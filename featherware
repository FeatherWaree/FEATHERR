function UpdateShaderUI()
	if not Shaders.Values then return end

	CloudActive = Shaders.Values["Enable Clouds"] or false
	WaterActive = Shaders.Values["Enable Water"] or false
	WeatherActive = (Shaders.Values["Weather"] ~= "None" and Shaders.Values["Weather"] ~= nil)

	if CloudCover and CloudDensity and CloudColor then
		CloudCover:SetVisible(CloudActive)
		CloudDensity:SetVisible(CloudActive)
		CloudColor:SetVisible(CloudActive)
	end

	if WaterColor and WaterWaveSize and WaterWaveSpeed then
		WaterColor:SetVisible(WaterActive)
		WaterWaveSize:SetVisible(WaterActive)
		WaterWaveSpeed:SetVisible(WaterActive)
	end

	if WeatherIntensity then
		WeatherIntensity:SetVisible(WeatherActive)
	end
end

function ApplyShaders()
	if not Shaders.Values then return end

	-- If the shader loop/toggle is turned off, force everything off
	local shadersEnabled = loops and loops["shaders"] == true

	-- Handle Clouds
	fwClouds = Terrain:FindFirstChild("FeatherwareClouds")
	if shadersEnabled and Shaders.Values["Enable Clouds"] then
		if not fwClouds then
			fwClouds = Instance.new("Clouds")
			fwClouds.Name = "FeatherwareClouds"
			fwClouds.Parent = Terrain
		end
		fwClouds.Cover = Shaders.Values["Cloud Cover"] or 0.5
		fwClouds.Density = Shaders.Values["Cloud Density"] or 0.5
	else
		if fwClouds then fwClouds:Destroy() end
	end

	-- Handle Water
	if shadersEnabled and Shaders.Values["Enable Water"] then
		Terrain.WaterWaveSize = Shaders.Values["Wave Size"] or 0.15
		Terrain.WaterWaveSpeed = Shaders.Values["Wave Speed"] or 15

		if not WaterIsGenerated then
			Terrain:FillBlock(WaterCFrame, WaterSize, Enum.Material.Water)
			WaterIsGenerated = true
		end
	else
		if WaterIsGenerated then
			Terrain:FillBlock(WaterCFrame, WaterSize, Enum.Material.Air)
			WaterIsGenerated = false
		end
	end

	-- Handle Weather
	fwWeatherPart = Cam:FindFirstChild("FeatherwareWeather")
	if shadersEnabled then
		if not fwWeatherPart then
			fwWeatherPart = Instance.new("Part")
			fwWeatherPart.Name = "FeatherwareWeather"
			fwWeatherPart.Anchored = true
			fwWeatherPart.CanCollide = false
			fwWeatherPart.Transparency = 1
			fwWeatherPart.Size = Vector3.new(150, 2, 150)
			fwWeatherPart.Parent = Cam

			fwWeatherEmitter = Instance.new("ParticleEmitter")
			fwWeatherEmitter.Name = "Emitter"
			fwWeatherEmitter.Parent = fwWeatherPart
			fwWeatherEmitter.EmissionDirection = Enum.NormalId.Bottom
			fwWeatherEmitter.Orientation = Enum.ParticleOrientation.FacingCamera
		else
			fwWeatherEmitter = fwWeatherPart:FindFirstChild("Emitter")
		end

		weatherType = Shaders.Values["Weather"] or "None"
		intensity = Shaders.Values["Weather Intensity"] or 1500

		if fwWeatherEmitter then
			if weatherType == "Rain" then
				fwWeatherEmitter.Enabled = true
