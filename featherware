	function mod:CreateSlider(sName, min, max, default, sCallback, sStep)
		sStep = (type(sStep) == "number") and sStep or 0.01
		local settingID = uniquePrefix .. "_" .. sName

		local decimals = 0
		local stepStr = tostring(sStep)
		if stepStr:find("%.") then decimals = #stepStr - stepStr:find("%.") end
		local formatStr = "%." .. decimals .. "f"

		local function cleanVal(val)
			if type(val) ~= "number" then val = tonumber(val) or min end
			val = math.clamp(val, min, max)
			local snapped = math.floor((val - min) / sStep + 0.5) * sStep + min
			return tonumber(string.format(formatStr, snapped))
		end

		-- SAFETY: Ensure saved config is actually a number, otherwise reset it
		if _G.SavedConfig[settingID] ~= nil then
			if type(_G.SavedConfig[settingID]) ~= "number" then
				_G.SavedConfig[settingID] = nil -- Corrupted save, wipe it
			else
				default = cleanVal(_G.SavedConfig[settingID])
			end
		end

		if _G.SavedConfig[settingID] == nil then
			default = cleanVal(default)
			_G.SavedConfig[settingID] = default
		end

		-- SAFETY: Ensure sCallback is strictly a function
		if type(sCallback) ~= "function" then sCallback = nil end

		local sFrame = FWNoModules.OwnInstance(Instance.new("Frame", settingsCont))
		sFrame:SetAttribute("FWSettingName", tostring(sName));sFrame:SetAttribute("FWM_Widget","Slider")
		sFrame.Size = UDim2.new(1, 0, 0, 38)
		sFrame.BackgroundTransparency = 1

		local sliderElement = {}

		function sliderElement:SetVisible(state)
			sFrame.Visible = state
		end

		local lbl = FWNoModules.OwnInstance(Instance.new("TextBox", sFrame))
		lbl.Text = "      " .. sName .. ": " .. string.format(formatStr, default)
		lbl.Size = UDim2.new(1, 0, 0.6, 0)
		lbl.BackgroundTransparency = 1
		lbl.TextColor3 = Color3.fromRGB(180, 180, 180)
		lbl.TextSize = 18
		lbl.TextXAlignment = Enum.TextXAlignment.Left
		lbl.FontFace = Font.fromName(textFont)
		lbl.ClearTextOnFocus = false

		local bg = FWNoModules.OwnInstance(Instance.new("TextButton", sFrame))
		bg.Text = ""
		bg.Size = UDim2.new(0.85, 0, 0.15, 0)
		bg.Position = UDim2.new(0.075, 0, 0.65, 0)
		bg.BackgroundColor3 = Color3.fromRGB(45, 45, 45)

		-- Safe UICorner creation
		local bgCorner = FWNoModules.OwnInstance(Instance.new("UICorner"))
		bgCorner.CornerRadius = UDim.new(0, 4)
		bgCorner.Parent = bg

		local fill = FWNoModules.OwnInstance(Instance.new("Frame", bg))
		fill.BackgroundColor3 = Color3.fromRGB(78, 173, 73)
		fill.Size = UDim2.new((default - min)/(max - min), 0, 1, 0)

		local fillCorner = FWNoModules.OwnInstance(Instance.new("UICorner"))
		fillCorner.CornerRadius = UDim.new(0, 4)
		fillCorner.Parent = fill

		mod.Values[sName] = default
		if sCallback then pcall(function() sCallback(default) end) end

		local function updateSliderVisual(val)
			val = cleanVal(val)
			local percent = math.clamp((val - min) / (max - min), 0, 1)
			fill.Size = UDim2.new(percent, 0, 1, 0)
			lbl.Text = "      " .. sName .. ": " .. string.format(formatStr, val)

			mod.Values[sName] = val
			_G.SavedConfig[settingID] = val

			-- Safe call for saveConfigToPC
			pcall(function()
				if type(saveConfigToPC) == "function" then
					saveConfigToPC()
				elseif typeof(saveConfigToPC) == "Instance" then
					if saveConfigToPC:IsA("BindableEvent") then
						saveConfigToPC:Fire()
					elseif saveConfigToPC:IsA("RemoteEvent") then
						saveConfigToPC:FireServer()
					end
				end
			end)

			if sCallback then pcall(function() sCallback(val) end) end
			if mod.Callbacks.OnValueChanged then pcall(function() mod.Callbacks.OnValueChanged(sName, val) end) end
		end

		mod.UpdateFunctions[sName] = function(forceValue)
            FWNoModules.Profiles.TouchBinding(settingID)
			updateSliderVisual(forceValue)
		end

		FWNoModules.Connect(lbl.FocusLost, function()
			local rawText = lbl.Text:match(":%s*(.-)$") or lbl.Text
			local num = tonumber(rawText)
			if num then
				updateSliderVisual(num)
			else
				updateSliderVisual(mod.Values[sName])
			end
		end)

		-- Define these locally for the drag logic just in case they aren't at the top of your script
		local RunService = G.Services.RunService
		local UserInputService = G.Services.UIS

        local stopSliderDrag
        FWNoModules.Connect(bg.InputBegan,function(input)
            if input.UserInputType~=Enum.UserInputType.MouseButton1 and input.UserInputType~=Enum.UserInputType.Touch then return end
            if stopSliderDrag then stopSliderDrag()end
            local unlock=FWNoModules.Mobile.LockScroll(sFrame)
            local function update(point)
                local localPoint=FWNoModules.Mobile.LocalPoint(bg,point)
                local relative=math.clamp(localPoint.X/math.max(1,bg.AbsoluteSize.X),0,1)
                local value=cleanVal(min+(max-min)*relative)
                if value~=mod.Values[sName]then updateSliderVisual(value)end
            end
            update(input.Position)
            stopSliderDrag=FWNoModules.PointerDrag(sFrame,input,function(change)update(change.Position)end,function()unlock();stopSliderDrag=nil end)
        end)

		FWNoModules.Connect(sFrame.InputChanged, function(input)
			if input.UserInputType == Enum.UserInputType.MouseWheel then
				local delta = input.Position.Z 
				local currentVal = mod.Values[sName]
				local newVal = currentVal + (delta * sStep)
				updateSliderVisual(newVal)
			end
		end)

        FWNoModules.Profiles.Register(settingID,function()return mod.Values[sName]end,function(v)mod.UpdateFunctions[sName](v)end,mod,"setting")
        return sliderElement
	end

