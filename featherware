		if nt_d.healthConn then nt_d.healthConn:Disconnect() end
		nt_d.healthConn = FWNoModules.Connect(ntHum.HealthChanged, function(health)
			ntPct = math.clamp(health / math.max(ntHum.MaxHealth, 1), 0, 1)
			nt_d.fill.Size = UDim2.fromScale(ntPct, 1)
			nt_d.hp.Text = tostring(math.round(health))
