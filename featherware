												end
												noelleData.SoundManager:playSound(noelleData.SlimeMeta[sType].directSound, {volumeMultiplier = 0.75})
											end)
										end

										-- Fire ability remote
										pcall(function()
											useAbility:FireServer("SLIME_DIRECT")
										end)

										task.wait(0.05)

										-- Move slime to target
										pcall(function()
											noelleData.requestMoveSlime:InvokeServer({slimeId = slimeId, targetPlayerUserId = targetPlayer.UserId})
										end)

										task.wait(0.10) -- 0.10s delay between giving multiple slimes
									end
								end
							end
						end
					end
				end
			end))
		end
	else
		if noelleData.loopConn then
			noelleData.loopConn:Disconnect()
			noelleData.loopConn = nil
		end
	end
end, true)

