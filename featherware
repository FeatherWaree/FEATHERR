								following = slime:FindFirstChild("Following")
								currentFollowing = following and following.Value or 0
								slimeState = slime:GetAttribute("SlimeState") or 0

								-- 0 = IDLE, 1 = CHANGING_PLAYER
								if currentFollowing ~= targetPlayer.UserId and slimeState == 0 then
									slimeId = slime:GetAttribute("Id")
									if slimeId and noelleData.requestMoveSlime then
										-- Play legit animation & sound
										if noelleData.animLoaded then
											pcall(function()
