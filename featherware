	if caitlynData.hudFrame then pcall(function() caitlynData.hudFrame:Destroy() end) caitlynData.hudFrame = nil end
end

caitlynStartHUD = function()
	if caitlynData.hudConnection then return end

	playerGui = Players.LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if not playerGui then return end

	existing = playerGui:FindFirstChild("CaitlynHUD_FW")
	if existing then existing:Destroy() end

	frame = Instance.new("Frame")
	frame.Name = "CaitlynHUD_FW"
	frame.Size = UDim2.new(0, 240, 0, 100)
	frame.Position = UDim2.new(0, 10, 0.5, -50)
	frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
	frame.BackgroundTransparency = 0.3
	frame.Parent = playerGui
	Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)

	titleLbl = Instance.new("TextLabel")
	titleLbl.Size = UDim2.new(1, -10, 0.25, 0)
	titleLbl.Position = UDim2.new(0, 5, 0, 0)
	titleLbl.BackgroundTransparency = 1
	titleLbl.TextColor3 = Color3.fromRGB(255, 50, 50)
	titleLbl.TextSize = 14
	titleLbl.Font = Enum.Font.GothamBold
	titleLbl.TextXAlignment = Enum.TextXAlignment.Left
	titleLbl.Text = "CAITLYN CONTRACTS"
	titleLbl.Parent = frame

	contractsLbl = Instance.new("TextLabel")
	contractsLbl.Size = UDim2.new(1, -10, 0.35, 0)
	contractsLbl.Position = UDim2.new(0, 5, 0.25, 0)
	contractsLbl.BackgroundTransparency = 1
	contractsLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
	contractsLbl.TextSize = 12
	contractsLbl.Font = Enum.Font.Gotham
	contractsLbl.TextXAlignment = Enum.TextXAlignment.Left
	contractsLbl.TextYAlignment = Enum.TextYAlignment.Top
	contractsLbl.TextWrapped = true
	contractsLbl.Parent = frame

	activeLbl = Instance.new("TextLabel")
	activeLbl.Size = UDim2.new(1, -10, 0.25, 0)
	activeLbl.Position = UDim2.new(0, 5, 0.65, 0)
	activeLbl.BackgroundTransparency = 1
	activeLbl.TextColor3 = Color3.fromRGB(100, 255, 100)
	activeLbl.TextSize = 12
	activeLbl.Font = Enum.Font.GothamBold
	activeLbl.TextXAlignment = Enum.TextXAlignment.Left
	activeLbl.Parent = frame

	caitlynData.hudFrame = frame
	caitlynData.hudContractsLbl = contractsLbl
	caitlynData.hudActiveLbl = activeLbl

	caitlynData.hudConnection = G.Services.RunService.RenderStepped:Connect(function()
		if not loops["auto caitlyn"] or not caitlynSettings.showContractHUD then
			if caitlynData.hudConnection then 
				caitlynData.hudConnection:Disconnect() 
				caitlynData.hudConnection = nil 
			end
			caitlynCleanupHUD()
			return
		end

		now = os.clock()
		if now - (caitlynData.lastHudUpdate or 0) < 0.2 then return end
		caitlynData.lastHudUpdate = now

		contractsText = ""
		for i, contract in ipairs(caitlynData.currentContracts) do
			if contract.target and contract.target.Name then
				contractsText = contractsText .. "• " .. contract.target.Name .. "\n"
			end
		end
		if contractsText == "" then contractsText = "No contracts available" end
		if contractsLbl.Text ~= contractsText then contractsLbl.Text = contractsText end

		if caitlynData.activeContract and caitlynData.activeContract.target then
			activeText = "Active: " .. caitlynData.activeContract.target.Name
		else
			activeText = "Active: None"
		end
		if activeLbl.Text ~= activeText then activeLbl.Text = activeText end
	end)
end

caitlynSelectContract = function(contract)
	if not caitlynData.selectRemote or not contract then return end

	contractId = contract.contractId or contract.id
	if not contractId then
		print("[Featherware] Contract has no ID: " .. tostring(contract))
		return
	end

	pcall(function()
		caitlynData.selectRemote:FireServer({contractId = contractId})
	end)

	print("[Featherware] Selected contract: " .. tostring(contract.target and contract.target.Name) .. " (ID: " .. tostring(contractId) .. ")")
end

caitlynCheckModes = function()
	if not loops["auto caitlyn"] or caitlynSettings.selectMode == "None" then return end
	if caitlynData.activeContract then return end
	if #caitlynData.currentContracts == 0 then return end

	now = os.clock()
	if now - caitlynData.lastCheck < 0.5 then return end
	caitlynData.lastCheck = now

	myChar = Players.LocalPlayer.Character
	if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
	myPos = myChar.HumanoidRootPart.Position

	for i, contract in ipairs(caitlynData.currentContracts) do
		if contract.target and contract.target.Character then
			targetChar = contract.target.Character
			if targetChar:FindFirstChild("HumanoidRootPart") then
				dist = (targetChar.HumanoidRootPart.Position - myPos).Magnitude

				if caitlynSettings.selectMode == "Range Mode" and dist <= AutoCaitlyn.Values["Range"] then
					caitlynSelectContract(contract)
					return
				end

				if caitlynSettings.selectMode == "Combat Mode" and dist <= 8 then
					caitlynSelectContract(contract)
					return
				end
			end
		end
	end
end

caitlynApply = function()
	if not canRequire then return end
	if not caitlynLoad() then return end

	active = loops["auto caitlyn"] == true

	if active and not caitlynData.storeConnection then
		caitlynData.storeConnection = caitlynData.store.changed:connect(function(newState)
			contracts = newState.Kit and newState.Kit.availableContracts or {}
			activeContract = newState.Kit and newState.Kit.activeContract or nil

			caitlynData.currentContracts = contracts or {}
			caitlynData.activeContract = activeContract

			caitlynCheckModes()

			if caitlynSettings.showContractHUD then
				if not caitlynData.hudConnection then
					caitlynStartHUD()
				end
			end
		end)

		state = caitlynData.store:getState()
		caitlynData.currentContracts = state and state.Kit and state.Kit.availableContracts or {}
		caitlynData.activeContract = state and state.Kit and state.Kit.activeContract or nil

		if caitlynSettings.showContractHUD and not caitlynData.hudConnection then
			caitlynStartHUD()
		end
	end

	if not active then
		caitlynDisconnectStore()
		caitlynCleanupHUD()
		caitlynData.currentContracts = {}
		caitlynData.activeContract = nil
		return
	end

	if caitlynSettings.showContractHUD and not caitlynData.hudConnection then
		caitlynStartHUD()
	end
	if not caitlynSettings.showContractHUD and caitlynData.hudConnection then
		caitlynCleanupHUD()
	end
end

