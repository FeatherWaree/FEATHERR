        end)
        if Reached and Current(Token) then
            Remotes:Get("GateOpenRequest"):SendToServer()
            Requests += 1
            Log("gate requested")
            local Waited: number = os.clock()
            while Current(Token) and not GateOpened and os.clock() - Waited < 5 do
                task.wait(0.2)
            end
        else
            task.wait(1)
        end
    end
end

Handlers.halloween_graveyard_2023 = function(Token: number, Assets: Instance)
    local Scene = Assets:FindFirstChild("Assets")
    if not Scene then
        return
    end
    local Remotes = bedwars.Client:GetNamespace("HalloweenGraveyard2023")
    local Button = Scene:FindFirstChild("GateButton") and Scene.GateButton:FindFirstChild("Button")
    local Solved: boolean = false
    local Found: number = 0
    AutoHalloween:Clean(Remotes:Get("PuzzleSolved"):Connect(function()
        Solved = true
        Log("altar solved")
    end))
    AutoHalloween:Clean(Remotes:Get("CandleDiscovered"):Connect(function(Data)
        Found = type(Data) == "table" and Data.candleCount or Found + 1
        Log(`candle discovered {Found}`)
    end))
    OpenGate("HalloweenGraveyard2023", Button, Token)
    task.wait(3)

    local Altar = Scene:FindFirstChild("Altar")
    if not Altar or not Altar:FindFirstChild("Candles") or not Altar:FindFirstChild("Points") then
        return
    end
    local Candles = Altar.Candles
    local Points = Altar.Points:GetChildren()

    local function Wrong(Point: Instance): boolean
        return Point:GetAttribute("CandleColor") ~= Point:GetAttribute("Color")
    end

    local function Collected(): number
        local Count: number = 0
        for _, Candle in Candles:GetChildren() do
            if Candle:GetAttribute("Collected") == true then
                Count += 1
            end
        end
        return Count
    end

    local Visited = {}
    Walk.Bunny = true
    while Current(Token) and not Solved do
        local Root = GetRoot()
        if not Root then
            task.wait(0.5)
            continue
        end
        local Pending = {}
        if Collected() < #Points then
            for _, Candle in Candles:GetChildren() do
                if Candle:GetAttribute("Collected") ~= true and os.clock() - (Visited[Candle] or -math.huge) > 25 then
                    table.insert(Pending, Candle)
                end
            end
        end
        if #Pending > 0 then
            table.sort(Pending, function(A, B)
                local PositionA, PositionB = PartPosition(A), PartPosition(B)
                return PositionA and PositionB and (PositionA - Root.Position).Magnitude < (PositionB - Root.Position).Magnitude or false
            end)
            local Candle = Pending[1]
            Visited[Candle] = os.clock()
            local Position = PartPosition(Candle)
            if Position then
                Log(`candle at {math.floor(Position.X)},{math.floor(Position.Y)},{math.floor(Position.Z)}, collected {Collected()}/{#Points}`)
                local Prompt = Candle:FindFirstChildWhichIsA("ProximityPrompt", true)
                local Fired: number = 0
                local Reached: boolean = Travel(GroundAt(Position), 4, 18, Token, Assets, 14, function()
                    if Collected() >= #Points or Candle:GetAttribute("Collected") == true then
                        return true
                    end
                    local Body = GetRoot()
                    if Prompt and Body and (Position - Body.Position).Magnitude <= 10.5 and os.clock() - Fired > 0.4 then
                        Fired = os.clock()
                        pcall(fireproximityprompt, Prompt)
                    end
                    return false
                end)
                local Body = GetRoot()
                for _ = 1, 4 do
                    if not Prompt or not Body or Candle:GetAttribute("Collected") == true or (Position - Body.Position).Magnitude > 11.5 then
                        break
                    end
                    pcall(fireproximityprompt, Prompt)
                    task.wait(0.4)
                end
                if Candle:GetAttribute("Collected") == true then
                    Log("candle collected by us")
                elseif not Reached then
                    Visited[Candle] = os.clock() + 70
                end
                task.wait(0.4)
            end
            continue
        end
        local Target: Instance?
        local Candle: Instance?
        for _, Point in Points do
            if Wrong(Point) then
                for _, Item in Candles:GetChildren() do
                    if tostring(Item:GetAttribute("AltarPoint")) == Point.Name then
                        Target, Candle = Point, Item
                        break
                    end
                end
                if Target then
                    break
                end
            end
        end
        if Target and Candle then
            local Prompt = Candle:FindFirstChildWhichIsA("ProximityPrompt", true)
            local Position = PartPosition(Candle)
            if Prompt and Position and Travel(GroundAt(Position), 7, 60, Token, Assets, 14) then
                Log(`point {Target.Name} wants {tostring(Target:GetAttribute("Color"))} has {tostring(Target:GetAttribute("CandleColor"))}`)
                for _ = 1, 9 do
                    if not Current(Token) or not Wrong(Target) then
                        break
                    end
                    pcall(fireproximityprompt, Prompt)
                    task.wait(0.4)
                end
            else
                task.wait(1)
            end
            continue
        end
        local AllRight: boolean = Collected() >= #Points
        for _, Point in Points do
            AllRight = AllRight and not Wrong(Point)
        end
        local Skull = Altar:FindFirstChild("Model") and Altar.Model:FindFirstChild("Skull")
        local Prayer = Skull and Skull:FindFirstChildWhichIsA("ProximityPrompt")
        local Position = Skull and PartPosition(Skull)
        if AllRight and Prayer and Position and Travel(GroundAt(Position), 6, 90, Token, Assets, 14) then
            Log("praying")
            pcall(fireproximityprompt, Prayer)
            local Waited: number = os.clock()
            while Current(Token) and not Solved and os.clock() - Waited < 5 do
                task.wait(0.3)
            end
        else
            task.wait(1)
        end
    end
    Walk.Bunny = false
end

