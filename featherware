cdNearestPlayer = function(pos, range)
	cd_best, cd_bd = nil, range
	for _, p in ipairs(FWNoModules.PlayerSnapshot()) do
		if cdShouldCheck(p) and p.Character then
			cd_hr = p.Character:FindFirstChild("HumanoidRootPart")
			if cd_hr then
				cd_d = (cd_hr.Position - pos).Magnitude
				if cd_d < cd_bd then cd_bd = cd_d; cd_best = p end
			end
		end
	end
	return cd_best, cd_bd
end

