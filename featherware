adetundeUpgradeCycle = function()
	if adetundeData.complete then return end
	now = os.clock()
	if now - adetundeData.lastAttempt < 0.3 then return end
	adetundeData.lastAttempt = now

	adetundeData.crystalCache = adetundeGetCrystals()

	if adetundeAllMaxed() then
		adetundeData.complete = true
		adetundeRender()
		return
	end

	if adetundeData.crystalCache <= 0 then
		adetundeRender()
		return
	end

	for i = 1, 3 do
		upgradeType = adetundeData.slotOrder[i]
		if upgradeType and adetundeCanUpgrade(upgradeType) then
			success = adetundeTryUpgrade(upgradeType)
			if success then
				if adetundeAllMaxed() then
					adetundeData.complete = true
				end
				adetundeRender()
				return
			end
		end
	end
	adetundeRender()
end

