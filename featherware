cdNotify = function(plr, reason)
	cd_key = tostring(plr.UserId) .. reason
	cd_now = os.clock()
	if cd_notifyCD[cd_key] and cd_now - cd_notifyCD[cd_key] < 6 then return end
	cd_notifyCD[cd_key] = cd_now
	NotificationSystem.Notify(plr.DisplayName, reason, 4)
end

cdShouldCheck = function(plr)
	if plr == Player then return CheaterDetector.Values["Self"] == true end
	return true
end

cdHeldName = function(char)
	cd_hi = char:FindFirstChild("HandInvItem")
	if cd_hi and cd_hi.Value then
		return typeof(cd_hi.Value) == "Instance" and cd_hi.Value.Name or tostring(cd_hi.Value)
	end
	return nil
end

cdKaEnabled = function(checkName)
	cd_ks = CheaterDetector.Values["Killaura Checks"]
