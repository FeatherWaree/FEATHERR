KaidaKa.Callbacks.OnToggle = function(state)
	loops["kaidaka"] = state

	if not loops["kaidaka"] then
		currentKaTarget = nil
		swingRequested = false
		if kaHighlight then kaHighlight.Adornee = nil end
		if boxVisualizer then boxVisualizer.Adornee = nil end
		return
	end

	task.spawn(function()
		while loops["kaidaka"] do
			hitDelay = tonumber(KaidaKa.Values["Hit Delay"]) or 0.55
			task.wait(hitDelay)

			if not loops["kaidaka"] then break end

			if not (KaidaKa.Values["Target Players"] or KaidaKa.Values["Target NPCs/Dummies"]) then
				currentKaTarget = nil
				kaHighlight.Adornee = nil
				boxVisualizer.Adornee = nil
				swingRequested = false
				continue
			end

			char = Player.Character
			if not char or not char:FindFirstChild("HumanoidRootPart") then
				currentKaTarget = nil
				kaHighlight.Adornee = nil
				boxVisualizer.Adornee = nil
				swingRequested = false
				continue
			end
			rootPart = char.HumanoidRootPart

			if KaidaKa.Values["Check If Sophia Frozen"] then
				stunTime = Player:GetAttribute("StunnedUntilTime")
				if stunTime and stunTime ~= -1 then
					currentKaTarget = nil
					kaHighlight.Adornee = nil
					boxVisualizer.Adornee = nil
					swingRequested = false
					continue
				end
			end

			if not handleClawRequirement() then
				currentKaTarget = nil
				kaHighlight.Adornee = nil
				boxVisualizer.Adornee = nil
				swingRequested = false
				continue
			end

			playertarget = nil
			playerdistance = 1000
			npcdummytarget = nil
			npcdummydistance = 1000

			reach = tonumber(KaidaKa.Values["Reach"]) or 20
			angleCheck = tonumber(KaidaKa.Values["Angle Check"]) or 90

			if KaidaKa.Values["Target Players"] then
				for _, v in ipairs(FWNoModules.PlayerSnapshot()) do
					isSpectator = false
					if v.Team and v.Team.Name and string.find(string.lower(v.Team.Name), "spectator") then
						isSpectator = true
					end

					if not isSpectator and v ~= Player and v.Character and v.Team ~= Player.Team then
						targetHRP = v.Character:FindFirstChild("HumanoidRootPart")
						hum = v.Character:FindFirstChild("Humanoid")
						if targetHRP and hum and hum.Health > 0 then
							dist = (rootPart.Position - targetHRP.Position).Magnitude
							if dist <= reach and dist < playerdistance then
								if isInFOV(rootPart, targetHRP, angleCheck) then
									playertarget = v.Character
									playerdistance = dist
								end
							end
						end
					end
				end
			end

			if KaidaKa.Values["Target NPCs/Dummies"] then
				for _, npc in ipairs(G.Services.Workspace:GetChildren()) do
					if npc:IsA("Model") and npc:FindFirstChild("Humanoid") and npc.PrimaryPart then
						if not Players:GetPlayerFromCharacter(npc) then
							dist = (rootPart.Position - npc.PrimaryPart.Position).Magnitude
							if dist <= reach and dist < npcdummydistance then
								if isInFOV(rootPart, npc.PrimaryPart, angleCheck) then
									npcdummytarget = npc
									npcdummydistance = dist
								end
							end
						end
					end
				end
			end

			priority = KaidaKa.Values["Priority"] or "Nearest"
			besttarget = nil
			if priority == "Player" then
				besttarget = playertarget or npcdummytarget
			elseif priority == "NPC/Dummy" then
				besttarget = npcdummytarget or playertarget
			else 
				if playertarget and npcdummytarget then
					besttarget = (playerdistance <= npcdummydistance) and playertarget or npcdummytarget
				else
					besttarget = playertarget or npcdummytarget
				end
			end

			hasTarget = false
			targetDir = nil

			if besttarget then
				targetHRP = besttarget:FindFirstChild("HumanoidRootPart") or besttarget.PrimaryPart
				if targetHRP then
					distToTarget = (rootPart.Position - targetHRP.Position).Magnitude

					if distToTarget <= 40 then
						if KaidaKa.Values["Highlight Target"] then
							kaHighlight.Adornee = besttarget
						else
							kaHighlight.Adornee = nil
						end

						if KaidaKa.Values["3D Box"] then
							boxVisualizer.Adornee = targetHRP
						else
							boxVisualizer.Adornee = nil
						end
					else
						kaHighlight.Adornee = nil
						boxVisualizer.Adornee = nil
					end

					if distToTarget <= reach and isInFOV(rootPart, targetHRP, angleCheck) then
						hasTarget = true
						targetDir = (targetHRP.Position - rootPart.Position).Unit
						currentKaTarget = besttarget

						if KaidaKa.Values["Face Target"] then
							char:PivotTo(CFrame.lookAt(rootPart.Position, targetHRP.Position))
						end
					end
				end
			end

			if not hasTarget then
				currentKaTarget = nil
				kaHighlight.Adornee = nil
				boxVisualizer.Adornee = nil
			end

			shouldSwing = false
			if KaidaKa.Values["Manual Swing"] then
				if clicking or swingRequested then
					shouldSwing = true
				end
				swingRequested = false
			else
				if hasTarget then
					shouldSwing = true
				end
			end

			if shouldSwing then
				if not handleClawRequirement() then
					continue
				end

				camera = G.Services.Workspace.CurrentCamera
				swingDir = targetDir or (camera and camera.CFrame.LookVector) or rootPart.CFrame.LookVector
				offsetPosition = rootPart.Position + (swingDir * reach)

				playSwingAnim()
				playHitSound()
				spawnClawVFX(rootPart.Position, swingDir)

				if hasTarget then
					remote = getClawRemote()
					remoteArgs = {
						{
							clientTime = G.Services.Workspace:GetServerTimeNow(),
							direction = Vector3.new(swingDir.X, swingDir.Y, swingDir.Z),
							position = Vector3.new(offsetPosition.X, offsetPosition.Y, offsetPosition.Z)
						}
					}

					if remote then
						pcall(function()
							remote:FireServer(unpack(remoteArgs))
						end)
					end
				end
			end
		end
	end)
end
FWNoModules.Connect(UserInputService.InputBegan, function(input, GPE)
	if GPE then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		startTime = os.clock()
	end
end)

FWNoModules.Connect(UserInputService.InputEnded, function(input, GPE)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		local currentTime = os.clock()
		local heldTime = currentTime - startTime

		if heldTime <= maxHoldTime then
			local timeSinceLastClick = currentTime - lastClickTime

			if timeSinceLastClick <= maxClickInterval then
				if not clicking then
					clicking = true
				end
			end

			lastClickTime = currentTime

			if resetTask then
				task.cancel(resetTask) 
			end

			resetTask = task.delay(maxClickInterval, function()
				clicking = false
			end)
		else
			clicking = false
		end
	end
end)

local Players = game:GetService("Players")

local function getAlpha()
	return math.clamp(1 - (AimAssist.Values["Smoothness"] / 100), 0.01, 1)
end

AimAssist.Callbacks.OnToggle = function(state)
	AimAssist.Toggled = state
	loops["aim assist"] = state

	if loops["aim assist"] == false then 
		if aimConnection then
			aimConnection:Disconnect()
			aimConnection = nil
		end
		currentTarget = nil
		return 
	end


	aimConnection = FWNoModules.TrackFrameConnection(RunService.Heartbeat:Connect(function()
		local s, e = pcall(function()
			if currentTarget and currentTarget.PrimaryPart then
				targetPart = currentTarget.PrimaryPart

				shakeIntensity = AimAssist.Values["Shake Intensity"]
				shakeSpeed = AimAssist.Values["Shake Speed"]
				currentTime = os.clock() * shakeSpeed

				offsetX = math.noise(currentTime, 0, 0) * shakeIntensity
				offsetY = math.noise(0, currentTime, 0) * shakeIntensity
				offsetZ = math.noise(0, 0, currentTime) * shakeIntensity
				shakeVector = Vector3.new(offsetX, offsetY, offsetZ)

				spoofedTargetPos = targetPart.Position + shakeVector
				goalCFrame = CFrame.new(camera.CFrame.Position, spoofedTargetPos)

				char = Player.Character
				if not char then return end 

				local handItem = char:FindFirstChild("HandInvItem", true) 

				if AimAssist.Values["Sync with KA Target"] == false and AimAssist.Values["Track Through Walls"] == false then
					local raycastParams = RaycastParams.new()
					raycastParams.FilterDescendantsInstances = {char, currentTarget} 
					raycastParams.FilterType = Enum.RaycastFilterType.Exclude
					raycastParams.IgnoreWater = true

					origin = camera.CFrame.Position
					direction = targetPart.Position - origin
					wallHit = G.Services.Workspace:Raycast(origin, direction, raycastParams)

					if wallHit then
						return 
					end
				end

				if AimAssist.Values["Require Sword Equipped"] == true then
					if handItem and table.find(swords, tostring(handItem.Value)) then
						if AimAssist.Values["Face Target"] == true then faceTarget(char, currentTarget) end
						camera.CFrame = camera.CFrame:Lerp(goalCFrame, getAlpha())
					else
						return 
					end
				else
					if AimAssist.Values["Face Target"] == true then faceTarget(char, currentTarget) end
					camera.CFrame = camera.CFrame:Lerp(goalCFrame, getAlpha())
				end
			end
		end)
		if not s then warn("[AimAssist Render ERROR] " .. tostring(e)) end
	end))

	task.spawn(function()
		local debugTick = 0 

		while AimAssist.Toggled do
			task.wait(0.05) 

			local success, errorMessage = pcall(function()
				debugTick = debugTick + 1
				local shouldPrint = (debugTick % 20 == 0) 

				if debugTick == 1 then
				end

				char = Player.Character
				if not char or not char:FindFirstChild("HumanoidRootPart") then
					if shouldPrint then end
					currentTarget = nil
					return -- Use return instead of continue inside a pcall
				end
				local myHRP = char.HumanoidRootPart

				local playerTarget = nil
				local dummyTarget = nil
				local bestTarget = nil

				local closestPlayerDist = AimAssist.Values["Range"]
				local closestNpcDist = AimAssist.Values["Range"]

				if shouldPrint then
				end

				-- PLAYERS
				if AimAssist.Values["Target Players"] == true then
					for _, targetCharacter in ipairs(EntityCache.Players) do
						local targetPlayer = Players:GetPlayerFromCharacter(targetCharacter)
						if targetPlayer == Player or (targetPlayer and targetPlayer.Team == Player.Team) then continue end

						local HRP = targetCharacter:FindFirstChild("HumanoidRootPart") or targetCharacter.PrimaryPart
						if HRP then
							local distance = (HRP.Position - myHRP.Position).Magnitude
							if distance <= closestPlayerDist then
								closestPlayerDist = distance
								playerTarget = targetCharacter
							end
						end
					end
				end

				-- NPCs
				if AimAssist.Values["Target NPC/Dummies"] == true then

					for _, npc in ipairs(EntityCache.NPCs) do
						local HRP = npc.PrimaryPart or npc:FindFirstChild("HumanoidRootPart")
						if HRP then
							local distance = (HRP.Position - myHRP.Position).Magnitude

							if distance <= closestNpcDist then
								closestNpcDist = distance
								dummyTarget = npc
							end
						end
					end
				end

				local priority = AimAssist.Values["Priority"]
				if priority == "Player" then
					bestTarget = playerTarget or dummyTarget
				elseif priority == "NPC/Dummy" then
					bestTarget = dummyTarget or playerTarget
				end

				-- SYNC / ASSIGNMENT
				if AimAssist.Values["Sync with KA Target"] == true and loops["killaura"] == true then
					local kaTarget = currentKaTarget 
					if kaTarget and kaTarget:FindFirstChild("Humanoid") and kaTarget.Humanoid.Health > 0 then
						currentTarget = kaTarget
					else
						currentTarget = nil
					end
					if shouldPrint then  end
				else
					if bestTarget and bestTarget:FindFirstChild("Humanoid") and bestTarget.Humanoid.Health > 0 then
						currentTarget = bestTarget
					else
						currentTarget = nil
					end
					if shouldPrint then  end
				end
			end)

			if not success then
				warn("[AimAssist ERROR] The loop crashed! Reason: " .. tostring(errorMessage))
			end

		end
	end)
end
-- Radar for Bridges
-- Create a dedicated RaycastParams object for this function to prevent casting errors
VelocityRayParams = RaycastParams.new()
VelocityRayParams.FilterType = Enum.RaycastFilterType.Exclude
VelocityRayParams.IgnoreWater = true

function IsOnVoidOrBridge(hrp)
	VelocityRayParams.FilterDescendantsInstances = {hrp.Parent}
	local pos = hrp.Position
	local down = Vector3.new(0, -20, 0)

	-- Check directly underneath
	if not G.Services.Workspace:Raycast(pos, down, VelocityRayParams) then 
		return true 
	end

	-- Check surrounding edges to see if we are on a bridge or solid ground
	local right = hrp.CFrame.RightVector * 4
	local forward = hrp.CFrame.LookVector * 4

	-- Fixed the typo here (changed 'params' to 'VelocityRayParams')
	if not G.Services.Workspace:Raycast(pos + right, down, VelocityRayParams) or 
		not G.Services.Workspace:Raycast(pos - right, down, VelocityRayParams) or
		not G.Services.Workspace:Raycast(pos + forward, down, VelocityRayParams) or 
		not G.Services.Workspace:Raycast(pos - forward, down, VelocityRayParams) then
		return true 
	end

	return false
end

