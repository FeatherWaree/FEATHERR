function ieCreateESP(inst)
	if ie_objects[inst] then return end
	ie_bb = FWNoModules.OwnInstance(Instance.new("BillboardGui"))
	ie_bb.Size = UDim2.fromOffset(160, 40)
	ie_bb.StudsOffset = Vector3.new(0, 2, 0)
	ie_bb.AlwaysOnTop = true
	ie_bb.Parent = inst
	ie_lbl = FWNoModules.OwnInstance(Instance.new("TextLabel"))
	ie_lbl.Size = UDim2.fromScale(1, 1)
	ie_lbl.BackgroundTransparency = 1
	ie_lbl.TextColor3 = ItemESP.Values["Item Color"] or Color3.fromRGB(255, 255, 100)
	ie_lbl.TextSize = ItemESP.Values["Text Size"] or 12
	ie_lbl.Font = Enum.Font.GothamBold
	ie_lbl.TextStrokeTransparency = 0
	ie_lbl.TextStrokeColor3 = Color3.fromRGB(15, 15, 15)
	ie_lbl.Text = inst.Name
	ie_lbl.Parent = ie_bb
	ie_glow = nil
	if ItemESP.Values["Show Glow"] then
		ie_glow = FWNoModules.OwnInstance(Instance.new("PointLight"))
		ie_glow.Color = ItemESP.Values["Item Color"] or Color3.fromRGB(255, 255, 100)
		ie_glow.Range = 8
		ie_glow.Brightness = 2
		ie_glow.Parent = inst
	end
	ie_objects[inst] = { bb = ie_bb, lbl = ie_lbl, glow = ie_glow }
end

function ieRemoveESP(inst)
	if ie_objects[inst] then
		pcall(function() ie_objects[inst].bb:Destroy() end)
		if ie_objects[inst].glow then pcall(function() ie_objects[inst].glow:Destroy() end) end
		ie_objects[inst] = nil
	end
end

function ieUpdateLabels()
	ie_char = Player.Character
	ie_hrp = ie_char and ie_char:FindFirstChild("HumanoidRootPart")
	if not ie_hrp then return end
	ie_maxDist = ItemESP.Values["Max Distance"] or 200
	for ie_inst, ie_data in pairs(ie_objects) do
		if not ie_inst.Parent then ieRemoveESP(ie_inst) continue end
		ie_pos = ie_inst.Position
		ie_dist = (ie_pos - ie_hrp.Position).Magnitude
		if ie_dist > ie_maxDist then ie_data.bb.Enabled = false continue end
		if ie_data.bb.Enabled ~= (true) then ie_data.bb.Enabled = true end
		ie_lines = {}
		ie_name = ie_inst.Name:gsub("_", " ")
		ie_amt = ie_inst:GetAttribute("Amount") or 1
		if ItemESP.Values["Show Amount"] and ie_amt > 1 then
			table.insert(ie_lines, ie_name .. " x" .. tostring(ie_amt))
		else
			table.insert(ie_lines, ie_name)
		end
		if ItemESP.Values["Show Distance"] then
			table.insert(ie_lines, string.format("%d studs", math.round(ie_dist)))
		end
		if ie_data.lbl.Text ~= (table.concat(ie_lines, "\n")) then ie_data.lbl.Text = table.concat(ie_lines, "\n") end
		if ie_data.lbl.TextColor3 ~= (ItemESP.Values["Item Color"] or Color3.fromRGB(255, 255, 100)) then ie_data.lbl.TextColor3 = ItemESP.Values["Item Color"] or Color3.fromRGB(255, 255, 100) end
		if ie_data.lbl.TextSize ~= (ItemESP.Values["Text Size"] or 12) then ie_data.lbl.TextSize = ItemESP.Values["Text Size"] or 12 end
	end
end

ItemESP.Callbacks.OnToggle = function(state)
	loops["item esp"] = state
	if state then
		ie_objects = {}
		ie_conns = {}
		for _, ie_inst in ipairs(sm_cs:GetTagged("ItemDrop")) do ieCreateESP(ie_inst) end
		table.insert(ie_conns, FWNoModules.Connect(sm_cs:GetInstanceAddedSignal("ItemDrop"), function(inst) if loops["item esp"] then ieCreateESP(inst) end end))
		table.insert(ie_conns, FWNoModules.Connect(sm_cs:GetInstanceRemovedSignal("ItemDrop"), function(inst) ieRemoveESP(inst) end))
		ie_updateConn = FWNoModules.TrackFrameConnection(sm_rs2.Heartbeat:Connect(function()
			if not loops["item esp"] then return end
			ieUpdateLabels()
		end))
		table.insert(ie_conns, ie_updateConn)
	else
		for _, ie_c in ipairs(ie_conns) do pcall(function() ie_c:Disconnect() end) end
		ie_conns = {}
		for ie_inst in pairs(ie_objects) do ieRemoveESP(ie_inst) end
		ie_objects = {}
	end
end

