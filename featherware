	pcall(function()
		rs = G.Services.RS
		events = rs:WaitForChild("events-@easy-games/game-core:shared/game-core-networking@getEvents.Events", 5)
		freijaData.remote = events:WaitForChild("useAbility", 5)
	end)
	return freijaData.remote ~= nil
end

freijaIsValidTarget = function(entity)
	if not entity or not entity.Parent then return false end
	if entity == Player.Character then return false end
	hum = entity:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return false end
	plr = Players:GetPlayerFromCharacter(entity)
	if plr then
		if plr == Player then return false end
		if plr.Team and Player.Team and plr.Team == Player.Team then return false end
	end
	return true
end

freijaCheckStacks = function(entity, stacks)
	if not loops["auto freiya"] then return end
	if stacks < freijaSettings.threshold then return end
	if not freijaIsValidTarget(entity) then return end

	now = os.clock()
	if now - freijaData.lastFire < 0.5 then return end

	if freijaLoadRemote() then
		freijaData.lastFire = now
		task.spawn(function()
			pcall(function()
				freijaData.remote:FireServer("ice_queen")
			end)
		end)
	end
end

freijaHookEntity = function(entity)
	if not entity:IsA("Model") and not entity:IsA("BasePart") then return end
	if freijaData.entityConnections[entity] then return end

	initialStacks = entity:GetAttribute("IceQueenStacks")
	if initialStacks and initialStacks > 0 then
		freijaCheckStacks(entity, initialStacks)
	end

	conn = entity:GetAttributeChangedSignal("IceQueenStacks"):Connect(function()
		stacks = entity:GetAttribute("IceQueenStacks")
		if stacks and stacks > 0 then
			freijaCheckStacks(entity, stacks)
		end
	end)

	freijaData.entityConnections[entity] = conn
end

freijaStart = function()
	if freijaData.connections.active then return end
	freijaData.connections.active = true

	cs = game:GetService("CollectionService")

	for _, entity in ipairs(cs:GetTagged("entity")) do
		freijaHookEntity(entity)
	end

	freijaData.connections.added = cs:GetInstanceAddedSignal("entity"):Connect(function(entity)
		freijaHookEntity(entity)
	end)

	freijaData.connections.removed = cs:GetInstanceRemovedSignal("entity"):Connect(function(entity)
		if freijaData.entityConnections[entity] then
			freijaData.entityConnections[entity]:Disconnect()
			freijaData.entityConnections[entity] = nil
		end
	end)
end

freijaStop = function()
	freijaData.connections.active = false
	if freijaData.connections.added then freijaData.connections.added:Disconnect() freijaData.connections.added = nil end
	if freijaData.connections.removed then freijaData.connections.removed:Disconnect() freijaData.connections.removed = nil end
	for entity, conn in pairs(freijaData.entityConnections) do
		pcall(function() conn:Disconnect() end)
	end
	table.clear(freijaData.entityConnections)
end

