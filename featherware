lassyGenId = function()
	chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
	id = ""
	for i = 1, 8 do
		id = id .. string.sub(chars, math.random(1, #chars), math.random(1, #chars))
	end
	return id
end

-- Closed-form ballistic solver (compensates for gravity & height differences)
lassySolve = function(origin, target, speed, gravity)
	dir = target - origin
	dist = Vector3.new(dir.X, 0, dir.Z).Magnitude
	dy = dir.Y

	v2 = speed * speed
	v4 = v2 * v2
	g = gravity

	discriminant = v4 - g * (g * dist * dist + 2 * dy * v2)
	if discriminant < 0 then
		return dir.Unit * speed, dist / speed
	end

	angle = math.atan2(v2 - math.sqrt(discriminant), g * dist)
	horizSpeed = speed * math.cos(angle)
	vertSpeed = speed * math.sin(angle)

	horizDir = Vector3.new(dir.X, 0, dir.Z).Unit
	vel = horizDir * horizSpeed + Vector3.new(0, vertSpeed, 0)
	time = dist / horizSpeed
	return vel, time
end

lassyIsInFOV = function(myHRP, targetHRP, fov)
	cam = G.Services.Workspace.CurrentCamera
	if not cam then return true end
	look = cam.CFrame.LookVector
	dir = (targetHRP.Position - myHRP.Position).Unit
	dot = look:Dot(dir)
	angle = math.deg(math.acos(math.clamp(dot, -1, 1)))
	return angle <= (fov / 2)
end

lassyFindTarget = function()
	myChar = Players.LocalPlayer.Character
	if not myChar then return nil end
	myHRP = myChar:FindFirstChild("HumanoidRootPart")
	if not myHRP then return nil end

	bestTarget = nil
	bestDist = lassySettings.range

	checkEntity = function(char, isPlayer)
		if not char or not char.Parent then return end
		hrp = char:FindFirstChild("HumanoidRootPart")
		hum = char:FindFirstChildOfClass("Humanoid")
		if not hrp or not hum or hum.Health <= 0 then return end

		dist = (hrp.Position - myHRP.Position).Magnitude
		if dist <= bestDist then
			if lassyIsInFOV(myHRP, hrp, lassySettings.fov) then
				bestTarget = char
				bestDist = dist
			end
		end
	end

	if AutoLassy.Values["Target Players"] then
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= Players.LocalPlayer and plr.Character then
				if plr.Team ~= Players.LocalPlayer.Team then
					checkEntity(plr.Character, true)
				end
			end
		end
	end

	if AutoLassy.Values["Target NPCs"] then
		for _, npc in ipairs(G.Services.Workspace:GetChildren()) do
			if npc:IsA("Model") and npc:FindFirstChildOfClass("Humanoid") and not Players:GetPlayerFromCharacter(npc) then
				checkEntity(npc, false)
			end
		end
	end

	return bestTarget
end

lassyFire = function(target)
	if not lassyLoadRemotes() then return end

	myChar = Players.LocalPlayer.Character
	if not myChar then return end
	myHRP = myChar:FindFirstChild("HumanoidRootPart")
	if not myHRP then return end

	invFolder = ReplicatedStorage:FindFirstChild("Inventories"):FindFirstChild(Players.LocalPlayer.Name)
	if not invFolder then return end
	lassoItem = invFolder:FindFirstChild("lasso")
	if not lassoItem then return end

	targetHRP = target:FindFirstChild("HumanoidRootPart")
	if not targetHRP then return end

	-- LEGIT: Miss chance (intentionally offset aim)
	missOffset = Vector3.zero
	if math.random(1, 100) > (AutoLassy.Values["Hit Chance"] or 85) then
		missOffset = Vector3.new(math.random(-4, 4), math.random(-2, 2), math.random(-4, 4))
	end

	aimPos = targetHRP.Position + missOffset

	speed = lassySettings.speed
	gravity = lassySettings.gravity

	if canRequire then
		meta = lassyGetMeta()
		if meta and meta.projectileSource then
			speed = meta.projectileSource.launchVelocity or speed
			gravity = meta.projectileSource.gravitationalAcceleration or gravity
		end
	end

	-- LEGIT: Slight velocity prediction
	targetVel = targetHRP.AssemblyLinearVelocity or Vector3.zero
	dist = (aimPos - myHRP.Position).Magnitude
	estTime = dist / speed
	predictedPos = aimPos + (targetVel * estTime * 0.4) 

	origin = myHRP.Position + Vector3.new(0, 2, 0)
	spawnOrigin = myHRP.Position

	vel, flightTime = lassySolve(origin, predictedPos, speed, gravity)

	fireId = lassyGenId()
	shotId = lassyGenId()

	-- LEGIT: Randomize draw duration (0.6s to 1.4s) to simulate human charging
	drawTime = 0.6 + math.random() * 0.8

	args = {
		lassoItem,
		"lasso",
		"lasso",
		Vector3.new(origin.X, origin.Y, origin.Z),
		Vector3.new(spawnOrigin.X, spawnOrigin.Y, spawnOrigin.Z),
		Vector3.new(vel.X, vel.Y, vel.Z),
		fireId,
		{shotId = shotId, drawDurationSec = drawTime},
		G.Services.Workspace:GetServerTimeNow()
	}

	task.spawn(function()
		pcall(function()
			lassyData.fireRemote:InvokeServer(unpack(args))
		end)

		-- Fire hit remote after flight time (fires twice as per packet dump)
		task.wait(math.max(0.1, flightTime - 0.05))
		if target and target.Parent then
			pcall(function()
				lassyData.hitRemote:FireServer(fireId, target)
			end)
			task.wait(0.05)
			pcall(function()
				lassyData.hitRemote:FireServer(fireId, target)
			end)
		end
	end)
end

lassyLoop = function()
	if not loops["auto lassy"] then return end

	myChar = Players.LocalPlayer.Character
	if not myChar then return end
	handItem = myChar:FindFirstChild("HandInvItem")
	if not handItem or not handItem.Value or handItem.Value.Name ~= "lasso" then return end

	now = os.clock()
	if now - lassyData.lastShot < lassySettings.cooldown then return end

	target = lassyFindTarget()
	if not target then 
		lassyData.targetLock = nil
		return 
	end

	-- LEGIT: Reaction time (locks onto target and waits before firing)
	if lassyData.targetLock ~= target then
		lassyData.targetLock = target
		lassyData.lockTime = now
	end

	reaction = AutoLassy.Values["Reaction Time"] or 0.25
	if now - lassyData.lockTime < reaction then return end

	lassyData.lastShot = now
	lassyFire(target)
end

