            recolor(rainbow and Color3.fromHSV(phase,.55,1)or color)
        end
        local function queue()
            if pending then return end
            pending=true
            FWNoModules.WithSessionOwner(function()task.defer(function()pending=false;refresh()end)end)
        end
        _G.__FW_REFRESH_MODULE_LIST=queue
        FWNoModules.Connect(frame:GetPropertyChangedSignal("Position"),function()
            _G.SavedConfig[savedPosKey]={XScale=frame.Position.X.Scale,XOffset=frame.Position.X.Offset,YScale=frame.Position.Y.Scale,YOffset=frame.Position.Y.Offset}
            saveConfigToPC()
        end)
        mod:CreateToggle("MODULE LIST",true,function(value)_G.ModuleListEnabled=value;frame.Visible=value;updateRainbow()end)
        mod:CreateToggle("AUTO LIST SCALE",true,function(value)auto=value;if manualSlider then manualSlider:SetVisible(not auto)end;queue()end)
        manualSlider=mod:CreateSlider("LIST SCALE",.5,2,manual,function(value)manual=value;if not auto then queue()end end,.05)
        manualSlider:SetVisible(not auto)
        mod:CreateDropdown("LIST SORT",{"Length (longest first)","Length (shortest first)","Alphabetical (A-Z)","Alphabetical (Z-A)"},sort,function(value)sort=value;queue()end)
        mod:CreateDropdown("LIST FONT",FWNoModules.ListFonts.Options(),fontName,function(value)fontName=value;queue()end)
        mod:CreateToggle("SHOW PROFILE NAME",false,function(value)showProfile=value;queue()end)
        mod:CreateToggle("RAINBOW TEXT",rainbow,function(value)rainbow=value;_G.RainbowEnabled=value;_G.SavedConfig.ModuleList_Rainbow=value;updateRainbow()end)
        mod:CreateColorPicker("TEXT COLOR",color,function(value)color=value;_G.StaticColor=value;_G.SavedConfig.ModuleList_Color=value;if not rainbow then recolor(color)end end)
        local unsubscribe=FWNoModules.Profiles.Subscribe(queue);FWNoModules.OnCleanup(unsubscribe)
        local viewportConnection
        local function cameraChanged()
            if viewportConnection then FWNoModules.ReleaseConnection(viewportConnection)end
            local camera=G.Services.Workspace.CurrentCamera
            if camera then viewportConnection=FWNoModules.Connect(camera:GetPropertyChangedSignal("ViewportSize"),queue)end
            queue()
        end
        FWNoModules.Connect(G.Services.Workspace:GetPropertyChangedSignal("CurrentCamera"),cameraChanged)
        FWNoModules.OnCleanup(function()if rainbowConnection then rainbowConnection:Disconnect()end;if viewportConnection then viewportConnection:Disconnect()end end)
        cameraChanged();updateRainbow()
    end

	function mod:CreateButton(btnName, callback, toggleable)
		local button = {
			Toggled = false
		}

		local btn = FWNoModules.OwnInstance(Instance.new("TextButton"))
		btn.Parent = settingsCont
		btn:SetAttribute("FWSettingName", tostring(btnName))
