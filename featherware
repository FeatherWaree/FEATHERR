function asSolve(O, T, v, g)
	asq_d = T - O
	asq_R = math.sqrt(asq_d.X*asq_d.X + asq_d.Z*asq_d.Z)
	if v <= 0 then return nil, 0 end
	if g < 0.001 then
		asq_dist = asq_d.Magnitude
		if asq_dist < 0.01 then return Vector3.new(0, v, 0), 0 end
		return asq_d.Unit * v, asq_dist / v
	end
	if asq_R < 0.5 then return Vector3.new(0, asq_d.Y >= 0 and v or -v, 0), math.abs(asq_d.Y)/v end
	asq_v2 = v*v
	asq_disc = asq_v2*asq_v2 - g*(g*asq_R*asq_R + 2*asq_d.Y*asq_v2)
	if asq_disc < 0 then return nil, 0 end
	asq_tanT = (asq_v2 - math.sqrt(asq_disc)) / (g*asq_R)
	asq_cosT = 1 / math.sqrt(1 + asq_tanT*asq_tanT)
	asq_hDir = Vector3.new(asq_d.X, 0, asq_d.Z) * (1/asq_R)
	return asq_hDir*(v*asq_cosT) + Vector3.new(0, v*asq_tanT*asq_cosT, 0), asq_R/(v*asq_cosT)
end

function asAim(O, hrp, vel, v, g, life, pTgtG)
	asa_T = hrp
	asa_g = pTgtG or 0
	asa_vt, asa_t = nil, 0
	for i = 1, 4 do
		asa_vt, asa_t = asSolve(O, asa_T, v, g)
		if not asa_vt or asa_t > (life or 3) then return nil end
		asa_T = Vector3.new(hrp.X + vel.X*asa_t, hrp.Y + vel.Y*asa_t - 0.5*asa_g*asa_t*asa_t, hrp.Z + vel.Z*asa_t)
	end
	return asa_vt, asa_t
end

function asResolve(itemType, inst)
	if not paGetItemMeta then return nil end
	asr_ok, asr_m = pcall(paGetItemMeta, itemType)
	if not asr_ok or type(asr_m) ~= "table" then return nil end
	asr_ps = asr_m.projectileSource
	if not asr_ps and asr_m.multiProjectileSource then
		for _, v in pairs(asr_m.multiProjectileSource) do
			if type(v) == "table" then asr_ps = v break end
		end
	end
	if not asr_ps or type(asr_ps) ~= "table" then return nil end
	asr_proj = nil
	if type(asr_ps.projectileType) == "function" then
		asr_ok2, asr_res = pcall(asr_ps.projectileType, itemType)
		if asr_ok2 and type(asr_res) == "string" then asr_proj = asr_res end
	end
	asr_proj = asr_proj or itemType
	return { projectile = asr_proj }
end

function asIsSpectator(team) return team ~= nil and tostring(team.Name):lower():find("spectat") ~= nil end

function asTrackUpdate(model, pos, now, rawVel)
	tr = asTrack[model]
	if not tr then tr = {c = 0}; asTrack[model] = tr end
	if tr.t4 and now - tr.t4 > 0.2 then tr.c = 0 end
	tr.x1, tr.y1, tr.z1, tr.t1 = tr.x2, tr.y2, tr.z2, tr.t2
	tr.x2, tr.y2, tr.z2, tr.t2 = tr.x3, tr.y3, tr.z3, tr.t3
	tr.x3, tr.y3, tr.z3, tr.t3 = tr.x4, tr.y4, tr.z4, tr.t4
	tr.x4, tr.y4, tr.z4, tr.t4 = pos.X, pos.Y, pos.Z, now
	if tr.c < 4 then tr.c = tr.c + 1 end
	if tr.c >= 2 and tr.t1 and (now - tr.t1) > 0.001 then
		atd = now - tr.t1
		atv = Vector3.new((tr.x4 - tr.x1)/atd, (tr.y4 - tr.y1)/atd, (tr.z4 - tr.z1)/atd)
		if atv.Magnitude > 250 then atv = atv.Unit * 250 end
		return atv
	end
	return rawVel
end

function asPartFor(model)
	asp_mode = ProjectileAssist.Values["Target Part"] or "Torso"
	asp_torso = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
	if asp_mode == "Head" then return model:FindFirstChild("Head") or asp_torso end
	if asp_mode == "Random" then
		asp_cached = asRandCache[model]; if asp_cached and asp_cached.Parent then return asp_cached end
		asp_pool, asp_pref = {}, {}
		for _, asp_d in pairs(model:GetDescendants()) do
			if asp_d:IsA("BasePart") then table.insert(asp_pool, asp_d); if table.find(PA_LIMB_NAMES, asp_d.Name) then table.insert(asp_pref, asp_d) end end
		end
		asp_src = (#asp_pref > 0) and asp_pref or asp_pool
		asp_pick = (#asp_src > 0) and asp_src[math.random(1, #asp_src)] or asp_torso
		asRandCache[model] = asp_pick; return asp_pick
	end
	return asp_torso
end

function asHasLOS(origin, part)
	ash_char = Player.Character
	if ash_char then asWallParams.FilterDescendantsInstances = { ash_char, part.Parent } else asWallParams.FilterDescendantsInstances = { part.Parent } end
	return G.Services.Workspace:Raycast(origin, part.Position - origin, asWallParams) == nil
end

function asConsider(model, part, rawVel)
	asRoot = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
	if not asRoot then return end
	asDvel = asTrackUpdate(model, asRoot.Position, asNow, rawVel)
	if not part then return end
	asc_d = part.Position - asOrigin; if asc_d.Magnitude < 0.01 then return end
	asc_ang = math.acos(math.clamp(asc_d.Unit:Dot(asLook), -1, 1)); if asc_ang > asHalf then return end
	if ProjectileAssist.Values["Ignore Behind Walls"] and not asHasLOS(asOrigin, part) then return end
	if asc_ang < asBestAng then asBestAng = asc_ang; asBestModel = model; asBestPart = part; asBestVel = asDvel end
end

function asPickTarget()
	asBestAng = math.huge; asBestModel, asBestPart, asBestVel = nil, nil, nil
	if ProjectileAssist.Values["Target Players"] then
		for _, aspl in ipairs(EntityCache.players) do
			if not asIsSpectator(aspl.Team) then
				asc = aspl.Character
				if asc then asch = asc:FindFirstChild("HumanoidRootPart"); if asch then asConsider(asc, asPartFor(asc), asch.AssemblyLinearVelocity) end end
			end
		end
	end
	if ProjectileAssist.Values["Target NPCs/Dummies"] then
		for _, asm in ipairs(EntityCache.npcs) do asConsider(asm, asPartFor(asm), Vector3.zero) end
	end
	return asBestModel, asBestPart, asBestVel
end

function asTick()
	asOk, asErr = pcall(function()
		-- DYNAMIC LOOKUP: This ensures it never breaks on respawn/equip (From Script 2)
		asHandler = nil
		if asKnit and asKnit.Controllers then
			for _, asC in pairs(asKnit.Controllers) do
				if asC and asC.projectileHandler then asHandler = asC.projectileHandler; break end
			end
		end
		if not asHandler then asAssisted = false; return end

		asShould = false
		if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
			asCam = G.Services.Workspace.CurrentCamera
			if asCam then
				asChar = Player.Character
				asHrp = asChar and asChar:FindFirstChild("HumanoidRootPart")
				asHum = asChar and asChar:FindFirstChildOfClass("Humanoid")

				if asHrp and asHum and asHum.Health > 0 and not asIsSpectator(Player.Team) then
					asTool = asChar:FindFirstChildOfClass("Tool")
					asHi = asChar:FindFirstChild("HandInvItem"); asHv = asHi and asHi.Value
					asHname = asHv and (typeof(asHv) == "Instance" and asHv.Name or tostring(asHv)) or (asTool and asTool.Name) or nil
					asHeldLower = asHname and asHname:lower() or ""
					asHinst = asHname and paInv and paInv:FindFirstChild(asHname) or nil

					-- INSTANT ENGAGEMENT: Removed the camera magnitude check and strict ammo/meta requirements (From Script 1)
					if asHinst or asTool then
						asL = asHinst and asResolve(asHname, asHinst) or nil
						asPm = (asL and PA_PROJ_META[asL.projectile]) or nil

						local ignorePearl = ProjectileAssist.Values["Ignore Telepearls"] and (asHeldLower:find("telepearl") or (asL and asL.projectile == "telepearl"))
						local ignoreFire = ProjectileAssist.Values["Ignore Fireballs"] and (asHeldLower:find("fireball") or (asL and asL.projectile == "fireball"))

						if not ignorePearl and not ignoreFire then
							asShould = true 
						end
					end
				end
			end
		end

		if not asShould then
			if asAssisted then asHandler.targetPoint = nil; asAssisted = false end
			return
		end

		asLook = asCam.CFrame.LookVector; asOrigin = asCam.CFrame.Position
		asHalf = math.rad((ProjectileAssist.Values["FOV"] or 100) * PA_FOV_SCALE)
		asNow = tick()
		asModel, asPart, asVel = asPickTarget()
		if not asModel or not asPart then
			if asAssisted then asHandler.targetPoint = nil; asAssisted = false end
			return
		end

		asMuzzle = nil
		if asTool then asH = asTool:FindFirstChild("Handle"); if asH then asBO = asH:FindFirstChild("BulletOrigin"); if asBO and asBO:IsA("Attachment") then asMuzzle = asBO.WorldPosition end end end
		if not asMuzzle then asMuzzle = asHrp.Position end
		asSolveO = asMuzzle + Vector3.new(0, 2, 0)

		asHum2 = asModel:FindFirstChildOfClass("Humanoid")
		asAir2 = (asHum2 and asHum2.FloorMaterial == Enum.Material.Air) or math.abs(asVel.Y) > 2
		asLeadY = asAir2 and asVel.Y or 0
		asTgtG = asAir2 and (G.Services.Workspace.Gravity or 196.2) or 0
		asLead = Vector3.new(asVel.X, asLeadY, asVel.Z)
		if asLead.Magnitude > 200 then asLead = asLead.Unit * 200 end

		-- UNIVERSAL FALLBACK: If projectile has no meta, defaults to a fast velocity so it always works (From Script 1)
		local baseVel = (asPm and asPm.launchVelocity) or 150
		local handlerMult = asHandler.velocityMultiplier or 1
		asEffV = baseVel * handlerMult

		local predLife = (asPm and (asPm.predictionLifetimeSec or asPm.lifetimeSec)) or 3
		local predGrav = (asPm and asPm.gravitationalAcceleration) or 0

		asVt, asT = asAim(asSolveO, asPart.Position, asLead, asEffV, predGrav, predLife, asTgtG)
		if not asVt then
			if asAssisted then asHandler.targetPoint = nil; asAssisted = false end
			return
		end

		asHandler.targetPoint = asSolveO + asVt.Unit * 1000
		asHandler.lockedAimPoint = nil
		asAssisted = true
	end)
	if not asOk and not asErrShown then asErrShown = true; warn("[ProjectileAssist] " .. tostring(asErr)) end
end

