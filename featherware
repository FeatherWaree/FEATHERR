Nuker.Callbacks.OnToggle = function(state)
	loops["nuker"] = state
	if NukerConnection then
		NukerConnection:Disconnect()
		NukerConnection = nil
	end
	updateNukerHighlight(nil)
	hideHpBar()
	nkClearPath()
	nkStopLegitEffects()
	nkDecision = nil

	if not loops["nuker"] then return end

	NukerConnection = FWNoModules.TrackFrameConnection(G.Services.RunService.Heartbeat:Connect(function()
		if not loops["nuker"] then
			nkStopLegitEffects()
			return
		end
		char = Player.Character
		if not char or not char:FindFirstChild("HumanoidRootPart") then
			updateNukerHighlight(nil)
			updateCustomHpBar(nil)
			nkClearPath()
			nkStopLegitEffects()
			return
		end
		hrp = char.HumanoidRootPart
		cam = G.Services.Workspace.CurrentCamera
		if not cam then return end

		nukerMode = Nuker.Values["Mode"] or "Blatant"
		if nukerMode ~= "Blatant" and nukerMode ~= "Legit" then nukerMode = "Blatant" end
		bedOnly = Nuker.Values["Bed Only"] or false
		range = Nuker.Values["Break Range"] or 21
		now = os.clock()

		-- ============ LEGIT ============
		if nukerMode == "Legit" then
			held = nkHeldName()
			autoTool = Nuker.Values["Auto Tool"] or false
			inv = FWNoModules.GetPrivateInventory(Player.Name)

			if not autoTool and (not held or not table.find(nkValidTools, held)) then
				updateCustomHpBar(nil)
				nkClearPath()
				nkStopLegitEffects()
				return
			end

			target, groupName = nkPickTarget(char, range)
			if not target then
				updateCustomHpBar(nil)
				nkClearPath()
				nkStopLegitEffects()
				return
			end

			if not nkAngleOk(cam, target.Position) then
				updateCustomHpBar(nil)
				nkStopLegitEffects()
				return
			end

			eval = nkEvalTarget(target, char, range, groupName == "bed")
			if eval and Nuker.Values["Mining Path"] then
				nkRenderPath(eval.cells)
			else
				nkClearPath()
			end

			if eval and not eval.open and eval.outer then
				solid = blockAtPoint(eval.outer, char)
				if solid and nkIsBreakableName(solid.Name) then
					minePoint = eval.outer
					mineBlock = solid
				else
					updateCustomHpBar(nil)
					nkStopLegitEffects()
					return
				end
			else
				mineBlock = target
				minePoint = eval and eval.bedPoint or target.Position
			end

			nkAutoToolCheck(mineBlock, now)
			if now < nkSwapWaitUntil then
				updateCustomHpBar(mineBlock)
				return
			end

			if Nuker.Values["Use Item Cooldowns"] then
				cool = nkItemCooldown(held)
			else
				cool = Nuker.Values["Break Speed"] or 0.3
			end
			if now - nkLegitLastBreak < cool then
				updateCustomHpBar(mineBlock)
				return
			end
			nkLegitLastBreak = now

			cellCenter = nkGridOf(minePoint)
			fireBreak(cellCenter, minePoint, (hrp.Position - minePoint).Unit)
			nkPredictHit(mineBlock, cellCenter)
			nkPlayLegitHit(mineBlock.Name, cellCenter)
			updateCustomHpBar(mineBlock)
			return
		end

		-- ============ BLATANT (Auto Tool now works here) ============
		if now - nkDecisionTime > 0.25 then
			nkDecisionTime = now
			nkDecision = nil
			if isGroupEnabled("bed") then
				candBeds = {}
				for _, b in ipairs(beds) do
					if b and b.Parent and not isOwnTeam(b) then
						d = (hrp.Position - b.Position).Magnitude
						if d <= range + 12 then
							table.insert(candBeds, {b = b, d = d})
						end
					end
				end
				table.sort(candBeds, function(a, b) return a.d < b.d end)
				for i = 1, math.min(#candBeds, 3) do
					ev = nkEvalTarget(candBeds[i].b, char, range, true)
					if ev and (not nkDecision or ev.cost < nkDecision.cost) then
						nkDecision = ev
					end
				end
			end
		end

		mineBlock = nil
		blatBp, blatHit, blatNorm, blatCf, blatSize = nil, nil, nil, nil, nil

		if nkDecision then
			if nkDecision.open then
				mineBlock = nkDecision.target
				side = nkDecision
				blatBp = nkGridOf(side.bedPoint)
				blatHit = side.bedPoint + side.dir * 0.5
				blatNorm = side.dir
				blatCf = mineBlock.CFrame
				blatSize = mineBlock.Size
			else
				solid = blockAtPoint(nkDecision.outer, char)
				if solid and nkIsBreakableName(solid.Name) then
					mineBlock = solid
					blatBp = nkGridOf(nkDecision.outer)
					blatHit = nkDecision.outer
					blatNorm = (hrp.Position - nkDecision.outer).Unit
					blatCf = CFrame.new(blatBp.X*3, blatBp.Y*3, blatBp.Z*3)
					blatSize = Vector3.new(3,3,3)
				end
			end
		elseif not bedOnly then
			nearestTarget = nil
			for _, g in ipairs(nkGroupPriority) do
				if g ~= "bed" and isGroupEnabled(g) then
					shortest = range
					for _, blk in ipairs(targetMap[g]) do
						if blk and blk.Parent then
							d = (hrp.Position - blk.Position).Magnitude
							if d < shortest then
								shortest = d
								nearestTarget = blk
							end
						end
					end
					if nearestTarget then break end
				end
			end

			if nearestTarget then
				tEv = nkEvalTarget(nearestTarget, char, range, false)
				if tEv and not tEv.open and tEv.outer then
					solid = blockAtPoint(tEv.outer, char)
					if solid and nkIsBreakableName(solid.Name) then
						mineBlock = solid
						blatBp = nkGridOf(tEv.outer)
						blatHit = tEv.outer
						blatNorm = (hrp.Position - tEv.outer).Unit
						blatCf = CFrame.new(blatBp.X*3, blatBp.Y*3, blatBp.Z*3)
						blatSize = Vector3.new(3,3,3)
					end
				else
					rayParams = RaycastParams.new()
					rayParams.FilterType = Enum.RaycastFilterType.Exclude
					rayParams.FilterDescendantsInstances = {char, nearestTarget}
					rayParams.IgnoreWater = true
					rayResult = G.Services.Workspace:Raycast(cam.CFrame.Position, nearestTarget.Position - cam.CFrame.Position, rayParams)
					if rayResult and rayResult.Instance and (rayResult.Instance == nearestTarget or rayResult.Instance:IsDescendantOf(nearestTarget)) then
						mineBlock = rayResult.Instance
						inside = rayResult.Position - rayResult.Normal * 0.5
						blatBp = nkGridOf(inside)
						blatHit = rayResult.Position
						blatNorm = rayResult.Normal
						blatCf = CFrame.new(blatBp.X*3, blatBp.Y*3, blatBp.Z*3)
						blatSize = Vector3.new(3,3,3)
					else
						mineBlock = nearestTarget
						blatBp = nkGridOf(nearestTarget.Position)
						blatHit = nearestTarget.Position
						blatNorm = (cam.CFrame.Position - nearestTarget.Position).Unit
						blatCf = nearestTarget.CFrame
						blatSize = nearestTarget.Size
					end
				end
			end
		end

		if mineBlock then
			nkAutoToolCheck(mineBlock, now) -- Auto Tool in Blatant
			if blatBp then
				tryBreak(blatBp, blatHit, blatNorm, blatCf, blatSize)
				nkPredictHit(mineBlock, blatBp)
			end
			updateCustomHpBar(mineBlock)
		else
			updateNukerHighlight(nil)
			updateCustomHpBar(nil)
		end
	end))
end
function cleanupAlarm()
	if activeAlarmData.model then
		activeAlarmData.model:Destroy()
		activeAlarmData.model = nil
	end
	if activeAlarmData.sound then
		activeAlarmData.sound:Destroy()
		activeAlarmData.sound = nil
	end
	if activeAlarmData.spinConnection then
		activeAlarmData.spinConnection:Disconnect()
		activeAlarmData.spinConnection = nil
	end
	if activeAlarmData.detectLoop then
		task.cancel(activeAlarmData.detectLoop)
		activeAlarmData.detectLoop = nil
	end
	if activeAlarmData.flashLoop then
		task.cancel(activeAlarmData.flashLoop)
		activeAlarmData.flashLoop = nil
	end
	for _, highlight in pairs(activeAlarmData.activeHighlights) do
		if highlight and highlight.Parent then
			highlight:Destroy()
		end
	end
	activeAlarmData.activeHighlights = {}
end

function findPlayerBed()
	for _, child in pairs(G.Services.Workspace:GetDescendants()) do
		if child.Name == "bed" then
			if child.Parent.Name ~= "MapCFrames" then
				if child:GetAttribute("TeamId") == Player:GetAttribute("Team") then
					return child
				end
			end
		end
	end
	return nil
end

playerBed = nil

BedAlarm.Callbacks.OnToggle = function(state)
	loops["bed alarm"] = state

	if loops["bed alarm"] then
		playerBed = findPlayerBed()

		if playerBed then
			alarmTemplate = G.Services.RS.Assets.Effects:FindFirstChild("BedAlarm", true) 
			if not alarmTemplate then return end

			local alarm = FWNoModules.OwnInstance(alarmTemplate:Clone())
			activeAlarmData.model = alarm
			alarm.Parent = G.Services.Workspace

			alarm:SetAttribute("RotationSpeed", 90)

			local bedCFrame = playerBed:IsA("Model") and playerBed:GetPivot() or playerBed.CFrame
			alarm:PivotTo(bedCFrame * CFrame.new(0, 15, 0))

			local alarmSound = FWNoModules.OwnInstance(Instance.new("Sound"))
			alarmSound.SoundId = "rbxassetid://7396762708"
			alarmSound.Looped = true
			alarmSound.Volume = 0.75

			alarmSound.RollOffMinDistance = 1000
			alarmSound.RollOffMaxDistance = 5000

			local soundPart = alarm.PrimaryPart or alarm:FindFirstChildWhichIsA("BasePart", true)
			alarmSound.Parent = soundPart
			activeAlarmData.sound = alarmSound

			local isTriggered = false

			activeAlarmData.spinConnection = FWNoModules.TrackFrameConnection(G.Services.RunService.Heartbeat:Connect(function(dt)
				if alarm and alarm.Parent then
					local currentSpeed = isTriggered and 270 or alarm:GetAttribute("RotationSpeed")
					alarm:PivotTo(alarm:GetPivot() * CFrame.Angles(0, math.rad(currentSpeed * dt), 0))
				end
			end))

			activeAlarmData.detectLoop = task.spawn(function()
				while loops["bed alarm"] and task.wait(0.5) do
					local someoneIsNear = false

					for _, enemy in pairs(FWNoModules.PlayerSnapshot()) do
						if enemy == Player or enemy:GetAttribute("Team") == Player:GetAttribute("Team") then 
							continue 
						end

						local character = enemy.Character
						local rootPart = character and character:FindFirstChild("HumanoidRootPart")

						if rootPart then
							local distance = (rootPart.Position - bedCFrame.Position).Magnitude

							if distance <= 30 then
								someoneIsNear = true

								if not activeAlarmData.activeHighlights[enemy] then
									local highlight = FWNoModules.OwnInstance(Instance.new("Highlight"))
									highlight.FillTransparency = 0.7
									highlight.OutlineTransparency = 0
									highlight.FillColor = Color3.fromRGB(204, 28, 28)
									highlight.OutlineColor = Color3.fromRGB(194, 33, 33)
									highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
									highlight.Parent = character

									activeAlarmData.activeHighlights[enemy] = highlight

									NotificationSystem.Notify("Bed Alarm", "Someone is at your base!", 0.5)

								else
									if activeAlarmData.activeHighlights[enemy].Parent ~= character then
										activeAlarmData.activeHighlights[enemy].Parent = character
									end
								end
							else
								if activeAlarmData.activeHighlights[enemy] then
									activeAlarmData.activeHighlights[enemy]:Destroy()
									activeAlarmData.activeHighlights[enemy] = nil
								end
							end
						else
							if activeAlarmData.activeHighlights[enemy] then
								activeAlarmData.activeHighlights[enemy]:Destroy()
								activeAlarmData.activeHighlights[enemy] = nil
							end
						end
					end

					for savedEnemy, highlight in pairs(activeAlarmData.activeHighlights) do
						if not savedEnemy.Parent then
							highlight:Destroy()
							activeAlarmData.activeHighlights[savedEnemy] = nil
						end
					end

					-- SOUND LOGIC: Check if the state just changed this cycle
					if someoneIsNear and not isTriggered then
						-- Someone entered the base
						if activeAlarmData.sound and not activeAlarmData.sound.IsPlaying then
							activeAlarmData.sound:Play()
						end
					elseif not someoneIsNear and isTriggered then
						-- Everyone left the base
						if activeAlarmData.sound then
							activeAlarmData.sound:Stop()
						end
					end

					isTriggered = someoneIsNear
				end
			end)

			activeAlarmData.flashLoop = task.spawn(function()
				local toggleState = true
				while loops["bed alarm"] and task.wait(0.5) do

					if isTriggered then
						toggleState = not toggleState 
					else
						toggleState = true 
					end

					local sidesColor = toggleState and Color3.fromRGB(226, 88, 88) or Color3.fromRGB(90, 25, 25)
					if alarm:FindFirstChild("Sides") then
						for _, part in pairs(alarm.Sides:GetChildren()) do
							if part:IsA("BasePart") then part.Color = sidesColor end
						end
					end

					if alarm:FindFirstChild("Recolor") then
						local recolor = alarm.Recolor
						if recolor:FindFirstChild("Inner") then
							recolor.Inner.Color = toggleState and Color3.fromRGB(195, 70, 70) or Color3.fromRGB(75, 20, 20)
						end
						if recolor:FindFirstChild("Outer") then
							recolor.Outer.Color = toggleState and Color3.fromRGB(188, 74, 74) or Color3.fromRGB(75, 20, 20)
						end
						if recolor:FindFirstChild("Bulb") then
							recolor.Bulb.Color = toggleState and Color3.fromRGB(195, 70, 70) or Color3.fromRGB(75, 20, 20)

							if recolor.Bulb:FindFirstChild("GlowAttachment") and recolor.Bulb.GlowAttachment:FindFirstChild("Glow") then
								local glowColor = toggleState and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(50, 0, 0)
								recolor.Bulb.GlowAttachment.Glow.Color = ColorSequence.new(glowColor)
							end
						end
					end
				end
			end)
		end
	else
		cleanupAlarm()
	end
end

