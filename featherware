		return kaliyahData.punchAnimId
	end

	pcall(function()
		if canRequire then
			AnimationType = require(ReplicatedStorage:WaitForChild("TS", 5):WaitForChild("animation", 5):WaitForChild("animation-type", 5)).AnimationType
			GameAnimationUtil = require(ReplicatedStorage:WaitForChild("TS", 5):WaitForChild("animation", 5):WaitForChild("animation-util", 5)).GameAnimationUtil
			DragonSlayerConstants = require(ReplicatedStorage:WaitForChild("TS", 5):WaitForChild("games", 5):WaitForChild("bedwars", 5):WaitForChild("kit", 5):WaitForChild("kits", 5):WaitForChild("dragon-slayer", 5):WaitForChild("dragon-slayer-constants", 5)).DragonSlayerConstants

