			if now - (whisperData.lastHeal or 0) >= 1.5 then 
				local hpPercent = AutoWhisper.Values["Heal when below %"] or 80
				local hpThreshold = tHum.MaxHealth * (hpPercent / 100)
				if tHum.Health <= hpThreshold then
					pcall(function()
						whisperEvents:FireServer({target = targetPlayer, ability = "OWL_HEAL"})
					end)
					whisperData.lastHeal = now
				end
			end
		end

		if AutoWhisper.Values["Auto Fly"] then
			local now = os.clock()
			if now - (whisperData.lastFly or 0) >= 1.0 then 
				local tHRP = targetChar:FindFirstChild("HumanoidRootPart")
				if tHRP then
					local belowStuds = AutoWhisper.Values["Fly when below"] or -50
					if tHRP.Position.Y <= belowStuds then
						pcall(function()
							whisperEvents:FireServer({target = targetPlayer, ability = "OWL_LIFT"})
						end)
						whisperData.lastFly = now
					end
				end
			end
		end
	end

	-- 3. Auto Shoot (Aura)
	-- 3. Auto Shoot (Aura)
	if AutoWhisper.Values["Auto Shoot"] then
		now = os.clock()
		shootDelay = AutoWhisper.Values["Shoot Delay"] or 0.5
		if now - (whisperData.lastShot or 0) >= shootDelay then
			owlPart = owl and (owl.PrimaryPart or owl:FindFirstChildWhichIsA("BasePart"))
			shootTarget = owlPart and whisperGetTarget(owlPart.Position) or nil
			if shootTarget then
				whisperShoot(owl, shootTarget)
				whisperData.lastShot = now
			end
		end
	end
end

