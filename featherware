			if not loops["kaidaka"] then break end

			if not (KaidaKa.Values["Target Players"] or KaidaKa.Values["Target NPCs/Dummies"]) then
				currentKaTarget = nil
				kaHighlight.Adornee = nil
				boxVisualizer.Adornee = nil
				swingRequested = false
				continue
			end

			char = Player.Character
			if not char or not char:FindFirstChild("HumanoidRootPart") then
				currentKaTarget = nil
				kaHighlight.Adornee = nil
				boxVisualizer.Adornee = nil
				swingRequested = false
				continue
