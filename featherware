function tsDoMove(dir)
	if dir.Magnitude < 0.01 then ts_hum:Move(Vector3.zero, false); return end
	ts_hum:Move(dir.Unit, false)
end

function tsTick()
	if not ts.on then return end
	ts_char = Player.Character
	ts_hrp = ts_char and ts_char:FindFirstChild("HumanoidRootPart")
	ts_hum = ts_char and ts_char:FindFirstChildOfClass("Humanoid")
	if not ts_hrp or not ts_hum or ts_hum.Health <= 0 then ts.lock = nil; return end

	-- [FIXED]: Removed `loops["fly"]` from this block so the script no longer turns off movement when flying.
	if loops and loops["swim"] then ts.lock = nil; ts_hum:Move(Vector3.zero, false); return end

	if tsUserMoving() then ts.lock = nil; return end

	ts_myPos = ts_hrp.Position
	ts.lock = tsFindTarget()
	if not ts.lock then ts_hum:Move(Vector3.zero, false); return end
	ts_tHRP = ts.lock:FindFirstChild("HumanoidRootPart") or ts.lock.PrimaryPart
	if not ts_tHRP then ts.lock = nil; return end

	ts_toT = ts_tHRP.Position - ts_myPos
	ts_hDist = math.sqrt(ts_toT.X * ts_toT.X + ts_toT.Z * ts_toT.Z)
	if ts_hDist < 0.05 then ts_hum:Move(Vector3.zero, false); return end
	ts_dirTo = Vector3.new(ts_toT.X / ts_hDist, 0, ts_toT.Z / ts_hDist)
	ts_perp = Vector3.new(-ts_dirTo.Z, 0, ts_dirTo.X)
	ts_range = TargetStrafe.Values["Strafe Range"] or 8
	ts_mode = TargetStrafe.Values["Strafe Mode"] or "Strafe"
	ts_now = tick()

	if ts_mode == "Custom" then
		if #ts_waypoints == 0 then tsDoMove(Vector3.zero); return end
		if ts.wpIndex > #ts_waypoints then ts.wpIndex = 1 end
		ts_wp = ts_waypoints[ts.wpIndex]
		ts_wpos = Vector3.new(ts_tHRP.Position.X + ts_wp.x, ts_tHRP.Position.Y + ts_wp.y, ts_tHRP.Position.Z + ts_wp.z)
		ts_wd = ts_wpos - ts_myPos
		ts_whDist = math.sqrt(ts_wd.X * ts_wd.X + ts_wd.Z * ts_wd.Z)
		if ts_whDist < 1.5 then
			ts.wpIndex = ts.wpIndex + 1
			if ts.wpIndex > #ts_waypoints then ts.wpIndex = 1 end
			tsDoMove(Vector3.zero); return
		end
		ts_wdir = Vector3.new(ts_wd.X / ts_whDist, 0, ts_wd.Z / ts_whDist)
		if tsDirClear(ts_wdir) then
			tsDoMove(ts_wdir); ts.blockedTime = 0
		else
			ts.blockedTime = ts.blockedTime + 0.016
			if ts.blockedTime > 0.5 then ts.wpIndex = ts.wpIndex + 1; ts.blockedTime = 0 end
			tsDoMove(Vector3.zero)
		end
		return
	end

	if ts_now >= ts.flipAt then
		ts.sign = -ts.sign
		ts.flipAt = ts_now + (TS_FLIP_MIN + math.random() * (TS_FLIP_MAX - TS_FLIP_MIN))
	end

	ts_radialErr = ts_hDist - ts_range
	ts_radial = 0
	if math.abs(ts_radialErr) > 1 then
		ts_radial = math.clamp(ts_radialErr * 0.35, -0.6, 0.6)
	end

	ts_move = ts_perp * ts.sign + ts_dirTo * ts_radial

	if not tsDirClear(ts_move.Unit) then
		ts.sign = -ts.sign
		ts_move = ts_perp * ts.sign + ts_dirTo * ts_radial
		if not tsDirClear(ts_move.Unit) then
			ts_move = ts_dirTo * ts_radial
			if ts_move.Magnitude < 0.01 or not tsDirClear(ts_move.Unit) then
				tsDoMove(Vector3.zero); return
			end
		end
	end
	tsDoMove(ts_move)
end

TargetStrafe.Callbacks.OnToggle = function(state)
	loops["target strafe"] = state
	ts.on = state
	if state then
		startEntityCache()
		ts.lock = nil; ts.sign = 1; ts.flipAt = tick(); ts.wpIndex = 1
		if not ts.conn then ts.conn = G.Services.RunService:BindToRenderStep("TargetStrafeMove", 300, tsTick) end
	else
		if ts.conn then G.Services.RunService:UnbindFromRenderStep("TargetStrafeMove"); ts.conn = nil end
		ts.lock = nil
		pcall(function()
			ts_c2 = Player.Character; ts_h2 = ts_c2 and ts_c2:FindFirstChildOfClass("Humanoid")
			if ts_h2 and not tsUserMoving() then ts_h2:Move(Vector3.zero, false) end
		end)
	end
end
