    end
    local function suspend(job,problem)
        job.problem=tostring(problem)
        local owner=job.owner
        if owner then
            owner.ProfilePending=true
            if FWNoModules.CancelFeature then FWNoModules.CancelFeature(owner)end
            if FWNoModules.CleanupFeatureObjects then FWNoModules.CleanupFeatureObjects(owner)end
            if owner.ProfileLoopKey and FWNoModules.SetLoop then FWNoModules.SetLoop(owner.ProfileLoopKey,false)end
        end
    end
    local function resumeOwner(owner)
        if not owner or not owner.ProfilePending or not owner.Toggled or not owner.ProfileToggleKey then return end
        for _,job in pairs(api.pending)do if job.owner==owner then return end end
        api.TryApply(owner.ProfileToggleKey,function(value)owner:SetProfileState(value)end,true,owner)
    end
    function api.TryApply(key,callback,value,owner,stopping)
        local job={key=key,callback=callback,value=clone(value),owner=owner,generation=applyGeneration}
        local previous=api.pending[key];if previous then cancelJob(previous)end
        api.pending[key]=job
        local function run()
            job.thread=coroutine.running()
            local ok,problem=pcall(callback,api.Value(job.value))
            job.finished=true;job.ok=ok;job.problem=problem
            if job.generation~=applyGeneration or api.pending[key]~=job then return end
            if ok then
                api.pending[key]=nil
                if job.timeout and applyTask then pcall(applyTask.cancel,job.timeout)end
                resumeOwner(owner)
            elseif not stopping then suspend(job,problem)end
        end
        if applyTask then
            local function start()job.thread=applyTask.spawn(run)end
            if FWNoModules.WithSessionOwner then FWNoModules.WithSessionOwner(start)else start()end
        else run()end
        if stopping then
            -- Tracked feature work is already cancelled. Do not allow a yielding
            -- old-place cleanup to resume after the next profile has started.
            cancelJob(job);api.pending[key]=nil
            return true
        end
        if job.finished then
            if not job.ok and not unavailable(job.problem)and not(owner and key==owner.ProfileToggleKey)then error(job.problem,0)end
            return job.ok
        end
        local function timeout()
            if api.pending[key]~=job or job.generation~=applyGeneration or job.finished then return end
            cancelJob(job);job.finished=true;job.ok=false
            suspend(job,"Feature dependencies are not ready in this place.")
        end
        local function schedule()job.timeout=applyTask.delay(.75,timeout)end
        if FWNoModules.WithSessionOwner then FWNoModules.WithSessionOwner(schedule)else schedule()end
        return false
    end
    function api.RetryDeferred()
        if api.busy or not api.ready then return end
        local jobs={}
        for _,job in pairs(api.pending)do if job.finished then jobs[#jobs+1]=job end end
        for _,job in ipairs(jobs)do
            local desired=_G.SavedConfig[job.key]
            if desired==nil then desired=job.value end
            pcall(api.TryApply,job.key,job.callback,api.Value(clone(desired)),job.owner)
        end
        if _G.__FW_REFRESH_MODULE_LIST then _G.__FW_REFRESH_MODULE_LIST()end
    end
    function api.WatchAvailability()
        if api.availabilityConnected or not FWNoModules.Connect then return end
        api.availabilityConnected=true
        local queued=false
        local function changed()
            if not next(api.pending)or queued then return end
            queued=true
            applyTask.delay(.2,function()queued=false;api.RetryDeferred()end)
        end
        local players=game:GetService("Players")
        local player=players.LocalPlayer
        if player then
            local characterConnection
            local function watchCharacter(character)
                if characterConnection then FWNoModules.ReleaseConnection(characterConnection)end
                characterConnection=FWNoModules.Connect(character.ChildAdded,function(object)
                    if object.Name=="HumanoidRootPart"or object:IsA("Humanoid")then changed()end
                end)
