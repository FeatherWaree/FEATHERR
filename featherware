martinLoadRemote = function()
	if martinData.abilityRemote then return true end
	pcall(function()
		eventsFolder = ReplicatedStorage:WaitForChild("events-@easy-games/game-core:shared/game-core-networking@getEvents.Events", 5)
		martinData.abilityRemote = eventsFolder:WaitForChild("useAbility", 5)
	end)
	return martinData.abilityRemote ~= nil
