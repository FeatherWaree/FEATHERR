grimPlayAnim = function()
	char = Player.Character
	if not char then return end
	hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	animator = hum:FindFirstChildOfClass("Animator")
	if not animator then return end

	if grimData.consumeAnim then grimData.consumeAnim:Destroy() end
	grimData.consumeAnim = Instance.new("Animation")
	grimData.consumeAnim.AnimationId = "rbxassetid://7228927934"

	pcall(function()
		grimData.consumeTrack = animator:LoadAnimation(grimData.consumeAnim)
		grimData.consumeTrack.Priority = Enum.AnimationPriority.Action
		grimData.consumeTrack.Looped = false
		grimData.consumeTrack:Play()
	end)
end

grimStopAnim = function()
	if grimData.consumeTrack then
		pcall(function() grimData.consumeTrack:Stop() end)
		grimData.consumeTrack:Destroy()
		grimData.consumeTrack = nil
	end
	if grimData.consumeAnim then
		grimData.consumeAnim:Destroy()
		grimData.consumeAnim = nil
	end
end

grimTryConsume = function(soulModel)
	if not loops["auto grim repear"] then return end
	if grimData.isConsuming then return end

	now = os.clock()
	if now - grimData.lastAttempt < 0.5 then return end

	if not soulModel or not soulModel.Parent then return end
	if soulModel.Name ~= "GrimReaperSoul" and not soulModel:FindFirstChild("Spirit") then return end

	token = soulModel:GetAttribute("GrimReaperSoulSecret")
	if not token then
		startTime = os.clock()
		repeat
			task.wait(0.05)
			token = soulModel:GetAttribute("GrimReaperSoulSecret")
		until token or (os.clock() - startTime > 2) or not soulModel.Parent
	end

	if not token or not soulModel.Parent then return end

	myChar = Player.Character
	if not myChar then return end
	myRoot = myChar:FindFirstChild("HumanoidRootPart")
	if not myRoot then return end

	spirit = soulModel:FindFirstChild("Spirit") or soulModel.PrimaryPart
	if not spirit then return end

	dist = (spirit.Position - myRoot.Position).Magnitude
	range = AutoGrimRepear.Values["Range"] or 500

	if dist > range then return end

	if not grimLoadRemote() then return end

	grimData.isConsuming = true
	grimData.lastAttempt = now

	task.spawn(function()
		if AutoGrimRepear.Values["Use Collect Animation"] then
			grimPlayAnim()
		end

		pcall(function()
			ConsumeSoulRemote:InvokeServer({secret = token})
		end)

		if AutoGrimRepear.Values["Use Collect Animation"] and grimData.consumeTrack then
			pcall(function()
				grimData.consumeTrack.Stopped:Wait()
			end)
		else
			task.wait(2.5)
		end

		grimStopAnim()
		grimData.isConsuming = false

		-- RE-SCAN: Instantly check for any other souls that spawned or were ignored while consuming
		task.wait(0.1)
		if loops["auto grim repear"] then
			for _, desc in ipairs(G.Services.Workspace:GetDescendants()) do
				if desc:IsA("Model") and desc.Name == "GrimReaperSoul" then
					task.spawn(grimTryConsume, desc)
				end
			end
		end
	end)
end

task.spawn(function()
	for _, desc in ipairs(G.Services.Workspace:GetDescendants()) do
		if desc:IsA("Model") and desc.Name == "GrimReaperSoul" then
			grimTryConsume(desc)
		end
	end
end)

