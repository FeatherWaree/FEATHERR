function trGetLine(trg_i)
	if not tr_pool[trg_i] then
		trg_f = FWNoModules.OwnInstance(Instance.new("Frame"))
		trg_f.BorderSizePixel = 0
		trg_f.AnchorPoint = Vector2.new(0.5, 0.5)
