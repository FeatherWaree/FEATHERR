zenoIsEnemy = function(plr)
	if not plr or plr == PlayersService.LocalPlayer then return false end
	if plr.Team and PlayersService.LocalPlayer.Team and plr.Team == PlayersService.LocalPlayer.Team then return false end
	if plr:GetAttribute("Spectating") or plr:GetAttribute("IsSpectator") then return false end
	return true
end

zenoGetTarget = function(maxDist)
	myChar = PlayersService.LocalPlayer.Character
	if not myChar then return nil, math.huge end
	myRoot = myChar:FindFirstChild("HumanoidRootPart")
	if not myRoot then return nil, math.huge end

	bestTarget = nil
	bestScore = math.huge

	for _, plr in ipairs(PlayersService:GetPlayers()) do
		if zenoIsEnemy(plr) and plr.Character then
			eRoot = plr.Character:FindFirstChild("HumanoidRootPart")
			eHum = plr.Character:FindFirstChildOfClass("Humanoid")
			if eRoot and eHum and eHum.Health > 0 then
				dist = (myRoot.Position - eRoot.Position).Magnitude
				if dist <= maxDist then
					if zenoSettings.targetMode == "Lowest HP" then
						hpPercent = eHum.Health / eHum.MaxHealth
						score = (hpPercent * 100000) + dist
						if score < bestScore then
							bestScore = score
							bestTarget = plr
						end
					else
						if dist < bestScore then
							bestScore = dist
							bestTarget = plr
						end
					end
				end
			end
		end
	end
	return bestTarget, bestScore
end

zenoGetEnemyCluster = function(minCrowd)
	bestTarget = nil
	bestCount = 0

	enemies = {}
	for _, plr in ipairs(PlayersService:GetPlayers()) do
		if zenoIsEnemy(plr) and plr.Character then
			eRoot = plr.Character:FindFirstChild("HumanoidRootPart")
			if eRoot then table.insert(enemies, eRoot) end
		end
	end

	for _, eRoot in ipairs(enemies) do
		count = 0
		for _, otherRoot in ipairs(enemies) do
			if (eRoot.Position - otherRoot.Position).Magnitude <= 15 then
				count = count + 1
			end
		end
		if count >= minCrowd and count > bestCount then
			bestCount = count
			bestTarget = eRoot
		end
	end

	return bestTarget
end

zenoFireAbility = function(abilityName, targetPos)
	if not zenoLoadRemotes() then return end

	args = {abilityName, {target = targetPos}}
	pcall(function()
		zenoData.abilityRemote:FireServer(unpack(args))
	end)

	if zenoData.store then
		pcall(function()
			duration = (abilityName == "LIGHTNING_STRIKE" and STRIKE_COOLDOWN) or (abilityName == "SHOCKWAVE" and SHOCKWAVE_COOLDOWN) or STORM_COOLDOWN
			expireTime = os.clock() + duration

			zenoData.store:dispatch({
				type = "CooldownStart", 
				cooldownId = abilityName, 
				duration = duration
			})

			zenoData.store:dispatch({
				type = "SetAbilityCooldown",
				ability = abilityName,
				expire = expireTime
			})
		end)
	end
end

zenoOnHitTriggered = function()
	if not loops["auto zeno"] then return end
	if zenoSettings.shockwaveMode ~= "On Hit" then return end

	maxTier = zenoGetMaxAvailableTier()

	if maxTier < 2 then return end

	tier = zenoGetStaffTier()

	now = os.clock()
	if now - zenoData.lastShockwave < SHOCKWAVE_COOLDOWN then return end

	didSwap = false

	if tier == 0 then
		if zenoSwapToStaff() then 
			didSwap = true 
		else
			return
		end
	end

	zenoFireAbility("SHOCKWAVE", Vector3.zero)
	zenoData.lastShockwave = now

	if didSwap then
		task.delay(0.25, zenoSwapBack)
	end
end

zenoSetupNamecallHook = function()
	if zenoData.namecallHook then return end
	if not canRequire then return end
	if not hookmetamethod or not getnamecallmethod or not checkcaller then return end

	zenoData.namecallHook = true
	print("[Auto Zeno] Executor supports hooks. Using safe __namecall SwordHit/ProjectileHit detection.")

	zenoData.oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
		local args = {...}
		local result = zenoData.oldNamecall(self, unpack(args))

		if not checkcaller() then
			pcall(function()
				method = getnamecallmethod()
				if method == "FireServer" or method == "InvokeServer" then
					remoteName = tostring(self)

					if remoteName == "SwordHit" or remoteName == "ProjectileHit" then
						zenoOnHitTriggered()
					end
				end
			end)
		end

		return result
	end)
end

zenoSetupDamageFallback = function()
	if zenoData.hitConn then return end

	pcall(function()
		netManaged = ReplicatedStorage:WaitForChild("rbxts_include", 5):WaitForChild("node_modules", 5):WaitForChild("@rbxts", 5):WaitForChild("net", 5):WaitForChild("out", 5):WaitForChild("_NetManaged", 5)
		entityDamaged = netManaged:WaitForChild("EntityDamageEvent", 5)

		zenoData.hitConn = entityDamaged.OnClientEvent:Connect(function(data)
			if typeof(data) == "table" then
				if data.entityInstance == PlayersService.LocalPlayer.Character or data.fromEntity == PlayersService.LocalPlayer.Character then
					zenoOnHitTriggered()
				end
			end
		end)
	end)
end

zenoLoop = function()
	if not loops["auto zeno"] then return end

	tier = zenoGetStaffTier()

	if tier == 0 then return end

	now = os.clock()
	myChar = PlayersService.LocalPlayer.Character
	myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	if not myRoot then return end

	-- 1. Auto Lightning Strike (Tier 1, 2, and 3 - All Staffs)
	if zenoSettings.autoStrike and now - zenoData.lastStrike >= STRIKE_COOLDOWN then
		nearest, _ = zenoGetTarget(100)
		if nearest then
			eRoot = nearest.Character:FindFirstChild("HumanoidRootPart")
			if eRoot then
				offset = Vector3.new(math.random(-2, 2), 0, math.random(-2, 2))
				zenoFireAbility("LIGHTNING_STRIKE", eRoot.Position + offset)
				zenoData.lastStrike = now
			end
		end
	end

	-- 2. Auto Shockwave In Range (Tier 2 and 3 ONLY)
	if tier >= 2 and zenoSettings.shockwaveMode == "In Range" and now - zenoData.lastShockwave >= SHOCKWAVE_COOLDOWN then
		nearest, _ = zenoGetTarget(zenoSettings.shockwaveRange)
		if nearest then
			zenoFireAbility("SHOCKWAVE", Vector3.zero)
			zenoData.lastShockwave = now
		end
	end

	-- 3. Auto Lightning Storm (Tier 3 ONLY)
	if tier >= 3 and zenoSettings.stormEnabled and now - zenoData.lastStorm >= STORM_COOLDOWN then
		clusterTarget = zenoGetEnemyCluster(zenoSettings.stormCrowdSize)
		if clusterTarget then
			zenoFireAbility("LIGHTNING_STORM", clusterTarget.Position)
			zenoData.lastStorm = now
		end
	end
end

