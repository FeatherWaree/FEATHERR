-- ===== block placer resolver (runs once; tries every known path, prints the winner) =====
function acPickMethod(p)
	for _, mn in ipairs({"placeBlock", "PlaceBlock", "place", "Place"}) do
		if type(p[mn]) == "function" then return mn end
	end
	return nil
end
function acTry(p, label)
	if acPlacer then return end
	if type(p) == "table" or type(p) == "userdata" then
		acMN = acPickMethod(p)
		if acMN then acPlacer = p; acPlaceMethod = acMN; acPlacePath = label end
	end
end
function acResolvePlacer()
	if acPlaceResolved then return end
	acPlaceResolved = true

	if not KnitClient then
		pcall(function()
			KnitClient = require(G.Services.RS.rbxts_include
				.node_modules["@easy-games"].knit.src).KnitClient
		end)
	end

	pcall(function()   -- 1: named controller
		acC = KnitClient and KnitClient.Controllers and KnitClient.Controllers.BlockPlacementController
		if acC then acTry(acC.blockPlacer or acC.placer, "BlockPlacementController") end
	end)
	pcall(function()   -- 2: search controllers by name
		if acPlacer or not (KnitClient and KnitClient.Controllers) then return end
		for k, c in pairs(KnitClient.Controllers) do
			if type(k) == "string" and k:lower():find("place") then
				acTry(c.blockPlacer or c.placer or c, "controller:" .. k)
				if acPlacer then break end
			end
		end
	end)
	pcall(function()   -- 3: client block engine
		if acPlacer then return end
		acCBE = require(Player.PlayerScripts.TS.lib["block-engine"]["client-block-engine"]).ClientBlockEngine
		if acCBE and acCBE.getBlockPlacer then acTry(acCBE:getBlockPlacer(), "ClientBlockEngine") end
	end)
	pcall(function()   -- 4: shared block engine
		if acPlacer then return end
		acBE = require(G.Services.RS.rbxts_include
			.node_modules["@easy-games"]["block-engine"].out).BlockEngine
		if acBE and acBE.getBlockPlacer then acTry(acBE:getBlockPlacer(), "BlockEngine") end
	end)

	if acPlacer then
		print("[AC-PLACE] placer found via", acPlacePath, "| method =", acPlaceMethod)
	else
		print("[AC-PLACE] NO placer instance -> mouse1click() fallback")
		pcall(function()
			if KnitClient and KnitClient.Controllers then
				acN = {}
				for k in pairs(KnitClient.Controllers) do if type(k) == "string" then table.insert(acN, k) end end
				print("[AC-PLACE] controllers seen:", table.concat(acN, ", "))
			end
		end)
	end
end

function acGetPlacePos()
	if acPlacer then
		acOk, acPos = pcall(function()
			acSel = acPlacer.clientManager and acPlacer.clientManager:getBlockSelector()
			if acSel then
				acInfo = acSel:getMouseInfo((BlockSelectorMode and BlockSelectorMode.PLACE) or 0)
				return acInfo and acInfo.placementPosition or nil
			end
		end)
		if acOk and acPos and acPos == acPos then return acPos end
	end
	if BlockSelector then
		acOk, acPos = pcall(function()
			acS = BlockSelector.new()
			acInfo = acS:getMouseInfo((BlockSelectorMode and BlockSelectorMode.PLACE) or 0)
			return acInfo and acInfo.placementPosition or nil
		end)
		if acOk and acPos and acPos == acPos then return acPos end
	end
	acM = Player:GetMouse()
	return acM and acM.Hit and acM.Hit.Position or nil
end

function acPlaceAtCursor()
	acResolvePlacer()
	if tick() - acLastPlace < 0.04 then return end
	acPos = acGetPlacePos()
	if not (acPos and acPos == acPos) then return end
	acLastPlace = tick()
	if acPlacer and acPlaceMethod then
		acOk, acErr = pcall(acPlacer[acPlaceMethod], acPlacer, acPos)
		if not acOk and not acPlaceDiag then acPlaceDiag = true; print("[AC-PLACE] placeBlock threw:", acErr) end
	else
		pcall(mouse1click)
	end
end

