function isOwnTeam(obj)
	myTeam = Player:GetAttribute("Team")
	objTeam = obj:GetAttribute("TeamId")
	if myTeam == nil then return false end
	return objTeam ~= nil and objTeam == myTeam
end

function isGroupEnabled(name)
	if Nuker.Values["Bed Only"] then return name == "bed" end
	bs = Nuker.Values["Break"]
	if type(bs) == "table" then
		if bs[name] == true or table.find(bs, name) then return true end
	end
	return false
end

nukerOverlap = OverlapParams.new()
nukerOverlap.FilterType = Enum.RaycastFilterType.Exclude

function cellSolid(point, char)
	nukerOverlap.FilterDescendantsInstances = {char}
	parts = G.Services.Workspace:GetPartBoundsInBox(CFrame.new(point), Vector3.new(2, 2, 2), nukerOverlap)
	return parts and #parts > 0
end

function blockAtPoint(point, char)
	nukerOverlap.FilterDescendantsInstances = {char}
	parts = G.Services.Workspace:GetPartBoundsInBox(CFrame.new(point), Vector3.new(2, 2, 2), nukerOverlap)
	if parts and #parts > 0 then return parts[1] end
	return nil
end

function gridPos(p)
	return Vector3.new(math.round(p.X / 3), math.round(p.Y / 3), math.round(p.Z / 3))
end

function fireBreak(blockPosition, hitPos, hitNormal)
	args = {
		{
			blockRef = { blockPosition = blockPosition },
			hitPosition = hitPos,
			hitNormal = hitNormal
		}
	}
	task.spawn(function()
		pcall(function()
			DamageBlock:InvokeServer(unpack(args))
		end)
	end)
end

lastBreakTime = 0

function tryBreak(bp, hitPos, hitNormal, hlCf, hlSize)
	updateNukerHighlight(hlCf, hlSize)
	now = os.clock()
	if now - lastBreakTime < (Nuker.Values["Break Speed"] or 0.30) then return end
	lastBreakTime = now
	fireBreak(bp, hitPos, hitNormal)
end

function scanBedSides(bed, char, range)
	best = nil
	myPos = char.HumanoidRootPart.Position
	dirs = {
		Vector3.new(1,0,0), Vector3.new(-1,0,0),
		Vector3.new(0,1,0), Vector3.new(0,-1,0),
		Vector3.new(0,0,1), Vector3.new(0,0,-1)
	}
	for _, dir in ipairs(dirs) do
		half = (bed.Size.X * math.abs(dir.X) + bed.Size.Y * math.abs(dir.Y) + bed.Size.Z * math.abs(dir.Z)) / 2
		bedPoint = bed.Position + dir * (half - 0.5)

		count = 0
		for i = 0, 5 do
			pt = bed.Position + dir * (half + 1.5 + i * 3)
			if cellSolid(pt, char) then
				count = count + 1
			else
				break
			end
		end

		if count == 0 then
			if (bedPoint - myPos).Magnitude <= range then
				if not best or not best.open then
					best = {open = true, count = 0, outerPoint = nil, bedPoint = bedPoint, dir = dir}
				end
			end
		else
			outerIdx = count - 1
			outerPoint = bed.Position + dir * (half + 1.5 + outerIdx * 3)
			if (outerPoint - myPos).Magnitude <= range then
				if not best or (not best.open and count < best.count) then
					best = {open = false, count = count, outerPoint = outerPoint, bedPoint = bedPoint, dir = dir}
				end
			end
		end
	end
	return best
end

