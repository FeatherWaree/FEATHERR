					pcall(function() asp_setInv:InvokeServer({ hand = asp_invItem }) end)
					task.wait(AutoStarPop.Values["Switch Delay"] or 0.15)
				end
				if not asp_invItem then return end

				aspPlayConsume()
				task.wait(AutoStarPop.Values["Consume Time"] or 0.5)

				if aspHeldName() ~= asp_typeStr then
					task.wait(AutoStarPop.Values["Switch Delay"] or 0.15)
					return
				end

				if asp_consumeRemote then
					pcall(function() asp_consumeRemote:InvokeServer({ item = asp_invItem }) end)
				end

				task.wait(AutoStarPop.Values["Switch Delay"] or 0.15)
			end)
		end
	end)
end


