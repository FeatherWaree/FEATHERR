function updateDamageHighlight(highlight)
	if not highlight or not highlight:IsA("Highlight") then
		return
	end

	if not loops["white hits"] then
		return
	end

	if WhiteHits.Values["Use Custom Settings"] then
		highlight.FillColor = WhiteHits.Values["Fill Color"] or Color3.fromRGB(255, 255, 255)
		highlight.OutlineColor = WhiteHits.Values["Outline Color"] or Color3.fromRGB(255, 255, 255)
		highlight.FillTransparency = WhiteHits.Values["Fill Transparency"]
		highlight.OutlineTransparency = WhiteHits.Values["Outline Transparency"]
	else
		-- Default behavior: make it completely invisible
		highlight.FillTransparency = 1
		highlight.OutlineTransparency = 1
	end
end

function hookCharacter(char)
	if not char or not char:IsA("Model") then return end

	-- Apply to existing highlights in the character
	existingHighlight = char:FindFirstChild("_DamageHighlight_")
	if existingHighlight then
		updateDamageHighlight(existingHighlight)
	end

	-- Listen for new highlights added to this specific character
	if not whiteHitCharConnections[char] then
		whiteHitCharConnections[char] = FWNoModules.Connect(char.ChildAdded, function(child)
			if child.Name == "_DamageHighlight_" then
				-- Slight yield to ensure properties are fully loaded by the game
				task.defer(updateDamageHighlight, child)
			end
		end)
	end
end

local function unhookCharacter(char)
	if whiteHitCharConnections[char] then
		whiteHitCharConnections[char]:Disconnect()
		whiteHitCharConnections[char] = nil
	end
end

WhiteHits.Callbacks.OnToggle = function(state)
	loops["white hits"] = state

	-- Clean up all existing connections
	if whiteHitConnection then
		whiteHitConnection:Disconnect()
		whiteHitConnection = nil
	end

	if highlightConnection then
		highlightConnection:Disconnect()
		highlightConnection = nil
	end

	for char, conn in pairs(whiteHitCharConnections) do
		conn:Disconnect()
	end
	table.clear(whiteHitCharConnections)

	if state then
		-- 1. Hook into Workspace DescendantAdded for NPCs / general workspace highlights
		highlightConnection = FWNoModules.Connect(G.Services.Workspace.DescendantAdded, function(obj)
			if obj.Name == "_DamageHighlight_" then
				task.defer(updateDamageHighlight, obj)
			elseif obj:IsA("Model") then
				-- Hook newly spawned NPCs/Characters
				hookCharacter(obj)
			end
		end)

		-- 2. Hook into Players for respawns
		for _, player in ipairs(FWNoModules.PlayerSnapshot()) do
			if player.Character then
				hookCharacter(player.Character)
			end

			table.insert(whiteHitCharConnections, FWNoModules.Connect(player.CharacterAdded, function(newChar)
				hookCharacter(newChar)
			end))
		end

		-- Listen for new players joining
		table.insert(whiteHitCharConnections, FWNoModules.Connect(Players.PlayerAdded, function(player)
			if player.Character then
				hookCharacter(player.Character)
			end
			table.insert(whiteHitCharConnections, FWNoModules.Connect(player.CharacterAdded, function(newChar)
				hookCharacter(newChar)
			end))
		end))

		-- 3. Initial scan of everything currently in the workspace
		for _, obj in ipairs(G.Services.Workspace:GetDescendants()) do
			if obj.Name == "_DamageHighlight_" then
				updateDamageHighlight(obj)
			elseif obj:IsA("Model") then
				hookCharacter(obj)
			end
		end

	else
		-- Revert all highlights to default when turned off
		for _, obj in ipairs(G.Services.Workspace:GetDescendants()) do
			if obj:IsA("Highlight") and obj.Name == "_DamageHighlight_" then
				obj.FillTransparency = 0.5 -- Standard Roblox highlight default
				obj.OutlineTransparency = 0
			end
		end
	end
end

local function findNearbyContainers(radius, espOnly)
	if not loops["chest stealer"] and not espOnly then 
		return {}, {} 
	end

	local chests = {}
	local crates = {}

	local root = cachedHRP
	if not root then return chests, crates end

	-- FIX 1: MaxParts must be set as a property of OverlapParams!
	local overlapParams = OverlapParams.new()
	overlapParams.FilterDescendantsInstances = {Player.Character}
	overlapParams.FilterType = Enum.RaycastFilterType.Exclude
	overlapParams.MaxParts = 5000 

	-- Only 3 arguments are passed to GetPartBoundsInRadius
	local parts = G.Services.Workspace:GetPartBoundsInRadius(root.Position, radius, overlapParams)

	for _, part in ipairs(parts) do
		if part.Name == "chest" then
			chests[#chests + 1] = part
		elseif part.Name == "team_crate" then
			if ChestStealer.Values["Own Crate"] == false then
				if part:GetAttribute("Team") == Player:GetAttribute("Team") then
					continue
				end
			end
			crates[#crates + 1] = part
		end
	end

	return chests, crates
end


