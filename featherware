kaliyahPlayPunchAnim = function()
	animId = kaliyahLoadPunchAnim()
	if not animId then return end

	char = Players.LocalPlayer.Character
	if not char then return end
	humanoid = char:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end
	animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then return end

	pcall(function()
		anim = FWNoModules.OwnInstance(Instance.new("Animation"))
		anim.AnimationId = animId
		track = FWNoModules.OwnInstance(animator:LoadAnimation(anim))
		track.Priority = Enum.AnimationPriority.Action
		if kaliyahData.punchAnimSpeed then
			track:AdjustSpeed(kaliyahData.punchAnimSpeed)
		end
		track:Play(0)
		FWNoModules.Connect(track.Stopped, function()
			track:Destroy()
			anim:Destroy()
		end)
		task.delay(2, function()
			if track and track.Parent then track:Destroy() end
			if anim and anim.Parent then anim:Destroy() end
		end)
	end)
end

