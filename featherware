Fullbright.Callbacks.OnToggle = function(state)
	if state then
		-- Cache original lighting settings
		origLighting.Ambient = game.Lighting.Ambient
		origLighting.ColorShift_Bottom = game.Lighting.ColorShift_Bottom
		origLighting.ColorShift_Top = game.Lighting.ColorShift_Top
		origLighting.Brightness = game.Lighting.Brightness
		origLighting.ClockTime = game.Lighting.ClockTime
		origLighting.FogEnd = game.Lighting.FogEnd
		origLighting.GlobalShadows = game.Lighting.GlobalShadows

		-- Loop it on RenderStepped so the game's anti-cheat or day/night cycle can't override it
		fbConnection = G.Services.RunService.RenderStepped:Connect(function()
			game.Lighting.Ambient = Color3.new(1, 1, 1)
			game.Lighting.ColorShift_Bottom = Color3.new(1, 1, 1)
			game.Lighting.ColorShift_Top = Color3.new(1, 1, 1)
			game.Lighting.Brightness = 2
			game.Lighting.ClockTime = 14
			game.Lighting.FogEnd = 100000
			game.Lighting.GlobalShadows = false
		end)
	else
		-- Stop the loop and reverse
		if fbConnection then fbConnection:Disconnect(); fbConnection = nil end

		game.Lighting.Ambient = origLighting.Ambient or Color3.fromRGB(127, 127, 127)
		game.Lighting.ColorShift_Bottom = origLighting.ColorShift_Bottom or Color3.fromRGB(0, 0, 0)
		game.Lighting.ColorShift_Top = origLighting.ColorShift_Top or Color3.fromRGB(0, 0, 0)
		game.Lighting.Brightness = origLighting.Brightness or 1
		game.Lighting.ClockTime = origLighting.ClockTime or 14
		game.Lighting.FogEnd = origLighting.FogEnd or 10000

		if origLighting.GlobalShadows ~= nil then
			game.Lighting.GlobalShadows = origLighting.GlobalShadows
		end
	end
end



sigridSettings = {
	speedBoost = false,
	highJump = false
}

sigridData = {
	knit = nil,
	speedMod = nil,
	jumpMod = nil
}

sigridGetKnit = function()
	if sigridData.knit then return sigridData.knit end
	pcall(function()
		ReplicatedStorage = G.Services.RS
		rbxts = ReplicatedStorage:WaitForChild("rbxts_include", 10)
		sigridData.knit = require(rbxts.node_modules["@easy-games"].knit.src).KnitClient
	end)
	return sigridData.knit
end

sigridApplyMods = function()
	knit = sigridData.knit
	if not knit or not knit.Controllers then return end
	sprint = knit.Controllers.SprintController
	jump = knit.Controllers.JumpHeightController
	active = loops["auto sigrid"] == true

	if sprint then
		if active and sigridSettings.speedBoost then
			if not sigridData.speedMod then
				sigridData.speedMod = {blockSprint = false, moveSpeedMultiplier = 1.25}
				sprint:getMovementStatusModifier():addModifier(sigridData.speedMod)
			end
		elseif sigridData.speedMod then
			pcall(function() sprint:getMovementStatusModifier():removeModifier(sigridData.speedMod) end)
			sigridData.speedMod = nil
		end
	end

	if jump then
		if active and sigridSettings.highJump then
			if not sigridData.jumpMod then
				sigridData.jumpMod = {jumpHeightMultiplier = 3}
				jump:getJumpModifier():addModifier(sigridData.jumpMod)
			end
		elseif sigridData.jumpMod then
			pcall(function() jump:getJumpModifier():removeModifier(sigridData.jumpMod) end)
			sigridData.jumpMod = nil
		end
	end
end

sigridApply = function()
	if not canRequire then return end
	active = loops["auto sigrid"] == true

	if active and (sigridSettings.speedBoost or sigridSettings.highJump) then
		task.spawn(function()
			while loops["auto sigrid"] and (sigridSettings.speedBoost or sigridSettings.highJump) do
				sigridGetKnit()
				if sigridData.knit and sigridData.knit.Controllers and sigridData.knit.Controllers.SprintController then
					break
				end
				task.wait(0.5)
			end
			sigridApplyMods()
		end)
	else
		sigridGetKnit()
		sigridApplyMods()
	end
end

