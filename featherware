NF_SNAP    = 4  
NF_MINFALL = 6 

nofall = { on = false, conn = nil }
nf = { engaged = false, landY = nil }

function nfRayGround(hrp)
	rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	if Player.Character then rp.FilterDescendantsInstances = { Player.Character } end
	hit = G.Services.Workspace:Raycast(hrp.Position, Vector3.new(0, -1000, 0), rp)
	return hit and hit.Position.Y or nil
end

function nfTryEngage(hrp, hum)
	G = nfRayGround(hrp)
	if not G then return end
	feetOff = (hrp.Size.Y / 2) + (hum.HipHeight or 2)      
	landY = G + feetOff
	if hrp.Position.Y - landY > NF_MINFALL then     
		nf.engaged = true
		nf.landY = landY
		print("[NOFALL] locked landing Y =", math.floor(landY), "| drop =", math.floor(hrp.Position.Y - landY))
	end
end

function nofallLoop()
	if not nofall.on then return end
	if loops["fly"] or loops["swim"] then return end
	char = Player.Character
	hrp  = char and char:FindFirstChild("HumanoidRootPart")
	hum  = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum or hum.Health <= 0 then nf.engaged = false; nf.landY = nil; return end

	air = (hum.FloorMaterial == Enum.Material.Air)
	if not air then 
		nf.engaged = false; nf.landY = nil; return
	end

	if not nf.engaged then
		nfTryEngage(hrp, hum)   
	elseif nf.landY and hrp.Position.Y <= nf.landY + NF_SNAP then
		nfSnapY = nf.landY
		hrp.CFrame = CFrame.new(hrp.Position.X, nf.landY, hrp.Position.Z)   
		pcall(function() hrp.AssemblyLinearVelocity = Vector3.zero end)   
		nf.engaged = false; nf.landY = nil
		print("[NOFALL] snapped to Y =", math.floor(nfSnapY))
	end
end

