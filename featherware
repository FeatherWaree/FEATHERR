    runtime.bindings = {}
    runtime.restorations = {}
    local scope = setmetatable({}, {__index = nativeTask})
    runtime.owners = setmetatable({}, {__mode = "k"})
    runtime.featureTasks = {}
    runtime.featureConnections = {}
    runtime.featureObjects = {}
    runtime.featureTweens = {}
    runtime.bindingOwners = {}
