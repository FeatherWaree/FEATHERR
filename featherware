function tsUserMoving()
	if UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.D) then return true end
	if UserInputService:IsKeyDown(Enum.KeyCode.Up) or UserInputService:IsKeyDown(Enum.KeyCode.Down) or UserInputService:IsKeyDown(Enum.KeyCode.Left) or UserInputService:IsKeyDown(Enum.KeyCode.Right) then return true end
	return false
end

function tsIsInvisible(model)
	tsp_pool = {}
	tsp_t = model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso") or model:FindFirstChild("LowerTorso")
	if tsp_t then table.insert(tsp_pool, tsp_t) end
	tsp_h = model:FindFirstChild("Head")
	if tsp_h then table.insert(tsp_pool, tsp_h) end
	if #tsp_pool == 0 then return false end
	tsp_sum = 0
	for _, tsp_p in ipairs(tsp_pool) do
		if tsp_p:IsA("BasePart") then tsp_sum = tsp_sum + math.max(tsp_p.Transparency, tsp_p.LocalTransparencyModifier) end
	end
	return (tsp_sum / #tsp_pool) >= 0.9
end

function tsHasLOS(from, model)
	tsl_h = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
	if not tsl_h then return false end
	tsl_char = Player.Character
	if tsl_char then tsWallParams.FilterDescendantsInstances = { tsl_char, model } else tsWallParams.FilterDescendantsInstances = { model } end
	return G.Services.Workspace:Raycast(from + Vector3.new(0, 1, 0), tsl_h.Position - (from + Vector3.new(0, 1, 0)), tsWallParams) == nil
end

function tsDist(model)
	tsd_h = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
	if not tsd_h then return nil, nil end
	return tsd_h, (tsd_h.Position - ts_myPos).Magnitude
end

function tsDirClear(dir)
	tsWallParams.FilterDescendantsInstances = { ts_char }
	ts_wall = G.Services.Workspace:Raycast(ts_hrp.Position + Vector3.new(0, 0.5, 0), dir * 2.0, tsWallParams)
	if ts_wall then return false end

	-- [FIXED]: If the player is currently flying, ignore the cliff edge detection so they don't freeze in mid-air.
	if loops and loops["fly"] then return true end

	tsGroundParams.FilterDescendantsInstances = { ts_char }
	ts_edge = G.Services.Workspace:Raycast(ts_hrp.Position + dir * 1.4 + Vector3.new(0, 1, 0), Vector3.new(0, -6, 0), tsGroundParams)
	return ts_edge ~= nil
end

function tsFindTarget()
	ts_cands = {}
	if TargetStrafe.Values["Target Players"] then
		for _, ts_pl in ipairs(EntityCache.players) do
			ts_m = ts_pl.Character
			if ts_m and not (TargetStrafe.Values["Ignore Invisible"] and tsIsInvisible(ts_m)) then
				ts_h, ts_d = tsDist(ts_m)
				if ts_h and ts_d <= (TargetStrafe.Values["Search Range"] or 14) then
					if not (TargetStrafe.Values["Ignore Behind Walls"]) or tsHasLOS(ts_myPos, ts_m) then
						table.insert(ts_cands, { m = ts_m, d = ts_d })
					end
				end
			end
		end
	end
	if TargetStrafe.Values["Target NPCs/Dummies"] then
		for _, ts_npc in ipairs(EntityCache.npcs) do
			if not (TargetStrafe.Values["Ignore Invisible"] and tsIsInvisible(ts_npc)) then
				ts_h, ts_d = tsDist(ts_npc)
				if ts_h and ts_d <= (TargetStrafe.Values["Search Range"] or 14) then
					if not (TargetStrafe.Values["Ignore Behind Walls"]) or tsHasLOS(ts_myPos, ts_npc) then
						table.insert(ts_cands, { m = ts_npc, d = ts_d })
					end
				end
			end
		end
	end
	if #ts_cands == 0 then return nil end
	table.sort(ts_cands, function(a, b) return a.d < b.d end)
	return ts_cands[1].m
end

function tsMapPos(dx, dz, centerUI)
	return Vector2.new(centerUI.X + dx * (TS_MAP_HALF / TS_MAP_RADIUS), centerUI.Y + dz * (TS_MAP_HALF / TS_MAP_RADIUS))
end

function tsMakeDot(parent, size, color, text)
	tsd = Instance.new("Frame")
	tsd.Size = UDim2.fromOffset(size, size)
	tsd.BackgroundColor3 = color; tsd.BackgroundTransparency = 0.1
	tsd.BorderSizePixel = 0; tsd.AnchorPoint = Vector2.new(0.5, 0.5); tsd.ZIndex = 5
	tsd.Parent = parent
	Instance.new("UICorner", tsd).CornerRadius = UDim.new(1, 0)
	if text and text ~= "" then
		tsd_lbl = Instance.new("TextLabel", tsd)
		tsd_lbl.Size = UDim2.fromScale(1, 1); tsd_lbl.BackgroundTransparency = 1
		tsd_lbl.Text = text; tsd_lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
		tsd_lbl.TextSize = 11; tsd_lbl.Font = Enum.Font.GothamBold; tsd_lbl.ZIndex = 6
	end
	return tsd
end

function tsRefreshEditor()
	if not ts_editorOpen or not ts_editorGui then return end
	ts_map = ts_editorGui:FindFirstChild("TS_BG"):FindFirstChild("TS_Map")
	if not ts_map then return end

	ts_dots = ts_map:FindFirstChild("TS_Dots")
	for _, ts_c in ipairs(ts_dots:GetChildren()) do ts_c:Destroy() end

	ts_centerUI = Vector2.new(ts_map.AbsoluteSize.X / 2, ts_map.AbsoluteSize.Y / 2)

	-- Red dot in the center for the Target
	ts_edot = tsMakeDot(ts_dots, 14, Color3.fromRGB(255, 60, 60), "")
	ts_edot.Position = UDim2.fromOffset(ts_centerUI.X, ts_centerUI.Y)

	-- Blue dot for the Player
	ts_char = Player.Character
	ts_hrp = ts_char and ts_char:FindFirstChild("HumanoidRootPart")
	ts_editorTarget = ts.lock or tsFindTarget()

	if ts_hrp and ts_editorTarget then
		ts_tHRP = ts_editorTarget:FindFirstChild("HumanoidRootPart") or ts_editorTarget.PrimaryPart
		if ts_tHRP then
			ts_pdx = ts_hrp.Position.X - ts_tHRP.Position.X
			ts_pdz = ts_hrp.Position.Z - ts_tHRP.Position.Z
			ts_ppUI = tsMapPos(ts_pdx, ts_pdz, ts_centerUI)
			ts_pdot = tsMakeDot(ts_dots, 9, Color3.fromRGB(80, 160, 255), "")
			ts_pdot.Position = UDim2.fromOffset(ts_ppUI.X, ts_ppUI.Y)
		end
	end

	-- Numbered Custom Waypoints
	for ts_wi, ts_wp in ipairs(ts_waypoints) do
		ts_wposUI = tsMapPos(ts_wp.x, ts_wp.z, ts_centerUI)
		ts_wdot = tsMakeDot(ts_dots, 16, Color3.fromRGB(255, 200, 60), tostring(ts_wi))
		ts_wdot.Position = UDim2.fromOffset(ts_wposUI.X, ts_wposUI.Y)
	end

	ts_info = ts_editorGui:FindFirstChild("TS_BG"):FindFirstChild("TS_Info")
	if ts_info then ts_info.Text = "Waypoints: " .. #ts_waypoints .. "  |  Left-click add  |  Right-click remove" end
end

function tsRefreshBlocks()
	if not ts_editorOpen or not ts_editorGui then return end
	ts_editorTarget = ts.lock or tsFindTarget()
	ts_map = ts_editorGui:FindFirstChild("TS_BG"):FindFirstChild("TS_Map")
	ts_blocks = ts_map and ts_map:FindFirstChild("TS_Blocks")
	if not ts_map or not ts_blocks then return end
	for _, ts_b in ipairs(ts_blocks:GetChildren()) do ts_b:Destroy() end

	ts_centerUI = Vector2.new(ts_map.AbsoluteSize.X / 2, ts_map.AbsoluteSize.Y / 2)
	ts_tHRP = ts_editorTarget and (ts_editorTarget:FindFirstChild("HumanoidRootPart") or ts_editorTarget.PrimaryPart)
	ts_tPos = ts_tHRP and ts_tHRP.Position or (Player.Character and Player.Character.PrimaryPart and Player.Character.PrimaryPart.Position) or Vector3.zero

	ts_src = G.Services.Workspace:FindFirstChild("Map") or G.Services.Workspace
	ts_count = 0
	for _, ts_part in ipairs(ts_src:GetChildren()) do
		if ts_count >= TS_MAX_BLOCKS then break end
		ts_bp = nil
		if ts_part:IsA("BasePart") then ts_bp = ts_part
		elseif ts_part:IsA("Model") and ts_part.PrimaryPart then ts_bp = ts_part.PrimaryPart end

		if ts_bp and ts_bp.Size.X >= 2 and ts_bp.Size.Z >= 2 then
			ts_dy = ts_bp.Position.Y - ts_tPos.Y
			if ts_dy > -12 and ts_dy < 6 then
				ts_dx = ts_bp.Position.X - ts_tPos.X
				ts_dz = ts_bp.Position.Z - ts_tPos.Z
				if math.abs(ts_dx) < TS_MAP_RADIUS and math.abs(ts_dz) < TS_MAP_RADIUS then
					ts_bposUI = tsMapPos(ts_dx, ts_dz, ts_centerUI)
					ts_bf = Instance.new("Frame")
					ts_bf.AnchorPoint = Vector2.new(0.5, 0.5)
					ts_bf.Position = UDim2.fromOffset(ts_bposUI.X, ts_bposUI.Y)
					ts_bf.Size = UDim2.fromOffset(math.max(3, ts_bp.Size.X * (TS_MAP_HALF / TS_MAP_RADIUS)), math.max(3, ts_bp.Size.Z * (TS_MAP_HALF / TS_MAP_RADIUS)))
					ts_bf.BackgroundColor3 = Color3.fromRGB(90, 95, 105)
					ts_bf.BackgroundTransparency = 0.45; ts_bf.BorderSizePixel = 0; ts_bf.ZIndex = 2
					ts_bf.Parent = ts_blocks
					ts_count = ts_count + 1
				end
			end
		end
	end
end

