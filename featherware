	mainScreenUI.Destroying:Connect(function()
		if EC_PlayerAddedConn then EC_PlayerAddedConn:Disconnect() end
		for _, conn in ipairs(EC_AddedConns) do conn:Disconnect() end
		for _, conn in ipairs(EC_RemovedConns) do conn:Disconnect() end
		table.clear(EntityCache.Players)
		table.clear(EntityCache.NPCs)
	end)
end

