	if warriorData.gritConn then pcall(function() warriorData.gritConn:Disconnect() end) warriorData.gritConn = nil end
	if warriorData.charConn then pcall(function() warriorData.charConn:Disconnect() end) warriorData.charConn = nil end
	if warriorData.kitConn then pcall(function() warriorData.kitConn:Disconnect() end) warriorData.kitConn = nil end
