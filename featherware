						dist = (eRoot.Position - jellyPos).Magnitude
						if dist <= maxRange then
							targetFound = true
							break
						end
					end
				end
			end

			if targetFound then break end
		end
	end

	-- 3. Fire Ability if target found
	if targetFound then
		if not marinaLoadRemote() then return end

		marinaData.lastFire = now
		print("[Auto Marina] Enemy near jellyfish! Firing electrify_jellyfish!")

