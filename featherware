			metal_e.hl.FillTransparency = MetalESP.Values["Highlight Fill Transparency"] or 0.85
			metal_e.hl.OutlineTransparency = MetalESP.Values["Highlight Outline Transparency"] or 0.1
			metal_e.hl.DepthMode = metal_walls and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
		end
		if metal_e.part and metal_e.orig then
			if MetalESP.Values["Show Part"] then
				metal_e.part.Transparency = MetalESP.Values["Part Transparency"] or 0
				metal_e.part.Color = MetalESP.Values["Part Color"] or Color3.fromRGB(255, 180, 50)
				metal_e.part.Material = Enum.Material.Neon
				metal_e.part.CastShadow = false
			else
				metal_e.part.Transparency = metal_e.orig.transp
				metal_e.part.Color = metal_e.orig.color
				metal_e.part.Material = metal_e.orig.mat
				metal_e.part.CastShadow = true
			end
		end
		if metal_e.dl then
			metal_e.dl.TextColor3 = MetalESP.Values["Distance Text Color"] or Color3.fromRGB(255, 255, 255)
			metal_e.dl.TextSize = MetalESP.Values["Text Size"] or 12
		end
		if metal_e.bb then
			metal_e.bb.AlwaysOnTop = metal_walls
		end
	end
end

