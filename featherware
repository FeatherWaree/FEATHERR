-- Own connections without wrapping their callbacks or changing their schedule.
FWNoModules.Runtime = {connections = {}, additions = 0, active = true}
do
local runtime = FWNoModules.Runtime
function FWNoModules.TrackFrameConnection(connection)
    if not runtime.active then connection:Disconnect(); return connection end
    runtime.connections[connection] = true
    local thread=coroutine.running()
    local owner=runtime.owners and thread and runtime.owners[thread]
    if owner then
        runtime.featureConnections[owner]=runtime.featureConnections[owner] or {}
        runtime.featureConnections[owner][connection]=true
    end
    runtime.additions += 1
    if runtime.additions % 64 == 0 then
        for existing in pairs(runtime.connections) do
            if not existing.Connected then runtime.connections[existing] = nil end
        end
    end
    return connection
end
function FWNoModules.ReleaseConnection(connection)
    if connection then connection:Disconnect(); runtime.connections[connection] = nil end
end
function runtime.Cleanup()
    if not runtime.active then return end
    if FWNoModules.Profiles then FWNoModules.Profiles.PrepareUnload()end
    runtime.active = false
    if runtime.FlushConfig then pcall(runtime.FlushConfig) end
    if runtime.runningConnection then runtime.runningConnection:Disconnect() end
    if runtime.StopModules then pcall(runtime.StopModules) end
    if runtime.CleanupVisuals then pcall(runtime.CleanupVisuals) end
    if runtime.CancelTasks then runtime.CancelTasks() end
    local cleanups = runtime.cleanups and table.clone(runtime.cleanups) or {}
    if runtime.cleanups then table.clear(runtime.cleanups) end
    for _, cleanup in ipairs(cleanups) do pcall(cleanup) end
    for connection in pairs(runtime.connections) do connection:Disconnect() end
    table.clear(runtime.connections)
    if runtime.RestoreSession then runtime.RestoreSession() end
    if runtime.DestroyOwned then runtime.DestroyOwned() end
    if runtime.CancelTasks then runtime.CancelTasks() end
end
end

-- Session ownership. These are lexical facades, never changes to global Roblox APIs.
function FWNoModules.CreateTaskScope(nativeTask)
