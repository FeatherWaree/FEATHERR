            end
            local optionAliases={["Limit to items"]="Require Sword Equipped",["Require mouse down"]="Manual Swing",["Max angle"]="Angle Check"}
            for name,nativeName in pairs(optionAliases)do module.Options[name]=module.Options[nativeName]end
