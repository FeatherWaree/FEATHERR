				if not rootPart or not humanoid or humanoid.Health <= 0 or not handInvItem or not handInvItem.Value then
					isFishing = false
					if idleLoopTrack then idleLoopTrack:Stop() idleLoopTrack = nil end
					task.wait(0.1) continue
				end
				if handInvItem.Value.Name ~= "fishing_rod" then
					isFishing = false
					if idleLoopTrack then idleLoopTrack:Stop() idleLoopTrack = nil end
					task.wait(0.1) continue
				end
