local function asGetFilteredItems(inventoryFolder)
	asItems = {}
	for _, obj in pairs(inventoryFolder:GetChildren()) do
		if obj.Name ~= "ChestOwner" and asIsItemSelected(obj.Name) then
			table.insert(asItems, obj.Name)
		end
	end
	table.sort(asItems)
	return asItems
end

local function updateChestESP(billboard, items)
	applyScale(billboard)

	container = billboard:FindFirstChild("Container")
	if not container then return end

	local inventoryHash = table.concat(items, ",")
	if billboard:GetAttribute("LastHash") == inventoryHash then return end
	billboard:SetAttribute("LastHash", inventoryHash)

	for _, child in pairs(container:GetChildren()) do
		if child:IsA("ImageLabel") then child:Destroy() end
	end

	for _, itemName in ipairs(items) do
		img = FWNoModules.OwnInstance(Instance.new("ImageLabel"))
		img.Size = UDim2.new(CHEST_ICON_FRAC, 0, CHEST_ICON_FRAC, 0)
		img.SizeConstraint = Enum.SizeConstraint.RelativeYY
		img.BackgroundTransparency = 1
		img.ImageTransparency = 0
		img.BorderSizePixel = 0
		img.ScaleType = Enum.ScaleType.Fit
		img.Image = getItemImage(itemName)
		img.Parent = container
	end
end

