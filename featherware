        if type(getcustomasset)=="function"then
            local ok,exists=pcall(function()return isfile and isfile(path)end)
            if ok and exists then local success,result=pcall(getcustomasset,path);if success then assetCache[path]=result;return result end end
        end
        -- GUI icons are adapted to built-in assets. User audio/image paths remain explicit settings.
        local builtins={close="rbxassetid://6031094678",search="rbxassetid://6031154871",add="rbxassetid://6035047377"}
        for name,id in pairs(builtins)do if path:lower():find(name,1,true)then assetCache[path]=id;return id end end
