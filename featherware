			if cd_owner and cdShouldCheck(cd_owner) then
				cd_st = cdState(cd_owner)
				table.insert(cd_st.shotTimes, cd_now)
				while #cd_st.shotTimes > 8 do table.remove(cd_st.shotTimes, 1) end
				if #cd_st.shotTimes >= 2 and (cd_st.shotTimes[#cd_st.shotTimes] - cd_st.shotTimes[#cd_st.shotTimes - 1]) < 0.25 then
					cdNotify(cd_owner, "Projectile Aura (fire rate)")
					cd_st.shotTimes = {}
				elseif #cd_st.shotTimes >= 3 and (cd_st.shotTimes[#cd_st.shotTimes] - cd_st.shotTimes[#cd_st.shotTimes - 2]) <= 1 then
					cdNotify(cd_owner, "Projectile Aura (multi weapon)")
					cd_st.shotTimes = {}
				end
			end
		end
		return
	end

	if not d:IsA("BasePart") then return end
	cd_n = d.Name:lower()

	-- chests
	if CheaterDetector.Values["Chest Stealer"] and (cd_n == "chest" or cd_n == "team_crate") then
		cdHookChest(d)
		return
	end

	-- block placed
	if CheaterDetector.Values["Scaffold"] or CheaterDetector.Values["BlockCPS Bypass"] then
		if cdIsBlockName(cd_n) and not cd_n:find("bed") then
			cd_now = os.clock()
			cd_p, cd_pd = cdNearestPlayer(d.Position, 10)
			if cd_p and (d.Position.Y - cd_p.Character.HumanoidRootPart.Position.Y) < 6 then
				cd_st = cdState(cd_p)
				cd_hr = cd_p.Character.HumanoidRootPart

				-- BLOCKCPS BYPASS: placing faster than the 12 CPS cap
				if CheaterDetector.Values["BlockCPS Bypass"] then
					if cd_now - cd_st.lastPlace < 0.06 then
						cdNotify(cd_p, "BlockCPS Bypass")
					end
				end
				cd_st.lastPlace = cd_now

				-- SCAFFOLD: blocks appearing under feet while NOT looking down & moving,
				-- or placing while a sword is held (impossible legit)
				if CheaterDetector.Values["Scaffold"] then
					cd_dy = cd_hr.Position.Y - d.Position.Y
					cd_held = cdHeldName(cd_p.Character)
					if cd_dy > 1 and cd_dy < 5 and cd_hr.CFrame.LookVector.Y > -0.15 and cd_hr.AssemblyLinearVelocity.Magnitude > 4 then
						table.insert(cd_st.scafTimes, cd_now)
						while #cd_st.scafTimes > 6 do table.remove(cd_st.scafTimes, 1) end
						if #cd_st.scafTimes >= 2 and (cd_st.scafTimes[#cd_st.scafTimes] - cd_st.scafTimes[#cd_st.scafTimes - 1]) <= 2 then
							cdNotify(cd_p, "Scaffold (auto bridge)")
							cd_st.scafTimes = {}
						end
					elseif cd_held and table.find(swords, cd_held) then
						cdNotify(cd_p, "Scaffold (placing with sword)")
					end
				end
			end
		end
	end

	-- resource collected? (added = dropped; removal handled below)
end)

