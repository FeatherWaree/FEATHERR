silasFireShield = function()
	now = os.clock()
	-- 17 second cooldown enforcement
	if now - silasData.lastFire < 17 then return end

	if not silasLoadRemote() then return end

	char = Player.Character
	if not char then return end
	hrp = char:FindFirstChild("HumanoidRootPart")
	hum = char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum or hum.Health <= 0 then return end

	range = AutoSilas.Values["Range"] or 15

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= Player and (not plr.Team or not Player.Team or plr.Team ~= Player.Team) then
			enemyChar = plr.Character
			if enemyChar then
				enemyHRP = enemyChar:FindFirstChild("HumanoidRootPart")
				enemyHum = enemyChar:FindFirstChildOfClass("Humanoid")
				if enemyHRP and enemyHum and enemyHum.Health > 0 then
					dist = (hrp.Position - enemyHRP.Position).Magnitude
					if dist <= range then
						silasData.lastFire = now
						print("[Auto Silas] Enemy in range (" .. math.floor(dist) .. " studs). Firing rebellion_shield!")
						pcall(function()
							silasData.abilityRemote:FireServer("rebellion_shield")
						end)
						break
					end
				end
			end
		end
	end
end

