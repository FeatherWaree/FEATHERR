LongJump.Callbacks.OnToggle = function(state)
	loops["long jump"] = state

	if state then
		task.spawn(function()
			character = Players.LocalPlayer.Character
			localRootPart = character and character:FindFirstChild("HumanoidRootPart")

			if localRootPart then
				replicatedStorage = G.Services.RS
				netManaged = replicatedStorage:WaitForChild("rbxts_include")
					:WaitForChild("node_modules")
					:WaitForChild("@rbxts")
					:WaitForChild("net")
					:WaitForChild("out")
					:WaitForChild("_NetManaged")

				GLIDE_SPEED = 75
				UPWARD_LIFT = 7

				if not originalGravity then
					originalGravity = G.Services.Workspace.Gravity
				end

				executedAbilityJump = false

				-- 1. Check for Yuzi Dash First
				if LongJump.Values["Yuzi Jump"] then
					handInvItem = character:FindFirstChild("HandInvItem")
					if handInvItem and handInvItem.Value then
						currentWeaponName = handInvItem.Value.Name

						-- Verify if the held item is a valid Yuzi Dao
						if currentWeaponName == "wood_dao" or currentWeaponName == "stone_dao" or currentWeaponName == "iron_dao" or currentWeaponName == "diamond_dao" or currentWeaponName == "emerald_dao" then

							lookDir = localRootPart.CFrame.LookVector
							currentPos = localRootPart.Position

							dashArgs = {
								"dash",
								{
									direction = Vector3.new(lookDir.X, lookDir.Y, lookDir.Z),
									origin = Vector3.new(currentPos.X, currentPos.Y, currentPos.Z),
									weapon = currentWeaponName
								}
							}

							-- Fire the Yuzi Dash instantly
							replicatedStorage:WaitForChild("events-@easy-games/game-core:shared/game-core-networking@getEvents.Events"):WaitForChild("useAbility"):FireServer(unpack(dashArgs))

							task.wait(0.07)
							executedAbilityJump = true
						end
					end
				end

				-- 2. Fallback to Fireball Jump if no Yuzi Dash occurred
				if not executedAbilityJump and LongJump.Values["Fireball Jump"] then
					invFolder = FWNoModules.GetPrivateInventoryContainer()
					if invFolder then
						playerInv = FWNoModules.GetPrivateInventory(Players.LocalPlayer.Name)
						if playerInv then
							fireballInst = playerInv:FindFirstChild("fireball")
							if fireballInst then
								handInvItem = character:FindFirstChild("HandInvItem")
								if handInvItem then
									currentItemName = handInvItem.Value and handInvItem.Value.Name
									oldItemInst = nil

									-- Equip fireball if not currently held
									if currentItemName ~= "fireball" then
										if currentItemName and currentItemName ~= "" then
											oldItemInst = playerInv:FindFirstChild(currentItemName)
										end
										equipArgs = { { hand = fireballInst } }
										netManaged:WaitForChild("SetInvItem"):InvokeServer(unpack(equipArgs))
										task.wait(0.04) -- High-ping sync yield so server recognizes the held fireball
									end

									originPos = localRootPart.Position
									targetPos = originPos - Vector3.new(0, 2, 0)
									velocity = Vector3.new(0, -68, 0)
									shotIdVal = getShotGUID()

									fireballItemRef = (FWNoModules.GetPrivateInventory(Player) and FWNoModules.GetPrivateInventory(Player):FindFirstChild("fireball")) or fireballInst

									fireArgs = {
										fireballItemRef,
										"fireball",
										"fireball",
										vec(originPos.X, originPos.Y, originPos.Z),
										vec(targetPos.X, targetPos.Y, targetPos.Z),
										vec(velocity.X, velocity.Y, velocity.Z),
										shotIdVal,
										{ shotId = shotIdVal, drawDurationSec = 0.25 },
										G.Services.Workspace:GetServerTimeNow()
									}

									netManaged:WaitForChild("ProjectileFire"):InvokeServer(unpack(fireArgs))

									-- Re-equip original weapon only after fireball projectile validates on server
									if oldItemInst and oldItemInst ~= fireballInst then
										task.wait(0.12) -- High-ping safety delay
										if loops["long jump"] then
											netManaged:WaitForChild("SetInvItem"):InvokeServer({ hand = oldItemInst })
										end
									end
								end
							end
						end
					end
				end

				-- 3. Execute Standard Long Jump / Glide
				localRootPart.CFrame = localRootPart.CFrame + Vector3.new(0, 3, 0)

				if not activePushForce or not activePushForce.Parent then
					activePushForce = FWNoModules.OwnInstance(Instance.new("BodyVelocity"))
					activePushForce.MaxForce = Vector3.new(100000, 100000, 100000)
					activePushForce.Parent = localRootPart
				end

				while loops["long jump"] and localRootPart and activePushForce.Parent do
					look = localRootPart.CFrame.LookVector
					flatDirection = Vector3.new(look.X, 0, look.Z).Unit

					activePushForce.Velocity = Vector3.new(
						flatDirection.X * GLIDE_SPEED,
						UPWARD_LIFT,
						flatDirection.Z * GLIDE_SPEED
					)
					task.wait(0.01)
				end

			end
		end)
	else
		if activePushForce then
			activePushForce:Destroy()
			activePushForce = nil
		end

		character = Players.LocalPlayer.Character
		localRootPart = character and character:FindFirstChild("HumanoidRootPart")

		if localRootPart then
			localRootPart.AssemblyLinearVelocity = Vector3.new(0, -60, 0)
		end
	end
end

