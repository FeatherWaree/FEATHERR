zenoIsEnemy = function(plr)
	if not plr or plr == PlayersService.LocalPlayer then return false end
	if plr.Team and PlayersService.LocalPlayer.Team and plr.Team == PlayersService.LocalPlayer.Team then return false end
	if plr:GetAttribute("Spectating") or plr:GetAttribute("IsSpectator") then return false end
	return true
end

zenoGetTarget = function(maxDist)
    local character = PlayersService.LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return nil, math.huge end
    local best, bestScore = nil, math.huge
    for _, player in ipairs(FWNoModules.PlayerSnapshot()) do
        if zenoIsEnemy(player) and player.Character then
            local enemyRoot = player.Character:FindFirstChild("HumanoidRootPart")
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            if enemyRoot and humanoid and humanoid.Health > 0 then
                local distance = (root.Position - enemyRoot.Position).Magnitude
                if distance <= maxDist then
                    local score = zenoSettings.targetMode == "Lowest HP"
                        and ((humanoid.Health / math.max(humanoid.MaxHealth, 1)) * 100000 + distance) or distance
                    if score < bestScore and FWNoModules.ClearShot("Zeno", root.Position, enemyRoot.Position, player.Character) then
                        best, bestScore = player, score
                    end
                end
            end
        end
    end
    return best, bestScore
end

zenoGetEnemyCluster = function(minCrowd)
    local character = PlayersService.LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local enemies = {}
    for _, player in ipairs(FWNoModules.PlayerSnapshot()) do
        if zenoIsEnemy(player) and player.Character then
            local enemyRoot = player.Character:FindFirstChild("HumanoidRootPart")
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            if enemyRoot and humanoid and humanoid.Health > 0
                and FWNoModules.ClearShot("Zeno", root.Position, enemyRoot.Position, player.Character) then
                enemies[#enemies + 1] = enemyRoot
            end
        end
    end
    local best, bestCount = nil, 0
    for _, enemyRoot in ipairs(enemies) do
        local count = 0
        for _, otherRoot in ipairs(enemies) do
            if (enemyRoot.Position - otherRoot.Position).Magnitude <= 15 then count += 1 end
        end
        if count >= minCrowd and count > bestCount then best, bestCount = enemyRoot, count end
    end
    return best
end

zenoFireAbility = function(abilityName, targetPosition, targetModel)
    if not zenoLoadRemotes() then return false end
    local character = PlayersService.LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root or not targetModel or not targetModel.Parent then return false end
    local enemyRoot = targetModel:FindFirstChild("HumanoidRootPart")
    local humanoid = targetModel:FindFirstChildOfClass("Humanoid")
    if not enemyRoot or not humanoid or humanoid.Health <= 0 then return false end
    -- Remotes/staff setup can yield in the original code. Validate visibility
    -- here, after setup, immediately before sending the ability.
    if not FWNoModules.ClearShot("Zeno", root.Position, enemyRoot.Position, targetModel) then return false end
    if abilityName == "SHOCKWAVE" then
        if (root.Position - enemyRoot.Position).Magnitude > zenoSettings.shockwaveRange then return false end
    elseif typeof(targetPosition) ~= "Vector3" then
        return false
    elseif (targetPosition - enemyRoot.Position).Magnitude > 0.01
        and not FWNoModules.ClearShot("Zeno", root.Position, targetPosition, targetModel) then
        return false
    end
    local sent = pcall(function() zenoData.abilityRemote:FireServer(abilityName, {target = targetPosition}) end)
    if not sent then return false end
    if zenoData.store then
        pcall(function()
            local duration = (abilityName == "LIGHTNING_STRIKE" and STRIKE_COOLDOWN)
                or (abilityName == "SHOCKWAVE" and SHOCKWAVE_COOLDOWN) or STORM_COOLDOWN
            zenoData.store:dispatch({type = "CooldownStart", cooldownId = abilityName, duration = duration})
            zenoData.store:dispatch({type = "SetAbilityCooldown", ability = abilityName, expire = os.clock() + duration})
        end)
    end
    return true
end

zenoOnHitTriggered = function()
    if not loops["auto zeno"] or zenoSettings.shockwaveMode ~= "On Hit" then return end
    if zenoGetMaxAvailableTier() < 2 then return end
    local now = os.clock()
    if now - zenoData.lastShockwave < SHOCKWAVE_COOLDOWN then return end
    local target = zenoGetTarget(zenoSettings.shockwaveRange)
    if not target then return end
    local didSwap = false
    if zenoGetStaffTier() == 0 then
        if not zenoSwapToStaff() then return end
        didSwap = true
    end
    if zenoFireAbility("SHOCKWAVE", Vector3.zero, target.Character) then zenoData.lastShockwave = now end
    if didSwap then task.delay(0.25, zenoSwapBack) end
end


zenoSetupNamecallHook = function()
	if zenoData.namecallHook then return end
	if not canRequire then return end
	if not hookmetamethod or not getnamecallmethod or not checkcaller then return end

	zenoData.namecallHook = true

	zenoData.oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
		local args = {...}
		local result = zenoData.oldNamecall(self, unpack(args))

		if not checkcaller() then
			pcall(function()
				method = getnamecallmethod()
				if method == "FireServer" or method == "InvokeServer" then
					remoteName = tostring(self)

					if remoteName == "SwordHit" or remoteName == "ProjectileHit" then
						zenoOnHitTriggered()
					end
				end
			end)
		end

		return result
	end)
end

zenoSetupDamageFallback = function()
	if zenoData.hitConn then return end

	pcall(function()
		netManaged = ReplicatedStorage:WaitForChild("rbxts_include", 5):WaitForChild("node_modules", 5):WaitForChild("@rbxts", 5):WaitForChild("net", 5):WaitForChild("out", 5):WaitForChild("_NetManaged", 5)
		entityDamaged = netManaged:WaitForChild("EntityDamageEvent", 5)

		zenoData.hitConn = FWNoModules.Connect(entityDamaged.OnClientEvent, function(data)
			if typeof(data) == "table" then
				if data.entityInstance == PlayersService.LocalPlayer.Character or data.fromEntity == PlayersService.LocalPlayer.Character then
					zenoOnHitTriggered()
				end
			end
		end)
	end)
end

zenoLoop = function()
    if not loops["auto zeno"] then return end
    local tier = zenoGetStaffTier()
    if tier == 0 then return end
    local now = os.clock()
    local character = PlayersService.LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    if zenoSettings.autoStrike and now - zenoData.lastStrike >= STRIKE_COOLDOWN then
        local target = zenoGetTarget(100)
        local enemyRoot = target and target.Character and target.Character:FindFirstChild("HumanoidRootPart")
        if enemyRoot then
            local offset = Vector3.new(math.random(-2, 2), 0, math.random(-2, 2))
            if zenoFireAbility("LIGHTNING_STRIKE", enemyRoot.Position + offset, target.Character) then zenoData.lastStrike = now end
        end
    end
    if tier >= 2 and zenoSettings.shockwaveMode == "In Range" and now - zenoData.lastShockwave >= SHOCKWAVE_COOLDOWN then
        local target = zenoGetTarget(zenoSettings.shockwaveRange)
        if target and zenoFireAbility("SHOCKWAVE", Vector3.zero, target.Character) then zenoData.lastShockwave = now end
    end
    if tier >= 3 and zenoSettings.stormEnabled and now - zenoData.lastStorm >= STORM_COOLDOWN then
        local target = zenoGetEnemyCluster(zenoSettings.stormCrowdSize)
        if target and zenoFireAbility("LIGHTNING_STORM", target.Position, target.Parent) then zenoData.lastStorm = now end
    end
end


