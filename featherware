adetundeRender = function()
	if not adetundeData.mainFrame then return end

	for i = 1, 3 do
		slot = adetundeData.slotFrames[i]
		if slot then
			for _, child in ipairs(slot:GetChildren()) do
				if child.Name == "Chip" then child:Destroy() end
			end
			upgradeType = adetundeData.slotOrder[i]
			if upgradeType then
				chip = adetundeMakeChip(upgradeType, slot)
				chip.Size = UDim2.new(1, -10, 0, 36)
				chip.Position = UDim2.new(0, 5, 0, 45)
				adetundeBindDrag(chip, "slot", i, upgradeType)
			end
		end
	end

	if adetundeData.poolFrame then
		for _, child in ipairs(adetundeData.poolFrame:GetChildren()) do
			if child.Name == "Chip" then child:Destroy() end
		end
		inSlots = {}
		for _, v in ipairs(adetundeData.slotOrder) do if v then inSlots[v] = true end end

		for _, t in ipairs({"shield", "strength", "speed"}) do
			if not inSlots[t] then
				chip = adetundeMakeChip(t, adetundeData.poolFrame)
				chip.Size = UDim2.new(0, 90, 0, 28)
				adetundeBindDrag(chip, "pool", nil, t)
			end
		end
	end

	if adetundeData.tier3Btns then
		for t, btn in pairs(adetundeData.tier3Btns) do
			if t == adetundeData.tier3Choice then
				btn.BackgroundColor3 = Color3.fromRGB(78, 173, 73)
				btn.TextColor3 = Color3.fromRGB(255, 255, 255)
			else
				btn.BackgroundColor3 = Color3.fromRGB(35, 35, 38)
				btn.TextColor3 = Color3.fromRGB(160, 160, 160)
			end
		end
	end

	if adetundeData.statusLbl then
		if adetundeData.complete then
			adetundeData.statusLbl.Text = "✓ All upgrades maxed"
			adetundeData.statusLbl.TextColor3 = Color3.fromRGB(78, 173, 73)
		elseif adetundeData.crystalCache <= 0 then
			adetundeData.statusLbl.Text = "Waiting for Frost Crystals..."
			adetundeData.statusLbl.TextColor3 = Color3.fromRGB(255, 200, 80)
		else
			adetundeData.statusLbl.Text = "Auto-upgrading..."
			adetundeData.statusLbl.TextColor3 = Color3.fromRGB(200, 200, 200)
		end
	end
end

