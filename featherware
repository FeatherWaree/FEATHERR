cyberFindBase = function()
	myTeam = PlayersService.LocalPlayer.Team
	if not myTeam then return nil end
	teamColor = myTeam.TeamColor.Color

	-- Look for a SpawnLocation with our team color (Most reliable base finder)
	for _, obj in ipairs(G.Services.Workspace:GetDescendants()) do
		if obj:IsA("SpawnLocation") and obj.Color == teamColor then
			return obj.Position
		end
	end

	-- Fallback: Look for a Bed model that matches our team color
	for _, obj in ipairs(G.Services.Workspace:GetDescendants()) do
		if obj:IsA("Model") and (obj.Name == "Bed" or obj.Name == "BedBottom") then
			primary = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
			if primary and primary.Color == teamColor then
