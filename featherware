end

local function getFiringSolution(origin, targetStartPos, targetVelocity, projectileSpeed, gravity)
	local predictedPos = targetStartPos
	local timeOfFlight = 0
	local angle = 0

	for i = 1, 4 do
		predictedPos = targetStartPos + (targetVelocity * timeOfFlight)

		local diff = predictedPos - origin
		local horizontalDist = Vector2.new(diff.X, diff.Z).Magnitude
		local verticalDist = diff.Y

		local v2 = projectileSpeed ^ 2
		local v4 = projectileSpeed ^ 4

		-- Use the custom gravity passed into the function
		local root = v4 - gravity * (gravity * horizontalDist^2 + 2 * verticalDist * v2)

		if root < 0 then
			return nil, nil, nil 
		end

		angle = math.atan2(v2 - math.sqrt(root), gravity * horizontalDist)

		local horizontalVelocity = projectileSpeed * math.cos(angle)
		timeOfFlight = horizontalDist / horizontalVelocity
	end

	local diff = predictedPos - origin
	local dir = Vector3.new(diff.X, 0, diff.Z).Unit

	local aimVector = dir * (projectileSpeed * math.cos(angle))
	aimVector += Vector3.new(0, projectileSpeed * math.sin(angle), 0)

	return aimVector, predictedPos, timeOfFlight
end


local function hasLineOfSight(originPart, targetPart, playerCharacter)
	if not originPart or not targetPart then return false end
	local origin = originPart.Position
	local targetPos = targetPart.Position
	local direction = targetPos - origin

	local raycastOrigin = origin + (direction.Unit * 2.5)
	local raycastDirection = targetPos - raycastOrigin

	local raycastParams = RaycastParams.new()
	raycastParams.FilterDescendantsInstances = {playerCharacter, targetPart.Parent}
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	raycastParams.RespectCanCollide = true 

	local raycastResult = G.Services.Workspace:Raycast(raycastOrigin, raycastDirection, raycastParams)
	return raycastResult == nil
end


local function findClosestPlr(radius, rootPart)
	closestCharacter = nil
	shortestDistance = radius 

	for _, targetPlayer in ipairs(FWNoModules.PlayerSnapshot()) do
		if targetPlayer ~= Player and targetPlayer.Team ~= Player.Team then
			character = targetPlayer.Character

			if character then
				targetRoot = character:FindFirstChild("HumanoidRootPart")

				if targetRoot then	
					distance = (rootPart.Position - targetRoot.Position).Magnitude

					if distance < shortestDistance then
						closestCharacter = character
						shortestDistance = distance
					end
				end
			end
		end
	end

	if closestCharacter then
		return closestCharacter, shortestDistance
	else
		return nil, nil
	end
end


local function findClosestNPC(radius, rootPart)
	closestNPC = nil
	shortestDistance = radius

	for _, npc in ipairs(G.Services.Workspace:GetChildren()) do

		if npc:IsA("Model") then
			humanoid = npc:FindFirstChild("Humanoid")
			targetRoot = npc.PrimaryPart or npc:FindFirstChild("HumanoidRootPart")

			if humanoid and humanoid.Health > 0 and targetRoot and not Players:GetPlayerFromCharacter(npc) then

				distance = (rootPart.Position - targetRoot.Position).Magnitude

				if distance < shortestDistance then
					closestNPC = npc
					shortestDistance = distance
				end
			end
		end
	end

	if closestNPC then
		return closestNPC, shortestDistance
	else
		return nil, nil
	end
end


