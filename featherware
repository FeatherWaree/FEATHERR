-- Update the toggle callback
ProjectileTracers.Callbacks.OnToggle = function(state)
	loops["projectile tracers"] = state

	if state then
		-- Try event-based first (optimized)
		eventSuccess = setupEventBasedTracers()

		if not eventSuccess then
			-- Fallback to G.Services.Workspace scanner
			connectG.Services.WorkspaceScanner()
		end

		-- Apply to existing projectiles
		for _, obj in pairs(G.Services.Workspace:GetDescendants()) do
			if VALID_PROJECTILES[obj.Name] then
				applyTracer(obj, false)
			end
		end
		for _, child in pairs(ProjectileTargeting:GetDescendants()) do
			applyTracer(child, true)
		end
	else
		-- Disconnect all connections
		for i, conn in ipairs(projectileTracerConnections) do
			if conn.Disconnect then
				conn:Disconnect()
			end
		end
		projectileTracerConnections = {}
	end
end

