				end
			end
		end)
	end

	if not cryptData.loopConn then
		cryptData.loopConn =FWNoModules.TrackFrameConnection(G.Services.RunService.Heartbeat:Connect(function()
			if not loops["auto crypt"] then return end

			now = os.clock()
			if now - (cryptData.lastLoop or 0) < 0.2 then return end 
			cryptData.lastLoop = now

			cryptScan()
		end))
	end
end

cryptStop = function()
	if cryptData.loopConn then pcall(function() cryptData.loopConn:Disconnect() end) cryptData.loopConn = nil end
	if cryptData.addedConn then pcall(function() cryptData.addedConn:Disconnect() end) cryptData.addedConn = nil end
	cryptData.processed = {}
end

