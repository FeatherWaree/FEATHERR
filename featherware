laniDiscoverSwap = function()
	if laniData.swapRemote or laniData.swapSearchDone then return end

	remotes = {}
	pcall(function()
		net = ReplicatedStorage:WaitForChild("rbxts_include", 5):WaitForChild("node_modules", 5):WaitForChild("@rbxts", 5):WaitForChild("net", 5):WaitForChild("out", 5):WaitForChild("_NetManaged", 5)
		for _, obj in ipairs(net:GetChildren()) do table.insert(remotes, obj) end
	end)
	pcall(function()
		ev = ReplicatedStorage:WaitForChild("events-@easy-games/game-core:shared/game-core-networking@getEvents.Events", 5)
		for _, obj in ipairs(ev:GetChildren()) do table.insert(remotes, obj) end
	end)

	candidates = {}
	for _, obj in ipairs(remotes) do
		n = obj.Name:lower()
		if n:find("hotbar") or n:find("swap") or n:find("equip") or n:find("hand") or n:find("slot") then
			table.insert(candidates, obj)
		end
	end

	if #candidates == 0 then return end
	laniData.swapSearchDone = true

	pinv = laniGetInv()
	slot0, slot1 = nil, nil
	if pinv then
		for i, child in ipairs(pinv:GetChildren()) do
			if child.Name == "scepter" then
				slot0 = i - 1
				slot1 = i
				break
			end
		end
	end
	laniData.swapSlot0 = slot0
	laniData.swapSlot1 = slot1
	scepter = laniGetScepterInstance()

	kinds = {}
	if slot0 then table.insert(kinds, {"table_slot", {slot = slot0}}) end
	if slot1 then table.insert(kinds, {"table_hotbarslot", {hotbarSlot = slot1}}) end
	if slot0 then table.insert(kinds, {"num", slot0}) end
	if slot1 then table.insert(kinds, {"num1", slot1}) end
	table.insert(kinds, {"table_itemType", {itemType = "scepter"}})
	table.insert(kinds, {"string", "scepter"})
	if scepter then table.insert(kinds, {"table_item", {item = scepter}}) end

	for _, remote in ipairs(candidates) do
		for _, kindArgs in ipairs(kinds) do
			kind = kindArgs[1]
			args = kindArgs[2]
			pcall(function()
				if remote.ClassName == "RemoteFunction" then
					remote:InvokeServer(args)
				else
					remote:FireServer(args)
				end
			end)
			task.wait(0.2)
			if laniHoldingScepter() then
				laniData.swapRemote = remote
				laniData.swapArgsKind = kind
				return
			end
			if not loops["auto lani"] then return end
		end
	end
end

laniBuildSwapArgs = function()
	kind = laniData.swapArgsKind
	if kind == "table_slot" then return {slot = laniData.swapSlot0} end
	if kind == "table_hotbarslot" then return {hotbarSlot = laniData.swapSlot1} end
	if kind == "num" then return laniData.swapSlot0 end
	if kind == "num1" then return laniData.swapSlot1 end
	if kind == "table_itemType" then return {itemType = "scepter"} end
	if kind == "string" then return "scepter" end
	if kind == "table_item" then return {item = laniGetScepterInstance()} end
	return nil
end

laniDoSwap = function()
	if not laniData.swapRemote then laniDiscoverSwap() end
	if not laniData.swapRemote then
		if not laniData.swapWarned then
			laniData.swapWarned = true
			warn("[Featherware] Could not find hotbar swap remote - hold the scepter manually")
		end
		return false
	end
	args = laniBuildSwapArgs()
	pcall(function()
		if laniData.swapRemote.ClassName == "RemoteFunction" then
			laniData.swapRemote:InvokeServer(args)
		else
			laniData.swapRemote:FireServer(args)
		end
	end)
	task.wait(0.25)
	return laniHoldingScepter()
end

