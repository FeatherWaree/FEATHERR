function NotificationSystem.Notify(title, text, duration)
	local cfg = NotificationSystem.Settings
	if not cfg.Enabled then return end
	duration = duration or cfg.Lifetime

	local WIDTH        = cfg.Width  or 300
	local HEIGHT       = cfg.Height or 64
	local RIGHT_MARGIN = 28 
	local TOP_MARGIN   = 16
	local GAP          = 10
	local accent       = cfg.AccentColor or Color3.fromRGB(78, 173, 73)
	local barColor     = Color3.fromRGB(255, 255, 255) 

	local SLIDE_OUT = TweenInfo.new(0.40, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
	local RESTACK   = TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)

	NotificationSystem._stack = NotificationSystem._stack or {}
	local stack = NotificationSystem._stack

	local function layoutStack()
		for i, f in ipairs(stack) do
			if f and f.Parent then
				local y = TOP_MARGIN + (i - 1) * (HEIGHT + GAP)
				TweenService:Create(f, RESTACK, {
					Position = UDim2.new(1, -RIGHT_MARGIN, 0, y),
				}):Play()
			end
		end
	end

	local frame = Instance.new("TextButton")
	frame.AutoButtonColor = false       
	frame.Text = ""                  
	frame.Size = UDim2.new(0, WIDTH, 0, HEIGHT)
	frame.BackgroundColor3 = cfg.BackgroundColor or Color3.fromRGB(26, 26, 30)
	frame.BorderSizePixel = 0
	frame.ClipsDescendants = true
	frame.AnchorPoint = Vector2.new(1, 0)
	frame.Parent = holder

	Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)

	local stroke = Instance.new("UIStroke", frame)
	stroke.Color = Color3.fromRGB(255, 255, 255)
	stroke.Transparency = 0.9
	stroke.Thickness = 1

	local gradient = Instance.new("UIGradient", frame)
	gradient.Rotation = 90
	gradient.Color = ColorSequence.new(
		Color3.fromRGB(34, 34, 40),
		Color3.fromRGB(19, 19, 23)
	)

	local accentBar = Instance.new("Frame", frame)  
	accentBar.Size = UDim2.new(0, 4, 1, 0)
	accentBar.BackgroundColor3 = barColor      
	accentBar.BorderSizePixel = 0
	Instance.new("UICorner", accentBar).CornerRadius = UDim.new(0, 2)

	local titleLbl = Instance.new("TextLabel", frame)
	titleLbl.BackgroundTransparency = 1
	titleLbl.Position = UDim2.new(0, 16, 0, 9)
	titleLbl.Size = UDim2.new(1, -28, 0, 18)
	titleLbl.Text = tostring(title)
	titleLbl.TextColor3 = cfg.TitleColor or Color3.fromRGB(242, 242, 246)
	titleLbl.Font = Enum.Font.GothamBold
	titleLbl.TextSize = 14
	titleLbl.TextXAlignment = Enum.TextXAlignment.Left
	titleLbl.TextYAlignment = Enum.TextYAlignment.Center

	local textLbl = Instance.new("TextLabel", frame)
	textLbl.BackgroundTransparency = 1
	textLbl.Position = UDim2.new(0, 16, 0, 28)
	textLbl.Size = UDim2.new(1, -28, 1, -34)
	textLbl.Text = tostring(text)
	textLbl.TextColor3 = cfg.TextColor or Color3.fromRGB(172, 174, 186)
	textLbl.Font = Enum.Font.GothamMedium
	textLbl.TextSize = 13
	textLbl.TextWrapped = true
	textLbl.RichText = true
	textLbl.TextXAlignment = Enum.TextXAlignment.Left
	textLbl.TextYAlignment = Enum.TextYAlignment.Top

	local progress = Instance.new("Frame", frame)
	progress.Size = UDim2.new(1, 0, 0, 2)
	progress.Position = UDim2.new(0, 0, 1, -2)
	progress.BackgroundColor3 = barColor
	progress.BorderSizePixel = 0

	table.insert(stack, frame)
	local slotY = TOP_MARGIN + (#stack - 1) * (HEIGHT + GAP)
	frame.Position = UDim2.new(1, WIDTH + 24, 0, slotY) 
	layoutStack() 

	local progressTween = TweenService:Create(progress,
		TweenInfo.new(duration, Enum.EasingStyle.Linear),
		{ Size = UDim2.new(0, 0, 0, 2) }
	)
	progressTween:Play()

	-- ===== one dismiss routine for BOTH the timer and the click =====
	local dismissed = false
	local function dismiss()
		if dismissed then return end
		dismissed = true
		progressTween:Cancel()

		for i, f in ipairs(stack) do
			if f == frame then table.remove(stack, i) break end
		end
		layoutStack()  

		local exit = TweenService:Create(frame, SLIDE_OUT, {
			Position = UDim2.new(1, WIDTH + 24, 0, frame.Position.Y.Offset),
			BackgroundTransparency = 1,
		})
		exit:Play()
		for _, v in ipairs(frame:GetDescendants()) do
			if v:IsA("TextLabel") then
				TweenService:Create(v, SLIDE_OUT, { TextTransparency = 1 }):Play()
			elseif v:IsA("UIStroke") then
				TweenService:Create(v, SLIDE_OUT, { Transparency = 1 }):Play()
			elseif v:IsA("Frame") and v ~= frame then
				TweenService:Create(v, SLIDE_OUT, { BackgroundTransparency = 1 }):Play()
			end
		end
		exit.Completed:Wait()
		frame:Destroy()
	end

	frame.MouseButton1Click:Connect(dismiss) 
	task.delay(duration, dismiss)
end

local function UninjectFW()
	saveConfigToPC()

	-- STEP 1: Turn off EVERY registered module (calls their OnToggle(false) which disconnects their loops/connections)
	if _G.__FW_ALL_MODULES then
		for _, m in ipairs(_G.__FW_ALL_MODULES) do
			if m.Toggled then
				pcall(function()
					if m.Callbacks and m.Callbacks.OnToggle then
						m.Callbacks.OnToggle(false)
					end
				end)
				m.Toggled = false
			end
		end
	end

	-- STEP 2: Force all loops to false
	if mainScreenUI then
		mainScreenUI:SetAttribute("Running", false)
	end
	for index, _ in pairs(loops) do
		loops[index] = false
	end

	-- STEP 3: Explicitly disconnect any remaining known connections
	pcall(function()

		fwKilled = true


		-- Shaders
		if WeatherRenderLoop then WeatherRenderLoop:Disconnect() WeatherRenderLoop = nil end
		-- ESP
		if espConnections then
			for _, c in pairs(espConnections) do pcall(function() c:Disconnect() end) end
			espConnections = {}
		end
		if activeESPCache then
			for _, data in pairs(activeESPCache) do
				if data.Frame2D then pcall(function() data.Frame2D:Destroy() end) end
				if data.Box3D then pcall(function() data.Box3D:Destroy() end) end
				for _, line in pairs(data.SkeletonLines or {}) do pcall(function() line:Destroy() end) end
			end
			activeESPCache = {}
		end
		-- Chams
		if chams_active then
			for _, hl in pairs(chams_active) do pcall(function() hl:Destroy() end) end
			chams_active = {}
		end
		if chamsFolder then pcall(function() chamsFolder:Destroy() end) chamsFolder = nil end
		-- Tracers
		if tr_renderConn then tr_renderConn:Disconnect() tr_renderConn = nil end
		if tr_gui then pcall(function() tr_gui:Destroy() end) tr_gui = nil end
		-- Velocity
		if velocityConnection then velocityConnection:Disconnect() velocityConnection = nil end
		-- Fly
		pcall(stopFlying)
		-- Nuker
		if NukerConnection then NukerConnection:Disconnect() NukerConnection = nil end
