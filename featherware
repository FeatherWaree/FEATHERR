					overlapParams.FilterType = Enum.RaycastFilterType.Exclude
					nearbyParts = G.Services.Workspace:GetPartBoundsInRadius(rootPart.Position, maxRange, overlapParams)
					for i = 1, #nearbyParts do
						part = nearbyParts[i]
						if part.Name == "RootPart" and part.Parent and TARGET_STARS[part.Parent.Name] then
							task.defer(processStar, part.Parent)
						end
					end
				end
				task.wait(0.25)
			end
			autoStarThread = nil
		end)
	end
end


local function isHoldingMetalDetector(character)
	if character:FindFirstChild("metal_detector") then
		return true
	end

	local handInvItem = character:FindFirstChild("HandInvItem")
	if handInvItem and handInvItem:IsA("ValueObject") and handInvItem.Value then
		if handInvItem.Value.Name == "metal_detector" or (handInvItem.Value:IsA("Instance") and handInvItem.Value.Name == "metal_detector") then
			return true
		end
	end
	return false
end

local function processMetal(model)
	if not loops["auto metal"] then return end
	if model.Name ~= "Model" or not model:FindFirstChild("hidden-metal-prompt") then return end

	if activeProcesses[model] then return end

	local character = Player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not rootPart then return end

	local requireHeld = AutoMetal.Values and AutoMetal.Values["Require Metal Detector Held"]
	if requireHeld and not isHoldingMetalDetector(character) then return end

	local metalPart = model:FindFirstChild("Part")
	if not metalPart then return end

	local maxRange = (AutoMetal.Values and AutoMetal.Values["Range"]) or 10
	local distance = (rootPart.Position - metalPart.Position).Magnitude

	if distance <= maxRange then
		activeProcesses[model] = true

		task.spawn(function()
			local holdTime = (AutoMetal.Values and AutoMetal.Values["Proximity Hold Time"]) or 0
			if holdTime > 0 then
				task.wait(holdTime)
			end

			activeProcesses[model] = nil

			if not loops["auto metal"] then return end
			local currentCharacter = Player.Character
			local currentRoot = currentCharacter and currentCharacter:FindFirstChild("HumanoidRootPart")
			if not currentRoot or not model:IsDescendantOf(G.Services.Workspace) or not metalPart:IsDescendantOf(G.Services.Workspace) then return end

			if requireHeld and not isHoldingMetalDetector(currentCharacter) then return end

			local currentDistance = (currentRoot.Position - metalPart.Position).Magnitude
			local currentMaxRange = (AutoMetal.Values and AutoMetal.Values["Range"]) or 10

			if currentDistance <= currentMaxRange then
				local metalId = model:GetAttribute("id") or model:GetAttribute("Id")
				if metalId then
					activeProcesses[model] = true 

					local args = {
						{
							id = metalId
						}
					}

					CollectRemote:FireServer(unpack(args))

					if AutoMetal.Values and AutoMetal.Values["Use Collect Animation"] then
						local humanoid = currentCharacter:FindFirstChildOfClass("Humanoid")
						if humanoid then
							local anim = Instance.new("Animation")
							anim.AnimationId = "rbxassetid://9378575104"

							local animator = humanoid:FindFirstChildOfClass("Animator") or humanoid
							local track = animator:LoadAnimation(anim)

							track.Looped = false
							track:Play()
							if canRequire then
								SoundManager:playSound(GameSound.SNAP_TRAP_CONSUME_MARK)
							end
							task.spawn(function()
								track.Stopped:Wait()
								anim:Destroy()
							end)
						end
					end
				end
			end
		end)
	end
end


autoMetalThread = nil
local oldAutoMetalToggle = AutoMetal.Callbacks.OnToggle
AutoMetal.Callbacks.OnToggle = function(state)
	if oldAutoMetalToggle then oldAutoMetalToggle(state) end
	loops["auto metal"] = state
	if autoMetalThread then task.cancel(autoMetalThread) autoMetalThread = nil end
	if loops["auto metal"] then
		autoMetalThread = task.spawn(function()
			while loops["auto metal"] do
				character = Player.Character
				rootPart = character and character:FindFirstChild("HumanoidRootPart")
				if rootPart then
					requireHeld = AutoMetal.Values and AutoMetal.Values["Require Metal Detector Held"]
					if not requireHeld or isHoldingMetalDetector(character) then
						maxRange = (AutoMetal.Values and AutoMetal.Values["Range"]) or 10
						overlapParams = OverlapParams.new()
						overlapParams.FilterType = Enum.RaycastFilterType.Exclude
						nearbyParts = G.Services.Workspace:GetPartBoundsInRadius(rootPart.Position, maxRange, overlapParams)
						for i = 1, #nearbyParts do
							part = nearbyParts[i]
							if part.Name == "Part" and part.Parent and part.Parent:IsA("Model") and part.Parent.Name == "Model" then
								processMetal(part.Parent)
							end
						end
					end
				end
				task.wait(0.5)
			end
			autoMetalThread = nil
		end)
	end
end




hannahSettings = {
	range = 25
}

hannahData = {
	connections = {},
	trackedTargets = {},
	lastFired = {},
	remote = nil
}

hannahLoadRemote = function()
	if hannahData.remote then return true end
	pcall(function()
		hannahData.remote = HannahRemote
	end)
	return hannahData.remote ~= nil
end

hannahIsValidTarget = function(entity)
	if not entity or not entity.Parent then return false end
	if entity == Player.Character then return false end
	hum = entity:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return false end
	plr = Players:GetPlayerFromCharacter(entity)
	if plr then
		if plr == Player then return false end
		if plr.Team and Player.Team and plr.Team == Player.Team then return false end
	end
	return true
end

hannahTryExecute = function(entity)
	if not loops["auto hannah"] then return end
	if not hannahIsValidTarget(entity) then return end

	now = os.clock()
	if hannahData.lastFired[entity] and now - hannahData.lastFired[entity] < 0.5 then return end

	myChar = Player.Character
	myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	targetRoot = entity:FindFirstChild("HumanoidRootPart") or entity.PrimaryPart

	if not myRoot or not targetRoot then return end

	dist = (myRoot.Position - targetRoot.Position).Magnitude
	if dist > hannahSettings.range then return end

	if hannahLoadRemote() then
		hannahData.lastFired[entity] = now
		task.spawn(function()
			pcall(function()
				hannahData.remote:InvokeServer({user = Player, victimEntity = entity})
			end)
		end)
	end
end

hannahHookEntity = function(entity)
	if not entity:IsA("Model") then return end
	if hannahData.trackedTargets[entity] then return end

	hannahData.trackedTargets[entity] = true
	hannahTryExecute(entity)
end

hannahStart = function()
	if hannahData.connections.active then return end
	hannahData.connections.active = true

	cs = game:GetService("CollectionService")

	for _, entity in ipairs(cs:GetTagged("HannahExecuteInteraction")) do
		hannahHookEntity(entity)
	end

	hannahData.connections.added = cs:GetInstanceAddedSignal("HannahExecuteInteraction"):Connect(function(entity)
		hannahHookEntity(entity)
	end)

	hannahData.connections.removed = cs:GetInstanceRemovedSignal("HannahExecuteInteraction"):Connect(function(entity)
		hannahData.trackedTargets[entity] = nil
		hannahData.lastFired[entity] = nil
	end)

	hannahData.connections.heartbeat = G.Services.RunService.Heartbeat:Connect(function()
		if not loops["auto hannah"] then return end
		myChar = Player.Character
		myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
		if not myRoot then return end

		for entity in pairs(hannahData.trackedTargets) do
			if entity and entity.Parent then
				targetRoot = entity:FindFirstChild("HumanoidRootPart") or entity.PrimaryPart
				if targetRoot then
					dist = (myRoot.Position - targetRoot.Position).Magnitude
					if dist <= hannahSettings.range then
						hannahTryExecute(entity)
					end
				end
			else
				hannahData.trackedTargets[entity] = nil
				hannahData.lastFired[entity] = nil
			end
		end
	end)
end

hannahStop = function()
	hannahData.connections.active = false
	if hannahData.connections.added then hannahData.connections.added:Disconnect() hannahData.connections.added = nil end
	if hannahData.connections.removed then hannahData.connections.removed:Disconnect() hannahData.connections.removed = nil end
	if hannahData.connections.heartbeat then hannahData.connections.heartbeat:Disconnect() hannahData.connections.heartbeat = nil end
	table.clear(hannahData.trackedTargets)
	table.clear(hannahData.lastFired)
end

