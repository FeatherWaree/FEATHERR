function paResolve(itemType, inst)
	par_low = itemType:lower()
	if par_low:find("arrow") then return nil end
	if not paGetItemMeta then return nil end
	p_ok, p_m = pcall(paGetItemMeta, itemType)
	if not p_ok or type(p_m) ~= "table" then return nil end
	par_ps = p_m.projectileSource
	if not par_ps and p_m.multiProjectileSource then
		for _, v in pairs(p_m.multiProjectileSource) do
			if type(v) == "table" then par_ps = v break end
		end
	end
	if not par_ps or type(par_ps) ~= "table" then return nil end
	if p_m.block then return nil end
	par_blacklist = {"fireball", "telepearl"}
	for _, bl_name in ipairs(par_blacklist) do
		if itemType:lower():find(bl_name) then return nil end
	end
	par_kind, par_ammo = "weapon", nil
	par_ammoTypes = par_ps.ammoItemTypes
	if par_ammoTypes and #par_ammoTypes > 0 then
		if #par_ammoTypes == 1 and par_ammoTypes[1] == itemType then
			par_kind, par_ammo = "throw", itemType
		else
			par_avail = {}
			for _, a in ipairs(par_ammoTypes) do
				if paAmount(a) > 0 then table.insert(par_avail, a) end
			end
			par_ammo = par_avail[1] or par_ammoTypes[1]
			for _, a in ipairs(par_avail) do
				par_la = tostring(a):lower()
				if not par_la:find("firework") and not par_la:find("volley") then par_ammo = a break end
			end
		end
	end
	par_proj = nil
	if type(par_ps.projectileType) == "function" then
		p_ok2, p_res = pcall(par_ps.projectileType, par_ammo or itemType)
		if p_ok2 and type(p_res) == "string" then par_proj = p_res end
	end
	par_proj = par_proj or itemType
	par_pm = PA_PROJ_META[par_proj]
	drawAnim, fireAnim, launchSnd, chargeSnd, speedMult = nil, nil, nil, nil, 1
	fireDelay = par_ps.fireDelaySec or 0.6
	maxCharge = par_ps.maxStrengthChargeSec or 0
	launchSnd = par_ps.launchSound
	chargeSnd = par_ps.chargeBeginSound
	speedMult = par_ps.walkSpeedMultiplier or 1
	if par_ps.thirdPerson then
		drawAnim = par_ps.thirdPerson.drawAnimation
		fireAnim = par_ps.thirdPerson.fireAnimation
	end
	if par_pm then
		launchSnd = launchSnd or par_pm.launchSound or par_pm.sound
		chargeSnd = chargeSnd or par_pm.chargeBeginSound
		drawAnim = drawAnim or par_pm.drawAnimation
		fireAnim = fireAnim or par_pm.fireAnimation
		speedMult = par_pm.slowdown or par_pm.moveSpeedMultiplier or par_pm.walkSpeedMultiplier or speedMult
		fireDelay = par_pm.fireDelaySec or fireDelay
		maxCharge = par_pm.drawDurationSec or maxCharge
	end
	if paAnimType then
		par_isSpear = par_low:find("spear") or par_low:find("trident") or par_low:find("harpoon")
		if not fireAnim then
			if par_isSpear then fireAnim = paAnimType.SPEAR_THROW
			elseif par_kind == "throw" then fireAnim = paAnimType.PUNCH end
		end
		if not drawAnim and par_isSpear then
			drawAnim = paAnimType.SPEAR_STARTUP or paAnimType.SPEAR_CHARGE_1
		end
	end
	return {
		weapon = inst, ammo = par_ammo, projectile = par_proj,
		damage = (par_pm and par_pm.combat and par_pm.combat.damage) or 0,
		kind = par_kind,
		drawAnim = drawAnim, fireAnim = fireAnim,
		launchSnd = launchSnd, chargeSnd = chargeSnd, speedMult = speedMult,
		fireDelay = fireDelay, maxCharge = maxCharge
	}
end

