adetundeLoadRemote = function()
	if adetundeData.upgradeRemote then return true end
	pcall(function()
		netManaged = ReplicatedStorage:WaitForChild("rbxts_include", 5):WaitForChild("node_modules", 5):WaitForChild("@rbxts", 5):WaitForChild("net", 5):WaitForChild("out", 5):WaitForChild("_NetManaged", 5)
		adetundeData.upgradeRemote = netManaged:WaitForChild("UpgradeFrostyHammer", 5)
	end)
	return adetundeData.upgradeRemote ~= nil
end

adetundeGetCrystals = function()
	invFolder = FWNoModules.GetPrivateInventoryContainer()
	if not invFolder then return 0 end
	playerInv = FWNoModules.GetPrivateInventory(Player.Name)
	if not playerInv then return 0 end
	crystalObj = playerInv:FindFirstChild("frost_crystal")
	if not crystalObj then return 0 end
	amt = crystalObj:GetAttribute("Amount")
	return tonumber(amt) or 0
end

adetundeEffectiveMax = function(upgradeType)
	if upgradeType == adetundeData.tier3Choice then return 3 end
	return 2
end

adetundeCanUpgrade = function(upgradeType)
	current = adetundeData.tiers[upgradeType] or 0
	return current < adetundeEffectiveMax(upgradeType)
end

adetundeAllMaxed = function()
	for _, t in ipairs({"shield", "strength", "speed"}) do
		if adetundeCanUpgrade(t) then return false end
	end
	return true
end

adetundeTryUpgrade = function(upgradeType)
	if not adetundeCanUpgrade(upgradeType) then return false end
	if adetundeGetCrystals() <= 0 then return false end
	if not adetundeLoadRemote() then return false end

	result = nil
	pcall(function()
		result = adetundeData.upgradeRemote:InvokeServer(upgradeType)
	end)

	if type(result) == "table" then
		for _, t in ipairs({"shield", "strength", "speed"}) do
			if type(result[t]) == "number" then
				adetundeData.tiers[t] = result[t]
			end
		end
		adetundeRender()
		return true
	end
	return false
end

