	box3D.Size = sz
	box3D.CFrame = cf
	box3D.Transparency = 1
	box3D.Parent = model

	weld3D = FWNoModules.OwnInstance(Instance.new("WeldConstraint"))
	weld3D.Part0 = box3D
	weld3D.Part1 = hrp
	weld3D.Parent = box3D

	sel3D = FWNoModules.OwnInstance(Instance.new("SelectionBox"))
	sel3D.Adornee = box3D
	sel3D.LineThickness = 0.05
	sel3D.Visible = false
