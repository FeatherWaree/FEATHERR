-- Resolve the inventory from the player's own GUI. Never use another
-- player's items when the requested inventory is unavailable on this client.
function FWNoModules.GetPrivateInventoryContainer(playerOrName)
    local players = game:GetService("Players")
    local player
    if playerOrName == nil then
        player = players.LocalPlayer
    elseif type(playerOrName) == "string" then
        player = players:FindFirstChild(playerOrName)
    elseif typeof(playerOrName) == "Instance" and playerOrName:IsA("Player") then
        player = playerOrName
    end
    if not player then return nil end
    local gui = player:FindFirstChild("PlayerGui")
    return gui and gui:FindFirstChild("PrivateInventory") or nil
end

function FWNoModules.GetPrivateInventory(playerOrName)
    local players = game:GetService("Players")
    local playerName
    if playerOrName == nil then
        playerName = players.LocalPlayer and players.LocalPlayer.Name
    elseif type(playerOrName) == "string" then
        playerName = playerOrName
    elseif typeof(playerOrName) == "Instance" and playerOrName:IsA("Player") then
        playerName = playerOrName.Name
    end
    if not playerName then return nil end
    local container = FWNoModules.GetPrivateInventoryContainer(playerOrName)
    return container and container:FindFirstChild(playerName) or nil
end

-- This bridge observes real deaths and releases each departed humanoid.
do
    local runtime = FWNoModules.Runtime
    local deathSignal = FWNoModules.OwnInstance(Instance.new("BindableEvent"))
    local records = {}
    local active = true
    FWNoModules.DeathSignal = deathSignal

    local function remove(humanoid)
        local record = records[humanoid]
        if not record then return end
        records[humanoid] = nil
        record.died:Disconnect()
        record.destroying:Disconnect()
    end
    local function watch(humanoid)
        if not active or not humanoid:IsA("Humanoid") or records[humanoid] then return end
        local record = {}
        records[humanoid] = record
        record.died = FWNoModules.Connect(humanoid.Died, function()
            if not active then return end
            local entity = humanoid.Parent
            if not entity or not entity:IsA("Model") then return end
            deathSignal:Fire({
                entityInstance = entity,
                victim = game:GetService("Players"):GetPlayerFromCharacter(entity),
                fromEntity = nil,
                source = "Humanoid.Died",
            })
        end)
        record.destroying = FWNoModules.Connect(humanoid.Destroying, function() remove(humanoid) end)
    end
    local added = FWNoModules.Connect(workspace.DescendantAdded, watch)
    local removed = FWNoModules.Connect(workspace.DescendantRemoving, remove)
    for _, object in ipairs(workspace:GetDescendants()) do
        if object:IsA("Humanoid") then watch(object) end
    end
    local function stop()
        if not active then return end
        active = false
        added:Disconnect()
        removed:Disconnect()
        for _, record in pairs(records) do record.died:Disconnect(); record.destroying:Disconnect() end
        table.clear(records)
        deathSignal:Destroy()
    end
    FWNoModules.StopDeathBridge = stop
    FWNoModules.OnCleanup(stop)
end


