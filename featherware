do
    local boundCharacter
    local addedConnection
    local removingConnection
    local function clearCharacterCache()
        if addedConnection then addedConnection:Disconnect(); addedConnection = nil end
        if removingConnection then removingConnection:Disconnect(); removingConnection = nil end
        boundCharacter = nil
        cachedChar, cachedHRP, cachedHumanoid = nil, nil, nil
        cachedVelocityHRP, cachedVelocityHum = nil, nil
        table.clear(phaseParts)
    end
    local function bindCharacterCache(char)
        clearCharacterCache()
        if not char or Player.Character ~= char then return end
        boundCharacter = char
        cachedChar = char
        cachedHRP = char:FindFirstChild("HumanoidRootPart")
        cachedHumanoid = char:FindFirstChildOfClass("Humanoid")
        cachedVelocityHRP, cachedVelocityHum = cachedHRP, cachedHumanoid
        CachePhaseParts(char)
        addedConnection = FWNoModules.Connect(char.DescendantAdded, function(part)
            if boundCharacter ~= char then return end
            if part.Parent == char then
                if part.Name == "HumanoidRootPart" then cachedHRP = part; cachedVelocityHRP = part end
                if part:IsA("Humanoid") then cachedHumanoid = part; cachedVelocityHum = part end
            end
            if part:IsA("BasePart") and not table.find(phaseParts, part) then
                phaseParts[#phaseParts + 1] = part
            end
        end)
        removingConnection = FWNoModules.Connect(char.DescendantRemoving, function(part)
            if part == cachedHRP then cachedHRP = nil; cachedVelocityHRP = nil end
            if part == cachedHumanoid then cachedHumanoid = nil; cachedVelocityHum = nil end
            local index = table.find(phaseParts, part)
            if index then table.remove(phaseParts, index) end
        end)
    end
    FWNoModules.Connect(Player.CharacterAdded, bindCharacterCache)
    FWNoModules.Connect(Player.CharacterRemoving, function(char)
        if boundCharacter == char then clearCharacterCache() end
    end)
