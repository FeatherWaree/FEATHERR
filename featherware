		cryptData.AnimationType = require(ReplicatedStorage:WaitForChild("TS", 5):WaitForChild("animation", 5):WaitForChild("animation-type", 5)).AnimationType

		local knit = require(ReplicatedStorage:WaitForChild("rbxts_include", 5):WaitForChild("node_modules", 5):WaitForChild("@easy-games", 5):WaitForChild("knit", 5):WaitForChild("src", 5))
		cryptData.KnitClient = knit.KnitClient
		cryptData.animsLoaded = true
	end)

	return success and cryptData.animsLoaded
