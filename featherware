	function mod:CreateSlider(sName, min, max, default, sCallback, sStep)
		sStep = (type(sStep) == "number") and sStep or 0.01
		local settingID = uniquePrefix .. "_" .. sName

		local decimals = 0
		local stepStr = tostring(sStep)
		if stepStr:find("%.") then decimals = #stepStr - stepStr:find("%.") end
		local formatStr = "%." .. decimals .. "f"

		local function cleanVal(val)
			if type(val) ~= "number" then val = tonumber(val) or min end
			val = math.clamp(val, min, max)
			local snapped = math.floor((val - min) / sStep + 0.5) * sStep + min
			return tonumber(string.format(formatStr, snapped))
		end

		-- SAFETY: Ensure saved config is actually a number, otherwise reset it
		if _G.SavedConfig[settingID] ~= nil then
			if type(_G.SavedConfig[settingID]) ~= "number" then
				_G.SavedConfig[settingID] = nil -- Corrupted save, wipe it
			else
				default = cleanVal(_G.SavedConfig[settingID])
			end
		end

		if _G.SavedConfig[settingID] == nil then
			default = cleanVal(default)
			_G.SavedConfig[settingID] = default
		end

		-- SAFETY: Ensure sCallback is strictly a function
		if type(sCallback) ~= "function" then sCallback = nil end

		local sFrame = Instance.new("Frame", settingsCont)
		sFrame.Size = UDim2.new(1, 0, 0, 38)
		sFrame.BackgroundTransparency = 1

		local sliderElement = {}

