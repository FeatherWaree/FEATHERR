sheep_busy = false
function sheepAutoLoop()
	if not loops["auto sheep"] then return end
	if not AutoSheep.Values["Auto Tame"] then return end
	if sheep_busy then return end
	if os.clock() - sheep_last_tame < 0.6 then return end

	sheep_range = AutoSheep.Values["Tame Range"] or 10
	sheep_model, sheep_data = sheepFindNearestIdle(sheep_range)
	if not sheep_model or not sheep_data then return end

	sheep_busy = true
	sheep_mygen = sheep_gen

	task.spawn(function()
		task.wait(AutoSheep.Values["Tame Delay"] or 0.5)
		if sheep_mygen ~= sheep_gen or not loops["auto sheep"] then sheep_busy = false return end

		sheep_hrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
		if not sheep_hrp or not sheep_model.Parent then sheep_busy = false return end
		sheep_pos = sheepGetPos(sheep_model)
		if not sheep_pos or (sheep_pos - sheep_hrp.Position).Magnitude > (AutoSheep.Values["Tame Range"] or 10) then sheep_busy = false return end

		sheep_data2 = sheepGetData(sheep_model)
		if sheep_data2 and sheepIsIdle(sheep_data2) then
			if AutoSheep.Values["Play Tame Animation"] then sheepPlayTameAnim(); task.wait(0.3) end
			if AutoSheep.Values["Play Tame Sound"] then sheepPlayTameSound() end
			sheepFireTame(sheep_data2)
			sheep_last_tame = os.clock()
		end

		sheep_busy = false
	end)
end

AutoSheep.Callbacks.OnToggle = function(state)
	loops["auto sheep"] = state
	if state then
		sheep_last_tame = 0
		sheep_busy = false
		if not sheep_autoConn then sheep_autoConn = G.Services.RunService.Heartbeat:Connect(sheepAutoLoop) end
	else
		if sheep_autoConn then sheep_autoConn:Disconnect(); sheep_autoConn = nil end
	end
end

