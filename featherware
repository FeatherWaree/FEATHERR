local function manualEquipAccessory(char, accessory)
	local handle = accessory:FindFirstChild("Handle")
	if not handle then return end

	-- 1. Strip all physics restrictions and broken welds
	handle.Anchored = false
	handle.CanCollide = false
	for _, v in ipairs(handle:GetChildren()) do
		if v:IsA("Weld") or v:IsA("JointInstance") then
			v:Destroy()
		end
	end

	-- 2. Find how this accessory is supposed to attach
	local accAttachment = handle:FindFirstChildOfClass("Attachment")
	if not accAttachment then 
		accessory.Parent = char
		return 
	end

	-- 3. Find the matching attachment point on the character's body
	local targetPart, targetAttachment
	for _, part in ipairs(char:GetChildren()) do
		if part:IsA("BasePart") then
			local foundAtt = part:FindFirstChild(accAttachment.Name)
			if foundAtt and foundAtt:IsA("Attachment") then
				targetPart = part
				targetAttachment = foundAtt
				break
			end
		end
	end

	-- 4. Manually force the weld if we found the attachment point
	if targetPart and targetAttachment then
		accessory.Parent = char

		-- Create a perfect weld mathematically bypassing the engine's broken logic
		local weld = Instance.new("Weld")
		weld.Name = "AccessoryWeld"
		weld.Part0 = handle
		weld.Part1 = targetPart
		weld.C0 = accAttachment.CFrame
		weld.C1 = targetAttachment.CFrame
		weld.Parent = handle
	else
		accessory.Parent = char
	end
end

local function applyLocalAvatar(username)
	local success, userId = pcall(function()
		return Players:GetUserIdFromNameAsync(username)
	end)

	if not success or not userId then 
		warn("[Fake Stats] Invalid username")
		return 
	end

	local char = Player.Character
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	if not char or not humanoid then return end

	-- 1. Save original appearance
	if not isAvatarSpoofed then
		originalAppearance = {}

		for _, child in ipairs(char:GetChildren()) do
			if child:IsA("Accessory") or child:IsA("Shirt") or child:IsA("Pants") or child:IsA("ShirtGraphic") or child:IsA("CharacterMesh") or child:IsA("BodyColors") then
				table.insert(originalAppearance, child:Clone())
			end
		end

		local head = char:FindFirstChild("Head")
		if head then
			for _, child in ipairs(head:GetChildren()) do
				if child:IsA("Decal") or child:IsA("SpecialMesh") then
					table.insert(originalAppearance, child:Clone())
				end
			end
		end

		isAvatarSpoofed = true
	end

	-- 2. Clear current appearance
	for _, child in ipairs(char:GetChildren()) do
		if child:IsA("Accessory") or child:IsA("Shirt") or child:IsA("Pants") or child:IsA("ShirtGraphic") or child:IsA("CharacterMesh") or child:IsA("BodyColors") then
			child:Destroy()
		end
	end

	local head = char:FindFirstChild("Head")
	if head then
		for _, child in ipairs(head:GetChildren()) do
			if child:IsA("Decal") or child:IsA("SpecialMesh") then
				child:Destroy()
			end
		end
	end

	-- 3. Load target appearance locally
	local successModel, targetModel = pcall(function()
		return Players:CreateHumanoidModelFromUserId(userId, humanoid.RigType)
	end)

	if successModel and targetModel then
		for _, child in ipairs(targetModel:GetChildren()) do
			if child:IsA("Accessory") then
				-- Use our new custom manual welder
				manualEquipAccessory(char, child:Clone())
			elseif child:IsA("Shirt") or child:IsA("Pants") or child:IsA("ShirtGraphic") or child:IsA("CharacterMesh") or child:IsA("BodyColors") then
				child:Clone().Parent = char
			end
		end

		local targetHead = targetModel:FindFirstChild("Head")
		if targetHead and head then
			for _, child in ipairs(targetHead:GetChildren()) do
				if child:IsA("Decal") or child:IsA("SpecialMesh") then
					child:Clone().Parent = head
				end
			end
		end

		targetModel:Destroy()
	else
		warn("[Fake Stats] Failed to load target character model.")
	end
end

local function revertLocalAvatar()
	if not isAvatarSpoofed then return end
	local char = Player.Character
	if not char then return end
	local head = char:FindFirstChild("Head")

	-- 1. Clear spoofed
	for _, child in ipairs(char:GetChildren()) do
		if child:IsA("Accessory") or child:IsA("Shirt") or child:IsA("Pants") or child:IsA("ShirtGraphic") or child:IsA("CharacterMesh") or child:IsA("BodyColors") then
			child:Destroy()
		end
	end

	if head then
		for _, child in ipairs(head:GetChildren()) do
			if child:IsA("Decal") or child:IsA("SpecialMesh") then
				child:Destroy()
			end
		end
	end

	-- 2. Restore original
	for _, item in ipairs(originalAppearance) do
		local clone = item:Clone()

		if clone:IsA("Accessory") then
			-- Weld the originals back perfectly as well
			manualEquipAccessory(char, clone)
		elseif clone:IsA("Decal") or clone:IsA("SpecialMesh") then
			if head then
				clone.Parent = head
			end
		else
			clone.Parent = char
		end
	end

	isAvatarSpoofed = false
	originalAppearance = {}
end
