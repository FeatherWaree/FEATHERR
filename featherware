	mapFolder = G.Services.Workspace:FindFirstChild("Map")
	if not mapFolder then return nil end
	worldsFolder = mapFolder:FindFirstChild("Worlds")
	if not worldsFolder then return nil end
	trRange = worldsFolder:FindFirstChild("tr_Range")
	if not trRange then return nil end
