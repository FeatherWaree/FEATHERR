function amResetDizzy()
	if not AutoMushRoom.Values["Bypass Dizzy Effect"] then return end
	char = Player.Character
	if not char then return end

	-- Force reset dizzy attribute
	currentDizzy = char:GetAttribute("StatusEffect_dizzy")
	if typeof(currentDizzy) == "number" and currentDizzy > 0 then
		char:SetAttribute("StatusEffect_dizzy", 0)
	end
end

function amLoop()
	now = tick()
	if now - amLastCheck < 0.2 then return end -- 0.2s interval
	amLastCheck = now

	if not loops["auto mushroom"] then return end
	if not amCollectRemote then return end

	char = Player.Character
	if not char then return end
	hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	range = tonumber(AutoMushRoom.Values["Range"]) or 5

	-- Scan for SingleMushroom models in Workspace
	for _, obj in ipairs(G.Services.Workspace:GetChildren()) do
		if obj:IsA("Model") and obj.Name == "SingleMushroom" then
			primPart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
			if primPart then
				dist = (hrp.Position - primPart.Position).Magnitude
				if dist <= range then
					mushId = obj:GetAttribute("Id") or obj:GetAttribute("id")
					if mushId then
						-- Fire the collect remote
						pcall(function()
							amCollectRemote:FireServer({
								id = mushId,
								collectableName = "SingleMushroom"
							})
						end)

						-- CRITICAL FIX: Reset Dizzy immediately after collect if enabled
						amResetDizzy()
					end
				end
			end
		end
	end
end

AutoMushRoom.Callbacks.OnToggle = function(state)
	loops["auto mushroom"] = state

	if state then
		-- Start the collection loop
		if not amConn then
			amConn = FWNoModules.TrackFrameConnection(G.Services.RunService.Heartbeat:Connect(amLoop))
		end

		-- Setup Dizzy Bypass Listener
		if AutoMushRoom.Values["Bypass Dizzy Effect"] then
			char = Player.Character
			if char then
				if amDizzyConn then amDizzyConn:Disconnect() end
				amDizzyConn = FWNoModules.Connect(char:GetAttributeChangedSignal("StatusEffect_dizzy"), amResetDizzy)
				amResetDizzy() -- Check immediately
			end
		end

		-- Re-connect dizzy bypass on respawn
		FWNoModules.Connect(Player.CharacterAdded, function(newChar)
			if not loops["auto mushroom"] then return end
			if AutoMushRoom.Values["Bypass Dizzy Effect"] then
				if amDizzyConn then amDizzyConn:Disconnect() end
				task.wait(0.5) -- Wait for character to load
				if newChar and loops["auto mushroom"] then
					amDizzyConn = FWNoModules.Connect(newChar:GetAttributeChangedSignal("StatusEffect_dizzy"), amResetDizzy)
				end
			end
		end)
	else
		-- Disconnect everything
		if amConn then amConn:Disconnect(); amConn = nil end
		if amDizzyConn then amDizzyConn:Disconnect(); amDizzyConn = nil end
	end
end

