    uiCorner(searchBox, 6)
    local searchPadding = FWNoModules.OwnInstance(Instance.new("UIPadding", searchBox))
    searchPadding.PaddingLeft = UDim.new(0, 8)
    searchPadding.PaddingRight = UDim.new(0, 30)
    closeSearch.Parent = searchBox
    closeSearch.Name = "ClearSearch"
    closeSearch.Size = UDim2.new(0, 24, 1, 0)
    closeSearch.Position = UDim2.new(1, -26, 0, 0)
    closeSearch.ZIndex = searchBox.ZIndex + 1
    mainScroll.Position = UDim2.new(0, 0, 0, 80)
    mainScroll.Size = UDim2.new(1, 0, 1, -85)
    mainScroll.CanvasSize = UDim2.new()
    function addons.Query() return searchBox.Text:match("^%s*(.-)%s*$") end
    local function updateSearchVisibility()
        local searching = addons.Query() ~= ""
        searchBox.Visible = not overlayFrame.Visible
        closeSearch.Visible = searching
        searchPanel.Visible = searching and not overlayFrame.Visible
        mainScroll.Visible = not overlayFrame.Visible
    end
    connect(overlayFrame:GetPropertyChangedSignal("Visible"), updateSearchVisibility)
    addons.SearchBox = searchBox
    addons.SearchPanel = searchPanel
    addons.ResultScroll = resultScroll

    local function settingNames(entry)
        local parts = {entry.Name, entry.CategoryName}
        for _, child in ipairs(entry.Settings:GetChildren()) do
            local label = child:GetAttribute("FWSettingName")
            if label then table.insert(parts, label) end
        end
        return table.concat(parts, " ")
    end

    function addons.RefreshEntry(entry)
        local active = entry.Mod and entry.Mod.Toggled
        local colour = active and Color3.fromRGB(78, 173, 73) or Color3.new(1, 1, 1)
        if entry.Star then
            entry.Star.Text = favourites[entry.ID] and "★" or "☆"
            entry.Star.TextColor3 = favourites[entry.ID] and Color3.fromRGB(255, 204, 80) or Color3.fromRGB(160, 160, 160)
        end
        for _, proxy in ipairs(entry.Proxies or {}) do
            proxy.Label.TextColor3 = colour
            if proxy.Star then
                proxy.Star.Text = favourites[entry.ID] and "★" or "☆"
                proxy.Star.TextColor3 = favourites[entry.ID] and Color3.fromRGB(255, 204, 80) or Color3.fromRGB(160, 160, 160)
            end
        end
    end

    function addons.ReturnSettings(entry)
        entry.Settings.Parent = entry.Home
        entry.Settings.Visible = false
        if entry.Arrow then entry.Arrow.Rotation = 0 end
        for _, proxy in ipairs(entry.Proxies or {}) do proxy.Arrow.Rotation = 0 end
    end

    local function jumpToSetting(entry, query, scroll)
        local target
        for _, child in ipairs(entry.Settings:GetChildren()) do
            local name = child:GetAttribute("FWSettingName")
            if name and child.Visible and matches(name, query) then target = child break end
        end
        if not target then return end
        local highlight = FWNoModules.OwnInstance(Instance.new("UIStroke", target))
        highlight.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        highlight.Color = Color3.fromRGB(255, 204, 80)
        highlight.Thickness = 2
        task.delay(2, function() highlight:Destroy() end)
        task.defer(function()
            if dead or not target.Parent or not scroll.Parent then return end
            local offset = target.AbsolutePosition.Y - scroll.AbsolutePosition.Y + scroll.CanvasPosition.Y
            local maxY = math.max(0, scroll.AbsoluteCanvasSize.Y - scroll.AbsoluteWindowSize.Y)
            scroll.CanvasPosition = Vector2.new(0, math.clamp(offset - 5, 0, maxY))
        end)
    end

    function addons.OpenSettings(entry, host, arrow, scroll, query)
        if entry.ImportedModule and FWNoModules.FeaturePort then FWNoModules.FeaturePort.Start()end
        if entry.Open then entry.Open(query) return end
        if #entry.Settings:GetChildren() <= 1 then
            local expected=entry.ExpectedSettings or 0
            local message=expected>0 and "These settings are still loading. Check the game dependency status in the console."or "No settings are available for this button."
            pcall(NotificationSystem.Notify, "Settings", message, 3)
            return
        end
        if entry.Settings.Parent == host and entry.Settings.Visible then
            addons.ReturnSettings(entry)
            return
        end
        addons.ReturnSettings(entry)
        entry.Settings.Parent = host
        entry.Settings.Visible = true
        arrow.Rotation = 90
        if query and query ~= "" then jumpToSetting(entry, query, scroll) end
    end

    function addons.ToggleFavourite(entry)
        favourites[entry.ID] = not favourites[entry.ID] or nil
        if not favourites[entry.ID] and entry.FavouriteProxy then
            if entry.Settings.Parent == entry.FavouriteProxy.Frame then addons.ReturnSettings(entry) end
        end
        save()
        addons.RefreshEntry(entry)
        addons.QueueRefresh()
    end

    -- Reuse the actual category button tree so spacing, fonts and controls match.
    function addons.MakeModuleProxy(entry, parent, favourite)
        local row = FWNoModules.OwnInstance(Instance.new("Frame", parent))
        row.Name = "Shortcut_" .. entry.ID
        row.Size = entry.Home.Size
        row.AutomaticSize = Enum.AutomaticSize.Y
        row.BackgroundTransparency = 1
        local layout = FWNoModules.OwnInstance(Instance.new("UIListLayout", row))
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        local head = FWNoModules.OwnInstance(entry.Button:Clone())
        head:SetAttribute("FW_TooltipAttached",nil)
        head.Parent = row
        FWNoModules.RegisterTooltip(entry,head)
        head.BackgroundTransparency = 1
        local oldHandle = head:FindFirstChild("ReorderHandle")
        if oldHandle then
            if favourite then oldHandle:Destroy() else oldHandle.Active = false end
        end
        local content = head:FindFirstChild("ButtonContent")
        local nameScroll = content:FindFirstChild("ButtonNameScroll")
        nameScroll.CanvasPosition = Vector2.zero
        local label = nameScroll:FindFirstChild("ButtonName")
        local arrow = head:FindFirstChild("SettingsArrow")
        local star = head:FindFirstChild("FavouriteStar")
        local bindLabel = head:FindFirstChild("Hotkey")
        local closet = content:FindFirstChild("ClosetBtn")
        local proxy = {Frame = row, Label = label, Arrow = arrow, Star = star}
        table.insert(entry.Proxies, proxy)
        connect(head.Activated, FWNoModules.Mobile.Activation(function() entry.Activate() end))
        connect(arrow.Activated, FWNoModules.Mobile.Activation(function()
            addons.OpenSettings(entry, row, arrow, favourite and parent or mainScroll, favourite and "" or addons.Query())
        end))
        connect(star.Activated, FWNoModules.Mobile.Activation(function() addons.ToggleFavourite(entry) end))
        if bindLabel and entry.Mod.MenuHotkeyInput then
            connect(bindLabel.InputBegan, entry.Mod.MenuHotkeyInput)
            connect(entry.Mod.MenuBindLabel:GetPropertyChangedSignal("Text"), function()
                bindLabel.Text = entry.Mod.MenuBindLabel.Text
            end)
        end
        if closet and entry.Mod.ApplyCloset then connect(closet.Activated, FWNoModules.Mobile.Activation(entry.Mod.ApplyCloset)) end
        local function updateLayout()
            local width = content.AbsoluteSize.X
            if closet then width -= closet.AbsoluteSize.X + 8 end
            local textWidth = label.TextBounds.X
            nameScroll.Size = UDim2.new(0, math.min(textWidth, math.max(0, width)), 1, 0)
            nameScroll.CanvasSize = UDim2.new(0, textWidth, 0, 0)
        end
        connect(label:GetPropertyChangedSignal("TextBounds"), updateLayout)
        connect(content:GetPropertyChangedSignal("AbsoluteSize"), updateLayout)
        task.defer(function() if not dead and row.Parent then updateLayout() end end)
        connect(head.MouseEnter, function()
            tween(head, {BackgroundTransparency = 0})
            local distance = math.max(0, nameScroll.CanvasSize.X.Offset - nameScroll.AbsoluteSize.X)
            if distance > 0 then tween(nameScroll, {CanvasPosition = Vector2.new(distance + 10, 0)}, 2) end
        end)
        connect(head.MouseLeave, function()
            tween(head, {BackgroundTransparency = 1})
            tween(nameScroll, {CanvasPosition = Vector2.zero}, 0.2)
        end)
        if favourite then
            local group = addons.FavouriteGroup
            local orderRow = {Frame = row, ID = entry.ID, Sequence = #group.Rows + 1}
            table.insert(group.Rows, orderRow)
            addons.DragHandle(head, orderRow, group, true)
            addons.Order(group)
        end
        addons.RefreshEntry(entry)
        return proxy
    end

    function addons.MakeFavouriteProxy(entry, parent)
        return addons.MakeModuleProxy(entry, parent, true)
    end

    function addons.Proxy(entry, parent, favourite)
        if entry.Button and entry.Button:FindFirstChild("ButtonContent") then
            return addons.MakeModuleProxy(entry, parent, favourite)
        end
        local row = FWNoModules.OwnInstance(Instance.new("Frame", parent))
        row.Name = "Shortcut_" .. entry.ID
        row.Size = UDim2.new(1, 0, 0, 32)
        row.AutomaticSize = Enum.AutomaticSize.Y
        row.BackgroundTransparency = 1
        local layout = FWNoModules.OwnInstance(Instance.new("UIListLayout", row))
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        local head = FWNoModules.OwnInstance(Instance.new("TextButton", row))
        head.Size = UDim2.new(1, 0, 0, 32)
        head.Text = ""
        head.BackgroundColor3 = Color3.fromRGB(39, 39, 39)
        head.BackgroundTransparency = 1
        head.BorderSizePixel = 0
        head.LayoutOrder = 1
        local label = FWNoModules.OwnInstance(Instance.new("TextLabel", head))
        label.Position = UDim2.new(0, 24, 0, 0)
        label.Size = UDim2.new(1, -85, 1, 0)
        label.Text = entry.Name
        label.TextColor3 = Color3.new(1, 1, 1)
        label.FontFace = Font.fromName(textFont)
        label.TextSize = 22
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.TextTruncate = Enum.TextTruncate.AtEnd
        label.BackgroundTransparency = 1
        connect(head.MouseEnter, function() tween(head, {BackgroundTransparency = 0}) end)
        connect(head.MouseLeave, function() tween(head, {BackgroundTransparency = 1}) end)
        local arrow = button(head, ">", 30, 30)
        local star
        if entry.Mod then
            star = button(head, "☆", 25, 54)
            connect(star.Activated, FWNoModules.Mobile.Activation(function() addons.ToggleFavourite(entry) end))
        end
        local proxy = {Frame = row, Label = label, Arrow = arrow, Star = star}
        table.insert(entry.Proxies, proxy)
        connect(head.Activated, FWNoModules.Mobile.Activation(function()
            if entry.Activate then entry.Activate() else entry.Open(addons.Query()) end
        end))
        connect(arrow.Activated, FWNoModules.Mobile.Activation(function()
            addons.OpenSettings(entry, row, arrow, favourite and parent or mainScroll, favourite and "" or addons.Query())
        end))
        if favourite then
            local group = addons.FavouriteGroup
            local orderRow = {Frame = row, ID = entry.ID, Sequence = #group.Rows + 1}
            table.insert(group.Rows, orderRow)
            addons.DragHandle(head, orderRow, group, true)
            addons.Order(group)
        end
        addons.RefreshEntry(entry)
        return proxy
    end

    function addons.Refresh()
        if dead then return end
        local query = addons.Query()
        local count, favouriteCount = 0, 0
        for index, entry in ipairs(addons.Modules) do
            if entry.Mod and favourites[entry.ID] then
                if not entry.FavouriteProxy then
                    entry.FavouriteProxy = addons.Proxy(entry, addons.FavouriteCategory.Scroll, true)
                end
                entry.FavouriteProxy.Frame.Visible = true
                favouriteCount += 1
            elseif entry.FavouriteProxy then entry.FavouriteProxy.Frame.Visible = false end
            local show = query ~= "" and matches(settingNames(entry), query)
            if show and not entry.SearchProxy then entry.SearchProxy = addons.Proxy(entry, resultScroll, false) end
            if entry.SearchProxy then
                if not show and entry.Settings.Parent == entry.SearchProxy.Frame then addons.ReturnSettings(entry) end
                entry.SearchProxy.Frame.Visible = show
                entry.SearchProxy.Frame.LayoutOrder = index

            end
            if show then count += 1 end
        end
        emptyResults.Visible = count == 0
        updateSearchVisibility()
        if addons.FavouriteEmpty then addons.FavouriteEmpty.Visible = favouriteCount == 0 end
    end

    function addons.QueueRefresh()
        if refreshQueued or dead then return end
        refreshQueued = true
        task.defer(function() refreshQueued = false; addons.Refresh() end)
    end

    connect(searchBox:GetPropertyChangedSignal("Text"), function()
        searchVersion += 1
        local version = searchVersion
        task.delay(0.12, function()
            if dead or version ~= searchVersion then return end
            updateSearchVisibility()
            mainScroll.CanvasPosition = Vector2.zero
            addons.Refresh()
        end)
    end)
    connect(searchBox.Focused, function()
        if addons.Query() ~= "" then updateSearchVisibility(); addons.QueueRefresh() end
    end)
    connect(closeSearch.Activated, FWNoModules.Mobile.Activation(function() searchBox.Text = ""; updateSearchVisibility() end))

    function addons.RegisterCategory(category, name, catButton, frame, scroll, layout)
        minWidth(frame, 240)
        scroll.CanvasSize = UDim2.new()
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        local record = {Name = name, Button = catButton, Frame = frame, Scroll = scroll}
        category.MenuRecord = record
        addons.Categories[name] = record
        local row = {Frame = catButton, ID = name, Sequence = #categoryGroup.Rows + 1}
        table.insert(categoryGroup.Rows, row)
        addons.Order(categoryGroup)
        addons.DragHandle(catButton, row, categoryGroup, false)
        record.Group = {Key = "Buttons_" .. name, Rows = {}, Scroll = scroll}
        if name == "Favourites" then
            addons.FavouriteCategory = record
            addons.FavouriteGroup = record.Group
            local empty = FWNoModules.OwnInstance(Instance.new("TextLabel", scroll))
            empty.Size = UDim2.new(1, -12, 0, 72)
            empty.Text = "Click ☆ beside a button\nto add it here.\nDrag ≡ to change the order."
            empty.TextColor3 = Color3.fromRGB(170, 170, 170)
            empty.TextSize = 16
            empty.TextWrapped = true
            empty.BackgroundTransparency = 1
            empty.LayoutOrder = 100000
            addons.FavouriteEmpty = empty
        end
        connect(frame:GetPropertyChangedSignal("Visible"), function()
            if frame.Visible then
                topZIndex = topZIndex + 1
                frame.ZIndex = topZIndex
            else
                if activeDrag and activeDrag.Group == record.Group then stopDrag(true) end
                if name == "Favourites" then
                    for _, entry in ipairs(addons.Modules) do
                        if entry.FavouriteProxy and entry.Settings.Parent == entry.FavouriteProxy.Frame then
                            addons.ReturnSettings(entry)
                        end
                    end
                end
            end
        end)
    end

    function addons.RegisterModule(category, name, mod, container, btn, settings, arrow, label, activate)
        local record = category.MenuRecord
        local entry = {
            ID = record.Name .. "/" .. name, Name = name, CategoryName = record.Name,
            Mod = mod, Home = container, Button = btn, Settings = settings, Arrow = arrow,
            Proxies = {}, Activate = activate,
        }
        table.insert(addons.Modules, entry)
        mod.MenuEntry = entry
        FWNoModules.RegisterTooltip(entry,btn)
        local star = button(btn, "☆", 34, 154)
        star.Name = "FavouriteStar"
        entry.Star = star
        connect(star.Activated, FWNoModules.Mobile.Activation(function() addons.ToggleFavourite(entry) end))
        local row = {Frame = container, ID = entry.ID, Sequence = #record.Group.Rows + 1}
        table.insert(record.Group.Rows, row)
        addons.Order(record.Group)
        addons.DragHandle(btn, row, record.Group, true)
        connect(label:GetPropertyChangedSignal("TextColor3"), function() addons.RefreshEntry(entry) end)
        connect(settings.ChildAdded, addons.QueueRefresh)
        addons.RefreshEntry(entry)
        addons.QueueRefresh()
        return entry
    end

    -- The main settings overlay is indexed alongside individual module settings.
    local coreEntry = {ID = "Menu/Settings", Name = "Menu Settings", CategoryName = "Settings", Settings = overlayScroll, Proxies = {}}
    coreEntry.Open = function(query)
        overlayFrame.Visible = true
        mainScroll.Visible = false
        jumpToSetting(coreEntry, query or "", overlayScroll)
    end
    table.insert(addons.Modules, coreEntry)
    connect(overlayScroll.ChildAdded, addons.QueueRefresh)
    connect(mainScreenUI.Destroying, function()
        stopDrag(false)
        dead = true
        for _, connection in ipairs(addons.Connections) do connection:Disconnect() end
        table.clear(addons.Connections)
    end)
end


