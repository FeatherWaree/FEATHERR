function sheepGetData(model)
	if not model then return nil end
	sheep_dv = model:FindFirstChild("SheepData")
	if sheep_dv and sheep_dv:IsA("ObjectValue") then return sheep_dv.Value end
	return nil
end

function sheepIsIdle(data)
	if not data then return false end
	sheep_st = data:GetAttribute("SheepState")
	if sheep_stateEnum then return sheep_st == sheep_stateEnum.IDLE end
	return sheep_st == 0 or sheep_st == "IDLE"
end

function sheepIsTamed(data)
	if not data then return false end
	sheep_st = data:GetAttribute("SheepState")
	if sheep_stateEnum then return sheep_st == sheep_stateEnum.TAMED end
	return sheep_st == 1 or sheep_st == "TAMED"
end

function sheepIsMine(data)
	if not data then return false end
	return data:GetAttribute("SheepOwnerUserId") == Player.UserId
end

function sheepGetPos(model)
	if model:IsA("BasePart") then return model.Position end
	if model:IsA("Model") then
		sheep_pp = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
		if sheep_pp then return sheep_pp.Position end
		pcall(function() return model:GetPivot().Position end)
	end
	return nil
end

function sheepColorParts(model, col, transp)
	sheep_orig = {}
	for _, sp in ipairs(model:GetDescendants()) do
		if sp:IsA("BasePart") then
			table.insert(sheep_orig, {part = sp, color = sp.Color, transp = sp.Transparency, mat = sp.Material})
			sp.Color = col
			sp.Transparency = transp
			sp.Material = Enum.Material.Neon
		end
	end
	return sheep_orig
end

function sheepRestoreParts(orig)
	if not orig then return end
	for _, op in ipairs(orig) do
		pcall(function()
			op.part.Color = op.color
			op.part.Transparency = op.transp
			op.part.Material = op.mat
		end)
	end
end

function sheepUpdatePartColors(orig, col, transp)
	if not orig then return end
	for _, op in ipairs(orig) do
		pcall(function()
			op.part.Color = col
			op.part.Transparency = transp
			op.part.Material = Enum.Material.Neon
		end)
	end
end

function sheepCleanupEntry(model)
	sheep_d = sheep_esp_data[model]
	if not sheep_d then return end
	if sheep_d.origParts then sheepRestoreParts(sheep_d.origParts) end
	if sheep_d.bb then pcall(function() sheep_d.bb:Destroy() end) end
	if sheep_d.glow then pcall(function() sheep_d.glow:Destroy() end) end
	sheep_esp_data[model] = nil
end

