Run(function()
	local Interface
	local HealthFont
	local HealthColor
	local HotbarColor
	local HotbarOpenInventory = canDebug and require(LocalPlayer.PlayerScripts.TS.controllers.global.hotbar.ui["hotbar-open-inventory"]).HotbarOpenInventory
	local HotbarHealthbar = canDebug and require(LocalPlayer.PlayerScripts.TS.controllers.global.hotbar.ui.healthbar["hotbar-healthbar"]).HotbarHealthbar
	local HotbarApp = canDebug and GetRoactRender(require(LocalPlayer.PlayerScripts.TS.controllers.global.hotbar.ui["hotbar-app"]).HotbarApp.render)
	local OldConstants, NewConstants = {}, {}
	local Indices: {[any]: {[string]: number}} = {}
	local FontTemplate: {[string]: any}?
	local OriginalFont: string?
	local GuiOverrides = CreateGuiOverrides()
	
	local function Added(Object: Instance)
	    if not Interface.Enabled or not Object:IsA("GuiObject") or not Object:FindFirstAncestor("hotbar") then
	        return
	    end
	
	    if Object:IsA("TextLabel") and Object.Parent.Name == "HotbarHealthbarContainer" then
	        GuiOverrides.Apply(Object, {FontFace = Font.fromEnum(Enum.Font[HealthFont.Value])})
	    elseif Object.Name == "1" and Object.Parent.Name == "HealthbarProgressWrapper" then
	        GuiOverrides.Apply(Object, {BackgroundColor3 = Color3.fromHSV(HealthColor.Hue, HealthColor.Sat, HealthColor.Value)})
	    elseif Object:FindFirstAncestor("ItemsHotbar") then
	        local MainColor: Color3 = Color3.fromHSV(HotbarColor.Hue, HotbarColor.Sat, HotbarColor.Value)
	        local BorderColor: Color3 = Color3.fromHSV(HotbarColor.Hue, HotbarColor.Sat, math.clamp(HotbarColor.Value > 0.5 and HotbarColor.Value - 0.2 or HotbarColor.Value + 0.2, 0, 1))
	        if Object:IsA("ImageButton") then
	            GuiOverrides.Apply(Object, {BackgroundColor3 = MainColor, BorderColor3 = BorderColor, BackgroundTransparency = math.clamp(1.2 - HotbarColor.Opacity, 0, 1)})
	        elseif Object:IsA("Frame") and Object.Parent:IsA("ImageButton") and Object.BackgroundTransparency < 1 then
	            GuiOverrides.Apply(Object, {BackgroundColor3 = BorderColor, BackgroundTransparency = 1 - HotbarColor.Opacity})
	        end
	    end
	end
	
	local function Refresh()
	    GuiOverrides.Restore()
	    if Interface.Enabled then
	        for _, v: Instance in LocalPlayer.PlayerGui:GetDescendants() do
	            Added(v)
	        end
	    end
	end
	
	vape:Clean(function()
	    for _, v: {[number]: any} in NewConstants do
	        table.clear(v)
	    end
	    for _, v: {[number]: any} in OldConstants do
	        table.clear(v)
	    end
	    table.clear(NewConstants)
	    table.clear(OldConstants)
	    table.clear(Indices)
	    FontTemplate = nil
	    OriginalFont = nil
	end)
	
	local function FindComponent(Name: string)
	    if not HotbarApp then
	        return nil
	    end
	    for Index: number = 1, 64 do
	        local Success, Value = pcall(debug.getupvalue, HotbarApp, Index)
	        if not Success then
	            break
	        end
	        if type(Value) == "table" and rawget(Value, "__componentName") == Name then
	            return Value
	        end
	    end
	    return nil
	end
	
	local function Resolve(Function, Key: string, Value: any, After: any?): number?
	    if typeof(Function) ~= "function" then
	        return nil
	    end
	    local Known: {[string]: number}? = Indices[Function]
	    if Known and Known[Key] then
	        return Known[Key]
	    end
	    local Index: number? = getgenv().findConstant(Function, Value, After)
	    if Index then
	        Indices[Function] = Known or {}
	        Indices[Function][Key] = Index
	    end
	    return Index
	end
	
	local function ApplyFont(Enabled: boolean)
	    if not FontTemplate and HotbarHealthbar then
	        for _, v: any in debug.getconstants(HotbarHealthbar.render) do
	            if type(v) == "table" and type(rawget(v, "Font")) == "string" then
	                FontTemplate = v
	                OriginalFont = v.Font
	                break
	            end
	        end
	    end
	    if FontTemplate then
	        FontTemplate.Font = Enabled and HealthFont.Value or OriginalFont
	    end
	end
	
	local function ModifyConstant(Function, Index: number?, Value)
	    if not Function or not Index then
	        return
	    end
	    if not OldConstants[Function] then
	        OldConstants[Function] = {}
	    end
	    if not NewConstants[Function] then
	        NewConstants[Function] = {}
	    end
	    if not OldConstants[Function][Index] then
	        OldConstants[Function][Index] = debug.getconstant(Function, Index)
	    end
	    if typeof(OldConstants[Function][Index]) ~= typeof(Value) then
	        return
	    end
	    NewConstants[Function][Index] = Value
	
	    if Interface.Enabled then
	        if Value then
	            debug.setconstant(Function, Index, Value)
	        else
	            debug.setconstant(Function, Index, OldConstants[Function][Index])
	            OldConstants[Function][Index] = nil
	        end
	    end
	end
	
	Interface = vape.Legit:CreateModule({
	    Name = "Interface",
	    Category = "Game",
	    Icon = GetVapeAsset(`{vape.Directory}/assets/new/legit_interface.png`),
	    Function = function(Callback: boolean)
	        if not canDebug then
	            if Callback then
	                Interface:Clean(GuiOverrides.Restore)
	                Interface:Clean(LocalPlayer.PlayerGui.DescendantAdded:Connect(Added))
	            end
	            Refresh()
	            return
	        end
	
	        for Function: (...any) -> ...any, Constants: {[number]: any} in (Callback and NewConstants or OldConstants) do
	            for i: number, Value: any in Constants do
	                debug.setconstant(Function, i, Value)
	            end
	        end
	        ApplyFont(Callback)
	    end,
	    Tooltip = "Customize bedwars UI"
	})
	
	local FontItems: {string} = {"LuckiestGuy"}
	for _, v: EnumItem in Enum.Font:GetEnumItems() do
	    if v.Name ~= "LuckiestGuy" and v ~= Enum.Font.Unknown then
	        table.insert(FontItems, v.Name)
	    end
	end
	HealthFont = Interface:CreateDropdown({
	    Name = "Health Font",
	    List = FontItems,
	    Function = function(Val: string)
	        if not canDebug then
	            Refresh()
	            return
	        end
	        if Interface.Enabled then
	            ApplyFont(true)
	        end
	    end
	})
	HealthColor = Interface:CreateColorSlider({
	    Name = "Health Color",
	    Function = function(Hue: number, Sat: number, Val: number)
	        if not canDebug then
	            Refresh()
	            return
	        end
	        ModifyConstant(HotbarHealthbar.render, Resolve(HotbarHealthbar.render, "Color", 13317668), tonumber(Color3.fromHSV(Hue, Sat, Val):ToHex(), 16))
	        if Interface.Enabled then
	            local Hotbar = LocalPlayer.PlayerGui:FindFirstChild("hotbar")
	            Hotbar = Hotbar and Hotbar:FindFirstChild("HealthbarProgressWrapper", true)
	            if Hotbar then
	                Hotbar["1"].BackgroundColor3 = Color3.fromHSV(Hue, Sat, Val)
	            end
	        end
	    end
	})
	HotbarColor = Interface:CreateColorSlider({
	    Name = "Hotbar Color",
	    DefaultOpacity = 0.8,
	    Function = function(Hue: number, Sat: number, Val: number, Opacity: number)
	        if not canDebug then
	            Refresh()
	            return
	        end
	        local InventoryRender = OldInventoryRender or HotbarOpenInventory.render
	        local Tile = FindComponent("HotbarTile")
	        local AppRender = Tile and Tile.render
	        local MainColor: number = tonumber(Color3.fromHSV(Hue, Sat, Val):ToHex(), 16)
	        local BorderColor: number = tonumber(Color3.fromHSV(Hue, Sat, math.clamp(Val > 0.5 and Val - 0.2 or Val + 0.2, 0, 1)):ToHex(), 16)
	        local Fill: number = 1 - Opacity
	        local Hover: number = math.clamp(1.2 - Opacity, 0, 1)
	
	        local AppMain, AppBorder, AppFill, AppHover
	        if AppRender then
	            AppMain = Resolve(AppRender, "Main", 1909806)
	            AppBorder = Resolve(AppRender, "Border", 7503788)
	            AppFill = Resolve(AppRender, "Fill", 0.2, 1909806)
