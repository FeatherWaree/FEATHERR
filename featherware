SOUND_INTERVAL = 0.23 -- Exact interval from consume-controller

healLoadRemotes = function()
	if healData.consumeRemote and healData.setInvRemote then return true end
	pcall(function()
		netManaged = ReplicatedStorage:WaitForChild("rbxts_include", 5):WaitForChild("node_modules", 5):WaitForChild("@rbxts", 5):WaitForChild("net", 5):WaitForChild("out", 5):WaitForChild("_NetManaged", 5)
		healData.consumeRemote = netManaged:WaitForChild("ConsumeItem", 5)
