end

function aadPlanLegit()
	aapl_hV = Vector3.new(aad.threatV.X, 0, aad.threatV.Z)
	if aapl_hV.Magnitude < 0.01 then aapl_hV = Vector3.new(G.Services.Workspace.CurrentCamera.CFrame.RightVector.X, 0, G.Services.Workspace.CurrentCamera.CFrame.RightVector.Z) end
	aapl_perp = Vector3.new(-aapl_hV.Z, 0, aapl_hV.X).Unit
	aapl_dirL = aapl_perp; aapl_dirR = -aapl_perp
	aapl_ttc = aad.threatTtc
	aapl_grounded = aad_hum.FloorMaterial ~= Enum.Material.Air
	aad.actJumped = false
	aad.actJumpStrafe = false
	aad.actStart = aad_hrp.Position
	aad.actNeed = AAD_LEG_NEED
	aad.actDir = aapl_dirL

	if not aapl_grounded then
		aad.actKind = "air"; aad.actDur = AAD_LEG_HOP_DUR; return
	end

	aapl_probe = AAD_LEG_NEED + 1
	aapl_sL = aadSafeGround(aapl_dirL, aapl_probe); aapl_sR = aadSafeGround(aapl_dirR, aapl_probe)
	aapl_safeDir = nil
	if aapl_sL and aapl_sR then aapl_safeDir = (math.random() < 0.5) and aapl_dirL or aapl_dirR
	elseif aapl_sL then aapl_safeDir = aapl_dirL
	elseif aapl_sR then aapl_safeDir = aapl_dirR
	end

	aapl_r = math.random()
	if aapl_ttc < 0.3 then
		aapl_kind = (aapl_r < 0.7) and "hop" or "jump"
	else
		if aapl_r < 0.5 then aapl_kind = "walk" elseif aapl_r < 0.85 then aapl_kind = "hop" else aapl_kind = "jump" end
	end

	if aapl_kind == "walk" or aapl_kind == "hop" then
		if aapl_safeDir then aad.actDir = aapl_safeDir else aapl_kind = "jump" end
	end

	if aapl_kind == "jump" then
		aapl_jsL = aadSafeGround(aapl_dirL, AAD_LEG_NEED + 1); aapl_jsR = aadSafeGround(aapl_dirR, AAD_LEG_NEED + 1)
		if aapl_jsL and aapl_jsR then aad.actDir = (math.random() < 0.5) and aapl_dirL or aapl_dirR; aad.actJumpStrafe = true
		elseif aapl_jsL then aad.actDir = aapl_dirL; aad.actJumpStrafe = true
		elseif aapl_jsR then aad.actDir = aapl_dirR; aad.actJumpStrafe = true
		end
	end

	aad.actKind = aapl_kind
	aad.actDur = (aapl_kind == "walk") and AAD_LEG_WALK_DUR or (aapl_kind == "hop") and AAD_LEG_HOP_DUR or AAD_LEG_JUMP_DUR
end

function aadSetHorizBV(dir)
	aad_bv = aadEnsureBV()
	aad_bv.MaxForce = Vector3.new(1e9, 0, 1e9)
	aad_bv.Velocity = Vector3.new(dir.X * AAD_LEG_SPEED, 0, dir.Z * AAD_LEG_SPEED)
end

function aadLoop(dt)
	if not aad.on then return end
	aad_char = aadMyChar()
	aad_hrp = aad_char and aad_char:FindFirstChild("HumanoidRootPart")
	aad_hum = aad_char and aad_char:FindFirstChildOfClass("Humanoid")
	if not aad_hrp or not aad_hum or aad_hum.Health <= 0 then aadCleanupBV(); aad.state = "idle"; return end
	if loops["fly"] or loops["swim"] then aadCleanupBV(); aad.state = "idle"; return end
	if aad.state == "up" and (not aad.bv or not aad.bv.Parent) then aad.state = "idle" end

	aad_mode = AutoArrowDodge.Values["Mode"] or "Legit"
	aad.scanAcc = aad.scanAcc + (dt or 0.016)
	if aad.scanAcc >= 0.033 then aad.scanAcc = 0; aadScan() end
	aadPurge()
	aad_now = tick()
	aad_hit = aadThreat(aad_hrp.Position, aad_mode)

	if not aad.dSum and aad_now - aad.sumAt > 1.5 then
		aad.dSum = true
		print("[AAD] tracked:", #aad.list, "| mode:", aad_mode, "| threat:", aad_hit, "| net:", aad.srcNet, "sync:", aad.srcSync, "scan:", aad.dScan)
	end

	if aad_mode == "Blatant" then
		if aad.state == "idle" then
			if aad_hit and (aad_now - aad.lastDodge >= AAD_COOLDOWN or aad.threatTtc <= 0.08) then
				aad.origCF = aad_hrp.CFrame
				aad.faceRot = aad_hrp.CFrame.Rotation
				aad.ceilingY = aad.origCF.Position.Y + AAD_SKY
				aad_hrp.CFrame = CFrame.new(aad_hrp.Position.X, aad.ceilingY, aad_hrp.Position.Z) * aad.faceRot
				aad_bv = aadEnsureBV(); aad_bv.MaxForce = Vector3.new(0, 1e9, 0); aad_bv.Velocity = Vector3.zero
				aad.state = "up"; aad.upStart = aad_now
			end
		elseif aad.state == "up" then
			aad_bv = aadEnsureBV(); aad_bv.MaxForce = Vector3.new(0, 1e9, 0); aad_bv.Velocity = Vector3.zero
			ahd_any, ahd_maxY = aadHoldDanger()
			if ahd_any then
				aad_desired = math.min(aad.origCF.Position.Y + AAD_CEIL_CAP, ahd_maxY + 5)
				if aad_desired < aad.origCF.Position.Y + AAD_SKY then aad_desired = aad.origCF.Position.Y + AAD_SKY end
				if aad_desired > aad.ceilingY then aad.ceilingY = aad_desired end
			end
			if aad_hrp.Position.Y > aad.ceilingY then
				aad_hrp.CFrame = CFrame.new(aad_hrp.Position.X, aad.ceilingY, aad_hrp.Position.Z) * aad.faceRot
			end
			if (not ahd_any) or (aad_now - aad.upStart > AAD_HOLD_MAX) then
				aad.state = "down"; aad.downStart = aad_now
			end
		elseif aad.state == "down" then
			ahd_any2, ahd_maxY2 = aadHoldDanger()
			if ahd_any2 then
				aad_ceiling2 = math.min(aad.origCF.Position.Y + AAD_CEIL_CAP, ahd_maxY2 + 5)
				if aad_ceiling2 < aad.origCF.Position.Y + AAD_SKY then aad_ceiling2 = aad.origCF.Position.Y + AAD_SKY end
				aad.ceilingY = aad_ceiling2
				aad_hrp.CFrame = CFrame.new(aad_hrp.Position.X, aad.ceilingY, aad_hrp.Position.Z) * aad.faceRot
				aad_bv = aadEnsureBV(); aad_bv.MaxForce = Vector3.new(0, 1e9, 0); aad_bv.Velocity = Vector3.zero
				aad.state = "up"; aad.upStart = aad_now
			else
				aad_gy = aadGroundY()
				aad_targetY = aad_gy or aad.origCF.Position.Y
				aad_bv = aadEnsureBV(); aad_bv.MaxForce = Vector3.new(0, 1e9, 0); aad_bv.Velocity = Vector3.zero
				aad_hrp.CFrame = CFrame.new(aad_hrp.Position.X, aad_targetY, aad_hrp.Position.Z) * aad.faceRot
				aadCleanupBV(); aad.state = "idle"; aad.lastDodge = aad_now
			end
		end
		return
	end

	if aad.state == "idle" then
		if aad_hit and (aad_now - aad.lastDodge >= AAD_COOLDOWN or aad.threatTtc <= 0.08) then
			aadPlanLegit()
			aad.state = "juke"; aad.dodgeUntil = 0
		end
	elseif aad.state == "juke" then
		if aad.dodgeUntil == 0 then aad.dodgeUntil = aad_now + aad.actDur end
		aaj_elapsed = aad_now - (aad.dodgeUntil - aad.actDur)
		aaj_travel = aad_hrp.Position - aad.actStart
		aaj_traveled = aaj_travel.X * aad.actDir.X + aaj_travel.Z * aad.actDir.Z
		aaj_canH = aaj_traveled < aad.actNeed
		aaj_safe = aadSafeAhead(aad.actDir)
		aaj_k = aad.actKind

		if aaj_k == "walk" then
			if aaj_canH and aaj_safe then
				aad_hum:Move(aad.actDir, false)
				aadSetHorizBV(aad.actDir)
			else
				aad_hum:Move(Vector3.zero, false); aadCleanupBV()
			end
		elseif aaj_k == "hop" then
			if not aad.actJumped then aad_hum:ChangeState(Enum.HumanoidStateType.Jumping); aad.actJumped = true end
			if aad_hum.FloorMaterial ~= Enum.Material.Air then
				if aaj_canH and aaj_safe then aad_hum:Move(aad.actDir, false); aadSetHorizBV(aad.actDir) else aad_hum:Move(Vector3.zero, false); aadCleanupBV() end
			else
				aad_hum:Move(Vector3.zero, false)
				if aaj_canH and aaj_safe then aadSetHorizBV(aad.actDir) else aadCleanupBV() end
			end
		elseif aaj_k == "jump" then
			if not aad.actJumped then aad_hum:ChangeState(Enum.HumanoidStateType.Jumping); aad.actJumped = true end
			if aad.actJumpStrafe and aaj_canH and aaj_safe then aadSetHorizBV(aad.actDir) else aadCleanupBV() end
			aad_hum:Move(Vector3.zero, false)
		elseif aaj_k == "air" then
			if aaj_canH and aaj_safe then aadSetHorizBV(aad.actDir) else aadCleanupBV() end
		end

		if aaj_elapsed >= aad.actDur then
			aadCleanupBV(); aad_hum:Move(Vector3.zero, false)
			aad.state = "idle"; aad.lastDodge = aad_now; aad.dodgeUntil = 0
		end
	end
end

AutoArrowDodge.Callbacks.OnToggle = function(state)
	aad.on = state
	if state then
		aad.state = "idle"; aad.list = {}; aad.hist = {}; aad.lastDodge = 0; aad.scanAcc = 0; aad.sumAt = tick(); aad.dodgeUntil = 0
		aad.origCF = nil; aad.faceRot = nil; aad.ceilingY = 0
		aad.dNet = false; aad.dSync = false; aad.dScan = false; aad.dSum = false
		aad.srcNet = false; aad.srcSync = false
		aadConnect()
		if not aad.conn then aad.conn = G.Services.RunService.Heartbeat:Connect(aadLoop) end
	else
		if aad.conn then aad.conn:Disconnect(); aad.conn = nil end
		if aad.evConn then pcall(function() aad.evConn:Disconnect() end); aad.evConn = nil end
		if aad.netConn then pcall(function() aad.netConn:Disconnect() end); aad.netConn = nil end
		aadCleanupBV(); aad.state = "idle"; aad.list = {}; aad.hist = {}; aad.dodgeUntil = 0
		pcall(function()
			aad_c2 = aadMyChar(); aad_h2 = aad_c2 and aad_c2:FindFirstChildOfClass("Humanoid")
			if aad_h2 then aad_h2:Move(Vector3.zero, false) end
		end)
	end
end

KeepSprint.Callbacks.OnToggle = function(state)
	loops["keep sprint"] = state

	if keepSprintAttrConn then
		pcall(function() keepSprintAttrConn:Disconnect() end)
		keepSprintAttrConn = nil
	end

	if state and canRequire and SprintController then
		cachedChar = Player.Character or Player.CharacterAdded:Wait()

		keepSprintAttrConn = cachedChar:GetAttributeChangedSignal("SpeedBoost"):Connect(function()
			if not loops["keep sprint"] then return end

			if cachedChar:GetAttribute("SpeedBoost") == 1.5 then
				if SprintController.isSprinting or SprintController.attemptingSprint then
					SprintController.attemptingSprint = true
					SprintController:startSprinting()
				end
			end
		end)
	end
end

