	function mod:CreateDropdown(dName, options, default, dCallback, multiSelect, isPlayerDropdown)
        multiSelect = multiSelect or false
        local optionsProvider = type(options) == "function" and options or nil
        if optionsProvider then options = optionsProvider() end
        local settingID = uniquePrefix .. "_" .. dName
		local favSettingID = settingID .. "_Favs"

		if isPlayerDropdown then
			options = {}
			for _, p in ipairs(FWNoModules.PlayerSnapshot()) do
				table.insert(options, p.Name)
			end
		end

		if _G.SavedConfig[settingID] ~= nil then
			default = FWNoModules.Profiles.Value(_G.SavedConfig[settingID])
		else
			_G.SavedConfig[settingID] = default
		end

		if _G.SavedConfig[favSettingID] == nil then
			_G.SavedConfig[favSettingID] = {}
		end
		local favorites = _G.SavedConfig[favSettingID]

		-- CRITICAL FIX: Ensure multiSelect values are ALWAYS a table
		if multiSelect then
			if type(default) == "table" then
				mod.Values[dName] = {}
				for _, v in ipairs(default) do table.insert(mod.Values[dName], v) end
			elseif type(default) == "string" and default ~= "" then
				mod.Values[dName] = {default}
			else
				mod.Values[dName] = {}
			end

			-- Safety check: if the saved config somehow became a non-table, reset it
			if type(mod.Values[dName]) ~= "table" then
				mod.Values[dName] = {}
			end
		else
			mod.Values[dName] = default
		end 

		local dropCont = FWNoModules.OwnInstance(Instance.new("Frame", settingsCont))
		dropCont:SetAttribute("FWSettingName", tostring(dName))
		dropCont.BackgroundTransparency = 1
		dropCont.AutomaticSize = Enum.AutomaticSize.Y
		dropCont.Size = UDim2.new(1, 0, 0, 0)
		local dLayout = FWNoModules.OwnInstance(Instance.new("UIListLayout", dropCont))
		dLayout.SortOrder = Enum.SortOrder.LayoutOrder

		local dBtn = FWNoModules.OwnInstance(Instance.new("TextButton", dropCont))
		dBtn.Size = UDim2.new(1, 0, 0, 28)
		dBtn.BackgroundTransparency = 1
		dBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
		dBtn.TextXAlignment = Enum.TextXAlignment.Left
		dBtn.TextSize = 20
		dBtn.FontFace = Font.fromName(textFont)
		dBtn.LayoutOrder = 1

		local optFrame = FWNoModules.OwnInstance(Instance.new("ScrollingFrame", dropCont))
		optFrame.BackgroundTransparency = 1
		optFrame.Size = UDim2.new(1, 0, 0, 240)
		optFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
		optFrame.AutomaticCanvasSize = "Y"
		optFrame.ScrollBarThickness = 4
		optFrame.ScrollBarImageColor3 = Color3.fromRGB(100, 100, 100)
		optFrame.Visible = false
		optFrame.LayoutOrder = 2

		local oLayout = FWNoModules.OwnInstance(Instance.new("UIListLayout", optFrame))
		oLayout.SortOrder = Enum.SortOrder.LayoutOrder

		dropdownElement = {}

		function dropdownElement:SetVisible(state)
			dropCont.Visible = state
		end

		local function updateDropdownText()
			if multiSelect then
				-- CRITICAL FIX: Ensure we are counting a table
				local currentVal = mod.Values[dName]
				if type(currentVal) ~= "table" then
					currentVal = {}
					mod.Values[dName] = currentVal
				end

				local count = #currentVal
				if count == 0 then
					dBtn.Text = "      - " .. dName .. ": None"
				elseif count == 1 then
					dBtn.Text = "      - " .. dName .. ": " .. tostring(currentVal[1])
				else
					dBtn.Text = "      - " .. dName .. ": [" .. count .. " Selected]"
				end
			else
				local val = mod.Values[dName]
				dBtn.Text = "      - " .. dName .. ": " .. (val ~= nil and tostring(val) or "None")
			end
		end

		updateDropdownText() 
		if dCallback then dCallback(mod.Values[dName]) end

		local fullyPopulated = false

		local function buildOptions()
			for _, child in ipairs(optFrame:GetChildren()) do
				if child:IsA("Frame") then
					child:Destroy()
				end
			end

			for i, opt in ipairs(options) do
				if i % 100 == 0 then task.wait() end

				local optKey = tostring(opt)

				local row = FWNoModules.OwnInstance(Instance.new("Frame", optFrame))
				row.Size = UDim2.new(1, 0, 0, 24)
				row.BackgroundTransparency = 1

				local oBtn = FWNoModules.OwnInstance(Instance.new("TextButton", row))
				oBtn.Size = UDim2.new(1, -35, 1, 0)
				oBtn.BackgroundTransparency = 1
				oBtn.TextColor3 = Color3.fromRGB(120, 120, 120)
				oBtn.TextXAlignment = Enum.TextXAlignment.Left
				oBtn.TextSize = 18
				oBtn.FontFace = Font.fromName(textFont)

				local favBtn = FWNoModules.OwnInstance(Instance.new("TextButton", row))
				favBtn.Size = UDim2.new(0, 24, 0, 24)
				favBtn.Position = UDim2.new(1, -28, 0, 0)
				favBtn.BackgroundTransparency = 1
				favBtn.TextSize = 16
				favBtn.FontFace = Font.fromName(textFont)

				local function updateVisual()
					if multiSelect then
						local isSelected = table.find(mod.Values[dName], opt)
						oBtn.Text = (isSelected and "          > [x] " or "          > [ ] ") .. optKey
						oBtn.TextColor3 = isSelected and Color3.new(1,1,1) or Color3.fromRGB(120, 120, 120)
					else
						oBtn.Text = "          > " .. optKey
					end
				end

				local function updateFavSort()
					local isFav = favorites[optKey] == true
					row.LayoutOrder = isFav and i or (10000 + i)
					favBtn.Text = isFav and "★" or "☆"
					favBtn.TextColor3 = isFav and Color3.fromRGB(254, 204, 34) or Color3.fromRGB(80, 80, 80)
				end

				updateVisual() 
				updateFavSort()

				FWNoModules.Connect(oBtn.MouseEnter, function() 
					tween(oBtn, {TextColor3 = Color3.new(1,1,1)}) 
				end)

				FWNoModules.Connect(oBtn.MouseLeave, function() 
					if multiSelect and table.find(mod.Values[dName], opt) then return end
					tween(oBtn, {TextColor3 = Color3.fromRGB(120, 120, 120)}) 
				end)

				FWNoModules.Connect(favBtn.MouseEnter, function()
					if not favorites[optKey] then favBtn.TextColor3 = Color3.fromRGB(200, 200, 200) end
				end)

				FWNoModules.Connect(favBtn.MouseLeave, function()
					if not favorites[optKey] then favBtn.TextColor3 = Color3.fromRGB(80, 80, 80) end
				end)

				FWNoModules.Connect(favBtn.Activated, FWNoModules.Mobile.Activation(function()
					favorites[optKey] = not favorites[optKey] or nil
					_G.SavedConfig[favSettingID] = favorites
					saveConfigToPC()
					updateFavSort()
				end))

				FWNoModules.Connect(oBtn.Activated, FWNoModules.Mobile.Activation(function()
					if multiSelect then
						local foundIdx = table.find(mod.Values[dName], opt)
						if foundIdx then
							table.remove(mod.Values[dName], foundIdx)
						else
							table.insert(mod.Values[dName], opt)
						end

						updateVisual()
						updateDropdownText()

						_G.SavedConfig[settingID] = mod.Values[dName]
						saveConfigToPC()

						if dCallback then dCallback(mod.Values[dName]) end
						if mod.Callbacks.OnValueChanged then mod.Callbacks.OnValueChanged(dName, mod.Values[dName]) end
					else
						optFrame.Visible = false
						mod.Values[dName] = opt

						updateDropdownText()

						_G.SavedConfig[settingID] = opt
						saveConfigToPC()

						if dCallback then dCallback(opt) end
						if mod.Callbacks.OnValueChanged then mod.Callbacks.OnValueChanged(dName, opt) end
					end
				end))
			end
		end

		mod.UpdateFunctions[dName] = function(forceVal)
            FWNoModules.Profiles.TouchBinding(settingID)
			if multiSelect then
				if type(forceVal) == "table" then
					mod.Values[dName] = forceVal
				elseif type(forceVal) == "string" and forceVal ~= "" then
					mod.Values[dName] = {forceVal}
				else
					mod.Values[dName] = {}
				end
				if type(mod.Values[dName]) ~= "table" then mod.Values[dName] = {} end
			else
				-- CRITICAL FIX: Validate that the forced value is actually in the options list
				local isValidOption = false
				for _, opt in ipairs(options) do
					if tostring(opt) == tostring(forceVal) then
						isValidOption = true
						break
					end
				end

				if isValidOption then
					mod.Values[dName] = forceVal
				else
					-- If the saved config is corrupted (e.g., "On Hit"), reset to the first valid option
					mod.Values[dName] = options[1]
				end
			end

			_G.SavedConfig[settingID] = mod.Values[dName]
			saveConfigToPC()
			updateDropdownText()
			if dCallback then dCallback(mod.Values[dName]) end
			if mod.Callbacks.OnValueChanged then mod.Callbacks.OnValueChanged(dName, mod.Values[dName]) end
		end


		FWNoModules.Connect(dBtn.Activated, FWNoModules.Mobile.Activation(function() 
			optFrame.Visible = not optFrame.Visible 

            if optFrame.Visible and optionsProvider then
                options = optionsProvider()
                fullyPopulated = false
            end
            if optFrame.Visible and not fullyPopulated then
				fullyPopulated = true
				buildOptions()
			end
		end))

		local lastRightClick = 0
		FWNoModules.Mobile.Secondary(dBtn, function(input)
            local now = tick()
            if FWNoModules.Mobile.IsTouchInput(input)then lastRightClick=now end
            if now - lastRightClick < 0.3 then
				lastRightClick = 0
				if multiSelect then
					mod.Values[dName] = {}
				else
					mod.Values[dName] = nil
				end
				updateDropdownText()
				if optFrame.Visible then buildOptions() end
				_G.SavedConfig[settingID] = mod.Values[dName]
				saveConfigToPC()
				if dCallback then dCallback(mod.Values[dName]) end
				if mod.Callbacks.OnValueChanged then mod.Callbacks.OnValueChanged(dName, mod.Values[dName]) end
			else
				lastRightClick = now
			end
		end)

		if isPlayerDropdown then
			local pAdded = FWNoModules.Connect(Players.PlayerAdded, function(plr)
				if not table.find(options, plr.Name) then
					table.insert(options, plr.Name)
					if fullyPopulated then buildOptions() end
				end
			end)

			local pRemoving = FWNoModules.Connect(Players.PlayerRemoving, function(plr)
				local idx = table.find(options, plr.Name)
				if idx then
					table.remove(options, idx)
					if fullyPopulated then buildOptions() end
				end

				if multiSelect then
					local selIdx = table.find(mod.Values[dName], plr.Name)
					if selIdx then
						table.remove(mod.Values[dName], selIdx)
						updateDropdownText()
						if dCallback then dCallback(mod.Values[dName]) end
					end
				else
					if mod.Values[dName] == plr.Name then
						mod.Values[dName] = nil
						updateDropdownText()
						if dCallback then dCallback(nil) end
					end
				end
			end)

			FWNoModules.Connect(dropCont.Destroying, function()
				pAdded:Disconnect()
				pRemoving:Disconnect()
			end)
		end
        FWNoModules.Profiles.Register(settingID,function()return mod.Values[dName]end,function(v)
            mod.Values[dName]=FWNoModules.Profiles.Clone(v)
            if v==nil then mod.Values[dName]=nil end
            _G.SavedConfig[settingID]=v==nil and FWNoModules.Profiles.Nil or FWNoModules.Profiles.Clone(v)
            updateDropdownText()
            fullyPopulated=false
            if optFrame.Visible then buildOptions();fullyPopulated=true end
            if dCallback then dCallback(v)end
            if mod.Callbacks.OnValueChanged then mod.Callbacks.OnValueChanged(dName,v)end
        end,mod,"setting")
        return { SetVisible = function(esp_sv) dropCont.Visible = esp_sv end }
	end

