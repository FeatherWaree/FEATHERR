function Walk.Plan(From: Vector3, To: Vector3, Radius: number?): ({PathWaypoint}?, string)
    local Path = PathfindingService:CreatePath({AgentRadius = Radius or 2, AgentHeight = 5, AgentCanJump = true, WaypointSpacing = 5, Costs = Walk.Costs})
    local Success, Err = pcall(function()
        Path:ComputeAsync(From, To)
    end)
    if not Success then
        return nil, tostring(Err)
    end
    if Path.Status ~= Enum.PathStatus.Success then
        return nil, tostring(Path.Status)
    end
    return Path:GetWaypoints(), "ok"
end

function Walk.To(Target: Vector3, Radius: number, Timeout: number, Token: number, Abort: (() -> boolean)?, Vertical: number?): (boolean, string)
    Walk.Bind()
    local Started: number = os.clock()
    local Waypoints: {PathWaypoint} = {}
    local Index: number = 2
    local Replan: number = 0
    local Jumped: {[number]: boolean} = {}
    local Root: BasePart? = GetRoot()
    local Anchor: Vector3 = Root and Root.Position or Vector3.zero
    local Moved: number = os.clock()
    local Faults: number = 0
    local Skipped: number = 0
    local Result: string = "timeout"
    Walk.Active = true
    while os.clock() - Started < Timeout do
        if not Current(Token) then
            Result = "cancel"
            break
        end
        Root = GetRoot()
        if not Root then
            Result = "dead"
            break
        end
        if Abort and Abort() then
            Result = "abort"
            break
        end
        local Position: Vector3 = Root.Position
        if Planarize(Target - Position).Magnitude <= Radius and math.abs(Target.Y - Position.Y) <= (Vertical or 9) then
            Result = "arrived"
            break
        end
        if #Waypoints == 0 or os.clock() >= Replan then
            local Planned, Reason = Walk.Plan(Position, Target, Faults >= 2 and 1.2 or 2)
            if Planned and #Planned > 1 then
                Waypoints, Index, Jumped = Planned, 2, {}
            else
                Waypoints = {}
                Faults += 1
                if Faults >= 5 then
                    Result = `nopath {Reason}`
                    break
                end
            end
            Replan = os.clock() + (#Waypoints > 0 and 4 or 1)
        end
        local Waypoint: PathWaypoint? = Waypoints[Index]
        if Waypoint then
            local Flat: Vector3 = Planarize(Waypoint.Position - Position)
            if Flat.Magnitude < 3 and math.abs(Waypoint.Position.Y - Position.Y) < 7 then
                Index += 1
            else
                Walk.Dir = Flat.Magnitude > 0.01 and Flat.Unit or Vector3.zero
                if Walk.Bunny and Flat.Magnitude > 7 then
                    local Body: Humanoid? = GetHumanoid()
                    if Body and Body.FloorMaterial ~= Enum.Material.Air and os.clock() - Skipped > 0.45 then
                        Skipped = os.clock()
                        Walk.Jump = true
                    end
                end
                if Waypoint.Action == Enum.PathWaypointAction.Jump and Flat.Magnitude < 6 and not Jumped[Index] then
                    Jumped[Index] = true
                    Walk.Jump = true
                end
            end
        else
            local Flat: Vector3 = Planarize(Target - Position)
            Walk.Dir = Flat.Magnitude > 0.01 and Flat.Unit or Vector3.zero
            Waypoints = {}
        end
        if (Position - Anchor).Magnitude > 1.2 then
            Anchor, Moved = Position, os.clock()
        elseif os.clock() - Moved > 1.1 then
            Walk.Jump = true
            Moved = os.clock()
            Faults += 1
            if Faults % 2 == 0 then
                Replan = 0
            end
        end
        task.wait()
    end
    Walk.Stop()
    return Result == "arrived", Result
end

function Walk.Hop(Goal: Vector3, Scene: Instance, Token: number): (boolean, string)
    local Root: BasePart? = GetRoot()
    if not Root then
        return false, "dead"
    end
    local Origin: Vector3 = Root.Position
    local Heading: Vector3 = Planarize(Goal - Origin)
    if Heading.Magnitude < 1 then
        return false, "here"
    end
    Heading = Heading.Unit
    local Candidates = {}
    for _, Item in Scene:GetDescendants() do
        if Item:IsA("BasePart") and Item.CanCollide and Item.Size.Y < 40 and Item.Size.X > 3 and Item.Size.Z > 3 then
            local Top: Vector3 = Item.Position + Vector3.new(0, Item.Size.Y / 2 + 3, 0)
            local Ahead: number = Planarize(Top - Origin):Dot(Heading)
            if Ahead > 12 and Ahead < 150 and math.abs(Top.Y - Origin.Y) < 30 then
                table.insert(Candidates, {Top = Top, Left = Planarize(Goal - Top).Magnitude})
            end
        end
    end
    table.sort(Candidates, function(A, B)
        return A.Left < B.Left
    end)
    for i: number = 1, math.min(#Candidates, 10) do
        if not Current(Token) then
            return false, "cancel"
        end
        local Planned = Walk.Plan(Origin, Candidates[i].Top)
        if Planned and #Planned > 1 then
            local Reached, Reason = Walk.To(Candidates[i].Top, 5, 30, Token, nil, 10)
            return Reached, `hop {Reason}`
        end
    end
    return false, `no hop in {#Candidates}`
end

local function Nudge(Root: BasePart, Target: Vector3)
    local Gap: Vector3 = Planarize(Target - Root.Position)
    local Spot: Vector3 = Target
    if Gap.Magnitude > 24 then
        Spot = Vector3.new(Root.Position.X + Gap.Unit.X * 24, Target.Y, Root.Position.Z + Gap.Unit.Z * 24)
    end
    Root.CFrame = CFrame.new(Spot + Vector3.new(0, 2, 0))
    Root.AssemblyLinearVelocity = Vector3.zero
end

function Walk.Follow(Route: {Vector3}, First: number, Token: number, Limit: number, Recover: boolean?, Radius: number?, Evade: ((BasePart, Vector3, Vector3) -> boolean)?): (boolean, number, string)
    Walk.Bind()
    Walk.Active = true
    local Index: number = First
    local Started: number = os.clock()
    local Anchor: Vector3 = Vector3.zero
    local Moved: number = os.clock()
    local Report: number = 0
    local Hopped: number = 0
    local Recoveries: number = 0
    local Reach: number = Radius or 4.5
    local Result: string = "timeout"
    while Current(Token) and os.clock() - Started < Limit do
        local Root: BasePart? = GetRoot()
        local Humanoid: Humanoid? = GetHumanoid()
        if not Root or not Humanoid then
            Result = "dead"
            break
        end
        local Position: Vector3 = Root.Position
        while Index <= #Route and Planarize(Route[Index] - Position).Magnitude < Reach do
            Index += 1
        end
        if Index > #Route then
            Result = "done"
            break
        end
        local Flat: Vector3 = Planarize(Route[Index] - Position)
        if Evade and Evade(Root, Position, Flat.Unit) then
            Walk.Dir = Vector3.zero
            Anchor, Moved = Root.Position, os.clock()
            task.wait()
            continue
        end
        Walk.Dir = Flat.Unit
        if Humanoid.FloorMaterial ~= Enum.Material.Air and os.clock() - Hopped > 0.45 then
            Hopped = os.clock()
            Walk.Jump = true
        end
        if Recover and Recoveries < 14 and Humanoid.Health > 0 and (Position.Y < Route[Index].Y - 18 or Root.AssemblyLinearVelocity.Y < -58 and Position.Y < Route[Index].Y - 10) then
            Recoveries += 1
            Nudge(Root, Route[Index])
            Anchor, Moved = Root.Position, os.clock()
            Log(`recover fall {Index}/{#Route}`)
        end
        if os.clock() - Report > 3 then
            Report = os.clock()
            Log(`follow {Index}/{#Route} at {math.floor(Position.X)},{math.floor(Position.Y)},{math.floor(Position.Z)} hp {math.floor(Humanoid.Health)}`)
        end
        if Planarize(Position - Anchor).Magnitude > 2.5 then
            Anchor, Moved = Position, os.clock()
        elseif Recover and Recoveries < 14 and Humanoid.Health > 0 and os.clock() - Moved > 1.6 then
            Recoveries += 1
            Nudge(Root, Route[Index])
            Anchor, Moved = Root.Position, os.clock()
            Log(`recover stuck {Index}/{#Route}`)
        elseif os.clock() - Moved > 3 then
            Result = "stuck"
            Log(`stuck ws {Humanoid.WalkSpeed} md {Humanoid.MoveDirection.Magnitude} state {tostring(Humanoid:GetState())} plat {tostring(Humanoid.PlatformStand)} sit {tostring(Humanoid.Sit)} vel {math.floor(Root.AssemblyLinearVelocity.Magnitude)} anch {tostring(Root.Anchored)} dir {Walk.Dir.Magnitude}`)
            break
        end
        task.wait()
    end
    Walk.Stop()
    return Result == "done", Index, Result
end

local function Nearest(Route: {Vector3}, Position: Vector3): number
    local Best: number = 1
    local Distance: number = math.huge
    for i: number, Point: Vector3 in Route do
        local Gap: number = Planarize(Point - Position).Magnitude
        if Gap < Distance then
            Best, Distance = i, Gap
        end
    end
    return Best
end

local function Travel(Target: Vector3, Radius: number, Limit: number, Token: number, Scene: Instance, Vertical: number?, Abort: (() -> boolean)?): boolean
    local Started: number = os.clock()
    local Failed: number = 0
    while Current(Token) and os.clock() - Started < Limit do
        local Reached, Reason = Walk.To(Target, Radius, 25, Token, Abort, Vertical)
        if Reached then
            return true
        end
        if Reason == "dead" or Reason == "cancel" or Reason == "abort" then
            return false
        end
        Log(`travel {Reason}`)
        local Hopped, HopReason = Walk.Hop(Target, Scene, Token)
        if not Hopped then
            Log(`hop {HopReason}`)
            Failed += 1
            if Failed >= 2 then
                return false
            end
            task.wait(0.5)
        end
    end
    return false
end

function Combat.Tune()
    for Name, Wanted in Tuning do
        local Module = vape.Modules[Name]
        local Options = Module and Module.Options
        if Options then
            for Option, Value in Wanted do
                local Component = Options[Option]
                if Component and type(Value) == "boolean" and Component.Enabled ~= nil and Component.Enabled ~= Value then
                    if Combat.Saved[Component] == nil then
                        Combat.Saved[Component] = Component.Enabled
                    end
                    Component:Toggle()
                    Log(`tuned {Name} {Option} {tostring(Value)}`)
                elseif Component and type(Value) == "number" and Component.Value ~= nil and Component.Value ~= Value then
                    if Combat.Saved[Component] == nil then
                        Combat.Saved[Component] = Component.Value
                    end
                    Component:SetValue(Value)
                    Log(`tuned {Name} {Option} {Value}`)
                end
            end
        end
    end
end

function Combat.Untune()
    for Component, Original in Combat.Saved do
        if type(Original) == "boolean" then
            if Component.Enabled ~= Original then
                Component:Toggle()
            end
        else
            Component:SetValue(Original)
        end
    end
    table.clear(Combat.Saved)
end

function Combat.Own()
    if Combat.Owned then
        return
    end
    Combat.Owned = true
    for _, Name in {"Killaura", "ProjectileAura"} do
        local Module = vape.Modules[Name]
        if Module then
            Combat.Original[Name] = Module.Enabled
            if Module.Enabled then
                Module:Toggle()
                Log(`auto disabled {Name}`)
            end
        end
    end
end

function Combat.Ensure()
    if not Fight.Enabled or not Mode() then
        return
    end
    Combat.Own()
    local Style: string = SceneCombat[Brain.Scene or ""] or "melee"
    local Melee: boolean = Style == "melee" or Style == "both"
    local Bow: boolean = (Style == "bow" or Style == "both") and Archery.Enabled
    local Aura = vape.Modules.Killaura
    if Aura and Aura.Enabled ~= Melee then
        Aura:Toggle()
        Log(`built-in killaura {Melee and "on" or "off"} for {tostring(Brain.Scene)}`)
    end
    if Bow then
        Combat.Shoot()
    elseif Combat.Bow or Combat.NPCs then
        Combat.Unshoot()
        Log(`built-in projectileaura off for {tostring(Brain.Scene)}`)
    end
    Combat.Tune()
    local Consume = vape.Modules.AutoConsume
    if Consume and not Consume.Enabled then
        Combat.Heal = true
        Consume:Toggle()
        Log("enabled AutoConsume")
    end
end

function Combat.Release()
    Combat.Unshoot()
    Combat.Untune()
    for Name, Original in Combat.Original do
        local Module = vape.Modules[Name]
        if Module and Module.Enabled ~= Original then
            Module:Toggle()
        end
    end
    table.clear(Combat.Original)
    Combat.Owned = false
    local Consume = vape.Modules.AutoConsume
    if Combat.Heal and Consume and Consume.Enabled then
        Consume:Toggle()
    end
    Combat.Heal = false
end

function Combat.Shoot()
    local Aura = vape.Modules.ProjectileAura
    if not Aura then
        return
    end
    local Targets = Aura.Options and Aura.Options.Targets
    if Targets and Targets.NPCs and not Targets.NPCs.Enabled then
        Targets.NPCs:Toggle()
        Combat.NPCs = true
    end
    if not Aura.Enabled then
        Aura:Toggle()
        Combat.Bow = true
    end
end

function Combat.Unshoot()
    local Aura = vape.Modules.ProjectileAura
    if not Aura then
        return
    end
    if Combat.Bow and Aura.Enabled then
        Aura:Toggle()
    end
    local Targets = Aura.Options and Aura.Options.Targets
    if Combat.NPCs and Targets and Targets.NPCs and Targets.NPCs.Enabled then
        Targets.NPCs:Toggle()
    end
    Combat.Bow, Combat.NPCs = false, false
end

local function Quiet()
    for _, Name in {"Speed", "Fly", "InfiniteFly", "AutoMiner", "Nuker"} do
        local Other = vape.Modules[Name]
        if Other and Other.Enabled then
            Other:Toggle()
            Log(`disabled {Name}`)
        end
    end
end

local function GetGraveyardRemote(Name: string)
    return bedwars.Client:GetNamespace("HalloweenGraveyard"):Get(Name)
end

local function SymbolSet(Text: string?): string
    local List = {}
    for Symbol in string.gmatch(Text or "", "[^,%s]+") do
        table.insert(List, Symbol)
    end
    table.sort(List)
    return table.concat(List, ",")
end

local function PartPosition(Object: Instance?): Vector3?
    if not Object then
        return nil
    end
    if Object:IsA("BasePart") then
        return Object.Position
    elseif Object:IsA("Model") then
        return Object:GetPivot().Position
    end
    return nil
end

local function GroundAt(Position: Vector3): Vector3
    local Params = RaycastParams.new()
    Params.FilterType = Enum.RaycastFilterType.Exclude
    Params.FilterDescendantsInstances = {Camera, LocalPlayer.Character}
    local Hit = workspace:Raycast(Position + Vector3.new(0, 6, 0), Vector3.new(0, -60, 0), Params)
    return Hit and Hit.Position + Vector3.new(0, 3, 0) or Position
end

local function FloorBelow(Position: Vector3, Height: number?): Vector3
    local Params = RaycastParams.new()
    Params.FilterType = Enum.RaycastFilterType.Exclude
    Params.FilterDescendantsInstances = {Camera, LocalPlayer.Character}
    local Hit = workspace:Raycast(Position, Vector3.new(0, -(Height or 80), 0), Params)
    return Hit and Hit.Position + Vector3.new(0, 3, 0) or Position
end

local function PromptPosition(Prompt: ProximityPrompt): Vector3?
    local Parent: Instance? = Prompt.Parent
    if Parent and Parent:IsA("Attachment") then
        return Parent.WorldPosition
    end
    while Parent and not Parent:IsA("BasePart") do
        Parent = Parent.Parent
    end
    return Parent and Parent.Position
end

local function OpenGate(Namespace: string, Button: BasePart?, Token: number)
    local Remotes = bedwars.Client:GetNamespace(Namespace)
    local GateOpened: boolean = false
    local Requests: number = 0
    AutoHalloween:Clean(Remotes:Get("GateOpenSuccess"):Connect(function()
        GateOpened = true
    end))
    while Current(Token) and Button and not GateOpened and Requests < 3 do
        local Reached = Walk.To(GroundAt(Button.Position), 5, 60, Token, function()
