cdHookChest = function(part)
    local folderValue = part:FindFirstChild("ChestFolderValue")
    local folder = folderValue and folderValue.Value
    if not folder or cd_chestConns[folder] then return end
    local connections, logs = cd_chestConns, cd_chestLog
    logs[folder] = {}
    local gate = FWNoModules.GatedEvent(folder.ChildRemoved, {"cheater detector"}, function(item)
        if not loops["cheater detector"] or not CheaterDetector.Values["Chest Stealer"] then return end
        if item.Name == "ChestOwner" then return end
        local now = os.clock()
        local times = logs[folder]
        if not times then return end
        table.insert(times, now)
        while #times > 6 do table.remove(times, 1) end
        if #times >= 3 and (times[#times] - times[#times - 2]) <= 0.35 then
            local nearest = cdNearestPlayer(part.Position, 25)
            if nearest then cdNotify(nearest, "Chest Stealer (instant loot)") end
            logs[folder] = {}
        end
    end)
    connections[folder] = gate
    local lifetime = {}
    local unsubscribeCleanup
    local alive = true
    local function remove()
        if not alive then return end
        alive = false
        gate:Disconnect()
        for _, connection in ipairs(lifetime) do connection:Disconnect() end
        table.clear(lifetime)
        if connections[folder] == gate then connections[folder] = nil; logs[folder] = nil end
        if unsubscribeCleanup then unsubscribeCleanup(); unsubscribeCleanup = nil end
    end
    lifetime[1] = FWNoModules.Connect(part.Destroying, remove)
    lifetime[2] = FWNoModules.Connect(folder.Destroying, remove)
    lifetime[3] = FWNoModules.Connect(part.AncestryChanged, function()
        if not part:IsDescendantOf(G.Services.Workspace) then remove() end
    end)
    unsubscribeCleanup = FWNoModules.OnCleanup(remove)
end

