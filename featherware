function gompyGetPos(g)
	if g:IsA("BasePart") then return g.Position end
	if g:IsA("Model") then
		gompy_pp = g.PrimaryPart or g:FindFirstChildWhichIsA("BasePart")
		if gompy_pp then return gompy_pp.Position end
		pcall(function() return g:GetPivot().Position end)
	end
	return nil
end

function gompyIsGhostObj(o)
	if not o then return false end
	if not (o:IsA("BasePart") or o:IsA("Model")) then return false end
	return o.Name:lower():find("ghost") ~= nil
end

function gompyColorParts(g, col, transp)
	gompy_orig = {}
	for _, gp in ipairs(g:GetDescendants()) do
		if gp:IsA("BasePart") then
			table.insert(gompy_orig, {part = gp, color = gp.Color, transp = gp.Transparency, mat = gp.Material})
			gp.Color = col
			gp.Transparency = transp
			gp.Material = Enum.Material.Neon
		end
	end
	return gompy_orig
end

function gompyRestoreParts(orig)
	if not orig then return end
	for _, op in ipairs(orig) do
		pcall(function()
			op.part.Color = op.color
			op.part.Transparency = op.transp
			op.part.Material = op.mat
		end)
	end
end

function gompyUpdatePartColors(orig, col, transp)
	if not orig then return end
	for _, op in ipairs(orig) do
		pcall(function()
			op.part.Color = col
			op.part.Transparency = transp
			op.part.Material = Enum.Material.Neon
		end)
	end
end

function gompyCleanupEntry(g)
	gompy_d = gompy_esp_data[g]
	if not gompy_d then return end
	if gompy_d.origParts then gompyRestoreParts(gompy_d.origParts) end
	if gompy_d.bb then pcall(function() gompy_d.bb:Destroy() end) end
	if gompy_d.glow then pcall(function() gompy_d.glow:Destroy() end) end
	gompy_esp_data[g] = nil
end

gompy_lastTick = 0
function gompyEspLoop()
	if not loops["gompy esp"] then return end
	gompy_now = os.clock()
	if gompy_now - gompy_lastTick < 0.2 then return end
	gompy_lastTick = gompy_now
	pcall(function()
		gompy_char = Player.Character
		gompy_hrp = gompy_char and gompy_char:FindFirstChild("HumanoidRootPart")
		if not gompy_hrp then return end

		gompy_col = GompyESP.Values["Ghost Color"] or Color3.fromRGB(180, 120, 255)
		gompy_partTransp = GompyESP.Values["Part Transparency"] or 0.3
		gompy_showHL = GompyESP.Values["Show Highlight"]
		gompy_showDist = GompyESP.Values["Show Distance"]
		gompy_showGlow = GompyESP.Values["Show Glow"]

		for gompy_g in pairs(gompy_esp_set) do
			if not gompy_g.Parent then
				gompyCleanupEntry(gompy_g)
				gompy_esp_set[gompy_g] = nil
			else
				gompy_pos = gompyGetPos(gompy_g)
				if gompy_pos then
					gompy_dist = (gompy_pos - gompy_hrp.Position).Magnitude

					if not gompy_esp_data[gompy_g] then
						gompy_entry = {}

						if gompy_showHL then
							gompy_entry.origParts = gompyColorParts(gompy_g, gompy_col, gompy_partTransp)
						end

						if gompy_showDist then
							gompy_bb = Instance.new("BillboardGui")
							gompy_bb.Adornee = gompy_g:IsA("BasePart") and gompy_g or (gompy_g.PrimaryPart or gompy_g:FindFirstChildWhichIsA("BasePart"))
							gompy_bb.Size = UDim2.fromOffset(120, 30)
							gompy_bb.StudsOffset = Vector3.new(0, 2, 0)
							gompy_bb.AlwaysOnTop = true
							gompy_bb.Parent = G.Services.Workspace
							gompy_dl = Instance.new("TextLabel")
							gompy_dl.Size = UDim2.fromScale(1, 1)
							gompy_dl.BackgroundTransparency = 1
							gompy_dl.Text = "Ghost • " .. tostring(math.floor(gompy_dist)) .. "m"
							gompy_dl.TextColor3 = GompyESP.Values["Distance Text Color"] or Color3.fromRGB(255, 255, 255)
							gompy_dl.TextSize = GompyESP.Values["Text Size"] or 12
							gompy_dl.Font = Enum.Font.GothamBlack
							gompy_dl.TextStrokeTransparency = 0
							gompy_dl.TextStrokeColor3 = Color3.fromRGB(20, 20, 20)
							gompy_dl.Parent = gompy_bb
							gompy_entry.bb = gompy_bb
							gompy_entry.dl = gompy_dl
						end

						if gompy_showGlow then
							gompy_glowPart = gompy_g:IsA("BasePart") and gompy_g or (gompy_g.PrimaryPart or gompy_g:FindFirstChildWhichIsA("BasePart"))
							if gompy_glowPart then
								gompy_glow = Instance.new("PointLight")
								gompy_glow.Color = gompy_col
								gompy_glow.Range = GompyESP.Values["Glow Range"] or 10
								gompy_glow.Brightness = GompyESP.Values["Glow Brightness"] or 2
								gompy_glow.Parent = gompy_glowPart
								gompy_entry.glow = gompy_glow
							end
						end

						gompy_esp_data[gompy_g] = gompy_entry
					else
						gompy_entry = gompy_esp_data[gompy_g]

						if gompy_showHL and gompy_entry.origParts then
							gompyUpdatePartColors(gompy_entry.origParts, gompy_col, gompy_partTransp)
						elseif not gompy_showHL and gompy_entry.origParts then
							gompyRestoreParts(gompy_entry.origParts)
							gompy_entry.origParts = nil
						elseif gompy_showHL and not gompy_entry.origParts then
							gompy_entry.origParts = gompyColorParts(gompy_g, gompy_col, gompy_partTransp)
						end

						if gompy_entry.dl then
							gompy_entry.dl.Text = "Ghost • " .. tostring(math.floor(gompy_dist)) .. "m"
							gompy_entry.dl.TextColor3 = GompyESP.Values["Distance Text Color"] or Color3.fromRGB(255, 255, 255)
							gompy_entry.dl.TextSize = GompyESP.Values["Text Size"] or 12
						end

						if gompy_showGlow and not gompy_entry.glow then
							gompy_glowPart = gompy_g:IsA("BasePart") and gompy_g or (gompy_g.PrimaryPart or gompy_g:FindFirstChildWhichIsA("BasePart"))
							if gompy_glowPart then
								gompy_glow = Instance.new("PointLight")
								gompy_glow.Color = gompy_col
								gompy_glow.Range = GompyESP.Values["Glow Range"] or 10
								gompy_glow.Brightness = GompyESP.Values["Glow Brightness"] or 2
								gompy_glow.Parent = gompy_glowPart
								gompy_entry.glow = gompy_glow
							end
						elseif not gompy_showGlow and gompy_entry.glow then
							pcall(function() gompy_entry.glow:Destroy() end)
							gompy_entry.glow = nil
						elseif gompy_entry.glow then
							gompy_entry.glow.Color = gompy_col
							gompy_entry.glow.Range = GompyESP.Values["Glow Range"] or 10
							gompy_entry.glow.Brightness = GompyESP.Values["Glow Brightness"] or 2
						end

						if not gompy_showDist and gompy_entry.bb then
							pcall(function() gompy_entry.bb:Destroy() end)
							gompy_entry.bb = nil
							gompy_entry.dl = nil
						end
					end
				end
			end
		end
	end)
end

GompyESP.Callbacks.OnToggle = function(state)
	loops["gompy esp"] = state
	if state then
		gompy_esp_set = {}
		gompy_esp_data = {}
		gompy_tagCount = 0
		for _, gg in ipairs(gompy_cs:GetTagged("ghost")) do
			if gg:IsA("Model") or gg:IsA("BasePart") then gompy_esp_set[gg] = true; gompy_tagCount = gompy_tagCount + 1 end
		end
		gompy_nameCount = 0
		pcall(function()
			for _, gd in ipairs(G.Services.Workspace:GetDescendants()) do
				if gompyIsGhostObj(gd) and not gompy_esp_set[gd] then gompy_esp_set[gd] = true; gompy_nameCount = gompy_nameCount + 1 end
			end
		end)
		print("[Gompy ESP] init -> via tag:", gompy_tagCount, "| via name:", gompy_nameCount)

		gompy_conns = {}
		table.insert(gompy_conns, gompy_cs:GetInstanceAddedSignal("ghost"):Connect(function(m)
			if loops["gompy esp"] and (m:IsA("Model") or m:IsA("BasePart")) then gompy_esp_set[m] = true end
		end))
		table.insert(gompy_conns, gompy_cs:GetInstanceRemovedSignal("ghost"):Connect(function(m)
			gompyCleanupEntry(m)
			gompy_esp_set[m] = nil
		end))
		table.insert(gompy_conns, G.Services.Workspace.DescendantAdded:Connect(function(d)
			if loops["gompy esp"] and gompyIsGhostObj(d) then gompy_esp_set[d] = true end
		end))

		if not gompy_loopConn then gompy_loopConn = G.Services.RunService.Heartbeat:Connect(gompyEspLoop) end
	else
		if gompy_loopConn then gompy_loopConn:Disconnect(); gompy_loopConn = nil end
		if gompy_conns then for _, gc in ipairs(gompy_conns) do pcall(function() gc:Disconnect() end) end end
		gompy_conns = {}
		for gompy_g in pairs(gompy_esp_data) do gompyCleanupEntry(gompy_g) end
		gompy_esp_set = {}
		gompy_esp_data = {}
	end
end

