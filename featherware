		pcall(function() if kaliyahThread then task.cancel(kaliyahThread) kaliyahThread = nil end end)
		pcall(function() if autoFishThread then task.cancel(autoFishThread) autoFishThread = nil end end)
		pcall(function() if autoYuziThread then task.cancel(autoYuziThread) autoYuziThread = nil end end)
		pcall(function() if infinitecrystal then task.cancel(infinitecrystal) infinitecrystal = nil end end)
		pcall(function() if breakThread then task.cancel(breakThread) breakThread = nil end end)
		-- HitBoxes
		pcall(hbClearAllHitboxes)
		pcall(hbRestoreRanges)
		if hb_conn then hb_conn:Disconnect() hb_conn = nil end
		-- Shop Tier Bypass
		pcall(function() if ShopTierBypassMechanic then ShopTierBypassMechanic:Toggle(false) end end)
		-- Sprint
		pcall(function()
			if canRequire and SprintController and origStopSprinting then
				SprintConstants.RUN_FOV_MULT = 1.1
				SprintController.stopSprinting = origStopSprinting
				SprintController:stopSprinting(true)
			end
		end)
		-- Gravity
		G.Services.Workspace.Gravity = 196.2
		-- Zoom
		Player.CameraMaxZoomDistance = 14
		-- FOV
		if G.Services.Workspace.CurrentCamera then G.Services.Workspace.CurrentCamera.FieldOfView = 70 end
		-- NoClickDelay
		pcall(function() if originalIsClickingTooFast then sword_controller.isClickingTooFast = originalIsClickingTooFast end end)
		-- BlockCPS
		pcall(function() if canRequire then shared_constants.CpsConstants.BLOCK_PLACE_CPS = 12 end end)
		-- Ping
		pcall(function() if canRequire then shared_constants.PingConstants.PING_COOLDOWN = 2 shared_constants.PingConstants.PING_LIFETIME = 6 end end)
		-- Animations
		pcall(function() if cachedChar and cachedChar:FindFirstChild("Animate") then cachedChar.Animate.Enabled = true end end)
		-- Headless
		pcall(function() if cachedChar and cachedChar:FindFirstChild("Head") then cachedChar.Head.Transparency = 0 end end)
		-- Night
		game.Lighting.ClockTime = 14
		-- RichShader
		pcall(rsApply, false)
		-- Trap Disabler
		if trapConnections then for _, c in pairs(trapConnections) do pcall(function() c:Disconnect() end) end trapConnections = {} end
		-- TrapESP
		pcall(function()
			for _, obj in pairs(G.Services.Workspace:GetDescendants()) do
				if obj.Name == "snap_trap" and obj:IsA("Part") then obj.Transparency = 1 end
			end
		end)
	end)

	-- STEP 4: Destroy GUIs
	pcall(function() if notificationsGui then notificationsGui:Destroy() end end)
	pcall(function() if mainScreenUI then mainScreenUI:Destroy() end end)
	pcall(function() if FW and FW.Destroy then FW:Destroy() end end)
	pcall(function() if moduleGui then moduleGui:Destroy() end end)
	pcall(function()
		local espGui = CoreGui:FindFirstChild("EspScreenGui")
		if espGui then espGui:Destroy() end
	end)
	pcall(function()
		local tsGui = CoreGui:FindFirstChild("TS_PathEditor")
		if tsGui then tsGui:Destroy() end
	end)
	pcall(function()
		for _, desc in ipairs(G.Services.Workspace:GetDescendants()) do
			if desc.Name == "3D_ESP_BOX" or desc.Name == "3D_KA_BOX" or desc.Name == "3D_NUKER_BOX" or desc.Name == "3D_CHEST_BOX" then
				desc:Destroy()
			end
		end
	end)

	_G.__FW_ALL_MODULES = nil
end

