-- The supplied timing helper. The surrounding panel adds confirmed-hit phase tracking.
FWNoModules.ReferenceSwordTiming={
    SafeSpacing=.296,HighSpacing=.2925,HitFloor=.285,GapFloor=.2915,ArrivalFloor=.2747,
    CooldownCorrection=(.017999999225139618/10)+.013412,
}
do
    local ref=FWNoModules.ReferenceSwordTiming
    local weaponSpacing={[.21]=.229,[.25]=.249,[.35]=.345,[.4]=.341,[.6]=.63}
    function ref.Calculate(speed,fury,high,budget,hits)
        local stock=speed==.3
        local normal=high and ref.HighSpacing or ref.SafeSpacing
        local spacing=stock and normal or weaponSpacing[speed]or speed+.03
        if hits and hits~=35 then spacing=math.max(spacing,10/math.max(hits-1,1))end
        spacing=math.max(spacing*fury,budget)
        local scale=spacing/(stock and normal or ref.SafeSpacing)
        local gap=(scale<1 and ref.GapFloor or ref.HitFloor)*scale
        if stock and high then gap=math.max(gap,ref.GapFloor*fury,budget)end
        return spacing,scale,gap,math.max(speed*fury-ref.CooldownCorrection,0),stock
    end
    -- Resolve only the supported balance module. Missing lobby modules do not yield.
    function ref.FuryMultiplier(character)
        if not character or not character:GetAttribute("StatusEffect_fury_potion")then return 1 end
        local balance=ref.balance
        if not balance and not ref.loading then
            local now=os.clock()
            if now>=(ref.retryAt or 0)then
                ref.retryAt=now+5
                local ts=G.Services.RS:FindFirstChild("TS")
                local folder=ts and ts:FindFirstChild("balance")
                local module=folder and folder:FindFirstChild("black-marketeer-balance")
                if module then
                    ref.loading=true
                    FWNoModules.WithSessionOwner(function()task.spawn(function()
                        local ok,result=pcall(require,module)
                        if ok and type(result)=="table"then ref.balance=result.BlackMarketeerBalance end
                        ref.loading=false
                    end)end)
                end
            end
        end
        local multiplier=balance and balance.FURY_POTION_ATTACK_SPEED_MULTIPLIER
        if type(multiplier)=="number"and multiplier==multiplier then return math.clamp(2-multiplier,.05,2)end
        return 1
    end
    local tickSize=1/60
    local drift=.004
    local function finite(n)return type(n)=="number"and n==n and math.abs(n)<math.huge end
    function ref.New()
        local sync={pending={},confirmed={},space=17*tickSize+drift,deadline=nil,stamp=0,search=true,frame=tickSize}
        function sync:Reset(target,weapon)
            self.target=target;self.weapon=weapon
            table.clear(self.pending)
            self.deadline=nil;self.lastSent=nil;self.stamp=0;self.offset=nil;self.search=true
            self.space=17*tickSize+drift;self.lastMatched=nil;self.locked=false
        end
        function sync:Plan(now,serverNow,target,weapon,cooldown,rate,interval,gap,options)
            if target~=self.target or weapon~=self.weapon then self:Reset(target,weapon)end
            local ping=options.ping or math.huge
            local stamp=options.stamp
            local speed=weapon=="frosty_hammer"and .3 or cooldown
            self.locked=false
            if not options.enabled or options.respect or not finite(speed)or speed<=0 then return interval,gap,nil end
            local budget=options.budget or 0
            local fury=options.fury or 1
            local spacing,scale,referenceGap,attackCooldown,stock=ref.Calculate(speed,fury,true,budget)
            interval=math.max(interval,spacing)
            gap=math.max(gap,referenceGap)
            local manualEarliest
            local controllerLast=options.controllerLast
            if finite(controllerLast)and controllerLast~=self.controllerStamp then
                manualEarliest=now+math.max(controllerLast+attackCooldown-serverNow,0)
            end
            -- The reference spins until its deadline. At low FPS, keep the
            -- normal spacing instead of blocking rendering or sending short gaps.
            if stock and fury==1 and rate>=35 and options.confirmations and finite(stamp)and ping<.2 and self.frame<=1/45 then
                self.locked=true
                if not self.deadline and self.lastSent then self.deadline=self.lastSent+self.space end
                local latest=self.pending[#self.pending]
                if latest and not latest.done and now-latest.monotonic>.25+self.frame*2 then
                    latest.done=true;self.stamp=0;self.offset=nil;self.search=true
                    self.space=17*tickSize+drift;self.deadline=latest.monotonic+.3
                end
                if self.deadline and now-self.deadline>.05 then
                    if now-self.deadline<10 then self.deadline+=math.ceil((now-self.deadline)/tickSize)*tickSize
                    else self:Reset(target,weapon);self.locked=true end
                end
                interval=math.max(10/rate,self.space,budget)
                gap=math.max(.25,10/rate*.9,budget)
                local deadline=math.max(self.lastSent and self.lastSent+gap or now,self.deadline or now,manualEarliest or now)
                return interval,gap,deadline
            end
            self.deadline=nil
            return interval,gap,manualEarliest
        end
        function sync:Sent(now,serverNow,target,locked)
            self.lastSent=now;self.controllerStamp=serverNow
            if locked then
                if not self.deadline or math.abs(now-self.deadline)>.05 then self.deadline=now end
                self.deadline+=self.space
            end
            self.pending[#self.pending+1]={target=target,monotonic=now,server=serverNow,done=false,locked=locked}
            while #self.pending>16 or self.pending[1]and now-self.pending[1].monotonic>2 do table.remove(self.pending,1)end
        end
        function sync:Damage(data,localCharacter,now)
            if type(data)~="table"or data.fromEntity~=localCharacter or data.damageType~=0 or not data.entityInstance then return false end
            local target=data.entityInstance
            if target~=self.target then return false end
            local ok,stamp=pcall(target.GetAttribute,target,"LastDamageTakenTime")
            if not ok or not finite(stamp)or stamp<=self.stamp then return false end
            for _,send in ipairs(self.pending)do
                if not send.done and send.target==target and stamp>=send.server-.05 and stamp<=send.server+.24 then
                    send.done=true
                    local previous=self.lastMatched
                    local extra=previous and self.stamp>0 and math.round((stamp-self.stamp)/tickSize)-math.round((send.server-previous.server)/tickSize)or 0
                    local offset=stamp-send.server
                    if send.locked and self.locked then
                        local spike=self.search and extra==1 and self.offset~=nil and(self.offset-drift+tickSize-offset)>.0035
                        self.offset=offset-(self.search and extra>0 and extra*tickSize or 0)
                        if extra==1 and self.search and not spike then
                            self.search=false;self.space=17*tickSize
                            if self.deadline then self.deadline+=tickSize-drift*.5-.0085 end
                        elseif extra>=1 and extra<=45 and self.deadline then
                            self.deadline+=extra*tickSize-(self.search and 0 or .0005)
                        end
                    end
                    self.stamp=stamp;self.lastMatched=send
                    self.confirmed[#self.confirmed+1]=now
                    while #self.confirmed>128 or self.confirmed[1]and now-self.confirmed[1]>=10 do table.remove(self.confirmed,1)end
                    return true
                end
            end
            return false
        end
        return sync
    end
end

-- One monotonic clock for attack pacing and Hit Reg Adjuster admission.
-- This schedules client requests; it does not acknowledge server damage.
FWNoModules.SwordTiming = {}
do
    local timing = FWNoModules.SwordTiming
    local fallbackCooldown = 10 / 35

    local function finite(value)
        return type(value) == "number" and value == value and math.abs(value) < math.huge
    end

    function timing.Period(hitsPer10)
        local rate = tonumber(hitsPer10)
        if not finite(rate) then rate = 35 end
        return 10 / math.clamp(rate, 1, 36)
    end

    function timing.WeaponCooldown(name)
        -- Match the getter used by SwordController instead of assuming .items
        -- exposes every weapon's current metadata.
        if canRequire and ItemMetaModule and type(ItemMetaModule.getItemMeta) == "function" then
            local ok, meta = pcall(ItemMetaModule.getItemMeta, name)
            local speed = ok and type(meta) == "table" and meta.sword and meta.sword.attackSpeed
            if finite(speed) and speed >= 0 then return speed, "getItemMeta" end
        end
        local meta = canRequire and ItemMetaTable and ItemMetaTable[name]
        local speed = meta and meta.sword and meta.sword.attackSpeed
        if finite(speed) and speed >= 0 then return speed, "items table" end
        return fallbackCooldown, "fallback (metadata unavailable)"
    end

    function timing.BufferInfo(name)
        local cooldown=timing.WeaponCooldown(name)
        local constants=canRequire and CombatData and CombatData.SwordsConstants
        local multiplier=constants and constants.swordSwingBufferMultiplier
        if not finite(multiplier)or multiplier<0 then multiplier=.4 end
        local remaining
        if kaSwordController and type(kaSwordController.getRemainingSwingCooldown)=="function"then
            local ok,value=pcall(kaSwordController.getRemainingSwingCooldown,kaSwordController,name)
            if ok and finite(value)then remaining=math.max(0,value)end
        end
        -- The supplied controller uses this admission window, then delays by
        -- (attackSpeed - elapsed) * 1.01. This is not a shorter weapon cooldown.
        return math.min(cooldown*multiplier,.2),remaining,multiplier
    end

    function timing.KillauraDelay(rate,cooldown,respectWeaponCooldown)
        local interval=timing.Period(rate)
        if respectWeaponCooldown then
            if not finite(cooldown)or cooldown<0 then cooldown=fallbackCooldown end
            return math.max(interval,cooldown),cooldown
        end
        -- The selected rate controls the request schedule. Keep its fractional
        -- frame phase; a hard minimum equal to this period would round each
        -- interval up to the next Heartbeat and lower the configured average.
        return interval,interval*.9
    end

    function timing.AdjusterDelay(name, rate)
        local cooldown = timing.WeaponCooldown(name)
        return math.max(timing.Period(rate), cooldown)
    end

    local function recentTimes(list, now)
        local count, first, last, minGap, maxGap = 0, nil, nil, math.huge, 0
        for _, time in ipairs(list) do
            if now - time < 10 then
                if last then minGap = math.min(minGap, time - last); maxGap = math.max(maxGap, time - last) end
                first = first or time
                last = time
                count += 1
            end
        end
        return count, first, last, minGap, maxGap
    end

    local function appendTime(list, now)
        while #list > 0 and now - list[1] >= 10 do table.remove(list, 1) end
        list[#list + 1] = now
        -- Bound diagnostics even if another feature issues unusually many calls.
        if #list > 256 then table.remove(list, 1) end
    end

    function timing.Blocked(now)
        local session = timing.Session
        if session then appendTime(session.BlockedTimes, now) end
    end

    function timing.PrintReport()
        local session = timing.Session
        if not session then print("[Sword timing] Enable Killaura and attack a target first."); return end
        local now = os.clock()
        local count, first, last, minGap, maxGap = recentTimes(session.SentTimes, now)
        local blocked = recentTimes(session.BlockedTimes, now)
        local age = now - session.StartedAt
        local average = count > 1 and (last - first) / (count - 1) or 0
        local cooldown, source = timing.WeaponCooldown(session.Weapon or "")
        local requested = Killaura and Killaura.Values["Hits per 10s"]
        local adjusterOn = loops["hit reg adjuster"] == true
        local adjusterRate = HitRegAdjuster and HitRegAdjuster.Values["Max Hits per 10s"]
        local respect=Killaura and Killaura.Values["Respect Weapon Cooldown"]==true
        local interval = timing.KillauraDelay(requested,cooldown,respect)
        if adjusterOn then interval = math.max(interval, timing.AdjusterDelay(session.Weapon or "", adjusterRate)) end
        if session.EffectiveInterval then interval=session.EffectiveInterval end
        if session.Sync then
            local confirmed=0
            for _,stamp in ipairs(session.Sync.confirmed)do if now-stamp<10 then confirmed+=1 end end
            print(string.format("[Sword timing] Adaptive=%s | Server-tick phase lock=%s | Matched melee damage confirmations in last 10s=%d",tostring(Killaura.Values["Adaptive Hit Timing"]==true),tostring(session.Sync.locked),confirmed))
        end
        print(string.format("[Sword timing] Weapon=%s | Requested=%s/10s | Adjuster=%s (%s/10s)", tostring(session.Weapon or "not resolved"), tostring(requested), tostring(adjusterOn), tostring(adjusterRate)))
        print(string.format("[Sword timing] Cooldown=%.6fs via %s | Effective configured target=%.3f requests/10s | Respect Weapon Cooldown=%s", cooldown, source, 10 / interval,tostring(respect)))
        print(string.format("[Sword timing] Last 10s: Killaura send calls=%d | All locally adjuster-blocked SwordHit calls=%d | Session age=%.2fs", count, blocked, age))
        if count > 1 then print(string.format("[Sword timing] Observed gaps: min=%.6fs avg=%.6fs max=%.6fs", minGap, average, maxGap)) end
        if session.LastPauseReason then print(string.format("[Sword timing] Last local pause=%s | %.2fs ago",session.LastPauseReason,math.max(0,now-session.LastPauseAt)))end
        local window,remaining,multiplier=timing.BufferInfo(session.Weapon or "")
        print(string.format("[Sword timing] Controller buffer window=%.6fs | Multiplier=%.3f | Remaining local cooldown=%s",window,multiplier,remaining and string.format("%.6fs",remaining)or"unavailable"))
        if adjusterOn then print("[Sword timing] Hit Reg Adjuster still enforces its own rate and weapon cooldown. Disable it to test the unrestricted client request schedule.")end
        print("[Sword timing] The request scheduler and the controller's swing buffer are separate. This report does not establish a server-side hit limit.")
        if cooldown>0 and tonumber(requested)and tonumber(requested)>10/cooldown then
            print(string.format("[Sword timing] Requested rate exceeds the weapon metadata rate (%.3f/10s). Server acceptance of faster requests has not been measured.",10/cooldown))
        end
        print("[Sword timing] Send calls are not server-confirmed sword hits. Take this report after at least 10 seconds of continuous attacks.")
    end

    function timing.New()
        local pacer = {LastSent = -math.huge, NextSlot = nil, Interval = nil, Requests = 0, StartedAt = os.clock(), SentTimes = {}, BlockedTimes = {}}

        function pacer:Ready(now, interval, minimumGap, externalEarliest)
            if not finite(now) or not finite(interval) or interval <= 0 then return false end
            minimumGap = math.max(minimumGap or 0, 0)
            if self.Interval ~= interval then
                self.Interval = interval
                self.NextSlot = self.LastSent == -math.huge and now or self.LastSent + interval
            end
            if now - self.NextSlot >= interval then
                -- No stored burst after losing a target, casting, or a long frame.
                self.NextSlot = now
            end
            return now >= self.NextSlot and now - self.LastSent >= minimumGap
                and now >= (externalEarliest or -math.huge)
        end

        function pacer:Pause(reason)
            self.LastPauseReason=reason
            self.LastPauseAt=os.clock()
        end

        function pacer:Commit(now, interval)
            self.LastSent = now
            self.Requests += 1
            appendTime(self.SentTimes, now)
            local nextSlot = (self.NextSlot or now) + interval
            -- Preserve fractional-frame phase instead of rounding every gap up.
            self.NextSlot = nextSlot > now and nextSlot or now + interval
        end

        return pacer
    end
end

