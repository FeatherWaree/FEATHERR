-- Queue System to prevent server throttling and infinite yields
local stealQueue = {} 
local queueActive = false

local function processQueue()
	if queueActive then return end
	queueActive = true

	task.spawn(function()
		while #stealQueue > 0 and loops["chest stealer"] do
			local data = table.remove(stealQueue, 1)
			local inv, item, c = data.inv, data.item, data.c

			-- Ensure the item is still in the chest and the chest exists
			if item and item.Parent == inv and c and c.Parent then
				local root = cachedHRP
				if root then
					-- FIX 2: Final distance check right before stealing
					local dist = (c.Position - root.Position).Magnitude
					local trueRange = tonumber(ChestStealer.Values["Range"]) or 20

					if dist <= trueRange then
						-- FIX 3: Wrap InvokeServer in spawn so server anti-cheat can't hang our loop
						task.spawn(function()
							pcall(function() takeItem:InvokeServer(inv, item) end)
						end)
					end
				end
			end
		end
		queueActive = false
	end)
end

