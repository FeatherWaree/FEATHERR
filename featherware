eldricGetValidTarget = function(maxDist, maxHealthPct)
	myChar = PlayersService.LocalPlayer.Character
	if not myChar then return nil end
	myRoot = myChar:FindFirstChild("HumanoidRootPart")
	if not myRoot then return nil end

	bestTarget = nil
	bestDist = maxDist

	for _, plr in ipairs(FWNoModules.PlayerSnapshot()) do
		if eldricIsEnemy(plr.Character) then
			hum = plr.Character:FindFirstChild("Humanoid")
			eRoot = plr.Character:FindFirstChild("HumanoidRootPart")
			if hum and eRoot and hum.Health > 0 then
				hpPct = (hum.Health / hum.MaxHealth) * 100
				if hpPct <= maxHealthPct then
					dist = (myRoot.Position - eRoot.Position).Magnitude
					if dist < bestDist then
						bestDist = dist
						bestTarget = plr.Character
					end
				end
			end
		end
	end

	if eldricSettings.includeNPCs then
		for _, obj in ipairs(G.Services.Workspace:GetChildren()) do
			if obj:IsA("Model") and not PlayersService:GetPlayerFromCharacter(obj) then
				hum = obj:FindFirstChildOfClass("Humanoid")
				eRoot = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
				if hum and eRoot and hum.Health > 0 then
					hpPct = (hum.Health / hum.MaxHealth) * 100
					if hpPct <= maxHealthPct then
						dist = (myRoot.Position - eRoot.Position).Magnitude
						if dist < bestDist then
							bestDist = dist
							bestTarget = obj
						end
					end
				end
			end
		end
	end

	return bestTarget
end

