	allowedProjs = AutoShoot.Values["Projectiles"] or {"headhunter", "wood_crossbow"}
	table.sort(allowedProjs, function(a, b)
		if a == "headhunter" then return true end
		if b == "headhunter" then return false end
		return a < b
	end)

	for _, projName in ipairs(allowedProjs) do
		projItem = inv:FindFirstChild(projName)
		if projItem and (projItem:GetAttribute("Amount") or 0) > 0 then
			arrowItem = inv:FindFirstChild("wood_arrow") or inv:FindFirstChild("arrow") or inv:FindFirstChild("headhunter_arrow")
			if arrowItem and (arrowItem:GetAttribute("Amount") or 0) > 0 then
