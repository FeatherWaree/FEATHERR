				else
					asp_critInv = aspFindStar("crit_star")
					asp_vitInv = aspFindStar("vitality_star")
					if asp_critInv then asp_typeStr, asp_invItem = "crit_star", asp_critInv
					elseif asp_vitInv then asp_typeStr, asp_invItem = "vitality_star", asp_vitInv end
					if not asp_typeStr then return end
