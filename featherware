function abHeldName()
	ab_c = Player.Character
	if not ab_c then return nil end
	ab_hi = ab_c:FindFirstChild("HandInvItem")
	ab_hv = ab_hi and ab_hi.Value
	if not ab_hv then return nil end
	return (typeof(ab_hv) == "Instance") and ab_hv.Name or tostring(ab_hv)
end

-- the part to use for position + prompt lookup (works whether the hive is a Model OR a bare Part)
function abHivePart(h)
	if h:IsA("BasePart") then return h end
	return h.PrimaryPart or h:FindFirstChildWhichIsA("BasePart")
end

function abIsHiveObj(o)
	if not o then return false end
	if not (o:IsA("BasePart") or o:IsA("Model")) then return false end
	return o.Name:lower():find("beehive") ~= nil
end

function abHoldingBee(hive)
	ab_pr = hive and hive:FindFirstChildOfClass("ProximityPrompt")
	if ab_pr and ab_pr.Enabled then return true end
	ab_n = abHeldName()
	if ab_n then
		ab_nl = ab_n:lower()
		if ab_nl:find("bee") and not ab_nl:find("net") then return true end
	end
	return false
end

function abHiveIsMine(hive)
	ab_uid = hive:GetAttribute("PlacedByUserId") or hive:GetAttribute("PlacedByUserID") or hive:GetAttribute("placedByUserId")
	if ab_uid then
		ab_uidn = tonumber(ab_uid)
		if ab_uidn and ab_uidn == Player.UserId then return true end
		ab_op = ab_uidn and Players:GetPlayerByUserId(ab_uidn) or nil
		if ab_op == Player then return true end
		if ab_op and ab_op.Team and Player.Team and ab_op.Team == Player.Team then return true end
	end
	return false
end

function abFirePickUp(beeId)
	if ab_pickUpRemote then pcall(function() ab_pickUpRemote:FireServer({beeId = beeId}) end) end
end

function abFirePrompt(prompt)
	if not prompt then return end
	if type(fireproximityprompt) == "function" then
		pcall(function() fireproximityprompt(prompt) end)
	else
		pcall(function() prompt:InputHoldBegin() end)
		task.wait(prompt.HoldDuration or 0.2)
		pcall(function() prompt:InputHoldEnd() end)
	end
end

function abPlayCollectSound()
	if SoundManager and GameSound and GameSound.BEE_NET_SWING then
		pcall(function() SoundManager:playSound(GameSound.BEE_NET_SWING) end)
	end
end

function abPlayDepositAnim()
	if ab_animUtil and ab_animType and ab_animType.PUNCH then
		pcall(function() ab_animUtil:playAnimation(Player, ab_animType.PUNCH) end)
	end
end

ab_lastTick = 0
function abLoop()
	if not loops["auto bee"] then return end
	ab_now = os.clock()
	if ab_now - ab_lastTick < 0.2 then return end
	ab_lastTick = ab_now
	pcall(function()
		ab_char = Player.Character
		ab_hrp = ab_char and ab_char:FindFirstChild("HumanoidRootPart")
		ab_hum = ab_char and ab_char:FindFirstChildOfClass("Humanoid")
		if not ab_hrp or not ab_hum or ab_hum.Health <= 0 then return end

		if AutoBee.Values["Collect Bees"] then
			ab_colRange = AutoBee.Values["Collect Range"] or 8
			ab_colHold = AutoBee.Values["Collect Hold Time"] or 0
			ab_reqNet = AutoBee.Values["Require Net Held"]
			for _, ab_bee in ipairs(ab_cs:GetTagged("bee")) do
				if not (ab_beeProc[ab_bee] and ab_now - ab_beeProc[ab_bee] < 0.6) and ab_bee.Parent and (ab_bee:GetAttribute("MaxDistanceFromOrigin") or 6) > 3 then
					ab_bp = ab_bee.PrimaryPart or ab_bee:FindFirstChild("Root") or ab_bee:FindFirstChildWhichIsA("BasePart")
					if ab_bp and (ab_bp.Position - ab_hrp.Position).Magnitude <= ab_colRange then
						ab_netHeldC = (abHeldName() == "bee_net")
						if (not ab_reqNet) or ab_netHeldC then
							ab_beeProc[ab_bee] = ab_now
							ab_mygen = ab_gen
							task.spawn(function()
								task.wait(ab_colHold)
								if ab_mygen == ab_gen and loops["auto bee"] and AutoBee.Values["Collect Bees"] and ab_bee.Parent then
									ab_hrp3 = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
									ab_bp2 = ab_bee.PrimaryPart or ab_bee:FindFirstChild("Root") or ab_bee:FindFirstChildWhichIsA("BasePart")
									ab_netHeldC2 = (abHeldName() == "bee_net")
									ab_reqNet2 = AutoBee.Values["Require Net Held"]
									if ab_hrp3 and ab_bp2 and (ab_bp2.Position - ab_hrp3.Position).Magnitude <= (AutoBee.Values["Collect Range"] or 8) and ((not ab_reqNet2) or ab_netHeldC2) then
										ab_bid = ab_bee:GetAttribute("BeeId")
										if ab_bid then
											abFirePickUp(ab_bid)
											if ab_netHeldC2 then abPlayCollectSound() end
										end
									end
								end
							end)
						end
					end
				end
			end
		end

		if AutoBee.Values["Auto Deposit Bees"] then
			ab_maxBees = AutoBee.Values["Max Bees In Hive"] or 14
			ab_depRange = AutoBee.Values["Deposit Range"] or 6
			ab_depHold = AutoBee.Values["Deposit Hold Time"] or 0
			ab_reqBee = AutoBee.Values["Require Bee Held"]
			ab_anyHive = false
			for ab_hive in pairs(ab_hiveSet) do
				if not ab_hive.Parent then
					ab_hiveSet[ab_hive] = nil
				else
					ab_anyHive = true
					if not (ab_hiveProc[ab_hive] and ab_now - ab_hiveProc[ab_hive] < 0.6) then
						if abHiveIsMine(ab_hive) then
							if (ab_hive:GetAttribute("Level") or 0) < ab_maxBees then
								ab_holdBee = (not ab_reqBee) or abHoldingBee(ab_hive)
								if ab_holdBee then
									ab_hp = abHivePart(ab_hive)
									if ab_hp then
										ab_dist = (ab_hp.Position - ab_hrp.Position).Magnitude
										if ab_dist <= ab_depRange then
											if not ab_firePrinted then
												ab_firePrinted = true
												ab_pr2 = ab_hive:FindFirstChildOfClass("ProximityPrompt")
												print("[AutoBee] DEPOSIT attempt ->", ab_hive.Name, "| isPart:", ab_hive:IsA("BasePart"), "| prompt:", ab_pr2 ~= nil, "| enabled:", ab_pr2 and ab_pr2.Enabled, "| held:", tostring(abHeldName()), "| dist:", math.floor(ab_dist), "| level:", ab_hive:GetAttribute("Level"))
											end
											ab_hiveProc[ab_hive] = ab_now
											ab_mygen2 = ab_gen
											task.spawn(function()
												task.wait(ab_depHold)
												if ab_mygen2 == ab_gen and loops["auto bee"] and AutoBee.Values["Auto Deposit Bees"] and ab_hive.Parent and abHiveIsMine(ab_hive) then
													ab_hrp2 = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
													ab_hp2 = abHivePart(ab_hive)
													ab_holdBee2 = (not AutoBee.Values["Require Bee Held"]) or abHoldingBee(ab_hive)
													if ab_hrp2 and ab_hp2 and (ab_hive:GetAttribute("Level") or 0) < (AutoBee.Values["Max Bees In Hive"] or 14) and ab_holdBee2 and (ab_hp2.Position - ab_hrp2.Position).Magnitude <= (AutoBee.Values["Deposit Range"] or 6) then
														abFirePrompt(ab_hive:FindFirstChildOfClass("ProximityPrompt"))
														if AutoBee.Values["Use Deposit Animation"] then abPlayDepositAnim() end
													end
												end
											end)
										end
									end
								end
							end
						elseif not ab_ownerPrinted then
							ab_ownerPrinted = true
							ab_u = ab_hive:GetAttribute("PlacedByUserId") or ab_hive:GetAttribute("PlacedByUserID")
							print("[AutoBee] hive found but NOT owned by you -> owner uid attr:", tostring(ab_u), "| your uid:", Player.UserId, "| your team:", tostring(Player.Team))
						end
					end
				end
			end
			if not ab_anyHive and not ab_diagInit then
				ab_diagInit = true
				print("[AutoBee] NO hives in tracked set yet (waiting on spawn signals)")
			end
		end
	end)
end

AutoBee.Callbacks.OnToggle = function(state)
	loops["auto bee"] = state
	if state then
		ab_beeProc = {}; ab_hiveProc = {}; ab_hiveSet = {}; ab_lastTick = 0
		ab_diagInit = false; ab_firePrinted = false; ab_ownerPrinted = false
		ab_tagCount = 0
		for _, ab_h in ipairs(ab_cs:GetTagged("beehive")) do
			if ab_h:IsA("Model") or ab_h:IsA("BasePart") then ab_hiveSet[ab_h] = true; ab_tagCount = ab_tagCount + 1 end
		end
		ab_nameCount = 0
		pcall(function()
			for _, ab_d in ipairs(G.Services.Workspace:GetDescendants()) do
				if abIsHiveObj(ab_d) and not ab_hiveSet[ab_d] then
					ab_hiveSet[ab_d] = true; ab_nameCount = ab_nameCount + 1
				end
			end
		end)
		print("[AutoBee] init hives -> via tag:", ab_tagCount, "| via name search:", ab_nameCount, "| total tracked:", (function() local n=0 for _ in pairs(ab_hiveSet) do n=n+1 end return n end)())

		ab_conns = {}
		table.insert(ab_conns, ab_cs:GetInstanceAddedSignal("beehive"):Connect(function(m)
			if loops["auto bee"] and (m:IsA("Model") or m:IsA("BasePart")) then ab_hiveSet[m] = true end
		end))
		table.insert(ab_conns, ab_cs:GetInstanceRemovedSignal("beehive"):Connect(function(m)
			ab_hiveSet[m] = nil; ab_hiveProc[m] = nil
		end))
		table.insert(ab_conns, G.Services.Workspace.DescendantAdded:Connect(function(d)
			if loops["auto bee"] and abIsHiveObj(d) then ab_hiveSet[d] = true end
		end))

		if not ab_loopConn then ab_loopConn = G.Services.RunService.Heartbeat:Connect(abLoop) end
	else
		if ab_loopConn then ab_loopConn:Disconnect(); ab_loopConn = nil end
		if ab_conns then for _, ab_c in ipairs(ab_conns) do pcall(function() ab_c:Disconnect() end) end end
		ab_conns = {}
		ab_beeProc = {}; ab_hiveProc = {}; ab_hiveSet = {}
	end
end
