-- 4. Core Logic: Check distance to cached positions and fire the real UUID
styxTryOpen = function()
	if not loops["auto styx"] then return end

	now = os.clock()
	if now - styxData.lastFire < 0.5 then return end -- Anti-spam cooldown

	myChar = Players.LocalPlayer.Character
	if not myChar then return end
	myRoot = myChar:FindFirstChild("HumanoidRootPart")
	if not myRoot then return end

	myPos = myRoot.Position
	maxRange = styxSettings.range or 20

	for uuid, data in pairs(styxData.cachedPortals) do
		-- Clean up old cache (portals despawn after some time)
		if tick() - data.time > 60 then
			styxData.cachedPortals[uuid] = nil
			continue
		end

		dist = (data.pos - myPos).Magnitude
		if dist <= maxRange then
			if styxData.tryRemote then
				styxData.lastFire = now
				print("[Auto Styx] Firing remote with REAL UUID:", uuid, "| Dist:", math.floor(dist))
				task.wait(styxSettings.delay)
				pcall(function()
					styxData.tryRemote:InvokeServer(uuid)
				end)
			end
		end
	end
end

