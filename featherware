            local group = addons.FavouriteGroup
            local orderRow = {Frame = row, ID = entry.ID, Sequence = #group.Rows + 1}
            table.insert(group.Rows, orderRow)
            addons.DragHandle(head, orderRow, group, true)
            addons.Order(group)
        end
        addons.RefreshEntry(entry)
        return proxy
    end

    function addons.Refresh()
        if dead then return end
        local query = addons.Query()
        local count, favouriteCount = 0, 0
        for index, entry in ipairs(addons.Modules) do
            if entry.Mod and favourites[entry.ID] then
                if not entry.FavouriteProxy then
                    entry.FavouriteProxy = addons.Proxy(entry, addons.FavouriteCategory.Scroll, true)
                end
                entry.FavouriteProxy.Frame.Visible = true
                favouriteCount += 1
            elseif entry.FavouriteProxy then entry.FavouriteProxy.Frame.Visible = false end
            local show = query ~= "" and matches(settingNames(entry), query)
            if show and not entry.SearchProxy then entry.SearchProxy = addons.Proxy(entry, resultScroll, false) end
            if entry.SearchProxy then
                if not show and entry.Settings.Parent == entry.SearchProxy.Frame then addons.ReturnSettings(entry) end
                entry.SearchProxy.Frame.Visible = show
                entry.SearchProxy.Frame.LayoutOrder = index

            end
            if show then count += 1 end
        end
        emptyResults.Visible = count == 0
        updateSearchVisibility()
        if addons.FavouriteEmpty then addons.FavouriteEmpty.Visible = favouriteCount == 0 end
    end

    function addons.QueueRefresh()
        if refreshQueued or dead then return end
        refreshQueued = true
        task.defer(function() refreshQueued = false; addons.Refresh() end)
    end

    connect(searchBox:GetPropertyChangedSignal("Text"), function()
        searchVersion += 1
        local version = searchVersion
        task.delay(0.12, function()
            if dead or version ~= searchVersion then return end
            updateSearchVisibility()
            mainScroll.CanvasPosition = Vector2.zero
            addons.Refresh()
        end)
    end)
    connect(searchBox.Focused, function()
        if addons.Query() ~= "" then updateSearchVisibility(); addons.QueueRefresh() end
    end)
    connect(closeSearch.Activated, FWNoModules.Mobile.Activation(function() searchBox.Text = ""; updateSearchVisibility() end))

    function addons.RegisterCategory(category, name, catButton, frame, scroll, layout)
        minWidth(frame, 240)
        scroll.CanvasSize = UDim2.new()
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        local record = {Name = name, Button = catButton, Frame = frame, Scroll = scroll}
        category.MenuRecord = record
        addons.Categories[name] = record
        local row = {Frame = catButton, ID = name, Sequence = #categoryGroup.Rows + 1}
        table.insert(categoryGroup.Rows, row)
        addons.Order(categoryGroup)
        addons.DragHandle(catButton, row, categoryGroup, false)
        record.Group = {Key = "Buttons_" .. name, Rows = {}, Scroll = scroll}
        if name == "Favourites" then
            addons.FavouriteCategory = record
            addons.FavouriteGroup = record.Group
            local empty = FWNoModules.OwnInstance(Instance.new("TextLabel", scroll))
            empty.Size = UDim2.new(1, -12, 0, 72)
            empty.Text = "Click ☆ beside a button\nto add it here.\nDrag ≡ to change the order."
            empty.TextColor3 = Color3.fromRGB(170, 170, 170)
            empty.TextSize = 16
            empty.TextWrapped = true
            empty.BackgroundTransparency = 1
            empty.LayoutOrder = 100000
            addons.FavouriteEmpty = empty
        end
        connect(frame:GetPropertyChangedSignal("Visible"), function()
            if frame.Visible then
                topZIndex = topZIndex + 1
                frame.ZIndex = topZIndex
            else
                if activeDrag and activeDrag.Group == record.Group then stopDrag(true) end
                if name == "Favourites" then
                    for _, entry in ipairs(addons.Modules) do
                        if entry.FavouriteProxy and entry.Settings.Parent == entry.FavouriteProxy.Frame then
                            addons.ReturnSettings(entry)
                        end
                    end
                end
            end
        end)
    end

    function addons.RegisterModule(category, name, mod, container, btn, settings, arrow, label, activate)
        local record = category.MenuRecord
        local entry = {
            ID = record.Name .. "/" .. name, Name = name, CategoryName = record.Name,
            Mod = mod, Home = container, Button = btn, Settings = settings, Arrow = arrow,
            Proxies = {}, Activate = activate,
        }
        table.insert(addons.Modules, entry)
        mod.MenuEntry = entry
        FWNoModules.RegisterTooltip(entry,btn)
        local star = button(btn, "☆", 34, 154)
        star.Name = "FavouriteStar"
        entry.Star = star
        connect(star.Activated, FWNoModules.Mobile.Activation(function() addons.ToggleFavourite(entry) end))
        local row = {Frame = container, ID = entry.ID, Sequence = #record.Group.Rows + 1}
        table.insert(record.Group.Rows, row)
        addons.Order(record.Group)
        addons.DragHandle(btn, row, record.Group, true)
        connect(label:GetPropertyChangedSignal("TextColor3"), function() addons.RefreshEntry(entry) end)
        connect(settings.ChildAdded, addons.QueueRefresh)
        addons.RefreshEntry(entry)
        addons.QueueRefresh()
        return entry
    end

    -- The main settings overlay is indexed alongside individual module settings.
    local coreEntry = {ID = "Menu/Settings", Name = "Menu Settings", CategoryName = "Settings", Settings = overlayScroll, Proxies = {}}
    coreEntry.Open = function(query)
        overlayFrame.Visible = true
        mainScroll.Visible = false
        jumpToSetting(coreEntry, query or "", overlayScroll)
    end
    table.insert(addons.Modules, coreEntry)
    connect(overlayScroll.ChildAdded, addons.QueueRefresh)
    connect(mainScreenUI.Destroying, function()
        stopDrag(false)
        dead = true
        for _, connection in ipairs(addons.Connections) do connection:Disconnect() end
        table.clear(addons.Connections)
    end)
end


function FW:CreateCategory(name)
	local category = {}

	local catVisID = name .. "_CategoryVisibility"
	local catPosID = name .. "_CategoryPosition"

	local catBtn = FWNoModules.OwnInstance(Instance.new("TextButton", mainScroll))
	catBtn.Name = name
	catBtn.Text = "  " .. name
	catBtn.Size = UDim2.new(1, 0, 0, 32)
	catBtn.BackgroundColor3 = Color3.fromRGB(39, 39, 39)
	catBtn.BackgroundTransparency = 1
	catBtn.TextColor3 = Color3.new(1, 1, 1)
	catBtn.FontFace = Font.fromName(textFont)
	catBtn.TextSize = 24
	catBtn.TextXAlignment = Enum.TextXAlignment.Left
	catBtn.BorderSizePixel = 0
	catBtn.LayoutOrder = lastSort

	lastSort += 1

	FWNoModules.Connect(catBtn.MouseEnter, function() tween(catBtn, {BackgroundTransparency = 0}) end)
	FWNoModules.Connect(catBtn.MouseLeave, function() tween(catBtn, {BackgroundTransparency = 1}) end)

	local savedVisibility = _G.SavedConfig[catVisID] or false

	local frame = FWNoModules.OwnInstance(Instance.new("Frame", mainScreenUI))
	frame.Name = name .. "Frame"
	frame.Size = UDim2.new(0.12, 0, 0.55, 0)

	if _G.SavedConfig[catPosID] ~= nil then
		local posData = _G.SavedConfig[catPosID]
		frame.Position = UDim2.new(posData.XS, posData.XO, posData.YS, posData.YO)
	else
		frame.Position = UDim2.new(0.25, 0, 0.1, 0)
	end

	frame.BackgroundColor3 = Color3.fromRGB(26, 26, 26)
	frame.BorderSizePixel = 0
	frame.Visible = savedVisibility
	catBtn.TextColor3 = savedVisibility and Color3.fromRGB(78, 173, 73) or Color3.new(1, 1, 1)

	uiCorner(frame, 8)
	makeDraggable(frame)

	FWNoModules.OwnInstance(glow:Clone()).Parent = frame
	FWNoModules.OwnInstance(uiStroke:Clone()).Parent = frame

	local fTitleFrame = FWNoModules.OwnInstance(titleFrame:Clone())
	fTitleFrame.Parent = frame
	fTitleFrame:ClearAllChildren()
	uiCorner(fTitleFrame, 8)

	local fTitleBottomHider = FWNoModules.OwnInstance(titleBottomHider:Clone())
	fTitleBottomHider.Parent = fTitleFrame

	local fTitle = FWNoModules.OwnInstance(title:Clone())
	fTitle.Parent = fTitleFrame
	fTitle.Text = name
	fTitle.Position = UDim2.new(0, 15, 0, 0)
	fTitle.Size = UDim2.new(1, -15, 1, 0)

	local fScroll = FWNoModules.OwnInstance(Instance.new("ScrollingFrame", frame))
	fScroll.Size = UDim2.new(1, 0, 1, -45)
	fScroll.Position = UDim2.new(0, 0, 0, 40)
	fScroll.BackgroundTransparency = 1
	fScroll.ScrollBarThickness = 0
	fScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	local fLayout = FWNoModules.OwnInstance(Instance.new("UIListLayout", fScroll))
	fLayout.Padding = UDim.new(0, 2)

	FWNoModules.Connect(catBtn.Activated, FWNoModules.Mobile.Activation(function()
		frame.Visible = not frame.Visible
		catBtn.TextColor3 = frame.Visible and Color3.fromRGB(78, 173, 73) or Color3.new(1, 1, 1)

		_G.SavedConfig[catVisID] = frame.Visible
		saveConfigToPC()
	end))

	FWNoModules.Connect(frame:GetPropertyChangedSignal("Position"), function()
		local currentPos = frame.Position
		_G.SavedConfig[catPosID] = {
			XS = currentPos.X.Scale,
			XO = currentPos.X.Offset,
			YS = currentPos.Y.Scale,
			YO = currentPos.Y.Offset
		}
		saveConfigToPC()
	end)

	function category:CreateButton(btnName, callback, allowHotkey, ClosetButton)
		local toggleID = name .. "_" .. btnName .. "_MainToggle"
		local hotkeyID = name .. "_" .. btnName .. "_Hotkey"

		local startingToggleState = _G.SavedConfig[toggleID] or false
		_G.SavedConfig[toggleID] = startingToggleState

		local mod = {
			Toggled = startingToggleState,
			Values = {},
			Callbacks = {},
			UpdateFunctions = {}
		}
		_G.__FW_ALL_MODULES = _G.__FW_ALL_MODULES or {}
		table.insert(_G.__FW_ALL_MODULES, mod)

		local container = FWNoModules.OwnInstance(Instance.new("Frame", fScroll))
		container.Size = UDim2.new(1, 0, 0, 32)
		container.BackgroundTransparency = 1
		container.AutomaticSize = Enum.AutomaticSize.Y
		local cLayout = FWNoModules.OwnInstance(Instance.new("UIListLayout", container))
		cLayout.SortOrder = Enum.SortOrder.LayoutOrder

		local btn = FWNoModules.OwnInstance(Instance.new("TextButton", container))
		btn.Name = btnName
		btn.Text = "" 
		btn.Size = UDim2.new(1, 0, 0, 32)
		btn.BackgroundColor3 = Color3.fromRGB(39, 39, 39)
		btn.BackgroundTransparency = 1
		btn.LayoutOrder = 1

		FWNoModules.SetLoop(string.lower(btnName), startingToggleState)

		-- INSTANTLY UPDATE MODULE LIST ON INJECTION
		if _G.__FW_REFRESH_MODULE_LIST then
			_G.__FW_REFRESH_MODULE_LIST()
		end

		local leftContainer = FWNoModules.OwnInstance(Instance.new("Frame", btn))
        leftContainer.Name = "ButtonContent"
		leftContainer.Position = UDim2.new(0, 20, 0, 0)
		leftContainer.Size = UDim2.new(1, -174, 1, 0)
		leftContainer.BackgroundTransparency = 1

		local leftPadding = FWNoModules.OwnInstance(Instance.new("UIPadding", leftContainer))
		leftPadding.PaddingLeft = UDim.new(0, 4)

		local listLayout = FWNoModules.OwnInstance(Instance.new("UIListLayout", leftContainer))
		listLayout.FillDirection = Enum.FillDirection.Horizontal
		listLayout.VerticalAlignment = Enum.VerticalAlignment.Center
		listLayout.SortOrder = Enum.SortOrder.LayoutOrder
		listLayout.Padding = UDim.new(0, 8)

		local nameScroll = FWNoModules.OwnInstance(Instance.new("ScrollingFrame", leftContainer))
        nameScroll.Name = "ButtonNameScroll"
		nameScroll.BackgroundTransparency = 1
		nameScroll.ScrollBarThickness = 0
		nameScroll.ClipsDescendants = true
		nameScroll.Active = false
		nameScroll.LayoutOrder = 1

		local nameLabel = FWNoModules.OwnInstance(Instance.new("TextLabel", nameScroll))
        nameLabel.Name = "ButtonName"
		nameLabel.Text = btnName
		nameLabel.Size = UDim2.new(0, 0, 1, 0)
		nameLabel.AutomaticSize = Enum.AutomaticSize.X
		nameLabel.BackgroundTransparency = 1
		nameLabel.TextYAlignment = Enum.TextYAlignment.Center 
		nameLabel.TextColor3 = startingToggleState and Color3.fromRGB(78, 173, 73) or Color3.new(1, 1, 1)
		nameLabel.FontFace = Font.fromName(textFont)
		nameLabel.TextSize = 22

		local closetDecision = ClosetButton == true
		local closetBtn

		if closetDecision then
			closetBtn = FWNoModules.OwnInstance(Instance.new("TextButton"))
			closetBtn.Parent = leftContainer
			closetBtn.Name = "ClosetBtn"
			closetBtn.Size = UDim2.new(0, 52, 0, 18)
			closetBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
			closetBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
			closetBtn.Text = "CLOSET"
			closetBtn.FontFace = Font.fromName(textFont)
			closetBtn.TextSize = 10
			closetBtn.LayoutOrder = 2

			FWNoModules.OwnInstance(Instance.new("UICorner", closetBtn)).CornerRadius = UDim.new(0, 4)

			local stroke = FWNoModules.OwnInstance(Instance.new("UIStroke", closetBtn))
			stroke.Color = Color3.fromRGB(70, 70, 70)
			stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		end

		local function updateLayout()
			local textWidth = nameLabel.TextBounds.X
			local maxTextWidth = leftContainer.AbsoluteSize.X

			if closetBtn then
				maxTextWidth -= closetBtn.AbsoluteSize.X + listLayout.Padding.Offset
			end

			maxTextWidth = math.max(0, maxTextWidth)
			if textWidth <= maxTextWidth then
				nameScroll.Size = UDim2.new(0, textWidth, 1, 0)
			else
				nameScroll.Size = UDim2.new(0, maxTextWidth, 1, 0)
			end
			nameScroll.CanvasSize = UDim2.new(0, textWidth, 0, 0)
		end

		FWNoModules.Connect(nameLabel:GetPropertyChangedSignal("TextBounds"), updateLayout)
		FWNoModules.Connect(leftContainer:GetPropertyChangedSignal("AbsoluteSize"), updateLayout)
		task.defer(updateLayout)

		local isHovering = false
		FWNoModules.Connect(btn.MouseEnter, function()
			isHovering = true
			tween(btn, {BackgroundTransparency = 0})

			if nameScroll.CanvasSize.X.Offset > nameScroll.AbsoluteSize.X then
				task.spawn(function()
					while isHovering do
						local maxScroll = nameScroll.CanvasSize.X.Offset - nameScroll.AbsoluteSize.X + 10
						tween(nameScroll, {CanvasPosition = Vector2.new(maxScroll, 0)}, 2)
						task.wait(2.5)
						if not isHovering then break end
						tween(nameScroll, {CanvasPosition = Vector2.new(0, 0)}, 1)
						task.wait(1)
					end
				end)
			end
		end)

		FWNoModules.Connect(btn.MouseLeave, function()
			isHovering = false
			tween(btn, {BackgroundTransparency = 1})
			tween(nameScroll, {CanvasPosition = Vector2.new(0, 0)}, 0.2)
		end)

        local function setToggleState(state)
            FWNoModules.Profiles.TouchBinding(toggleID)
			if mainScreenUI and mainScreenUI:GetAttribute("Running") then
				mod.Toggled = state
				nameLabel.TextColor3 = state and Color3.fromRGB(78, 173, 73) or Color3.new(1, 1, 1)
				FWNoModules.SetLoop(string.lower(btnName), state)

				-- INSTANTLY UPDATE MODULE LIST (Event-Driven)
				if _G.__FW_REFRESH_MODULE_LIST then
					_G.__FW_REFRESH_MODULE_LIST()
				end

				pcall(NotificationSystem.Notify, btnName, state and "Toggled On" or "Toggled Off", 2)

				_G.SavedConfig[toggleID] = state
				pcall(saveConfigToPC)

				task.spawn(function()
                    FWNoModules.RunModuleCallbacks(mod,callback,state)
				end)
			end
		end

        mod.ProfileStartupTask=task.spawn(function()
            if startingToggleState then
				if not game:IsLoaded() then game.Loaded:Wait() end
                -- These utility features need no avatar. Other features keep their spawn setup.
                if btnName ~= "Anti AFK" and btnName ~= "Spectate" then
                    local char = Player.Character or Player.CharacterAdded:Wait()
                    if not char:FindFirstChild("HumanoidRootPart") then
                        char:WaitForChild("HumanoidRootPart", 5)
                    end
                    task.wait(0.5)
                end
                if not FWNoModules.Runtime.active or not mod.Toggled then return end
                FWNoModules.RunModuleCallbacks(mod,callback,true)
			end
		end)

		local arrow = FWNoModules.OwnInstance(Instance.new("TextButton", btn))
        arrow.Name = "SettingsArrow"
		arrow.Text = "<b>></b>"
		arrow.RichText = true
		arrow.Size = UDim2.new(0, 30, 1, 0)
		arrow.Position = UDim2.new(1, -30, 0, 0)
		arrow.BackgroundTransparency = 1
		arrow.TextColor3 = Color3.fromRGB(130, 130, 130)
		arrow.FontFace = Font.fromName(textFont)
		arrow.TextSize = 20

        if allowHotkey then
            local bindings=FWNoModules.Bindings
            local bindLabel=FWNoModules.OwnInstance(Instance.new("TextButton",btn))
            bindLabel.Name="Hotkey";mod.MenuBindLabel=bindLabel
            bindLabel.Size=UDim2.new(0,70,1,0);bindLabel.Position=UDim2.new(1,-110,0,0)
            bindLabel.BackgroundTransparency=1;bindLabel.TextColor3=Color3.fromRGB(120,120,120)
            bindLabel.FontFace=Font.fromName(textFont);bindLabel.TextSize=12;bindLabel.TextTruncate=Enum.TextTruncate.AtEnd;bindLabel.TextScaled=true
            local bindTextSize=FWNoModules.OwnInstance(Instance.new("UITextSizeConstraint",bindLabel))
            bindTextSize.MinTextSize=8;bindTextSize.MaxTextSize=12
            local function label()
                local binding=FWNoModules.Profiles.Value(_G.SavedConfig[hotkeyID])
                bindLabel.Text="["..bindings.Format(binding).."]"
            end
            local function set(value)
                _G.SavedConfig[hotkeyID]=bindings.Value(value)or FWNoModules.Profiles.Nil
                label()
            end
            FWNoModules.Profiles.Register(hotkeyID,function()return FWNoModules.Profiles.Value(_G.SavedConfig[hotkeyID])end,set,nil,"hotkey")
            FWNoModules.Mobile.RegisterKey(hotkeyID,btnName,function()return FWNoModules.Profiles.Value(_G.SavedConfig[hotkeyID])end)
            _G.__FW_PANIC_REG=_G.__FW_PANIC_REG or{}
            _G.__FW_PANIC_REG[btnName]=_G.__FW_PANIC_REG[btnName]or{}
            _G.__FW_PANIC_REG[btnName].resetKey=function()set(nil);saveConfigToPC()end
            local function handle(input)
                if input.UserInputType==Enum.UserInputType.MouseButton2 then set(nil);saveConfigToPC();return end
                if input.UserInputType~=Enum.UserInputType.MouseButton1 and not FWNoModules.Mobile.IsTouchInput(input)then return end
                bindings.Capture(btnName,input,function(value)
                    FWNoModules.Profiles.TouchBinding(hotkeyID);set(value);saveConfigToPC()
                end,function(text)bindLabel.Text="["..text.."]"end,label)
            end
            mod.MenuHotkeyInput=handle
            FWNoModules.Connect(bindLabel.InputBegan,handle)
            bindings.Register(function()return FWNoModules.Profiles.Value(_G.SavedConfig[hotkeyID])end,function()
                if mainScreenUI and mainScreenUI:GetAttribute("Running")==true then setToggleState(not mod.Toggled)end
            end)
            label()
        end


		local settingsCont = FWNoModules.OwnInstance(Instance.new("Frame", container))
		settingsCont.Size = UDim2.new(1, 0, 0, 0)
		settingsCont.BackgroundTransparency = 1
		settingsCont.Visible = false
		settingsCont.AutomaticSize = Enum.AutomaticSize.Y
		settingsCont.LayoutOrder = 2
		local sLayout = FWNoModules.OwnInstance(Instance.new("UIListLayout", settingsCont))
		sLayout.SortOrder = Enum.SortOrder.LayoutOrder

		FWNoModules.Connect(btn.Activated, FWNoModules.Mobile.Activation(function()
			if _G.__FW_NO_TOGGLE and _G.__FW_NO_TOGGLE[btnName] then return end
			setToggleState(not mod.Toggled)
		end))

		FWNoModules.Connect(arrow.Activated, FWNoModules.Mobile.Activation(function()
			if #settingsCont:GetChildren() == 1 then
				NotificationSystem.Notify("Settings", "None are available sorry!", 1)
			else
				FW.MenuAddons.OpenSettings(mod.MenuEntry, container, arrow, fScroll, "")
			end
		end))

		if closetBtn then
            mod.ApplyCloset = function()
				local BTTNsettings = closetSettings[string.lower(btnName)]
				if not BTTNsettings then return end

				for key, value in pairs(BTTNsettings) do
					if mod.UpdateFunctions[key] then
						mod.UpdateFunctions[key](value)
					else
						mod.Values[key] = value
					end
				end
                print("Applied CLOSET settings for:", btnName)
            end
            FWNoModules.Connect(closetBtn.Activated, FWNoModules.Mobile.Activation(mod.ApplyCloset))
		end

		injectElements(mod, settingsCont, name .. "_" .. btnName)

        function mod:SetState(state)
            setToggleState(state)
        end
        mod.ProfileToggleKey=toggleID
        mod.ProfileLoopKey=string.lower(btnName)
        function mod:SetProfileState(state)
            local wasEnabled=self.Toggled
            self.Toggled=state==true
            nameLabel.TextColor3=self.Toggled and Color3.fromRGB(78,173,73)or Color3.new(1,1,1)
            FWNoModules.SetLoop(string.lower(btnName),self.Toggled)
            _G.SavedConfig[toggleID]=self.Toggled
            if wasEnabled==self.Toggled and not self.ProfilePending then return end
            self.ProfilePending=nil
            local ok,problem=FWNoModules.RunModuleCallbacks(self,callback,self.Toggled)
            if not ok then error(problem,0)end
        end
        FWNoModules.Profiles.Register(toggleID,function()return mod.Toggled end,function(v)mod:SetProfileState(v)end,mod,"module")
        function mod:StopForUnload()
            if not self.Toggled then return end
            self.Toggled = false
            FWNoModules.SetLoop(string.lower(btnName), false)
            FWNoModules.RunModuleCallbacks(self,callback,false)
        end

		_G.__FW_PANIC_REG = _G.__FW_PANIC_REG or {}
		if not (_G.__FW_NO_TOGGLE and _G.__FW_NO_TOGGLE[btnName]) then
			_G.__FW_PANIC_REG[btnName] = _G.__FW_PANIC_REG[btnName] or {}
			_G.__FW_PANIC_REG[btnName].off = function()
				if not (mainScreenUI and mainScreenUI:GetAttribute("Running")) then return end
				if mod.Toggled == false then return end
				mod.Toggled = false
				nameLabel.TextColor3 = Color3.new(1, 1, 1)
				FWNoModules.SetLoop(string.lower(btnName), false)

				-- INSTANTLY UPDATE MODULE LIST
				if _G.__FW_REFRESH_MODULE_LIST then
					_G.__FW_REFRESH_MODULE_LIST()
				end

				_G.SavedConfig[toggleID] = false
				pcall(saveConfigToPC)
				task.spawn(function()
                    FWNoModules.RunModuleCallbacks(mod,callback,false)
				end)
			end
		end
		_G.__FW_ACTION_CLICK = _G.__FW_ACTION_CLICK or {}
		mod.MenuActionCallbacks = {}
		_G.__FW_ACTION_CLICK[btnName] = function(fn)
			local connection = FWNoModules.Connect(btn.Activated, FWNoModules.Mobile.Activation(fn))
			table.insert(mod.MenuActionCallbacks, {Callback = fn, Connection = connection})
			return connection
		end

		FW.MenuAddons.RegisterModule(category, btnName, mod, container, btn, settingsCont, arrow, nameLabel, function()
			if not (_G.__FW_NO_TOGGLE and _G.__FW_NO_TOGGLE[btnName]) then
				setToggleState(not mod.Toggled)
			end
			for _, action in ipairs(mod.MenuActionCallbacks) do
				if action.Connection.Connected then task.spawn(action.Callback) end
			end
		end)

		return mod
	end

    FWNoModules.Profiles.Register(catVisID,function()return frame.Visible end,function(v)
        frame.Visible=v==true;catBtn.TextColor3=frame.Visible and Color3.fromRGB(78,173,73)or Color3.new(1,1,1)
    end,nil,"custom")
    FWNoModules.Profiles.Register(catPosID,function()local p=frame.Position;return {XS=p.X.Scale,XO=p.X.Offset,YS=p.Y.Scale,YO=p.Y.Offset}end,function(v)
        if v then frame.Position=UDim2.new(v.XS,v.XO,v.YS,v.YO)end
    end,nil,"custom")
    FW.MenuAddons.RegisterCategory(category, name, catBtn, frame, fScroll, fLayout)
	return category
end

