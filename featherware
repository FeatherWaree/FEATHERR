function getNetManaged()
	if netManaged then return netManaged end
	pcall(function()
		rep = G.Services.RS
		include = rep:WaitForChild("rbxts_include", 1)
		if not include then return end
		nodeModules = include:WaitForChild("node_modules", 1)
		if not nodeModules then return end
		rbxts = nodeModules:WaitForChild("@rbxts", 1)
		if not rbxts then return end
		net = rbxts:WaitForChild("net", 1)
		if not net then return end
		out = net:WaitForChild("out", 1)
		if not out then return end
		netManaged = out:WaitForChild("_NetManaged", 1)
	end)
	return netManaged
end

