            if ok and state.alive and state.players[player.UserId] == row and row.avatar.Parent then row.avatar.Image = image end
        end)
        return row
    end

    state.refresh = function()
        if not state.alive or not state.gui.Enabled then return end
        local options = PlayerDisplay.Values
        local active, counts, included = {}, {}, {}
        for _, player in ipairs(FWNoModules.PlayerSnapshot()) do
            local ownTeam = player == Player or (Player.Team ~= nil and player.Team == Player.Team)
            if options["Include Own Team"] or not ownTeam then included[#included + 1] = player end
        end
        table.sort(included, function(a, b)
            local left, right = string.lower(a.DisplayName or a.Name), string.lower(b.DisplayName or b.Name)
            return left == right and a.UserId < b.UserId or left < right
        end)
        for index, player in ipairs(included) do
            active[player.UserId] = true
            local group = teamGroup(player.Team)
            counts[group] = (counts[group] or 0) + 1
            local row = state.players[player.UserId] or playerRow(player)
            row.frame.Parent, row.frame.LayoutOrder = group.rows, index
            row.marker.BackgroundColor3 = group.color
            row.name.Text, row.username.Text = player.DisplayName or player.Name, "@" .. player.Name
            local details = {}
            local level, clan = player:GetAttribute("PlayerLevel"), player:GetAttribute("ClanTag")
            if options["Include Levels"] and level ~= nil then details[#details + 1] = "Lvl " .. tostring(level) end
            if options["Include Clans"] and type(clan) == "string" and clan ~= "" then details[#details + 1] = "[" .. clan .. "]" end
            row.details.Text = table.concat(details, "  ·  ")
            local kitName = player:GetAttribute("PlayingAsKit") or player:GetAttribute("PlayingAsKits") or ""
            local meta
            if kitName ~= "" and state.kitMeta and type(state.kitMeta.getBedwarsKitMeta) == "function" then
                local ok, result = pcall(state.kitMeta.getBedwarsKitMeta, kitName)
                if ok and type(result) == "table" then meta = result end
            end
            local image = meta and meta.renderImage
            local showImage = options["Show Kit Image"] and type(image) == "string" and image ~= ""
            row.kitImage.Image, row.kitImage.Visible = showImage and image or "", showImage == true
            row.kitText.Text = meta and meta.name or (kitName ~= "" and tostring(kitName) or "No kit")
            row.kitText.Position = UDim2.fromOffset(0, showImage and 33 or 4)
            row.kitText.Size = UDim2.fromOffset(52, showImage and 21 or 48)
            row.kitText.TextWrapped = not showImage
        end
        for userId, row in pairs(state.players) do
            if not active[userId] then row.frame:Destroy(); state.players[userId] = nil end
        end
        local groups = {}
        for key, group in pairs(state.teams) do
            if not counts[group] then
                group.frame:Destroy(); state.teams[key] = nil
            else
                group.color = group.team and group.team.TeamColor.Color or colors.muted
                group.dot.BackgroundColor3, group.title.TextColor3 = group.color, group.color
                group.title.Text = string.upper(group.team and group.team.Name or "No Team")
                group.count.Text = counts[group] .. (counts[group] == 1 and " PLAYER" or " PLAYERS")
                groups[#groups + 1] = group
            end
        end
        table.sort(groups, function(a, b)
            if (a.team == nil) ~= (b.team == nil) then return a.team ~= nil end
            return a.title.Text < b.title.Text
        end)
        for index, group in ipairs(groups) do group.frame.LayoutOrder = index end
        state.count.Text, state.empty.Visible = tostring(#included), #included == 0
    end
    state.requestRefresh = function()
        if not state.alive or not state.gui.Enabled or state.pending then return end
        state.pending = true
        task.defer(function()
            state.pending = false
            if state.alive then state.refresh() end
        end)
    end
    local function unwatch(player)
        local list = state.watchers[player.UserId]
        if list then for _, connection in ipairs(list) do connection:Disconnect() end end
        state.watchers[player.UserId] = nil
    end
    local function watch(player)
        if state.watchers[player.UserId] then return end
        local list = {}
        for _, name in ipairs({"Team", "DisplayName"}) do list[#list + 1] = FWNoModules.Connect(player:GetPropertyChangedSignal(name), state.requestRefresh) end
        for _, name in ipairs({"PlayerLevel", "ClanTag", "PlayingAsKit", "PlayingAsKits"}) do list[#list + 1] = FWNoModules.Connect(player:GetAttributeChangedSignal(name), state.requestRefresh) end
        state.watchers[player.UserId] = list
    end
    local function clearRows()
        for _, row in pairs(state.players) do row.frame:Destroy() end
        for _, group in pairs(state.teams) do group.frame:Destroy() end
        state.players, state.teams = {}, {}
    end
    local function tick()
        if not state.alive or not state.gui.Enabled then return end
        state.requestRefresh()
        state.timer = task.delay(1, tick)
    end
    PlayerDisplay.Callbacks.OnToggle = function(enabled)
        if not state.alive then return end
        loops["player display"], state.gui.Enabled = enabled, enabled
        if state.timer then task.cancel(state.timer); state.timer = nil end
        state.dragging = false
        if enabled then
            for _, player in ipairs(FWNoModules.PlayerSnapshot()) do watch(player) end
            keepOnScreen()
            state.refresh()
            state.timer = task.delay(1, tick)
        else
            for _, player in ipairs(FWNoModules.PlayerSnapshot()) do unwatch(player) end
            clearRows()
        end
    end
    track(FWNoModules.Connect(Players.PlayerAdded, function(player)
        if state.gui.Enabled then watch(player); state.requestRefresh() end
    end))
    track(FWNoModules.Connect(Players.PlayerRemoving, function(player) unwatch(player); state.requestRefresh() end))
    local function cleanup()
        if not state.alive then return end
        savePosition()
        state.alive = false
        if state.timer then task.cancel(state.timer) end
        if state.saveTask then task.cancel(state.saveTask) end
        if state.cameraConnection then state.cameraConnection:Disconnect() end
        if state.dragEnd then state.dragEnd:Disconnect() end
        for _, connection in ipairs(state.connections) do connection:Disconnect() end
        for _, list in pairs(state.watchers) do for _, connection in ipairs(list) do connection:Disconnect() end end
        state.watchers = {}
        state.gui:Destroy()
    end
    FWNoModules.PlayerDisplayCleanup = cleanup
    track(FWNoModules.Connect(mainScreenUI.Destroying, cleanup))
    if PlayerDisplay.Toggled then PlayerDisplay.Callbacks.OnToggle(true) end
end
