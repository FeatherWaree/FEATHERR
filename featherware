		speedConnection = FWNoModules.TrackFrameConnection(G.Services.RunService.Heartbeat:Connect(function(deltaTime)
			if not mainScreenUI or mainScreenUI:GetAttribute("Running") == false then return end

			if not cachedChar or not cachedHumanoid or cachedHumanoid.Health <= 0 or not cachedChar.Parent then 
				liveChar = Player.Character
