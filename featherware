function beeColor(isWild)
	if isWild then
		return BeeESP.Values["Bee Color"] or Color3.fromRGB(255, 200, 50)
	end
	return BeeESP.Values["Hive Bee Color"] or Color3.fromRGB(150, 255, 150)
end

function beeRemoveVisuals(model)
	bee_e = bee_active[model]
	if not bee_e then return end
	if bee_e.hl then pcall(function() bee_e.hl:Destroy() end) end
	if bee_e.bb then pcall(function() bee_e.bb:Destroy() end) end
	if bee_e.glow then pcall(function() bee_e.glow:Destroy() end) end
	if bee_e.line then pcall(function() bee_e.line:Destroy() end) end
	bee_active[model] = nil
end

function beeApplyVisuals(model)
	if not bee_folder then return end
	if bee_active[model] then return end
	bee_part = model.PrimaryPart or model:FindFirstChild("Root") or model:FindFirstChildWhichIsA("BasePart")
	if not bee_part then return end

	bee_maxDist = model:GetAttribute("MaxDistanceFromOrigin") or 6
	bee_isWild = bee_maxDist > 3

	if bee_isWild and BeeESP.Values["Show Bees"] == false then return end
	if not bee_isWild and BeeESP.Values["Show Hive Bees"] == false then return end

	bee_col = beeColor(bee_isWild)
	bee_entry = {part = bee_part, isWild = bee_isWild}

	if BeeESP.Values["Show Highlight"] then
		bee_hl = FWNoModules.OwnInstance(Instance.new("Highlight"))
		bee_hl.Adornee = model
		bee_hl.FillColor = bee_col
		bee_hl.OutlineColor = BeeESP.Values["Highlight Outline Color"] or Color3.fromRGB(255, 255, 255)
		bee_hl.FillTransparency = BeeESP.Values["Highlight Fill Transparency"]
		if bee_hl.FillTransparency == nil then bee_hl.FillTransparency = 0.85 end
		bee_hl.OutlineTransparency = BeeESP.Values["Highlight Outline Transparency"]
		if bee_hl.OutlineTransparency == nil then bee_hl.OutlineTransparency = 0.1 end
		bee_hl.DepthMode = (BeeESP.Values["Through Walls"] ~= false) and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
		bee_hl.Parent = bee_folder
		bee_entry.hl = bee_hl
	end

	if BeeESP.Values["Show Distance"] or BeeESP.Values["Show Bee Id"] then
		bee_bb = FWNoModules.OwnInstance(Instance.new("BillboardGui"))
		bee_bb.Adornee = bee_part
		bee_bb.Size = UDim2.fromOffset(140, 30)
		bee_bb.StudsOffset = Vector3.new(0, 1.5, 0)
		bee_bb.AlwaysOnTop = BeeESP.Values["Through Walls"] ~= false
		bee_bb.Parent = bee_folder

		bee_dl = FWNoModules.OwnInstance(Instance.new("TextLabel"))
		bee_dl.Size = UDim2.fromScale(1, 1)
		bee_dl.BackgroundTransparency = 1
		bee_dl.Text = ""
		bee_dl.TextColor3 = BeeESP.Values["Distance Text Color"] or Color3.fromRGB(255, 255, 255)
		bee_dl.TextSize = BeeESP.Values["Text Size"] or 12
		bee_dl.Font = Enum.Font.GothamBlack
		bee_dl.TextStrokeTransparency = 0
		bee_dl.TextStrokeColor3 = Color3.fromRGB(20, 20, 20)
		bee_dl.Parent = bee_bb

		bee_entry.bb = bee_bb
		bee_entry.dl = bee_dl
	end

	if BeeESP.Values["Show Glow"] then
		bee_glow = FWNoModules.OwnInstance(Instance.new("PointLight"))
		bee_glow.Color = bee_col
		bee_glow.Range = BeeESP.Values["Glow Range"] or 10
		bee_glow.Brightness = BeeESP.Values["Glow Brightness"] or 2
		bee_glow.Parent = bee_part
		bee_entry.glow = bee_glow
	end

	if BeeESP.Values["Show Origin Line"] then
		bee_line = FWNoModules.OwnInstance(Instance.new("Part"))
		bee_line.Anchored = true
		bee_line.CanCollide = false
		bee_line.CanQuery = false
		bee_line.CanTouch = false
		bee_line.CastShadow = false
		bee_line.Material = Enum.Material.Neon
		bee_line.Color = bee_col
		bee_line.Transparency = 0.3
		bee_line.Size = Vector3.new(0.1, 0.1, 1)
		bee_line.Parent = bee_folder
		bee_entry.line = bee_line
	end

	bee_active[model] = bee_entry
end

function beeRebuildVisuals()
	if not bee_ready then return end
	for bee_m in pairs(bee_active) do beeRemoveVisuals(bee_m) end
	for bee_m in pairs(bee_allModels) do
		if bee_m.Parent then
			beeApplyVisuals(bee_m)
		else
			bee_allModels[bee_m] = nil
		end
	end
end

function beeRebuildAll()
	if not bee_ready then return end
	for bee_m in pairs(bee_active) do beeRemoveVisuals(bee_m) end
	bee_allModels = {}
	for _, bee_m in ipairs(bee_cs:GetTagged("bee")) do
		if bee_m:IsA("Model") and bee_m.Parent then
			bee_allModels[bee_m] = true
			beeApplyVisuals(bee_m)
		end
	end
end

function beeApplyProps()
	if not bee_ready then return end
	bee_walls = BeeESP.Values["Through Walls"] ~= false
	for _, bee_e in pairs(bee_active) do
		bee_col = beeColor(bee_e.isWild)
		if bee_e.hl then
			bee_e.hl.FillColor = bee_col
			bee_e.hl.OutlineColor = BeeESP.Values["Highlight Outline Color"] or Color3.fromRGB(255, 255, 255)
			bee_e.hl.FillTransparency = BeeESP.Values["Highlight Fill Transparency"] or 0.85
			bee_e.hl.OutlineTransparency = BeeESP.Values["Highlight Outline Transparency"] or 0.1
			bee_e.hl.DepthMode = bee_walls and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
		end
		if bee_e.dl then
			bee_e.dl.TextColor3 = BeeESP.Values["Distance Text Color"] or Color3.fromRGB(255, 255, 255)
			bee_e.dl.TextSize = BeeESP.Values["Text Size"] or 12
		end
		if bee_e.bb then
			bee_e.bb.AlwaysOnTop = bee_walls
		end
		if bee_e.glow then
			bee_e.glow.Color = bee_col
			bee_e.glow.Range = BeeESP.Values["Glow Range"] or 10
			bee_e.glow.Brightness = BeeESP.Values["Glow Brightness"] or 2
		end
		if bee_e.line then
			bee_e.line.Color = bee_col
		end
	end
end

function beeUpdateDistances()
	if not loops["bee esp"] then return end
	bee_char = G.Services.Players.LocalPlayer.Character
	if not bee_char then return end
	bee_hrp = bee_char:FindFirstChild("HumanoidRootPart")
	if not bee_hrp then return end
	bee_pPos = bee_hrp.Position

	for bee_m, bee_e in pairs(bee_active) do
		if bee_e.part and bee_e.part.Parent then
			if bee_e.dl then
				bee_dist = (bee_e.part.Position - bee_pPos).Magnitude
				bee_text = ""
				if BeeESP.Values["Show Bee Id"] then
					bee_id = bee_m:GetAttribute("BeeId") or "?"
					bee_text = "#" .. tostring(bee_id):sub(1, 4)
				end
				if BeeESP.Values["Show Distance"] then
					if bee_text ~= "" then bee_text = bee_text .. " • " end
					bee_text = bee_text .. tostring(math.floor(bee_dist)) .. "m"
				end
				if bee_text == "" then
					bee_text = bee_e.isWild and "Wild" or "Hive"
				end
				bee_e.dl.Text = bee_text
			end
			if bee_e.line and bee_e.line.Parent then
				bee_origin = bee_m:GetAttribute("BeeOrigin")
				if bee_origin then
					bee_beePos = bee_e.part.Position
					bee_dir = bee_origin - bee_beePos
					bee_len = bee_dir.Magnitude
					if bee_len > 0.1 then
						bee_mid = bee_beePos + bee_dir / 2
						bee_e.line.Size = Vector3.new(0.1, 0.1, bee_len)
						bee_e.line.CFrame = CFrame.new(bee_mid, bee_origin)
					end
				end
			end
		else
			beeRemoveVisuals(bee_m)
			bee_allModels[bee_m] = nil
		end
	end
end

