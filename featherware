healGetItemInstance = function(itemName)
	playerInv = healGetInventoryFolder()
	if not playerInv then return nil end
	item = playerInv:FindFirstChild(itemName)
	if item then
		amt = item:GetAttribute("Amount")
		if amt == nil or amt > 0 then return item end
