            local entry = runtime.restorations[i]
            pcall(function() entry.object[entry.key] = entry.value end)
        end
        table.clear(runtime.restorations)
    end
    function runtime.DestroyOwned()
        for tween in pairs(runtime.tweens) do pcall(function() tween:Cancel() end) end
        table.clear(runtime.tweens)
        for object in pairs(runtime.objects) do
            pcall(function()
                if object:IsA("AnimationTrack") then object:Stop() end
                object:Destroy()
            end)
        end
        table.clear(runtime.objects)
        table.clear(runtime.featureTasks);table.clear(runtime.featureConnections);table.clear(runtime.featureObjects);table.clear(runtime.owners);table.clear(runtime.bindingOwners);table.clear(runtime.featureTweens)
