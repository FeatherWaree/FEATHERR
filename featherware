function aadOwnerVerdictFromUserId(uid)
	if not uid or uid == 0 then return "skip" end
	if uid == Player.UserId then return "skip" end
	aou_plr = Players:GetPlayerByUserId(uid)
	if not aou_plr then return "skip" end
	aou_sameTeam = (aou_plr.Team ~= nil and Player.Team ~= nil and aou_plr.Team == Player.Team)
	if aou_sameTeam then return "skip" end
	if aou_plr.Team ~= nil and tostring(aou_plr.Team.Name):lower():find("spectat") then return "skip" end
	return "enemy"
end

function aadOwnerVerdictFromShooterModel(shooter)
	if not shooter then return "skip" end
	if shooter == aadMyChar() then return "skip" end
	aos_plr = Players:GetPlayerFromCharacter(shooter)
	if not aos_plr then return "skip" end
	aos_sameTeam = (aos_plr.Team ~= nil and Player.Team ~= nil and aos_plr.Team == Player.Team)
	if aos_sameTeam then return "skip" end
	if aos_plr.Team ~= nil and tostring(aos_plr.Team.Name):lower():find("spectat") then return "skip" end
	return "enemy"
end

function aadIngest(typ, vel, org, verdict, hint)
	if not aad.on then return false end
	if verdict ~= "enemy" then return false end
	if not vel or not org then return false end
	if not AutoArrowDodge.Values["Other Projectiles"] then
		if not aadIsArrow(typ, hint) then return false end
	end
	aai_g, aai_life = 196.2, 3
	if typ and PA_PROJ_META and PA_PROJ_META[typ] then
		aai_g = PA_PROJ_META[typ].gravitationalAcceleration or aai_g
		aai_life = PA_PROJ_META[typ].lifetimeSec or aai_life
	end
	if #aad.list > 96 then table.remove(aad.list, 1) end
	table.insert(aad.list, { o = org, v = vel, g = aai_g, t0 = tick(), life = aai_life })
	return true
end

function aadScanTypes(args)
	aas_typ, aas_vel, aas_org, aas_sh = nil, nil, nil, nil
	for aas_i = 1, #args do
		aas_x = args[aas_i]; aas_t = typeof(aas_x)
		if aas_t == "string" and not aas_typ then aas_typ = aas_x
		elseif aas_t == "Vector3" then
			if not aas_vel then aas_vel = aas_x elseif not aas_org then aas_org = aas_x end
		elseif aas_t == "Instance" and (aas_x:IsA("Model") or aas_x:IsA("BasePart")) then
			if not aas_sh and (Players:GetPlayerFromCharacter(aas_x) or aas_x:FindFirstChildOfClass("Humanoid")) then aas_sh = aas_x end
		end
	end
	return aas_typ, aas_vel, aas_org, aas_sh
end

function aadParseSync(...)
