Killaura.Callbacks.OnToggle = function(state)
    if FWNoModules.kaDamageConnection then FWNoModules.ReleaseConnection(FWNoModules.kaDamageConnection);FWNoModules.kaDamageConnection=nil end
	FWNoModules.SetLoop("killaura", state)
	if state and loadedSwingTrack then
		pcall(function() loadedSwingTrack:Stop(); loadedSwingTrack:Destroy() end)
		loadedSwingTrack = nil
	end
	if not state then
		currentKaTarget = nil
		currentVisualTarget = nil
		if kaHighlight then kaHighlight.Adornee = nil end
		hide3DBox()
		if loadedSwingTrack then
			pcall(function() loadedSwingTrack:Stop(); loadedSwingTrack:Destroy() end)
			loadedSwingTrack = nil
		end
		if kaHeartbeatConn then
			kaHeartbeatConn:Disconnect()
			kaHeartbeatConn = nil
		end
		return 
	end

	if ka3DBox and ka3DBox.Parent ~= G.Services.Workspace and ka3DBox.Parent ~= game.Lighting and ka3DBox.Parent ~= nil then
		ka3DBox.Color = Killaura.Values["3D Box Color"] or Color3.fromRGB(0, 255, 163)
	end

	character = Player.Character or Player.CharacterAdded:Wait()
	if not character then return end
	animator = character:FindFirstChild("Humanoid") and character.Humanoid:FindFirstChild("Animator")
	local kaSwingAnimation = FWNoModules.OwnInstance(Instance.new("Animation"))
	kaSwingAnimation.AnimationId = "rbxassetid://4947108314"
	loadedSwingTrack = animator and FWNoModules.OwnInstance(animator:LoadAnimation(kaSwingAnimation))
	kaSwingAnimation:Destroy()
	if loadedSwingTrack then
		loadedSwingTrack.Priority = Enum.AnimationPriority.Action
		loadedSwingTrack.Looped = false
	end

	lastTargetSearch = 0
	cachedBestTarget = nil
	currentVisualTarget = nil
	lastEquipTime = 0
	lastVisualSwing = 0

	-- Per-enable state cannot retain elapsed time from a previous target/session.
	local kaPacer = FWNoModules.SwordTiming.New()
	FWNoModules.SwordTiming.Session = kaPacer
    local kaSync=FWNoModules.ReferenceSwordTiming.New()
    kaPacer.Sync=kaSync
    local damageRemote=NetRemotes and NetRemotes:FindFirstChild("EntityDamageEvent")
    if damageRemote and damageRemote:IsA("RemoteEvent")then
        FWNoModules.kaDamageConnection=FWNoModules.Connect(damageRemote.OnClientEvent,function(data)
            if loops["killaura"]then kaSync:Damage(data,Player.Character,os.clock())end
        end)
    end

	if kaHeartbeatConn then kaHeartbeatConn:Disconnect() end

	kaHeartbeatConn = FWNoModules.TrackFrameConnection(G.Services.RunService.Heartbeat:Connect(function(deltaTime)
		if not loops["killaura"] then
			kaHeartbeatConn:Disconnect()
			kaHeartbeatConn = nil
			return
		end

        if Player:GetAttribute("IsCasting")==true then kaPacer:Pause("Casting");return end

		local nowServerTime = G.Services.Workspace:GetServerTimeNow()
		local timing = FWNoModules.SwordTiming
		local handItem = Player.Character and Player.Character:FindFirstChild("HandInvItem")
		local heldName = handItem and handItem.Value and (typeof(handItem.Value) == "Instance" and handItem.Value.Name or tostring(handItem.Value)) or ""
		local weaponSpeed = timing.WeaponCooldown(heldName)
        local hitDelay = timing.KillauraDelay(Killaura.Values["Hits per 10s"],weaponSpeed,Killaura.Values["Respect Weapon Cooldown"]==true)

		if not (Killaura.Values["Target Players"] or Killaura.Values["Target NPCs/Dummies"]) then return end

		local char = Player.Character
		local rootPart = char and char:FindFirstChild("HumanoidRootPart")
		local humanoid = char and char:FindFirstChild("Humanoid")

        if not rootPart or not humanoid or humanoid.Health<=0 then kaPacer:Pause("Character unavailable");return end

		if Killaura.Values["Check If Sophia Frozen"] then
			local stunTime = Player:GetAttribute("StunnedUntilTime")
			if stunTime and stunTime ~= -1 and stunTime > 0 then return end
		end

        if not handItem then kaPacer:Pause("No equipped item");return end

		local reach = tonumber(Killaura.Values["Reach"]) or 12.4
		local selectionRange = reach
		if Killaura.Values["Swing Animation"] then
			selectionRange = tonumber(Killaura.Values["Swing Range"]) or 50
		end

		if nowServerTime - lastTargetSearch > 0.15 or not cachedBestTarget or not cachedBestTarget.Parent then
			lastTargetSearch = nowServerTime
			local playertarget, playerdistance = nil, selectionRange
			local npcdummytarget, npcdummydistance = nil, selectionRange

			for _, charModel in ipairs(EntityCache.Players or {}) do
				-- FIX 1: Better player detection (find by name if character link is missing)
				local targetPlayer = Players:GetPlayerFromCharacter(charModel) or Players:FindFirstChild(charModel.Name)

				-- FIX 2: Stronger teammate check (checks both Roblox Teams and game Attributes)
				local isTeammate = false
				if targetPlayer then
					if Player.Team ~= nil and targetPlayer.Team == Player.Team then
						isTeammate = true
					elseif Player:GetAttribute("Team") ~= nil and targetPlayer:GetAttribute("Team") == Player:GetAttribute("Team") then
						isTeammate = true
					end
				end

				if charModel ~= Player.Character and charModel.Parent and not isTeammate then
					local tHRP = charModel:FindFirstChild("HumanoidRootPart")
					local tHum = charModel:FindFirstChildOfClass("Humanoid")

					if tHRP and tHum and tHum.Health > 0 then
						local dist = (rootPart.Position - tHRP.Position).Magnitude
						if dist < playerdistance then
							playertarget = charModel
							playerdistance = dist
						end
					end
				end
			end

			if Killaura.Values["Target NPCs/Dummies"] then
				for _, npc in ipairs(EntityCache.NPCs or {}) do
					if npc and npc.Parent then
						-- FIX 3: Don't target teammate's pets/clones that count as NPCs
						local npcTeam = npc:GetAttribute("Team")
						local myTeam = Player:GetAttribute("Team")
						local isNpcTeammate = (npcTeam ~= nil and myTeam ~= nil and npcTeam == myTeam)

						if not isNpcTeammate then
							local tHRP = npc:FindFirstChild("HumanoidRootPart") or npc.PrimaryPart
							local tHum = npc:FindFirstChild("Humanoid")
							if tHRP and tHum and tHum.Health > 0 then
								local dist = (rootPart.Position - tHRP.Position).Magnitude
								if dist < npcdummydistance then
									npcdummytarget = npc
									npcdummydistance = dist
								end
							end
						end
					end
				end
			end

			local priority = Killaura.Values["Priority"]
			local bountyTarget = nil
			if priority == "Bounty Hunter" and ClientStore then
				pcall(function()
					local storeState = ClientStore:getState()
					if storeState and storeState.Kit then
						local bTarget = storeState.Kit.bountyHunterTarget
						if bTarget and typeof(bTarget) == "Instance" then
							local bChar = bTarget:IsA("Player") and bTarget.Character or (bTarget:IsA("Model") and bTarget or nil)
							if bChar and bChar.Parent then
								local bHRP = bChar:FindFirstChild("HumanoidRootPart") or bChar.PrimaryPart
								local bHum = bChar:FindFirstChild("Humanoid")
								if bHRP and bHum and bHum.Health > 0 then
									local bDist = (rootPart.Position - bHRP.Position).Magnitude
									if bDist <= selectionRange then
										bountyTarget = bChar
									end
								end
							end
						end
					end
				end)
			end

			if priority == "Bounty Hunter" then
				cachedBestTarget = bountyTarget or playertarget or npcdummytarget
			elseif priority == "Player" then
				cachedBestTarget = playertarget or npcdummytarget
			elseif priority == "NPC/Dummy" then
				cachedBestTarget = npcdummytarget or playertarget
			else
				cachedBestTarget = (playerdistance <= npcdummydistance and playertarget) or npcdummytarget or playertarget
			end
		end

		local besttarget = cachedBestTarget
        if not besttarget or not besttarget.Parent then
            kaPacer:Pause("No eligible target")
            cachedBestTarget = nil
			if currentVisualTarget ~= nil then
				currentVisualTarget = nil
				if kaHighlight then kaHighlight.Adornee = nil end
				hide3DBox()
			end
			return
		end

		local targetHRP = besttarget:FindFirstChild("HumanoidRootPart") or besttarget.PrimaryPart
		if not targetHRP then
			cachedBestTarget = nil
			return
		end

		local distance = (rootPart.Position - targetHRP.Position).Magnitude

		-- 3. VISUALS (Highlight & 3D Box) - FIXED TO PREVENT PHYSICS LAUNCH
		if distance <= selectionRange then
			if Killaura.Values["Highlight Target"] then
				kaHighlight.FillColor = Killaura.Values["Highlight Color"]
				kaHighlight.Adornee = besttarget
			else
				kaHighlight.Adornee = nil
			end

			if Killaura.Values["3D Box Target"] then
				if currentVisualTarget ~= besttarget then
					currentVisualTarget = besttarget
					ka3DBox.Massless = true
					ka3DBox.Anchored = true
					ka3DBox.CanCollide = false
					ka3DBox.CanQuery = false
					ka3DBox.CanTouch = false
					ka3DBox.Parent = G.Services.Workspace
					ka3DBox.Size = Vector3.new(4, 5, 2)
					ka3DBox.Transparency = 0.65
					ka3DBox.Material = Enum.Material.SmoothPlastic
					if ka3DBoxWeld then 
						ka3DBoxWeld:Destroy() 
						ka3DBoxWeld = nil 
					end
				end
				ka3DBox.CFrame = targetHRP.CFrame
				ka3DBox.Color = Killaura.Values["3D Box Color"]
			else
				if currentVisualTarget ~= nil then
					currentVisualTarget = nil
					hide3DBox()
				end
			end
		else
			if currentVisualTarget ~= nil then
				currentVisualTarget = nil
				if kaHighlight then kaHighlight.Adornee = nil end
				hide3DBox()
			end
		end

		-- 4. SWING ANIMATION
		if Killaura.Values["Swing Animation"] and not Killaura.Values["Manual Swing"] then
			if distance <= selectionRange then
				local visualCooldown
				if Killaura.Values["Calculate Swing Speed"] then
					visualCooldown = math.max(1 / 9, hitDelay)
				else
					visualCooldown = tonumber(Killaura.Values["Swing Speed"]) or 0.111
				end
				if nowServerTime - lastVisualSwing >= visualCooldown then
					lastVisualSwing = nowServerTime
					if canRequire and kaSwordController then
						kaSwordController:playSwordEffect({sword = {}}, false, {playAnimation = true, playSound = true})
					else
						if loadedSwingTrack then
							if loadedSwingTrack.IsPlaying then
								loadedSwingTrack:Stop()
							end
							loadedSwingTrack:Play()
						end
					end

					-- === CUSTOM SKIN SWING SOUND (Plays during Swing Animation outside reach) ===
					if loops["item skin changer"] and iscMeta and isc_selected and heldName ~= "" then
						local ka_skinTag = isc_selected[heldName]
						if ka_skinTag then
							local ka_skinMeta = iscMeta[heldName .. "_" .. ka_skinTag]
							if not ka_skinMeta then
								for _, ka_m in pairs(iscMeta) do
									if type(ka_m) == "table" and ka_m.itemType == heldName and ka_m.skinTag == ka_skinTag then
										ka_skinMeta = ka_m
										break
									end
								end
							end
							if ka_skinMeta and type(ka_skinMeta.sword) == "table" and type(ka_skinMeta.sword.hitSounds) == "table" and #ka_skinMeta.sword.hitSounds > 0 then
								local ka_sndId = ka_skinMeta.sword.hitSounds[math.random(1, #ka_skinMeta.sword.hitSounds)]
								if type(ka_sndId) == "string" then
									if not string.find(ka_sndId, "rbxassetid") then ka_sndId = "rbxassetid://" .. ka_sndId end
									task.spawn(function()
										local ka_snd = FWNoModules.OwnInstance(Instance.new("Sound"))
										ka_snd.SoundId = ka_sndId
										ka_snd.Volume = 1
										ka_snd.Parent = G.Services.Workspace.CurrentCamera or G.Services.Workspace
										ka_snd.PlayOnRemove = true
										ka_snd:Destroy()
									end)
								end
							end
						end
					end
				end
			end
		end

		if distance <= reach and Killaura.Values["Face Target"] then
			faceTarget(char, besttarget)
		end

		-- 5. VALIDATION CHECKS
		-- 5. VALIDATION CHECKS
		if distance > reach then return end
		if math.abs(targetHRP.Position.Y - rootPart.Position.Y) > reach + 2 then return end
		if Killaura.Values["Wall Check"] and not kaCanSee(besttarget) then return end
		if not isInFOV(rootPart, targetHRP, tonumber(Killaura.Values["Angle Check"]) or 180) then return end

		local isClicking = (typeof(clicking) == "boolean" and clicking) or (typeof(mouse1down) == "boolean" and mouse1down) or false
		if Killaura.Values["Manual Swing"] and not isClicking then return end

		local invFolder = FWNoModules.GetPrivateInventory(Player.Name)
		local isSword = swords and table.find(swords, heldName)
		local inventoryWeapon = nil

		if not isSword then
			if Killaura.Values["Require Sword Equipped"] then
				return
			else
				local bestSword = getBestEquippedSword(Player.Name)
				if bestSword then
					local swordInstance = typeof(bestSword) == "Instance" and bestSword or nil
					if not swordInstance then
						local swapInv = FWNoModules.GetPrivateInventoryContainer()
						local playerInv = swapInv and FWNoModules.GetPrivateInventory(Player.Name)
						swordInstance = playerInv and playerInv:FindFirstChild(tostring(bestSword))
					end

					if swordInstance then
						inventoryWeapon = swordInstance
						-- Use a small debounce to prevent spamming the server while we wait for the visual swap
						if nowServerTime - lastEquipTime > 0.1 then
							lastEquipTime = nowServerTime
							task.spawn(function()
								pcall(function() SetInvItemRemote:InvokeServer({ hand = swordInstance }) end)
							end)
						end
						-- CRITICAL FIX: We do NOT return here anymore.
						-- We instantly proceed to attack using this sword on the exact same frame.
					else
						return
					end
				else
					return
				end
			end
		else
			-- If we already had a sword equipped, resolve it normally
			inventoryWeapon = invFolder and invFolder:FindFirstChild(heldName)
			if not inventoryWeapon then
				inventoryWeapon = getBestEquippedSword(Player.Name)
			end
		end

		if not loops["killaura"] then return end
		if not inventoryWeapon then return end

		-- Resolve the actual attack weapon after any auto-equip decision.
		kaPacer.Weapon = inventoryWeapon.Name
		local actualCooldown = inventoryWeapon.Name == heldName and weaponSpeed or timing.WeaponCooldown(inventoryWeapon.Name)
        local attackDelay,minimumGap=timing.KillauraDelay(Killaura.Values["Hits per 10s"],actualCooldown,Killaura.Values["Respect Weapon Cooldown"]==true)
		local adjusterEarliest = -math.huge
		if loops["hit reg adjuster"] and HitRegAdjuster then
			local adjusterDelay = timing.AdjusterDelay(inventoryWeapon.Name, HitRegAdjuster.Values["Max Hits per 10s"])
			attackDelay = math.max(attackDelay, adjusterDelay)
			minimumGap = math.max(minimumGap, adjusterDelay)
			adjusterEarliest = (hrAdjusterLastHit or -math.huge) + adjusterDelay
		end

        -- Adapt only the send schedule. Target checks and hit payload stay unchanged.
        local attackNow=os.clock()
        kaSync.frame=math.clamp(tonumber(deltaTime)or 1/60,1/500,1/15)
        local ping=math.huge
        if Killaura.Values["Adaptive Hit Timing"]then
            local ok,value=pcall(Player.GetNetworkPing,Player)
            if ok and type(value)=="number"then ping=value end
        end
        local referenceEarliest
        attackDelay,minimumGap,referenceEarliest=kaSync:Plan(attackNow,nowServerTime,besttarget,inventoryWeapon.Name,actualCooldown,tonumber(Killaura.Values["Hits per 10s"])or 36,attackDelay,minimumGap,{
            enabled=Killaura.Values["Adaptive Hit Timing"]==true,
            respect=Killaura.Values["Respect Weapon Cooldown"]==true,
            confirmations=FWNoModules.kaDamageConnection~=nil,
            ping=ping,stamp=besttarget:GetAttribute("LastDamageTakenTime"),
            controllerLast=kaSwordController and kaSwordController.lastAttack,
            fury=Killaura.Values["Adaptive Hit Timing"]and not Killaura.Values["Respect Weapon Cooldown"]and FWNoModules.ReferenceSwordTiming.FuryMultiplier(Player.Character)or 1,
            budget=.2,
        })
        if referenceEarliest then
            adjusterEarliest=math.max(adjusterEarliest,referenceEarliest)
            if kaSync.locked then kaPacer.NextSlot=referenceEarliest;kaPacer.Interval=attackDelay end
        end
        kaPacer.EffectiveInterval=attackDelay
        -- The explicit weapon-cooldown and Hit Reg Adjuster settings keep precedence.
		if kaPacer:Ready(attackNow, attackDelay, minimumGap, adjusterEarliest) then

			-- BYPASS THE 9 CPS HARDCAP ONLY WHEN FIRING (Fixes manual swing cooldown)
			if canRequire and kaSwordController then
				kaSwordController.lastSwing = 0
			end

			currentKaTarget = besttarget
			local dir = (targetHRP.Position - rootPart.Position).Unit
			local spoofedTargetPosition = targetHRP.Position
			if distance > 14 then
				spoofedTargetPosition = targetHRP.Position + ((rootPart.Position - targetHRP.Position).Unit * (distance - 13.5))
			end

			local kaArgs = {{
				chargedAttack = { chargeRatio = 0 },
				entityInstance = besttarget,
				validate = {
					selfPosition = { value = rootPart.Position + dir * 5.5 },
					targetPosition = { value = spoofedTargetPosition },
					raycast = {
						cameraPosition = { value = G.Services.Workspace.CurrentCamera.CFrame.Position },
						cursorDirection = { value = dir }
					}
				},
				weapon = inventoryWeapon,
				timeSinceSwingStart = 0
			}}

			-- === CUSTOM SKIN HIT SOUND FOR KILLAURA ===
			if loops["item skin changer"] and iscMeta and isc_selected and inventoryWeapon then
				ka_skinTag = isc_selected[inventoryWeapon.Name]
				if ka_skinTag then
					ka_skinMeta = iscMeta[inventoryWeapon.Name .. "_" .. ka_skinTag]
					if not ka_skinMeta then
						for _, ka_m in pairs(iscMeta) do
							if type(ka_m) == "table" and ka_m.itemType == inventoryWeapon.Name and ka_m.skinTag == ka_skinTag then
								ka_skinMeta = ka_m
								break
							end
						end
					end
					if ka_skinMeta and type(ka_skinMeta.sword) == "table" and type(ka_skinMeta.sword.hitSounds) == "table" and #ka_skinMeta.sword.hitSounds > 0 then
						ka_sndId = ka_skinMeta.sword.hitSounds[math.random(1, #ka_skinMeta.sword.hitSounds)]
						if type(ka_sndId) == "string" then
							if not string.find(ka_sndId, "rbxassetid") then ka_sndId = "rbxassetid://" .. ka_sndId end
							ka_snd = FWNoModules.OwnInstance(Instance.new("Sound"))
							ka_snd.SoundId = ka_sndId
							ka_snd.Volume = 1
							ka_snd.Parent = G.Services.Workspace.CurrentCamera or G.Services.Workspace
							ka_snd.PlayOnRemove = true
							ka_snd:Destroy()
						end
					end
				end
			end

            local sentAt=os.clock()
            local sentServer=G.Services.Workspace:GetServerTimeNow()
			SwordHitRemote:FireServer(unpack(kaArgs))
            kaSync:Sent(sentAt,sentServer,besttarget,kaSync.locked)
            if Killaura.Values["Adaptive Hit Timing"]and kaSwordController then kaSwordController.lastAttack=sentServer end
			kaPacer:Commit(sentAt, attackDelay)
		end
	end))
end

