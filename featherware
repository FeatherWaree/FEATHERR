		palos_tgt = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or (model:IsA("BasePart") and model or nil)
	end
	if not palos_tgt then return false end
	palos_filter = {}
	if palos_char then table.insert(palos_filter, palos_char) end
	if typeof(model) == "Instance" then table.insert(palos_filter, model) end
	if typeof(rootPart) == "Instance" then table.insert(palos_filter, rootPart) end
	paWallParams.FilterDescendantsInstances = palos_filter
	palos_hit = G.Services.Workspace:Raycast(origin, palos_tgt.Position - origin, paWallParams)
	return palos_hit == nil
end

function paConsider(model, h, v, myPos)
	if not paHasLOS(myPos, model, h) then return end
	mode = ProjectileAura.Values["Mode"] or "Blatant"
	if mode == "Legit" then
		fovVal = ProjectileAura.Values["FOV"] or 150
		fovAng = 5 + (fovVal / 1000) * 175
		cosTh = math.cos(math.rad(fovAng))
		camPos = camera.CFrame.Position
		camDir = camera.CFrame.LookVector
		toT = h.Position - camPos
		if toT.Magnitude > 0.001 and camDir:Dot(toT.Unit) < cosTh then return end
	end
	pap_d = (myPos - h.Position).Magnitude
	if not pap_bd or pap_d < pap_bd then pap_best, pap_bd, pap_bh, pap_bv = model, pap_d, h, v end
end

function paPickTarget(myPos)
	pap_best, pap_bd, pap_bh, pap_bv = nil, nil, nil, nil
	if ProjectileAura.Values["Target Players"] then
		if EntityCache and EntityCache.players then
			for _, pap_pl in ipairs(EntityCache.players) do
				pap_c = pap_pl.Character
				pap_h = pap_c and pap_c:FindFirstChild("HumanoidRootPart")
				if pap_h then
					paConsider(pap_c, pap_h, pap_h.AssemblyLinearVelocity or pap_h.Velocity or Vector3.zero, myPos)
				end
			end
		end
	end
	if ProjectileAura.Values["Target NPCs/Dummies"] then
		if EntityCache and EntityCache.npcs then
			for _, pap_m in ipairs(EntityCache.npcs) do
				pap_h = pap_m:FindFirstChild("HumanoidRootPart") or pap_m.PrimaryPart
				if pap_h then
					paConsider(pap_m, pap_h, pap_h.AssemblyLinearVelocity or pap_h.Velocity or Vector3.zero, myPos)
				end
			end
		else
			for _, pap_m in ipairs(paGetNpcList()) do
				pap_root, pap_model = paNpcRoot(pap_m)
				if pap_root then
					paConsider(pap_model, pap_root, pap_root.AssemblyLinearVelocity or pap_root.Velocity or Vector3.zero, myPos)
				end
			end
		end
	end
	return pap_best, pap_bh, pap_bv
end

function paSpawnVisual(pProj, pPm, pO, pVel, pG)
	if #PA_VIS >= PA_MAX_VIS then return end
	pas_modelName = (pPm and pPm.projectileModel) or pProj
	pas_srcRoot = paItems and paItems:FindFirstChild(pas_modelName)
	if not pas_srcRoot then return end
	if pas_srcRoot:IsA("Accessory") then
		pas_src = pas_srcRoot:FindFirstChild("Handle")
	else
		pas_src = pas_srcRoot
	end
	if not pas_src then return end
	pas_clone = pas_src:Clone()
	pas_clone.Parent = G.Services.Workspace
	if pas_clone:IsA("BasePart") then
		pas_mover = pas_clone; pas_isModel = false
	elseif pas_clone:IsA("Model") then
		pas_isModel = true
		pas_mover = pas_clone.PrimaryPart
		if not pas_mover then
			pas_clone.PrimaryPart = pas_clone:FindFirstChildWhichIsA("BasePart")
			pas_mover = pas_clone.PrimaryPart
		end
	else
		pas_clone:Destroy()
		return
	end
	if not pas_mover then pas_clone:Destroy() return end
	if pas_mover:IsA("BasePart") then
		pas_mover.Anchored = true; pas_mover.CanCollide = false; pas_mover.CanQuery = false; pas_mover.CanTouch = false
	end
	pas_dir = pVel.Magnitude > 0 and pVel.Unit or Vector3.new(0,1,0)
	pas_fr = (pPm and pPm.flightRotation) or Vector3.new(0,0,0)
	pas_fix = CFrame.new()
	if paIsSpearVisual(pProj) and pas_mover:IsA("BasePart") then
		pas_sz = pas_mover.Size
		if pas_sz.X >= pas_sz.Y and pas_sz.X >= pas_sz.Z then pas_fix = paAxisFix(Vector3.new(1,0,0))
		elseif pas_sz.Y >= pas_sz.Z then pas_fix = paAxisFix(Vector3.new(0,1,0))
		else pas_fix = paAxisFix(Vector3.new(0,0,1)) end
	end
	pas_cf = CFrame.lookAt(pO, pO + pas_dir) * pas_fix * CFrame.Angles(pas_fr.X, pas_fr.Y, pas_fr.Z)
	if pas_isModel then pas_clone:PivotTo(pas_cf) else pas_mover.CFrame = pas_cf end
	table.insert(PA_VIS, { obj = pas_clone, mover = pas_mover, isModel = pas_isModel, O = pO, V = pVel, g = pG, fr = pas_fr, t0 = tick(), life = (pPm and pPm.lifetimeSec) or 2 })
end

function paDoShot(pL, pO, pSpawnO, pVel, pT, pTgt, pG, pProj, pPm, pFid, pSid)
	pae_curName = paGetHeldName()
	pae_curInst = pae_curName and paInv and paInv:FindFirstChild(pae_curName) or nil
	if pae_curInst and not paIsManaged(pae_curInst) then paSavedHand = pae_curInst end
	if pae_curInst ~= pL.weapon and paSetInv then
		pcall(function() paSetInv:InvokeServer({ hand = pL.weapon }) end)
	end
	pae_draw = (pL.kind == "throw") and (pL.maxCharge or 0) or PA_FULL_DRAW
	paf_ok = pcall(function()
		return paFire:InvokeServer(pL.weapon, pL.ammo, pL.projectile,
			vec3(pO.X, pO.Y, pO.Z),
			vec3(pSpawnO.X, pSpawnO.Y, pSpawnO.Z),
			vec3(pVel.X, pVel.Y, pVel.Z),
			pFid, { shotId = pSid, drawDurationSec = pae_draw },
			G.Services.Workspace:GetServerTimeNow())
	end)
	if paf_ok then
		paLastShot = tick()
		paf_tr = paPlayAnim(pL.fireAnim)
		if paf_tr and paf_tr.Length then paFireAnimDone = tick() + paf_tr.Length end
		paPlaySound(pL.launchSnd)
		for paf_k = 1, #PA_HIT_TAPS do
			paf_at = math.max(0, math.min(pT + PA_HIT_TAPS[paf_k], 3))
			task.delay(paf_at, function() pcall(function() paHit:FireServer(pFid, pTgt) end) end)
		end
		paSpawnVisual(pProj, pPm, pSpawnO, pVel, pG)
	end
end

function paFireShot(L, O, spawnO, vel, t, target, g, projName, pm)
	paf_fireId, paf_shotId = paGenId(), paGenId()
	task.spawn(paDoShot, L, O, spawnO, vel, t, target, g, projName, pm, paf_fireId, paf_shotId)
end

function paVisTick()
	pav_now = tick(); pav_i = 1
	while pav_i <= #PA_VIS do
		pav_e = PA_VIS[pav_i]; pav_t = pav_now - pav_e.t0
		if pav_t >= pav_e.life or not pav_e.obj.Parent then
			pcall(function() pav_e.obj:Destroy() end); table.remove(PA_VIS, pav_i)
		else
			pav_p = pav_e.O + pav_e.V*pav_t + Vector3.new(0, -0.5*pav_e.g*pav_t*pav_t, 0)
			pav_cv = pav_e.V + Vector3.new(0, -pav_e.g*pav_t, 0)
			pav_d = pav_cv.Magnitude > 0.001 and pav_cv.Unit or Vector3.new(0,1,0)
			pav_cf = CFrame.lookAt(pav_p, pav_p + pav_d) * CFrame.Angles(pav_e.fr.X, pav_e.fr.Y, pav_e.fr.Z)
			if pav_e.isModel then pav_e.obj:PivotTo(pav_cf) else pav_e.mover.CFrame = pav_cf end
			pav_i = pav_i + 1
		end
	end
end

