function nkClearPath()
	for k, b in pairs(nkPathBoxes) do pcall(function() b:Destroy() end) end
	nkPathBoxes = {}
end

function nkRenderPath(cells)
	if not cells or #cells == 0 then
		nkClearPath()
		return
	end
	seen = {}
	col = Nuker.Values["Highlight Color"] or Color3.fromRGB(255, 0, 0)
	for _, gp in ipairs(cells) do
		key = gp.X .. "_" .. gp.Y .. "_" .. gp.Z
		seen[key] = true
		if not nkPathBoxes[key] then
			b = FWNoModules.OwnInstance(Instance.new("Part"))
			b.Anchored = true
			b.CanCollide = false
			b.CanQuery = false
			b.CanTouch = false
			b.Transparency = 1
			b.Size = Vector3.new(0.1, 0.1, 0.1)
			b.CFrame = CFrame.new(gp.X * 3, gp.Y * 3, gp.Z * 3)
			b.Parent = nkPathFolder
			h = FWNoModules.OwnInstance(Instance.new("Highlight"))
			h.Adornee = b
			h.FillTransparency = 0.7
			h.OutlineTransparency = 0
			h.Parent = b
			nkPathBoxes[key] = b
			FWNoModules.OwnTween(TweenService:Create(b, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = Vector3.new(3, 3, 3), Transparency = 0.6})):Play()
		end
		nkPathBoxes[key].Highlight.FillColor = col
		nkPathBoxes[key].Highlight.OutlineColor = col
	end
	for key, b in pairs(nkPathBoxes) do
		if not seen[key] then
			nkPathBoxes[key] = nil
			task.spawn(function()
				pcall(function()
					FWNoModules.OwnTween(TweenService:Create(b, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Size = Vector3.new(0.1, 0.1, 0.1), Transparency = 1})):Play()
				end)
				task.delay(0.22, function() pcall(function() b:Destroy() end) end)
			end)
		end
	end
end

