FPSBooster = GameTab:CreateButton("FPS Booster", function(state)
	if state then
		-- Disable Global Shadows
		if FPSBooster.Values["Disable Global Shadows"] then
			fpsCache.GlobalShadows = game.Lighting.GlobalShadows
			game.Lighting.GlobalShadows = false
		end

		-- Disable Terrain Grass & Foliage
		if FPSBooster.Values["Disable Terrain Grass"] then
			pcall(function()
				fpsCache.TerrainDeco = G.Services.Workspace.Terrain.Decoration
				G.Services.Workspace.Terrain.Decoration = false
			end)
		end

		-- Simplify Water (Waves & Transparency)
		if FPSBooster.Values["Simplify Water"] then
			pcall(function()
				fpsCache.WaterProps.WaterWaveSize = G.Services.Workspace.Terrain.WaterWaveSize
				fpsCache.WaterProps.WaterWaveSpeed = G.Services.Workspace.Terrain.WaterWaveSpeed
				fpsCache.WaterProps.WaterTransparency = G.Services.Workspace.Terrain.WaterTransparency
				G.Services.Workspace.Terrain.WaterWaveSize = 0
				G.Services.Workspace.Terrain.WaterWaveSpeed = 0
				G.Services.Workspace.Terrain.WaterTransparency = 1
			end)
		end

		-- Optimize everything currently in the G.Services.Workspace
		for _, v in pairs(G.Services.Workspace:GetDescendants()) do
			optimizeObj(v)
		end

		-- Automatically optimize new things
		fpsConnection = G.Services.Workspace.DescendantAdded:Connect(optimizeObj)

		-- RENDER CULLING (CPU/GPU Trade-off)
		if FPSBooster.Values["Render Culling"] then
			fpsCache.CullingActive = true
			fpsCache.StaticParts = {}

			-- Cache all non-moving map parts
			for _, v in pairs(G.Services.Workspace:GetDescendants()) do
				if v:IsA("BasePart") and v.Anchored and v.Transparency < 1 then
					table.insert(fpsCache.StaticParts, {part = v, origTrans = v.LocalTransparencyModifier})
				end
			end

			-- Run a slow loop (0.5 second) to avoid frying the CPU while saving GPU
			task.spawn(function()
				while fpsCache.CullingActive do
					if not loops["fps booster"] then break end
					char = G.Services.Players.LocalPlayer.Character
					root = char and char:FindFirstChild("HumanoidRootPart")
					if root then
						myPos = root.Position
						distLimit = FPSBooster.Values["Cull Distance Slider"]
						for _, data in ipairs(fpsCache.StaticParts) do
							if data.part and data.part.Parent then
								if (data.part.Position - myPos).Magnitude > distLimit then
									data.part.LocalTransparencyModifier = 1
								else
									data.part.LocalTransparencyModifier = data.origTrans
								end
							end
						end
					end -- closed 'if root then'
					task.wait(0.5)
				end -- closed 'while fpsCache.CullingActive do'
			end) -- closed 'task.spawn'
		end -- closed 'if FPSBooster.Values["Render Culling"] then'

	else
		-- Turn off culling loop
		fpsCache.CullingActive = false

		-- Restore cull visibility
		if fpsCache.StaticParts then
			for _, data in ipairs(fpsCache.StaticParts) do
				if data.part and data.part.Parent then
					data.part.LocalTransparencyModifier = data.origTrans
				end
			end
			fpsCache.StaticParts = {}
		end

		-- Disconnect the auto-optimizer
		if fpsConnection then 
			fpsConnection:Disconnect()
			fpsConnection = nil 
		end

		-- Restore global shadow
		if fpsCache.GlobalShadows ~= nil then
			game.Lighting.GlobalShadows = fpsCache.GlobalShadows
			fpsCache.GlobalShadows = nil
		end

		-- Restore Terrain Grass
		if fpsCache.TerrainDeco ~= nil then
			pcall(function()
				G.Services.Workspace.Terrain.Decoration = fpsCache.TerrainDeco
				fpsCache.TerrainDeco = nil
			end)
		end

		-- Restore Water Properties
		if fpsCache.WaterProps.WaterWaveSize ~= nil then
			pcall(function()
				G.Services.Workspace.Terrain.WaterWaveSize = fpsCache.WaterProps.WaterWaveSize
				G.Services.Workspace.Terrain.WaterWaveSpeed = fpsCache.WaterProps.WaterWaveSpeed
				G.Services.Workspace.Terrain.WaterTransparency = fpsCache.WaterProps.WaterTransparency
				fpsCache.WaterProps = {}
			end)
		end

		-- Restore all cached properties precisely back to their original states
		for part, mat in pairs(fpsCache.PartsMat) do if part and part.Parent then part.Material = mat end end
		for part, shad in pairs(fpsCache.PartsShad) do if part and part.Parent then part.CastShadow = shad end end
		for tex, trans in pairs(fpsCache.Textures) do if tex and tex.Parent then tex.Transparency = trans end end
		for p, en in pairs(fpsCache.Particles) do if p and p.Parent then p.Enabled = en end end

		-- Clear caches
		fpsCache.PartsMat = setmetatable({}, {__mode = "k"})
		fpsCache.PartsShad = setmetatable({}, {__mode = "k"})
		fpsCache.Textures = setmetatable({}, {__mode = "k"})
		fpsCache.Particles = setmetatable({}, {__mode = "k"})
	end
end, true)

