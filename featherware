            inset = GuiService:GetGuiInset()
            screenPos = Vector2.new(mousePos.X,mousePos.Y)-inset
            localPos = (screenPos - adetundeData.mainFrame.AbsolutePosition)/FWNoModules.Mobile.ScaleOf(adetundeData.mainFrame)
			adetundeData.ghost.Position = UDim2.fromOffset(localPos.X - adetundeData.ghost.AbsoluteSize.X/(2*FWNoModules.Mobile.ScaleOf(adetundeData.mainFrame)), localPos.Y - adetundeData.ghost.AbsoluteSize.Y/(2*FWNoModules.Mobile.ScaleOf(adetundeData.mainFrame)))
		end
	end
end)

FWNoModules.Connect(UserInputService.InputEnded, function(input)
	if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and adetundeData.dragInfo then
        if input.UserInputType==Enum.UserInputType.Touch and input~=adetundeData.dragInfo.input then return end
        mousePos = input.UserInputType==Enum.UserInputType.Touch and input.Position or UserInputService:GetMouseLocation()
        inset = GuiService:GetGuiInset()
        screenPos = Vector2.new(mousePos.X,mousePos.Y)-inset

		targetSlot = nil
		for i = 1, 3 do
			f = adetundeData.slotFrames[i]
			if f then
				ap = f.AbsolutePosition
				as = f.AbsoluteSize
				if screenPos.X >= ap.X and screenPos.X <= ap.X + as.X and screenPos.Y >= ap.Y and screenPos.Y <= ap.Y + as.Y then
					targetSlot = i
					break
				end
			end
		end

		drag = adetundeData.dragInfo

		if targetSlot then
			existingInTarget = adetundeData.slotOrder[targetSlot]
			if drag.sourceType == "slot" then
				adetundeData.slotOrder[drag.sourceIndex] = existingInTarget
				adetundeData.slotOrder[targetSlot] = drag.upgradeType
			else
				for i = 1, 3 do
					if adetundeData.slotOrder[i] == drag.upgradeType then
						adetundeData.slotOrder[i] = nil
					end
				end
				adetundeData.slotOrder[targetSlot] = drag.upgradeType
			end
		else
			if drag.sourceType == "slot" then
				adetundeData.slotOrder[drag.sourceIndex] = nil
			end
		end

        if drag.scroll and drag.scroll.Parent then drag.scroll.ScrollingEnabled=drag.scrolling end
        adetundeData.dragInfo = nil
		if adetundeData.ghost then adetundeData.ghost:Destroy() adetundeData.ghost = nil end
		adetundeRender()
		adetundeSaveSettings() -- SAVE SLOT ORDER
	end
end)

adetundeUpgradeCycle = function()
	if adetundeData.complete then return end
	now = os.clock()
	if now - adetundeData.lastAttempt < 0.3 then return end
	adetundeData.lastAttempt = now

	adetundeData.crystalCache = adetundeGetCrystals()

	if adetundeAllMaxed() then
		adetundeData.complete = true
		adetundeRender()
		return
	end

	if adetundeData.crystalCache <= 0 then
		adetundeRender()
		return
	end

	for i = 1, 3 do
		upgradeType = adetundeData.slotOrder[i]
		if upgradeType and adetundeCanUpgrade(upgradeType) then
			success = adetundeTryUpgrade(upgradeType)
			if success then
				if adetundeAllMaxed() then
					adetundeData.complete = true
				end
				adetundeRender()
				return
			end
		end
	end
	adetundeRender()
end

