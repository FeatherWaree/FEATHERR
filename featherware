	local success, ItemMeta = pcall(function()
		return require(G.Services.RS.TS.item["item-meta"])
	end)

	if success and ItemMeta and ItemMeta.items then
		for itemType, itemData in pairs(ItemMeta.items) do
			local function tryExtract(src)
				if not src then return end
				if src.projectileType then
					ok1, res1 = pcall(src.projectileType)
					if ok1 and type(res1) == "string" then projectiles[res1] = true end

					if src.ammoItemTypes then
						for _, ammo in pairs(src.ammoItemTypes) do
							ok2, res2 = pcall(src.projectileType, ammo)
							if ok2 and type(res2) == "string" then projectiles[res2] = true end
						end
					end
				end
				if src.guidedProjectile then
					projectiles[src.guidedProjectile] = true
				end
			end

			tryExtract(itemData.projectileSource)
			tryExtract(itemData.guidedProjectileSource)

			if itemData.multiProjectileSource then
				for _, src in pairs(itemData.multiProjectileSource) do
					tryExtract(src)
				end
			end
		end
	end

	return projectiles
