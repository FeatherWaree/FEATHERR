function scaffoldIsBlockEmpty(gridPos)
	local worldPos = gridPos * 3
	local params = OverlapParams.new()
	params.FilterDescendantsInstances = {Player.Character}
	params.FilterType = Enum.RaycastFilterType.Exclude
	local parts = G.Services.Workspace:GetPartBoundsInBox(CFrame.new(worldPos), Vector3.new(2.8, 2.8, 2.8), params)
	for _, p in ipairs(parts) do
		if p.CanCollide and not p:IsDescendantOf(Player.Character) then
			return false -- A solid block already exists here
		end
	end
	return true
end
function scaffoldPlaceBlock(newGridPos, targetGridPos)
	if not sm_placeRemote then return end

	-- Calculate the hit normal based on which face of the target block we are clicking
	local diff = newGridPos - targetGridPos
	local hitNormal = Vector3.new(0, 1, 0)
	if diff.Y == 1 then hitNormal = Vector3.new(0, 1, 0)
	elseif diff.Y == -1 then hitNormal = Vector3.new(0, -1, 0)
	elseif diff.X == 1 then hitNormal = Vector3.new(1, 0, 0)
	elseif diff.X == -1 then hitNormal = Vector3.new(-1, 0, 0)
	elseif diff.Z == 1 then hitNormal = Vector3.new(0, 0, 1)
	elseif diff.Z == -1 then hitNormal = Vector3.new(0, 0, -1)
	end

	local targetWorldPos = targetGridPos * 3
	local hitPosition = targetWorldPos + (hitNormal * 1.5)
	local blockType = Scaffold.Values["Block Type"] or "wool_white"

	-- Exact game arguments for placing a block
	local args = {
		position = Vector3.new(newGridPos.X, newGridPos.Y, newGridPos.Z),
		blockType = blockType,
		blockData = 0,
		mouseBlockInfo = {
			target = {
				blockRef = { blockPosition = Vector3.new(targetGridPos.X, targetGridPos.Y, targetGridPos.Z) },
				hitPosition = hitPosition,
				hitNormal = hitNormal,
			},
			placementPosition = Vector3.new(newGridPos.X, newGridPos.Y, newGridPos.Z),
		},
	}

	pcall(function()
		sm_placeRemote:InvokeServer(args)
	end)
end

scaffoldLoopConn = nil

function scaffoldLoop()
	local char = Player.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum then return end

	scaffoldUpdateCounter()

	local feetPos = hrp.Position - Vector3.new(0, 2.5, 0)
	local gridBelow = Vector3.new(math.round(feetPos.X / 3), math.round(feetPos.Y / 3), math.round(feetPos.Z / 3))

	local placed = false

	-- Tower: Place directly below
	if Scaffold.Values["Tower"] then
		if scaffoldIsBlockEmpty(gridBelow) then
			local targetGrid = gridBelow + Vector3.new(0, 1, 0)
			if not scaffoldIsBlockEmpty(targetGrid) then
				scaffoldPlaceBlock(gridBelow, targetGrid)
				placed = true
			end
		end
	end

	-- Expand: Place behind the player based on movement direction
	if not placed and Scaffold.Values["Expand"] then
		local moveDir = hum.MoveDirection
		if moveDir.Magnitude > 0.1 then
			local dirGrid = Vector3.new(math.round(moveDir.X), 0, math.round(moveDir.Z))
			if dirGrid.Magnitude > 0 then
				local gridBehind = gridBelow - dirGrid
				if scaffoldIsBlockEmpty(gridBehind) then
					local targetGrid = gridBehind + dirGrid
					if not scaffoldIsBlockEmpty(targetGrid) then
						scaffoldPlaceBlock(gridBehind, targetGrid)
					end
				end
			end
		end
	end

	-- Safe Walk: Prevent walking off edges
	if Scaffold.Values["Safe Walk"] then
		local moveDir = hum.MoveDirection
		if moveDir.Magnitude > 0.1 then
			local dirGrid = Vector3.new(math.round(moveDir.X), 0, math.round(moveDir.Z))
			if dirGrid.Magnitude > 0 then
				local gridAhead = gridBelow + dirGrid
				if scaffoldIsBlockEmpty(gridAhead) then
					local belowAhead = gridAhead - Vector3.new(0, 1, 0)
					if scaffoldIsBlockEmpty(belowAhead) then
						hum.WalkSpeed = math.min(hum.WalkSpeed, 8)
					end
				end
			end
		end
	end

	-- Sprint
	if Scaffold.Values["Sprint"] then
		if canRequire and SprintController then
			SprintController.attemptingSprint = true
			SprintController:startSprinting()
		end
	end
end

