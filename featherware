bountyApply = function()
	if not canRequire then return end
	if not bountyLoad() then return end

	active = loops["auto bounty hunter"] == true

	if active and not bountyData.storeConnection then
		bountyData.storeConnection = bountyData.store.changed:connect(function(newState)
			newTarget = newState.Kit and newState.Kit.bountyHunterTarget or nil
			if newTarget ~= bountyData.currentTarget then
				bountyData.currentTarget = newTarget
				if bountySettings.targetESP and loops["auto bounty hunter"] then
					bountyCleanupESP()
					bountyStartESP()
				end
				if bountySettings.targetHUD and loops["auto bounty hunter"] then
					bountyCleanupHUD()
					bountyStartHUD()
				end
				if bountySettings.autoReroll and loops["auto bounty hunter"] and newTarget then
					shouldReroll = false
					if not newTarget.Character or not newTarget.Character.Parent then
						shouldReroll = true
					end
					if shouldReroll and tick() - bountyData.lastRerollTime > 3 then
						bountyData.lastRerollTime = tick()
						pcall(function()
							bountyData.rerollRemote:FireServer("bounty_hunter_reroll")
						end)
					end
				end
			end
		end)

		state = bountyData.store:getState()
		bountyData.currentTarget = state and state.Kit and state.Kit.bountyHunterTarget or nil
		if bountyData.currentTarget and bountySettings.targetESP then
			bountyStartESP()
		end
		if bountyData.currentTarget and bountySettings.targetHUD then
			bountyStartHUD()
		end
	end

	if not active then
		bountyDisconnectStore()
		bountyCleanupESP()
		bountyCleanupHUD()
		bountyData.currentTarget = nil
		return
	end

	if bountySettings.targetESP and not bountyData.espConnection and bountyData.currentTarget then
		bountyStartESP()
	end
	if bountySettings.targetHUD and not bountyData.hudConnection and bountyData.currentTarget then
		bountyStartHUD()
	end
	if not bountySettings.targetESP and bountyData.espConnection then
		bountyCleanupESP()
	end
	if not bountySettings.targetHUD and bountyData.hudConnection then
		bountyCleanupHUD()
	end
end

