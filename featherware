						castTrack:Play()
						task.delay(1.2, function() castAnim:Destroy() end)
					end
					randomShotId = generateRandomString(8)
					randomCode = generateRandomString(8)
					launchOrigin = rootPart.Position + (launchDirection * 3)
					originX, originY, originZ = launchOrigin.X, launchOrigin.Y + 0.5, launchOrigin.Z
					velocityX = launchDirection.X * 12
					velocityY = 4.45
					velocityZ = launchDirection.Z * 12
					fireArgs = { [1] = inventoryRod, [3] = "fisherman_bobber", [4] = vec(originX, originY, originZ), [5] = vec(originX, originY - 2, originZ), [6] = vec(velocityX, velocityY, velocityZ), [7] = randomCode, [8] = { shotId = randomShotId, drawDurationSec = 0 }, [9] = G.Services.Workspace:GetServerTimeNow() }
					pcall(function() if ProjectileRemote then ProjectileRemote:InvokeServer(unpack(fireArgs, 1, 9)) end end)
					task.wait(0.8)
					if playAnims and loops["auto fish"] then
						idleAnim = Instance.new("Animation")
						idleAnim.AnimationId = "rbxassetid://7789132571"
						idleLoopTrack = animator:LoadAnimation(idleAnim)
						idleLoopTrack.Looped = true
						idleLoopTrack:Play()
					end
					initialPosition = rootPart.Position
					interrupted = false
					minigameApp = nil
					waitTimer = 0
					minigameWaitTime = (AutoFish.Values and AutoFish.Values["Minigame Wait Time"]) or 1.5
					while waitTimer < 10 and loops["auto fish"] do
