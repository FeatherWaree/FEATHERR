local oldChestESPToggle = ChestESP.Callbacks.OnToggle
ChestESP.Callbacks.OnToggle = function(state)
	if oldChestESPToggle then oldChestESPToggle(state) end
	loops["chest esp"] = state
	if chestEspThread then task.cancel(chestEspThread) chestEspThread = nil end
	if loops["chest esp"] then
		chestEspThread = task.spawn(function()
			while loops["chest esp"] do
				chests = findNearbyContainers(CHEST_ESP_RANGE, true)
				currentlyVisibleChests = {}
				for _, chestPart in pairs(chests) do
					chestInventoryFolder = nil
					for _, object in pairs(chestPart:GetChildren()) do
						if object.Name == "ChestFolderValue" then chestInventoryFolder = object.Value break end
					end
					if chestInventoryFolder then
						items = asGetFilteredItems(chestInventoryFolder)
						if #items > 0 then
							currentlyVisibleChests[chestPart] = true
							if not activeESPs[chestPart] then activeESPs[chestPart] = createChestESP(chestPart) end
							updateChestESP(activeESPs[chestPart], items)
						end
					end
				end
				for chestPart, gui in pairs(activeESPs) do
					if not currentlyVisibleChests[chestPart] or not chestPart.Parent then
						gui:Destroy()
						activeESPs[chestPart] = nil
					end
				end
				task.wait(0.5)
			end
			for chestPart, gui in pairs(activeESPs) do gui:Destroy() end
			table.clear(activeESPs)
			chestEspThread = nil
		end)										
	else
		for chestPart, gui in pairs(activeESPs) do gui:Destroy() end
		table.clear(activeESPs)
	end
end
