function ntBindCharacter(plr, char)
	nt_d = nt_objects[plr]
	if not nt_d then return end

	ntHead = char:WaitForChild("Head", 5) or char:WaitForChild("HumanoidRootPart", 5)
	if ntHead then
		nt_d.bb.Adornee = ntHead
	end

	ntHum = char:WaitForChild("Humanoid", 5)
	if ntHum then
		if nt_d.healthConn then nt_d.healthConn:Disconnect() end
		nt_d.healthConn = FWNoModules.Connect(ntHum.HealthChanged, function(health)
			ntPct = math.clamp(health / math.max(ntHum.MaxHealth, 1), 0, 1)
			nt_d.fill.Size = UDim2.fromScale(ntPct, 1)
			nt_d.hp.Text = tostring(math.round(health))
		end)
		ntPct = math.clamp(ntHum.Health / math.max(ntHum.MaxHealth, 1), 0, 1)
		nt_d.fill.Size = UDim2.fromScale(ntPct, 1)
		nt_d.hp.Text = tostring(math.round(ntHum.Health))
	end

	ntUpdateTagVisuals(plr)
end

