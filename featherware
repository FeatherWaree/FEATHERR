function panicOnClick()
	panic_now = tick()
	if panic_lastClick ~= 0 and panic_now - panic_lastClick <= panic_DOUBLE then
		panic_hintToken = panic_hintToken + 1
		panic_lastClick = 0
		panicTurnOffAll()
		panicResetAllKeys()
		for panic_k in pairs(loops) do loops[panic_k] = false end
		pcall(NotificationSystem.Notify, "Panic", "all modules and hotkeys reset", 1)
