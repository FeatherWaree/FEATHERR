function chamsReconcile()
	chams_desired = {}

	if Chams.Values["Target Players"] then
		for _, chams_pl in pairs(Players:GetPlayers()) do
			if chams_pl ~= Player then
				chams_c = chams_pl.Character
				if chams_c then
					chams_hum = chams_c:FindFirstChildOfClass("Humanoid")
					if chams_hum and chams_hum.Health > 0 then
						chams_sameTeam = (chams_pl.Team ~= nil and Player.Team ~= nil and chams_pl.Team == Player.Team)
						chams_isSpec = (chams_pl.Team ~= nil and tostring(chams_pl.Team.Name):lower():find("spectat") ~= nil)
						if not chams_sameTeam and not chams_isSpec then
							chams_desired[chams_c] = true
						end
					end
				end
			end
		end
	end

	if Chams.Values["Target NPCs/Dummies"] then
		for _, chams_m in ipairs(EntityCache.npcs) do
			if chams_m and chams_m.Parent then
				chams_hum2 = chams_m:FindFirstChildOfClass("Humanoid")
				if chams_hum2 and chams_hum2.Health > 0 then chams_desired[chams_m] = true end
			end
		end
	end

	for chams_m, chams_hl in pairs(chams_active) do
		if not chams_desired[chams_m] or not chams_m.Parent then
			pcall(function() chams_hl:Destroy() end)
			chams_active[chams_m] = nil
		end
	end

	for chams_m in pairs(chams_desired) do
		chams_hl = chams_active[chams_m]
		if not chams_hl or not chams_hl.Parent then chamsMake(chams_m) end
	end

	chams_fc = chamsV("Cham Color", Color3.fromRGB(140, 120, 255))
	chams_oc = chamsV("Outline Color", Color3.fromRGB(255, 255, 255))
	chams_ft = chamsV("Cham Transparency", 0.5)
	chams_ot = chamsV("Outline Transparency", 0)
	if chams_fc ~= chams_lastFC or chams_oc ~= chams_lastOC or chams_ft ~= chams_lastFT or chams_ot ~= chams_lastOT then
		for _, chams_hl in pairs(chams_active) do
			chams_hl.FillColor = chams_fc
			chams_hl.OutlineColor = chams_oc
			chams_hl.FillTransparency = chams_ft
			chams_hl.OutlineTransparency = chams_ot
		end
		chams_lastFC = chams_fc; chams_lastOC = chams_oc; chams_lastFT = chams_ft; chams_lastOT = chams_ot
	end
end

Chams.Callbacks.OnToggle = function(state)
	loops["chams"] = state
	if state then
		startEntityCache()
		chams_gen = chams_gen + 1
		pcall(chamsReconcile)
		task.spawn(function(g)
			while loops["chams"] and chams_gen == g do
				pcall(chamsReconcile)
				task.wait(0.15)
			end
		end, chams_gen)
	else
		for chams_m, chams_hl in pairs(chams_active) do pcall(function() chams_hl:Destroy() end) end
		chams_active = {}
	end
end



