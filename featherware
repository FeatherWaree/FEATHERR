kaliyahCheckAndPunch = function(targetUserId, stacks)
	if stacks < kaliyahSettings.punchAtStacks then return end

	targetPlayer = Players:GetPlayerByUserId(targetUserId)
	if not targetPlayer or not targetPlayer.Character then return end

	myChar = Players.LocalPlayer.Character
	if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end

	targetHRP = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not targetHRP then return end

	dist = (targetHRP.Position - myChar.HumanoidRootPart.Position).Magnitude
	if dist > kaliyahSettings.punchRange then 
		return 
	end

	kaliyahFirePunch()
end

kaliyahSetupWithRequire = function()
	knit = kaliyahGetKnit()
	if not knit or not knit.Controllers then 
		print("[Kaliyah] KnitClient or Controllers not found. Cooldown tracking disabled.")
		return false 
	end

	if not kaliyahData.cooldownConn then
		pcall(function()
			cooldownController = knit.Controllers.CooldownController
			if cooldownController then
				kaliyahData.canPunch = true

				kaliyahData.cooldownConn = G.Services.RunService.Heartbeat:Connect(function()
					if not loops["auto kaliyah"] then return end

					remaining = cooldownController:getRemainingCooldown("DRAGON_SLAYER_PUNCH")

					local isReady = remaining <= 0

					if isReady then
						kaliyahData.canPunch = true
						-- Try to punch anyone who has enough stacks
						for userId, stacks in pairs(kaliyahData.targetStacks) do
							if stacks >= kaliyahSettings.punchAtStacks then
								kaliyahCheckAndPunch(userId, stacks)
								break -- Only punch one person per frame
							end
						end
					else
						kaliyahData.canPunch = false
					end
				end)
			else
			end
		end)
	end

	return true
end

kaliyahApply = function()
	if not loops["auto kaliyah"] then
		kaliyahCleanup()
		return
	end

	if not kaliyahLoadRemotes() then 
		return 
	end

	if not kaliyahData.stacksConnection then
		print("[Kaliyah] Hooking into UpdateDragonSlayerStacks...")
		kaliyahData.stacksConnection = kaliyahData.stacksRemote.OnClientEvent:Connect(function(data)
			-- entire callback wrapped so nothing from our side can ever error
			pcall(function()
				if typeof(data) ~= "table" then return end
				if data.kitUser ~= Players.LocalPlayer.UserId then return end

				target = data.target

				-- safely extract UserId whether it's a Player or a Dummy/Model
				local targetUserId = nil
				if typeof(target) == "Instance" then
					if target:IsA("Player") then
						targetUserId = target.UserId
					elseif target:IsA("Model") or target:IsA("BasePart") then
						-- If it's a dummy, try to find the player from the character, or skip if it's a pure NPC
						local plr = Players:GetPlayerFromCharacter(target)
						if plr then
							targetUserId = plr.UserId
						else
							-- It's a dummy/NPC. We can't track stacks by UserId easily without EntityUtil.
							-- For now, we skip dummies to prevent the crash, but we don't error out.
							return 
						end
					end
				end

				if type(targetUserId) ~= "number" then return end

				stacks = tonumber(data.stacks) or 0

				print("[Kaliyah] Stack update for UserID " .. targetUserId .. ": " .. stacks .. " stacks")

				if stacks == 0 then
					kaliyahData.targetStacks[targetUserId] = nil
				else
					kaliyahData.targetStacks[targetUserId] = stacks
				end

				if stacks >= kaliyahSettings.punchAtStacks then
					if canRequire and kaliyahData.knit then
						if kaliyahData.canPunch then
							kaliyahCheckAndPunch(targetUserId, stacks)
						end
					else
						kaliyahCheckAndPunch(targetUserId, stacks)
