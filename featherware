        items[item] = true
    end
    function FWNoModules.CancelFeature(owner)
        if runtime.UpdateFeatureHooks then runtime.UpdateFeatureHooks(owner,false)end
        for tween in pairs((runtime.featureTweens or {})[owner]or{})do pcall(function()tween:Cancel()end)end
        if runtime.featureTweens then runtime.featureTweens[owner]=nil end
        local current = coroutine.running()
        if owner.ProfileStartupTask and owner.ProfileStartupTask~=current then
            pcall(scope.cancel,owner.ProfileStartupTask);owner.ProfileStartupTask=nil
        end
        for thread in pairs(runtime.featureTasks[owner] or {}) do
            if thread ~= current then pcall(nativeTask.cancel, thread); runtime.tasks[thread] = nil; runtime.owners[thread] = nil end
        end
        runtime.featureTasks[owner] = nil
        for connection in pairs(runtime.featureConnections[owner] or {}) do connection:Disconnect(); runtime.connections[connection] = nil end
        runtime.featureConnections[owner] = nil
        for name, item in pairs(runtime.bindingOwners) do
            if item == owner then local service=runtime.bindings[name];if service then pcall(function()service:UnbindFromRenderStep(name)end)end;runtime.bindingOwners[name]=nil;runtime.bindings[name]=nil end
        end
    end
    function FWNoModules.WithSessionOwner(callback,...)
        local thread=coroutine.running()
        local previous=thread and runtime.owners[thread]
        if thread then runtime.owners[thread]=nil end
        local result=table.pack(pcall(callback,...))
        if thread then runtime.owners[thread]=previous end
        if not result[1]then error(result[2],0)end
        return table.unpack(result,2,result.n)
    end
    function FWNoModules.CleanupFeatureObjects(owner)
            for object in pairs(runtime.featureObjects[owner] or {})do
                pcall(function()
                    if object:IsA("AnimationTrack") then object:Stop();return end
                    if object:IsA("GuiObject")or object:IsA("LayerCollector")or object:IsA("UIComponent")or object:IsA("Animation")then return end
                    if object.Parent==nil or object.Parent==game:GetService("Lighting")then return end
                    object:Destroy();runtime.objects[object]=nil
                end)
            end
            runtime.featureObjects[owner]=nil
    end
    function FWNoModules.RunModuleCallbacks(owner, constructor, state)
        if not state then FWNoModules.CancelFeature(owner)
        elseif runtime.UpdateFeatureHooks then runtime.UpdateFeatureHooks(owner,true)end
        local thread = coroutine.running()
        local previous = thread and runtime.owners[thread]
        if thread then runtime.owners[thread] = state and owner or nil end
        local failure
        if constructor then local ok, problem=pcall(constructor,state);if not ok then failure=problem end end
        if owner.Callbacks.OnToggle then local ok,problem=pcall(owner.Callbacks.OnToggle,state);if not ok then failure=failure or problem end end
        if thread then runtime.owners[thread] = previous end
        if not state then FWNoModules.CleanupFeatureObjects(owner)end
        return failure==nil,failure
    end

    local function completed(thread)
        runtime.tasks[thread] = nil
        local owner=runtime.owners[thread]
        if owner and runtime.featureTasks[owner] then runtime.featureTasks[owner][thread]=nil end
        runtime.owners[thread]=nil
    end
    local function schedule(method, duration, callback, ...)
        local thread
        if not runtime.active then
            thread = coroutine.create(function() end)
            coroutine.resume(thread)
            return thread
        end
        if type(callback) == "thread" then
            thread = callback
        else
            thread = coroutine.create(function(...)
                if not runtime.active then completed(coroutine.running()); return end
                local ok, problem = pcall(callback, ...)
                completed(coroutine.running())
                if not ok then error(problem, 0) end
            end)
        end
        runtime.tasks[thread] = true
        local parent=coroutine.running()
        local owner=parent and runtime.owners[parent]
        runtime.owners[thread]=owner
        markFeature(runtime.featureTasks,owner,thread)
