        })
        if referenceEarliest then
            adjusterEarliest=math.max(adjusterEarliest,referenceEarliest)
            if kaSync.locked then kaPacer.NextSlot=referenceEarliest;kaPacer.Interval=attackDelay end
        end
        kaPacer.EffectiveInterval=attackDelay
        -- The explicit weapon-cooldown and Hit Reg Adjuster settings keep precedence.
		if kaPacer:Ready(attackNow, attackDelay, minimumGap, adjusterEarliest) then

			-- BYPASS THE 9 CPS HARDCAP ONLY WHEN FIRING (Fixes manual swing cooldown)
