-- ===== TARGET TRACKING (prediction) =====

function vaResetTracking()
	va_posHistory = {}
	va_smoothVel = Vector3.new(0, 0, 0)
	va_groundedResult = true
	va_groundedFrame = 0
end

function vaAddToHistory(pos, t)
	table.insert(va_posHistory, { pos = pos, t = t })
	while #va_posHistory > 15 do table.remove(va_posHistory, 1) end
end

function vaCalcAvgVel()
	if #va_posHistory < 2 then return va_smoothVel end
	va_newest = va_posHistory[#va_posHistory]
	va_oldest = va_posHistory[1]
	va_dt = va_newest.t - va_oldest.t
	if va_dt < 0.01 then return va_smoothVel end
	va_rawVel = (va_newest.pos - va_oldest.pos) / va_dt
	va_smoothVel = va_smoothVel:Lerp(va_rawVel, 0.3)
	return va_smoothVel
end

function vaIsGrounded(root, model)
	va_groundParams.FilterDescendantsInstances = { model }
	va_hit = G.Services.Workspace:Raycast(root.Position - Vector3.new(0, 1, 0), Vector3.new(0, -4, 0), va_groundParams)
	return va_hit ~= nil
end

function vaPredictPos(root, origin, model)
	vaAddToHistory(root.Position, os.clock())
	va_vel = vaCalcAvgVel()
	va_groundedFrame = va_groundedFrame + 1
	if va_groundedFrame >= 3 then
		va_groundedFrame = 0
		va_groundedResult = vaIsGrounded(root, model)
	end
	va_dist = (root.Position - origin).Magnitude
	va_bulletSpeed = VulcanAimbot.Values["Bullet Speed"] or 500
	if va_bulletSpeed < 1 then va_bulletSpeed = 1 end
	va_leadTime = va_dist / va_bulletSpeed
	-- horizontal lead catches strafing (tangential velocity component)
	va_predX = root.Position.X + va_vel.X * va_leadTime
	va_predZ = root.Position.Z + va_vel.Z * va_leadTime
	-- vertical: if airborne, compensate for gravity arc (jumping/falling)
	if va_groundedResult then
		va_predY = root.Position.Y
	else
		va_predY = root.Position.Y + va_vel.Y * va_leadTime - 0.5 * G.Services.Workspace.Gravity * va_leadTime * va_leadTime
	end
	return Vector3.new(va_predX, va_predY, va_predZ)
end

-- ===== TARGET FINDING (with sticky target) =====

function vaFindBestTarget(turret, origin, range)
	va_cam = G.Services.Workspace.CurrentCamera
	if not va_cam then return nil, nil, math.huge end
	va_lookDir = va_cam.CFrame.LookVector
	va_bestModel = nil
	va_bestRoot = nil
	va_bestAngle = math.huge

	if VulcanAimbot.Values["Target Players"] then
		for _, va_plr in ipairs(FWNoModules.PlayerSnapshot()) do
			if va_plr ~= Player and va_plr.Character then
				va_hum = va_plr.Character:FindFirstChildOfClass("Humanoid")
				va_root = va_plr.Character:FindFirstChild("HumanoidRootPart")
				if va_hum and va_root and va_hum.Health > 0 then
					if not vaIsTeamSafe(va_plr) then continue end
					va_dist = (va_root.Position - origin).Magnitude
					if va_dist <= range then
						if not vaWallClear(origin, va_root.Position, turret, va_plr.Character) then continue end
						va_toT = (va_root.Position - origin).Unit
						va_ang = math.acos(math.clamp(va_lookDir:Dot(va_toT), -1, 1))
						if va_ang < va_bestAngle then
							va_bestAngle = va_ang
							va_bestModel = va_plr.Character
							va_bestRoot = va_root
						end
					end
				end
			end
		end
	end

	if VulcanAimbot.Values["Target NPCs/Dummies"] then
		va_now2 = os.clock()
		if va_now2 - va_lastNpcScan >= 2 then
			va_lastNpcScan = va_now2
			pcall(vaScanNpcs)
		end
		for _, va_npc in ipairs(va_npcCache) do
			if va_npc.Parent then
				va_hum = va_npc:FindFirstChildOfClass("Humanoid")
				va_root = va_npc:FindFirstChild("HumanoidRootPart")
				if va_hum and va_root and va_hum.Health > 0 then
					va_dist = (va_root.Position - origin).Magnitude
					if va_dist <= range then
						if not vaWallClear(origin, va_root.Position, turret, va_npc) then continue end
						va_toT = (va_root.Position - origin).Unit
						va_ang = math.acos(math.clamp(va_lookDir:Dot(va_toT), -1, 1))
						if va_ang < va_bestAngle then
							va_bestAngle = va_ang
							va_bestModel = va_npc
							va_bestRoot = va_root
						end
					end
				end
			end
		end
	end

	return va_bestModel, va_bestRoot, va_bestAngle
end

function vaResolveTarget(turret, origin, range)
	va_bestModel, va_bestRoot, va_bestAngle = vaFindBestTarget(turret, origin, range)

	if VulcanAimbot.Values["Sticky Target"] and va_currentTargetModel and va_currentTargetModel.Parent then
		va_curRoot = va_currentTargetModel:FindFirstChild("HumanoidRootPart")
		va_curHum = va_currentTargetModel:FindFirstChildOfClass("Humanoid")
		if va_curRoot and va_curHum and va_curHum.Health > 0 then
			va_curDist = (va_curRoot.Position - origin).Magnitude
			va_curValid = va_curDist <= range
			if va_curValid and VulcanAimbot.Values["Ignore Behind Walls"] then
				va_curValid = vaWallClear(origin, va_curRoot.Position, turret, va_currentTargetModel)
			end
			if va_curValid then
				va_cam2 = G.Services.Workspace.CurrentCamera
				if va_cam2 then
					va_lookDir2 = va_cam2.CFrame.LookVector
					va_curAngle = math.acos(math.clamp(va_lookDir2:Dot((va_curRoot.Position - origin).Unit), -1, 1))
					va_threshold = math.rad(VulcanAimbot.Values["Switch Threshold"] or 5)
					if va_bestModel and va_bestModel ~= va_currentTargetModel and va_bestAngle < va_curAngle - va_threshold then
						va_currentTargetModel = va_bestModel
						vaResetTracking()
					end
				end
				return va_currentTargetModel
			end
		end
		va_currentTargetModel = va_bestModel
		vaResetTracking()
		return va_bestModel
	end

	if va_currentTargetModel ~= va_bestModel then vaResetTracking() end
	va_currentTargetModel = va_bestModel
	return va_bestModel
end

-- ===== MAIN LOOP =====

VulcanAimbot.Callbacks.OnToggle = function(state)
	loops["vulcan aimbot"] = state
	if not state then
		va_gen = va_gen + 1
		va_currentTargetModel = nil
		vaResetTracking()
		return
	end
	va_myGen = va_gen
	va_conn = FWNoModules.TrackFrameConnection(G.Services.RunService.RenderStepped:Connect(function()
		if not loops["vulcan aimbot"] or va_myGen ~= va_gen then return end

		va_turret = vaGetTurret()
		if not va_turret or not va_turret.Parent then
			va_currentTargetModel = nil
			vaResetTracking()
			return
		end
		va_rot = va_turret:FindFirstChild("Rotate")
		if not va_rot then return end
		va_origin = va_rot.Position
		va_range = VulcanAimbot.Values["Range"] or 500

		va_targetModel = vaResolveTarget(va_turret, va_origin, va_range)
		if not va_targetModel or not va_targetModel.Parent then return end
		va_targetRoot = va_targetModel:FindFirstChild("HumanoidRootPart")
		va_targetHum = va_targetModel:FindFirstChildOfClass("Humanoid")
		if not va_targetRoot or not va_targetHum or va_targetHum.Health <= 0 then
			va_currentTargetModel = nil
			vaResetTracking()
			return
		end

		if VulcanAimbot.Values["Prediction"] then
			va_aimPos = vaPredictPos(va_targetRoot, va_origin, va_targetModel)
		else
			va_aimPos = va_targetRoot.Position
		end

		va_yaw, va_pitch = vaCalcAngles(va_origin, va_aimPos)
		if not va_yaw then return end

		pcall(function()
			va_rot.CFrame = CFrame.new(va_rot.Position) * CFrame.Angles(0, va_yaw, 0) * CFrame.Angles(va_pitch, 0, 0)
		end)
		va_head = va_turret:FindFirstChild("Head")
		if va_head then
			va_camOrigin = va_head:FindFirstChild("CameraOrigin")
			if va_camOrigin and G.Services.Workspace.CurrentCamera then
				pcall(function() G.Services.Workspace.CurrentCamera.CFrame = va_camOrigin.WorldCFrame end)
			end
		end

		va_now3 = os.clock()
		if va_now3 - va_lastSend >= 0.2 and va_aimRemote then
			va_lastSend = va_now3
			pcall(function()
				va_aimRemote:FireServer({
					angleX = math.deg(va_yaw % (2 * math.pi)),
					turretBlockPos = vaBlockPos(va_turret),
					angleY = math.deg(va_pitch),
				})
			end)
		end
	end))
end


