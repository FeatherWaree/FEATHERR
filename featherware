										pcall(function()
											useAbility:FireServer("SLIME_DIRECT")
										end)

										task.wait(0.05)

										-- Move slime to target
										pcall(function()
											noelleData.requestMoveSlime:InvokeServer({slimeId = slimeId, targetPlayerUserId = targetPlayer.UserId})
										end)

										task.wait(0.10) -- 0.10s delay between giving multiple slimes
