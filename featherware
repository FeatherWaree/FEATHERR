-- ULTRA OPTIMIZED TARGET FINDER (No GetDescendants lag)
emberGetTarget = function()
	myChar = PlayersService.LocalPlayer.Character
	if not myChar then return nil end
	myRoot = myChar:FindFirstChild("HumanoidRootPart")
	if not myRoot then return nil end

	bestTarget = nil
	bestDist = emberSettings.range

	-- Scan Players (Very fast, max 40 players)
	if emberSettings.targetMode == "Players" or emberSettings.targetMode == "Both" then
		for _, plr in ipairs(PlayersService:GetPlayers()) do
			if plr ~= PlayersService.LocalPlayer and (not plr.Team or not PlayersService.LocalPlayer.Team or plr.Team ~= PlayersService.LocalPlayer.Team) then
				char = plr.Character
				if char then
					root = char:FindFirstChild("HumanoidRootPart")
					hum = char:FindFirstChildOfClass("Humanoid")
					if root and hum and hum.Health > 0 then
						dist = (root.Position - myRoot.Position).Magnitude
						if dist <= bestDist then
							bestDist = dist
							bestTarget = plr
						end
					end
				end
			end
		end
	end

	-- Scan NPCs (Optimized: Only checks top-level models in G.Services.Workspace, NOT all descendants)
	if emberSettings.targetMode == "NPCs" or emberSettings.targetMode == "Both" then
		for _, obj in ipairs(G.Services.Workspace:GetChildren()) do
			if obj:IsA("Model") and not PlayersService:GetPlayerFromCharacter(obj) then
				hum = obj:FindFirstChildOfClass("Humanoid")
				root = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
				if hum and root and hum.Health > 0 then
					dist = (root.Position - myRoot.Position).Magnitude
					if dist <= bestDist then
						bestDist = dist
						bestTarget = obj
					end
				end
			end
		end
	end

	return bestTarget
end

