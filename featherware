kaliyahFirePunch = function()
	if not kaliyahData.abilityRemote then 
		warn("[Kaliyah] Cannot fire punch: abilityRemote is nil!")
		return 
	end

	now = os.clock()
	if now - kaliyahData.lastPunch < 0.05 then return end
	kaliyahData.lastPunch = now

	print("[Kaliyah] Firing punch remote!")
