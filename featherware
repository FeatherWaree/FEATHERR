VulcanAimbot.Callbacks.OnToggle = function(state)
	loops["vulcan aimbot"] = state
	if not state then
		va_gen = va_gen + 1
		va_currentTargetModel = nil
		vaResetTracking()
		return
	end
	va_myGen = va_gen
	print("[VulcanAimbot] ON | AimTurret:", va_aimRemote ~= nil, "| BlockEngine:", va_blockEngine ~= nil, "| ClientStore:", va_clientStore ~= nil)
	va_conn = G.Services.RunService.RenderStepped:Connect(function()
		if not loops["vulcan aimbot"] or va_myGen ~= va_gen then return end

		va_turret = vaGetTurret()
		if not va_turret or not va_turret.Parent then
			va_currentTargetModel = nil
			vaResetTracking()
			return
		end
		va_rot = va_turret:FindFirstChild("Rotate")
		if not va_rot then return end
		va_origin = va_rot.Position
		va_range = VulcanAimbot.Values["Range"] or 500

		va_targetModel = vaResolveTarget(va_turret, va_origin, va_range)
		if not va_targetModel or not va_targetModel.Parent then return end
		va_targetRoot = va_targetModel:FindFirstChild("HumanoidRootPart")
		va_targetHum = va_targetModel:FindFirstChildOfClass("Humanoid")
		if not va_targetRoot or not va_targetHum or va_targetHum.Health <= 0 then
			va_currentTargetModel = nil
			vaResetTracking()
			return
		end

		if VulcanAimbot.Values["Prediction"] then
			va_aimPos = vaPredictPos(va_targetRoot, va_origin, va_targetModel)
		else
			va_aimPos = va_targetRoot.Position
		end

		va_yaw, va_pitch = vaCalcAngles(va_origin, va_aimPos)
		if not va_yaw then return end

		pcall(function()
			va_rot.CFrame = CFrame.new(va_rot.Position) * CFrame.Angles(0, va_yaw, 0) * CFrame.Angles(va_pitch, 0, 0)
		end)
		va_head = va_turret:FindFirstChild("Head")
		if va_head then
			va_camOrigin = va_head:FindFirstChild("CameraOrigin")
			if va_camOrigin and G.Services.Workspace.CurrentCamera then
				pcall(function() G.Services.Workspace.CurrentCamera.CFrame = va_camOrigin.WorldCFrame end)
			end
		end

		va_now3 = os.clock()
		if va_now3 - va_lastSend >= 0.2 and va_aimRemote then
			va_lastSend = va_now3
			pcall(function()
				va_aimRemote:FireServer({
					angleX = math.deg(va_yaw % (2 * math.pi)),
					turretBlockPos = vaBlockPos(va_turret),
					angleY = math.deg(va_pitch),
				})
			end)
		end
	end)
end




