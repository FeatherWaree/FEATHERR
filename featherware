	pcall(function()
		BedwarsKitMetaModule = require(G.Services.RS:WaitForChild("TS", 5):WaitForChild("games", 5):WaitForChild("bedwars", 5):WaitForChild("kit", 5):WaitForChild("bedwars-kit-meta", 5))
	end)
	pcall(function()
		ntRankMeta = require(G.Services.RS:WaitForChild("TS", 5):WaitForChild("rank", 5):WaitForChild("rank-meta", 5)).RankMeta
	end)

	task.spawn(function()
		pcall(function()
			ntFetchRanksRemote = G.Services.RS:WaitForChild("rbxts_include", 5):WaitForChild("node_modules", 5):WaitForChild("@rbxts", 5):WaitForChild("net", 5):WaitForChild("out", 5):WaitForChild("_NetManaged", 5):WaitForChild("FetchRanks", 5)
		end)
	end)

