-- 1. Helper to safely add to NPCs without duplicates
EC_AddNPC = function(instance)
	if not instance:IsA("Model") then return end
	if instance:FindFirstChildOfClass("Humanoid") then
		if not table.find(EntityCache.NPCs, instance) then
			table.insert(EntityCache.NPCs, instance)
		end
	end
end

-- 2. Helper to remove from NPCs
EC_RemoveNPC = function(instance)
	local nIdx = table.find(EntityCache.NPCs, instance)
	if nIdx then
		table.remove(EntityCache.NPCs, nIdx)
	end
end

-- 3. Initial Scan for all target NPC tags
EC_NpcTags = {"entity", "DiamondGuardian", "CryptBoss", "WarlockBoss", "trainingRoomDummy"}
for _, tag in ipairs(EC_NpcTags) do
	for _, inst in ipairs(EC_CS:GetTagged(tag)) do
		EC_AddNPC(inst)
	end
end

-- 4. Listen for NPC tags added/removed dynamically
EC_AddedConns = {}
EC_RemovedConns = {}

for _, tag in ipairs(EC_NpcTags) do
	table.insert(EC_AddedConns, EC_CS:GetInstanceAddedSignal(tag):Connect(EC_AddNPC))
	table.insert(EC_RemovedConns, EC_CS:GetInstanceRemovedSignal(tag):Connect(EC_RemoveNPC))
end

-- 5. PLAYER TRACKING (No CollectionService, tracks characters directly via Player events)
EC_AddPlayerChar = function(char)
	if char and char:IsA("Model") and char ~= localPlayer.Character then
		if not table.find(EntityCache.Players, char) then
			table.insert(EntityCache.Players, char)
		end
	end
end

EC_RemovePlayerChar = function(char)
	local pIdx = table.find(EntityCache.Players, char)
	if pIdx then
		table.remove(EntityCache.Players, pIdx)
	end
end

EC_SetupPlayer = function(plr)
	if plr.Character then
		EC_AddPlayerChar(plr.Character)
	end
	plr.CharacterAdded:Connect(function(newChar)
		EC_AddPlayerChar(newChar)
	end)
	plr.CharacterRemoving:Connect(function(oldChar)
		EC_RemovePlayerChar(oldChar)
	end)
end

-- Scan players already in the server
for _, plr in ipairs(EC_PlayersService:GetPlayers()) do
	EC_SetupPlayer(plr)
end

EC_PlayerAddedConn = EC_PlayersService.PlayerAdded:Connect(EC_SetupPlayer)

