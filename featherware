martinCheckRange = function()
	myChar = Players.LocalPlayer.Character
	if not myChar then return false end
	myRoot = myChar:FindFirstChild("HumanoidRootPart")
	if not myRoot then return false end

	maxRange = martinSettings.range or 15

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= Players.LocalPlayer and plr.Team ~= Players.LocalPlayer.Team and plr.Character then
			eRoot = plr.Character:FindFirstChild("HumanoidRootPart")
			eHum = plr.Character:FindFirstChildOfClass("Humanoid")
			if eRoot and eHum and eHum.Health > 0 then
				dist = (myRoot.Position - eRoot.Position).Magnitude
				if dist <= maxRange then
					return true
				end
			end
		end
	end
	return false
end

-- Method 1: Safe Hookmetamethod (Instant, only if canRequire is true and supported)
martinSetupHook = function()
	if martinData.hookActive then return end
	if not canRequire then return end
	if not hookmetamethod or not getnamecallmethod or not checkcaller then return end

	martinData.hookActive = true
	print("[Auto Martin] Executor supports hooks. Using safe __namecall detection.")

	martinData.oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
		-- CRITICAL: Always call the original function first and store the result
		-- This ensures the game's combat system never breaks
		local args = {...}
		local result = martinData.oldNamecall(self, unpack(args))

		-- Only run our logic if we aren't the ones calling it (prevents infinite loops)
		if not checkcaller() then
			pcall(function()
				method = getnamecallmethod()
				if method == "FireServer" or method == "InvokeServer" then
					remoteName = tostring(self)

					-- Catches both melee swings connecting and projectiles landing
					if remoteName == "SwordHit" or remoteName == "ProjectileHit" then
						if loops["auto martin"] and martinSettings.mode == "On Hit" then
							if martinCheckRange() then
								martinFireAbility()
							end
						end
					end
				end
			end)
		end

		-- CRITICAL: Return the original result so the game continues normally
		return result
	end)
end

-- Method 2: Fallback Loop (For In Range mode, or if hooks aren't supported)
martinStartLoop = function()
	if martinData.loopConn then return end

	martinData.loopConn = G.Services.RunService.Heartbeat:Connect(function()
		if not loops["auto martin"] then return end

		myChar = Players.LocalPlayer.Character
		myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")

		-- Handle In Range Mode continuously
		if martinSettings.mode == "In Range" then
			if martinCheckRange() then
				martinFireAbility()
			end
		end

		-- Fallback for On Hit Mode if hooks aren't supported
		if martinSettings.mode == "On Hit" and not martinData.hookActive then
			if myHum then
				if myHum.Health < martinData.lastHealth then
					if martinCheckRange() then
						martinFireAbility()
					end
				end
				martinData.lastHealth = myHum.Health
			else
				martinData.lastHealth = 100
			end
		end
	end)
end

