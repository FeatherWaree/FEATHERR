-- ANGLE: slider = full-circle value (360=all, 180=front half, 90=narrow cone)
function nkAngleOk(cam, point)
	val = Nuker.Values["Angle"] or 359
	if val >= 359 then return true end
	allowed = val / 2
	look = cam.CFrame.LookVector
	toB = (point - cam.CFrame.Position).Unit
	return math.deg(math.acos(math.clamp(look:Dot(toB), -1, 1))) <= allowed
end

