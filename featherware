    local blocker=make("TextButton",mainScreenUI,{Name="ProfileSwitch",Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,Text="",Visible=false,Active=true,ZIndex=100000})
    api.OnBusy=function(busy)blocker.Visible=busy;heading.Text=busy and "  Profiles · Switching..." or "  Profiles"end
    FWNoModules.OnCleanup(unsubscribe)
    render()
end

-- Texture detail reduction. No post-processing blur or render-step loop.
function FWNoModules.ReduceTexturePixels(pixels,sourceWidth,sourceHeight,width,height,checkpoint)
    assert(buffer.len(pixels)==sourceWidth*sourceHeight*4,"Unexpected source pixel buffer length")
    local output=buffer.create(width*height*4)
    local samples,visible=0,false
    for y=0,height-1 do
        local y0=math.floor(y*sourceHeight/height)
        local y1=math.max(y0,math.floor((y+1)*sourceHeight/height)-1)
        for x=0,width-1 do
            local x0=math.floor(x*sourceWidth/width)
            local x1=math.max(x0,math.floor((x+1)*sourceWidth/width)-1)
            local red,green,blue,alpha,count=0,0,0,0,0
            for sy=y0,y1 do
                for sx=x0,x1 do
                    local offset=(sy*sourceWidth+sx)*4
                    local a=buffer.readu8(pixels,offset+3)
                    -- Premultiply by alpha so transparent white borders cannot wash out colours.
                    red+=buffer.readu8(pixels,offset)*a
                    green+=buffer.readu8(pixels,offset+1)*a
                    blue+=buffer.readu8(pixels,offset+2)*a
                    alpha+=a;count+=1;samples+=1
                    if samples%4096==0 and checkpoint and not checkpoint()then return nil,"cancelled"end
                end
            end
            local offset=(y*width+x)*4
            if alpha>0 then
                visible=true
                buffer.writeu8(output,offset,math.floor(red/alpha+.5))
                buffer.writeu8(output,offset+1,math.floor(green/alpha+.5))
                buffer.writeu8(output,offset+2,math.floor(blue/alpha+.5))
            end
            buffer.writeu8(output,offset+3,math.floor(alpha/count+.5))
        end
    end
    if not visible then return nil,"transparent"end
    return output
end

function FWNoModules.CreateBlurryGraphics(deps)
    local api = {IncludeGUI=false, Quality="Very Blurry"}
    local current, working, enabled = nil, false, false
    local pendingRestores={}
    local levels = {["Very Blurry"]=0,["Blurry"]=1,["Slightly Blurry"]=2}
    local limits = {[0]=64,[1]=128,[2]=256}
    local maxPixels, maxImages = 4194304, 256
    local kick, observe, forget, summarize
    local function notify(message)
        if deps.Notify then pcall(deps.Notify,message)end
    end
    local function log(message)
        if deps.Log then pcall(deps.Log,"[Featherware/Blurry Graphics] "..message)end
    end
    local function destroy(image)
        if image then pcall(function()image:Destroy()end)end
    end
    local function release(connection)
        if connection then deps.Disconnect(connection)end
    end
    local function valid(state,record)
        return current==state and state.active and not record.removed and deps.InScope(record.object,record.gui)
    end
    local function read(object,property)
        local ok,value=pcall(function()return object[property]end)
        if ok then return value end
    end
    local function write(object,property,value)
        return pcall(function()object[property]=value end)
    end
    local function drop(state,record)
        local entry=record.entry
        record.entry=nil
        if entry then
            entry.users-=1
        end
    end
    local function makeRoom(state,pixels)
        for key,entry in pairs(state.cache)do
            if state.count<maxImages and state.pixels+pixels<=maxPixels then break end
            if entry.users==0 then
                state.cache[key]=nil;state.pixels-=entry.pixels;state.count-=1
                destroy(entry.image)
            end
        end
        return state.count<maxImages and state.pixels+pixels<=maxPixels
    end
    local function restore(state,record)
        record.mutating=true
        if record.applied then
            record.expected=table.clone(record.original)
            local contentOK=read(record.object,record.property)==record.original[record.property]
                or write(record.object,record.property,record.original[record.property])
            if not contentOK and type(record.originalAlias)=="string"and record.originalAlias~=""then
                contentOK=write(record.object,record.alias,record.originalAlias)
            end
            if not contentOK then
                -- Keep the live replacement alive until its original can be restored.
                -- Destroying an image still referenced by a part can leave it blank.
                record.mutating=false
                return false
            end
            for property,value in pairs(record.original)do
                if property~=record.property then write(record.object,property,value)end
            end
            state.appliedCount-=1
        end
        record.applied=false
        record.mutating=false
        drop(state,record)
        return true
    end
    forget=function(state,object)
        local record=state.records[object]
        if not record then return end
        record.removed=true;record.revision+=1
        release(record.changed);release(record.ancestry)
        if not restore(state,record)then
            pendingRestores[record]={state=state}
            log("Original texture could not be restored yet. Its replacement was kept alive.")
        end
        state.records[object]=nil
    end
    local function stopImages()
        local state=current
        current=nil
        if not state then return end
        state.active=false
        release(state.added)
        local objects={}
        for object in pairs(state.records)do objects[#objects+1]=object end
        for _,object in ipairs(objects)do forget(state,object)end
        for key,entry in pairs(state.cache)do
            if entry.users==0 then destroy(entry.image);state.cache[key]=nil end
        end
        table.clear(state.queue);table.clear(state.failures)
    end
    local function queue(state,record)
        if record.queued or not valid(state,record)then return end
        record.queued=true
        state.last+=1;state.queue[state.last]=record
        kick()
    end
    local function reduce(state,record)
        if not valid(state,record)then return end
        local revision=record.revision
        local content=record.original[record.property]
        local uri=read(content,"Uri")
        -- Dynamic Content objects must keep updating. Do not freeze them into snapshots.
        if type(uri)~="string"or uri==""then state.skippedContent+=1;return end
        local cap=limits[levels[api.Quality]or 0]
        local key=uri.."|"..cap
        if state.failures[key]or state.unchanged[key]then return end
        local entry=state.cache[key]
        local created=false
        if not entry then
            if not makeRoom(state,0)then
                if not state.capWarning then state.capWarning=true;notify("The reduced image cache is full. Additional images stay unchanged to limit memory use.")end
                return
            end
            local source,image
            local ok,problem=pcall(function()
                source=deps.Assets:CreateEditableImageAsync(content)
                if not source then error("Editable image memory is unavailable",0)end
                if not valid(state,record)or record.revision~=revision then return end
                local size=source.Size
                -- Reduce small block textures too. A 16px texture becomes 2px in Very Blurry.
                local divisor=({[0]=8,[1]=4,[2]=2})[levels[api.Quality]or 0]
                local scale=math.min(1/divisor,cap/math.max(size.X,size.Y))
                if size.X<=1 and size.Y<=1 then scale=1 end
                if scale>=1 then
                    if state.unchangedCount<512 then state.unchanged[key]=true;state.unchangedCount+=1 end
                    return
                end
                local width=math.max(1,math.floor(size.X*scale+.5))
                local height=math.max(1,math.floor(size.Y*scale+.5))
                if not makeRoom(state,width*height)then
                    if not state.capWarning then state.capWarning=true;notify("The reduced image cache is full. Additional images stay unchanged to limit memory use.")end
                    return
                end
                local sourcePixels=source:ReadPixelsBuffer(Vector2.zero,size)
                destroy(source);source=nil
                local lastYield=os.clock()
                local output,reason=FWNoModules.ReduceTexturePixels(sourcePixels,size.X,size.Y,width,height,function()
                    if not valid(state,record)or record.revision~=revision then return false end
                    if os.clock()-lastYield>=.0015 then deps.Wait();lastYield=os.clock()end
                    return valid(state,record)and record.revision==revision
                end)
                if not output then
                    if reason=="transparent"then
                        if state.unchangedCount<512 then state.unchanged[key]=true;state.unchangedCount+=1 end
                        state.skippedContent+=1
                    end
                    return
                end
                if not valid(state,record)or record.revision~=revision then return end
                image=deps.Assets:CreateEditableImage({Size=Vector2.new(width,height)})
                if not image then error("Editable image memory is unavailable",0)end
                image:WritePixelsBuffer(Vector2.zero,image.Size,output)
                local verified=image:ReadPixelsBuffer(Vector2.zero,image.Size)
                if buffer.len(verified)~=buffer.len(output)or buffer.tostring(verified)~=buffer.tostring(output)then
                    error("Image pixel verification failed; original texture kept",0)
                end
                created=true
                entry={key=key,image=image,content=deps.Content.fromObject(image),users=0,
                    pixels=width*height,x=width/size.X,y=height/size.Y}
            end)
            destroy(source)
            if not ok then
                destroy(image)
                if current==state then
                    -- Bounded negative cache. Inaccessible assets are never removed or blanked.
                    if state.failureCount<512 then state.failures[key]=true;state.failureCount+=1 end
                    if state.failureCount<=3 then log("Asset "..uri..": "..tostring(problem))end
                    if not state.warned then
                        state.warned=true
                        notify("Some images cannot be reduced here. Roblox blocked image access or its image memory budget is full. Those images stay unchanged.")
                    end
                end
                return
            end
            if not entry then return end
            if not valid(state,record)or record.revision~=revision then destroy(entry.image);return end
            state.cache[key]=entry;state.count+=1;state.pixels+=entry.pixels
        end
        if not valid(state,record)or record.revision~=revision then return end
        record.mutating=true
        record.expected={[record.property]=entry.content}
        local ok=write(record.object,record.property,entry.content)
        if ok then
            entry.users+=1;record.entry=entry;record.applied=true
            state.appliedCount+=1
            if record.gui then
                local function vector(value)return Vector2.new(value.X*entry.x,value.Y*entry.y)end
                record.expected.ImageRectOffset=vector(record.original.ImageRectOffset)
                record.expected.ImageRectSize=vector(record.original.ImageRectSize)
                local rect=record.original.SliceCenter
                if rect then record.expected.SliceCenter=Rect.new(vector(rect.Min),vector(rect.Max))end
                if record.original.SliceScale then
                    record.expected.SliceScale=record.original.SliceScale/math.min(entry.x,entry.y)
                end
                record.expected.ResampleMode=Enum.ResamplerMode.Default
                for property,value in pairs(record.expected)do
                    if property~=record.property then write(record.object,property,value)end
                end
            elseif record.original.ResampleMode~=nil then
                record.expected.ResampleMode=Enum.ResamplerMode.Default
                write(record.object,"ResampleMode",record.expected.ResampleMode)
            end
        else
            state.assignmentFailures+=1
            if state.assignmentFailures<=3 then log("Could not replace "..record.object.ClassName.."."..record.property)end
            if entry.users==0 then
                state.cache[key]=nil;state.count-=1;state.pixels-=entry.pixels;destroy(entry.image)
            end
        end
        record.mutating=false
        return created
    end
    kick=function()
        if working then return end
        working=true
        -- Finish in-flight asset loads so their temporary images can be destroyed on disable.
        -- One worker is shared across toggles and setting changes.
        deps.Spawn(function()
            local processed=0
            while current and current.active do
                local state=current
                if state.first>state.last then summarize(state);break end
                local record=state.queue[state.first]
                state.queue[state.first]=nil;state.first+=1
                record.queued=false
                local ok,problem=pcall(reduce,state,record)
                if not ok and not state.workerWarning then
                    state.workerWarning=true
                    notify("An unsupported image was skipped: "..tostring(problem))
                end
                processed+=1
                if ok and problem==true then deps.Wait()
                elseif processed%16==0 then deps.Wait()end
            end
            working=false
        end)
    end
    observe=function(state,object)
        if current~=state or state.records[object]then return end
        local gui=object:IsA("ImageLabel")or object:IsA("ImageButton")
        local property,alias
        if gui then
            if not api.IncludeGUI then return end
            property,alias="ImageContent","Image"
        else
            if object:IsA("MeshPart")then property,alias="TextureContent","TextureID"
            elseif object:IsA("FileMesh")then property,alias="TextureContent","TextureId"
            elseif object:IsA("Decal")then property,alias="ColorMapContent","Texture"
            elseif object:IsA("SurfaceAppearance")or object:IsA("MaterialVariant")or object:IsA("TerrainDetail")then property,alias="ColorMapContent","ColorMap"
            else return end
        end
        if not deps.InScope(object,gui)then return end
        local content=read(object,property)
        if content==nil and object:IsA("Decal")then property="TextureContent";content=read(object,property)end
        if content==nil then state.unsupported+=1;return end
        local original={[property]=content}
        local resample=read(object,"ResampleMode")
        if resample~=nil then original.ResampleMode=resample end
        if gui then
            for _,key in ipairs({"ImageRectOffset","ImageRectSize","SliceCenter","SliceScale","ResampleMode"})do
                original[key]=read(object,key)
            end
            if not original.ImageRectOffset or not original.ImageRectSize then return end
        end
        local record={object=object,gui=gui,property=property,alias=alias,originalAlias=read(object,alias),original=original,revision=0}
        state.records[object]=record
        record.changed=deps.Connect(object.Changed,function(changed)
            if record.mutating or record.removed then return end
            if changed==property or changed==alias or (property=="ColorMapContent"and changed=="ColorMap")then
                local value=read(object,property)
                if record.expected and value==record.expected[property]then return end
                record.original[property]=value
                record.originalAlias=read(object,alias)
            elseif record.original[changed]~=nil then
                local value=read(object,changed)
                if record.expected and value==record.expected[changed]then return end
                record.original[changed]=value
            else return end
            record.revision+=1
            if not restore(state,record)then return end
            queue(state,record)
        end)
        record.ancestry=deps.Connect(object.AncestryChanged,function()
            if not deps.InScope(object,gui)then forget(state,object)end
        end)
        queue(state,record)
    end
    function api.Report()
        local state=current
        if not state then log("Feature is off.");notify("Blurry Graphics is off.");return end
        local message=string.format("Images changed=%d | Asset failures=%d | Assignment failures=%d | Unsupported properties=%d | Empty/dynamic images=%d | Queue=%d | Engine texture override=disabled | Method=verified RGBA averaging",
            state.appliedCount,state.failureCount,state.assignmentFailures,state.unsupported,state.skippedContent,
            math.max(0,state.last-state.first+1))
        log(message)
        notify(string.format("Changed %d images. Asset failures: %d. Assignment failures: %d. Full details are in the console.",state.appliedCount,state.failureCount,state.assignmentFailures))
    end
    summarize=function(state)
        if current~=state or not state.scanned or state.reported then return end
        state.reported=true
        api.Report()
        if state.appliedCount==0 then
            notify("No image replacements were applied. Use Print Texture Status for details. Built-in material textures may not support live changes.")
        end
    end
    local function startImages()
        stopImages()
        if next(pendingRestores)then
            enabled=false
            notify("Texture restoration is still blocked. New replacements were paused to avoid accumulating images.")
            return false
        end
        local state={active=true,records={},queue={},first=1,last=0,
            cache={},count=0,pixels=0,failures={},failureCount=0,unchanged={},unchangedCount=0,
            appliedCount=0,assignmentFailures=0,unsupported=0,skippedContent=0}
        current=state
        -- No engine-wide texture override. Only verified image buffers are assigned.
        state.added=deps.Connect(deps.Added,function(object)observe(state,object)end)
        -- Incremental discovery. Existing controls remain usable during large map scans.
        deps.Spawn(function()
            local stack=deps.Roots()
            local count=0
            while #stack>0 and current==state and state.active do
                local object=table.remove(stack)
                observe(state,object)
                local ok,children=pcall(function()return object:GetChildren()end)
                if ok then for _,child in ipairs(children)do stack[#stack+1]=child end end
                count+=1
                if count%150==0 then deps.Wait()end
            end
            if current==state then state.scanned=true;if state.first>state.last then summarize(state)end end
        end)
        return true
    end
    function api.Stop()
        enabled=false
        for record,item in pairs(pendingRestores)do
            if restore(item.state,record)then
                pendingRestores[record]=nil
                local entry=item.state.cache
                for key,image in pairs(entry)do
                    if image.users==0 then destroy(image.image);entry[key]=nil end
                end
            end
        end
        stopImages()
        if next(pendingRestores)then notify("A texture restore was blocked. Its image was kept alive to avoid a blank texture. Try turning the feature off again.")end
    end
    function api.Start()
        api.Stop()
        if next(pendingRestores)then return false end
        enabled=true
        return startImages()
    end
    function api.SetGUI(value)
        api.IncludeGUI=value==true
        if enabled then return startImages()end
    end
    function api.SetQuality(value)
        api.Quality=levels[value]and value or "Very Blurry"
        if enabled then return api.Start()end
    end
    return api
end

