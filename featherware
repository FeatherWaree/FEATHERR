				targetPct = AutoNazar.Values["Health Percent"] or 50

				if hum then
					hpPct = (hum.Health / hum.MaxHealth) * 100

					if mode == "Health" then
						if hpPct <= targetPct then
							nazarFireAbility()
						end
					end

					if mode == "On Hit" and not nazarData.hookActive then
						if hum.Health < nazarData.lastHealth then
							if hpPct <= targetPct then
								nazarFireAbility()
							end
						end
						nazarData.lastHealth = hum.Health
					else
						if hum then
							nazarData.lastHealth = hum.Health
						end
					end
				end
			end)
		end
	else
		if nazarConn then
			nazarConn:Disconnect()
			nazarConn = nil
		end
	end
end, true)

