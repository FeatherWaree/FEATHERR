				end

				task.wait(0.1) 

				-- 2. The ACTUAL claiming channel animation (USE_GRAVESTONE)
				-- This is exactly what the game plays in useGravestone() after the server accepts
				if cryptData.AnimationUtil then
					local assetId = cryptData.GameAnimationUtil:getAssetId(cryptData.AnimationType.USE_GRAVESTONE)
					cryptData.AnimationUtil:playAnimation(PlayersService.LocalPlayer, assetId, {looped = false})
				end
			end)
		end

		-- Extract attributes required by the server
		secret = gravestone:GetAttribute("GravestoneSecret")
		position = gravestone:GetAttribute("GravestonePosition") or gravestone:GetPivot().Position
		userId = gravestone:GetAttribute("GravestonePlayerUserId")
		armor = gravestone:GetAttribute("ArmorType")
		sword = gravestone:GetAttribute("SwordType")
		bow = gravestone:GetAttribute("BowType")

		if secret then
			args = {
				secret = secret,
				position = position,
				skeletonData = {
					associatedPlayerUserId = userId,
					armorType = armor,
					weaponType = sword,
					bowType = bow
				}
			}

			pcall(function()
				if cryptData.activateRemote:IsA("RemoteFunction") then
					cryptData.activateRemote:InvokeServer(args)
				else
					cryptData.activateRemote:FireServer(args)
				end
			end)
		end

		-- Cleanup cache after a short delay
		task.wait(1)
		cryptData.processed[gravestone] = nil
	end)
end

