end

-- Keep the game's audio modules independent of kit animation setup and of
-- globals that another feature may overwrite. All sound keys below come
-- from the original script; no replacement asset IDs are guessed.
FWNoModules.GameAudio = {warnings = {}, nextLoad = 0}

function FWNoModules.AudioWarning(feature, message)
    local cache = FWNoModules.GameAudio.warnings
    local key = feature .. ": " .. tostring(message)
    local now = os.clock()
    if not cache[key] or now - cache[key] >= 10 then
        cache[key] = now
        warn("[Featherware audio] " .. key)
    end
end

function FWNoModules.ResolveGameAudio()
    local audio = FWNoModules.GameAudio
    if audio.manager and audio.sounds then return audio.manager, audio.sounds end
    if os.clock() < audio.nextLoad then return audio.manager, audio.sounds end
    audio.nextLoad = os.clock() + 5
    if type(require) ~= "function" then return nil, nil, "Game module loading is unavailable." end
    local storage = game:GetService("ReplicatedStorage")
    local function path(parent, names)
        for _, name in ipairs(names) do
            parent = parent and parent:FindFirstChild(name)
            if not parent then return nil end
        end
        return parent
    end
    local failures = {}
    if not audio.manager then
        local module = path(storage, {"rbxts_include", "node_modules", "@easy-games", "game-core", "out"})
        if module then
            local ok, result = pcall(require, module)
            if ok and result and result.SoundManager then audio.manager = result.SoundManager
            else failures[#failures + 1] = "SoundManager module: " .. tostring(result) end
        else failures[#failures + 1] = "SoundManager module path is missing." end
    end
    if not audio.sounds then
        local module = path(storage, {"TS", "sound", "game-sound"})
        if module then
            local ok, result = pcall(require, module)
            if ok and result and result.GameSound then audio.sounds = result.GameSound
            else failures[#failures + 1] = "GameSound module: " .. tostring(result) end
        else failures[#failures + 1] = "GameSound module path is missing." end
    end
    return audio.manager, audio.sounds, table.concat(failures, " ")
end

function FWNoModules.PlayGameSound(feature, keys, options)
    local manager, sounds, failure = FWNoModules.ResolveGameAudio()
    if not manager or not sounds or type(manager.playSound) ~= "function" then
        FWNoModules.AudioWarning(feature, failure and failure ~= "" and failure or "The game audio modules are not ready.")
        return false
    end
    if type(keys) == "string" then keys = {keys} end
    local sound
    for _, key in ipairs(keys) do
        if sounds[key] ~= nil then sound = sounds[key]; break end
    end
    if sound == nil then
        FWNoModules.AudioWarning(feature, "Missing original sound key: " .. table.concat(keys, ", "))
        return false
    end
    local ok, problem = pcall(function() manager:playSound(sound, options) end)
    if not ok then FWNoModules.AudioWarning(feature, "Playback failed: " .. tostring(problem)) end
    return ok
end

function FWNoModules.PlayCollectAnimation(feature, character, asset)
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end
    local animation = FWNoModules.OwnInstance(Instance.new("Animation"))
    animation.AnimationId = asset
    local connection
    local ok, problem = pcall(function()
        local animator = humanoid:FindFirstChildOfClass("Animator") or humanoid
        local track = FWNoModules.OwnInstance(animator:LoadAnimation(animation))
        track.Looped = false
        connection = FWNoModules.Connect(track.Stopped, function()
            if connection then connection:Disconnect(); connection = nil end
            animation:Destroy()
            track:Destroy()
        end)
        track:Play()
    end)
    if not ok then
        if connection then connection:Disconnect() end
        animation:Destroy()
        FWNoModules.AudioWarning(feature, "Animation failed; sound playback is separate: " .. tostring(problem))
    end
    return ok
end


-- Reuse query parameters, but never cache a visibility result across shots.
-- These checks do not yield, schedule work, or scan the map.
FWNoModules.WallQueries = {}

function FWNoModules.ClearShot(channel, origin, destination, target, source, host)
    if typeof(origin) ~= "Vector3" or typeof(destination) ~= "Vector3" then return false end
    local direction = destination - origin
    if direction.Magnitude < 0.001 then return true end
    local character = G.Services.Players.LocalPlayer.Character
    local query = FWNoModules.WallQueries[channel]
    if not query then
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.IgnoreWater = true
        params.RespectCanCollide = true
        query = {params = params}
        FWNoModules.WallQueries[channel] = query
    end
    if not query.initialized or query.character ~= character or query.source ~= source or query.host ~= host then
        local ignored = {}
        if character then ignored[#ignored + 1] = character end
        if source then ignored[#ignored + 1] = source end
        if host and host ~= character then ignored[#ignored + 1] = host end
        query.params.FilterDescendantsInstances = ignored
        query.character, query.source, query.host, query.initialized = character, source, host, true
    end
    local hit = G.Services.Workspace:Raycast(origin, direction, query.params)
    if not hit then return true end
    local hitTarget = target ~= nil and hit.Instance ~= nil and hit.Instance:IsDescendantOf(target)
    return hitTarget == true, hitTarget == true
end

function FWNoModules.ClearWhisperPath(origin, targetPosition, velocity, gravity, flightTime, target, owl, host)
    -- Reject a target currently behind a wall before doing any arc checks.
    if not FWNoModules.ClearShot("Whisper", origin, targetPosition, target, owl, host) then return false end
    local duration = flightTime
    if type(duration) ~= "number" or duration ~= duration or duration <= 0 then
        duration = (targetPosition - origin).Magnitude / math.max(velocity.Magnitude, 1)
    end
    if duration == math.huge then return false end
    local acceleration = Vector3.new(0, -0.5 * gravity, 0)
    local previous = origin
    -- Four fixed segments check the actual outgoing arc without a wait or an
    -- unbounded simulation. Stop as soon as a wall or the target is hit.
    for segment = 1, 4 do
        local time = duration * (segment / 4)
        local position = origin + velocity * time + acceleration * (time * time)
        local clear, hitTarget = FWNoModules.ClearShot("Whisper", previous, position, target, owl, host)
        if not clear then return false end
        if hitTarget then return true end
        previous = position
    end
    return true
end


