	c.CornerRadius = UDim.new(0, r or 6)
	return c
end

local function stroke(parent, color, thickness, transparency)
	local s = Instance.new("UIStroke", parent)
	s.Color = color or THEME.Border
	s.Thickness = thickness or 1
	s.Transparency = transparency or 0.45
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	return s
end

local function makeToggleSwitch(parent, default, onColor)
	local track = Instance.new("Frame", parent)
	track.Size = UDim2.fromOffset(34, 18)
	track.BackgroundColor3 = default and (onColor or THEME.Accent) or THEME.ToggleOff
	track.BorderSizePixel = 0
	corner(track, 9)
	stroke(track, THEME.Border, 1, 0.55)

	local thumb = Instance.new("Frame", track)
	thumb.Size = UDim2.fromOffset(12, 12)
	thumb.AnchorPoint = Vector2.new(0, 0.5)
	thumb.Position = default and UDim2.new(0, 19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)
	thumb.BackgroundColor3 = THEME.TextPrimary
	thumb.BorderSizePixel = 0
	corner(thumb, 6)

	local function setState(state)
		tween(track, {BackgroundColor3 = state and (onColor or THEME.Accent) or THEME.ToggleOff}, 0.16)
		tween(thumb, {Position = state and UDim2.new(0, 19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)}, 0.16)
	end
	return track, setState
end


local function injectElements(mod, settingsCont, uniquePrefix)
	mod.UpdateFunctions = mod.UpdateFunctions or {}

	uniquePrefix = uniquePrefix or "Overlay"

	local function findRawInstance(obj)
		if typeof(obj) == "Instance" then
			return obj
		elseif type(obj) == "table" then
			local target = obj.ContainerFrame or obj.Container or obj.Frame or obj.Window or obj.MainFrame
			if target then
				return findRawInstance(target) 
			else
				for _, val in pairs(obj) do
					if typeof(val) == "Instance" then return val end
				end
			end
		end
		return nil
	end

	settingsCont = findRawInstance(settingsCont)

	if not settingsCont then
		local fwObj = _G.FW or FW
		if fwObj and fwObj.SettingsOverlay then
			settingsCont = findRawInstance(fwObj.SettingsOverlay)
		end
	end

	-- Final absolute check
	if not settingsCont or typeof(settingsCont) ~= "Instance" then
		warn("[Featherware Error] COULD NOT EXTRACT A VALID ROBLOX INSTANCE. Value type is: " .. typeof(settingsCont))
		return
	end

	function mod:CreateMainWindow(loopsTableReference)
		if not settingsCont then return end

		local mainTargetGui = PlayerGui:FindFirstChild("Featherware_ModuleListGui")
		if not mainTargetGui then
			warn("No ScreenGui found for module list")
			return
		end

		local savedPosKey = uniquePrefix .. "_ModuleListPosition"

		local existing = mainTargetGui:FindFirstChild("Featherware_PremiumModuleList")
		if existing then
			existing:Destroy()
		end

		-- MAIN CONTAINER
		local moduleListFrame = Instance.new("Frame")
		moduleListFrame.Name = "Featherware_PremiumModuleList"
		moduleListFrame.Size = UDim2.new(0, 250, 0, 50)

		local savedPos = _G.SavedConfig and _G.SavedConfig[savedPosKey]
		moduleListFrame.Position = savedPos and UDim2.new(
			savedPos.XScale, savedPos.XOffset,
			savedPos.YScale, savedPos.YOffset
		) or UDim2.new(1, -260, 0.1, 0)

		moduleListFrame.BackgroundTransparency = 1 
		moduleListFrame.BorderSizePixel = 0
		moduleListFrame.Active = true
		moduleListFrame.Visible = _G.ModuleListEnabled ~= nil and _G.ModuleListEnabled or true
		moduleListFrame.Parent = mainTargetGui

		local listScale = Instance.new("UIScale", moduleListFrame)
		listScale.Scale = _G.ModuleListScale or 1.0

		if makeDraggable then
			makeDraggable(moduleListFrame)
		elseif mod.makeDraggable then
			mod.makeDraggable(moduleListFrame)
		end

		positionSaveThread = nil
		moduleListFrame:GetPropertyChangedSignal("Position"):Connect(function()
			if positionSaveThread then task.cancel(positionSaveThread) end
			positionSaveThread = task.delay(0.5, function()
				pos = moduleListFrame.Position
				if not _G.SavedConfig then _G.SavedConfig = {} end
				_G.SavedConfig[savedPosKey] = {
					XScale = pos.X.Scale, XOffset = pos.X.Offset,
					YScale = pos.Y.Scale, YOffset = pos.Y.Offset
				}
				if saveConfigToPC then saveConfigToPC() end
				positionSaveThread = nil
			end)
		end)

		-- VISUALS: RIGHT CONNECTING LINE
		local rightLine = Instance.new("Frame")
		rightLine.Size = UDim2.new(0, 2, 0, 30) -- Height dynamically updates later
		rightLine.Position = UDim2.new(1, -2, 0, 0)
		rightLine.BorderSizePixel = 0
		rightLine.BackgroundColor3 = _G.StaticColor or Color3.fromRGB(168, 85, 247)
		rightLine.Parent = moduleListFrame

		-- VISUALS: TITLE
		local listTitle = Instance.new("TextLabel")
		listTitle.Size = UDim2.new(1, -8, 0, 30) -- Shifted slightly left to account for line
		listTitle.BackgroundTransparency = 1
		listTitle.Text = "FEATHERWARE"
		listTitle.Font = Enum.Font.GothamBlack
		listTitle.TextSize = 16
		listTitle.TextXAlignment = Enum.TextXAlignment.Right
		listTitle.TextStrokeTransparency = 0.2 
		listTitle.TextStrokeColor3 = Color3.fromRGB(15, 15, 15)
		listTitle.Parent = moduleListFrame

		-- VISUALS: LIST CONTAINER
		local listCont = Instance.new("Frame")
		listCont.Size = UDim2.new(1, -8, 0, 0) -- Shifted left for the line
		listCont.Position = UDim2.new(0, 0, 0, 32)
		listCont.BackgroundTransparency = 1
		listCont.Parent = moduleListFrame

		local listLayout = Instance.new("UIListLayout", listCont)
		listLayout.SortOrder = Enum.SortOrder.LayoutOrder
		listLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right 
		listLayout.Padding = UDim.new(0, 2) 


		-- Load persisted settings or use defaults
		local savedRainbow = _G.SavedConfig["ModuleList_Rainbow"]
		_G.RainbowEnabled = savedRainbow ~= nil and savedRainbow or true

		local savedColor = _G.SavedConfig["ModuleList_Color"]
		_G.StaticColor = savedColor or Color3.fromRGB(168, 85, 247)

		local labelPool = {}

		local rainbowConnection = nil

		function applyColor(color)
			lastAppliedColor = color
			if listTitle then listTitle.TextColor3 = color end
			if rightLine then rightLine.BackgroundColor3 = color end
			for _, label in ipairs(labelPool) do
				if label and label.Parent then label.TextColor3 = color end
			end
		end

		function updateRainbowState()
			local shouldBeRunning = moduleListFrame and moduleListFrame.Parent and moduleListFrame.Visible and _G.RainbowEnabled

			if shouldBeRunning then
				if not rainbowConnection then
					rainbowConnection =  G.Services.RunService.RenderStepped:Connect(function(dt)
						hue = (hue + 0.2 * dt) % 1
						applyColor(Color3.fromHSV(hue, 0.55, 1))
					end)
				end
			else
				if rainbowConnection then
					rainbowConnection:Disconnect()
					rainbowConnection = nil
				end
				if not _G.RainbowEnabled and _G.StaticColor then
					applyColor(_G.StaticColor)
				end
			end
		end
		local function rainbowLoop(deltaTime)
			if not _G.RainbowEnabled or not moduleListFrame.Parent or not moduleListFrame.Visible then
				if rainbowConnection then
					rainbowConnection:Disconnect()
					rainbowConnection = nil
				end
				return
			end
			hue = (hue + 0.2 * deltaTime) % 1 
			applyColor(Color3.fromHSV(hue, 0.55, 1))
		end

		mod:CreateToggle("MODULE LIST", moduleListFrame.Visible, function(state)
			_G.ModuleListEnabled = state
			moduleListFrame.Visible = state
			updateRainbowState() -- Re-evaluate loop connection
		end)
		mod:CreateSlider("LIST SCALE", 0.5, 2.0, listScale.Scale, function(val)
			_G.ModuleListScale = val
			listScale.Scale = val
		end)
		mod:CreateToggle("RAINBOW TEXT", _G.RainbowEnabled, function(state)
			_G.RainbowEnabled = state
			_G.SavedConfig["ModuleList_Rainbow"] = state
			pcall(saveConfigToPC)
			updateRainbowState() -- Re-evaluate loop connection
		end)
		mod:CreateColorPicker("TEXT COLOR", _G.StaticColor, function(color)
			_G.StaticColor = color
			_G.SavedConfig["ModuleList_Color"] = color
			pcall(saveConfigToPC)
			if not _G.RainbowEnabled then
				applyColor(color) -- Instantly update static color without loop
			end
		end)

		-- HELPER: GET EXACT TEXT PIXEL WIDTH FOR SORTING
		local function getTextWidth(text)
			return G.Services.TS:GetTextSize(text, 14, Enum.Font.GothamBold, Vector2.new(1000, 20)).X
		end

		local function refreshModuleListVisuals()
			for i = #labelPool, 1, -1 do
				if not labelPool[i] or not labelPool[i].Parent then
					table.remove(labelPool, i)
				end
			end

			local activeKeys = {}
			for key, val in pairs(loopsTableReference or {}) do
				if val == true then
					table.insert(activeKeys, tostring(key))
				end
			end

			-- Exact visual length sorting (longest to shortest)
			table.sort(activeKeys, function(a, b)
				return getTextWidth(string.upper(a)) > getTextWidth(string.upper(b))
			end)

			-- Hide unused labels (Prevents Destroying/Recreating)
			for i = #activeKeys + 1, #labelPool do
				labelPool[i].Visible = false
			end

			-- Update existing or create new labels
			for i, rawKey in ipairs(activeKeys) do
				local txt = labelPool[i]
				if not txt then
					txt = Instance.new("TextLabel")
					txt.Size = UDim2.new(0, 200, 0, 18)
					txt.BackgroundTransparency = 1
					txt.Font = Enum.Font.GothamBold
					txt.TextSize = 14
					txt.TextXAlignment = Enum.TextXAlignment.Right
					txt.TextStrokeTransparency = 0.25
					txt.TextStrokeColor3 = Color3.fromRGB(10, 10, 10)
					txt.Parent = listCont
					table.insert(labelPool, txt)
				end
				txt.Text = string.upper(rawKey)
				txt.LayoutOrder = i
				txt.Visible = true
			end

			-- Dynamically scale the right connecting line based on active items
			local totalHeight = 30 + (#activeKeys * 20) -- 30 for title, 20 for each item (18 size + 2 padding)
			rightLine.Size = UDim2.new(0, 2, 0, totalHeight)

			-- Ensure newly created labels get the correct color immediately
			if lastAppliedColor then
				applyColor(lastAppliedColor)
			elseif _G.StaticColor then
				applyColor(_G.StaticColor)
			end
		end

		_G.__FW_REFRESH_MODULE_LIST = function()
			task.defer(refreshModuleListVisuals)
		end
		task.defer(refreshModuleListVisuals)
	end -- <--- THIS CLOSES CreateMainWindow

