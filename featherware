function nkBestToolFor(blockName, inv)
	n = string.lower(blockName)
	want = nil
	if n:find("wool") then
		want = {"shears"}
	elseif n == "bed" or n:find("plank") or n:find("wood") or n:find("log") then
		want = nkAxes
	elseif n:find("obsidian") or n:find("ceramic") or n:find("stone_brick") or n:find("stone") or n:find("tesla") or n:find("hive") or n:find("iron_ore") or n:find("lucky") then
		want = nkPickaxes
	end
	if not want then return nil end
	if inv then
		for _, t in ipairs(want) do
			if inv:FindFirstChild(t) then return t end
		end
	end
	return nil
end

function nkSwapTool(toolName)
	inv = FWNoModules.GetPrivateInventory(Player.Name)
	item = inv and inv:FindFirstChild(toolName)
	if not item or not nkSetInv then return false end
	pcall(function() nkSetInv:InvokeServer({hand = item}) end)
	return true
end

function nkNotifyTool(toolName)
	now = os.clock()
	if now - nkLastToolNotify > 0.5 then
