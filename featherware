            if object:IsA("ModuleScript")or object:IsA("RemoteFunction")or object:IsA("RemoteEvent")then changed()end
        end)
    end
    if FWNoModules.OnCleanup then FWNoModules.OnCleanup(api.CancelPending)end

    local function replay(data)
        local affected = {}
        local differences = {}
        for _, binding in ipairs(api.order) do
            local value = data[binding.key]
            if value == nil then value = baseline[binding.key];if value==nil then value=binding.default end end
            if api.pending[binding.key]or(binding.owner and binding.owner.ProfilePending)or not equal(encode(readBinding(binding)), encode(value)) then
                differences[#differences + 1] = {binding = binding, value = clone(value)}
                if binding.owner and binding.owner.Toggled ~= nil then affected[binding.owner] = true end
            end
        end
        api.CancelPending()
        for owner in pairs(affected)do
            if owner.Toggled then
                if FWNoModules.CancelFeature then FWNoModules.CancelFeature(owner)end
                api.TryApply("__stop_"..tostring(owner),function()owner:StopForUnload()end,nil,owner,true)
            end
        end
        reconcile(_G.SavedConfig, data)
        for _, change in ipairs(differences) do
            if change.binding.kind~="module"then
                api.TryApply(change.binding.key,change.binding.set,api.Value(change.value),change.binding.owner)
            end
        end
        if api.AfterApply then api.TryApply("__after_apply",api.AfterApply,nil)end
        for owner in pairs(affected) do
            local enabled = api.Value(data[owner.ProfileToggleKey]) == true
            api.TryApply(owner.ProfileToggleKey,function(value)owner:SetProfileState(value)end,enabled,owner)
        end
        if _G.__FW_REFRESH_MODULE_LIST then _G.__FW_REFRESH_MODULE_LIST()end
    end
    function api.Select(id, skipSave)
        if api.busy or not api.ready then return false, "A profile change is already in progress." end
        if id==manifest.active then return true end
        local target = record(id)
        if not target then return false, "Profile not found." end
        local incoming = cache[id] or read(target.path)
        if not incoming then return false, "This profile could not be read." end
        if api.BeforeSwitch then pcall(api.BeforeSwitch)end
        local previous = api.Snapshot()
        if not skipSave then local ok, problem = api.Flush(); if not ok then return false, problem end end
        api.transitionSnapshot=previous
        api.busy = true
        if api.OnBusy then api.OnBusy(true) end
        _G.IsBindingKey = false
        local ok, problem = pcall(replay, clone(incoming))
        if ok then
            local snapshot=api.Snapshot()
            local stored,reason=write(target.path,snapshot)
            if stored then cache[id]=snapshot else ok=false;problem=reason end
        end
