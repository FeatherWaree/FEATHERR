local function stopChestStealer()
	if chestStealerThread then
		task.cancel(chestStealerThread)
		chestStealerThread = nil
	end
	for container, hookInfo in pairs(activeChestHooks) do 
		if hookInfo.conn then hookInfo.conn:Disconnect() end
	end
	activeChestHooks = {}
	stealQueue = {}
	hideChestHighlight()
end

local function startChestStealer()
	if chestStealerThread then return end

	chestStealerThread = task.spawn(function()
		while loops["chest stealer"] do
			local root = cachedHRP
			local hum = cachedHumanoid

			if root and hum and hum.Health > 0 then
				local trueRange = tonumber(ChestStealer.Values["Range"]) or 20
				local visualRange = trueRange + 15 -- Detect further away for visuals ONLY

				local dChests, dCrates = findNearbyContainers(visualRange, true)

				local nearbyContainers = {}
				local nearestContainer = nil
				local nearestDist = math.huge

				local function processDetected(c)
					if not c or not c.Parent then return end
					local dist = (c.Position - root.Position).Magnitude

					if dist <= visualRange then
						nearbyContainers[c] = true

						local folderVal = c:FindFirstChild("ChestFolderValue")
						local inv = folderVal and folderVal.Value
						local hasItems = false

						if inv then
							-- 1. Main loop sweep (Retries items naturally if you walked away and walked back)
							for _, item in ipairs(inv:GetChildren()) do
								if item.Name ~= "ChestOwner" then
									hasItems = true

									-- Only push to steal queue if actually within stealing range
									if dist <= trueRange then
										local inQueue = false
										for _, q in ipairs(stealQueue) do
											if q.item == item then inQueue = true break end
										end
										if not inQueue then
											table.insert(stealQueue, {inv = inv, item = item, c = c})
										end
									end
								end
							end

							-- 2. Hook for instant reaction
							if not activeChestHooks[c] then
								local conn = inv.ChildAdded:Connect(function(item)
									if item.Name ~= "ChestOwner" then
										highlightChestContainer(c)

										-- Only enqueue if we are close enough to steal it
										local currentDist = (c.Position - cachedHRP.Position).Magnitude
										if currentDist <= trueRange then
											table.insert(stealQueue, {inv = inv, item = item, c = c})
											processQueue()
										end
									end
								end)
								activeChestHooks[c] = { conn = conn, inventory = inv }
							end
						end

						if hasItems and dist < nearestDist then
							nearestDist = dist
							nearestContainer = c
						end
					end
				end

				if ChestStealer.Values["Crates"] then for _, c in ipairs(dCrates) do processDetected(c) end end
				if ChestStealer.Values["Chests"] then for _, c in ipairs(dChests) do processDetected(c) end end

				-- Start queue processing if we caught missed items
				if #stealQueue > 0 then processQueue() end

				-- Cleanup hooks for chests we walked too far away from
				for container, hookInfo in pairs(activeChestHooks) do
					if not nearbyContainers[container] or not container.Parent then
						if hookInfo.conn then hookInfo.conn:Disconnect() end
						activeChestHooks[container] = nil
					end
				end

				-- Update Highlight
				if nearestContainer then
					highlightChestContainer(nearestContainer)
				else
					hideChestHighlight()
				end
			end

			task.wait(0.02) 
		end
		chestStealerThread = nil
	end)
end

