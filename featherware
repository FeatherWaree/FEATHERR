panic_lastClick = 0
panic_hintToken = 0
panic_DOUBLE = 0.4

function panicTurnOffAll()
	if not _G.__FW_PANIC_REG then return end
	for panic_n, panic_reg in pairs(_G.__FW_PANIC_REG) do
		if panic_reg.off then pcall(panic_reg.off) end
	end
end

function panicResetAllKeys()
	if not _G.__FW_PANIC_REG then return end
	for panic_n, panic_reg in pairs(_G.__FW_PANIC_REG) do
		if panic_reg.resetKey then pcall(panic_reg.resetKey) end
	end
end

function panicOnClick()
	panic_now = tick()
	if panic_lastClick ~= 0 and panic_now - panic_lastClick <= panic_DOUBLE then
		panic_hintToken = panic_hintToken + 1
		panic_lastClick = 0
		panicTurnOffAll()
		panicResetAllKeys()
		for panic_k in pairs(loops) do FWNoModules.SetLoop(panic_k, false) end
		pcall(NotificationSystem.Notify, "Panic", "all modules and hotkeys reset", 1)
		return
	end

	panic_lastClick = panic_now
	panicTurnOffAll()
	for panic_k in pairs(loops) do FWNoModules.SetLoop(panic_k, false) end
	pcall(NotificationSystem.Notify, "Panic", "Disabled all modules", 1)

	panic_token = panic_hintToken + 1
	panic_hintToken = panic_token
	task.delay(0.5, function()
		if panic_hintToken == panic_token then
			pcall(NotificationSystem.Notify, "Panic", "If you want to disable hotkeys aswell, double click it", 1)
		end
	end)
end

