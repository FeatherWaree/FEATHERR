											pcall(function() paSetInv:InvokeServer({ hand = pa_L.weapon }) end)
										end
										paFireShot(pa_L, pa_myPos, pa_spawnO, pa_vt, pa_t, pa_target, bl_grav, pa_L.projectile, pa_pm)
										PA_BLATANT_COOLDOWNS[pa_cdKey] = now + (pa_L.fireDelay or 0.6)
										PA_RR = pa_idx
									else
