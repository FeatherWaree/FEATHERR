		-- Projectile ESP
		if pe_netConn then pe_netConn:Disconnect() pe_netConn = nil end
		if pe_renderConn then pe_renderConn:Disconnect() pe_renderConn = nil end
		pcall(peCleanup)
		-- Projectile Aura
		if PA_VIS_CONN then PA_VIS_CONN:Disconnect() PA_VIS_CONN = nil end
