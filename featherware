		uiCorner(gSlider, 4)

		local bSlider = FWNoModules.OwnInstance(Instance.new("TextBox", cFrame))
		bSlider.Size = UDim2.new(0.12, 0, 0.5, 0)
		bSlider.Position = UDim2.new(0.78, 0, 0.25, 0)
		bSlider.BackgroundColor3 = Color3.fromRGB(40, 40, 100)
		bSlider.TextColor3 = Color3.new(1,1,1)
		bSlider.Text = tostring(math.floor(defaultColor.B * 255))
		uiCorner(bSlider, 4)

		local wheelBtn = FWNoModules.OwnInstance(Instance.new("TextButton", cFrame))
		wheelBtn.Size = UDim2.new(0.08, 0, 0.5, 0)
		wheelBtn.Position = UDim2.new(0.90, 0, 0.25, 0)
		wheelBtn.BackgroundColor3 = defaultColor
		wheelBtn.Text = ""
		uiCorner(wheelBtn, 4)

		local btnStroke = FWNoModules.OwnInstance(Instance.new("UIStroke", wheelBtn))
		btnStroke.Color = Color3.fromRGB(200, 200, 200)
		btnStroke.Thickness = 1

		local wheelPopup, wheelImage, wheelPin, closeWheel
		local stopWheelDrag

		if cCallback then cCallback(defaultColor) end

		local function updateColor()
			local r = math.clamp(tonumber(rSlider.Text) or math.floor(defaultColor.R * 255), 0, 255)
			local g = math.clamp(tonumber(gSlider.Text) or math.floor(defaultColor.G * 255), 0, 255)
			local b = math.clamp(tonumber(bSlider.Text) or math.floor(defaultColor.B * 255), 0, 255)

			r = math.floor(r)
			g = math.floor(g)
			b = math.floor(b)

			rSlider.Text = tostring(r)
			gSlider.Text = tostring(g)
			bSlider.Text = tostring(b)

			local finalColor = Color3.fromRGB(r, g, b)

			mod.Values[cName] = finalColor

			_G.SavedConfig[settingID] = {
				R = r,
				G = g,
				B = b
			}

			saveConfigToPC()

			wheelBtn.BackgroundColor3 = finalColor

			if cCallback then
				cCallback(finalColor)
			end

			if mod.Callbacks.OnValueChanged then
				mod.Callbacks.OnValueChanged(cName, finalColor)
			end
		end


		local function updateFromWheel(input)
			local rSize = wheelImage.AbsoluteSize
			local rPos = wheelImage.AbsolutePosition
            local mousePos = FWNoModules.Mobile.LocalPoint(wheelImage,input.Position)
            local relativeX =mousePos.X-rSize.X/2
            local relativeY =mousePos.Y-rSize.Y/2

			local angle = math.atan2(relativeY, relativeX)
			local hue = (angle + math.pi) / (2 * math.pi)

			local radius = rSize.X / 2
			local distance = math.sqrt(relativeX^2 + relativeY^2)
			local saturation = math.clamp(distance / radius, 0, 1)

			if distance > radius then
				relativeX = (relativeX / distance) * radius
				relativeY = (relativeY / distance) * radius
			end

			wheelPin.Position = UDim2.new(0.5, relativeX/FWNoModules.Mobile.ScaleOf(wheelImage), 0.5, relativeY/FWNoModules.Mobile.ScaleOf(wheelImage))

			local pickedColor = Color3.fromHSV(hue, saturation, 1)
			rSlider.Text = tostring(math.floor(pickedColor.R * 255))
			gSlider.Text = tostring(math.floor(pickedColor.G * 255))
			bSlider.Text = tostring(math.floor(pickedColor.B * 255))

			updateColor()

		end

		local function syncPinPosition()
			local r = tonumber(rSlider.Text) or 255
			local g = tonumber(gSlider.Text) or 255
			local b = tonumber(bSlider.Text) or 255
			local h,s,v = Color3.fromRGB(r,g,b):ToHSV()

			local angle = (h * 2 * math.pi) - math.pi
			local radius = (wheelImage.AbsoluteSize.X / (2*FWNoModules.Mobile.ScaleOf(wheelImage))) * s

			wheelPin.Position = UDim2.new(0.5, math.cos(angle) * radius, 0.5, math.sin(angle) * radius)
		end

		mod.UpdateFunctions[cName] = function(forceColor)
            FWNoModules.Profiles.TouchBinding(settingID)
			rSlider.Text = tostring(math.floor(forceColor.R * 255))
			gSlider.Text = tostring(math.floor(forceColor.G * 255))
			bSlider.Text = tostring(math.floor(forceColor.B * 255))
			updateColor()
		end

        FWNoModules.Profiles.Register(settingID,function()return mod.Values[cName]end,function(v)
            if typeof(v)~="Color3" then
                local scale=(v.R>1 or v.G>1 or v.B>1)and 255 or 1
                v=Color3.new(v.R/scale,v.G/scale,v.B/scale)
            end
            mod.Values[cName]=v;_G.SavedConfig[settingID]=v
            rSlider.Text=tostring(math.floor(v.R*255));gSlider.Text=tostring(math.floor(v.G*255));bSlider.Text=tostring(math.floor(v.B*255))
            wheelBtn.BackgroundColor3=v
            if cCallback then cCallback(v)end
            if mod.Callbacks.OnValueChanged then mod.Callbacks.OnValueChanged(cName,v)end
            if wheelPopup then syncPinPosition()end
        end,mod,"setting")
        local function ensureWheel()
			if wheelPopup then return end
			local mainTargetGui = (settingsCont and settingsCont:FindFirstAncestorOfClass("ScreenGui")) 
				or G.Services.CoreGui:FindFirstChildOfClass("ScreenGui") 
				or G.Services.Players.LocalPlayer:WaitForChild("PlayerGui"):FindFirstChildOfClass("ScreenGui") 
				or settingsCont
	
			wheelPopup = FWNoModules.OwnInstance(Instance.new("Frame", mainTargetGui))
