Run(function()
	local AutoBlockUp
	local Mode
	local LimitItem
	local ReturnSlot
	local Center
	local Blacklist
	local Started: boolean = false
	local Held: boolean = false
	local Owned: boolean = false
	local Warned: string?
	local Previous: number?
	local Equipped: number?
	local Jump: number?
	local JumpHumanoid: Humanoid?
	local LostAt: number?
	local LastPlace: number = 0
	local LastTarget: Vector3?
	local Cooldown: number = 0
	local LastError: number = 0
	local Raise: Vector3 = Vector3.new(0, 3, 0)
	local Gate: number = 0.15
	local MinHealth: number = 8
	local Faces: {Vector3} = {
	    Vector3.new(0, -3, 0),
	    Vector3.new(3, 0, 0),
	    Vector3.new(-3, 0, 0),
	    Vector3.new(0, 0, 3),
	    Vector3.new(0, 0, -3)
	}
	
	local function Warn(Text: string)
	    if Warned ~= Text then
	        Warned = Text
	        SendNotification("AutoBlockUp", Text, 3, "warning", "AutoBlockUpWarning")
	    end
	end
	
	local function Suppress()
	    if JumpHumanoid or vape.MovementOwner or not Entity.isAlive then
	        return
	    end
	
	    vape.MovementOwner, Owned = "AutoBlockUp", true
	    JumpHumanoid = Entity.character.Humanoid
	    Jump = JumpHumanoid.JumpHeight
	    JumpHumanoid.JumpHeight = 0
	end
	
	local function Unsuppress()
	    if JumpHumanoid and Jump and JumpHumanoid.JumpHeight == 0 then
	        JumpHumanoid.JumpHeight = Jump
	    end
	    if Owned and vape.MovementOwner == "AutoBlockUp" then
	        vape.MovementOwner = nil
	    end
	    Jump, JumpHumanoid, Owned = nil, nil, false
	end
	
	local function Release()
	    if ReturnSlot.Enabled and Previous and Equipped == store.inventory.hotbarSlot and Entity.isAlive then
	        task.spawn(HotbarSwitch, Previous)
	    end
	    Unsuppress()
	    Started, Warned, Previous, Equipped, LostAt = false, nil, nil, nil, nil
	    Cooldown = os.clock() + 0.2
	end
	
	local function IsBlacklisted(ItemType: string): boolean
	    return table.find(Blacklist.ListEnabled, ItemType) ~= nil or (ItemType:find("wool") ~= nil and table.find(Blacklist.ListEnabled, "wool") ~= nil)
	end
	
	local function GetBlock(): (string?, number?)
	    local Hand = store.hand
	    if Hand.toolType == "block" and Hand.tool and (Hand.amount or 0) > 0 and not IsBlacklisted(Hand.tool.Name) then
	        return Hand.tool.Name, nil
	    end
	    if LimitItem.Enabled then
	        return nil, nil
	    end
	
	    local Best: string?
	    local BestSlot: number?
	    local BestRank, BestHealth = math.huge, math.huge
	    for _, v: any in store.inventory.inventory.items do
	        local Block = bedwars.ItemMeta[v.itemType] and bedwars.ItemMeta[v.itemType].block
	        if Block and (Block.health or 0) >= MinHealth and (v.amount or 0) > 0 and not IsBlacklisted(v.itemType) then
	            local Slot: number? = GetHotbar(v.tool)
	            local Rank: number = (Slot and 0 or 2) + (v.itemType:find("wool") and 0 or 1)
	            if Rank < BestRank or (Rank == BestRank and Block.health < BestHealth) then
	                Best, BestSlot, BestRank, BestHealth = v.itemType, Slot, Rank, Block.health
	            end
	        end
	    end
	    return Best, BestSlot
	end
	
	local function IsAnchored(Target: Vector3): boolean
	    for _, v: Vector3 in Faces do
	        if GetPlacedBlock(Target + v) then
	            return true
	        end
	    end
	    return false
	end
	
	local function GetDelay(): number
	    return 1 / math.max(math.min(bedwars.DefaultPlaceCPS or math.huge, bedwars.SharedConstants.BLOCK_PLACE_CPS), 1)
	end
	
	local function IsAllowed(Target: Vector3): boolean
	    if LocalPlayer:GetAttribute("DenyBlockPlace") then
	        return false
	    end
	
	    local Map = bedwars.MapController
	    if not Map then
	        return true
	    end
	
	    local Cell: Vector3 = bedwars.BlockController:getBlockPosition(Target)
	    local Checked, Denied = pcall(Map.isInDenyRegion, Map, Cell)
	    if Checked and Denied then
	        return false
	    end
	
	    Checked, Denied = pcall(Map.isOutOfBounds, Map, Cell)
	    return not (Checked and Denied)
	end
	
	local function Locate(): (Vector3?, string?, string?)
	    if not Entity.isAlive then
	        return nil, nil, nil
	    end
	
	    local Position: Vector3 = Entity.character.RootPart.Position
	    local Feet: number = Position.Y - Entity.character.HipHeight
	    local Target: Vector3 = RoundPosition(Vector3.new(Position.X, Feet - 1.5, Position.Z))
	    while Target.Y - 1.5 <= Feet + 3 and GetPlacedBlock(Target) do
	        Target += Raise
	    end
	    if Target.Y - 1.5 > Feet + 3 or GetPlacedBlock(Target + Raise) or GetPlacedBlock(Target + Raise * 2) or not IsAnchored(Target) then
	        return nil, nil, nil
	    end
	
	    local ItemType: string? = GetBlock()
	    if not ItemType then
	        return nil, nil, "No blocks to place"
	    end
	    if not IsAllowed(Target) then
	        return nil, nil, "Can't place blocks here"
	    end
	    return Target, ItemType, nil
	end
	
	local function SetHeld(Down: boolean)
	    Held = Down
	    if Down and Mode.Value == "Holding jump" and Locate() then
	        Suppress()
	    end
	end
	
	local function Step()
	    if not Entity.isAlive then
	        Unsuppress()
	        Started, Warned, Previous, Equipped, LostAt = false, nil, nil, nil, nil
	        return
	    end
	
	    local Owner: string? = vape.MovementOwner
	    local Jumping: boolean = Mode.Value == "Holding jump"
	    if (Owner and Owner ~= "AutoBlockUp") or (Jumping and not Held) then
	        if Started or Owned then
	            Release()
	        end
	        return
	    end
	
	    if not Started then
	        if os.clock() < Cooldown or (Jumping and not Locate()) then
	            return
	        end
	
	        Started = true
	        local ItemType, Slot = GetBlock()
	        if not ItemType then
	            Warn("No blocks to place")
	        elseif Slot and Slot ~= store.inventory.hotbarSlot then
	            Previous, Equipped = store.inventory.hotbarSlot, Slot
	            task.spawn(HotbarSwitch, Slot)
	        end
	        if Jumping then
	            Suppress()
	        end
	    end
	
	    local Root: BasePart = Entity.character.RootPart
	    local Position: Vector3 = Root.Position
	    if Center.Enabled and Entity.character.Humanoid.MoveDirection.Magnitude < 0.1 and Entity.character.Humanoid.FloorMaterial ~= Enum.Material.Air and isnetworkowner(Root) then
	        local Middle: Vector3 = RoundPosition(Position)
	        if math.abs(Middle.X - Position.X) > 0.05 or math.abs(Middle.Z - Position.Z) > 0.05 then
	            Root.CFrame = CFrame.new(Middle.X, Position.Y, Middle.Z) * Root.CFrame.Rotation
	            Position = Root.Position
	        end
	    end
	
	    local Now: number = workspace:GetServerTimeNow()
	    if Now - math.max(LastPlace, bedwars.BlockCpsController.lastPlaceTimestamp) < GetDelay() or not CanPlace() then
	        return
	    end
	
	    local Target, ItemType, Reason = Locate()
	    if Jumping then
	        if Target then
	            LostAt = nil
	            Suppress()
	        else
	            LostAt = LostAt or os.clock()
	            if os.clock() - LostAt >= 0.25 then
	                Unsuppress()
	            end
	        end
	    elseif Reason then
	        Warn(Reason)
	    end
	    if not Target then
	        return
	    end
	
	    local Feet: number = Position.Y - Entity.character.HipHeight
	    if Target.Y - 1.5 > Feet + Gate or (Target == LastTarget and Now - LastPlace < 0.5) then
	        return
	    end
	
	    Warned = nil
	    LastPlace, LastTarget = Now, Target
	    task.spawn(bedwars.placeBlock, Target, ItemType)
	end
	
	AutoBlockUp = vape.Categories.Utility:CreateModule({
	    Name = "AutoBlockUp",
	    Function = function(Callback: boolean)
	        if Callback then
	            if not vape.Loaded and Mode.Value == "When enabled" then
	                task.defer(function()
	                    if AutoBlockUp.Enabled then
	                        AutoBlockUp:Toggle(true)
	                    end
	                end)
	                return
	            end
	
	            Started, Warned, Previous, Equipped, LostAt, LastPlace, Cooldown = false, nil, nil, nil, nil, 0, 0
	            SetHeld(not UserInputService:GetFocusedTextBox() and UserInputService:IsKeyDown(Enum.KeyCode.Space))
	            AutoBlockUp:Clean(UserInputService.InputBegan:Connect(function(Input: InputObject)
	                if not UserInputService:GetFocusedTextBox() and (Input.KeyCode == Enum.KeyCode.Space or Input.KeyCode == Enum.KeyCode.ButtonA) then
	                    SetHeld(true)
	                end
	            end))
	            AutoBlockUp:Clean(UserInputService.InputEnded:Connect(function(Input: InputObject)
	                if Input.KeyCode == Enum.KeyCode.Space or Input.KeyCode == Enum.KeyCode.ButtonA then
	                    SetHeld(false)
	                end
	            end))
	
	            local TouchGui = UserInputService.TouchEnabled and LocalPlayer.PlayerGui:FindFirstChild("TouchGui")
	            local JumpButton = TouchGui and TouchGui:FindFirstChild("JumpButton", true)
	            if JumpButton then
	                AutoBlockUp:Clean(JumpButton:GetPropertyChangedSignal("ImageRectOffset"):Connect(function()
	                    SetHeld(JumpButton.ImageRectOffset.X == 146)
	                end))
	            end
	
	            AutoBlockUp:Clean(RunService.Heartbeat:Connect(function()
	                local Success, ErrorMessage = pcall(Step)
	                if not Success and tick() > LastError then
	                    LastError = tick() + 5
	                    warn(`[catvape] autoblockup step failed: {ErrorMessage}`)
	                end
	            end))
	        else
	            Release()
	        end
	    end,
	    Tooltip = "Equips your blocks and builds a tower under you as fast as the game allows, then switches back to your last item. Pick when it runs with Mode"
	})
	
	Mode = AutoBlockUp:CreateDropdown({
	    Name = "Mode",
	    List = {"When enabled", "Holding jump"},
	    Default = "Holding jump",
	    Function = function()
	        if Started then
	            Release()
	        end
	    end,
	    Tooltip = "When enabled builds whenever the module is on (best with the bind set to hold). Holding jump builds while you hold jump and there is somewhere to build, cancelling that jump, and leaves your jump alone everywhere else"
	})
	LimitItem = AutoBlockUp:CreateToggle({
	    Name = "Limit to items",
	    Tooltip = "Only places the block already in your hand, never switches or digs through your inventory"
	})
	ReturnSlot = AutoBlockUp:CreateToggle({
	    Name = "Return to last slot",
	    Default = true,
	    Tooltip = "Switches back to what you were holding when it stops"
	})
	Center = AutoBlockUp:CreateToggle({
	    Name = "Center",
	    Default = true,
	    Tooltip = "Keeps you in the middle of your block while you are not moving so the tower stays one block wide"
	})
	Blacklist = AutoBlockUp:CreateTextList({
	    Name = "Blacklist",
	    Default = {"ballista", "cannon", "siege_tnt", "tnt"},
	    Tooltip = "Block types it will never place"
	})
end)

