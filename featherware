end

function acbTick()
	if not loops["auto charge bow"] then return end
	acb_h = acbGetHandler()
	if not acb_h then return end
	acb_char = Player.Character
	if not acb_char then return end
	acb_hi = acb_char:FindFirstChild("HandInvItem")
	acb_hv = acb_hi and acb_hi.Value
	acb_name = acb_hv and (typeof(acb_hv) == "Instance" and acb_hv.Name or tostring(acb_hv)) or nil
	if not acb_name or not paGetItemMeta then return end
	acb_ok, acb_meta = pcall(paGetItemMeta, acb_name)
	if not acb_ok or not acb_meta then return end
	acb_ps = acb_meta.projectileSource
	if not acb_ps or not acb_ps.maxStrengthChargeSec or acb_ps.maxStrengthChargeSec <= 0 then return end
	acb_maxT = acb_ps.maxStrengthChargeSec
	acb_minS = acb_ps.minStrengthScalar or 0.5
	acb_frac = math.clamp((AutoChargeBow.Values["Charge Percent"] or 100) / 100, 0, 1)
	acb_targetDraw = acb_maxT * acb_frac
	if (acb_h.drawDurationSeconds or 0) < acb_targetDraw then
		acb_h.drawDurationSeconds = acb_targetDraw
		acb_h.velocityMultiplier = acb_frac + (1 - acb_frac) * acb_minS
	end
end

