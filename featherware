			ER ES ET FI FO FR GA GB GG GH GI GM GN GQ GR GW HR HU IE IM IO IS IT JE KE KM LI LR LS
			LT LU LV LY MA MC MD ME MG MK ML MR MT MU MW MZ NA NE NG NL NO PL PT RE RO RS RU RW SC
			SD SE SH SI SJ SK SL SM SN SO SS ST SZ TD TF TG TN TZ UA UG VA XK YT ZA ZM ZW]],
		AS = [[AE AM AZ BD BH BN BT CN CY GE HK ID IL IN IQ IR JO JP KG KH KP KR KW KZ LA LB LK MM MN
			MO MV MY NP OM PH PK PS QA SG SY TH TJ TL TM TR TW UZ VN YE]],
		OCEANIA = [[AU CC CK CX FJ FM GU HM KI MH MP NC NF NR NU NZ PF PG PN PW SB TK TO TV UM VU WF WS]]
	}
	local Aliases: {[string]: string} = {
		NA = "NA",
		EU = "EU",
		AS = "AS",
		ASIA = "AS",
		OCEANIA = "OCEANIA",
		USA = "NA",
		AMERICA = "NA",
		UK = "EU",
		EUROPE = "EU",
		OCE = "OCEANIA",
		AUS = "OCEANIA",
		AUSTRALIA = "OCEANIA"
	}
	local Codes: {[string]: string} = {}
	
	for Name: string, List: string in Countries do
		for Code: string in List:gmatch("%a+") do
			Codes[Code] = Name
		end
	end
	
	local function Convert(Text: string): string?
		local Code: string? = Text:upper():gsub("<[^>]*>", ""):gsub("REGION:", ""):match("%a+")
		return Code and (Aliases[Code] or Codes[Code])
	end
	
	RegionLock = vape.Categories.Utility:CreateModule({
		Name = "RegionLock",
		Function = function(Callback: boolean)
			writefile(`{vape.Directory}/profiles/regionlock.txt`, tostring(Callback))
	
			local Hold = store.readyHold
			if not Callback then
				if Hold.Block == "RegionLock" then
					Hold.Block = nil
					if not (vape.Modules.AutoMatchDodge and vape.Modules.AutoMatchDodge.Enabled) then
						Hold.Release()
					end
				end
				return
			end
	
			if not Hold.Held then
				return
			end
	
			Hold.Claimed = true
			local Code: string?
			local Started: number = os.clock()
			repeat
				local Display: Instance? = LocalPlayer:WaitForChild("PlayerGui", 9e9):FindFirstChild("ServerRegionDisplay")
				local Label: TextLabel? = Display and Display:FindFirstChild("ServerRegionText")
				Code = Label and Label.Text:gsub("<[^>]*>", ""):gsub("REGION:%s*", ""):match("%S+")
				if not Code then
					task.wait(0.1)
				end
			until Code or not RegionLock.Enabled or not Hold.Held or os.clock() - Started > 30
	
			if not RegionLock.Enabled or not Hold.Held then
				return
			end
	
			if not Code then
				SendNotification("RegionLock", "Could not read the server region, loading anyway", 8, "warning")
				if not (vape.Modules.AutoMatchDodge and vape.Modules.AutoMatchDodge.Enabled) then
					Hold.Release()
				end
				return
			end
	
			local Region: string? = Convert(Code)
			local Selected: {[string]: boolean} = {}
			local Valid: boolean = false
			for _, v: string in Regions.ListEnabled do
				local Name: string? = Convert(v)
				if Name then
					Selected[Name] = true
					Valid = true
				end
			end
	
			if not Valid then
				SendNotification("RegionLock", "No valid region is turned on, loading every region", 8, "warning")
			elseif not Region then
				SendNotification("RegionLock", `Unknown region {Code}, loading anyway`, 8, "warning")
			end
	
			if not Valid or not Region or Selected[Region] then
				if not (vape.Modules.AutoMatchDodge and vape.Modules.AutoMatchDodge.Enabled) then
					Hold.Release()
				end
			else
				Hold.Block = "RegionLock"
				SendNotification("RegionLock", `Dodging {Code} ({Region}), it is not in your regions`, 12, "info")
			end
		end,
		ExtraText = function()
			return getgenv().Dodged and "Dodging" or "Game loaded"
		end,
		Tooltip = "Dodges matches on servers outside your selected regions. These settings carry over into the match"
	})
	
	Regions = RegionLock:CreateTextList({
		Name = "Regions",
		Placeholder = "NA / EU / AS / OCEANIA",
		Default = {"NA", "EU", "AS", "OCEANIA"},
		Function = function()
			if not Regions then
				return
			end
			for i: number, v: string in Regions.List do
				Regions.List[i] = v:gsub("%s+", ""):upper()
			end
			for i: number, v: string in Regions.ListEnabled do
				Regions.ListEnabled[i] = v:gsub("%s+", ""):upper()
			end
		end,
		Tooltip = "Turn off the regions you do not want. The server region is read from its data-center code: SG-03 counts as AS (ASIA too), AU and NZ as OCEANIA (AUS and OCE too), US-CA as NA. Leaving every region on accepts anything"
	})
	if RegionLock.Share then
		RegionLock:Share("regionlock")
	end
end)

Run(function()
	local ShopQuickBuy
	local HoldDelay
	local CPS
	
	local Holding: boolean = false
	local ClickThread: thread?
	
	local function GetShopId()
	    if not Entity.isAlive then
	        return nil
	    end
	    local LocalPosition: Vector3 = Entity.character.RootPart.Position
	    local Id
	    for _, v: any in store.shop do
	        if v.Shop and (v.RootPart.Position - LocalPosition).Magnitude <= 20 then
	            Id = v.Id
	        end
	    end
	    return Id
	end
	
	local function GetHoveredItem(): string?
	    local MousePosition: Vector2 = (UserInputService:GetMouseLocation() - GuiService:GetGuiInset())
	    for _, v: GuiObject in LocalPlayer.PlayerGui:GetGuiObjectsAtPosition(MousePosition.X, MousePosition.Y) do
	        local Object: Instance? = v
	        while Object and Object ~= LocalPlayer.PlayerGui do
	            local ItemType: string? = Object.Name:match("^(.+)_ShopItemCard$")
	            if ItemType then
	                return ItemType
	            end
	            Object = Object.Parent
	        end
	    end
	end
	
	local function StartClicking(ItemType: string)
	    if ClickThread then
	        task.cancel(ClickThread)
	    end
	    ClickThread = task.spawn(function()
	        repeat
	            local ShopId = bedwars.AppController:isAppOpen("BedwarsItemShopApp") and store.shopLoaded and GetShopId()
	            if ShopId and bedwars.BedwarsShopController.alreadyPurchasedMap[ItemType] == nil then
	                local Item = bedwars.Shop.getShopItem(ItemType, LocalPlayer, {shopId = ShopId})
	                local Currency = Item and GetItem(Item.currency)
	                local Buyable = Item and not (Item.ignoredByKit and table.find(Item.ignoredByKit, store.equippedKit or "")) and not Item.lockedByForge and not Item.disabled and (Currency and Currency.amount or 0) >= Item.price
	                if Buyable and Item.require and Item.require.teamUpgrade and (bedwars.Store:getState().Bedwars.teamUpgrades[Item.require.teamUpgrade.upgradeId] or -1) < Item.require.teamUpgrade.lowestTierIndex then
	                    Buyable = false
	                end
	
	                if Buyable then
	                    bedwars.Handler:Get("BedwarsPurchaseItem"):Fire("CallServerAsync", {
	                        shopItem = Item,
	                        shopId = ShopId
	                    }):andThen(function(Success)
	                        if not Success then
	                            return
	                        end
	                        bedwars.AudioManager:playAudio(bedwars.SoundList.BEDWARS_PURCHASE_ITEM)
	                        bedwars.Store:dispatch({
	                            type = "BedwarsAddItemPurchased",
	                            itemType = ItemType
	                        })
	                        if Item.tiered then
	                            bedwars.BedwarsShopController.alreadyPurchasedMap[ItemType] = true
	                        end
	                    end)
	                end
	            end
	            task.wait(1 / CPS.Value)
	        until not Holding
	        ClickThread = nil
	    end)
	end
	
	ShopQuickBuy = vape.Categories.Utility:CreateModule({
	    Name = "ShopClicker",
	    Function = function(Callback: boolean)
	        if Callback then
	            ShopQuickBuy:Clean(UserInputService.InputBegan:Connect(function(Input: InputObject)
	                if Input.UserInputType ~= Enum.UserInputType.MouseButton1 then
	                    return
	                end
	                if not bedwars.AppController:isAppOpen("BedwarsItemShopApp") then
	                    return
	                end
	
	                local ItemType: string? = GetHoveredItem()
	                if not ItemType then
	                    return
	                end
	
	                Holding = true
	                task.delay(HoldDelay.Value, function()
	                    if Holding and GetHoveredItem() == ItemType then
	                        StartClicking(ItemType)
	                    end
	                end)
	            end))
	
	            ShopQuickBuy:Clean(UserInputService.InputEnded:Connect(function(Input: InputObject)
	                if Input.UserInputType == Enum.UserInputType.MouseButton1 then
	                    Holding = false
	                end
	            end))
	        else
	            Holding = false
	            if ClickThread then
	                task.cancel(ClickThread)
	                ClickThread = nil
	            end
	        end
	    end,
	    Tooltip = "Hold on a shop item to rapidly buy it."
	})
	
	HoldDelay = ShopQuickBuy:CreateSlider({
