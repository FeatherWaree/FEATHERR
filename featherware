function aadAddCand(part)
	if not part or not part:IsA("BasePart") or not part.Parent then return end
	aadc_mc = aadMyChar()
	if aadc_mc and part:IsDescendantOf(aadc_mc) then return end
	aadc_pos = part.Position; aadc_now = tick()
	aadc_h = aad.hist[part]
	if aadc_h then
		aadc_dt = aadc_now - aadc_h.t
		if aadc_dt > 0.001 and aadc_dt < 0.25 then
			aadc_dpos = aadc_pos - aadc_h.p
			aadc_spd = aadc_dpos.Magnitude / aadc_dt
			if aadc_spd > 30 then
				aadc_my = aad_hrp and aad_hrp.Position
				if aadc_my and (aadc_pos - aadc_my):Dot(aadc_dpos) < 0 then
					aadc_uid = tonumber(part:GetAttribute("ProjectileShooter"))
					aadc_verdict = aadOwnerVerdictFromUserId(aadc_uid)
					if aadc_verdict == "enemy" then
						aadc_hint = (part.Parent and part.Parent.Name) or part.Name
						if aadIngest(nil, aadc_dpos / aadc_dt, aadc_pos, aadc_verdict, aadc_hint) and not aad.dScan then aad.dScan = true end
					end
				end
			end
		end
	end
	aad.hist[part] = { p = aadc_pos, t = aadc_now }
end

function aadScan()
	aad.histFrame = aad.histFrame + 1
	if aad.histFrame % 60 == 0 then
		aad_hn = {}
		for aad_hk, aad_hv in pairs(aad.hist) do if aad_hk.Parent then aad_hn[aad_hk] = aad_hv end end
		aad.hist = aad_hn
	end
	for _, aad_tag in ipairs({"Projectile", "projectile"}) do
		for _, aad_ti in ipairs(aadCS:GetTagged(aad_tag)) do
			aadAddCand(aad_ti:IsA("BasePart") and aad_ti or aad_ti.PrimaryPart)
		end
	end
	aad_roots = { G.Services.Workspace }
	for _, aad_ch in ipairs(G.Services.Workspace:GetChildren()) do
		if aad_ch:IsA("Folder") or aad_ch:IsA("Model") then
			aad_low = aad_ch.Name:lower()
			if aad_low:find("projectile") or aad_low:find("effect") or aad_low:find("combat") or aad_low:find("arrow") then table.insert(aad_roots, aad_ch) end
		end
	end
	for _, aad_r in ipairs(aad_roots) do
		for _, aad_ch in ipairs(aad_r:GetChildren()) do
			aadAddCand(aad_ch:IsA("BasePart") and aad_ch or (aad_ch:IsA("Model") and aad_ch.PrimaryPart or nil))
		end
	end
end

function aadThreat(C, mode)
	aat_rad = (mode == "Blatant") and AAD_HIT_R_BLAT or AAD_HIT_R_LEG
	aat_react = (mode == "Blatant") and AAD_REACT_BLAT or AAD_REACT_LEG
	aat_maxD = AutoArrowDodge.Values["Distance"] or 300
	aat_bLow = C.Y + AAD_BAND_LOW
	aat_bHigh = C.Y + AAD_BAND_HIGH
	aat_now = tick()
	aat_best = false; aat_bestTtc = 999; aat_bestV = Vector3.zero
	for aat_j = 1, #aad.list do
		aat_e = aad.list[aat_j]; aat_a0 = aat_now - aat_e.t0
		if aat_a0 >= 0 and aat_a0 <= aat_e.life then
			aat_P0 = aadPosAt(aat_e, aat_a0); aat_V0 = aadVelAt(aat_e, aat_a0)
			aat_hN = Vector3.new(aat_P0.X - C.X, 0, aat_P0.Z - C.Z)
			if aat_hN.Magnitude <= aat_maxD then
				if aat_hN.Magnitude <= aat_rad and aat_P0.Y >= aat_bLow and aat_P0.Y <= aat_bHigh then
					aat_bestTtc = 0; aat_bestV = aat_V0; aat_best = true
				else
					aat_hV = Vector3.new(aat_V0.X, 0, aat_V0.Z); aat_vh2 = aat_hV:Dot(aat_hV)
					if aat_vh2 > 0.01 then
						aat_th = aat_a0 - aat_hN:Dot(aat_hV) / aat_vh2
						if aat_th < aat_a0 then aat_th = aat_a0 end
						if aat_th > aat_a0 + aat_react then aat_th = aat_a0 + aat_react end
						aat_Ph = aadPosAt(aat_e, aat_th)
						aat_hh = Vector3.new(aat_Ph.X - C.X, 0, aat_Ph.Z - C.Z).Magnitude
						if aat_hh <= aat_rad and aat_Ph.Y >= aat_bLow and aat_Ph.Y <= aat_bHigh then
							aat_ttc = aat_th - aat_a0
							if aat_ttc <= aat_react and aat_ttc < aat_bestTtc then
								aat_bestTtc = aat_ttc; aat_bestV = aadVelAt(aat_e, aat_th); aat_best = true
							end
						end
					end
				end
			end
		end
	end
	aad.threatTtc = aat_best and aat_bestTtc or 999
	aad.threatV = aat_bestV
	return aat_best
end

function aadHoldDanger()
	ahd_low = aad.origCF.Position.Y + AAD_BAND_LOW
	ahd_high = aad.origCF.Position.Y + AAD_CEIL_CAP
	ahd_my = aad_hrp.Position
	ahd_now = tick(); ahd_maxY = -1e9; ahd_any = false
	for ahd_i = 1, #aad.list do
		ahd_e = aad.list[ahd_i]; ahd_age = ahd_now - ahd_e.t0
		if ahd_age >= 0 and ahd_age <= ahd_e.life then
			ahd_P = aadPosAt(ahd_e, ahd_age)
			ahd_hd = Vector3.new(ahd_P.X - ahd_my.X, 0, ahd_P.Z - ahd_my.Z).Magnitude
			if ahd_hd <= AAD_HOLD_CLEAR and ahd_P.Y >= ahd_low and ahd_P.Y <= ahd_high then
				ahd_any = true
				if ahd_P.Y > ahd_maxY then ahd_maxY = ahd_P.Y end
			end
		end
	end
	return ahd_any, ahd_maxY
end

