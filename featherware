            end
            if not state.visible or radiusChanged or center ~= state.center then
                local frame = CFrame.new(center)
                for index = 1, 24 do kaRingSegs[index].CFrame = frame * state.offsets[index] end
                state.center = center
            end
            if color ~= state.color then
                for index = 1, 24 do kaRingSegs[index].Color = color end
                state.color = color
            end
            if not state.visible then
                for index = 1, 24 do kaRingSegs[index].Transparency = 0.15 end
                state.visible = true
            end
            if kaRingFolder.Parent ~= G.Services.Workspace then kaRingFolder.Parent = G.Services.Workspace end
