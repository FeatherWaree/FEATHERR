QuickCollect.Callbacks.OnToggle = function(state)
	loops["quickcollect"] = state
	pickup_gen = pickup_gen + 1
	qc_myGen = pickup_gen

	-- Clean up any existing connections to prevent memory leaks
	if qc_connAdded then qc_connAdded:Disconnect(); qc_connAdded = nil end
	if qc_connRemoved then qc_connRemoved:Disconnect(); qc_connRemoved = nil end
	if qc_loopConn then qc_loopConn:Disconnect(); qc_loopConn = nil end

	if state then
		-- 1. Track spawn times when item drops appear via CollectionService
		qc_connAdded = qc_cs:GetInstanceAddedSignal("ItemDrop"):Connect(function(qc_item)
			qc_spawnTimes[qc_item] = tick()
		end)

		qc_connRemoved = qc_cs:GetInstanceRemovedSignal("ItemDrop"):Connect(function(qc_item)
			qc_spawnTimes[qc_item] = nil
			pcall(function() qc_item:SetAttribute("ClientPickupAttemptTime", nil) end)
		end)

		-- Populate items already existing in the world
		for _, qc_item in ipairs(qc_cs:GetTagged("ItemDrop")) do
			if not qc_spawnTimes[qc_item] then
				qc_spawnTimes[qc_item] = tick()
			end
		end

		-- 2. Heartbeat-driven check (Optimized to skip frames if character is missing)
		qc_lastCheck = 0
		qc_loopConn = game:GetService("RunService").Heartbeat:Connect(function(dt)
			if not loops["quickcollect"] or qc_myGen ~= pickup_gen then return end

			-- Throttle check to every 0.05 seconds to save CPU, while respecting the slider smoothly
			qc_lastCheck = qc_lastCheck + dt
			if qc_lastCheck < 0.05 then return end
			qc_lastCheck = 0

			pcall(function()
				qc_char = qc_player.Character
				qc_hrp = qc_char and qc_char:FindFirstChild("HumanoidRootPart")
				if not qc_hrp then return end

				qc_delay = QuickCollect.Values["Pickup Delay"] or 0
				qc_range = 6
				if loops["resource collector"] and ResourceCollector then
					qc_range = ResourceCollector.Values["Pickup Range"] or 6
				end

				qc_count = 0
				qc_now = tick()

				for qc_item, qc_spawn in pairs(qc_spawnTimes) do
					if qc_count >= 5 then break end

					if qc_item and qc_item.Parent then
						if qc_spawn and (qc_now - qc_spawn >= qc_delay) then
							-- Get the primary part or position of the item drop
							qc_itemPart = qc_item:IsA("Model") and (qc_item.PrimaryPart or qc_item:FindFirstChildWhichIsA("BasePart")) or qc_item

							if qc_itemPart and qc_itemPart:IsA("BasePart") then
								qc_dist = (qc_hrp.Position - qc_itemPart.Position).Magnitude
								if qc_dist <= qc_range then
									qc_lastAttempt = qc_item:GetAttribute("ClientPickupAttemptTime")
									if qc_lastAttempt == nil or (qc_now - qc_lastAttempt > 0.1) then
										qc_item:SetAttribute("ClientPickupAttemptTime", qc_now)

										-- Invoke the server using your exact specified path structure
										if qc_pickupRemote then
											task.spawn(function()
												pcall(function()
													qc_pickupRemote:InvokeServer({ itemDrop = qc_item })
												end)
											end)
										end
										qc_count = qc_count + 1
									end
								end
							end
						end
					else
						-- Clean up dead items from the tracking table
						qc_spawnTimes[qc_item] = nil
					end
				end
			end)
		end)
	else
		-- Full Cleanup / Zero Memory Leak state
		if qc_connAdded then qc_connAdded:Disconnect(); qc_connAdded = nil end
		if qc_connRemoved then qc_connRemoved:Disconnect(); qc_connRemoved = nil end
		if qc_loopConn then qc_loopConn:Disconnect(); qc_loopConn = nil end

		for _, qc_item in ipairs(qc_cs:GetTagged("ItemDrop")) do
			pcall(function() qc_item:SetAttribute("ClientPickupAttemptTime", nil) end)
		end
		table.clear(qc_spawnTimes)
	end
end

