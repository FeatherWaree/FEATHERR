		end)
		healSwapBack()
	end

	healData.isConsuming = false
end

healConsumeLegit = function(itemInstance)
	if healData.isConsuming then return end
	healData.isConsuming = true

	if healSwapToItem(itemInstance) then
		-- 1. Apply Movement Slow (Legit)
		if canRequire then
			pcall(function()
				knit = require(ReplicatedStorage:WaitForChild("rbxts_include", 5):WaitForChild("node_modules", 5):WaitForChild("@easy-games", 5):WaitForChild("knit", 5):WaitForChild("src", 5)).KnitClient
				healData.sprintMod = {blockSprint = true, moveSpeedMultiplier = 0.5}
				knit.Controllers.SprintController:getMovementStatusModifier():addModifier(healData.sprintMod)
			end)
		end

		-- 2. Play Animation & Sound Loop
		if canRequire then
			pcall(function()
				GameAnimationUtil = require(ReplicatedStorage:WaitForChild("TS", 5):WaitForChild("animation", 5):WaitForChild("animation-util", 5)).GameAnimationUtil
				AnimationType = require(ReplicatedStorage:WaitForChild("TS", 5):WaitForChild("animation", 5):WaitForChild("animation-type", 5)).AnimationType
				SoundManager = require(ReplicatedStorage:WaitForChild("rbxts_include", 5):WaitForChild("node_modules", 5):WaitForChild("@easy-games", 5):WaitForChild("game-core", 5):WaitForChild("out", 5)).SoundManager
				GameSound = require(ReplicatedStorage:WaitForChild("TS", 5):WaitForChild("sound", 5):WaitForChild("game-sound", 5)).GameSound

				healData.animTrack = GameAnimationUtil:playAnimation(PlayersService.LocalPlayer, AnimationType.EAT, {looped = true})

				healData.soundTask = task.spawn(function()
					while healData.isConsuming do
						SoundManager:playSound(GameSound.EAT_FOOD_1)
						task.wait(SOUND_INTERVAL)
					end
				end)
			end)
		end

		-- 3. Monitor for manual swaps or damage (Cancel if interrupted)
		char = PlayersService.LocalPlayer.Character
		handInv = char and char:FindFirstChild("HandInvItem")
		if handInv then
			healData.handConn = handInv.Changed:Connect(function(newVal)
				if newVal ~= itemInstance then
					healData.isConsuming = false -- Interrupt
				end
			end)
		end

		-- 4. Wait for consume time
		healData.consumeEndTime = os.clock() + CONSUME_TIME
		while healData.isConsuming and os.clock() < healData.consumeEndTime do
			task.wait(0.05)
		end

		-- 5. Fire remote if not interrupted
		if healData.isConsuming then
			pcall(function()
				healData.consumeRemote:InvokeServer({item = itemInstance})
			end)
		end

		-- 6. Cleanup effects and swap back
		healStopLegitEffects()
		healSwapBack()
	end

	healData.isConsuming = false
end

healCheckAndConsume = function()
	if not loops["auto heal"] then return end
	if healData.isConsuming then return end

	char = PlayersService.LocalPlayer.Character
	if not char then return end
	hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return end

	hpPercent = (hum.Health / hum.MaxHealth) * 100
	hpThreshold = healSettings.hpPercent
	gAppleThreshold = healSettings.gApplePercent

	-- Priority: Apple -> Shield -> Golden Apple
	if healSettings.useApple and hpPercent <= hpThreshold then
		apple = healGetItemInstance("apple")
		if apple then
			if healSettings.mode == "Blatant" then healConsumeBlatant(apple) else healConsumeLegit(apple) end
			return
		end
	end

	if healSettings.useShield and hpPercent <= hpThreshold then
		shield = healGetItemInstance("mini_shield")
		if shield then
			if healSettings.mode == "Blatant" then healConsumeBlatant(shield) else healConsumeLegit(shield) end
			return
		end
	end

	if healSettings.useGApple and hpPercent <= gAppleThreshold then
		gApple = healGetItemInstance("golden_apple")
		if gApple then
			if healSettings.mode == "Blatant" then healConsumeBlatant(gApple) else healConsumeLegit(gApple) end
			return
		end
	end
end

