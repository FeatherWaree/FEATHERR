-- Anti AFK sends the supplied game status only while its button is enabled.
FWNoModules.AntiAFK = {}
do
    local controller = FWNoModules.AntiAFK
    local enabled = false
    local timer
    local generation = 0
    local path = {"rbxts_include", "node_modules", "@rbxts", "net", "out", "_NetManaged", "AfkInfo"}
    local function sendStatus()
        local remote = G.Services.RS
        for _, name in ipairs(path) do
            remote = remote and remote:FindFirstChild(name)
            if not remote then return false end
        end
        if not remote:IsA("RemoteEvent") then return false end
        return pcall(function() remote:FireServer({afk = false}) end)
    end
    function controller.SetEnabled(state)
        state = state == true and FWNoModules.Runtime.active
        if enabled == state then return end
        enabled = state
        generation += 1
        local token = generation
        if timer then pcall(task.cancel, timer); timer = nil end
        if not state then return end
        local function pulse()
            if not enabled or generation ~= token or not FWNoModules.Runtime.active then return end
            timer = nil
            local sent = sendStatus()
            if enabled and generation == token and FWNoModules.Runtime.active then
                timer = task.delay(sent and 1200 or 15, pulse)
            end
        end
        pulse()
    end
    FWNoModules.OnCleanup(function() controller.SetEnabled(false) end)
end

AntiAFK = Utility:CreateButton("Anti AFK", function(state)
    FWNoModules.AntiAFK.SetEnabled(state)
end, true)

-- Spectate is event-driven: no frame loop, roster polling, or work while disabled.
FWNoModules.Spectator = {}
do
    local controller = FWNoModules.Spectator
    local enabled = false
    local alive = true
    local generation = 0
    local queued = false
    local records = {}
    local roster = {}
    local connections = {}
    local targetConnections = {}
    local cameraConnections = {}
    local target
    local activeCamera
    local subject
    local transition
    local transitionConnection
    local transitionVersion = 0
    local cardTween
    local restoreConnections = {}
    local gui, card, face, display, username, details, kit, status
    local refresh
    local choose
    local requestRefresh
    local applyCamera

    local function disconnect(list)
        for _, connection in ipairs(list) do connection:Disconnect() end
        table.clear(list)
    end
    local function watch(list, signal, callback)
        list[#list + 1] = FWNoModules.Connect(signal, callback)
    end
    local function ownSubject()
        local character = Player.Character
        return character and (character:FindFirstChildOfClass("Humanoid")
            or character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart)
    end
    local function restoreCamera()
        disconnect(restoreConnections)
        local function restore()
            local camera = G.Services.Workspace.CurrentCamera
            local own = ownSubject()
            if not camera or not own then return false end
            camera.CameraSubject = own
            camera.CameraType = Enum.CameraType.Custom
            disconnect(restoreConnections)
            return true
        end
        if restore() then return end
        local function watchCharacter(character)
            disconnect(restoreConnections)
            if restore() then return end
            if character then watch(restoreConnections, character.ChildAdded, restore) end
            watch(restoreConnections, Player.CharacterAdded, watchCharacter)
        end
        watchCharacter(Player.Character)
    end
    local function sameTeam(other)
        if Player.Team ~= nil and other.Team ~= nil then return Player.Team == other.Team end
        local own = Player:GetAttribute("Team")
        if own == nil then own = Player:GetAttribute("TeamId") end
        local theirs = other:GetAttribute("Team")
        if theirs == nil then theirs = other:GetAttribute("TeamId") end
        return own ~= nil and theirs ~= nil and own == theirs
    end
    local function teamLabel(player)
        if player.Team then return player.Team.Name end
        local value = player:GetAttribute("Team")
        if value == nil then value = player:GetAttribute("TeamId") end
        return value ~= nil and tostring(value) or nil
    end
    function controller.GetPlayerOptions()
        local options = {}
        for _, player in ipairs(Players:GetPlayers()) do
            local character = player.Character
            local root = character and (character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart)
            if player ~= Player and character and character:IsDescendantOf(G.Services.Workspace)
                and root and root:IsA("BasePart") then options[#options + 1] = player.Name end
        end
        table.sort(options)
        if #options == 0 then options[1] = "None" end
        return options
    end
    function controller.GetTeamOptions()
        local seen, options = {}, {}
        local function include(name)
            if name and not seen[name] then seen[name] = true; options[#options + 1] = name end
        end
        local ok, teams = pcall(function() return game:GetService("Teams"):GetTeams() end)
        if ok then for _, team in ipairs(teams) do include(team.Name) end end
        for _, player in ipairs(Players:GetPlayers()) do include(teamLabel(player)) end
        table.sort(options)
        if #options == 0 then options[1] = "None" end
        return options
    end
    function controller.ValidateSelection()
        if not Spectate then return end
        local mode = Spectate.Values["Cycle Through"]
        local exists = true
        if mode == "Specific Player" then
            exists = false
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= Player and player.Name == Spectate.Values["Player"]
                    and (not enabled or records[player]) then exists = true; break end
            end
        elseif mode == "Specific Team" then
            local selected = Spectate.Values["Team"]
            exists = selected ~= nil and selected ~= "None" and table.find(controller.GetTeamOptions(), selected) ~= nil
        elseif mode ~= "Everyone" and mode ~= "Teammates" and mode ~= "Enemies" then
            exists = false
        end
        if not exists then
            if Spectate.UpdateFunctions and Spectate.UpdateFunctions["Cycle Through"] then
                Spectate.UpdateFunctions["Cycle Through"]("Everyone")
            else
                Spectate.Values["Cycle Through"] = "Everyone"
                _G.SavedConfig["Utility_Spectate_Cycle Through"] = "Everyone"
                saveConfigToPC()
            end
        end
    end
    local function allowed(player)
        if player == Player or not records[player] then return false end
        local filter = Spectate and Spectate.Values["Cycle Through"] or "Everyone"
        if filter == "Teammates" then return sameTeam(player) end
        if filter == "Enemies" then return not sameTeam(player) end
        if filter == "Specific Player" then return player.Name == Spectate.Values["Player"] end
        if filter == "Specific Team" then return teamLabel(player) == Spectate.Values["Team"] end
        return true
    end
    local function physical(player)
        local record = records[player]
        local character = record and record.character
        if not character or not character:IsDescendantOf(G.Services.Workspace) then return nil end
        local root = character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart
        if not root or not root:IsA("BasePart") or not root:IsDescendantOf(character) then return nil end
        return root, character:FindFirstChildOfClass("Humanoid")
    end
    local function cancelTransition()
        transitionVersion += 1
        if transitionConnection then transitionConnection:Disconnect(); transitionConnection = nil end
        if transition then transition:Cancel(); transition = nil end
    end
    local function make(kind, parent, properties)
        local object = FWNoModules.OwnInstance(Instance.new(kind))
        for key, value in pairs(properties) do object[key] = value end
        object.Parent = parent
        return object
    end
    local function text(parent, name, position, size, fontSize, color)
        return make("TextLabel", parent, {
            Name = name, Position = position, Size = size, TextSize = fontSize,
            BackgroundTransparency = 1, FontFace = Font.fromName(textFont), Text = "",
            TextColor3 = color or Color3.fromRGB(240, 240, 240),
            TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
        })
    end
    local function createGui()
        gui = make("ScreenGui", nil, {
            Name = "Featherware_Spectate", ResetOnSpawn = false, IgnoreGuiInset = true,
            ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 2147483647,
        })
        pcall(function() gui.Parent = G.Services.CoreGui end)
        if not gui.Parent then gui.Parent = PlayerGui end
        card = make("Frame", gui, {
            Name = "PlayerInfo", AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 20, 1, -24),
            Size = UDim2.new(0.9, 0, 0, 142), BackgroundColor3 = Color3.fromRGB(26, 26, 26),
            BorderSizePixel = 0, BackgroundTransparency = 0.08,
        })
        make("UISizeConstraint", card, {MaxSize = Vector2.new(380, 142)})
        uiCorner(card, 8)
        make("UIStroke", card, {Color = Color3.fromRGB(65, 65, 65), Thickness = 1, Transparency = 0.25})
        face = make("ImageLabel", card, {
            Name = "AvatarFace", Size = UDim2.new(0, 68, 0, 68), Position = UDim2.new(0, 14, 0, 29),
            BackgroundColor3 = Color3.fromRGB(39, 39, 39), BorderSizePixel = 0, Image = "",
        })
        uiCorner(face, 8)
        status = text(card, "Status", UDim2.new(0, 14, 0, 7), UDim2.new(1, -28, 0, 19), 13, Color3.fromRGB(160, 160, 160))
        display = text(card, "DisplayName", UDim2.new(0, 94, 0, 29), UDim2.new(1, -108, 0, 26), 22)
        username = text(card, "Username", UDim2.new(0, 94, 0, 56), UDim2.new(1, -108, 0, 19), 14, Color3.fromRGB(175, 175, 175))
        details = text(card, "ClanLevel", UDim2.new(0, 94, 0, 78), UDim2.new(1, -108, 0, 19), 13)
        kit = text(card, "Kit", UDim2.new(0, 14, 0, 100), UDim2.new(1, -28, 0, 18), 13)
        local hint = text(card, "Hint", UDim2.new(0, 14, 0, 120), UDim2.new(1, -28, 0, 17), 12, Color3.fromRGB(145, 145, 145))
        hint.Text = FWNoModules.Mobile.TouchEnabled and "Tap left: previous     Tap right: next"or"Click left: previous     Click right: next"
    end
    local function attribute(player, names, fallback)
        for _, name in ipairs(names) do
            local value = player:GetAttribute(name)
            if type(value) == "string" and value ~= "" then return value end
            if type(value) == "number" then return tostring(value) end
        end
        return fallback
    end
    local function updateInfo()
        if not gui then return end
        if not target then
            face.Image = ""
            display.Text = "No players available"
            username.Text = "Waiting for a character"
            details.Text, kit.Text = "", ""
            status.Text = "Spectate"
            return
        end
        face.Image = "rbxthumb://type=AvatarHeadShot&id=" .. tostring(target.UserId) .. "&w=150&h=150"
        display.Text = target.DisplayName
        username.Text = "@" .. target.Name
        details.Text = "Clan: " .. attribute(target, {"ClanTag"}, "None")
            .. "   Level: " .. attribute(target, {"PlayerLevel", "Level"}, "—")
        kit.Text = "Kit: " .. attribute(target, {"PlayingAsKit", "PlayingAsKits", "Kit"}, "None"):gsub("_", " ")
        local index = table.find(roster, target)
        status.Text = index and ("Spectating · " .. index .. " / " .. #roster) or "Spectating · waiting for respawn"
    end
    local function animateInfo()
        if cardTween then cardTween:Cancel() end
        card.Position = UDim2.new(0, -390, 1, -24)
        cardTween = FWNoModules.OwnTween(TweenService:Create(card, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Position = UDim2.new(0, 20, 1, -24),
        }))
        cardTween:Play()
    end
    applyCamera = function(animated)
        local camera = activeCamera
        if not enabled or not camera then return end
        local root, humanoid = physical(target)
        local nextSubject = humanoid and humanoid.Health > 0 and humanoid or root
        if not nextSubject then
            cancelTransition()
            subject = nil
            if camera.CameraType ~= Enum.CameraType.Scriptable then camera.CameraType = Enum.CameraType.Scriptable end
            return
        end
        if animated then
            cancelTransition()
            subject = nextSubject
            local version = transitionVersion
            camera.CameraType = Enum.CameraType.Scriptable
            camera.CameraSubject = nextSubject
            local distance = math.clamp((camera.CFrame.Position - camera.Focus.Position).Magnitude, 8, 22)
            local focus = root.Position + Vector3.new(0, 2, 0)
            local goal = CFrame.lookAt(focus - camera.CFrame.LookVector * distance, focus)
            transition = FWNoModules.OwnTween(TweenService:Create(camera, TweenInfo.new(0.32, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {CFrame = goal}))
            transitionConnection = FWNoModules.Connect(transition.Completed, function(playbackState)
                if not enabled or version ~= transitionVersion or activeCamera ~= camera then return end
                if playbackState ~= Enum.PlaybackState.Completed then return end
                if transitionConnection then transitionConnection:Disconnect(); transitionConnection = nil end
                transition = nil
                applyCamera(false)
            end)
            transition:Play()
        elseif not transition then
            subject = nextSubject
            if camera.CameraSubject ~= nextSubject then camera.CameraSubject = nextSubject end
            if camera.CameraType ~= Enum.CameraType.Custom then camera.CameraType = Enum.CameraType.Custom end
        end
    end
    local function bindTarget()
        disconnect(targetConnections)
        if not target then return end
        for _, name in ipairs({"DisplayName", "Name"}) do
            watch(targetConnections, target:GetPropertyChangedSignal(name), updateInfo)
        end
        for _, name in ipairs({"ClanTag", "PlayerLevel", "Level", "PlayingAsKit", "PlayingAsKits", "Kit"}) do
            watch(targetConnections, target:GetAttributeChangedSignal(name), updateInfo)
        end
        local _, humanoid = physical(target)
        if humanoid then watch(targetConnections, humanoid.Died, function() cancelTransition(); applyCamera(false); updateInfo() end) end
    end
    choose = function(player, animate)
        cancelTransition()
        target = player
        bindTarget()
        updateInfo()
        if animate and target then animateInfo() end
        applyCamera(animate and target ~= nil)
    end
    local function nextPlayer(direction)
        if #roster == 0 then return nil end
        local index = target and table.find(roster, target)
        if index then return roster[((index - 1 + direction) % #roster) + 1] end
        if target then
            if direction > 0 then
                for _, player in ipairs(roster) do if player.UserId > target.UserId then return player end end
            else
                for i = #roster, 1, -1 do if roster[i].UserId < target.UserId then return roster[i] end end
            end
        end
        return roster[direction > 0 and 1 or #roster]
    end
    refresh = function()
        if not enabled then return end
        controller.ValidateSelection()
        local previousSubject = subject
        table.clear(roster)
        for player in pairs(records) do
            if allowed(player) and physical(player) then roster[#roster + 1] = player end
        end
        table.sort(roster, function(a, b) return a.UserId < b.UserId end)
        if target and allowed(target) then
            -- Keep a selected player through death/removal of their old character.
            -- New selections and cycle options always require a physical character.
            local root, humanoid = physical(target)
            local newSubject = humanoid and humanoid.Health > 0 and humanoid or root
            if previousSubject ~= newSubject then choose(target, newSubject ~= nil)
            else updateInfo(); applyCamera(false) end
        else
            choose(nextPlayer(1), true)
        end
    end
    requestRefresh = function()
        if not enabled or queued then return end
        queued = true
        local token = generation
        task.defer(function()
            if token ~= generation or not enabled then return end
            queued = false
            refresh()
        end)
    end
    local function unwatchPlayer(player)
        local record = records[player]
        if not record then return end
        disconnect(record.connections)
        disconnect(record.characterConnections)
        records[player] = nil
    end
    local function watchPlayer(player)
        if player == Player or records[player] then return end
        local record = {connections = {}, characterConnections = {}}
        records[player] = record
        local function bindCharacter(character)
            disconnect(record.characterConnections)
            record.character = character
            if character then
                watch(record.characterConnections, character.ChildAdded, requestRefresh)
                watch(record.characterConnections, character.ChildRemoved, requestRefresh)
                watch(record.characterConnections, character.AncestryChanged, requestRefresh)
            end
            requestRefresh()
        end
        watch(record.connections, player.CharacterAdded, bindCharacter)
        watch(record.connections, player.CharacterRemoving, function(character)
            if record.character == character then bindCharacter(nil) end
        end)
        watch(record.connections, player:GetPropertyChangedSignal("Team"), requestRefresh)
        for _, name in ipairs({"Team", "TeamId"}) do
            watch(record.connections, player:GetAttributeChangedSignal(name), requestRefresh)
        end
        bindCharacter(player.Character)
    end
    local function bindCamera()
        cancelTransition()
        disconnect(cameraConnections)
        activeCamera = G.Services.Workspace.CurrentCamera
        if activeCamera then
            local function changed()
                if not enabled or transition then return end
                if activeCamera.CameraSubject ~= subject or activeCamera.CameraType ~= (subject and Enum.CameraType.Custom or Enum.CameraType.Scriptable) then
                    requestRefresh()
                end
            end
            watch(cameraConnections, activeCamera:GetPropertyChangedSignal("CameraSubject"), changed)
            watch(cameraConnections, activeCamera:GetPropertyChangedSignal("CameraType"), changed)
        end
        applyCamera(false)
    end
    function controller.Cycle(direction)
        if not enabled then return end
        local player = nextPlayer(direction < 0 and -1 or 1)
        if player then choose(player, true) end
    end
    function controller.RefreshFilter()
        if FWNoModules.Profiles and FWNoModules.Profiles.busy then return end
        if Spectate and Spectate.Values["Player"] ~= nil and Spectate.Values["Team"] ~= nil then
            controller.ValidateSelection()
        end
        requestRefresh()
    end
    function controller.SetEnabled(state)
        state = state == true and alive and FWNoModules.Runtime.active
        if enabled == state then return end
        enabled = state
        generation += 1
        queued = false
        cancelTransition()
        disconnect(connections)
        disconnect(cameraConnections)
        disconnect(targetConnections)
        for player in pairs(records) do unwatchPlayer(player) end
        table.clear(roster)
        target, subject = nil, nil
        if cardTween then cardTween:Cancel(); cardTween = nil end
        if gui then gui:Destroy(); gui = nil end
        if not state then
            restoreCamera()
            activeCamera = nil
            return
        end
        disconnect(restoreConnections)
        createGui()
        watch(connections, Players.PlayerAdded, function(player) watchPlayer(player) end)
        watch(connections, Players.PlayerRemoving, function(player) unwatchPlayer(player); requestRefresh() end)
        watch(connections, Player:GetPropertyChangedSignal("Team"), requestRefresh)
        for _, name in ipairs({"Team", "TeamId"}) do
            watch(connections, Player:GetAttributeChangedSignal(name), requestRefresh)
        end
        local ok, teams = pcall(function() return game:GetService("Teams") end)
        if ok and teams then
            watch(connections, teams.ChildAdded, requestRefresh)
            watch(connections, teams.ChildRemoved, requestRefresh)
        end
        watch(connections, G.Services.Workspace:GetPropertyChangedSignal("CurrentCamera"), bindCamera)
        local function overControls(point)
            -- Games may mark every world click as processed. Check actual controls
            -- instead, so menu buttons stay clickable without disabling screen cycling.
            for _, container in ipairs({PlayerGui, G.Services.CoreGui}) do
                local ok, objects = pcall(function() return container:GetGuiObjectsAtPosition(point.X, point.Y) end)
                if ok and objects then
                    for _, object in ipairs(objects) do
                        local textVisible=object:IsA("TextLabel") and object.Text~="" and object.TextTransparency<1
                        local imageVisible=(object:IsA("ImageLabel") or object:IsA("ImageButton")) and object.Image~="" and object.ImageTransparency<1
                        local panelVisible=object.BackgroundTransparency<1
                        local viewport=activeCamera and activeCamera.ViewportSize
                        local transparentRoot=object:IsA("Frame") and object.BackgroundTransparency>=1 and viewport
                            and object.AbsoluteSize.X>=viewport.X*0.95 and object.AbsoluteSize.Y>=viewport.Y*0.95
                        if not transparentRoot and (object.Active or textVisible or imageVisible or panelVisible
                            or object:IsA("GuiButton") or object:IsA("TextBox") or object:IsA("ScrollingFrame")
                            or (mainScreenUI and mainScreenUI.Enabled and object:IsDescendantOf(mainScreenUI))) then
                            return true
                        end
                    end
                end
            end
            return false
        end
        watch(connections, UserInputService.InputBegan, function(input)
            if type(input)=="table"and input.FWVirtual then return end
            if UserInputService:GetFocusedTextBox() or _G.IsBindingKey or currentlyDragging then return end
            local mouse = input.UserInputType == Enum.UserInputType.MouseButton1
            if not mouse and input.UserInputType ~= Enum.UserInputType.Touch then return end
            local point = mouse and UserInputService:GetMouseLocation() or input.Position
            local camera = activeCamera
            if camera and not overControls(point) then
                controller.Cycle(point.X < camera.ViewportSize.X / 2 and -1 or 1)
            end
        end)
        for _, player in ipairs(Players:GetPlayers()) do watchPlayer(player) end
        bindCamera()
        refresh()
    end
    FWNoModules.OnCleanup(function()
        local wasEnabled = enabled
        controller.SetEnabled(false)
        alive = false
        disconnect(restoreConnections)
        if wasEnabled and ownSubject() then restoreCamera(); disconnect(restoreConnections) end
    end)
end

