updateESPAttachments = function()
	myChar = Players.LocalPlayer.Character
	tChar = bountyData.currentTarget and bountyData.currentTarget.Character
	if not myChar or not tChar then return end

	myHRP = myChar:FindFirstChild("HumanoidRootPart")
	tHRP = tChar:FindFirstChild("HumanoidRootPart")
	if not myHRP or not tHRP then return end

	if not bountyData.espAtt0 or not bountyData.espAtt0.Parent or bountyData.espAtt0.Parent ~= myHRP then
		if bountyData.espAtt0 then bountyData.espAtt0:Destroy() end
		bountyData.espAtt0 = Instance.new("Attachment", myHRP)
	end

	if not bountyData.espAtt1 or not bountyData.espAtt1.Parent or bountyData.espAtt1.Parent ~= tHRP then
		if bountyData.espAtt1 then bountyData.espAtt1:Destroy() end
		bountyData.espAtt1 = Instance.new("Attachment", tHRP)
	end

	if not bountyData.espBeam or not bountyData.espBeam.Parent then
		if bountyData.espBeam then bountyData.espBeam:Destroy() end
		beam = Instance.new("Beam")
		beam.Attachment0 = bountyData.espAtt0
		beam.Attachment1 = bountyData.espAtt1
		beam.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255))
		beam.Width0 = 0.3
		beam.Width1 = 0.3
		beam.FaceCamera = true
		beam.Transparency = NumberSequence.new(0.2)
		beam.Parent = G.Services.Workspace.CurrentCamera
		bountyData.espBeam = beam
	else
		bountyData.espBeam.Attachment0 = bountyData.espAtt0
		bountyData.espBeam.Attachment1 = bountyData.espAtt1
	end

	if not bountyData.espHighlight or not bountyData.espHighlight.Parent or bountyData.espHighlight.Adornee ~= tChar then
		if bountyData.espHighlight then bountyData.espHighlight:Destroy() end
		highlight = Instance.new("Highlight")
		highlight.FillColor = Color3.fromRGB(255, 255, 255)
		highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
		highlight.FillTransparency = 0.5
		highlight.Adornee = tChar
		highlight.Parent = G.Services.Workspace.CurrentCamera
		bountyData.espHighlight = highlight
	else
		bountyData.espHighlight.Adornee = tChar
	end
end

bountyStartESP = function()
	if not bountyData.currentTarget then return end
