    layout.Padding = UDim.new(0, 2)
    local function make(kind, parent, properties)
        local object = FWNoModules.OwnInstance(Instance.new(kind, parent))
        for key, value in pairs(properties) do object[key] = value end
        return object
    end
    local function control(kind, parent, text)
        return make(kind, parent, {BackgroundTransparency=1,BorderSizePixel=0,Text=text,FontFace=Font.fromName(textFont),TextSize=18,TextColor3=Color3.new(1,1,1)})
    end
    local heading = control("TextLabel", section, "  Profiles")
    heading.Size = UDim2.new(1, 0, 0, 34)
    heading.TextXAlignment = Enum.TextXAlignment.Left
    heading.TextSize = 22
    heading.LayoutOrder = 0
    local addRow = make("Frame", section, {Name="AddProfile",Size=UDim2.new(1,0,0,32),BackgroundTransparency=1,LayoutOrder=1})
    local nameBox = control("TextBox", addRow, "")
    nameBox.Size=UDim2.new(1,-56,1,0);nameBox.Position=UDim2.new(0,8,0,0)
    nameBox.PlaceholderText="New profile name...";nameBox.ClearTextOnFocus=false
    nameBox.TextXAlignment=Enum.TextXAlignment.Left
    local add = control("TextButton",addRow,"Add")
    add.Size=UDim2.new(0,46,1,0);add.Position=UDim2.new(1,-48,0,0)
    local rows = {}
    local function report(ok, problem)
        if not ok then NotificationSystem.Notify("Profiles", tostring(problem), 4) end
    end
    local function render()
        local present = {}
        for index, profile in ipairs(api.GetProfiles()) do
            present[profile.id] = true
            local row = rows[profile.id]
            if not row then
                row = {connections={}}
                rows[profile.id]=row
                row.frame=make("Frame",section,{Name="Profile_"..profile.id,Size=UDim2.new(1,0,0,32),BackgroundTransparency=1})
                row.select=control("TextButton",row.frame,"")
                row.select.Size=UDim2.new(1,-60,1,0);row.select.TextXAlignment=Enum.TextXAlignment.Left
                row.rename=control("TextButton",row.frame,"✎");row.rename.Size=UDim2.new(0,28,1,0);row.rename.Position=UDim2.new(1,-58,0,0)
                row.delete=control("TextButton",row.frame,"×");row.delete.Size=UDim2.new(0,28,1,0);row.delete.Position=UDim2.new(1,-28,0,0)
                row.edit=control("TextBox",row.frame,profile.name);row.edit.Size=UDim2.new(1,-62,1,0);row.edit.Visible=false;row.edit.ClearTextOnFocus=false
                local id = profile.id
                local function connect(signal,fn)row.connections[#row.connections+1]=FWNoModules.Connect(signal,fn)end
                connect(row.select.Activated,FWNoModules.Mobile.Activation(function()report(api.Select(id))end))
                connect(row.delete.Activated,FWNoModules.Mobile.Activation(function()report(api.Delete(id))end))
                connect(row.rename.Activated,FWNoModules.Mobile.Activation(function()if not api.busy then row.edit.Visible=true;row.select.Visible=false;row.edit:CaptureFocus()end end))
                connect(row.edit.FocusLost,function()
                    if not row.edit.Visible then return end
                    row.edit.Visible=false;row.select.Visible=true
                    report(api.Rename(id,row.edit.Text))
                end)
            end
            row.frame.LayoutOrder=index+1
            row.select.Text="  "..profile.name
            row.select.TextTruncate=Enum.TextTruncate.AtEnd
            row.select.TextColor3=profile.id==api.GetActive() and Color3.fromRGB(78,173,73) or Color3.new(1,1,1)
            if not row.edit.Visible then row.edit.Text=profile.name end
        end
        for id,row in pairs(rows)do
            if not present[id]then
                for _,connection in ipairs(row.connections)do FWNoModules.ReleaseConnection(connection)end
                row.frame:Destroy();rows[id]=nil
            end
        end
    end
    local function create()
        local ok,problem=api.Add(nameBox.Text)
        if ok then nameBox.Text="" else report(false,problem)end
    end
    FWNoModules.Connect(add.Activated,FWNoModules.Mobile.Activation(create))
    FWNoModules.Connect(nameBox.FocusLost,function(enter)if enter then create()end end)
    local unsubscribe=api.Subscribe(render)
    local blocker=make("TextButton",mainScreenUI,{Name="ProfileSwitch",Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,Text="",Visible=false,Active=true,ZIndex=100000})
    api.OnBusy=function(busy)blocker.Visible=busy;heading.Text=busy and "  Profiles · Switching..." or "  Profiles"end
    FWNoModules.OnCleanup(unsubscribe)
    render()
end

