cdHookChest = function(part)
    local folderValue = part:FindFirstChild("ChestFolderValue")
    local folder = folderValue and folderValue.Value
    if not folder or cd_chestConns[folder] then return end
    local connections, logs = cd_chestConns, cd_chestLog
    logs[folder] = {}
    local gate = FWNoModules.GatedEvent(folder.ChildRemoved, {"cheater detector"}, function(item)
        if not loops["cheater detector"] or not CheaterDetector.Values["Chest Stealer"] then return end
        if item.Name == "ChestOwner" then return end
        local now = os.clock()
        local times = logs[folder]
        if not times then return end
        table.insert(times, now)
        while #times > 6 do table.remove(times, 1) end
        if #times >= 3 and (times[#times] - times[#times - 2]) <= 0.35 then
            local nearest = cdNearestPlayer(part.Position, 25)
            if nearest then cdNotify(nearest, "Chest Stealer (instant loot)") end
            logs[folder] = {}
        end
    end)
    connections[folder] = gate
    local lifetime = {}
    local unsubscribeCleanup
    local alive = true
    local function remove()
        if not alive then return end
        alive = false
        gate:Disconnect()
        for _, connection in ipairs(lifetime) do connection:Disconnect() end
        table.clear(lifetime)
        if connections[folder] == gate then connections[folder] = nil; logs[folder] = nil end
        if unsubscribeCleanup then unsubscribeCleanup(); unsubscribeCleanup = nil end
    end
    lifetime[1] = FWNoModules.Connect(part.Destroying, remove)
    lifetime[2] = FWNoModules.Connect(folder.Destroying, remove)
    lifetime[3] = FWNoModules.Connect(part.AncestryChanged, function()
        if not part:IsDescendantOf(G.Services.Workspace) then remove() end
    end)
    unsubscribeCleanup = FWNoModules.OnCleanup(remove)
end

-- ============ DAMAGE EVENT (reach / KA / kaida / velocity) ============
pcall(function()
	cd_dmgConn = FWNoModules.GatedEvent(NetRemotes:WaitForChild("EntityDamageEvent", 10).OnClientEvent, {"cheater detector"}, function(data)
		if not loops["cheater detector"] then return end
		if type(data) ~= "table" then return end
		cd_from = data.fromEntity
		cd_victim = data.entityInstance
		if typeof(cd_from) ~= "Instance" or typeof(cd_victim) ~= "Instance" then return end
		if cd_from == cd_victim then return end
		cd_fromPlr = Players:GetPlayerFromCharacter(cd_from)
		cd_victimPlr = Players:GetPlayerFromCharacter(cd_victim)
		cd_now = os.clock()

		if cd_victimPlr and cdShouldCheck(cd_victimPlr) then
			cd_st = cdState(cd_victimPlr)
			cd_st.lastHurt = cd_now
			if CheaterDetector.Values["Velocity"] then
				cd_st.velBefore = cd_st.lastVel
				cd_st.hurtTime = cd_now
				cd_st.velChecked = false
			end
		end

		if cd_fromPlr and cdShouldCheck(cd_fromPlr) then
			cd_held = cdHeldName(cd_from)
			cd_st = cdState(cd_fromPlr)
			cd_st.lastMeleeAny = cd_now
			if cd_held then
				cd_fHRP = cd_from:FindFirstChild("HumanoidRootPart")
				cd_vHRP = cd_victim:FindFirstChild("HumanoidRootPart")
				if cd_fHRP and cd_vHRP then
					cd_dist = (cd_fHRP.Position - cd_vHRP.Position).Magnitude

					-- SWORD REACH: server max is 14.4, anything above = cheat
					if CheaterDetector.Values["Reach"] and table.find(swords, cd_held) and cd_dist > 14.5 then
						cdNotify(cd_fromPlr, "Reach (" .. math.floor(cd_dist) .. " studs)")
					end

					-- KAIDA REACH: normal claw max 21
					if CheaterDetector.Values["Kaida Reach"] and cd_held:find("summoner_claw") and cd_dist > 21.5 then
						cdNotify(cd_fromPlr, "Kaida Reach (" .. math.floor(cd_dist) .. " studs)")
					end

					if table.find(swords, cd_held) then
						-- KA: WALL CHECK
						if cdKaEnabled("Wall Check") and cd_dist <= 20 then
							cd_wp = RaycastParams.new()
							cd_wp.FilterType = Enum.RaycastFilterType.Exclude
							cd_wp.FilterDescendantsInstances = {cd_from, cd_victim}
							cd_w = G.Services.Workspace:Raycast(cd_fHRP.Position + Vector3.new(0, 1, 0), cd_vHRP.Position - cd_fHRP.Position, cd_wp)
							if cd_w and cd_w.Instance and cd_w.Instance.CanCollide then
								cdNotify(cd_fromPlr, "Killaura (no wall check)")
							end
						end
						-- KA: ANGLE (hits from behind, ~180°)
						if cdKaEnabled("Angle") then
							cd_ang = math.deg(math.acos(math.clamp(cd_fHRP.CFrame.LookVector:Dot((cd_vHRP.Position - cd_fHRP.Position).Unit), -1, 1)))
							if cd_ang >= 170 then
								cdNotify(cd_fromPlr, "Killaura (360 angle hit)")
							end
						end
						cd_st.lastMelee = cd_now
					end
				end
			end
		end
	end)
end)

-- ============ WORLD WATCHER (scaffold / blockcps / fastbreak / nuker / quickcollect / resource) ============
cd_descConn = FWNoModules.GatedEvent(G.Services.Workspace.DescendantAdded, {"cheater detector"}, function(d)
	if not loops["cheater detector"] then return end

	-- projectile aura + pearl tracking
	if d.Parent and d.Parent.Name == "ProjectileTargeting" then
		cd_now = os.clock()
		cd_n = d.Name:lower()
		-- pearl exemption for novoid
		if cd_n:find("pearl") then
			cd_p = cdNearestPlayer(d:GetPivot().Position, 15)
			if cd_p then cdState(cd_p).pearlTime = cd_now end
		end
		if CheaterDetector.Values["Projectile Aura"] then
			-- find owner via any attribute holding a player's UserId
			cd_owner = nil
			for cd_uid, cd_val in pairs(d:GetAttributes()) do
				if type(cd_val) == "number" then
					cd_op = Players:GetPlayerByUserId(cd_val)
					if cd_op then cd_owner = cd_op break end
				end
			end
			if cd_owner and cdShouldCheck(cd_owner) then
				cd_st = cdState(cd_owner)
				table.insert(cd_st.shotTimes, cd_now)
				while #cd_st.shotTimes > 8 do table.remove(cd_st.shotTimes, 1) end
				if #cd_st.shotTimes >= 2 and (cd_st.shotTimes[#cd_st.shotTimes] - cd_st.shotTimes[#cd_st.shotTimes - 1]) < 0.25 then
					cdNotify(cd_owner, "Projectile Aura (fire rate)")
					cd_st.shotTimes = {}
				elseif #cd_st.shotTimes >= 3 and (cd_st.shotTimes[#cd_st.shotTimes] - cd_st.shotTimes[#cd_st.shotTimes - 2]) <= 1 then
					cdNotify(cd_owner, "Projectile Aura (multi weapon)")
					cd_st.shotTimes = {}
				end
			end
		end
		return
	end

	if not d:IsA("BasePart") then return end
	cd_n = d.Name:lower()

	-- chests
	if CheaterDetector.Values["Chest Stealer"] and (cd_n == "chest" or cd_n == "team_crate") then
		cdHookChest(d)
		return
	end

	-- block placed
	if CheaterDetector.Values["Scaffold"] or CheaterDetector.Values["BlockCPS Bypass"] then
		if cdIsBlockName(cd_n) and not cd_n:find("bed") then
			cd_now = os.clock()
			cd_p, cd_pd = cdNearestPlayer(d.Position, 10)
			if cd_p and (d.Position.Y - cd_p.Character.HumanoidRootPart.Position.Y) < 6 then
				cd_st = cdState(cd_p)
				cd_hr = cd_p.Character.HumanoidRootPart

				-- BLOCKCPS BYPASS: placing faster than the 12 CPS cap
				if CheaterDetector.Values["BlockCPS Bypass"] then
					if cd_now - cd_st.lastPlace < 0.06 then
						cdNotify(cd_p, "BlockCPS Bypass")
					end
				end
				cd_st.lastPlace = cd_now

				-- SCAFFOLD: blocks appearing under feet while NOT looking down & moving,
				-- or placing while a sword is held (impossible legit)
				if CheaterDetector.Values["Scaffold"] then
					cd_dy = cd_hr.Position.Y - d.Position.Y
					cd_held = cdHeldName(cd_p.Character)
					if cd_dy > 1 and cd_dy < 5 and cd_hr.CFrame.LookVector.Y > -0.15 and cd_hr.AssemblyLinearVelocity.Magnitude > 4 then
						table.insert(cd_st.scafTimes, cd_now)
