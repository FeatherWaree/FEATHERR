-- 3. TOGGLE CALLBACK

Chams.Callbacks.OnToggle = function(state)
	loops["chams"] = state

	for _, conn in pairs(chamsConnections) do
		pcall(function() conn:Disconnect() end)
	end
	chamsConnections = {}

	if state then
		if type(startEntityCache) == "function" then
			startEntityCache()
		end

		chamsReconcileAll()

		table.insert(chamsConnections, FWNoModules.Connect(Players.PlayerAdded, function(plr)
			table.insert(chamsConnections, FWNoModules.Connect(plr.CharacterAdded, function(char)
				task.wait(0.5)
				chamsReconcileAll()
			end))
			table.insert(chamsConnections, FWNoModules.Connect(plr:GetPropertyChangedSignal("Team"), chamsReconcileAll))
		end))

		table.insert(chamsConnections, FWNoModules.Connect(Players.PlayerRemoving, function(plr)
			if plr.Character then
				chamsRemove(plr.Character)
			end
		end))

		for _, plr in ipairs(FWNoModules.PlayerSnapshot()) do
			table.insert(chamsConnections, FWNoModules.Connect(plr.CharacterAdded, function(char)
				task.wait(0.5)
				chamsReconcileAll()
			end))
			table.insert(chamsConnections, FWNoModules.Connect(plr:GetPropertyChangedSignal("Team"), chamsReconcileAll))
		end

		table.insert(chamsConnections, FWNoModules.Connect(Player:GetPropertyChangedSignal("Team"), chamsReconcileAll))

		table.insert(chamsConnections, FWNoModules.Connect(G.Services.Workspace.ChildAdded, function(child)
			if child:FindFirstChildOfClass("Humanoid") and not Players:GetPlayerFromCharacter(child) then
				task.wait(0.5)
				chamsReconcileAll()
			end
		end))

		table.insert(chamsConnections, FWNoModules.Connect(G.Services.Workspace.ChildRemoved, function(child)
			chamsRemove(child)
		end))

	else
		-- Ensure everything gets completely wiped and destroyed on untoggle
		for model, hl in pairs(chams_active) do
			pcall(function() hl:Destroy() end)
		end
		chams_active = {}

		if chamsFolder then
			chamsFolder:ClearAllChildren()
		end
	end
end

