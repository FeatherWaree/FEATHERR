-- ============ HIGH-PERFORMANCE BUILT-IN ENTITY CACHE = ============
LocalCache = {players = {}, npcs = {}, lastUpdate = 0}
function updateEntityCache()
	local now = tick()
	if now - LocalCache.lastUpdate < 0.2 then return end -- Throttled updates for performance
	LocalCache.lastUpdate = now

	table.clear(LocalCache.players)
	table.clear(LocalCache.npcs)

	local localPlayer = G.Services.Players.LocalPlayer
	for _, p in ipairs(FWNoModules.PlayerSnapshot()) do
		if p ~= localPlayer and p.Character then
			table.insert(LocalCache.players, p)
		end
	end

	local workspaceChildren = G.Services.Workspace:GetChildren()
	for _, inst in ipairs(workspaceChildren) do
		if inst:FindFirstChildOfClass("Humanoid") and not G.Services.Players:GetPlayerFromCharacter(inst) then
			table.insert(LocalCache.npcs, inst)
		end
	end
end

