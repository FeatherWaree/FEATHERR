		if Player.Character and Player.Character:FindFirstChildOfClass("Humanoid") then
			nfEnableStateConnections(Player.Character:FindFirstChildOfClass("Humanoid"))
		end

		-- Re-enable connections when character respawns
		if nfCharAddedConn then nfCharAddedConn:Disconnect() end
		nfCharAddedConn = FWNoModules.Connect(Player.CharacterAdded, function(newChar)
			if not loops["nofall"] then return end
			newHum = newChar:WaitForChild("Humanoid", 5)
