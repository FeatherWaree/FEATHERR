minerProcessModel = function(model)
	if not loops["auto miner"] then return end
	if minerActiveSessions[model] then return end

	char = Player.Character
	hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	targetRoot = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart")
	if not targetRoot then return end

	maxRange = AutoMiner.Values["Range"] or 6
	if (hrp.Position - targetRoot.Position).Magnitude > maxRange then return end

	minerActiveSessions[model] = true

	task.spawn(function()
		petrifyId = model:GetAttribute("PetrifyId") or model:GetAttribute("petrifyId")
		if not petrifyId then
			minerActiveSessions[model] = nil
			return
		end

		shouldUseAnim = AutoMiner.Values["Use Mine Animation"]
		mineDuration = AutoMiner.Values["Mine Duration"] or 2.5

		animationTrack = nil

		if shouldUseAnim then
			if canRequire and minerGameAnimUtil and minerAnimType and minerAnimType.MINER_MINE_STONE then
				pcall(function()
					animationTrack = minerGameAnimUtil:playAnimation(Player, minerAnimType.MINER_MINE_STONE)
				end)
			else
				pcall(function()
					anim = Instance.new("Animation")
					anim.AnimationId = "rbxassetid://8934264605"
					hum = char:FindFirstChildOfClass("Humanoid")
					animator = hum and hum:FindFirstChildOfClass("Animator")
					if animator then
						animationTrack = animator:LoadAnimation(anim)
						animationTrack.Looped = true
						animationTrack:Play()
					end
				end)
			end

			if canRequire and minerSoundManager and minerGameSound then
				task.spawn(function()
					intervals = mineDuration / 4
					for i = 1, 3 do
						if not minerActiveSessions[model] or not model.Parent then break end
						task.wait(intervals)
						pcall(function()
							snd = minerGameSound["MINER_STONE_HIT_" .. i]
							if snd then minerSoundManager:playSound(snd, {position = targetRoot.Position}) end
						end)
					end
				end)
			end
		end

		startTime = os.clock()
		interrupted = false

		while os.clock() - startTime < mineDuration do
			task.wait(0.1)
			if not loops["auto miner"] then interrupted = true break end
			if not model or not model.Parent then interrupted = true break end

			currentChar = Player.Character
			currentRoot = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
			if not currentRoot then interrupted = true break end

			currentTarget = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart")
			if not currentTarget then interrupted = true break end

			currentDistance = (currentRoot.Position - currentTarget.Position).Magnitude
			maxRangeNow = AutoMiner.Values["Range"] or 6

			if currentDistance > maxRangeNow + 1.5 then
				interrupted = true
				break
			end
		end

		if animationTrack then
			pcall(function() animationTrack:Stop() end)
			pcall(function() animationTrack:Destroy() end)
		end

		if not interrupted then
			pcall(function()
				DestroyPetrifiedRemote:FireServer({petrifyId = petrifyId})
			end)
			if canRequire and minerSoundManager and minerGameSound and minerGameSound.MINER_STONE_BREAK then
				pcall(function() minerSoundManager:playSound(minerGameSound.MINER_STONE_BREAK, {position = targetRoot.Position}) end)
			end
		end

		minerActiveSessions[model] = nil
	end)
end

minerStartEvents = function()
	if minerConnections.active then return end
	minerConnections.active = true

	minerConnections.added = minerCS:GetInstanceAddedSignal("petrified-player"):Connect(function(model)
