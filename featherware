nyxIsEnemyPlayerChar = function(char)
	if not char or not char.Parent then return false end
	plr = Players:GetPlayerFromCharacter(char)
	if not plr then return false end
	if plr == Player then return false end
	if plr.Team ~= nil and Player.Team ~= nil and plr.Team == Player.Team then return false end
	hum = char:FindFirstChildOfClass("Humanoid")
	if hum and hum.Health <= 0 then return false end
	return true
end

nyxCheckRangeAndFire = function()
	myChar = Player.Character
	if not myChar then return end
	myRoot = myChar:FindFirstChild("HumanoidRootPart")
	if not myRoot then return end
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= Player then
			char = plr.Character
			if char and nyxIsEnemyPlayerChar(char) then
				root = char:FindFirstChild("HumanoidRootPart")
				if root and (root.Position - myRoot.Position).Magnitude <= nyxSettings.range then
					nyxFire()
					return
				end
			end
		end
	end
end

nyxOnProgress = function(abilityId, progress)
	if abilityId ~= "midnight" then return end
	nyxData.progress = tonumber(progress) or 0
	wasReady = nyxData.ready
	nyxData.ready = nyxData.progress >= nyxData.MAX
	if nyxData.ready and not wasReady then
		print("[AutoNyx] Bar FULL (" .. tostring(nyxData.progress) .. "/" .. tostring(nyxData.MAX) .. ")")
	end
	if not nyxData.ready or not loops["auto nyx"] then return end

	if nyxSettings.mode == "In Range" then
		nyxCheckRangeAndFire()
	elseif nyxSettings.mode == "On Hit" then
		-- Fallback: if the hit that filled the bar just happened (within 0.6s), fire now
		if os.clock() - nyxData.lastHitTime <= 0.6 then
			nyxFire()
		end
	end
end

-- Safe Hookmetamethod for On Hit Mode (Same logic as Auto Martin)
nyxSetupHook = function()
	if nyxData.hookActive then return end
	if not canRequire then return end
	if not hookmetamethod or not getnamecallmethod or not checkcaller then return end

	nyxData.hookActive = true
	print("[AutoNyx] Executor supports hooks. Using safe __namecall SwordHit/ProjectileHit detection.")

	nyxData.oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
		-- CRITICAL: Always call the original function first to prevent breaking combat
		local args = {...}
		local result = nyxData.oldNamecall(self, unpack(args))

		if not checkcaller() then
			pcall(function()
				method = getnamecallmethod()
				if method == "FireServer" or method == "InvokeServer" then
					remoteName = tostring(self)

					-- Catches both melee swings connecting and projectiles landing
					if remoteName == "SwordHit" or remoteName == "ProjectileHit" then
						if loops["auto nyx"] and nyxSettings.mode == "On Hit" then
							nyxData.lastHitTime = os.clock()
							print("[AutoNyx] Hit registered via hook | ready: " .. tostring(nyxData.ready))

							if nyxData.ready then
								nyxFire()
							end
						end
					end
				end
			end)
		end

		-- CRITICAL: Return the original result so the game continues normally
		return result
	end)
end

nyxStart = function()
	eventsFolder = G.Services.RS:WaitForChild("events-@easy-games/game-core:shared/game-core-networking@getEvents.Events", 10)

	-- Progress Tracking (Works for both modes)
	if not nyxData.progressConn then
		nyxData.progressConn = eventsFolder:WaitForChild("abilityProgressUpdate", 10).OnClientEvent:Connect(nyxOnProgress)
	end

	-- Setup Hook for On Hit Mode
	nyxSetupHook()

	-- Range Mode Loop + On Hit Fallback (if hooks aren't supported)
	if not nyxData.rangeConn then
		nyxData.rangeConn = G.Services.RunService.Heartbeat:Connect(function()
			if not loops["auto nyx"] then return end
			if not nyxData.ready then return end

			now = os.clock()

			if nyxSettings.mode == "In Range" then
				if now - nyxData.lastRangeCheck < 0.2 then return end
				nyxData.lastRangeCheck = now
				nyxCheckRangeAndFire()

			elseif nyxSettings.mode == "On Hit" and not nyxData.hookActive then
				-- Fallback for On Hit if executor doesn't support hooks
				if now - nyxData.lastHitTime <= 0.3 then
					nyxFire()
				end
			end
		end)
	end
end

nyxStop = function()
	if nyxData.progressConn then pcall(function() nyxData.progressConn:Disconnect() end) nyxData.progressConn = nil end
	if nyxData.rangeConn then pcall(function() nyxData.rangeConn:Disconnect() end) nyxData.rangeConn = nil end
	nyxData.ready = false
	nyxData.progress = 0
end

