function nkHeldName()
	char = Player.Character
	if not char then return nil end
	hi = char:FindFirstChild("HandInvItem")
	if hi and hi.Value then
		return typeof(hi.Value) == "Instance" and hi.Value.Name or tostring(hi.Value)
	end
	return nil
