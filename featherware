PlayerAttach:CreateSlider("Range", 1, 30, 18, nil, 1)

local pa_raycastParams = RaycastParams.new()
pa_raycastParams.FilterType = Enum.RaycastFilterType.Exclude
pa_raycastParams.IgnoreWater = true

local attachConnection = nil
local lastChar = nil

local function attachLoop()
	-- 1. LOCAL VARIABLES: Adding 'local' prevents Lua from doing heavy global lookups
	local char = Player.Character
	if not char then return end

	local hrp = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum or hum.Health <= 0 then return end

	-- 2. TABLE ALLOCATION FIX: Only update the filter table if you respawn
	if lastChar ~= char then
		pa_raycastParams.FilterDescendantsInstances = {char}
		lastChar = char
	end

	-- 3. CACHING: Read UI settings once per frame, not per entity check
	local maxRange = tonumber(PlayerAttach.Values["Range"]) or 18
	local maxAngle = tonumber(PlayerAttach.Values["Angle Check"]) or 360
	local targetPlayers = PlayerAttach.Values["Target Players"]
	local targetNPCs = PlayerAttach.Values["Target NPCs/Dummies"]

	local bestTarget = nil
	local bestDist = maxRange

	-- Cache your position and look vector so we don't recalculate it 20 times per frame
	local myPos = hrp.Position
	local myLookVec = hrp.CFrame.LookVector

	-- Helper function to cleanly calculate math without repeating code
	local function checkTarget(tHRP)
		if not tHRP then return end

		local tPos = tHRP.Position
		local dist = (myPos - tPos).Magnitude

		if dist <= bestDist then
			local valid = true
			if maxAngle < 360 then
				local dir = (tPos - myPos).Unit
				local dot = myLookVec:Dot(dir)
				local angle = math.deg(math.acos(math.clamp(dot, -1, 1)))
				if angle > maxAngle then valid = false end
			end

			if valid then
				bestDist = dist
				bestTarget = tHRP
			end
		end
	end

	-- Check Players
	if targetPlayers then
		-- Using uppercase 'Players' to match your EntityCache format from the previous script
		for _, model in ipairs(EntityCache.Players) do
			if model ~= char then 
				checkTarget(model:FindFirstChild("HumanoidRootPart"))
			end
		end
	end

	if not bestTarget and targetNPCs then
		for _, npc in ipairs(EntityCache.NPCs) do
			checkTarget(npc:FindFirstChild("HumanoidRootPart") or npc.PrimaryPart)
		end
	end

	if bestTarget then
		local ray = G.Services.Workspace:Raycast(myPos + Vector3.new(0, 2, 0), Vector3.new(0, -10, 0), pa_raycastParams)
		if ray then
			local desiredY = ray.Position.Y + 2 + (hrp.Size.Y * 0.5)
			local currentVel = hrp.AssemblyLinearVelocity

			if myPos.Y < desiredY - 0.2 then
				hrp.AssemblyLinearVelocity = Vector3.new(currentVel.X, -35, currentVel.Z)
			elseif myPos.Y > desiredY + 0.2 then
				hrp.AssemblyLinearVelocity = Vector3.new(currentVel.X, 35, currentVel.Z)
			else
				hrp.AssemblyLinearVelocity = Vector3.new(currentVel.X, 0, currentVel.Z)
			end
		end

		local lookCFrame = CFrame.lookAt(myPos, bestTarget.Position)
		hrp.CFrame = lookCFrame * CFrame.Angles(math.rad(-15), 0, 0)
	end
end

