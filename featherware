									pa_spawnO = pa_myPos - PA_HAND_OFFSET
									pa_pm = PA_PROJ_META[pa_L.projectile] or PA_PROJ_META[pa_L.weapon.Name] or {}
									bl_launchVel = pa_pm.launchVelocity or 100
									bl_grav = pa_pm.gravitationalAcceleration or (paIsStraight(pa_L.projectile) and 0 or 196.2)
