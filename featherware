Handlers.halloween_maze = function(Token: number, Assets: Instance)
    local Maze = Assets:FindFirstChild("Maze")
    if not Maze then
        return
    end
    local Exit = Maze:FindFirstChild("ExitBlocker")
    local Blocks = {}
    local function Clear()
        for _, Block in Blocks do
            Block:Destroy()
        end
        table.clear(Blocks)
        Walk.Costs = nil
    end
    AutoHalloween:Clean(Clear)
    local function Guard(Radius: number)
        Clear()
        if Radius <= 0 then
            return
        end
        for _, Spot in CollectionService:GetTagged("ActiveMazeBoss") do
            if Spot:IsA("BasePart") and Spot:IsDescendantOf(Assets) then
                local Block = Instance.new("Part")
                Block.Anchored = true
                Block.CanCollide = false
                Block.CanQuery = true
                Block.CanTouch = false
                Block.Transparency = 1
                Block.Size = Vector3.new(Radius * 2, 30, Radius * 2)
                Block.Position = Spot.Position
                local Modifier = Instance.new("PathfindingModifier")
                Modifier.Label = "Trap"
                Modifier.Parent = Block
                Block.Parent = workspace
                table.insert(Blocks, Block)
            end
        end
        Walk.Costs = {Trap = math.huge}
    end
    local function Illuminate()
        local Origin: Vector3 = Maze.PrimaryPart and Maze.PrimaryPart.Position or Maze:GetPivot().Position
        local Send = bedwars.Client:Get("SendFlashlightPositionToServer")
        local Toggle = bedwars.Client:Get("ToggleFlashlight")
        pcall(function()
            Toggle:SendToServer(true)
        end)
        local Target = GroundAt(Vector3.new(Exit.Position.X + 63, Exit.Position.Y - 9, Exit.Position.Z))
        local Start = Vector3.new(-143, -108, -23)
        for _, Radius in {48, 44, 40, 36} do
            Guard(Radius)
            if Walk.Plan(Start, Target) then
                Log(`light guide radius {Radius}`)
                break
            end
        end
        Log(`illuminator origin {math.floor(Origin.X)},{math.floor(Origin.Z)}`)
        local Path = {}
        local Planned: number = 0
        local Sent: number = 0
        while Current(Token) do
            local Lead: Vector3?
            local Gap: number = math.huge
            for _, Player in Players:GetPlayers() do
                local Role = Player:GetAttribute("MazeRole")
                local Body = Player.Character
                local Root = Body and Body:FindFirstChild("HumanoidRootPart")
                local Humanoid = Body and Body:FindFirstChildOfClass("Humanoid")
                if Player ~= LocalPlayer and type(Role) == "string" and Role:find("runner") and Root and Humanoid and Humanoid.Health > 0 then
                    local Left: number = Planarize(Target - Root.Position).Magnitude
                    if Left < Gap then
                        Lead, Gap = Root.Position, Left
                    end
                end
            end
            if Lead then
                if os.clock() - Planned > 1.5 then
                    Planned = os.clock()
                    local Waypoints = Walk.Plan(Lead, Target)
                    if not Waypoints then
                        local Saved = Walk.Costs
                        Walk.Costs = nil
                        Waypoints = Walk.Plan(Lead, Target)
                        Walk.Costs = Saved
                    end
                    if Waypoints then
                        Path = Waypoints
                    end
                end
                local Spot: Vector3 = Lead
                local Nearest: number = 1
                local Best: number = math.huge
                for i: number, Waypoint: PathWaypoint in Path do
                    local Away: number = Planarize(Waypoint.Position - Lead).Magnitude
                    if Away < Best then
                        Nearest, Best = i, Away
                    end
                end
                local Travelled: number = 0
                for i: number = Nearest, #Path - 1 do
                    Travelled += (Path[i + 1].Position - Path[i].Position).Magnitude
                    Spot = Path[i + 1].Position
                    if Travelled >= 32 then
                        break
                    end
                end
                if Gap < 45 then
                    Spot = Vector3.new(Exit.Position.X + 17, Exit.Position.Y - 9, Exit.Position.Z)
                end
                Send:SendToServer(Vector2.new(math.clamp((Spot.X - Origin.X) * 0.01, -2.5, 2.5), math.clamp((Spot.Z - Origin.Z) * 0.01, -2.5, 2.5)))
                if os.clock() - Sent > 5 then
                    Sent = os.clock()
                    Log(`light at {math.floor(Spot.X)},{math.floor(Spot.Z)} lead {math.floor(Lead.X)},{math.floor(Lead.Z)}`)
                end
            end
            task.wait(0.12)
        end
    end
    while Current(Token) do
        local Role = LocalPlayer:GetAttribute("MazeRole")
        if Role == "illuminator" and Exit and GetRoot() then
            Illuminate()
            Clear()
            return
        end
        if type(Role) == "string" and Role:find("runner") and Exit and GetRoot() then
            local Reached: number = 0
            for _, Offset in {27, 63} do
                for _, Radius in {48, 44, 40, 36, 0} do
                    Guard(Radius)
                    local Root = GetRoot()
                    local Target = GroundAt(Vector3.new(Exit.Position.X + Offset, Exit.Position.Y - 9, Exit.Position.Z))
                    local Planned = Root and Walk.Plan(Root.Position, Target)
                    Log(`maze trap {Radius} exit {Offset}: {Planned and "path" or "no path"}`)
                    if Planned then
                        local Done, Reason = Walk.To(Target, Offset == 27 and 2.5 or 8, 200, Token)
                        Log(`maze trap {Radius} walk: {Reason}`)
                        if Done then
                            Reached = Offset
                            break
                        end
                        if not Current(Token) then
                            Clear()
                            return
                        end
                    end
                end
                if Reached > 0 then
                    break
                end
            end
            if Reached == 27 and Current(Token) then
                Walk.Bind()
                Walk.Active = true
                Walk.Dir = Vector3.new(-1, 0, 0)
                task.wait(3)
                Walk.Stop()
                Log("maze finish pushed")
            end
            Clear()
            if Reached > 0 then
                while Current(Token) do
                    task.wait(1)
                end
                return
            end
        end
        task.wait(1)
    end
    Clear()
end

Handlers.halloween_obby = function(Token: number, Assets: Instance)
    local Remotes = bedwars.Client:GetNamespace("HalloweenObby")
    local Gate = Assets:FindFirstChild("EntryGate")
    local Prompt = Gate and Gate:FindFirstChild("OpenGatePrompt", true)
    local Started: boolean = false
