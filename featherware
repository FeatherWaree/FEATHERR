lianLoop = function()
	if not loops["auto lian"] then return end

	localPlayer = PlayersService.LocalPlayer

	-- 1. Check if Dragon Sword Kit is equipped
	kitAttr = localPlayer:GetAttribute("PlayingAsKits")
	if kitAttr ~= "dragon_sword" then
		if not lianData.notified then
			lianSendNotification("Auto Lian", "Dragon Sword kit is not equipped! Module disabled.")
			lianData.notified = true
		end
		return
	end
	lianData.notified = false

	-- 2. Check SwordCount Attribute
	swordCount = localPlayer:GetAttribute("SwordCount") or 0
	if swordCount < 1 then return end -- Need at least 1 stack to fire anything

	now = os.clock()
	maxRange = AutoLian.Values["Range"] or 30

	-- 3. Mode Logic
	if lianSettings.mode == "Sword Ult" then
		if now - lianData.lastUlt < ULT_COOLDOWN then return end

		targets, count = lianGetTargetsInRange(maxRange)
		reqCount = AutoLian.Values["Ult Player Count"] or 3

		if count >= reqCount then
			if not lianLoadRemotes() then return end

			lianData.lastUlt = now
			print("[Auto Lian] " .. count .. " enemies in range (>= " .. reqCount .. "). Firing Dragon Sword Ult!")

			lianPlayEffects(true)

			pcall(function()
				lianData.ultRemote:FireServer()
			end)
		end

	elseif lianSettings.mode == "Sword" then
		if now - lianData.lastFire < FIRE_COOLDOWN then return end

		nearest = lianGetNearestTarget(maxRange)
		if nearest then
			if not lianLoadRemotes() then return end

			lianData.lastFire = now
			print("[Auto Lian] Enemy in range. Firing Dragon Sword!")

			lianPlayEffects(false)

			pcall(function()
				lianData.fireRemote:FireServer("dragon_sword")
			end)
		end
	end
end

