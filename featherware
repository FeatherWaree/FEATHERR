	    for _, v: any in Entity.List do
	        if v.Player and v.Targetable and v.Health > 0 and v.RootPart and (v.RootPart.Position - LocalPosition).Magnitude <= EnemyRange.Value then
	            return true
	        end
	    end
	    return false
	end
	
