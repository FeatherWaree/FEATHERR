local function createChestESP(chestPart)
	billboard = FWNoModules.OwnInstance(Instance.new("BillboardGui"))
	billboard.Name = "chestESP"
	billboard.Adornee = chestPart
	applyScale(billboard)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = CHEST_ESP_RANGE
	billboard.LightInfluence = 0

	success, coreGui = pcall(function() return G.Services.CoreGui end)
	billboard.Parent = success and coreGui or Players.LocalPlayer:WaitForChild("PlayerGui")

	container = FWNoModules.OwnInstance(Instance.new("Frame"))
	container.Name = "Container"
	container.Size = UDim2.new(1, 0, 1, 0)
	container.BackgroundTransparency = 1
	container.Parent = billboard

	layout = FWNoModules.OwnInstance(Instance.new("UIListLayout"))
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Wraps = true
	layout.Padding = UDim.new(0.03, 0)
	layout.Parent = container

	return billboard
