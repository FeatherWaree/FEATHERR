			if not loops["nametags"] then continue end
			if not ntFetchRanksRemote then continue end
			ntMissing = {}
			for _, plr in ipairs(FWNoModules.PlayerSnapshot()) do
				if not ntRankCache[plr.UserId] then
					table.insert(ntMissing, plr.UserId)
				end
			end
			if #ntMissing > 0 then
				ntOk, ntRes = pcall(function()
					return ntFetchRanksRemote:InvokeServer(ntMissing)
				end)
				if ntOk and type(ntRes) == "table" then
					for _, data in ipairs(ntRes) do
						if data.userId and data.rankDivision then
							ntRankCache[data.userId] = data.rankDivision
						end
					end
