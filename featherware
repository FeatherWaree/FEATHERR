				mySlimes = {}
				for _, slime in ipairs(game:GetService("CollectionService"):GetTagged("SlimeData")) do
					tamer = slime:FindFirstChild("Tamer")
					if tamer and tamer.Value == Player.UserId then
						sType = slime:GetAttribute("SlimeType")
						if sType then
							mySlimes[sType] = slime
						end
					end
				end

				targets = {
					[0] = AutoNoelle.Values["Healing Slime Target"],
					[1] = AutoNoelle.Values["Void Slime Target"],
					[2] = AutoNoelle.Values["Sticky Slime Target"],
