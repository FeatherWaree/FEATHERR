		minerAnimType = require(ReplicatedStorage:WaitForChild("TS", 5):WaitForChild("animation", 5):WaitForChild("animation-type", 5)).AnimationType
		minerSoundManager = require(ReplicatedStorage:WaitForChild("rbxts_include", 5):WaitForChild("node_modules", 5):WaitForChild("@easy-games", 5):WaitForChild("game-core", 5):WaitForChild("out")).SoundManager
		minerGameSound = require(ReplicatedStorage:WaitForChild("TS", 5):WaitForChild("sound", 5):WaitForChild("game-sound", 5)).GameSound
	end)
