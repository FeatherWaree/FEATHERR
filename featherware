Nuker.Callbacks.OnToggle = function(state)
	loops["nuker"] = state
	if NukerConnection then
		NukerConnection:Disconnect()
		NukerConnection = nil
	end
	updateNukerHighlight(nil)
	hideHpBar()

	if loops["nuker"] then
		NukerConnection = G.Services.RunService.Heartbeat:Connect(function()
			if not loops["nuker"] then return end
			char = Player.Character
			if not char or not char:FindFirstChild("HumanoidRootPart") then
				updateNukerHighlight(nil)
				updateCustomHpBar(nil)
				return
			end
			hrp = char.HumanoidRootPart
			cam = G.Services.Workspace.CurrentCamera
			if not cam then return end

			mode = Nuker.Values["Mode"] or "Blatant"
			bedOnly = Nuker.Values["Bed Only"] or false
			range = Nuker.Values["Break Range"] or 21
			mineBlock = nil

			-- ============ LEGIT ============
			if mode == "Legit" then
				lgParams = RaycastParams.new()
				lgParams.FilterType = Enum.RaycastFilterType.Exclude
				lgParams.FilterDescendantsInstances = {char}
				lgParams.IgnoreWater = true
				lgRay = cam:Raycast(cam.CFrame.Position, cam.CFrame.LookVector * range, lgParams)

				if not lgRay or not lgRay.Instance then
					updateNukerHighlight(nil)
					updateCustomHpBar(nil)
					return
				end
				lgInst = lgRay.Instance

				lgBed = nil
				for _, b in ipairs(beds) do
					if lgInst == b or lgInst:IsDescendantOf(b) then lgBed = b break end
				end

				if lgBed then
					if isOwnTeam(lgBed) or not isGroupEnabled("bed") then
						updateNukerHighlight(nil)
						updateCustomHpBar(nil)
						return
					end
					mineBlock = lgBed
					lgInside = lgRay.Position - lgRay.Normal * 0.5
					tryBreak(gridPos(lgInside), lgRay.Position, lgRay.Normal, lgBed.CFrame, lgBed.Size)
				else
					if bedOnly then
						updateNukerHighlight(nil)
						updateCustomHpBar(nil)
						return
					end
					lgGroup = nil
					for name, group in pairs(targetMap) do
						for _, blk in ipairs(group) do
							if lgInst == blk or lgInst:IsDescendantOf(blk) then lgGroup = name break end
						end
						if lgGroup then break end
					end
					if not lgGroup or not isGroupEnabled(lgGroup) then
						updateNukerHighlight(nil)
						updateCustomHpBar(nil)
						return
					end
					mineBlock = lgInst
					lgInside = lgRay.Position - lgRay.Normal * 0.5
					lgCell = gridPos(lgInside) * 3
					tryBreak(gridPos(lgInside), lgRay.Position, lgRay.Normal, CFrame.new(lgCell), Vector3.new(3,3,3))
				end
				updateCustomHpBar(mineBlock)
				return
			end

			-- ============ BLATANT ============
			nearestBed = nil
			shortest = range
			if isGroupEnabled("bed") then
				for _, b in ipairs(beds) do
					if b and b.Parent and not isOwnTeam(b) then
						d = (hrp.Position - b.Position).Magnitude
						if d < shortest then
							shortest = d
							nearestBed = b
						end
					end
				end
			end

			if nearestBed then
				side = scanBedSides(nearestBed, char, range)
				if side and side.open then
					mineBlock = nearestBed
					tryBreak(gridPos(side.bedPoint), side.bedPoint + side.dir * 0.5, side.dir, nearestBed.CFrame, nearestBed.Size)
				elseif side then
					if bedOnly then
						updateNukerHighlight(nearestBed.CFrame, nearestBed.Size)
						updateCustomHpBar(nil)
						return
					end
					mineBlock = blockAtPoint(side.outerPoint, char) or nearestBed
					cellCenter = gridPos(side.outerPoint) * 3
					tryBreak(gridPos(side.outerPoint), side.outerPoint, (hrp.Position - side.outerPoint).Unit, CFrame.new(cellCenter), Vector3.new(3,3,3))
				else
					mineBlock = nearestBed
					updateNukerHighlight(nearestBed.CFrame, nearestBed.Size)
				end
				updateCustomHpBar(mineBlock)
				return
			end

			if bedOnly then
				updateNukerHighlight(nil)
				updateCustomHpBar(nil)
				return
			end

			nearestTarget = nil
			shortest = range
			for name, group in pairs(targetMap) do
				if name ~= "bed" and isGroupEnabled(name) then
					for _, blk in ipairs(group) do
						if blk and blk.Parent then
							d = (hrp.Position - blk.Position).Magnitude
							if d < shortest then
								shortest = d
								nearestTarget = blk
							end
						end
					end
				end
			end

			if not nearestTarget then
				updateNukerHighlight(nil)
				updateCustomHpBar(nil)
				return
			end

			rayParams = RaycastParams.new()
			rayParams.FilterType = Enum.RaycastFilterType.Exclude
			rayParams.FilterDescendantsInstances = {char, nearestTarget}
			rayParams.IgnoreWater = true
			rayResult = G.Services.Workspace:Raycast(cam.CFrame.Position, nearestTarget.Position - cam.CFrame.Position, rayParams)

			if rayResult and rayResult.Instance then
				mineBlock = rayResult.Instance
				inside = rayResult.Position - rayResult.Normal * 0.5
				cellCenter = gridPos(inside) * 3
				tryBreak(gridPos(inside), rayResult.Position, rayResult.Normal, CFrame.new(cellCenter), Vector3.new(3,3,3))
			else
				mineBlock = nearestTarget
				tryBreak(gridPos(nearestTarget.Position), nearestTarget.Position, (cam.CFrame.Position - nearestTarget.Position).Unit, nearestTarget.CFrame, nearestTarget.Size)
			end
			updateCustomHpBar(mineBlock)
		end)
	end
end
