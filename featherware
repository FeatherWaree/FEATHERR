luciaHasCandy = function()
	invFolder = ReplicatedStorage:FindFirstChild("Inventories") or ReplicatedStorage:FindFirstChild("inventories")
	if not invFolder then return false end
	playerInv = invFolder:FindFirstChild(Player.Name)
	if not playerInv then return false end

	-- Check if the player has any candy in their inventory
	-- Bedwars usually names the candy item "candy" or "lucia_candy"
	if playerInv:FindFirstChild("candy") or playerInv:FindFirstChild("lucia_candy") then
		return true
	end
	return false
end

luciaTryDeposit = function()
	if not loops["auto lucia"] then return end

	-- Throttle checks to every 0.2 seconds to keep it 100% lag-free
	now = os.clock()
	if now - luciaData.lastCheck < 0.2 then return end
	luciaData.lastCheck = now

	-- 1. Check if we have candy
	if not luciaHasCandy() then return end

	-- 2. Find the pinata
	pinata = luciaGetPinata()
	if not pinata then return end

	-- 3. Check the pinata's current coin amount vs our max limit
	currentCoins = pinata:GetAttribute("Coin") or 0
	maxLimit = AutoLucia.Values["Max Pinata Candy"] or 500

	if currentCoins >= maxLimit then return end

	-- 4. Check distance (10 stud range)
	char = Player.Character
	if not char then return end
	hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	dist = (hrp.Position - pinata.Position).Magnitude
	if dist > (AutoLucia.Values["Deposit Range"] or 10) then return end

	-- 5. Fire the remote
	if luciaLoadRemote() then
		pcall(function()
			luciaData.remote:InvokeServer(pinata)
		end)
	end
end

