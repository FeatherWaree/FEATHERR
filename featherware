	if not TARGET_STARS[child.Name] then return end

	local character = Player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not rootPart then return end

	local starRoot = child:FindFirstChild("RootPart")
	if not starRoot then return end

	local maxRange = (AutoStar.Values and AutoStar.Values["Range"]) or 50
	local distance = (rootPart.Position - starRoot.Position).Magnitude

	if distance <= maxRange then
		local starId = child:GetAttribute("id") or child:GetAttribute("Id")
		if starId then
			local args = {
				{
					id = starId,
					collectableName = child.Name
				}
			}

			task.defer(CollectRemote.FireServer, CollectRemote, unpack(args))
			if AutoStar.Values and AutoStar.Values["Use Collect Animation"] then
				local humanoid = character:FindFirstChildOfClass("Humanoid")
				if humanoid then
					local anim = Instance.new("Animation")
					anim.AnimationId = "rbxassetid://4866397461"

					local animator = humanoid:FindFirstChildOfClass("Animator") or humanoid
