function baIsBowEquipped()
	ba_char = Player.Character
	if not ba_char then return false end
	ba_hi = ba_char:FindFirstChild("HandInvItem")
	if not ba_hi or not ba_hi.Value then return false end
	ba_name = tostring(ba_hi.Value.Name):lower()
	return ba_name:find("bow") ~= nil or ba_name:find("crossbow") ~= nil or ba_name:find("headhunter") ~= nil
end

function baHasLOS(from, to)
	ba_char = Player.Character
	if not ba_char then return true end
	ba_raycast.FilterDescendantsInstances = { ba_char }
	ba_hit = G.Services.Workspace:Raycast(from, to - from, ba_raycast)
	return ba_hit == nil
end

function baFindTarget()
	ba_cam = G.Services.Workspace.CurrentCamera
	if not ba_cam then return nil end
	ba_camPos = ba_cam.CFrame.Position
	ba_lookDir = ba_cam.CFrame.LookVector
	ba_fovRad = math.rad(BowAssist.Values["FOV"] or 60)
	ba_range = BowAssist.Values["Range"] or 200
	ba_best = nil
	ba_bestAngle = ba_fovRad

	if BowAssist.Values["Target Players"] then
		for _, ba_plr in ipairs(Players:GetPlayers()) do
			if ba_plr ~= Player and ba_plr.Character then
				ba_hum = ba_plr.Character:FindFirstChildOfClass("Humanoid")
				ba_root = ba_plr.Character:FindFirstChild("HumanoidRootPart")
				if ba_hum and ba_root and ba_hum.Health > 0 then
					if BowAssist.Values["Ignore Team"] and Player.Team and ba_plr.Team == Player.Team then continue end
					ba_dist = (ba_root.Position - ba_camPos).Magnitude
					if ba_dist <= ba_range then
						ba_dir = (ba_root.Position - ba_camPos).Unit
						ba_angle = math.acos(math.clamp(ba_lookDir:Dot(ba_dir), -1, 1))
						if ba_angle < ba_bestAngle then
							if not BowAssist.Values["Ignore Walls"] or baHasLOS(ba_camPos, ba_root.Position) then
								ba_bestAngle = ba_angle
								ba_best = ba_root.Position
							end
						end
					end
				end
			end
		end
	end

	if BowAssist.Values["Target NPCs"] and typeof(EntityCache) == "table" and EntityCache.npcs then
		for _, ba_npc in ipairs(EntityCache.npcs) do
			ba_root = ba_npc:FindFirstChild("HumanoidRootPart") or ba_npc.PrimaryPart
			ba_hum = ba_npc:FindFirstChildOfClass("Humanoid")
			if ba_root and ba_hum and ba_hum.Health > 0 then
				ba_dist = (ba_root.Position - ba_camPos).Magnitude
				if ba_dist <= ba_range then
					ba_dir = (ba_root.Position - ba_camPos).Unit
					ba_angle = math.acos(math.clamp(ba_lookDir:Dot(ba_dir), -1, 1))
					if ba_angle < ba_bestAngle then
						if not BowAssist.Values["Ignore Walls"] or baHasLOS(ba_camPos, ba_root.Position) then
							ba_bestAngle = ba_angle
							ba_best = ba_root.Position
						end
					end
				end
			end
		end
	end

	return ba_best
end

BowAssist.Callbacks.OnToggle = function(state)
	loops["bowassist"] = state
	if state then
		ba_conn = sm_rs2.RenderStepped:Connect(function()
			if not loops["bowassist"] then return end
			if BowAssist.Values["Only When Drawing"] and not baIsBowEquipped() then return end
			ba_target = baFindTarget()
			if not ba_target then return end
			ba_cam = G.Services.Workspace.CurrentCamera
			if not ba_cam then return end
			ba_targetCF = CFrame.new(ba_cam.CFrame.Position, ba_target)
			ba_smooth = BowAssist.Values["Smoothness"] or 0.15
			ba_curLook = ba_cam.CFrame.LookVector
			ba_newLook = ba_targetCF.LookVector
			ba_finalX = ba_curLook.X
			ba_finalY = ba_curLook.Y
			ba_finalZ = ba_curLook.Z
			if BowAssist.Values["Horizontal Assist"] then
				ba_finalX = ba_curX + (ba_newLook.X - ba_curLook.X) * ba_smooth
				ba_finalZ = ba_curLook.Z + (ba_newLook.Z - ba_curLook.Z) * ba_smooth
			end
			if BowAssist.Values["Vertical Assist"] then
				ba_finalY = ba_curLook.Y + (ba_newLook.Y - ba_curLook.Y) * ba_smooth
			end
			ba_cam.CFrame = CFrame.new(ba_cam.CFrame.Position, ba_cam.CFrame.Position + Vector3.new(ba_finalX, ba_finalY, ba_finalZ))
		end)
	else
		if ba_conn then ba_conn:Disconnect(); ba_conn = nil end
	end
end
