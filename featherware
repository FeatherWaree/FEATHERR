-- ===== TARGET TRACKING (prediction) =====

function vaResetTracking()
	va_posHistory = {}
	va_smoothVel = Vector3.new(0, 0, 0)
	va_groundedResult = true
	va_groundedFrame = 0
end

function vaAddToHistory(pos, t)
	table.insert(va_posHistory, { pos = pos, t = t })
	while #va_posHistory > 15 do table.remove(va_posHistory, 1) end
end

function vaCalcAvgVel()
	if #va_posHistory < 2 then return va_smoothVel end
	va_newest = va_posHistory[#va_posHistory]
	va_oldest = va_posHistory[1]
	va_dt = va_newest.t - va_oldest.t
	if va_dt < 0.01 then return va_smoothVel end
	va_rawVel = (va_newest.pos - va_oldest.pos) / va_dt
	va_smoothVel = va_smoothVel:Lerp(va_rawVel, 0.3)
	return va_smoothVel
end

function vaIsGrounded(root, model)
	va_groundParams.FilterDescendantsInstances = { model }
	va_hit = G.Services.Workspace:Raycast(root.Position - Vector3.new(0, 1, 0), Vector3.new(0, -4, 0), va_groundParams)
	return va_hit ~= nil
end

function vaPredictPos(root, origin, model)
	vaAddToHistory(root.Position, os.clock())
	va_vel = vaCalcAvgVel()
	va_groundedFrame = va_groundedFrame + 1
	if va_groundedFrame >= 3 then
		va_groundedFrame = 0
		va_groundedResult = vaIsGrounded(root, model)
	end
	va_dist = (root.Position - origin).Magnitude
	va_bulletSpeed = VulcanAimbot.Values["Bullet Speed"] or 500
	if va_bulletSpeed < 1 then va_bulletSpeed = 1 end
	va_leadTime = va_dist / va_bulletSpeed
	-- horizontal lead catches strafing (tangential velocity component)
	va_predX = root.Position.X + va_vel.X * va_leadTime
	va_predZ = root.Position.Z + va_vel.Z * va_leadTime
	-- vertical: if airborne, compensate for gravity arc (jumping/falling)
	if va_groundedResult then
		va_predY = root.Position.Y
	else
		va_predY = root.Position.Y + va_vel.Y * va_leadTime - 0.5 * G.Services.Workspace.Gravity * va_leadTime * va_leadTime
	end
	return Vector3.new(va_predX, va_predY, va_predZ)
end

