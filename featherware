						table.insert(targets, obj)
						count = count + 1
					end
				end
			end
		end
	end

	return targets, count
end

lianGetNearestTarget = function(maxDist)
	myChar = PlayersService.LocalPlayer.Character
	if not myChar then return nil end
	myRoot = myChar:FindFirstChild("HumanoidRootPart")
	if not myRoot then return nil end

	bestTarget = nil
	bestDist = maxDist

	for _, plr in ipairs(PlayersService:GetPlayers()) do
		if lianIsEnemy(plr.Character) then
			eRoot = plr.Character:FindFirstChild("HumanoidRootPart")
			if eRoot then
				dist = (myRoot.Position - eRoot.Position).Magnitude
				if dist < bestDist then
					bestDist = dist
					bestTarget = plr.Character
				end
			end
		end
	end

	if lianSettings.includeNPCs then
		for _, obj in ipairs(G.Services.Workspace:GetChildren()) do
			if obj:IsA("Model") and not PlayersService:GetPlayerFromCharacter(obj) then
				hum = obj:FindFirstChildOfClass("Humanoid")
				eRoot = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
				if hum and hum.Health > 0 and eRoot then
					dist = (myRoot.Position - eRoot.Position).Magnitude
					if dist < bestDist then
						bestDist = dist
						bestTarget = obj
					end
				end
			end
		end
	end

	return bestTarget
end

