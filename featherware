		lbl.Text = "      " .. sName .. ": " .. string.format(formatStr, default)
		lbl.Size = UDim2.new(1, 0, 0.6, 0)
		lbl.BackgroundTransparency = 1
		lbl.TextColor3 = Color3.fromRGB(180, 180, 180)
		lbl.TextSize = 18
		lbl.TextXAlignment = Enum.TextXAlignment.Left
		lbl.FontFace = Font.fromName(textFont)
		lbl.ClearTextOnFocus = false

		local bg = Instance.new("TextButton", sFrame)
		bg.Text = ""
		bg.Size = UDim2.new(0.85, 0, 0.15, 0)
		bg.Position = UDim2.new(0.075, 0, 0.65, 0)
		bg.BackgroundColor3 = Color3.fromRGB(45, 45, 45)

		-- Safe UICorner creation
		local bgCorner = Instance.new("UICorner")
		bgCorner.CornerRadius = UDim.new(0, 4)
		bgCorner.Parent = bg

		local fill = Instance.new("Frame", bg)
		fill.BackgroundColor3 = Color3.fromRGB(78, 173, 73)
		fill.Size = UDim2.new((default - min)/(max - min), 0, 1, 0)

		local fillCorner = Instance.new("UICorner")
		fillCorner.CornerRadius = UDim.new(0, 4)
		fillCorner.Parent = fill

		mod.Values[sName] = default
		if sCallback then pcall(function() sCallback(default) end) end

		local function updateSliderVisual(val)
			val = cleanVal(val)
			local percent = math.clamp((val - min) / (max - min), 0, 1)
			fill.Size = UDim2.new(percent, 0, 1, 0)
			lbl.Text = "      " .. sName .. ": " .. string.format(formatStr, val)

			mod.Values[sName] = val
			_G.SavedConfig[settingID] = val

			-- Safe call for saveConfigToPC
			pcall(function()
				if type(saveConfigToPC) == "function" then
					saveConfigToPC()
				elseif typeof(saveConfigToPC) == "Instance" then
					if saveConfigToPC:IsA("BindableEvent") then
						saveConfigToPC:Fire()
					elseif saveConfigToPC:IsA("RemoteEvent") then
						saveConfigToPC:FireServer()
					end
				end
			end)

			if sCallback then pcall(function() sCallback(val) end) end
			if mod.Callbacks.OnValueChanged then pcall(function() mod.Callbacks.OnValueChanged(sName, val) end) end
		end

		mod.UpdateFunctions[sName] = function(forceValue)
			updateSliderVisual(forceValue)
		end

		lbl.FocusLost:Connect(function()
			local rawText = lbl.Text:match(":%s*(.-)$") or lbl.Text
			local num = tonumber(rawText)
			if num then
				updateSliderVisual(num)
			else
				updateSliderVisual(mod.Values[sName])
			end
		end)

		-- Define these locally for the drag logic just in case they aren't at the top of your script
		local RunService = G.Services.RunService
		local UserInputService = G.Services.UIS

		bg.MouseButton1Down:Connect(function()
			local moveConn, releaseConn
			moveConn = G.Services.RunService.RenderStepped:Connect(function()
				local mouseP = UserInputService:GetMouseLocation().X
				local relative = math.clamp((mouseP - bg.AbsolutePosition.X) / bg.AbsoluteSize.X, 0, 1)
				local val = min + ((max - min) * relative)
				updateSliderVisual(val)
			end)
			releaseConn = UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 then
					moveConn:Disconnect()
					releaseConn:Disconnect()
				end
			end)
		end)

		sFrame.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseWheel then
				local delta = input.Position.Z 
				local currentVal = mod.Values[sName]
				local newVal = currentVal + (delta * sStep)
				updateSliderVisual(newVal)
			end
		end)

		return sliderElement
	end

