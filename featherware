		metal_part.Transparency = MetalESP.Values["Part Transparency"] or 0
		metal_part.Color = MetalESP.Values["Part Color"] or Color3.fromRGB(255, 180, 50)
		metal_part.Material = Enum.Material.Neon
		metal_part.CastShadow = false
	end

	if MetalESP.Values["Show Highlight"] then
		metal_hl = Instance.new("Highlight")
		metal_hl.Adornee = model
		metal_hl.FillColor = MetalESP.Values["Highlight Fill Color"] or Color3.fromRGB(255, 180, 50)
		metal_hl.OutlineColor = MetalESP.Values["Highlight Outline Color"] or Color3.fromRGB(255, 255, 255)

		metal_hl.FillTransparency = MetalESP.Values["Highlight Fill Transparency"]
		if metal_hl.FillTransparency == nil then metal_hl.FillTransparency = 0.85 end

		metal_hl.OutlineTransparency = MetalESP.Values["Highlight Outline Transparency"]
		if metal_hl.OutlineTransparency == nil then metal_hl.OutlineTransparency = 0.1 end

		metal_hl.DepthMode = (MetalESP.Values["Through Walls"] ~= false) and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
		metal_hl.Parent = metal_folder
		metal_entry.hl = metal_hl
	end

