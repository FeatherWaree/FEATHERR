						hasMoved = (rootPart.Position - initialPosition).Magnitude > 0.5
						isJumping = humanoid.FloorMaterial == Enum.Material.Air
						stillHoldingRod = (handInvItem.Value and handInvItem.Value.Name == "fishing_rod")
