function updateDisplay()
	if not loops["player display"] then return end

	pd_includeOwn = PlayerDisplay.Values["Include Own Team"]
	pd_includeClans = PlayerDisplay.Values["Include Clans"]
	pd_includeLevels = PlayerDisplay.Values["Include Levels"]
	pd_showKitImg = PlayerDisplay.Values["Show Kit Image"]

	pd_currentPlayers = Players:GetPlayers()
	pd_activeUsers = {}

	for _, pd_plr in ipairs(pd_currentPlayers) do
		if pd_includeOwn or pd_plr ~= Player then
			pd_activeUsers[pd_plr.UserId] = pd_plr

			pd_cache = playerCache[pd_plr.UserId]
			if not pd_cache then
				pd_pf, pd_refs = createPlayerFrame(pd_plr)
				pd_cache = {
					frame = pd_pf,
					refs = pd_refs,
					lastName = "",
					lastDetails = "",
					lastKit = "",
					lastShowImg = nil,
					lastTeam = nil
				}
				playerCache[pd_plr.UserId] = pd_cache

				task.spawn(function()
					pd_success, pd_img = pcall(function()
						return Players:GetUserThumbnailAsync(pd_plr.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
					end)
					if pd_success and pd_cache.refs and pd_cache.refs.av and pd_cache.refs.av.Parent then
						pd_cache.refs.av.Image = pd_img
					end
				end)
			end

			if not pd_cache or not pd_cache.frame then
				playerCache[pd_plr.UserId] = nil
				continue
			end

			pd_currentTeam = pd_plr.Team
			pd_tName = pd_currentTeam and pd_currentTeam.Name or "No Team"
			if pd_cache.lastTeam ~= pd_tName then
				pd_tf = getTeamFrame(pd_currentTeam)
				pd_pc = pd_tf:FindFirstChild("PlayersContainer")
				if pd_pc then
					pd_cache.frame.Parent = pd_pc
				end
				pd_cache.lastTeam = pd_tName
			end

			pd_displayName = pd_plr.DisplayName or pd_plr.Name
			if pd_cache.lastName ~= pd_displayName then
				pd_cache.refs.name.Text = pd_displayName
				pd_cache.lastName = pd_displayName
			end

			pd_details = {}
			if pd_includeLevels then
				pd_lvl = pd_plr:GetAttribute("PlayerLevel")
				if pd_lvl then table.insert(pd_details, "Lvl " .. tostring(pd_lvl)) end
			end
			if pd_includeClans then
				pd_clan = pd_plr:GetAttribute("ClanTag")
				if type(pd_clan) == "string" and pd_clan ~= "" then 
					table.insert(pd_details, "[" .. pd_clan .. "]") 
				end
			end
			pd_detailStr = table.concat(pd_details, " • ")
			if pd_cache.lastDetails ~= pd_detailStr then
				pd_cache.refs.details.Text = pd_detailStr
				pd_cache.lastDetails = pd_detailStr
			end

			pd_kitName = pd_plr:GetAttribute("PlayingAsKit") or pd_plr:GetAttribute("PlayingAsKits") or ""
			if pd_cache.lastKit ~= pd_kitName or pd_cache.lastShowImg ~= pd_showKitImg then
				pd_cache.lastKit = pd_kitName
				pd_cache.lastShowImg = pd_showKitImg
				pd_kitMeta = pd_kitName ~= "" and BedwarsKitMetaModule and BedwarsKitMetaModule.getBedwarsKitMeta(pd_kitName)
				if pd_kitMeta then
					if pd_showKitImg and pd_kitMeta.renderImage and pd_kitMeta.renderImage ~= "" then
						pd_cache.refs.kitImg.Image = pd_kitMeta.renderImage
						pd_cache.refs.kitImg.Visible = true
						pd_cache.refs.kitTxt.Visible = false
					else
						pd_cache.refs.kitImg.Visible = false
						pd_cache.refs.kitTxt.Visible = true
						pd_cache.refs.kitTxt.Text = pd_kitMeta.name or pd_kitName
					end
				else
					pd_cache.refs.kitImg.Visible = false
					pd_cache.refs.kitTxt.Visible = true
					pd_cache.refs.kitTxt.Text = pd_kitName
				end
			end
		end
	end

	for pd_userId, pd_c in pairs(playerCache) do
		if not pd_activeUsers[pd_userId] then
			if pd_c and pd_c.frame then
				pd_c.frame:Destroy()
			end
			playerCache[pd_userId] = nil
		end
	end

	cleanupEmptyTeams()
end

function cleanupEmptyTeams()
	for cet_tName, cet_tf in pairs(teamFrames) do
		cet_has = false
		for _, cet_child in ipairs(cet_tf.PlayersContainer:GetChildren()) do
			if cet_child:IsA("Frame") and cet_child.Name == "PlayerFrame" then
				cet_has = true
				break
			end
		end
		if not cet_has then
			cet_tf:Destroy()
			teamFrames[cet_tName] = nil
		end
	end
end

pdUpdateConn = nil
pd_lastUpdate = 0

PlayerDisplay.Callbacks.OnToggle = function(state)
	loops["player display"] = state
	if pdGui then pdGui.Enabled = state end

	if pdUpdateConn then
		pdUpdateConn:Disconnect()
		pdUpdateConn = nil
	end

	if state then
		updateDisplay()
		pdUpdateConn = G.Services.RunService.Heartbeat:Connect(function()
			pd_now = os.clock()
			if pd_now - pd_lastUpdate >= 1 then
				pd_lastUpdate = pd_now
				updateDisplay()
			end
		end)
	else
		for pd_uid, pd_c in pairs(playerCache) do
			if pd_c and pd_c.frame then pd_c.frame:Destroy() end
		end
		playerCache = {}
		for cet_tName, cet_tf in pairs(teamFrames) do
			cet_tf:Destroy()
		end
		teamFrames = {}
	end
end

HitRegAdjuster = Combat:CreateButton("Hit Reg Adjuster", nil, true)
HitRegAdjuster:CreateSlider("Max Hits per 10s", 1, 35, 35, nil, 0.1)

hrAdjusterLastHit = 0
hrAdjusterHookActive = false

HitRegAdjuster.Callbacks.OnToggle = function(state)
	loops["hit reg adjuster"] = state
	if state and not hrAdjusterHookActive then
		hrAdjusterHookActive = true
		if hookmetamethod then
			local oldNamecall
			oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
				if loops["hit reg adjuster"] then
					local method = getnamecallmethod()
					if method == "FireServer" then
						local remoteName = tostring(self)
						if remoteName == "SwordHit" then
							local maxHits = tonumber(HitRegAdjuster.Values["Max Hits per 10s"]) or 35
							local requiredDelay = 10 / math.max(maxHits, 1)

							-- Safety floor to prevent server rejection
							requiredDelay = math.max(requiredDelay, 0.2857) 

							local now = os.clock()
							if now - hrAdjusterLastHit < requiredDelay then
								return nil -- Blocks the hit from firing if it's too fast
							end
							hrAdjusterLastHit = now
						end
					end
				end
				return oldNamecall(self, ...)
			end)
		end
	end
end

Transparency = Visuals:CreateButton("Transparency", nil, true)
Transparency:CreateSlider("Amount", 0, 1, 0.5, nil, 0.1)

transpConn = nil
transpCharConn = nil

function transpApplyPart(part)
	if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and part.Name ~= "FW_Cape" then
		part.LocalTransparencyModifier = Transparency.Values["Amount"] or 0.5
	end
end

function transpApplyAll(targetChar)
	for _, desc in ipairs(targetChar:GetDescendants()) do
		transpApplyPart(desc)
	end
end

Transparency.Callbacks.OnToggle = function(state)
	loops["transparency"] = state
	if state then
		if game:GetService("Players").LocalPlayer.Character then
			transpApplyAll(game:GetService("Players").LocalPlayer.Character)
			if transpConn then transpConn:Disconnect() end

			-- task.defer beats Roblox's internal tool initialization so weapons stay transparent
			transpConn = game:GetService("Players").LocalPlayer.Character.DescendantAdded:Connect(function(desc)
				task.defer(transpApplyPart, desc)
			end)
		end

		if not transpCharConn then
			transpCharConn = game:GetService("Players").LocalPlayer.CharacterAdded:Connect(function(newChar)
				if not loops["transparency"] then return end
				task.wait(0.05)
				transpApplyAll(newChar)
				if transpConn then transpConn:Disconnect() end
				transpConn = newChar.DescendantAdded:Connect(function(desc)
					task.defer(transpApplyPart, desc)
				end)
			end)
		end
	else
		if transpConn then transpConn:Disconnect(); transpConn = nil end
		if transpCharConn then transpCharConn:Disconnect(); transpCharConn = nil end

		if game:GetService("Players").LocalPlayer.Character then
			for _, desc in ipairs(game:GetService("Players").LocalPlayer.Character:GetDescendants()) do
				if desc:IsA("BasePart") then
					desc.LocalTransparencyModifier = 0
				end
			end
		end
	end
end

