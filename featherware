-- Fires 3 sword_wave1 projectiles directly at the target entity
lumenFireWavesAtTarget = function(targetEntity)
	if not loops["auto lumen"] then return end
	if lumenSettings.instakillMode ~= "On Hit" then return end

	now = os.clock()
	if now - lumenData.lastFire < 0.1 then return end -- Anti-spam throttle
	lumenData.lastFire = now

	if not lumenLoadRemote() then return end

	math.randomseed(os.time() + math.floor(os.clock() * 1000000) + math.floor(tick() * 1000000))

	myChar = PlayersService.LocalPlayer.Character
	myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	if not myRoot then return end

	targetRoot = targetEntity:FindFirstChild("HumanoidRootPart") or targetEntity.PrimaryPart
	if not targetRoot then return end

	invFolder = ReplicatedStorage:WaitForChild("Inventories", 1):WaitForChild(PlayersService.LocalPlayer.Name, 1)
	lightSwordInv = invFolder and invFolder:FindFirstChild("light_sword")
	if not lightSwordInv then return end

	-- Calculate exact direction to the entity we just hit
	dir = (targetRoot.Position - myRoot.Position)
	if dir.Magnitude < 0.001 then
		dir = myRoot.CFrame.LookVector
	else
		dir = dir.Unit
	end

	vel = dir * 80
	origin = vector.create(myRoot.Position.X, myRoot.Position.Y, myRoot.Position.Z)
	velocity = vector.create(vel.X, vel.Y, vel.Z)

	-- Fire 3 times per hit using task.spawn for instant execution
	for i = 1, 3 do
		task.spawn(function()
			pcall(function()
				lumenData.fireRemote:InvokeServer(unpack({
					lightSwordInv,
					"light_sword",
					"sword_wave1",
					origin,
					origin,
					velocity,
					lumenMakeId(),
					{ shotId = lumenMakeId(), drawDurationSec = 0 },
					G.Services.Workspace:GetServerTimeNow()
				}))
			end)
		end)
	end
end

-- Method 1: __namecall Hook (Instant On Hit detection)
lumenSetupHook = function()
	if lumenData.hookActive then return end
	if not hookmetamethod or not getnamecallmethod or not checkcaller then return end

	lumenData.hookActive = true
	print("[Auto Lumen] Executor supports hooks. Using safe __namecall SwordHit/ProjectileHit detection.")

	lumenData.oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
		local args = {...}
		local result = lumenData.oldNamecall(self, unpack(args))

		if not checkcaller() then
			pcall(function()
				method = getnamecallmethod()
				if method == "FireServer" or method == "InvokeServer" then
					remoteName = tostring(self)
					if remoteName == "SwordHit" or remoteName == "ProjectileHit" then
						if loops["auto lumen"] and lumenSettings.instakillMode == "On Hit" then
							-- Try to extract the entity hit from the args
							hitData = args[1]
							targetEntity = nil
							if typeof(hitData) == "table" then
								targetEntity = hitData.entityInstance or hitData.target or hitData.victim
							end

							-- Fallback: if we can't parse the exact entity, find the closest enemy
							if not targetEntity then
								myRoot = PlayersService.LocalPlayer.Character and PlayersService.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
								if myRoot then
									bestDist = 15
									for _, plr in ipairs(PlayersService:GetPlayers()) do
										if plr ~= PlayersService.LocalPlayer and (not plr.Team or not PlayersService.LocalPlayer.Team or plr.Team ~= PlayersService.LocalPlayer.Team) then
											eChar = plr.Character
											if eChar then
												eRoot = eChar:FindFirstChild("HumanoidRootPart")
												if eRoot then
													dist = (myRoot.Position - eRoot.Position).Magnitude
													if dist < bestDist then
														bestDist = dist
														targetEntity = eChar
													end
												end
											end
										end
									end
									-- Also check NPCs
									for _, npc in ipairs(G.Services.Workspace:GetChildren()) do
										if npc:IsA("Model") and npc:FindFirstChildOfClass("Humanoid") and not PlayersService:GetPlayerFromCharacter(npc) then
											npcRoot = npc:FindFirstChild("HumanoidRootPart") or npc.PrimaryPart
											if npcRoot then
												dist = (myRoot.Position - npcRoot.Position).Magnitude
												if dist < bestDist then
													bestDist = dist
													targetEntity = npc
												end
											end
										end
									end
								end
							end

							if targetEntity then
								task.wait(0.1)
								lumenFireWavesAtTarget(targetEntity)
							end
						end
					end
				end
			end)
		end
		return result
	end)
end

-- Method 2: EntityDamageEvent Fallback (For non-hook executors)
lumenSetupFallback = function()
	if lumenData.fallbackConn then return end
	pcall(function()
		netManaged = ReplicatedStorage:WaitForChild("rbxts_include", 5):WaitForChild("node_modules", 5):WaitForChild("@rbxts", 5):WaitForChild("net", 5):WaitForChild("out", 5):WaitForChild("_NetManaged", 5)
		entityDamaged = netManaged:WaitForChild("EntityDamageEvent", 5)
		lumenData.fallbackConn = entityDamaged.OnClientEvent:Connect(function(data)
			if not loops["auto lumen"] or lumenSettings.instakillMode ~= "On Hit" then return end

			if typeof(data) == "table" then
