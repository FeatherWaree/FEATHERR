		metal_bb.Adornee = metal_part
		metal_bb.Size = UDim2.fromOffset(100, 30)
		metal_bb.StudsOffset = Vector3.new(0, 1.5, 0)
		metal_bb.AlwaysOnTop = MetalESP.Values["Through Walls"] ~= false
		metal_bb.Parent = metal_folder

