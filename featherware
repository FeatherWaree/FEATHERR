function metalApplyProps()
	if not metal_ready then return end
	metal_walls = MetalESP.Values["Through Walls"] ~= false
	for _, metal_e in pairs(metal_active) do
		if metal_e.hl then
			metal_e.hl.FillColor = MetalESP.Values["Highlight Fill Color"] or Color3.fromRGB(255, 180, 50)
