Killaura.Callbacks.OnToggle = function(state)
	loops["killaura"] = state
	if not state then
		currentKaTarget = nil
		currentVisualTarget = nil
		if kaHighlight then kaHighlight.Adornee = nil end
		hide3DBox()
		if loadedSwingTrack and loadedSwingTrack.Parent then
			loadedSwingTrack:Stop()
		end
		if kaHeartbeatConn then
			kaHeartbeatConn:Disconnect()
			kaHeartbeatConn = nil
		end
		return 
	end

	if ka3DBox and ka3DBox.Parent ~= G.Services.Workspace and ka3DBox.Parent ~= game.Lighting and ka3DBox.Parent ~= nil then
		ka3DBox.Color = Killaura.Values["3D Box Color"] or Color3.fromRGB(0, 255, 163)
	end

	character = Player.Character or Player.CharacterAdded:Wait()
	if not character then return end
	animator = character:FindFirstChild("Humanoid") and character.Humanoid:FindFirstChild("Animator")
	swingAnimation = Instance.new("Animation")
	swingAnimation.AnimationId = "rbxassetid://4947108314"
	loadedSwingTrack = animator and animator:LoadAnimation(swingAnimation)
	if loadedSwingTrack then
		loadedSwingTrack.Priority = Enum.AnimationPriority.Action
		loadedSwingTrack.Looped = false
	end

	lastTargetSearch = 0
	cachedBestTarget = nil
	currentVisualTarget = nil
	lastEquipTime = 0
	lastVisualSwing = 0

	-- ACCUMULATOR VARIABLES (Fixes Slider Inaccuracy)
	accumulatedTime = 0
	lastFrameTime = os.clock()

	if kaHeartbeatConn then kaHeartbeatConn:Disconnect() end

	kaHeartbeatConn = G.Services.RunService.Heartbeat:Connect(function(deltaTime)
		if not loops["killaura"] then
			kaHeartbeatConn:Disconnect()
			kaHeartbeatConn = nil
			return
		end

		-- 1. PERFECT TIMING ACCUMULATOR
		-- We use real deltaTime passed by Heartbeat instead of task.wait()
		now = os.clock()
		realDelta = now - lastFrameTime
		lastFrameTime = now

		-- Cap delta to prevent stockpiling if the game freezes/lags heavily
		if realDelta > 0.25 then realDelta = 0.016 end
		accumulatedTime = accumulatedTime + realDelta

		hitsPer10 = tonumber(Killaura.Values["Hits per 10s"]) or 35
		calculatedDelay = 10 / math.max(hitsPer10, 0.025)
		hitDelay = math.max(calculatedDelay, 0.025) -- Allow up to ~40 CPS max internally

		if not (Killaura.Values["Target Players"] or Killaura.Values["Target NPCs/Dummies"]) then return end

		char = Player.Character
		rootPart = char and char:FindFirstChild("HumanoidRootPart")
		humanoid = char and char:FindFirstChild("Humanoid")

		if not rootPart or not humanoid or humanoid.Health <= 0 then return end

		if Killaura.Values["Check If Sophia Frozen"] then
			stunTime = Player:GetAttribute("StunnedUntilTime")
			if stunTime and stunTime ~= -1 and stunTime > 0 then return end
		end

		handItem = char:FindFirstChild("HandInvItem")
		if not handItem then return end

		reach = tonumber(Killaura.Values["Reach"]) or 12.4
		selectionRange = reach
		if Killaura.Values["Swing Animation"] then
			selectionRange = tonumber(Killaura.Values["Swing Range"]) or 50
		end

		if now - lastTargetSearch > 0.15 or not cachedBestTarget or not cachedBestTarget.Parent then
			lastTargetSearch = now
			playertarget, playerdistance = nil, selectionRange
			npcdummytarget, npcdummydistance = nil, selectionRange

			for _, charModel in ipairs(EntityCache.Players or {}) do
				if charModel ~= Player.Character and charModel.Parent then
					tHRP = charModel:FindFirstChild("HumanoidRootPart")
					tHum = charModel:FindFirstChildOfClass("Humanoid")

					if tHRP and tHum and tHum.Health > 0 then
						dist = (rootPart.Position - tHRP.Position).Magnitude
						if dist < playerdistance then
							playertarget = charModel
							playerdistance = dist
						end
					end
				end
			end
			
			if Killaura.Values["Target NPCs/Dummies"] then
				for _, npc in ipairs(EntityCache.NPCs or {}) do
					if npc and npc.Parent then
						tHRP = npc:FindFirstChild("HumanoidRootPart") or npc.PrimaryPart
						tHum = npc:FindFirstChild("Humanoid")
						if tHRP and tHum and tHum.Health > 0 then
							dist = (rootPart.Position - tHRP.Position).Magnitude
							if dist < npcdummydistance then
								npcdummytarget = npc
								npcdummydistance = dist
							end
						end
					end
				end
			end

			priority = Killaura.Values["Priority"]
			bountyTarget = nil
			if priority == "Bounty Hunter" and ClientStore then
				pcall(function()
					storeState = ClientStore:getState()
					if storeState and storeState.Kit then
						bTarget = storeState.Kit.bountyHunterTarget
						if bTarget and typeof(bTarget) == "Instance" then
							bChar = bTarget:IsA("Player") and bTarget.Character or (bTarget:IsA("Model") and bTarget or nil)
							if bChar and bChar.Parent then
								bHRP = bChar:FindFirstChild("HumanoidRootPart") or bChar.PrimaryPart
								bHum = bChar:FindFirstChild("Humanoid")
								if bHRP and bHum and bHum.Health > 0 then
									bDist = (rootPart.Position - bHRP.Position).Magnitude
									if bDist <= selectionRange then
										bountyTarget = bChar
									end
								end
							end
						end
					end
				end)
			end

			if priority == "Bounty Hunter" then
				cachedBestTarget = bountyTarget or playertarget or npcdummytarget
			elseif priority == "Player" then
				cachedBestTarget = playertarget or npcdummytarget
			elseif priority == "NPC/Dummy" then
				cachedBestTarget = npcdummytarget or playertarget
			else
				cachedBestTarget = (playerdistance <= npcdummydistance and playertarget) or npcdummytarget or playertarget
			end
		end

		besttarget = cachedBestTarget
		if not besttarget or not besttarget.Parent then
			cachedBestTarget = nil
			if currentVisualTarget ~= nil then
				currentVisualTarget = nil
				if kaHighlight then kaHighlight.Adornee = nil end
				hide3DBox()
			end
			return
		end

		targetHRP = besttarget:FindFirstChild("HumanoidRootPart") or besttarget.PrimaryPart
		if not targetHRP then
			cachedBestTarget = nil
			return
		end

		distance = (rootPart.Position - targetHRP.Position).Magnitude

		-- 3. VISUALS (Highlight & 3D Box)
		if distance <= selectionRange then
			if Killaura.Values["Highlight Target"] then
				kaHighlight.FillColor = Killaura.Values["Highlight Color"]
				kaHighlight.Adornee = besttarget
			else
				kaHighlight.Adornee = nil
			end

			if Killaura.Values["3D Box Target"] then
				if currentVisualTarget ~= besttarget then
					currentVisualTarget = besttarget
					ka3DBox.Anchored = false
					ka3DBox.Parent = G.Services.Workspace
					ka3DBox.CFrame = targetHRP.CFrame
					ka3DBox.Size = Vector3.new(0.1, 0.1, 0.1)
					if ka3DBoxWeld then ka3DBoxWeld:Destroy() end
					ka3DBoxWeld = Instance.new("WeldConstraint")
					ka3DBoxWeld.Part0 = ka3DBox
					ka3DBoxWeld.Part1 = targetHRP
					ka3DBoxWeld.Parent = ka3DBox
					TweenService:Create(ka3DBox, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = Vector3.new(4, 5, 2)}):Play()
				end
				ka3DBox.Color = Killaura.Values["3D Box Color"]
			else
				if currentVisualTarget ~= nil then
					currentVisualTarget = nil
					hide3DBox()
				end
			end
		else
			if currentVisualTarget ~= nil then
				currentVisualTarget = nil
				if kaHighlight then kaHighlight.Adornee = nil end
				hide3DBox()
			end
		end

		-- 4. SWING ANIMATION
		if Killaura.Values["Swing Animation"] and not Killaura.Values["Manual Swing"] then
			if distance <= selectionRange then
				if Killaura.Values["Calculate Swing Speed"] then
					visualCooldown = math.max(1 / 9, hitDelay)
				else
					visualCooldown = tonumber(Killaura.Values["Swing Speed"]) or 0.111
				end
				if now - lastVisualSwing >= visualCooldown then
					lastVisualSwing = now
					if canRequire and kaSwordController then
						kaSwordController:playSwordEffect({sword = {}}, false, {playAnimation = true, playSound = true})
					else
						if loadedSwingTrack then
							if loadedSwingTrack.IsPlaying then
								loadedSwingTrack:Stop()
							end
							loadedSwingTrack:Play()
						end
					end
				end
			end
		end

		if distance <= reach and Killaura.Values["Face Target"] then
			faceTarget(char, besttarget)
		end

		-- 5. VALIDATION CHECKS
		if distance > reach then return end
		if math.abs(targetHRP.Position.Y - rootPart.Position.Y) > reach + 2 then return end
		if Killaura.Values["Wall Check"] and not kaCanSee(besttarget) then return end
		if not isInFOV(rootPart, targetHRP, tonumber(Killaura.Values["Angle Check"]) or 180) then return end

		isClicking = (typeof(clicking) == "boolean" and clicking) or (typeof(mouse1down) == "boolean" and mouse1down) or false
		if Killaura.Values["Manual Swing"] and not isClicking then return end

		invFolder = game.ReplicatedStorage:FindFirstChild("Inventories") and game.ReplicatedStorage.Inventories:FindFirstChild(Player.Name)
		heldName = handItem.Value and (typeof(handItem.Value) == "Instance" and handItem.Value.Name or tostring(handItem.Value)) or ""
		isSword = swords and table.find(swords, heldName)

		if not isSword then
			if Killaura.Values["Require Sword Equipped"] then
				return
			else
				if now - lastEquipTime > 0.25 then
					lastEquipTime = now
					task.spawn(function()
						bestSword = getBestEquippedSword(Player.Name)
						if bestSword then
							swordInstance = typeof(bestSword) == "Instance" and bestSword or nil
							if not swordInstance then
								swapInv = G.Services.RS:FindFirstChild("Inventories")
								playerInv = swapInv and swapInv:FindFirstChild(Player.Name)
								swordInstance = playerInv and playerInv:FindFirstChild(tostring(bestSword))
							end
							if swordInstance then
								SetInvItemRemote:InvokeServer({ hand = swordInstance })
							end
						end
					end)
				end
				return
			end
		end

		inventoryWeapon = invFolder and invFolder:FindFirstChild(heldName)
		if not inventoryWeapon then
			inventoryWeapon = getBestEquippedSword(Player.Name)
		end

		if not loops["killaura"] then return end

		-- 6. THE ACCUMULATOR TRIGGER & ANTI-STUTTER CHECK
		if accumulatedTime >= hitDelay then
			-- Prevent accumulator from stockpiling if frame drops occur
			accumulatedTime = accumulatedTime - hitDelay
			if accumulatedTime > hitDelay then 
				accumulatedTime = 0 
			end

			-- ANTI-STUTTER: Check the game's internal SwordController cooldown
			-- This prevents the script from firing while the game is buffering an attack, eliminating the 0.3s-0.5s dead zone.
			canFire = true
			if canRequire and kaSwordController then
				serverTime = G.Services.Workspace:GetServerTimeNow()
				-- Get the weapon's actual attack speed dynamically
				weaponSpeed = 0.15 -- Default fallback
				if ItemMetaTable and ItemMetaTable[heldName] and ItemMetaTable[heldName].sword then
					weaponSpeed = ItemMetaTable[heldName].sword.attackSpeed or 0.15
				end

				-- If the game is still on cooldown, DO NOT FIRE. Wait for the next frame.
				if (serverTime - (kaSwordController.lastAttack or 0)) < weaponSpeed then
					canFire = false
					-- Refund the time so we try again immediately on the next frame
					accumulatedTime = accumulatedTime + hitDelay 
				end
			end

			if canFire then
				currentKaTarget = besttarget
				dir = (targetHRP.Position - rootPart.Position).Unit
				spoofedTargetPosition = targetHRP.Position
				if distance > 14 then
					spoofedTargetPosition = targetHRP.Position + ((rootPart.Position - targetHRP.Position).Unit * (distance - 13.5))
				end

				kaArgs = {{
					chargedAttack = { chargeRatio = 0 },
					entityInstance = besttarget,
					validate = {
						selfPosition = { value = rootPart.Position + dir * 5.5 },
						targetPosition = { value = spoofedTargetPosition },
						raycast = {
							cameraPosition = { value = G.Services.Workspace.CurrentCamera.CFrame.Position },
							cursorDirection = { value = dir }
						}
					},
					weapon = inventoryWeapon,
					timeSinceSwingStart = 0
				}}

				SwordHitRemote:FireServer(unpack(kaArgs))
			end
		end
	end)
end
