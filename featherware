		btn.TextSize = 20
		btn.FontFace = Font.fromName(textFont)
		btn.TextXAlignment = Enum.TextXAlignment.Left

		local function update()
			btn.TextColor3 = button.Toggled
				and Color3.fromRGB(78,173,73)
				or Color3.fromRGB(180,180,180)
		end

		function button:SetState(state)
			if self.Toggled == state then
				return
			end

			self.Toggled = state
			update()

			if callback then
				callback(state)
			end
		end

		FWNoModules.Connect(btn.Activated, FWNoModules.Mobile.Activation(function()
			if toggleable then
				button:SetState(not button.Toggled)
			else
				if callback then
					callback()
				end
			end
		end))

		update()

		return button
	end

