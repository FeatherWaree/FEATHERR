whisperSolve = function(O, T, v, g)
	ws_d = T - O
	ws_R = math.sqrt(ws_d.X*ws_d.X + ws_d.Z*ws_d.Z)
	if v <= 0 then return nil, 0 end
	if g < 0.001 then
		ws_dist = ws_d.Magnitude
		if ws_dist < 0.01 then return Vector3.new(0, v, 0), 0 end
		return ws_d.Unit * v, ws_dist / v
	end
	if ws_R < 0.5 then
		return Vector3.new(0, ws_d.Y >= 0 and v or -v, 0), math.abs(ws_d.Y) / v
	end
	ws_v2 = v * v
	ws_disc = ws_v2*ws_v2 - g*(g*ws_R*ws_R + 2*ws_d.Y*ws_v2)
	if ws_disc < 0 then return nil, 0 end
	ws_tanT = (ws_v2 - math.sqrt(ws_disc)) / (g * ws_R)
	ws_cosT = 1 / math.sqrt(1 + ws_tanT*ws_tanT)
	ws_hDir = Vector3.new(ws_d.X, 0, ws_d.Z) * (1 / ws_R)
	return ws_hDir*(v*ws_cosT) + Vector3.new(0, v*ws_tanT*ws_cosT, 0), ws_R / (v*ws_cosT)
end

whisperShoot = function(owl, target)
	if not whisperData.owlFireRemote then return end

	owlPart = owl.PrimaryPart or owl:FindFirstChildWhichIsA("BasePart")
	targetPart = target:FindFirstChild("HumanoidRootPart") or target:FindFirstChild("Head") or target.PrimaryPart
	if not owlPart or not targetPart then return end

	origin = owlPart.Position
	targetPos = targetPart.Position

	pm = (whisperProjMeta and whisperProjMeta["owl_projectile"]) or nil
	speed = (pm and pm.launchVelocity) or 180
	grav = (pm and pm.gravitationalAcceleration) or 196.2
	life = (pm and pm.lifetimeSec) or 3

	targetVel = targetPart.AssemblyLinearVelocity or Vector3.zero
	if targetVel.Magnitude > 200 then targetVel = targetVel.Unit * 200 end

	vt, t = nil, 0
	aim = targetPos
	for i = 1, 4 do
		vt, t = whisperSolve(origin, aim, speed, grav)
		if not vt then break end
		aim = Vector3.new(
			targetPos.X + targetVel.X * t,
			targetPos.Y + targetVel.Y * t,
			targetPos.Z + targetVel.Z * t)
	end
	if not vt then
		vt = (targetPos - origin).Unit * speed
	end

	args = {
		fromPosition = origin,
		direction = vt,
		ProjectileRefId = whisperGenerateId(),
		initialVelocity = vt
	}
	pcall(function() whisperData.owlFireRemote:FireServer(args) end)

	whisperSpawnVisual(origin, vt, grav, math.min(life, 3))
end

whisperData.vis = {}

whisperSpawnVisual = function(o, v, g, life)
	if #whisperData.vis >= 20 then return end
	src = nil
	pcall(function()
		rs = G.Services.RS
		if rs:FindFirstChild("Items") then src = rs.Items:FindFirstChild("owl_projectile") end
		if not src and rs:FindFirstChild("Assets") then
			if rs.Assets:FindFirstChild("owl_projectile") then src = rs.Assets.owl_projectile end
			if not src and rs.Assets:FindFirstChild("Projectiles") then src = rs.Assets.Projectiles:FindFirstChild("owl_projectile") end
		end
	end)

	if src then
		clone = src:Clone()
		clone.Parent = G.Services.Workspace
		if clone:IsA("BasePart") then
			mover = clone; isModel = false
		elseif clone:IsA("Model") then
			isModel = true
			mover = clone.PrimaryPart or clone:FindFirstChildWhichIsA("BasePart")
			if mover and not clone.PrimaryPart then clone.PrimaryPart = mover end
		else
			clone:Destroy()
			return
		end
		if not mover then return end
		if mover:IsA("BasePart") then
			mover.Anchored = true; mover.CanCollide = false; mover.CanQuery = false; mover.CanTouch = false
		end
	else
		clone = Instance.new("Part")
		clone.Shape = Enum.PartType.Ball
		clone.Size = Vector3.new(0.9, 0.9, 0.9)
		clone.Material = Enum.Material.Neon
		clone.Color = Color3.fromRGB(190, 230, 255)
		clone.Anchored = true; clone.CanCollide = false; clone.CanQuery = false; clone.CanTouch = false
		clone.CastShadow = false
		clone.Parent = G.Services.Workspace
		mover = clone; isModel = false
	end

	dir = v.Magnitude > 0 and v.Unit or Vector3.new(0,1,0)
	mover.CFrame = CFrame.lookAt(o, o + dir)
	if isModel then clone:PivotTo(mover.CFrame) end

	table.insert(whisperData.vis, {obj = clone, mover = mover, isModel = isModel, O = o, V = v, g = g, t0 = tick(), life = life or 2.5})
end

whisperVisTick = function()
	nowT = tick(); i = 1
	while i <= #whisperData.vis do
		e = whisperData.vis[i]; t = nowT - e.t0
		if t >= e.life or not e.obj.Parent then
			pcall(function() e.obj:Destroy() end); table.remove(whisperData.vis, i)
		else
			p = e.O + e.V*t + Vector3.new(0, -0.5*e.g*t*t, 0)
			cv = e.V + Vector3.new(0, -e.g*t, 0)
			d = cv.Magnitude > 0.001 and cv.Unit or Vector3.new(0,1,0)
			cf = CFrame.lookAt(p, p + d)
			if e.isModel then e.obj:PivotTo(cf) else e.mover.CFrame = cf end
			i = i + 1
		end
	end
end

