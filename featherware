pcall(function()
	cd_dmgConn = FWNoModules.GatedEvent(NetRemotes:WaitForChild("EntityDamageEvent", 10).OnClientEvent, {"cheater detector"}, function(data)
		if not loops["cheater detector"] then return end
		if type(data) ~= "table" then return end
		cd_from = data.fromEntity
		cd_victim = data.entityInstance
		if typeof(cd_from) ~= "Instance" or typeof(cd_victim) ~= "Instance" then return end
		if cd_from == cd_victim then return end
		cd_fromPlr = Players:GetPlayerFromCharacter(cd_from)
		cd_victimPlr = Players:GetPlayerFromCharacter(cd_victim)
		cd_now = os.clock()

		if cd_victimPlr and cdShouldCheck(cd_victimPlr) then
			cd_st = cdState(cd_victimPlr)
			cd_st.lastHurt = cd_now
			if CheaterDetector.Values["Velocity"] then
				cd_st.velBefore = cd_st.lastVel
				cd_st.hurtTime = cd_now
				cd_st.velChecked = false
			end
		end

		if cd_fromPlr and cdShouldCheck(cd_fromPlr) then
			cd_held = cdHeldName(cd_from)
			cd_st = cdState(cd_fromPlr)
			cd_st.lastMeleeAny = cd_now
			if cd_held then
				cd_fHRP = cd_from:FindFirstChild("HumanoidRootPart")
				cd_vHRP = cd_victim:FindFirstChild("HumanoidRootPart")
				if cd_fHRP and cd_vHRP then
					cd_dist = (cd_fHRP.Position - cd_vHRP.Position).Magnitude

					-- SWORD REACH: server max is 14.4, anything above = cheat
					if CheaterDetector.Values["Reach"] and table.find(swords, cd_held) and cd_dist > 14.5 then
						cdNotify(cd_fromPlr, "Reach (" .. math.floor(cd_dist) .. " studs)")
					end

					-- KAIDA REACH: normal claw max 21
					if CheaterDetector.Values["Kaida Reach"] and cd_held:find("summoner_claw") and cd_dist > 21.5 then
						cdNotify(cd_fromPlr, "Kaida Reach (" .. math.floor(cd_dist) .. " studs)")
					end

					if table.find(swords, cd_held) then
						-- KA: WALL CHECK
						if cdKaEnabled("Wall Check") and cd_dist <= 20 then
							cd_wp = RaycastParams.new()
							cd_wp.FilterType = Enum.RaycastFilterType.Exclude
							cd_wp.FilterDescendantsInstances = {cd_from, cd_victim}
							cd_w = G.Services.Workspace:Raycast(cd_fHRP.Position + Vector3.new(0, 1, 0), cd_vHRP.Position - cd_fHRP.Position, cd_wp)
							if cd_w and cd_w.Instance and cd_w.Instance.CanCollide then
								cdNotify(cd_fromPlr, "Killaura (no wall check)")
							end
						end
						-- KA: ANGLE (hits from behind, ~180°)
						if cdKaEnabled("Angle") then
							cd_ang = math.deg(math.acos(math.clamp(cd_fHRP.CFrame.LookVector:Dot((cd_vHRP.Position - cd_fHRP.Position).Unit), -1, 1)))
							if cd_ang >= 170 then
								cdNotify(cd_fromPlr, "Killaura (360 angle hit)")
							end
						end
						cd_st.lastMelee = cd_now
					end
				end
			end
		end
	end)
end)

