function isInFOV(originPart, targetPart, angleLimit)
	if not originPart or not targetPart then return false end
	dirToTarget = (targetPart.Position - originPart.Position).Unit
	dot = originPart.CFrame.LookVector:Dot(dirToTarget)
	angle = math.deg(math.acos(math.clamp(dot, -1, 1)))
	return angle <= angleLimit
end

function isClawEquipped()
	char = Player.Character
	if not char then return false end

	handItem = char:FindFirstChild("HandInvItem")
	if not handItem then return false end

	clawName = tostring(handItem.Value)
	return table.find(claws, clawName) ~= nil
end

function equipClaw()
	inventories = G.Services.RS:FindFirstChild("Inventories")
	if not inventories then return false end

	inventoryFolder = inventories:FindFirstChild(Player.Name)
	if not inventoryFolder then return false end

	inventoryClaw = nil

	for i = 4, 1, -1 do
		checkClaw = "summoner_claw_" .. tostring(i)
		claw = inventoryFolder:FindFirstChild(checkClaw)
		if claw then
			inventoryClaw = claw
			break
		end
	end

	if not inventoryClaw then
		for _, item in ipairs(inventoryFolder:GetChildren()) do
			if table.find(claws, item.Name) then
				inventoryClaw = item
				break
			end
		end
	end

	if not inventoryClaw then return false end

	remote = getSetInvRemote()
	if not remote then return false end

	success = false
	pcall(function()
		remote:InvokeServer({hand = inventoryClaw})
		success = true
	end)

	if success then
		task.wait(0.1)
	end

	return success
end

function handleClawRequirement()
	if KaidaKa.Values["Require Claw Equipped"] then
		return isClawEquipped()
	end

	if isClawEquipped() then
		return true
	end

	equipClaw()

	for i = 1, 8 do
		if isClawEquipped() then
			return true
		end
		task.wait(0.05)
	end

	return isClawEquipped()
end

function playSwingAnim()
	if not KaidaKa.Values["Swing Anim"] then return end
	char = Player.Character
	if not char then return end
	humanoid = char:FindFirstChild("Humanoid")
	if not humanoid then return end

	animator = humanoid:FindFirstChildOfClass("Animator")

	if not animator then
		NotificationSystem.Notify("Kaida Swing Anim", "No animator found", 1)
		return
	end

	if not kaidaHitTrack or not kaidaHitTrack.IsPlaying then
		if not kaidaHitTrack then
			kaidaHitTrack = animator:LoadAnimation(swingAnimation)
			kaidaHitTrack.Priority = Enum.AnimationPriority.Action
			kaidaHitTrack.Looped = false
		end
		kaidaHitTrack:Play()
	end
end

function playHitSound()
	if KaidaKa and KaidaKa.Values and not KaidaKa.Values["Hit Sound"] then
		if currentHitSound and currentHitSound.Parent then
			currentHitSound:Stop()
			currentHitSound:Destroy()
			currentHitSound = nil
		end
		return
	end

	if #clawSoundIds == 0 then return end

	if currentHitSound and currentHitSound.Parent and currentHitSound.IsPlaying then
		return
	end

	if currentHitSound and currentHitSound.Parent then
		currentHitSound:Stop()
		currentHitSound:Destroy()
		currentHitSound = nil
	end

	s = Instance.new("Sound")
	s.Volume = 1
	s.SoundId = clawSoundIds[math.random(1, #clawSoundIds)]
	s.Parent = G.Services.Workspace.CurrentCamera or G.Services.Workspace
	currentHitSound = s
	s:Play()

	s.Ended:Connect(function()
		if currentHitSound == s then
			currentHitSound = nil
		end
		if s and s.Parent then
			s:Destroy()
		end
	end)

	task.delay(10, function()
		if s and s.Parent and not s.IsPlaying then
			if currentHitSound == s then
				currentHitSound = nil
			end
			s:Destroy()
		end
	end)
end

function spawnClawVFX(position, direction)
	task.spawn(function()
		clawModel = game.ReplicatedStorage.Assets.Misc.Kaida.Summoner_DragonClaw:Clone()
		clawModel.Parent = G.Services.Workspace

		unitDir = Vector3.new(direction.X, 0, direction.Z).Unit
		rightVec = unitDir:Cross(Vector3.new(0, 1, 0)).Unit * -1
		spawnPos = position + rightVec * 5 + unitDir * 6
		lookAt = spawnPos + direction * 13

		clawModel:PivotTo(CFrame.new(spawnPos, lookAt))
		if clawModel.PrimaryPart then clawModel.PrimaryPart.Anchored = true end

		animController = clawModel:FindFirstChild("AnimationController")
		if animController then
			animator = humanoid:FindFirstChildOfClass("Animator")
			if not animator then
				NotificationSystem.Notify("Kaida Claw VFX", "No animator found", 1)
				return
			end

			clawAnim = clawModel:FindFirstChildWhichIsA("Animation", true)
			if not clawAnim and clawVfxAnimId then
				clawAnim = Instance.new("Animation")
				clawAnim.AnimationId = clawVfxAnimId
			end

			if clawAnim then
				track = animator:LoadAnimation(clawAnim)
				track:Play(0.1, 1, 1)
			end
		end

		meshParts = {}
		for _, child in ipairs(clawModel:GetDescendants()) do
			if child:IsA("MeshPart") or child:IsA("BasePart") then
				child.Transparency = 0
				table.insert(meshParts, child)
			end
		end

		task.wait(0.2)
		fadeInfo = TweenInfo.new(0.25, Enum.EasingStyle.Linear, Enum.EasingDirection.In)
		for _, part in ipairs(meshParts) do
			TweenService:Create(part, fadeInfo, {Transparency = 1}):Play()
		end

		task.delay(0.3, function()
			if clawModel and clawModel.Parent then
				clawModel:Destroy()
			end
		end)
	end)
end

