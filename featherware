function spTargetSet()
	sp_set = {}
	if StarPopper.Values["All Consumables"] then
		for sp_k, sp_e in pairs(sp_items) do
			if type(sp_e) == "table" and sp_e.consumable and sp_e.consumable.consumeTime ~= nil then
				sp_set[sp_e] = true
			end
		end
	else
		for _, sp_key in ipairs({ sp_itemType.CRIT_STAR, sp_itemType.VITALITY_STAR }) do
			sp_e = sp_items[sp_key]
			if sp_e and sp_e.consumable then sp_set[sp_e] = true end
		end
	end
	return sp_set
end

function spApply(v)
	if not sp_items or not sp_itemType then return end
	sp_use = (v <= 0) and 0.0001 or v
	sp_want = spTargetSet()
	for sp_e in pairs(sp_patched) do
		if not sp_want[sp_e] then
			if sp_orig[sp_e] ~= nil then sp_e.consumable.consumeTime = sp_orig[sp_e] end
			sp_patched[sp_e] = nil
		end
	end
	for sp_e in pairs(sp_want) do
		if sp_orig[sp_e] == nil then sp_orig[sp_e] = sp_e.consumable.consumeTime end
		sp_e.consumable.consumeTime = sp_use
		sp_patched[sp_e] = true
	end
end

function spRestore()
	for sp_e in pairs(sp_patched) do
		if sp_orig[sp_e] ~= nil then sp_e.consumable.consumeTime = sp_orig[sp_e] end
		sp_patched[sp_e] = nil
	end
end

