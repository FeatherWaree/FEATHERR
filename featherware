	-- 1. Check if Jellyfish Kit is equipped
	kitAttr = PlayersService.LocalPlayer:GetAttribute("PlayingAsKits")
	if kitAttr ~= "jellyfish" then
		if not marinaData.notified then
			marinaSendNotification("Auto Marina", "Jellyfish kit is not equipped! Module disabled.")
