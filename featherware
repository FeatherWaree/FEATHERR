function paAxisFix(L)
	tgt = Vector3.new(0, 0, -1)
	d = L:Dot(tgt)
	if d > 0.999 then return CFrame.new() end
	if d < -0.999 then return CFrame.Angles(math.rad(180), 0, 0) end
	return CFrame.fromAxisAngle(L:Cross(tgt).Unit, math.acos(math.clamp(d, -1, 1)))
end

function paPlaySound(sndData)
