local function GetFunctionRange(Func)
    if not canDebug then
        return nil
    end

    local Found: boolean = false
    for _, v: number | string | boolean in debug.getconstants(Func) do
        if v == "maxActivationDistance" then
            Found = true
        elseif Found then
            return v and typeof(v) == "number" and v or nil
        end
    end
    return nil
end
getgenv().getFunctionRange = GetFunctionRange

getgenv().findConstant = function(Func, Value: any, After: any?): number?
    if not canDebug or typeof(Func) ~= "function" then
        return nil
    end

    local Constants: {any} = debug.getconstants(Func)
    local Anchor: number = 0
    if After ~= nil then
        for Index: number, v: any in Constants do
            if v == After and (Anchor == 0 or Index < Anchor) then
                Anchor = Index
            end
        end
        if Anchor == 0 then
            return nil
        end
    end

    local Found: number?
    for Index: number, v: any in Constants do
        if v == Value and Index > Anchor and (not Found or Index < Found) then
            Found = Index
        end
    end
    return Found
end


