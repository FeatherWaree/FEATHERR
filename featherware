farmerTryHarvest = function(crop)
	if farmerData.lastHarvest[crop] and os.clock() - farmerData.lastHarvest[crop] < 1.5 then return end

	myChar = PlayersService.LocalPlayer.Character
	if not myChar then return end
	myRoot = myChar:FindFirstChild("HumanoidRootPart")
	if not myRoot then return end

	pos = crop:GetPivot().Position
	dist = (pos - myRoot.Position).Magnitude

	if dist > 6.5 then return end 

	name = crop.Name:lower()
	isCarrot = name:find("carrot")
	isMelon = name:find("melon")
	isPumpkin = name:find("pumpkin")

	if isCarrot and not farmerSettings.autoCarrots then return end
	if isMelon and not farmerSettings.autoMelons then return end
	if isPumpkin and not farmerSettings.autoPumpkins then return end
	if not isCarrot and not isMelon and not isPumpkin then return end

	farmerData.lastHarvest[crop] = os.clock()

	-- FIXED: Perfect BlockEngine grid math for 3x3x3 blocks (works for positive AND negative coords)
	blockPos = Vector3.new(
		math.floor((pos.X + 1.5) / 3), 
		math.floor((pos.Y + 1.5) / 3), 
		math.floor((pos.Z + 1.5) / 3)
	)

	if farmerLoadAnims() then
		pcall(function()
			farmerData.GameAnimationUtil:playAnimation(PlayersService.LocalPlayer, farmerData.AnimationType.PUNCH)
			farmerData.SoundManager:playSound(farmerData.GameSound.CROP_HARVEST)
		end)
	end

	-- Tiny delay to let the client register the swing before the server validates the harvest
	task.wait(0.05)

	if farmerLoadRemote() then
		pcall(function()
			-- MUST be InvokeServer because CropHarvest is a RemoteFunction (CallServer)
			farmerData.remote:InvokeServer({position = blockPos})
		end)
	end
end

