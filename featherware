local function dropAllItems(iron, diamond, emerald)

	local char = cachedChar
	if not char then return end

	local inflated = char:GetAttribute("InflatedBalloons") or 0

	if not VoidDrop.Values["During Balloons"] and inflated > 0 then
		return
	end

	local inventory = FWNoModules.GetPrivateInventory(Player.Name)
	if not inventory then return end


	if loops["auto balloon"] and not VoidDrop.Values["During Balloons"] then
		if inventory:FindFirstChild("balloon") then
			return
		end
	end


	if not VoidDrop.Values["During Whisper Fly"] then
		for _, owl in ipairs(G.Services.Workspace:GetChildren()) do
			if owl.Name == "ServerOwl" 
				and owl:GetAttribute("Target") == Player.UserId 
				and owl:GetAttribute("Status") == 2 then
				return
			end
		end
	end


	local function fireDrop(itemName)

		local itemInstance = inventory:FindFirstChild(itemName)

		if itemInstance then

			local amount = itemInstance:GetAttribute("Amount") or 1

			local args = {
				{
					item = itemInstance,
					amount = amount
				}
			}

			task.spawn(function()
				dropRemote:InvokeServer(unpack(args))
			end)

		end
	end


	if iron then fireDrop("iron") end
	if diamond then fireDrop("diamond") end
	if emerald then fireDrop("emerald") end
end


