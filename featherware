				kaHighlight.Adornee = nil
				boxVisualizer.Adornee = nil
			end

			shouldSwing = false
			if KaidaKa.Values["Manual Swing"] then
				if clicking or swingRequested then
					shouldSwing = true
				end
				swingRequested = false
			else
				if hasTarget then
					shouldSwing = true
				end
			end

			if shouldSwing then
				if not handleClawRequirement() then
					continue
				end

				camera = G.Services.Workspace.CurrentCamera
				swingDir = targetDir or (camera and camera.CFrame.LookVector) or rootPart.CFrame.LookVector
				offsetPosition = rootPart.Position + (swingDir * reach)

				playSwingAnim()
				playHitSound()
				spawnClawVFX(rootPart.Position, swingDir)

				if hasTarget then
					remote = getClawRemote()
					remoteArgs = {
						{
							clientTime = G.Services.Workspace:GetServerTimeNow(),
							direction = Vector3.new(swingDir.X, swingDir.Y, swingDir.Z),
							position = Vector3.new(offsetPosition.X, offsetPosition.Y, offsetPosition.Z)
						}
					}

					if remote then
						pcall(function()
							remote:FireServer(unpack(remoteArgs))
						end)
					end
				end
			end
		end
	end)
