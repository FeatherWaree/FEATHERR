	end

	-- Also listen for kit changes in case they switch kits while module is on
	if not warriorData.kitConn then
		warriorData.kitConn = PlayersService.LocalPlayer:GetAttributeChangedSignal("PlayingAsKits"):Connect(function()
			if loops["auto warrior"] then
				warriorCheckAndFire()
			end
		end)
	end
end

