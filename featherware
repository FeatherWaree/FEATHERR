-- Performance support. Disabled work has no frame connection or polling timer.
do
    local runtime = FWNoModules.Runtime
    local watches = {}
    local waiters = {}
    local keyboard = {}
    local keyboardConnection
    runtime.cleanups = runtime.cleanups or {}

    function FWNoModules.OnCleanup(callback)
        if not runtime.active then callback(); return function() end end
        table.insert(runtime.cleanups, callback)
        local subscribed = true
        return function()
            if not subscribed then return end
            subscribed = false
            local index = table.find(runtime.cleanups, callback)
            if index then table.remove(runtime.cleanups, index) end
        end
    end

    function FWNoModules.SetLoop(key, value)
        local previous = loops[key]
        loops[key] = value
        if previous == value then return end
        local callbacks = watches[key]
        if callbacks then
            for callback in pairs(callbacks) do callback(value, previous) end
        end
        local waiter = waiters[key]
        if waiter then waiter:Fire() end
    end

    function FWNoModules.WatchLoop(key, callback)
        local callbacks = watches[key]
        if not callbacks then callbacks = {}; watches[key] = callbacks end
        callbacks[callback] = true
        return function() callbacks[callback] = nil end
    end

    -- Connect the unchanged callback at its original frame signal only while
    -- at least one of its owning features is enabled.
    function FWNoModules.GatedFrame(signal, keys, callback, settleOnDisable)
        local connection
        local subscriptions = {}
        local unsubscribeCleanup
        local gate = {Connected = true}
        local function synchronize()
            if not gate.Connected or not runtime.active then return end
            local enabled = false
            for _, key in ipairs(keys) do
                if loops[key] then enabled = true; break end
            end
            if enabled then
                if not connection then connection = FWNoModules.TrackFrameConnection(signal:Connect(callback)) end
            elseif connection then
                connection:Disconnect()
                connection = nil
                if settleOnDisable then callback() end
            end
        end
        function gate:Disconnect()
            if not self.Connected then return end
            self.Connected = false
            if connection then connection:Disconnect(); connection = nil end
            for _, unsubscribe in ipairs(subscriptions) do unsubscribe() end
            table.clear(subscriptions)
            if unsubscribeCleanup then unsubscribeCleanup(); unsubscribeCleanup = nil end
        end
        for _, key in ipairs(keys) do
            subscriptions[#subscriptions + 1] = FWNoModules.WatchLoop(key, synchronize)
        end
        synchronize()
        unsubscribeCleanup = FWNoModules.OnCleanup(function() gate:Disconnect() end)
        return gate
    end

    FWNoModules.GatedEvent = FWNoModules.GatedFrame

    function FWNoModules.WaitForFeature(key)
        if not runtime.active then return false end
        if loops[key] then return true end
        local waiter = waiters[key]
        if not waiter then
            waiter = FWNoModules.OwnInstance(Instance.new("BindableEvent"))
            waiters[key] = waiter
        end
        while runtime.active and not loops[key] do waiter.Event:Wait() end
        return runtime.active
    end

    -- Only matching bindings enter their original handler. A single engine
    -- listener replaces the per-button listeners, including unbound buttons.
    function FWNoModules.KeyboardListener(shouldRun, callback)
        local entry = {Connected = true, ShouldRun = shouldRun, Callback = callback}
        function entry:Disconnect()
            if not self.Connected then return end
            self.Connected = false
            local index = table.find(keyboard, self)
            if index then table.remove(keyboard, index) end
        end
        table.insert(keyboard, entry)
        if not keyboardConnection then
            keyboardConnection = FWNoModules.Connect(FWNoModules.Mobile.GetService().InputBegan, function(input, processed)
                if input.UserInputType ~= Enum.UserInputType.Keyboard or (FWNoModules.Profiles and FWNoModules.Profiles.busy) then return end
                for _, listener in ipairs(keyboard) do
                    if listener.Connected and listener.ShouldRun(input, processed) then
                        -- Preserve independent event-handler threads if a callback yields.
                        task.spawn(listener.Callback, input, processed)
                    end
                end
            end)
        end
        return entry
    end

    -- Pointer listeners exist only during the gesture. This also stops drags
    -- on focus loss, GUI destruction, and hiding the menu.
    function FWNoModules.PointerDrag(owner, input, onMove, onStop)
        local service = FWNoModules.Mobile.GetService()
        local connections = {}
        local active = runtime.active
        local stop
        stop = function()
            if not active then return end
            active = false
            runtime.pointerStops[stop] = nil
            for _, connection in ipairs(connections) do connection:Disconnect() end
            table.clear(connections)
            if onStop then onStop() end
        end
        if not active then return stop end
        runtime.pointerStops[stop] = true
        local function connect(signal, callback)
            connections[#connections + 1] = FWNoModules.Connect(signal, callback)
        end
        if onMove then
            connect(service.InputChanged, function(change)
                if input and input.UserInputType == Enum.UserInputType.Touch then
                    if change ~= input then return end
                elseif change.UserInputType ~= Enum.UserInputType.MouseMovement then return end
                onMove(change)
            end)
        end
        connect(service.InputEnded, function(change)
            if input and input.UserInputType == Enum.UserInputType.Touch then
                if change == input then stop() end
            elseif change.UserInputType == Enum.UserInputType.MouseButton1 then stop() end
        end)
        connect(service.WindowFocusReleased, stop)
        if owner then
            connect(owner.Destroying, stop)
            connect(owner:GetPropertyChangedSignal("Visible"), function()
                if not owner.Visible then stop() end
            end)
            local screen = owner:FindFirstAncestorOfClass("ScreenGui")
            if screen then
                connect(screen:GetPropertyChangedSignal("Enabled"), function()
                    if not screen.Enabled then stop() end
                end)
            end
        end
        return stop
    end

    runtime.pointerStops = {}
    FWNoModules.OnCleanup(function()
        local stops = {}
        for stop in pairs(runtime.pointerStops) do stops[#stops + 1] = stop end
        for _, stop in ipairs(stops) do stop() end
        for _, listener in ipairs(keyboard) do listener.Connected = false end
        table.clear(keyboard)
        for _, waiter in pairs(waiters) do waiter:Fire() end
        task.defer(function()
            for _, waiter in pairs(waiters) do waiter:Destroy() end
            table.clear(waiters)
        end)
        table.clear(watches)
    end)
end

-- Keep world caches proportional to live objects, without polling the map.
do
    local byInstance = {}
    local members = setmetatable({}, {__mode = "k"})
    local returning = setmetatable({}, {__mode = "k"})

    function FWNoModules.CacheWorldInstance(list, instance)
        if not FWNoModules.Runtime.active or not instance or not instance:IsDescendantOf(workspace) then return end
        local set = members[list]
        if not set then set = {}; members[list] = set end
        if set[instance] then return end
        set[instance] = true
        list[#list + 1] = instance
        local lists = byInstance[instance]
        if not lists then lists = {}; byInstance[instance] = lists end
        lists[list] = true
    end

    local function remove(instance)
        local lists = byInstance[instance]
        if not lists then return end
        byInstance[instance] = nil
        returning[instance] = lists
        for list in pairs(lists) do
            local set = members[list]
            if set then set[instance] = nil end
            local index = table.find(list, instance)
            if index then table.remove(list, index) end
        end
    end
    FWNoModules.Connect(workspace.DescendantRemoving, remove)
    FWNoModules.Connect(workspace.DescendantAdded, function(instance)
        local lists = returning[instance]
        if not lists then return end
        returning[instance] = nil
        for list in pairs(lists) do FWNoModules.CacheWorldInstance(list, instance) end
    end)
    FWNoModules.OnCleanup(function()
        for list in pairs(members) do table.clear(list) end
        table.clear(members)
        table.clear(byInstance)
        table.clear(returning)
    end)
end

-- Cross-device input adapter. Desktop keeps the native service and mouse.
function FWNoModules.BuildMobileInput()
    local native=game:GetService("UserInputService")
    local players=game:GetService("Players")
    local world=game:GetService("Workspace")
    local api={TouchEnabled=native.TouchEnabled,keys={},gestures=setmetatable({},{__mode="k"}),suppressed=setmetatable({},{__mode="k"}),keySources={},mouseSources={},virtual={},connections={}}
    local function position(input)return Vector2.new(input.Position.X,input.Position.Y)end
    local function center()local camera=world.CurrentCamera;return camera and camera.ViewportSize/2 or Vector2.new(0,0)end
    function api.IsTouchInput(input)return input and input.UserInputType==Enum.UserInputType.Touch end
    function api.GestureConsumed(input)
        local record=input and api.gestures[input]
        return record and(record.moved or record.secondary)or false
    end
    function api.Activation(callback)
        return function(input,...)
            if api.GestureConsumed(input)or(FWNoModules.Profiles and FWNoModules.Profiles.busy)then return end
            return callback(input,...)
        end
    end
    function api.Secondary(button,callback)
        if not api.TouchEnabled then return FWNoModules.Connect(button.MouseButton2Click,callback)end
        local ok,signal=pcall(function()return button.SecondaryActivated end)
        if ok and signal then
            return FWNoModules.Connect(signal,function(input,...)
                if api.IsTouchInput(input)then
                    local record=api.gestures[input];if record then record.secondary=true end
                end
                return callback(input,...)
            end)
        end
        -- Older clients retain right-click, with a bounded touch long-press fallback.
        local connection=FWNoModules.Connect(button.MouseButton2Click,callback)
        FWNoModules.Connect(button.InputBegan,function(input)
            if not api.IsTouchInput(input)then return end
            task.delay(.5,function()
                local record=api.gestures[input]
                if button.Parent and record and not record.ended and not record.moved then record.secondary=true;callback(input)end
            end)
        end)
        return connection
    end
    function api.BindMap(button,callback)
        FWNoModules.Connect(button.InputBegan,function(input)if not api.IsTouchInput(input)then callback(input)end end)
        FWNoModules.Connect(button.Activated,api.Activation(function(input)
            if api.IsTouchInput(input)then callback({UserInputType=Enum.UserInputType.MouseButton1,Position=input.Position})end
        end))
        api.Secondary(button,function(input)
            if api.IsTouchInput(input)then callback({UserInputType=Enum.UserInputType.MouseButton2,Position=input.Position})end
        end)
    end
    function api.BindHold(button,callback)
        local held={}
        local endConnection,focusConnection
        local function release(input)
            if not held[input]then return end
            held[input]=nil;callback(false,input)
            if not next(held)then
                if endConnection then endConnection:Disconnect();endConnection=nil end
                if focusConnection then focusConnection:Disconnect();focusConnection=nil end
