hitboxConnections = {}

-- Clears all active event listeners so they don't stack
function clearHitboxConnections()
	for _, conn in pairs(hitboxConnections) do
		pcall(function() conn:Disconnect() end)
	end
	hitboxConnections = {}
end

-- Applies the size and fixes camera properties
function applyHitboxToPart(part, sizeValue)
	if not part or not part:IsA("BasePart") then return end

	-- Ignore weapons and armor accessories so we don't make swords giant
	if part:FindFirstAncestorOfClass("Accessory") or part:FindFirstAncestorOfClass("Tool") then return end

	-- Save original states
	if not part:GetAttribute("OriginalSizeX") then
		part:SetAttribute("OriginalSizeX", part.Size.X)
		part:SetAttribute("OriginalSizeY", part.Size.Y)
		part:SetAttribute("OriginalSizeZ", part.Size.Z)
		part:SetAttribute("OriginalTrans", part.Transparency)
	end

	-- THE FIX: Keep Y size the exact same to bypass raycast anti-cheat flags. Expand X and Z.
	part.Size = Vector3.new(sizeValue, part:GetAttribute("OriginalSizeY"), sizeValue)
	part.Massless = true
	part.CanCollide = false

	-- THE FIX: Roblox camera/mouse ignores parts with transparency > 0.25
	if part.Transparency < 0.5 then
		part.Transparency = 0.5
	end
end

-- Reverts the part when you toggle the module off
function revertHitboxPart(part)
	if part and part:IsA("BasePart") and part:GetAttribute("OriginalSizeX") then
		part.Size = Vector3.new(
			part:GetAttribute("OriginalSizeX"),
			part:GetAttribute("OriginalSizeY"),
			part:GetAttribute("OriginalSizeZ")
		)
		if part:GetAttribute("OriginalTrans") then
			part.Transparency = part:GetAttribute("OriginalTrans")
		end
	end
end

-- Processes an entire character model (Players or NPCs)
function processCharacter(char, isPlayer)
	if not char then return end

	-- 1. Apply to parts that already loaded
	for _, desc in pairs(char:GetDescendants()) do
		pcall(function()
			if HitboxExpander.Values["Expand Players"] and isPlayer then
				applyHitboxToPart(desc, HitboxExpander.Values["Expand Size"] or 12)
			elseif HitboxExpander.Values["Expand NPCs"] and not isPlayer then
				applyHitboxToPart(desc, HitboxExpander.Values["Expand Size"] or 12)
			end
		end)
	end

	-- 2. Listen for parts loading in late (like late armor spawns) without any loops
	table.insert(hitboxConnections, FWNoModules.Connect(char.DescendantAdded, function(desc)
		pcall(function()
			if HitboxExpander.Values["Expand Players"] and isPlayer then
				applyHitboxToPart(desc, HitboxExpander.Values["Expand Size"] or 12)
			elseif HitboxExpander.Values["Expand NPCs"] and not isPlayer then
				applyHitboxToPart(desc, HitboxExpander.Values["Expand Size"] or 12)
			end
		end)
	end))
end

-- Main Setup Event Function
function runHitboxExpanderEvents()
	clearHitboxConnections()

	-- ==== SETUP PLAYERS ====
	if HitboxExpander.Values["Expand Players"] then
		-- Apply to current players
		for _, plr in pairs(FWNoModules.PlayerSnapshot()) do
			if plr ~= game:GetService("Players").LocalPlayer then
				if plr.Character then
					processCharacter(plr.Character, true)
				end
				-- Listen for when they die and respawn
				table.insert(hitboxConnections, FWNoModules.Connect(plr.CharacterAdded, function(char)
					processCharacter(char, true)
				end))
			end
		end

		-- Listen for brand new players joining the match
		table.insert(hitboxConnections, FWNoModules.Connect(game:GetService("Players").PlayerAdded, function(plr)
			if plr ~= game:GetService("Players").LocalPlayer then
				table.insert(hitboxConnections, FWNoModules.Connect(plr.CharacterAdded, function(char)
					processCharacter(char, true)
				end))
			end
		end))
	end

	-- ==== SETUP NPCS ====
	if HitboxExpander.Values["Expand NPCs"] then
		-- Apply to currently existing Hitbox tags
		for _, box in pairs(game:GetService("CollectionService"):GetTagged("Hitbox")) do
			pcall(function() applyHitboxToPart(box, HitboxExpander.Values["Expand Size"] or 12) end)
		end

		-- Listen for new tags being added by the server in real-time
		table.insert(hitboxConnections, FWNoModules.Connect(game:GetService("CollectionService"):GetInstanceAddedSignal("Hitbox"), function(box)
			pcall(function() applyHitboxToPart(box, HitboxExpander.Values["Expand Size"] or 12) end)
		end))
	end
end

-- Cleanup Function
function revertAllHitboxes()
	clearHitboxConnections()

	-- Revert players
	for _, plr in pairs(FWNoModules.PlayerSnapshot()) do
		if plr.Character then
			for _, desc in pairs(plr.Character:GetDescendants()) do
				pcall(function() revertHitboxPart(desc) end)
			end
		end
	end

	-- Revert tags
	for _, box in pairs(game:GetService("CollectionService"):GetTagged("Hitbox")) do
		pcall(function() revertHitboxPart(box) end)
		if box.Parent then
			for _, desc in pairs(box.Parent:GetDescendants()) do
				pcall(function() revertHitboxPart(desc) end)
			end
		end
	end
end

