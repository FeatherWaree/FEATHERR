-- Shared prediction math. No workers or frame connections are added here.
function FWNoModules.BuildProjectilePrediction()
    local api = {}
    local floorCache = setmetatable({}, {__mode="k"})
    local motionCache = setmetatable({}, {__mode="k"})
    local floorParams = RaycastParams.new()
    floorParams.FilterType = Enum.RaycastFilterType.Exclude
    floorParams.IgnoreWater = true
    local filter = {}
    local function finite(n) return type(n)=="number" and n==n and math.abs(n)<1e12 end
    local function sane(v)
        if not v or not finite(v.X)or not finite(v.Y)or not finite(v.Z)then return Vector3.zero end
        return v.Magnitude>1024 and v.Unit*1024 or v
    end
    function api.Static(origin, target, speed, gravity)
        if not finite(speed)or speed<=0 or not finite(gravity)then return nil end
        gravity=math.max(0,gravity)
        local d=target-origin
        local range=math.sqrt(d.X*d.X+d.Z*d.Z)
        if gravity<1e-5 then
            local distance=d.Magnitude
            if distance<1e-6 then return Vector3.new(0,speed,0),0 end
            return d*(speed/distance),distance/speed
        end
        if range<1e-6 then
            if math.abs(d.Y)<1e-6 then return Vector3.new(0,speed,0),0 end
            if d.Y>0 then
                local disc=speed*speed-2*gravity*d.Y
                if disc<0 then return nil end
                return Vector3.new(0,speed,0),2*d.Y/(speed+math.sqrt(disc))
            end
            return Vector3.new(0,-speed,0),-2*d.Y/(speed+math.sqrt(speed*speed-2*gravity*d.Y))
        end
        local v2=speed*speed
        local disc=v2*v2-gravity*(gravity*range*range+2*d.Y*v2)
        if disc<0 then return nil end
        -- Rationalized low-arc expression stays stable for fast/flat shots.
        local tangent=(gravity*range*range+2*d.Y*v2)/(range*(v2+math.sqrt(disc)))
        local horizontal=speed/math.sqrt(1+tangent*tangent)
        return Vector3.new(d.X/range*horizontal,horizontal*tangent,d.Z/range*horizontal),range/horizontal
    end
    function api.Track(records,model,position,now,raw)
        raw=sane(raw)
        local previous=records[model]
        if not previous then records[model]={position=position,time=now,raw=raw,lastReliable=now};return raw end
        local dt=now-previous.time
        local delta=position-previous.position
        local old=previous.raw
        local lastReliable=previous.lastReliable or now
        previous.position=position;previous.time=now;previous.raw=raw
        local horizontal=raw.X*raw.X+raw.Z*raw.Z
        if horizontal>=0.01 then previous.lastReliable=now end
        if dt<1e-5 or dt>0.25 then return raw end
        if delta.Magnitude>math.max(8,raw.Magnitude*dt*3+2)then return raw end
        local oldHorizontal=old.X*old.X+old.Z*old.Z
        if horizontal<0.01 and oldHorizontal<0.01 and now-lastReliable>0.08 and delta.Magnitude>0.001 then
            return sane(delta/dt)
        end
        return raw
    end

    local function floorAt(model,root,now)
        local cached=floorCache[model]
        if cached and now-cached.time<.07 then
            local delta=root.Position-cached.position
            if delta.X*delta.X+delta.Z*delta.Z<2.25 and math.abs(delta.Y)<16 and(not cached.hit or cached.hit.Position.Y<=root.Position.Y+.25)then return cached.hit end
        end
        table.clear(filter)
        local own=G.Services.Players.LocalPlayer.Character
        if own then filter[#filter+1]=own end
        filter[#filter+1]=model
        if EntityCache then
            for _,list in ipairs({EntityCache.Players or {},EntityCache.NPCs or {}})do
                for _,character in ipairs(list)do if character~=own and character~=model then filter[#filter+1]=character end end
            end
        end
        floorParams.FilterDescendantsInstances=filter
        local hit=G.Services.Workspace:Raycast(root.Position+Vector3.new(0,0.25,0),Vector3.new(0,-1024,0),floorParams)
        floorCache[model]={position=root.Position,time=now,hit=hit}
        return hit
    end
    function api.Motion(model,part,velocity,now)
        velocity=sane(velocity)
        now=now or os.clock()
        local root=model and(model:FindFirstChild("HumanoidRootPart")or model.PrimaryPart)
        local humanoid=model and model:FindFirstChildOfClass("Humanoid")
        if not root then return velocity,0,nil end
        local gravity=G.Services.Workspace.Gravity or 196.2
        local hit=floorAt(model,root,now)
        local hip=humanoid and tonumber(humanoid.HipHeight)or 2
        local standing=math.max(.5,(hip or 2)+(root.Size and root.Size.Y or 2)/2)
        if humanoid and humanoid.RigType==Enum.HumanoidRigType.R6 then
            local leg=model:FindFirstChild("Left Leg")or model:FindFirstChild("Right Leg")
            standing=standing+(leg and leg.Size.Y or 2)
        end
        local platformY=0
        if hit and hit.Instance and hit.Instance:IsA("BasePart")then platformY=hit.Instance.AssemblyLinearVelocity.Y end
        local state=humanoid and humanoid:GetState()
        local nearFloor=hit and root.Position.Y-hit.Position.Y<=standing+.55
        local airborneState=state==Enum.HumanoidStateType.Jumping or state==Enum.HumanoidStateType.Freefall
        local grounded=humanoid and humanoid.FloorMaterial~=Enum.Material.Air and not airborneState and(not hit or nearFloor)or false
        if nearFloor and velocity.Y-platformY<=2.5 then grounded=true end
        if velocity.Y-platformY>8 or state==Enum.HumanoidStateType.Jumping then grounded=false end
        local context={FloorY=hit and(hit.Position.Y+standing+part.Position.Y-root.Position.Y)or nil,Mode="Ballistic"}

        local record=motionCache[model]
        local dt=record and(now-record.time)or 0
        local discontinuity=record and(root.Position-record.position).Magnitude>math.max(16,velocity.Magnitude*math.max(dt,0)*4+4)
        local jumpImpulse=record and dt>0 and velocity.Y-record.velocity.Y>math.max(state==Enum.HumanoidStateType.Jumping and 14 or 45,gravity*dt*2)
        local released=record and record.controlled and dt>.001 and velocity.Y-record.velocity.Y< -math.max(1,gravity*dt*.5)
        if not record or record.rootRef[1]~=root or dt>.3 or dt<0 or discontinuity or jumpImpulse or released then
            record={rootRef=setmetatable({root},{__mode="v"}),position=root.Position,time=now,velocity=velocity,samples={},candidate=nil,confidence=0}
            motionCache[model]=record;dt=0
        end
        if #record.samples==0 or dt>=.018 then
            local samples=record.samples
            while #samples>0 and now-samples[1].time>.2 do table.remove(samples,1)end
            samples[#samples+1]={position=root.Position,velocity=velocity,time=now}
            if #samples>12 then table.remove(samples,1)end
            record.position=root.Position;record.time=now;record.velocity=velocity
            local first=samples[1]
            local span=now-first.time
            record.acceleration=nil
            if span>=.1 then
                local sumT,sumV,sumTT,sumTV=0,0,0,0
                local zeroReported=true
                for _,sample in ipairs(samples)do
                    local t=sample.time-first.time
                    sumT+=t;sumV+=sample.velocity.Y;sumTT+=t*t;sumTV+=t*sample.velocity.Y
                    if sample.velocity.Magnitude>=.01 then zeroReported=false end
                end
                local denominator=#samples*sumTT-sumT*sumT
                local acceleration=denominator>1e-8 and(#samples*sumTV-sumT*sumV)/denominator or(velocity.Y-first.velocity.Y)/span
                local displacement=(root.Position-first.position)/span
                -- Anchored/CFrame-driven flight may report zero assembly velocity.
                -- Fit motion from root samples instead of treating it as stationary.
                if zeroReported and(root.Position-first.position).Magnitude>1 then
                    local middle=samples[math.floor((#samples+1)/2)]
                    local left=middle.time-first.time
                    local right=now-middle.time
                    if left>.02 and right>.02 then
                        local va=(middle.position-first.position)/left
                        local vb=(root.Position-middle.position)/right
                        acceleration=2*(vb.Y-va.Y)/(left+right)
                        velocity=sane(Vector3.new(vb.X,vb.Y+acceleration*right*.5,vb.Z))
                        record.derived=velocity
                    end
                else record.derived=nil end
                if finite(acceleration)then
                    local candidate
                    local matches=math.abs(displacement.Y-velocity.Y)<=math.max(6,gravity*span*.2)
                    if math.abs(acceleration)<=math.max(8,gravity*.08)and matches then candidate="Controlled"
                    elseif acceleration< -gravity*.1 and math.abs(acceleration+gravity)>gravity*.2 then candidate="ModifiedGravity"
                    elseif acceleration< -gravity*.1 then candidate="Ballistic"
                    elseif acceleration>gravity*.1 and state~=Enum.HumanoidStateType.Jumping then candidate="Powered"end
                    if candidate==record.candidate then record.confidence+=1 else record.candidate=candidate;record.confidence=1 end
                    if candidate and record.confidence>=3 then record.acceleration=math.clamp(acceleration,-gravity*3,gravity*2)end
                end
            end
        elseif record.derived and velocity.Magnitude<.01 and record.velocity.Magnitude<.01 then velocity=record.derived end

        if grounded then record.controlled=false;return Vector3.new(velocity.X,platformY,velocity.Z),0,nil end
        local forced=state==Enum.HumanoidStateType.Swimming or state==Enum.HumanoidStateType.Climbing or root.Anchored==true
        if type(root.FindFirstChildOfClass)=="function"then
            local body=root:FindFirstChildOfClass("BodyVelocity")
            if body and body.MaxForce and body.MaxForce.Y>0 then forced=true end
        end
        record.controlled=false
        if record.acceleration then
            if record.candidate=="Ballistic"then return velocity,gravity,context end
            if record.candidate=="ModifiedGravity"then context.Mode="ModifiedGravity";return velocity,math.max(0,-record.acceleration),context end
            if record.candidate=="Powered"then
                context.Mode="Powered";context.AccelerationY=record.acceleration;context.AccelerationHorizon=.35
                return velocity,0,context
            end
        end
        if forced or(record.candidate=="Controlled"and record.acceleration~=nil)then
            record.controlled=true;context.Mode="Controlled"
            return velocity,0,context
        end
        return velocity,gravity,context
    end

    function api.Intercept(origin,position,velocity,speed,gravity,life,targetGravity,latency,context)
        if not finite(speed)or speed<=0 or not finite(gravity)then return nil end
        velocity=sane(velocity)
        gravity=math.max(0,gravity)
        life=tonumber(life)or 3
        if not finite(life)or life<=0 then return nil end
        targetGravity=math.max(0,tonumber(targetGravity)or 0)
        latency=math.clamp(tonumber(latency)or 0,0,0.5)
        local floor=context and context.FloorY
        local function point(t)
            local total=t+latency
            local y=position.Y+velocity.Y*total-0.5*targetGravity*total*total
            if context and finite(context.AccelerationY)then
                local horizon=math.min(total,context.AccelerationHorizon or .35)
                y=position.Y+velocity.Y*total+context.AccelerationY*(horizon*total-.5*horizon*horizon)
            end
            if floor and y<floor then y=floor end
            return position.X+velocity.X*total,y,position.Z+velocity.Z*total
        end
        local function residual(t)
            local x,y,z=point(t)
            x=x-origin.X;y=y-origin.Y+0.5*gravity*t*t;z=z-origin.Z
            return x*x+y*y+z*z-speed*speed*t*t
        end
        local function launch(t)
            if t<=1e-7 or t>life then return nil end
            local x,y,z=point(t)
            local vector=Vector3.new(x-origin.X,y-origin.Y+0.5*gravity*t*t,z-origin.Z)/t
            if not finite(vector.Magnitude)or math.abs(vector.Magnitude-speed)*t>0.025 then return nil end
            return vector.Unit*speed,t,Vector3.new(x,y,z)
        end
        -- Most shots converge in a few iterations; check the final target position
        -- against that same flight time rather than returning a previous iterate.
        local time=0
        for _=1,10 do
            local x,y,z=point(time)
            local vector,nextTime=api.Static(origin,Vector3.new(x,y,z),speed,gravity)
            if not vector or nextTime>life then break end
            if math.abs(nextTime-time)<1e-5 then
                local result,t,aim=launch(nextTime)
                if result then return result,t,aim end
            end
            time=nextTime
        end
        -- Bounded scalar fallback for fast/receding targets or landing transitions.
        -- It finds the first low-arc sign crossing, never an arbitrary late iterate.
        local lo,hi=0,nil
        for i=1,40 do
            local t=life*(i/40)^2
            if residual(t)<=0 then hi=t;break end
            lo=t
        end
        if not hi then return nil end
        for _=1,25 do
            local middle=(lo+hi)/2
            if residual(middle)>0 then lo=middle else hi=middle end
        end
        return launch((lo+hi)/2)
    end
    FWNoModules.OnCleanup(function()table.clear(floorCache);table.clear(motionCache);table.clear(filter)end)
    return api
end
FWNoModules.ProjectilePrediction=FWNoModules.BuildProjectilePrediction()

function paSolve(O,T,v,g)
    return FWNoModules.ProjectilePrediction.Static(O,T,v,g)
end
function paAim(O,position,velocity,speed,gravity,life,targetGravity,context)
    return FWNoModules.ProjectilePrediction.Intercept(O,position,velocity,speed,gravity,life,targetGravity,PA_NET_LATENCY,context)
end

function paHasLOS(origin, model, rootPart)
	palos_char = Players.LocalPlayer.Character
	palos_tgt = rootPart
	if not palos_tgt and typeof(model) == "Instance" then
		palos_tgt = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or (model:IsA("BasePart") and model or nil)
	end
	if not palos_tgt then return false end
	palos_filter = {}
	if palos_char then table.insert(palos_filter, palos_char) end
	if typeof(model) == "Instance" then table.insert(palos_filter, model) end
	if typeof(rootPart) == "Instance" then table.insert(palos_filter, rootPart) end
	paWallParams.FilterDescendantsInstances = palos_filter
	palos_hit = G.Services.Workspace:Raycast(origin, palos_tgt.Position - origin, paWallParams)
	return palos_hit == nil
end

function paConsider(model, h, v, myPos)
	if not paHasLOS(myPos, model, h) then return end
	considerMode = ProjectileAura.Values["Mode"] or "Blatant"
	if considerMode ~= "Blatant" and considerMode ~= "Legit" then considerMode = "Blatant" end
	if considerMode == "Legit" then
		fovVal = ProjectileAura.Values["FOV"] or 150
		fovAng = 5 + (fovVal / 1000) * 175
		cosTh = math.cos(math.rad(fovAng))
		camPos = camera.CFrame.Position
		camDir = camera.CFrame.LookVector
		toT = h.Position - camPos
		if toT.Magnitude > 0.001 and camDir:Dot(toT.Unit) < cosTh then return end
	end
	pap_d = (myPos - h.Position).Magnitude
	if not pap_bd or pap_d < pap_bd then pap_best, pap_bd, pap_bh, pap_bv = model, pap_d, h, v end
end

function paPickTarget(myPos)
	pap_best, pap_bd, pap_bh, pap_bv = nil, nil, nil, nil
	if ProjectileAura.Values["Target Players"] then
		if EntityCache and EntityCache.Players then
			for _, pap_plChar in ipairs(EntityCache.Players) do
				if pap_plChar ~= Players.LocalPlayer.Character and not paIsTeammate(pap_plChar) then
					pap_h = pap_plChar:FindFirstChild("HumanoidRootPart")
					pap_hum = pap_plChar:FindFirstChildOfClass("Humanoid")
					if pap_h and pap_hum and pap_hum.Health > 0 then
						paConsider(pap_plChar, pap_h, pap_h.AssemblyLinearVelocity or pap_h.Velocity or Vector3.zero, myPos)
					end
				end
			end
		end
	end
	if ProjectileAura.Values["Target NPCs/Dummies"] then
		if EntityCache and EntityCache.NPCs then
			for _, pap_m in ipairs(EntityCache.NPCs) do
				pap_h = pap_m:FindFirstChild("HumanoidRootPart") or pap_m.PrimaryPart
				pap_hum = pap_m:FindFirstChildOfClass("Humanoid")
				if pap_h and pap_hum and pap_hum.Health > 0 then
					paConsider(pap_m, pap_h, pap_h.AssemblyLinearVelocity or pap_h.Velocity or Vector3.zero, myPos)
				end
			end
		end
	end
	return pap_best, pap_bh, pap_bv
end

function paSpawnVisual(pProj, pPm, pO, pVel, pG)
	if #PA_VIS >= PA_MAX_VIS then return end
	pas_modelName = (pPm and pPm.projectileModel) or pProj
	pas_srcRoot = paItems and paItems:FindFirstChild(pas_modelName)
	if not pas_srcRoot then return end

	if pas_srcRoot:IsA("Accessory") then
		pas_src = pas_srcRoot:FindFirstChild("Handle")
	else
		pas_src = pas_srcRoot
	end
	if not pas_src then return end

	pas_clone = FWNoModules.OwnInstance(pas_src:Clone())
	pas_clone.Parent = G.Services.Workspace

	if pas_clone:IsA("BasePart") then
		pas_mover = pas_clone; pas_isModel = false
	elseif pas_clone:IsA("Model") then
		pas_isModel = true
		pas_mover = pas_clone.PrimaryPart
		if not pas_mover then
			pas_clone.PrimaryPart = pas_clone:FindFirstChildWhichIsA("BasePart")
			pas_mover = pas_clone.PrimaryPart
		end
	else
		pas_clone:Destroy()
		return
	end

	if not pas_mover then pas_clone:Destroy() return end

	if pas_mover:IsA("BasePart") then
		pas_mover.Anchored = true
		pas_mover.CanCollide = false
		pas_mover.CanQuery = false
		pas_mover.CanTouch = false
	end

	-- ============================================================
	-- CRITICAL FIX: FORCE TRAIL COLOR ON CLONED PROJECTILES
	-- ============================================================
	-- ============================================================
	-- CRITICAL FIX: FORCE TRAIL COLOR ON CLONED PROJECTILES
	-- ============================================================
	if loops["projectile tracers"] then
		targetPart = pas_clone:FindFirstChild("Handle") or pas_mover

		if targetPart then
			-- 1. SAFELY CONVERT COLOR (Handles Color3, {R,G,B} tables, and nil)
			rawColor = ProjectileTracers.Values["Color"]
			safeColor = Color3.fromRGB(255, 255, 255) -- Default white

			if typeof(rawColor) == "Color3" then
				safeColor = rawColor
			elseif type(rawColor) == "table" then
				-- Config saves Color3 as {R=0-1, G=0-1, B=0-1}
				local r = tonumber(rawColor.R) or 1
				local g = tonumber(rawColor.G) or 1
				local b = tonumber(rawColor.B) or 1
				-- Check if values are 0-1 floats or 0-255 integers
				if r <= 1 and g <= 1 and b <= 1 then
					safeColor = Color3.fromRGB(r * 255, g * 255, b * 255)
				else
					safeColor = Color3.fromRGB(r, g, b)
				end
			end

			glowEnabled = ProjectileTracers.Values["Glow"]
			glowIntensity = tonumber(ProjectileTracers.Values["Glow Intensity"]) or 1

			-- 2. FIND THE TRAIL
			trail = targetPart:FindFirstChildWhichIsA("Trail")

			if trail then
				-- FORCE APPLY: Strip texture so solid color shows, and set ColorSequence
				trail.Texture = "" 
				trail.Color = ColorSequence.new(safeColor)
				trail.LightEmission = glowEnabled and glowIntensity or 0
				trail.LightInfluence = glowEnabled and 0 or 1
				trail.Transparency = NumberSequence.new(0, 1)
				trail.Enabled = true
			else
				-- 3. CREATE TRAIL IF MISSING
				a0 = targetPart:FindFirstChild("TrailAttachment0") or targetPart:FindFirstChild("Attachment0")
				a1 = targetPart:FindFirstChild("TrailAttachment1") or targetPart:FindFirstChild("Attachment1")

				if not a0 then
					a0 = FWNoModules.OwnInstance(Instance.new("Attachment"))
					a0.Name = "TrailAttachment0"
					a0.Position = Vector3.new(0, 0, 0)
					a0.Parent = targetPart
				end
				if not a1 then
					a1 = FWNoModules.OwnInstance(Instance.new("Attachment"))
					a1.Name = "TrailAttachment1"
					a1.Position = Vector3.new(0, 0, -1.5)
					a1.Parent = targetPart
				end

				newTrail = FWNoModules.OwnInstance(Instance.new("Trail"))
				newTrail.Attachment0 = a0
				newTrail.Attachment1 = a1
				newTrail.Texture = ""
				newTrail.Color = ColorSequence.new(safeColor)
				newTrail.LightEmission = glowEnabled and glowIntensity or 0
				newTrail.Lifetime = 0.4
				newTrail.WidthScale = NumberSequence.new(1, 0)
				newTrail.Transparency = NumberSequence.new(0, 1)
				newTrail.Enabled = true
				newTrail.Parent = targetPart
			end

			-- 4. COLOR THE HANDLE/PART AND MAKE NEON
			if targetPart:IsA("BasePart") then
				targetPart.Color = safeColor
				if glowEnabled then
					targetPart.Material = Enum.Material.Neon
				end
			end
		end
	end
	-- ============================================================
	-- ============================================================

	pas_dir = pVel.Magnitude > 0 and pVel.Unit or Vector3.new(0,1,0)
	pas_fr = (pPm and pPm.flightRotation) or Vector3.new(0,0,0)
	pas_fix = CFrame.new()

	if paIsSpearVisual(pProj) and pas_mover:IsA("BasePart") then
		pas_sz = pas_mover.Size
		if pas_sz.X >= pas_sz.Y and pas_sz.X >= pas_sz.Z then pas_fix = paAxisFix(Vector3.new(1,0,0))
		elseif pas_sz.Y >= pas_sz.Z then pas_fix = paAxisFix(Vector3.new(0,1,0))
		else pas_fix = paAxisFix(Vector3.new(0,0,1)) end
	end

	pas_cf = CFrame.lookAt(pO, pO + pas_dir) * pas_fix * CFrame.Angles(pas_fr.X, pas_fr.Y, pas_fr.Z)
	if pas_isModel then pas_clone:PivotTo(pas_cf) else pas_mover.CFrame = pas_cf end

	table.insert(PA_VIS, { obj = pas_clone, mover = pas_mover, isModel = pas_isModel, O = pO, V = pVel, g = pG, fr = pas_fr, t0 = tick(), life = (pPm and pPm.lifetimeSec) or 2 })
end

function paDoShot(pL, pO, pSpawnO, pVel, pT, pTgt, pG, pProj, pPm, pFid, pSid)
	pae_curName = paGetHeldName()
	pae_curInst = pae_curName and paInv and paInv:FindFirstChild(pae_curName) or nil
	if pae_curInst and not paIsManaged(pae_curInst) then paSavedHand = pae_curInst end
	if pae_curInst ~= pL.weapon and paSetInv then
		pcall(function() paSetInv:InvokeServer({ hand = pL.weapon }) end)
	end

	-- ======= RE-AIM WITH FRESH DATA =======
	-- The hand swap above may have yielded 50-200ms.
	-- Re-read target position/velocity so we aim where they ARE, not where they WERE.
	local pae_freshHrp = typeof(pTgt) == "Instance" and pTgt.Parent and pTgt:FindFirstChild("HumanoidRootPart")
	local pae_freshChar = Players.LocalPlayer.Character
	local pae_freshMyPart = pae_freshChar and pae_freshChar:FindFirstChild("HumanoidRootPart")
    if typeof(pTgt)=="Instance" and (not pae_freshHrp or not pae_freshMyPart)then return end
    if pae_freshHrp and pae_freshMyPart then
        if not paHasLOS(pae_freshMyPart.Position,pTgt,pae_freshHrp)then return end
        local pae_freshHum = pTgt:FindFirstChildOfClass("Humanoid")
        if pae_freshHum and pae_freshHum.Health<=0 then return end
        if pae_freshHum and pae_freshHum.Health > 0 then
            local pae_freshMyPos = pae_freshMyPart.Position
			local pae_freshSpawnO = pae_freshMyPos - PA_HAND_OFFSET
			local pae_freshVel = pae_freshHrp.AssemblyLinearVelocity or pae_freshHrp.Velocity or Vector3.zero

            local pae_lead,pae_tgtG,pae_motion=FWNoModules.ProjectilePrediction.Motion(pTgt,pae_freshHrp,pae_freshVel,tick())

			local pae_launchVel = (pPm and pPm.launchVelocity) or 100
			local pae_life = (pPm and pPm.lifetimeSec) or 3

			local pae_newVt, pae_newT = paAim(pae_freshSpawnO, pae_freshHrp.Position, pae_lead, pae_launchVel, pG, pae_life, pae_tgtG,pae_motion)
			if pae_newVt then
				pO = pae_freshMyPos
				pSpawnO = pae_freshSpawnO
				pVel = pae_newVt
                pT = pae_newT
            else return end 
		end
	end
	-- ======= END RE-AIM =======

	pae_draw = (pL.kind == "throw") and (pL.maxCharge or 0) or PA_FULL_DRAW
	paf_ok = pcall(function()
		return paFire:InvokeServer(pL.weapon, pL.ammo, pL.projectile,
			vec3(pO.X, pO.Y, pO.Z),
			vec3(pSpawnO.X, pSpawnO.Y, pSpawnO.Z),
			vec3(pVel.X, pVel.Y, pVel.Z),
			pFid, { shotId = pSid, drawDurationSec = pae_draw },
			G.Services.Workspace:GetServerTimeNow())
	end)
	if paf_ok then
		paLastShot = tick()
		paf_tr = paPlayAnim(pL.fireAnim)
		if paf_tr and paf_tr.Length then paFireAnimDone = tick() + paf_tr.Length end
		paPlaySound(pL.launchSnd)
		for paf_k = 1, #PA_HIT_TAPS do
			paf_at = math.max(0, math.min(pT + PA_HIT_TAPS[paf_k], 3))
			task.delay(paf_at, function() pcall(function() paHit:FireServer(pFid, pTgt) end) end)
		end
		paSpawnVisual(pProj, pPm, pSpawnO, pVel, pG)
	end
end

function paFireShot(L, O, spawnO, vel, t, target, g, projName, pm)
	paf_fireId, paf_shotId = paGenId(), paGenId()
	task.spawn(paDoShot, L, O, spawnO, vel, t, target, g, projName, pm, paf_fireId, paf_shotId)
end

function paVisTick()
	pav_now = tick(); pav_i = 1
	while pav_i <= #PA_VIS do
		pav_e = PA_VIS[pav_i]; pav_t = pav_now - pav_e.t0
		if pav_t >= pav_e.life or not pav_e.obj.Parent then
			pcall(function() pav_e.obj:Destroy() end); table.remove(PA_VIS, pav_i)
		else
			pav_p = pav_e.O + pav_e.V*pav_t + Vector3.new(0, -0.5*pav_e.g*pav_t*pav_t, 0)
			pav_cv = pav_e.V + Vector3.new(0, -pav_e.g*pav_t, 0)
			pav_d = pav_cv.Magnitude > 0.001 and pav_cv.Unit or Vector3.new(0,1,0)
			pav_cf = CFrame.lookAt(pav_p, pav_p + pav_d) * CFrame.Angles(pav_e.fr.X, pav_e.fr.Y, pav_e.fr.Z)
			if pav_e.isModel then pav_e.obj:PivotTo(pav_cf) else pav_e.mover.CFrame = pav_cf end
			pav_i = pav_i + 1
		end
	end
end

ProjectileAura.Callbacks.OnToggle = function(state)
	loops["projectile aura"] = state
	if not state then
		if PA_VIS_CONN then PA_VIS_CONN:Disconnect(); PA_VIS_CONN = nil end
		for _, pa_e in ipairs(PA_VIS) do pcall(function() pa_e.obj:Destroy() end) end
		PA_VIS = {}
		paRestoreHand()
		paSavedHand = nil
		paLastShot = 0
		PA_MANAGED = {}
		PA_RR = 0
		paLockedSpeed = nil
		PA_BLATANT_COOLDOWNS = {}
		char = Players.LocalPlayer.Character
		hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum and originalWalkSpeed then hum.WalkSpeed = originalWalkSpeed end
		paUpdateLegitTracer(nil, nil, false)
		if PA_LEGIT_TRACER_BEAM then pcall(function() PA_LEGIT_TRACER_BEAM:Destroy() end); PA_LEGIT_TRACER_BEAM = nil end
		if PA_LEGIT_TRACER_ATTACH then pcall(function() PA_LEGIT_TRACER_ATTACH:Destroy() end); PA_LEGIT_TRACER_ATTACH = nil end
		if PA_LEGIT_TRACER_A1 then pcall(function() PA_LEGIT_TRACER_A1:Destroy() end); PA_LEGIT_TRACER_A1 = nil end
		return
	end

	char = Players.LocalPlayer.Character
	hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then originalWalkSpeed = hum.WalkSpeed end

	if not PA_VIS_CONN then PA_VIS_CONN = FWNoModules.TrackFrameConnection(G.Services.RunService.Heartbeat:Connect(paVisTick)) end
	paSavedHand = nil
	paLastShot = 0
	PA_RR = 0
	paLockedSpeed = nil
	PA_BLATANT_COOLDOWNS = {}
	isCharging = false
	drawTrack = nil
	chargeStartTime = 0
	nextShotTime = 0
	lastHeldName = nil
	lastSwapTime = 0

	task.spawn(function()
		while loops["projectile aura"] do
			if paSavedHand and paLastShot and tick() - paLastShot > 0.35 then paRestoreHand() end

			char = Players.LocalPlayer.Character
			hum = char and char:FindFirstChildOfClass("Humanoid")
			PAmode = ProjectileAura.Values["Mode"] or "Blatant"

			if PAmode ~= "Blatant" and PAmode ~= "Legit" then
				PAmode = "Blatant"
				ProjectileAura.Values["Mode"] = "Blatant"
				if ProjectileAura.UpdateFunctions and ProjectileAura.UpdateFunctions["Mode"] then
					pcall(function() ProjectileAura.UpdateFunctions["Mode"]("Blatant") end)
				end
			end

			if not (ProjectileAura.Values["Target Players"] or ProjectileAura.Values["Target NPCs/Dummies"]) then
				if isCharging then
					isCharging = false
					if drawTrack then pcall(function() drawTrack:Stop() end); drawTrack = nil end
					paUpdateLegitTracer(nil, nil, false)
					if hum then hum.WalkSpeed = originalWalkSpeed end
				end
				G.Services.RunService.Heartbeat:Wait()
			else
				if loops["killaura"] and currentKaTarget and currentKaTarget.Parent then
					kaTgtHRP = currentKaTarget:FindFirstChild("HumanoidRootPart") or currentKaTarget.PrimaryPart
					kaMyHRP = char and char:FindFirstChild("HumanoidRootPart")
					if kaTgtHRP and kaMyHRP then
						kaDist = (kaMyHRP.Position - kaTgtHRP.Position).Magnitude
						kaReach = tonumber(Killaura.Values["Reach"]) or 12.4
						if kaDist <= kaReach + 2 then
							G.Services.RunService.Heartbeat:Wait()
							continue
						end
					end
				end

				if tick() - PA_REBUILT > 0.5 then PA_REBUILT = tick(); paBuildLoadouts() end
				pa_myPart = char and char:FindFirstChild("HumanoidRootPart")
				pa_myPos = pa_myPart and pa_myPart.Position

				if not pa_myPos then
					if isCharging then
						isCharging = false
						if drawTrack then pcall(function() drawTrack:Stop() end); drawTrack = nil end
						paUpdateLegitTracer(nil, nil, false)
						if hum then hum.WalkSpeed = originalWalkSpeed end
					end
					G.Services.RunService.Heartbeat:Wait()
				else
					pa_target, pa_hrp, pa_vel = paPickTarget(pa_myPos)
					pa_n = #PA_LOADOUTS
					now = tick()

					if not pa_target or not pa_hrp or pa_n == 0 then
						if isCharging then
							isCharging = false
							if drawTrack then pcall(function() drawTrack:Stop() end); drawTrack = nil end
							paUpdateLegitTracer(nil, nil, false)
							if hum then hum.WalkSpeed = originalWalkSpeed end
						end
						G.Services.RunService.Heartbeat:Wait()
					else
                        local pa_motion
                        pa_lead,pa_tgtG,pa_motion=FWNoModules.ProjectilePrediction.Motion(pa_target,pa_hrp,pa_vel,now)

						if PAmode == "Legit" then
							heldName = paGetHeldName()
							currentLoadout = nil
							if heldName then
								for _, L in ipairs(PA_LOADOUTS) do
									if L.weapon.Name == heldName then currentLoadout = L break end
								end
							end

							if heldName ~= lastHeldName then
								lastHeldName = heldName
								lastSwapTime = now
								if heldName and heldName:find("frost_staff") then paForceFrostProjectile() end
								if isCharging then
									isCharging = false
									if drawTrack then pcall(function() drawTrack:Stop() end); drawTrack = nil end
									paUpdateLegitTracer(nil, nil, false)
									if hum then hum.WalkSpeed = originalWalkSpeed end
								end
							end

							if not currentLoadout then
								if isCharging then
									isCharging = false
									if drawTrack then pcall(function() drawTrack:Stop() end); drawTrack = nil end
									paUpdateLegitTracer(nil, nil, false)
									if hum then hum.WalkSpeed = originalWalkSpeed end
								end
								G.Services.RunService.Heartbeat:Wait()
							else
								if paHasAmmo(currentLoadout) and now - lastSwapTime >= 0.01 and now - lastShotTime >= (currentLoadout.fireDelay + 0.02) and (not paIsSpearVisual(currentLoadout.projectile) or now >= paFireAnimDone + 0.15) then
									pa_pm = PA_PROJ_META[currentLoadout.projectile] or PA_PROJ_META[currentLoadout.weapon.Name] or {}
									lg_launchVel = pa_pm.launchVelocity or 100
									lg_grav = pa_pm.gravitationalAcceleration or (paIsStraight(currentLoadout.projectile) and 0 or 196.2)
									lg_life = pa_pm.lifetimeSec or 3

									if not isCharging then
										isCharging = true
										chargeStartTime = now
										paChargeAnimLen = 0
										paLockedSpeed = originalWalkSpeed * (currentLoadout.speedMult or 0.6)
										paPlaySound(currentLoadout.chargeSnd)
										drawTrack = paPlayAnim(currentLoadout.drawAnim)
										if drawTrack and drawTrack.Length then paChargeAnimLen = drawTrack.Length end
										paUpdateLegitTracer(nil, nil, false)
										if hum then hum.WalkSpeed = paLockedSpeed end
									end

									if isCharging and hum then hum.WalkSpeed = paLockedSpeed end
									if isCharging then
										pa_chargeSpawnO = pa_myPos - PA_HAND_OFFSET
										pa_chargeVt, _ = paAim(pa_chargeSpawnO, pa_hrp.Position, pa_lead, lg_launchVel, lg_grav, lg_life, pa_tgtG,pa_motion)
										if pa_chargeVt then
											paUpdateLegitTracer(pa_chargeSpawnO, pa_chargeVt, true)
										else
											paUpdateLegitTracer(nil, nil, false)
										end
									end

									pa_spawnO = pa_myPos - PA_HAND_OFFSET
									pa_vt, pa_t = paAim(pa_spawnO, pa_hrp.Position, pa_lead, lg_launchVel, lg_grav, lg_life, pa_tgtG,pa_motion)

									if pa_vt then
										paUpdateLegitTracer(pa_spawnO, pa_vt, true)
									else
										paUpdateLegitTracer(nil, nil, false)
									end

									if now - chargeStartTime >= math.max(currentLoadout.maxCharge or 0, paChargeAnimLen) then
										if pa_vt then
											verifyHeld = paGetHeldName()
											if verifyHeld ~= currentLoadout.weapon.Name then
												if drawTrack then pcall(function() drawTrack:Stop() end); drawTrack = nil end
												paUpdateLegitTracer(nil, nil, false)
												isCharging = false
												paLockedSpeed = nil
												if hum then hum.WalkSpeed = originalWalkSpeed end
											else
												paUpdateLegitTracer(pa_spawnO, pa_vt, true)
												paFireShot(currentLoadout, pa_myPos, pa_spawnO, pa_vt, pa_t, pa_target, lg_grav, currentLoadout.projectile, pa_pm)
												lastShotTime = now
												if drawTrack then pcall(function() drawTrack:Stop() end); drawTrack = nil end
												paUpdateLegitTracer(nil, nil, false)
												isCharging = false
												paLockedSpeed = nil
												if hum then hum.WalkSpeed = originalWalkSpeed end
											end
										elseif now - chargeStartTime > (currentLoadout.maxCharge or 0) + 1.5 then
											if drawTrack then pcall(function() drawTrack:Stop() end); drawTrack = nil end
											paUpdateLegitTracer(nil, nil, false)
											isCharging = false
											paLockedSpeed = nil
											chargeStartTime = now
											if hum then hum.WalkSpeed = originalWalkSpeed end
										end
									end
								else
									if isCharging then
										isCharging = false
										if drawTrack then pcall(function() drawTrack:Stop() end); drawTrack = nil end
										paUpdateLegitTracer(nil, nil, false)
										if hum then hum.WalkSpeed = originalWalkSpeed end
									end
								end
							end
						else
							pa_idx = (PA_RR % pa_n) + 1
							pa_L = PA_LOADOUTS[pa_idx]

							if paHasAmmo(pa_L) then
								pa_cdKey = pa_L.weapon.Name .. "_" .. pa_L.projectile
								pa_cdEnd = PA_BLATANT_COOLDOWNS[pa_cdKey] or 0

								if now >= pa_cdEnd then
									pa_spawnO = pa_myPos - PA_HAND_OFFSET
									pa_pm = PA_PROJ_META[pa_L.projectile] or PA_PROJ_META[pa_L.weapon.Name] or {}
									bl_launchVel = pa_pm.launchVelocity or 100
									bl_grav = pa_pm.gravitationalAcceleration or (paIsStraight(pa_L.projectile) and 0 or 196.2)
									bl_life = pa_pm.lifetimeSec or 3

									pa_vt, pa_t = paAim(pa_spawnO, pa_hrp.Position, pa_lead, bl_launchVel, bl_grav, bl_life, pa_tgtG,pa_motion)

									if pa_vt and paHasLOS(pa_myPos, pa_target, pa_hrp) then
										heldNameB = paGetHeldName()
										if heldNameB ~= pa_L.weapon.Name then
											if pa_L.weapon.Name:find("frost_staff") then paForceFrostProjectile() end
											pcall(function() paSetInv:InvokeServer({ hand = pa_L.weapon }) end)
										end
										paFireShot(pa_L, pa_myPos, pa_spawnO, pa_vt, pa_t, pa_target, bl_grav, pa_L.projectile, pa_pm)
										PA_BLATANT_COOLDOWNS[pa_cdKey] = now + (pa_L.fireDelay or 0.6)
										PA_RR = pa_idx
									else
										PA_RR = pa_idx
									end
								else
									PA_RR = pa_idx
								end
							else
								PA_RR = pa_idx
							end
						end
					end
				end

				G.Services.RunService.Heartbeat:Wait()
			end
		end
	end)
end
