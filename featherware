		local posData = _G.SavedConfig[catPosID]
		frame.Position = UDim2.new(posData.XS, posData.XO, posData.YS, posData.YO)
	else
		frame.Position = UDim2.new(0.25, 0, 0.1, 0)
	end

	frame.BackgroundColor3 = Color3.fromRGB(26, 26, 26)
	frame.BorderSizePixel = 0
	frame.Visible = savedVisibility
	catBtn.TextColor3 = savedVisibility and Color3.fromRGB(78, 173, 73) or Color3.new(1, 1, 1)

	uiCorner(frame, 8)
	makeDraggable(frame)

	glow:Clone().Parent = frame
	uiStroke:Clone().Parent = frame

	local fTitleFrame = titleFrame:Clone()
	fTitleFrame.Parent = frame
	fTitleFrame:ClearAllChildren()
	uiCorner(fTitleFrame, 8)

	local fTitleBottomHider = titleBottomHider:Clone()
	fTitleBottomHider.Parent = fTitleFrame

	local fTitle = title:Clone()
	fTitle.Parent = fTitleFrame
	fTitle.Text = name
	fTitle.Position = UDim2.new(0, 15, 0, 0)
	fTitle.Size = UDim2.new(1, -15, 1, 0)

	local fScroll = Instance.new("ScrollingFrame", frame)
	fScroll.Size = UDim2.new(1, 0, 1, -45)
	fScroll.Position = UDim2.new(0, 0, 0, 40)
	fScroll.BackgroundTransparency = 1
	fScroll.ScrollBarThickness = 0
	fScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	local fLayout = Instance.new("UIListLayout", fScroll)
	fLayout.Padding = UDim.new(0, 2)

	catBtn.MouseButton1Click:Connect(function()
		frame.Visible = not frame.Visible
		catBtn.TextColor3 = frame.Visible and Color3.fromRGB(78, 173, 73) or Color3.new(1, 1, 1)

		_G.SavedConfig[catVisID] = frame.Visible
		saveConfigToPC()
	end)

	frame:GetPropertyChangedSignal("Position"):Connect(function()
		local currentPos = frame.Position
		_G.SavedConfig[catPosID] = {
			XS = currentPos.X.Scale,
			XO = currentPos.X.Offset,
			YS = currentPos.Y.Scale,
			YO = currentPos.Y.Offset
		}
		saveConfigToPC()
	end)

	function category:CreateButton(btnName, callback, allowHotkey, ClosetButton)
		local toggleID = name .. "_" .. btnName .. "_MainToggle"
		local hotkeyID = name .. "_" .. btnName .. "_Hotkey"

		local startingToggleState = _G.SavedConfig[toggleID] or false
		_G.SavedConfig[toggleID] = startingToggleState

		local mod = {
			Toggled = startingToggleState,
			Values = {},
			Callbacks = {},
			UpdateFunctions = {}
		}
		_G.__FW_ALL_MODULES = _G.__FW_ALL_MODULES or {}
		table.insert(_G.__FW_ALL_MODULES, mod)

		local container = Instance.new("Frame", fScroll)
		container.Size = UDim2.new(1, 0, 0, 32)
		container.BackgroundTransparency = 1
		container.AutomaticSize = Enum.AutomaticSize.Y
		local cLayout = Instance.new("UIListLayout", container)
		cLayout.SortOrder = Enum.SortOrder.LayoutOrder

		local btn = Instance.new("TextButton", container)
		btn.Name = btnName
		btn.Text = "" 
		btn.Size = UDim2.new(1, 0, 0, 32)
		btn.BackgroundColor3 = Color3.fromRGB(39, 39, 39)
		btn.BackgroundTransparency = 1
		btn.LayoutOrder = 1

		loops[string.lower(btnName)] = startingToggleState

		-- INSTANTLY UPDATE MODULE LIST ON INJECTION
		if _G.__FW_REFRESH_MODULE_LIST then
			_G.__FW_REFRESH_MODULE_LIST()
		end

		local leftContainer = Instance.new("Frame", btn)

		local leftContainer = Instance.new("Frame", btn)
		leftContainer.Size = UDim2.new(1, -75, 1, 0)
		leftContainer.BackgroundTransparency = 1

		local leftPadding = Instance.new("UIPadding", leftContainer)
		leftPadding.PaddingLeft = UDim.new(0, 12)

		local listLayout = Instance.new("UIListLayout", leftContainer)
		listLayout.FillDirection = Enum.FillDirection.Horizontal
		listLayout.VerticalAlignment = Enum.VerticalAlignment.Center
		listLayout.SortOrder = Enum.SortOrder.LayoutOrder
		listLayout.Padding = UDim.new(0, 8)

		local nameScroll = Instance.new("ScrollingFrame", leftContainer)
		nameScroll.BackgroundTransparency = 1
		nameScroll.ScrollBarThickness = 0
		nameScroll.ClipsDescendants = true
		nameScroll.Active = false
		nameScroll.LayoutOrder = 1

		local nameLabel = Instance.new("TextLabel", nameScroll)
		nameLabel.Text = btnName
		nameLabel.Size = UDim2.new(0, 0, 1, 0)
		nameLabel.AutomaticSize = Enum.AutomaticSize.X
		nameLabel.BackgroundTransparency = 1
		nameLabel.TextYAlignment = Enum.TextYAlignment.Center 
		nameLabel.TextColor3 = startingToggleState and Color3.fromRGB(78, 173, 73) or Color3.new(1, 1, 1)
		nameLabel.FontFace = Font.fromName(textFont)
		nameLabel.TextSize = 22

		local closetDecision = ClosetButton == true
		local closetBtn

		if closetDecision then
			closetBtn = Instance.new("TextButton")
			closetBtn.Parent = leftContainer
			closetBtn.Name = "ClosetBtn"
			closetBtn.Size = UDim2.new(0, 52, 0, 18)
			closetBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
			closetBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
			closetBtn.Text = "CLOSET"
			closetBtn.FontFace = Font.fromName(textFont)
			closetBtn.TextSize = 10
			closetBtn.LayoutOrder = 2

			Instance.new("UICorner", closetBtn).CornerRadius = UDim.new(0, 4)

			local stroke = Instance.new("UIStroke", closetBtn)
			stroke.Color = Color3.fromRGB(70, 70, 70)
			stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		end

		local function updateLayout()
			local textWidth = nameLabel.TextBounds.X
			local maxTextWidth = leftContainer.AbsoluteSize.X

			if closetBtn then
				maxTextWidth -= closetBtn.AbsoluteSize.X + listLayout.Padding.Offset
			end

			if textWidth <= maxTextWidth then
				nameScroll.Size = UDim2.new(0, textWidth, 1, 0)
			else
				nameScroll.Size = UDim2.new(0, maxTextWidth, 1, 0)
			end
			nameScroll.CanvasSize = UDim2.new(0, textWidth, 0, 0)
		end

		nameLabel:GetPropertyChangedSignal("TextBounds"):Connect(updateLayout)
		leftContainer:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateLayout)
		task.defer(updateLayout)

		local isHovering = false
		btn.MouseEnter:Connect(function()
			isHovering = true
			tween(btn, {BackgroundTransparency = 0})

			if nameScroll.CanvasSize.X.Offset > nameScroll.AbsoluteSize.X then
				task.spawn(function()
					while isHovering do
						local maxScroll = nameScroll.CanvasSize.X.Offset - nameScroll.AbsoluteSize.X + 10
						tween(nameScroll, {CanvasPosition = Vector2.new(maxScroll, 0)}, 2)
						task.wait(2.5)
						if not isHovering then break end
						tween(nameScroll, {CanvasPosition = Vector2.new(0, 0)}, 1)
						task.wait(1)
					end
				end)
			end
		end)

		btn.MouseLeave:Connect(function()
			isHovering = false
			tween(btn, {BackgroundTransparency = 1})
			tween(nameScroll, {CanvasPosition = Vector2.new(0, 0)}, 0.2)
		end)

		local function setToggleState(state)
			if mainScreenUI and mainScreenUI:GetAttribute("Running") then
				mod.Toggled = state
				nameLabel.TextColor3 = state and Color3.fromRGB(78, 173, 73) or Color3.new(1, 1, 1)
				loops[string.lower(btnName)] = state

				-- INSTANTLY UPDATE MODULE LIST (Event-Driven)
				if _G.__FW_REFRESH_MODULE_LIST then
					_G.__FW_REFRESH_MODULE_LIST()
				end

				pcall(NotificationSystem.Notify, btnName, state and "Toggled On" or "Toggled Off", 2)

				_G.SavedConfig[toggleID] = state
				pcall(saveConfigToPC)

				task.spawn(function()
					if callback then pcall(callback, state) end
					if mod.Callbacks.OnToggle then pcall(mod.Callbacks.OnToggle, state) end
				end)
			end
		end

		task.spawn(function()
			if startingToggleState then
				if not game:IsLoaded() then game.Loaded:Wait() end
				local char = Player.Character or Player.CharacterAdded:Wait()
				if not char:FindFirstChild("HumanoidRootPart") then
					char:WaitForChild("HumanoidRootPart", 5)
				end
				task.wait(0.5) 
				if callback then pcall(callback, true) end
				if mod.Callbacks.OnToggle then pcall(mod.Callbacks.OnToggle, true) end
			end
		end)

		local arrow = Instance.new("TextButton", btn)
		arrow.Text = "<b>></b>"
		arrow.RichText = true
		arrow.Size = UDim2.new(0, 30, 1, 0)
		arrow.Position = UDim2.new(1, -30, 0, 0)
		arrow.BackgroundTransparency = 1
		arrow.TextColor3 = Color3.fromRGB(130, 130, 130)
		arrow.FontFace = Font.fromName(textFont)
		arrow.TextSize = 20

		if allowHotkey then
			local savedKeyName = _G.SavedConfig[hotkeyID]
			local bindLabel = Instance.new("TextButton", btn)
			bindLabel.Size = UDim2.new(0, 35, 1, 0)
			bindLabel.Position = UDim2.new(1, -70, 0, 0)
			bindLabel.BackgroundTransparency = 1
			bindLabel.Text = savedKeyName and ("[" .. savedKeyName .. "]") or "[ - ]"
			bindLabel.TextColor3 = Color3.fromRGB(120, 120, 120)
			bindLabel.FontFace = Font.fromName(textFont)
			bindLabel.TextSize = 16

			local isBinding = false
			bindLabel.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton2 then
					_G.SavedConfig[hotkeyID] = nil
					bindLabel.Text = "[ - ]"
					saveConfigToPC()
					return
				end

				if input.UserInputType == Enum.UserInputType.MouseButton1 then
					isBinding = true
					_G.IsBindingKey = true
					bindLabel.Text = "[...]"
				end
			end)

			UserInputService.InputBegan:Connect(function(input, GPE)
				if isBinding and input.UserInputType == Enum.UserInputType.Keyboard then
					isBinding = false
					local key = input.KeyCode
					if key == Enum.KeyCode.Backspace or key == Enum.KeyCode.Escape then
						_G.SavedConfig[hotkeyID] = nil
						bindLabel.Text = "[ - ]"
					else
						_G.SavedConfig[hotkeyID] = key.Name
						bindLabel.Text = "[" .. key.Name .. "]"
					end
					saveConfigToPC()
					task.defer(function() _G.IsBindingKey = false end)

				elseif not GPE and not _G.IsBindingKey then
					-- Checks the values table directly rather than reading an alternative local variable 
					local configuredKeyName = _G.SavedConfig[hotkeyID]
					if configuredKeyName and input.KeyCode == Enum.KeyCode[configuredKeyName] then
						if mainScreenUI and mainScreenUI:GetAttribute("Running") == true then
							setToggleState(not mod.Toggled)
						end
					end
				end

				_G.__FW_PANIC_REG = _G.__FW_PANIC_REG or {}
				_G.__FW_PANIC_REG[btnName] = _G.__FW_PANIC_REG[btnName] or {}
				_G.__FW_PANIC_REG[btnName].resetKey = function()
					_G.SavedConfig[hotkeyID] = nil
					bindLabel.Text = "[ - ]"
					pcall(saveConfigToPC)
				end
			end)
		end

		local settingsCont = Instance.new("Frame", container)
		settingsCont.Size = UDim2.new(1, 0, 0, 0)
		settingsCont.BackgroundTransparency = 1
		settingsCont.Visible = false
		settingsCont.AutomaticSize = Enum.AutomaticSize.Y
		settingsCont.LayoutOrder = 2
		local sLayout = Instance.new("UIListLayout", settingsCont)
		sLayout.SortOrder = Enum.SortOrder.LayoutOrder

		btn.MouseButton1Click:Connect(function()
			if _G.__FW_NO_TOGGLE and _G.__FW_NO_TOGGLE[btnName] then return end
			setToggleState(not mod.Toggled)
		end)

		arrow.MouseButton1Click:Connect(function()
			if #settingsCont:GetChildren() == 1 then
				NotificationSystem.Notify("Settings", "None are available sorry!", 1)
			else
				settingsCont.Visible = not settingsCont.Visible
				arrow.Rotation = settingsCont.Visible and 90 or 0
			end
		end)

		if closetBtn then
			closetBtn.MouseButton1Click:Connect(function()
				local BTTNsettings = closetSettings[string.lower(btnName)]
				if not BTTNsettings then return end

				for key, value in pairs(BTTNsettings) do
					if mod.UpdateFunctions[key] then
						mod.UpdateFunctions[key](value)
					else
						mod.Values[key] = value
					end
				end
				print("Applied CLOSET settings for:", btnName)
			end)
		end

		injectElements(mod, settingsCont, name .. "_" .. btnName)

		function mod:SetState(state)
			setToggleState(state)
		end

		_G.__FW_PANIC_REG = _G.__FW_PANIC_REG or {}
		if not (_G.__FW_NO_TOGGLE and _G.__FW_NO_TOGGLE[btnName]) then
			_G.__FW_PANIC_REG[btnName] = _G.__FW_PANIC_REG[btnName] or {}
			_G.__FW_PANIC_REG[btnName].off = function()
				if not (mainScreenUI and mainScreenUI:GetAttribute("Running")) then return end
				if mod.Toggled == false then return end
				mod.Toggled = false
				nameLabel.TextColor3 = Color3.new(1, 1, 1)
				loops[string.lower(btnName)] = false

				-- INSTANTLY UPDATE MODULE LIST
				if _G.__FW_REFRESH_MODULE_LIST then
					_G.__FW_REFRESH_MODULE_LIST()
				end

				_G.SavedConfig[toggleID] = false
				pcall(saveConfigToPC)
				task.spawn(function()
					if callback then pcall(callback, false) end
					if mod.Callbacks.OnToggle then pcall(mod.Callbacks.OnToggle, false) end
				end)
			end
		end
		_G.__FW_ACTION_CLICK = _G.__FW_ACTION_CLICK or {}
		_G.__FW_ACTION_CLICK[btnName] = function(fn) btn.MouseButton1Click:Connect(fn) end

		return mod
	end

	return category
end

