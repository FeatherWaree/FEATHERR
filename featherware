	local Mode
	local PlacementMode
	local PlacementSpeed
	local Center
	local Priority
	local Return
	local Switch
	local Wool
	local Blacklist
	local AutoPatch
	local BedChecker
	local CenterOrigin: Vector3?
	local Anchor: Vector3?
	local AimGoal: Vector3?
	local AimHome: Vector3?
	local AimReturning: boolean = false
	local LastPlace: number = 0
	local LastWarning: number = 0
	local Retries: {[Vector3]: number} = {}
	
	local Scan: number = 30
	local BedRange: number = 14
	local TurnSpeed: number = 24
	local TurnTolerance: number = 0.35
	local RetryGap: number = 0.3
	local FailGap: number = 4
	local Directions: {Vector3} = {
	    Vector3.new(1, 0, 0),
	    Vector3.new(-1, 0, 0),
	    Vector3.new(0, 0, 1),
	    Vector3.new(0, 0, -1)
	}
	local Priorities = {
	    ["Lowest cost"] = function(A, B): boolean
	        return A.Health < B.Health
	    end,
	    ["Hardest"] = function(A, B): boolean
	        return A.Health > B.Health
	    end
	}
	
	local function GetOrigin(): Vector3
	    local Position: Vector3 = Entity.character.RootPart.Position
	    local Hit: RaycastResult? = Entity.Raycast(Position, Vector3.new(0, -Scan, 0), store.airRay)
	    return RoundPosition(Hit and Vector3.new(Position.X, Hit.Position.Y + 1.5, Position.Z) or Position)
	end
	
	local function GetBedNear(Partial: boolean?)
	    local LocalPosition: Vector3 = Entity.character.RootPart.Position
	    for _, v: BasePart in CollectionService:GetTagged("bed") do
	        if (LocalPosition - v.Position).Magnitude >= BedRange or v:GetAttribute(`Team{LocalPlayer:GetAttribute("Team") or -1}NoBreak`) then
	            continue
	        end
	
	        local Handler = bedwars.BlockController:getHandlerRegistry():getHandler(v.Name)
	        local Cells = Handler and Handler:getContainedPositions(v) or {v.Position / 3}
	        local Occupied = {}
	        for _, Cell: Vector3 in Cells do
	            Occupied[Cell * 3] = true
	        end
	
	        local Covered, Open = 0, 0
	        for _, Cell: Vector3 in Cells do
	            for i: number = 1, #Sides do
	                local Position: Vector3 = (Cell * 3) + Sides[i]
	                if not Occupied[Position] then
	                    if not GetPlacedBlock(Position) then
	                        Open += 1
	                    elseif Sides[i].Y >= 0 then
	                        Covered += 1
	                    end
	                end
	            end
	        end
	
	        if Partial and Covered > 0 or (not Partial and Open == 0) then
	            return v
	        end
	    end
	    return nil
	end
	
	local function GetBlocks()
	    local Blocks = {}
	    for _, v: any in store.inventory.inventory.items do
	        local Block = bedwars.ItemMeta[v.itemType].block
	        if Block and (Wool.Enabled and v.itemType:find("wool") or not Wool.Enabled and not table.find(Blacklist.ListEnabled, v.itemType:find("wool") and "wool" or v.itemType)) then
	            local Slot: number? = GetHotbar(v.tool)
	            if Slot or not Switch.Enabled then
	                table.insert(Blocks, {Type = v.itemType, Health = Block.health, Slot = Slot, Amount = v.amount or math.huge})
	            end
	        end
	    end
	    if #Blocks > 1 then
	        table.sort(Blocks, Priorities[Priority.Value])
	    end
	    return Blocks
	end
	
	local function GetEnclosure(Origin: Vector3, Grounded: boolean): {Vector3}
	    local Enemy = Entity.EntityPosition({
	        Range = 60,
	        Part = "RootPart",
	        Players = true
	    })
	    local Facing: Vector3 = Enemy and Enemy.RootPart.Position - Origin or Vector3.zero
	    local Order: {Vector3} = table.clone(Directions)
	    table.sort(Order, function(A: Vector3, B: Vector3): boolean
	        return A:Dot(Facing) > B:Dot(Facing)
	    end)
	
	    local Cells: {Vector3} = {}
	    if Grounded and not Entity.Raycast(Origin, Vector3.new(0, -3, 0), store.airRay) then
	        table.insert(Cells, Vector3.new(0, -3, 0))
	    end
	    for _, Height: number in {0, 3} do
	        for _, Direction: Vector3 in Order do
	            table.insert(Cells, Vector3.new(Direction.X * 3, Height, Direction.Z * 3))
	        end
	    end
	    if Grounded then
	        table.insert(Cells, Vector3.new(Order[1].X * 3, 6, Order[1].Z * 3))
	        table.insert(Cells, Vector3.new(0, 6, 0))
	    end
	    return Cells
	end
	
	local function HoldCenter()
	    if not CenterOrigin or PlacementMode.Value ~= "Blatant" or not Center.Enabled or vape.MovementOwner or not Entity.isAlive then
	        return
	    end
	
	    local Root: BasePart = Entity.character.RootPart
	    if isnetworkowner(Root) then
	        Root.CFrame = CFrame.new(CenterOrigin.X, Root.Position.Y, CenterOrigin.Z) * Root.CFrame.Rotation
	        Root.AssemblyLinearVelocity = Vector3.new(0, Root.AssemblyLinearVelocity.Y, 0)
	    end
	end
	
	local function GetPlaceDelay(): number
	    local CPS: number = math.min(bedwars.DefaultPlaceCPS or math.huge, bedwars.SharedConstants.BLOCK_PLACE_CPS)
	    if PlacementMode.Value == "Legit" then
	        CPS = math.min(CPS, PlacementSpeed.Value)
	    end
	    return 1 / math.max(CPS, 1)
	end
	
	local function IsInside(Origin: Vector3): boolean
	    local OffsetPosition: Vector3 = (Entity.character.RootPart.Position - Origin) * Vector3.new(1, 0, 1)
	    return math.max(math.abs(OffsetPosition.X), math.abs(OffsetPosition.Z)) <= 1.5
	end
	
	local function GetAimError(): number
	    local Look: Vector3 = Entity.character.RootPart.CFrame.LookVector * Vector3.new(1, 0, 1)
	    if not AimGoal or Look.Magnitude < 0.001 then
	        return 0
	    end
	    return math.acos(math.clamp(Look.Unit:Dot(AimGoal.Unit), -1, 1))
	end
	
	local function StopAim()
	    if AimGoal and Entity.isAlive then
	        local Root: BasePart = Entity.character.RootPart
	        if AimHome then
	            Root.CFrame = CFrame.lookAlong(Root.Position, AimHome)
	        end
	        Entity.character.Humanoid.AutoRotate = true
	    end
	    AimGoal, AimHome, AimReturning = nil, nil, false
	end
	
	local function Turn(Direction: Vector3)
	    if not AimHome then
	        local Look: Vector3 = Entity.character.RootPart.CFrame.LookVector * Vector3.new(1, 0, 1)
	        AimHome = Look.Magnitude > 0.001 and Look.Unit or nil
	    end
	    AimGoal, AimReturning = Direction, false
	end
	
	local function TurnBack()
	    if AimHome then
	        AimGoal, AimReturning = AimHome, true
	    else
	        StopAim()
	    end
	end
	
	local function AimStep(DeltaTime: number)
	    if not AimGoal then
	        return
	    end
	    if not Entity.isAlive then
	        AimGoal, AimHome, AimReturning = nil, nil, false
	        return
	    end
	
	    local Root: BasePart = Entity.character.RootPart
	    Entity.character.Humanoid.AutoRotate = false
	    if AimReturning and GetAimError() < 0.02 then
	        StopAim()
	        return
	    end
	    Root.CFrame = Root.CFrame:Lerp(CFrame.lookAlong(Root.Position, AimGoal), math.clamp((TurnSpeed + 2) * DeltaTime, 0, 1))
	end
	
	local function PlacePattern(Origin: Vector3, Cells: {Vector3}, Blocks, Limit: number, Patching: boolean?)
	    local Hotbar = store.hand.tool and GetHotbar(store.hand.tool) or nil
	    local Placed: number = 0
	
	    for _, Offset: Vector3 in Cells do
	        if Placed >= Limit or not BlockIn.Enabled or not Entity.isAlive then
	            break
	        end
	        local Position: Vector3 = Origin + Offset
	        if GetPlacedBlock(Position) then
	            continue
	        end
	        while Blocks[1] and Blocks[1].Amount <= 0 do
	            table.remove(Blocks, 1)
	        end
	        local Block = Blocks[1]
	        if not Block then
	            break
	        end
	
	        if PlacementMode.Value == "Blatant" and Center.Enabled then
	            CenterOrigin = Origin
	        end
	        local Turning: boolean = Patching == true and PlacementMode.Value == "Legit" and Offset.Y >= 0 and Offset.Y <= 3 and (Offset.X ~= 0 or Offset.Z ~= 0)
	        if Turning then
	            Turn(Vector3.new(Offset.X, 0, Offset.Z))
	        end
	        local Deadline: number = os.clock() + 0.3
	        repeat
	            task.wait()
	        until not BlockIn.Enabled or not Entity.isAlive or ((workspace:GetServerTimeNow() - math.max(LastPlace, bedwars.BlockCpsController.lastPlaceTimestamp)) >= GetPlaceDelay() and (not Turning or GetAimError() < TurnTolerance or os.clock() > Deadline))
	        if not BlockIn.Enabled or not Entity.isAlive then
	            break
	        end
	        if PlacementMode.Value == "Legit" and not IsInside(Origin) then
	            break
	        end
	
	        if Switch.Enabled then
	            HotbarSwitch(Block.Slot)
	        end
	        LastPlace = workspace:GetServerTimeNow()
	        task.spawn(bedwars.placeBlock, Position, Block.Type)
	        local Registered: boolean = GetPlacedBlock(Position) and true or false
	        if Registered then
	            Block.Amount -= 1
	            Placed += 1
	        end
	        if Patching then
	            Retries[Position] = os.clock() + (Registered and RetryGap or FailGap)
	        end
	    end
	    if Patching then
	        TurnBack()
	    end
	    if Return.Enabled and Switch.Enabled and Hotbar then
	        HotbarSwitch(Hotbar)
	    end
	end
	
	local function Build(): boolean
	    if not Entity.isAlive or (Mode.Value ~= "On bind" and not GetBedNear()) then
	        return false
	    end
	
	    local Blocks = GetBlocks()
	    local Early: boolean = false
	    repeat
	        task.wait()
	        if Entity.isAlive and not Early then
	            local Origin: Vector3 = GetOrigin()
	            local Drop: number = Entity.character.RootPart.Position.Y - Origin.Y
	            Early = Drop >= 6 and Drop <= 24
	            if Early then
	                PlacePattern(Origin, GetEnclosure(Origin, false), Blocks, PlacementMode.Value == "Blatant" and Center.Enabled and math.huge or 3)
	            end
	        end
	    until not BlockIn.Enabled or not Entity.isAlive or Entity.character.Humanoid.FloorMaterial ~= Enum.Material.Air
	
	    if Entity.isAlive then
	        local Origin: Vector3 = GetOrigin()
	        PlacePattern(Origin, GetEnclosure(Origin, true), Blocks, math.huge)
	        Anchor = Origin
	    end
	    CenterOrigin = nil
	    return true
	end
	
	local function Patch()
	    if not Entity.isAlive then
	        Anchor = nil
	        return
	    end
	
	    local Base: Vector3? = Anchor
	    if not Base or Entity.character.Humanoid.FloorMaterial == Enum.Material.Air or not CanPlace() or not IsInside(Base) then
	        return
	    end
	
	    local Origin: Vector3 = GetOrigin()
	    if Origin.Y > Base.Y then
	        return
	    end
	    if Origin.Y < Base.Y then
	        Base, Anchor = Origin, Origin
	        table.clear(Retries)
	    end
	
	    local Cells: {Vector3} = {}
	    for _, Offset: Vector3 in GetEnclosure(Base, true) do
	        local Position: Vector3 = Base + Offset
	        if not GetPlacedBlock(Position) and (Retries[Position] or 0) <= os.clock() then
	            table.insert(Cells, Offset)
	        end
	    end
	    if #Cells == 0 then
	        return
	    end
	
	    local Blocks = GetBlocks()
	    if #Blocks == 0 then
	        if os.clock() - LastWarning > 5 then
	            LastWarning = os.clock()
	            SendNotification("Block-In", "No blocks left to patch with", 3, "warning", "BlockInWarning")
	        end
	        return
	    end
	
	    PlacePattern(Base, Cells, Blocks, math.huge, true)
	    CenterOrigin = nil
	end
	
	local function TurnOff()
	    if BlockIn.Enabled then
	        BlockIn:Toggle()
	    end
	end
	
	local function IsAway(): boolean
	    return BedChecker.Enabled and not (Entity.isAlive and GetBedNear(true))
	end
	
	local function Dismiss()
	    if vape.Loaded then
	        SendNotification("Block-In", "You are not near an enemy bed defense", 3, "warning", "BlockInWarning")
	    end
	    TurnOff()
	end
	
	BlockIn = vape.Categories.World:CreateModule({
	    Name = "Block-In",
	    Function = function(Callback: boolean)
	        if Callback then
	            if not vape.Loaded and Mode.Value == "On bind" and AutoPatch.Enabled then
	                task.defer(TurnOff)
	                return
	            end
	            if IsAway() then
	                task.defer(Dismiss)
	                return
	            end
	
	            LastPlace, Anchor = 0, nil
	            table.clear(Retries)
	            BlockIn:Clean(RunService.PreSimulation:Connect(HoldCenter))
	            BlockIn:Clean(RunService.PostSimulation:Connect(AimStep))
	            BlockIn:Clean(function()
	                CenterOrigin, Anchor = nil, nil
	                StopAim()
	            end)
	
	            local Guarding: boolean = false
	            repeat
	                local Bind: boolean = Mode.Value == "On bind"
	                if IsAway() then
	                    Dismiss()
	                    break
	                end
	
	                if Guarding and Bind and AutoPatch.Enabled then
	                    Patch()
	                    task.wait(0.1)
	                elseif Guarding and Bind then
	                    TurnOff()
	                    break
	                else
	                    local Built: boolean = Build()
	                    Guarding = Bind and Built and AutoPatch.Enabled
	                    if Bind and not Guarding then
	                        TurnOff()
	                        break
	                    end
	                    if not Bind then
	                        task.wait(0.5)
	                    end
	                end
	            until not BlockIn.Enabled
	        end
	    end,
	    Tooltip = "Automatically blocks you in by building walls around you"
	})
	
	Mode = BlockIn:CreateDropdown({
	    Name = "Mode",
	    List = {"On bind", "When near"},
	    Default = "On bind",
	    Function = function(Val: string)
	        if AutoPatch then AutoPatch.Object.Visible = Val == "On bind" end
	    end,
	    Tooltip = "On bind blocks you in once per keypress, When near keeps you blocked in while you are on an enemy bed"
	})
	BedChecker = BlockIn:CreateToggle({
	    Name = "Bed checker",
	    Tooltip = `Won't turn on, and turns itself off with a warning, whenever you are not within {BedRange} studs of an enemy bed that has blocks around it`
	})
	AutoPatch = BlockIn:CreateToggle({
	    Name = "Auto Patch",
	    Tooltip = "On bind only. Stays on after blocking you in and refills any wall block that gets broken, or rebuilds around you when you drop to a lower level, until you turn the module off yourself. In Legit mode your character silently turns toward each side block it patches and back afterwards"
	})
	PlacementMode = BlockIn:CreateDropdown({
	    Name = "Placement mode",
	    List = {"Legit", "Blatant"},
	    Default = "Legit",
	    Function = function(Val: string)
	        if PlacementSpeed then PlacementSpeed.Object.Visible = Val == "Legit" end
	        if Center then Center.Object.Visible = Val == "Blatant" end
	    end,
	    Tooltip = "Legit uses your placement speed and lets you move freely, Blatant builds at the normal limit with optional centering"
	})
	local MaxSpeed = math.max(bedwars.DefaultPlaceCPS or bedwars.SharedConstants.BLOCK_PLACE_CPS, 1)
	PlacementSpeed = BlockIn:CreateSlider({
	    Name = "Placement speed",
	    Min = 1,
	    Max = MaxSpeed,
	    Default = MaxSpeed,
	    Visible = true,
	    Suffix = "blocks/s",
	    Tooltip = "Blocks placed per second in Legit mode"
	})
	Center = BlockIn:CreateToggle({
	    Name = "Center",
	    Default = true,
	    Visible = false,
	    Tooltip = "Holds you in the middle of your block while it builds, so no side gets skipped"
	})
	Priority = BlockIn:CreateDropdown({
	    Name = "Block priority",
	    List = {"Lowest cost", "Hardest"},
	    Default = "Lowest cost"
	})
	Switch = BlockIn:CreateToggle({Name = "Switch", Default = true})
	Return = BlockIn:CreateToggle({Name = "Return to last slot", Default = true})
	Wool = BlockIn:CreateToggle({Name = "Wool only"})
	Blacklist = BlockIn:CreateTextList({
	    Name = "Blacklist",
	    Default = {"cannon", "siege_tnt", "tnt"}
	})
end)

Run(function()
	local AutoChestSplit
	local Items
	local Range
	local Minimum
	local EnemyOnly
	local Delay
	local NextDeposit: number = 0
	
	local function GetChest(LocalPosition: Vector3): BasePart?
	    for _, v: Instance in CollectionService:GetTagged("personal-chest") do
	        local Part: BasePart? = not v:IsA("Model") and v or (v.PrimaryPart or v:FindFirstChildWhichIsA("BasePart", true))
	        if Part and (Part.Position - LocalPosition).Magnitude <= Range.Value then
	            return Part
	        end
	    end
	    return nil
	end
	
	local function InEnemyBase(LocalPosition: Vector3): boolean
	    local Team = LocalPlayer:GetAttribute("Team")
	    local Closest, Distance = nil, math.huge
	
	    for _, v: Instance in CollectionService:GetTagged("team-crate") do
	        local Part: BasePart? = not v:IsA("Model") and v or (v.PrimaryPart or v:FindFirstChildWhichIsA("BasePart", true))
	        local PartDistance: number = Part and (Part.Position - LocalPosition).Magnitude or math.huge
	        if PartDistance < Distance then
	            Closest, Distance = v, PartDistance
	        end
	    end
	    return Closest ~= nil and Closest:GetAttribute("Team") ~= Team
	end
	
	local function DepositSplit()
	    local Inventory: Instance? = ReplicatedStorage:FindFirstChild("Inventories")
	    Inventory = Inventory and Inventory:FindFirstChild(`{LocalPlayer.Name}_personal`) or nil
	    if not Inventory then
	        return
	    end
	
	    for _, v: string in Items.ListEnabled do
	        local Item = getItem(v)
	        if Item and (Item.amount or 1) >= Minimum.Value then
	            task.spawn(function()
	                bedwars.Client:GetNamespace("Inventory"):Get("ChestGiveItem"):CallServer(Inventory, Item.tool)
	            end)
	        end
	    end
	end
	
	AutoChestSplit = vape.Categories.Inventory:CreateModule({
	    Name = "AutoChestSplit",
	    Function = function(Callback: boolean)
	        if Callback then
	            NextDeposit = 0
	
	            repeat
	                task.wait()
	            until store.matchState ~= 0 or (not AutoChestSplit.Enabled)
	            if not AutoChestSplit.Enabled then
	                return
	            end
	
	            repeat
	                if Entity.isAlive and tick() >= NextDeposit and #Items.ListEnabled > 0 then
	                    local LocalPosition: Vector3 = Entity.character.RootPart.Position
	                    if GetChest(LocalPosition) and (not EnemyOnly.Enabled or InEnemyBase(LocalPosition)) then
	                        NextDeposit = tick() + Delay.Value
	                        DepositSplit()
	                    end
	                end
	                task.wait(0.1)
	            until not AutoChestSplit.Enabled
	        end
	    end,
	    Tooltip = "Banks the split in your personal chest the moment you are stood at one"
	})
	
	Items = AutoChestSplit:CreateTextList({
	    Name = "Items",
	    Default = {"diamond", "emerald"},
	    Tooltip = "What counts as the split"
	})
	Range = AutoChestSplit:CreateSlider({
	    Name = "Range",
	    Min = 1,
	    Max = 18,
	    Default = 18,
	    Suffix = function(Val: number)
	        return Val <= 1 and "stud" or "studs"
	    end,
	    Tooltip = "How close to the chest you have to be, the server stops taking items at about 20"
	})
	Minimum = AutoChestSplit:CreateSlider({
	    Name = "Minimum",
	    Min = 1,
	    Max = 64,
	    Default = 1,
	    Tooltip = "Leaves the stack alone until you are holding this many"
	})
	EnemyOnly = AutoChestSplit:CreateToggle({
	    Name = "Enemy base only",
	    Default = true,
	    Tooltip = "Only banks at a chest that is closer to their generator than yours"
	})
	Delay = AutoChestSplit:CreateSlider({
	    Name = "Delay",
	    Min = 0,
	    Max = 5,
	    Decimal = 10,
	    Default = 0.5,
	    Suffix = "seconds"
	})
end)

