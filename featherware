												if drawTrack then pcall(function() drawTrack:Stop() end); drawTrack = nil end
												paUpdateLegitTracer(nil, nil, false)
												isCharging = false
												paLockedSpeed = nil
												if hum then hum.WalkSpeed = originalWalkSpeed end
											end
										elseif now - chargeStartTime > (currentLoadout.maxCharge or 0) + 1.5 then
											if drawTrack then pcall(function() drawTrack:Stop() end); drawTrack = nil end
											paUpdateLegitTracer(nil, nil, false)
											isCharging = false
											paLockedSpeed = nil
											chargeStartTime = now
											if hum then hum.WalkSpeed = originalWalkSpeed end
										end
									end
								else
									if isCharging then
										isCharging = false
										if drawTrack then pcall(function() drawTrack:Stop() end); drawTrack = nil end
										paUpdateLegitTracer(nil, nil, false)
										if hum then hum.WalkSpeed = originalWalkSpeed end
									end
								end
							end
						else
							pa_idx = (PA_RR % pa_n) + 1
