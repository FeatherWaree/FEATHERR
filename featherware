cdState = function(plr)
	if not cd_players[plr] then
		cd_players[plr] = {
			lastVel = Vector3.zero, nextSample = 0,
			lastHurt = -999, velBefore = Vector3.zero, hurtTime = -999, velChecked = true,
			fallY = nil, falling = false,
			airTime = 0, climbTime = 0, phaseTime = 0, phaseNext = 0,
			airJumps = 0, lastJumpSpike = 0,
			moveTime = 0,
			lastMelee = -999, lastMeleeAny = -999,
			scafTimes = {}, trapTime = -999,
			speedTime = 0, ljTime = 0, spinTime = 0, fallTime = 0,
