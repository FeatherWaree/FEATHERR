			alarmSound.RollOffMaxDistance = 5000

			local soundPart = alarm.PrimaryPart or alarm:FindFirstChildWhichIsA("BasePart", true)
			alarmSound.Parent = soundPart
			activeAlarmData.sound = alarmSound

			local isTriggered = false

			activeAlarmData.spinConnection = G.Services.RunService.Heartbeat:Connect(function(dt)
				if alarm and alarm.Parent then
					local currentSpeed = isTriggered and 270 or alarm:GetAttribute("RotationSpeed")
					alarm:PivotTo(alarm:GetPivot() * CFrame.Angles(0, math.rad(currentSpeed * dt), 0))
				end
			end)

			activeAlarmData.detectLoop = task.spawn(function()
				while loops["bed alarm"] and task.wait(0.5) do
					local someoneIsNear = false

					for _, enemy in pairs(Players:GetPlayers()) do
						if enemy == Player or enemy:GetAttribute("Team") == Player:GetAttribute("Team") then 
							continue 
						end

						local character = enemy.Character
						local rootPart = character and character:FindFirstChild("HumanoidRootPart")

						if rootPart then
							local distance = (rootPart.Position - bedCFrame.Position).Magnitude

							if distance <= 30 then
								someoneIsNear = true

								if not activeAlarmData.activeHighlights[enemy] then
									local highlight = Instance.new("Highlight")
									highlight.FillTransparency = 0.7
									highlight.OutlineTransparency = 0
									highlight.FillColor = Color3.fromRGB(204, 28, 28)
									highlight.OutlineColor = Color3.fromRGB(194, 33, 33)
									highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
									highlight.Parent = character

									activeAlarmData.activeHighlights[enemy] = highlight

									NotificationSystem.Notify("Bed Alarm", "Someone is at your base!", 0.5)

								else
									if activeAlarmData.activeHighlights[enemy].Parent ~= character then
										activeAlarmData.activeHighlights[enemy].Parent = character
									end
								end
							else
								if activeAlarmData.activeHighlights[enemy] then
									activeAlarmData.activeHighlights[enemy]:Destroy()
									activeAlarmData.activeHighlights[enemy] = nil
								end
							end
						else
							if activeAlarmData.activeHighlights[enemy] then
								activeAlarmData.activeHighlights[enemy]:Destroy()
								activeAlarmData.activeHighlights[enemy] = nil
							end
						end
					end

					for savedEnemy, highlight in pairs(activeAlarmData.activeHighlights) do
						if not savedEnemy.Parent then
							highlight:Destroy()
							activeAlarmData.activeHighlights[savedEnemy] = nil
						end
					end

					-- SOUND LOGIC: Check if the state just changed this cycle
					if someoneIsNear and not isTriggered then
						-- Someone entered the base
						if activeAlarmData.sound and not activeAlarmData.sound.IsPlaying then
							activeAlarmData.sound:Play()
						end
					elseif not someoneIsNear and isTriggered then
						-- Everyone left the base
						if activeAlarmData.sound then
							activeAlarmData.sound:Stop()
						end
					end

					isTriggered = someoneIsNear
				end
			end)

			activeAlarmData.flashLoop = task.spawn(function()
				local toggleState = true
				while loops["bed alarm"] and task.wait(0.5) do

					if isTriggered then
						toggleState = not toggleState 
					else
						toggleState = true 
					end

					local sidesColor = toggleState and Color3.fromRGB(226, 88, 88) or Color3.fromRGB(90, 25, 25)
					if alarm:FindFirstChild("Sides") then
						for _, part in pairs(alarm.Sides:GetChildren()) do
							if part:IsA("BasePart") then part.Color = sidesColor end
						end
					end

					if alarm:FindFirstChild("Recolor") then
						local recolor = alarm.Recolor
						if recolor:FindFirstChild("Inner") then
							recolor.Inner.Color = toggleState and Color3.fromRGB(195, 70, 70) or Color3.fromRGB(75, 20, 20)
						end
						if recolor:FindFirstChild("Outer") then
							recolor.Outer.Color = toggleState and Color3.fromRGB(188, 74, 74) or Color3.fromRGB(75, 20, 20)
						end
						if recolor:FindFirstChild("Bulb") then
							recolor.Bulb.Color = toggleState and Color3.fromRGB(195, 70, 70) or Color3.fromRGB(75, 20, 20)

							if recolor.Bulb:FindFirstChild("GlowAttachment") and recolor.Bulb.GlowAttachment:FindFirstChild("Glow") then
								local glowColor = toggleState and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(50, 0, 0)
								recolor.Bulb.GlowAttachment.Glow.Color = ColorSequence.new(glowColor)
							end
						end
					end
				end
			end)
		end
	else
		cleanupAlarm()
	end
end

