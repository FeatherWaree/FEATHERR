				if stunTime and stunTime ~= -1 then
					currentKaTarget = nil
					kaHighlight.Adornee = nil
					boxVisualizer.Adornee = nil
					swingRequested = false
					continue
				end
			end

			if not handleClawRequirement() then
				currentKaTarget = nil
				kaHighlight.Adornee = nil
				boxVisualizer.Adornee = nil
				swingRequested = false
				continue
			end

			playertarget = nil
			playerdistance = 1000
			npcdummytarget = nil
			npcdummydistance = 1000

			reach = tonumber(KaidaKa.Values["Reach"]) or 20
			angleCheck = tonumber(KaidaKa.Values["Angle Check"]) or 90

			if KaidaKa.Values["Target Players"] then
				for _, v in ipairs(Players:GetPlayers()) do
					isSpectator = false
					if v.Team and v.Team.Name and string.find(string.lower(v.Team.Name), "spectator") then
						isSpectator = true
					end

					if not isSpectator and v ~= Player and v.Character and v.Team ~= Player.Team then
						targetHRP = v.Character:FindFirstChild("HumanoidRootPart")
						hum = v.Character:FindFirstChild("Humanoid")
						if targetHRP and hum and hum.Health > 0 then
							dist = (rootPart.Position - targetHRP.Position).Magnitude
							if dist <= reach and dist < playerdistance then
								if isInFOV(rootPart, targetHRP, angleCheck) then
									playertarget = v.Character
									playerdistance = dist
								end
							end
						end
					end
				end
			end

			if KaidaKa.Values["Target NPCs/Dummies"] then
				for _, npc in ipairs(G.Services.Workspace:GetChildren()) do
					if npc:IsA("Model") and npc:FindFirstChild("Humanoid") and npc.PrimaryPart then
						if not Players:GetPlayerFromCharacter(npc) then
							dist = (rootPart.Position - npc.PrimaryPart.Position).Magnitude
							if dist <= reach and dist < npcdummydistance then
								if isInFOV(rootPart, npc.PrimaryPart, angleCheck) then
									npcdummytarget = npc
									npcdummydistance = dist
								end
							end
						end
					end
				end
			end

			priority = KaidaKa.Values["Priority"] or "Nearest"
			besttarget = nil
			if priority == "Player" then
				besttarget = playertarget or npcdummytarget
			elseif priority == "NPC/Dummy" then
				besttarget = npcdummytarget or playertarget
			else 
				if playertarget and npcdummytarget then
					besttarget = (playerdistance <= npcdummydistance) and playertarget or npcdummytarget
				else
					besttarget = playertarget or npcdummytarget
				end
			end

			hasTarget = false
			targetDir = nil

			if besttarget then
				targetHRP = besttarget:FindFirstChild("HumanoidRootPart") or besttarget.PrimaryPart
				if targetHRP then
					distToTarget = (rootPart.Position - targetHRP.Position).Magnitude

					if distToTarget <= 40 then
						if KaidaKa.Values["Highlight Target"] then
							kaHighlight.Adornee = besttarget
						else
							kaHighlight.Adornee = nil
						end

						if KaidaKa.Values["3D Box"] then
							boxVisualizer.Adornee = targetHRP
						else
							boxVisualizer.Adornee = nil
						end
					else
						kaHighlight.Adornee = nil
						boxVisualizer.Adornee = nil
					end

					if distToTarget <= reach and isInFOV(rootPart, targetHRP, angleCheck) then
						hasTarget = true
						targetDir = (targetHRP.Position - rootPart.Position).Unit
						currentKaTarget = besttarget

						if KaidaKa.Values["Face Target"] then
							char:PivotTo(CFrame.lookAt(rootPart.Position, targetHRP.Position))
