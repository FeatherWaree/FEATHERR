marinaCheckAndFire = function()
	if not loops["auto marina"] then return end

	-- 1. Check if Jellyfish Kit is equipped
	kitAttr = PlayersService.LocalPlayer:GetAttribute("PlayingAsKits")
	if kitAttr ~= "jellyfish" then
		if not marinaData.notified then
			marinaSendNotification("Auto Marina", "Jellyfish kit is not equipped! Module disabled.")
			marinaData.notified = true
		end
		return
	end

	-- Reset notification flag if kit is equipped
	marinaData.notified = false

	now = os.clock()
	if now - marinaData.lastFire < ELECTRIFY_COOLDOWN then return end

	myChar = PlayersService.LocalPlayer.Character
	if not myChar then return end
	myRoot = myChar:FindFirstChild("HumanoidRootPart")
	if not myRoot then return end

	maxRange = AutoMarina.Values["Range"] or 20
	targetFound = false

	-- 2. Check for enemies/NPCs near any of your jellyfish
	for _, jelly in ipairs(CollectionService:GetTagged("jellyfish")) do
		-- Only check jellyfish placed by you
		if jelly:GetAttribute("PlacedByUserId") == PlayersService.LocalPlayer.UserId then
			jellyPos = jelly:GetPivot().Position

			-- Check Players
			for _, plr in ipairs(FWNoModules.PlayerSnapshot()) do
				if marinaIsEnemy(plr.Character) then
					eRoot = plr.Character:FindFirstChild("HumanoidRootPart")
					if eRoot then
						dist = (eRoot.Position - jellyPos).Magnitude
						if dist <= maxRange then
							targetFound = true
							break
						end
					end
				end
			end

			if targetFound then break end

			-- Check NPCs/Dummies
			for _, obj in ipairs(G.Services.Workspace:GetChildren()) do
				if obj:IsA("Model") and not PlayersService:GetPlayerFromCharacter(obj) then
					hum = obj:FindFirstChildOfClass("Humanoid")
					eRoot = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
					if hum and hum.Health > 0 and eRoot then
						dist = (eRoot.Position - jellyPos).Magnitude
						if dist <= maxRange then
							targetFound = true
							break
						end
					end
				end
			end

			if targetFound then break end
		end
	end

	-- 3. Fire Ability if target found
	if targetFound then
		if not marinaLoadRemote() then return end

		marinaData.lastFire = now

		pcall(function()
			marinaData.abilityRemote:FireServer("electrify_jellyfish")
		end)
	end
end

