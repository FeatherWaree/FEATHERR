function scaffoldGetBlock()
	char = Player.Character
	if not char then return nil, 0 end

	-- 1. Check what is currently in hand
	handItem = char:FindFirstChild("HandInvItem")
	currentHandName = nil
	if handItem and handItem.Value then
		currentHandName = typeof(handItem.Value) == "Instance" and handItem.Value.Name or tostring(handItem.Value)
	end

	-- 2. If holding a valid block, use it
	if currentHandName then
		inv = FWNoModules.GetPrivateInventory(Player.Name)
		amount = inv and inv:FindFirstChild(currentHandName) and inv[currentHandName]:GetAttribute("Amount") or 0
		if amount > 0 then 
			-- Verify it's actually a block type (basic check)
			if currentHandName:find("wool") or currentHandName:find("plank") or currentHandName:find("stone") or currentHandName:find("obsidian") or currentHandName:find("glass") or currentHandName:find("brick") then
				return currentHandName, amount
			end
		end
	end

	-- 3. If NOT holding a block, and "Limit to items" is OFF, search inventory and EQUIP it
	if not Scaffold.Values["Limit to items"] then
		inv = FWNoModules.GetPrivateInventory(Player.Name)
		if inv then
			for _, item in ipairs(inv:GetChildren()) do
				-- Check if it's a valid block type
				if item.Name:find("wool") or item.Name:find("plank") or item.Name:find("stone") or item.Name:find("obsidian") or item.Name:find("glass") or item.Name:find("brick") then
					amt = item:GetAttribute("Amount") or 0
					if amt > 0 then
						-- CRITICAL FIX: Equip the block if we aren't holding it
						if currentHandName ~= item.Name and scaffoldSetInvRemote then
							pcall(function()
								scaffoldSetInvRemote:InvokeServer({ hand = item })
							end)
						end
						return item.Name, amt
					end
				end
			end
		end
	end

	return nil, 0
end

function scaffoldLoop()
	char = Player.Character
	if not char then return end
	hrp = char:FindFirstChild("HumanoidRootPart")
	hum = char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum or hum.Health <= 0 then return end

	wool, amount = scaffoldGetBlock()

	-- Require mouse down check
	if Scaffold.Values["Require mouse down"] then
		if not G.Services.UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
			wool = nil
		end
	end

	-- Update Block Count label
	if Scaffold.Values["Block Count"] then
		if not scaffoldLabel then
			scaffoldLabel = FWNoModules.OwnInstance(Instance.new("TextLabel"))
			scaffoldLabel.Size = UDim2.fromOffset(100, 20)
			scaffoldLabel.Position = UDim2.new(0.5, 6, 0.5, 60)
			scaffoldLabel.BackgroundTransparency = 1
			scaffoldLabel.AnchorPoint = Vector2.new(0.5, 0)
			scaffoldLabel.Text = "0"
			scaffoldLabel.TextColor3 = Color3.new(0, 1, 0)
			scaffoldLabel.TextSize = 18
			scaffoldLabel.RichText = true
			scaffoldLabel.Font = Enum.Font.Arial
			local hud=PlayerGui:FindFirstChild("Featherware_ScaffoldHUD")
            if not hud then hud=FWNoModules.OwnInstance(Instance.new("ScreenGui"));hud.Name="Featherware_ScaffoldHUD";hud.ResetOnSpawn=false;hud.Parent=PlayerGui end
            scaffoldLabel.Parent=hud
		end
		scaffoldLabel.Visible = true
		scaffoldLabel.Text = (amount or 0) .. " (Scaffold)"
		scaffoldLabel.TextColor3 = Color3.fromHSV(((amount or 0) / 128) / 2.8, 0.86, 1)
	else
		if scaffoldLabel then scaffoldLabel.Visible = false end
	end

	if wool then
		-- Tower: Set velocity to 38 if Space is held
		if Scaffold.Values["Tower"] and G.Services.UIS:IsKeyDown(Enum.KeyCode.Space) and not G.Services.UIS:GetFocusedTextBox() then
			hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, 38, hrp.AssemblyLinearVelocity.Z)
		end

		expandVal = tonumber(Scaffold.Values["Expand"]) or 3
		for i = expandVal, 1, -1 do
			-- Calculate position based on movement direction
			yOffset = (hum.HipHeight or 2) + (Scaffold.Values["Downwards"] and G.Services.UIS:IsKeyDown(Enum.KeyCode.LeftShift) and 4.5 or 1.5)
			currentpos = scaffoldRoundPos(hrp.Position - Vector3.new(0, yOffset, 0) + hum.MoveDirection * (i * 3))

			-- Diagonal fix
			if Scaffold.Values["Diagonal"] then
				angle = math.abs(math.round(math.deg(math.atan2(-hum.MoveDirection.X, -hum.MoveDirection.Z)) / 45) * 45)
				if angle % 90 == 45 then
					dt = scaffoldLastPos - currentpos
					if ((dt.X == 0 and dt.Z ~= 0) or (dt.X ~= 0 and dt.Z == 0)) and ((scaffoldLastPos - hrp.Position) * Vector3.new(1, 0, 1)).Magnitude < 2.5 then
						currentpos = scaffoldLastPos
					end
				end
			end

			-- CRITICAL FIX #2: Update visual to the NEW block position (currentpos)
			scaffoldUpdateVisual(currentpos)

			block, blockpos = scaffoldGetPlacedBlock(currentpos)
			if not block then
				-- Find a nearby block to place on
				gridPos = Vector3.new(math.round(currentpos.X / 3), math.round(currentpos.Y / 3), math.round(currentpos.Z / 3))
				if scaffoldCheckAdjacent(gridPos * 3) then
					placePos = gridPos * 3
				else
					-- CRITICAL FIX #1: Use the fast raycast proximity instead of the heavy 3D scan
					placePos = scaffoldBlockProximity(currentpos)
				end

				if placePos then
					-- Calculate the grid positions for the remote
					newGrid = Vector3.new(math.round(currentpos.X / 3), math.round(currentpos.Y / 3), math.round(currentpos.Z / 3))
					targetGrid = Vector3.new(math.round(placePos.X / 3), math.round(placePos.Y / 3), math.round(placePos.Z / 3))

					task.delay(0, function()
						scaffoldPlaceBlock(newGrid, targetGrid, wool)
					end)
				end
			end
			scaffoldLastPos = currentpos
		end
	end
end
function scaffoldClearVisuals()
	if scaffoldVisualTween then scaffoldVisualTween:Cancel(); scaffoldVisualTween = nil end
	if scaffoldVisualBlock then scaffoldVisualBlock.Parent = nil end
	scaffoldVisualPos = nil
end

-- CRITICAL FIX #2: VISUAL GOES TO NEWEST BLOCK PLACED
function scaffoldUpdateVisual(pos)
	if not scaffoldVisualBlock or not pos then return end
	-- Snap the visual to the exact grid position where the new block will be placed
	blockpos = Vector3.new(math.round(pos.X / 3) * 3, math.round(pos.Y / 3) * 3, math.round(pos.Z / 3) * 3)
	if scaffoldVisualPos == blockpos then return end

	if scaffoldVisualTween then scaffoldVisualTween:Cancel(); scaffoldVisualTween = nil end

	cam = G.Services.Workspace.CurrentCamera
	if scaffoldVisualBlock.Parent == cam then
		scaffoldVisualTween = FWNoModules.OwnTween(G.Services.TweenService:Create(scaffoldVisualBlock, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {CFrame = CFrame.new(blockpos)}))
		scaffoldVisualTween:Play()
	else
		scaffoldVisualBlock.CFrame = CFrame.new(blockpos)
		scaffoldVisualBlock.Parent = cam
	end
	scaffoldVisualPos = blockpos
end

function scaffoldPlaceBlock(newGridPos, targetGridPos, blockType)
	if not scaffoldPlaceRemote then return end

	-- Calculate the hit normal based on which face of the target block we are clicking
	diff = newGridPos - targetGridPos
	hitNormal = Vector3.new(0, 1, 0)
	if diff.Y == 1 then hitNormal = Vector3.new(0, 1, 0)
	elseif diff.Y == -1 then hitNormal = Vector3.new(0, -1, 0)
	elseif diff.X == 1 then hitNormal = Vector3.new(1, 0, 0)
	elseif diff.X == -1 then hitNormal = Vector3.new(-1, 0, 0)
	elseif diff.Z == 1 then hitNormal = Vector3.new(0, 0, 1)
	elseif diff.Z == -1 then hitNormal = Vector3.new(0, 0, -1)
	end

	targetWorldPos = targetGridPos * 3
	hitPosition = targetWorldPos + (hitNormal * 1.5)

	-- Exact game arguments for placing a block
	args = {
		position = Vector3.new(newGridPos.X, newGridPos.Y, newGridPos.Z),
		blockType = blockType,
		blockData = 0,
		mouseBlockInfo = {
			target = {
				blockRef = { blockPosition = Vector3.new(targetGridPos.X, targetGridPos.Y, targetGridPos.Z) },
				hitPosition = hitPosition,
				hitNormal = hitNormal,
			},
			placementPosition = Vector3.new(newGridPos.X, newGridPos.Y, newGridPos.Z),
		},
	}

	pcall(function()
		scaffoldPlaceRemote:InvokeServer(args)
	end)
end


