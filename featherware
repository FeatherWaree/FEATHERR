    -- Restrict window movement to the title bar. Row drags have their own owner.
    function addons.BlockWindowDrag(frame, input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then return false end
        if activeDrag then return true end
        local inset = game:GetService("GuiService"):GetGuiInset()
        local y = input.Position.Y - (mainScreenUI.IgnoreGuiInset and 0 or inset.Y)
        return y > frame.AbsolutePosition.Y + 35
    end

    function addons.Order(group)
        local stored = savedTable("Order_" .. group.Key)
        local rank = {}
        for index, id in ipairs(stored) do
            if type(id) == "string" and not rank[id] then rank[id] = index end
        end
        table.sort(group.Rows, function(a, b)
            local ar = rank[a.ID] or (#stored + a.Sequence)
            local br = rank[b.ID] or (#stored + b.Sequence)
            if ar == br then return a.Sequence < b.Sequence end
            return ar < br
        end)
        for index, row in ipairs(group.Rows) do row.Frame.LayoutOrder = index end
    end

    local categoryGroup = {Key = "Categories", Rows = {}, Scroll = mainScroll}
    addons.CategoryGroup = categoryGroup
    local function persistOrder(group)
        local ids = {}
        for index, row in ipairs(group.Rows) do ids[index] = row.ID end
        _G.SavedConfig[prefix .. "Order_" .. group.Key] = ids
        save()
    end

    local function stopDrag(commit)
        local drag = activeDrag
        if not drag then return end
        if drag.Ghost then drag.Ghost:Destroy()end
        for object,value in pairs(drag.Faded or {})do if object.Parent then object.TextTransparency=value end end
        if drag.Parent and drag.Parent.Parent then drag.Parent.BackgroundTransparency=drag.BackgroundTransparency end
        activeDrag = nil
        if dragRender then dragRender:Disconnect(); dragRender = nil end
        if currentlyDragging == drag.Handle then currentlyDragging = nil end
        drag.Group.Scroll.ScrollingEnabled = drag.ScrollingEnabled
        drag.Handle.TextColor3 = Color3.fromRGB(160, 160, 160)
        if commit then persistOrder(drag.Group) end
    end

    addons.EndDrag=stopDrag
    function addons.DragHandle(parent, row, group, left)
        local handle = button(parent, "≡", 20, 20)
        handle.Name = "ReorderHandle"
        handle.Position = left and UDim2.new(0, 0, 0, 0) or UDim2.new(1, -24, 0, 0)
        connect(handle.InputBegan, function(input)
            if input.UserInputType ~= Enum.UserInputType.MouseButton1
                and input.UserInputType ~= Enum.UserInputType.Touch then return end
            if activeDrag or currentlyDragging or UserInputService:GetFocusedTextBox() then return end
            activeDrag = {
                Handle = handle, Row = row, Group = group, Input = input,
                Point = input.Position, Start = input.Position, Moved = false,
                Parent=parent, HeaderHeight=parent.AbsoluteSize.Y, Faded={}, BackgroundTransparency=parent.BackgroundTransparency,
                ScrollingEnabled = group.Scroll.ScrollingEnabled,
            }
            local inset=game:GetService("GuiService"):GetGuiInset()
            activeDrag.OffsetY=input.Position.Y-parent.AbsolutePosition.Y-(mainScreenUI.IgnoreGuiInset and 0 or inset.Y)
            activeDrag.OffsetX=input.Position.X-parent.AbsolutePosition.X-(mainScreenUI.IgnoreGuiInset and 0 or inset.X)
            currentlyDragging = handle
            dragRender = FWNoModules.TrackFrameConnection(G.Services.RunService.RenderStepped:Connect(updateDrag))
            group.Scroll.ScrollingEnabled = false
            handle.TextColor3 = Color3.fromRGB(78, 173, 73)
        end)
        return handle
    end

    connect(UserInputService.InputChanged, function(input)
        local drag = activeDrag
        if not drag then return end
        if drag.Input.UserInputType == Enum.UserInputType.Touch then
            if input ~= drag.Input then return end
        elseif input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        drag.Point = input.Position
        if (drag.Point - drag.Start).Magnitude >= 3 then drag.Moved = true end
        if drag.Moved then updateDrag(0)end
    end)
    connect(UserInputService.InputEnded, function(input)
        if activeDrag and (input == activeDrag.Input
            or (activeDrag.Input.UserInputType == Enum.UserInputType.MouseButton1
                and input.UserInputType == Enum.UserInputType.MouseButton1)) then stopDrag(true) end
    end)
    connect(UserInputService.WindowFocusReleased, function() stopDrag(true) end)
    connect(mainScreenUI:GetPropertyChangedSignal("Enabled"), function()
        if not mainScreenUI.Enabled then stopDrag(true) end
    end)
    updateDrag = function(dt)
        local drag = activeDrag
        if not drag or not drag.Moved then return end
        local scroll = drag.Group.Scroll
        if not drag.Handle:IsDescendantOf(mainScreenUI) or not mainScreenUI.Enabled then
            stopDrag(true)
            return
        end
        if drag.Input.UserInputType==Enum.UserInputType.MouseButton1 and UserInputService.GetMouseLocation then
            drag.Point=UserInputService:GetMouseLocation()
        end
        if not drag.Ghost then
            drag.Ghost=FWNoModules.OwnInstance(drag.Parent:Clone())
            drag.Ghost.Name="ReorderPreview"
            local cloneScale=drag.Ghost:FindFirstChild("FWM_Scale");if cloneScale then cloneScale:Destroy()end
            local ratio=FWNoModules.Mobile.ScaleOf(drag.Parent)
            if ratio~=1 then FWNoModules.OwnInstance(Instance.new("UIScale",drag.Ghost)).Scale=ratio end
            drag.Ghost.Size=UDim2.new(0,drag.Parent.AbsoluteSize.X/ratio,0,drag.HeaderHeight/ratio)
            drag.Ghost.AutomaticSize=Enum.AutomaticSize.None
            drag.Ghost.ZIndex=10000;drag.Ghost.Active=false
            drag.Ghost.Parent=mainScreenUI
            local objects={drag.Parent}
            for _,object in ipairs(drag.Parent:GetDescendants())do objects[#objects+1]=object end
            for _,object in ipairs(objects)do
                if object:IsA("TextLabel")or object:IsA("TextButton")then drag.Faded[object]=object.TextTransparency;object.TextTransparency=0.65 end
            end
            for _,object in ipairs(drag.Ghost:GetDescendants())do if object:IsA("GuiObject")then object.ZIndex=10001;object.Active=false end end
            drag.Parent.BackgroundTransparency=0.8
        end
        local inset = game:GetService("GuiService"):GetGuiInset()
        local y = drag.Point.Y - (mainScreenUI.IgnoreGuiInset and 0 or inset.Y)
        local x = drag.Point.X - (mainScreenUI.IgnoreGuiInset and 0 or inset.X)
        drag.Ghost.Position=UDim2.new(0,x-drag.OffsetX,0,y-drag.OffsetY)
        local probe=y-drag.OffsetY+drag.HeaderHeight/2
        if x < scroll.AbsolutePosition.X - 30
            or x > scroll.AbsolutePosition.X + scroll.AbsoluteSize.X + 30 then return end
        local top = scroll.AbsolutePosition.Y
        local bottom = top + scroll.AbsoluteSize.Y
        local direction = y < top + 28 and -1 or (y > bottom - 28 and 1 or 0)
        local maxY = math.max(0, scroll.AbsoluteCanvasSize.Y - scroll.AbsoluteWindowSize.Y)
        scroll.CanvasPosition = Vector2.new(0, math.clamp(scroll.CanvasPosition.Y + direction * 300 * dt, 0, maxY))
        local rows = drag.Group.Rows
        local oldIndex = table.find(rows, drag.Row)
        local targetIndex = oldIndex
        for index, row in ipairs(rows) do
            if row ~= drag.Row and row.Frame.Visible then
                local middle = row.Frame.AbsolutePosition.Y + row.Frame.AbsoluteSize.Y / 2
                if index < oldIndex and probe < middle then targetIndex = math.min(targetIndex, index) end
                if index > oldIndex and probe > middle then targetIndex = math.max(targetIndex, index) end
            end
        end
        if targetIndex ~= oldIndex then
            table.remove(rows, oldIndex)
            table.insert(rows, targetIndex, drag.Row)
            for index, row in ipairs(rows) do row.Frame.LayoutOrder = index end
        end
    end

