        FWNoModules.Spectator.ValidateSelection()
    end
    FWNoModules.Mobile.AttachUI(mainScreenUI,mainFrame,mainScroll,saveConfigToPC)
    FWNoModules.BuildMenuOptions(mainScreenUI,mainFrame,FW.SettingsOverlay,FW.MenuAddons,saveConfigToPC)
    profiles.Finish()
    profiles.WatchAvailability()
end

