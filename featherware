function gridPos(p)
	return Vector3.new(math.round(p.X / 3), math.round(p.Y / 3), math.round(p.Z / 3))
end

function nkGridOf(point)
	if nkBlockEngine then
		ok, bp = pcall(function() return nkBlockEngine:getBlockPosition(point) end)
		if ok and bp then return bp end
	end
	return gridPos(point)
end

nkHealthCache = {}
pcall(function()
	nkHealthRemote = G.Services.RS:WaitForChild("rbxts_include",5):WaitForChild("node_modules",5):WaitForChild("@rbxts",5):WaitForChild("net",5):WaitForChild("out",5):WaitForChild("_NetManaged",5):WaitForChild("BlockHealthbarUpdate",5)
	FWNoModules.Connect(nkHealthRemote.OnClientEvent, function(d)
		if type(d) ~= "table" or not d.blockPosition then return end
		nkHealthCache[d.blockPosition.X .. "_" .. d.blockPosition.Y .. "_" .. d.blockPosition.Z] = {h = d.newHealth, m = d.maxHealth, t = os.clock()}
	end)
end)

function nkReadHealth(gp)
	if not nkBlockEngine then return nil, nil end
	ok, data = pcall(function() return nkBlockEngine:getStore():getBlockData(gp) end)
	if ok and data then
		h = data:GetAttribute(Player.Name .. "_Health")
		if type(h) ~= "number" then h = data:GetAttribute("Health") end
		if type(h) ~= "number" then
			pcall(function()
				h = data:GetAttribute(tostring(nkBlockEngine:getDefaultHealthKey()))
			end)
		end
		m = data:GetAttribute("MaxHealth")
		if type(h) == "number" then return h, m end
	end
	return nil, nil
end

nkPredicted = {}
function nkPredictHit(block, gp)
	key = gp.X .. "_" .. gp.Y .. "_" .. gp.Z
	maxH = block:GetAttribute("MaxHealth")
	cur = nil
	live, lm = nkReadHealth(gp)
	if nkPredicted[key] then
		cur = nkPredicted[key].h
	else
		cur = live or block:GetAttribute("Health") or maxH
	end
	dmg = nil
	if nkBlockEngine then
		pcall(function() dmg = nkBlockEngine:calculateBlockDamage(Player, {blockPosition = gp}) end)
	end
	if type(dmg) ~= "number" or dmg <= 0 then dmg = (maxH or 100) * 0.1 end
	cur = math.max(0, (cur or maxH or 100) - dmg)
	nkPredicted[key] = {h = cur, m = maxH, t = os.clock()}
	nkHealthCache[key] = {h = cur, m = maxH, t = os.clock()}
	return cur, maxH
end

function nkCellHealth(gp, inst)
	key = gp.X .. "_" .. gp.Y .. "_" .. gp.Z
	c = nkHealthCache[key]
	if c and (os.clock() - c.t) < 6 then return c.h end
	h, m = nkReadHealth(gp)
	if type(h) == "number" then return h end
	if inst then
		h = inst:GetAttribute("Health")
		if type(h) == "number" then return h end
		m = inst:GetAttribute("MaxHealth")
		if type(m) == "number" then return m end
	end
	return 100
end

