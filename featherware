hpBarGui, hpBarBg, hpBarFill, hpBarTarget = nil, nil, nil, nil

function hpBarColor(pct)
	return Color3.fromHSV(math.clamp(pct, 0, 1) * 0.33, 0.75, 0.95)
end

function destroyHpBarNow()
	if hpBarGui then pcall(function() hpBarGui:Destroy() end) end
	hpBarGui = nil; hpBarBg = nil; hpBarFill = nil; hpBarTarget = nil
end

function hideHpBar()
	if not hpBarGui then return end
	hb_gui = hpBarGui; hb_bg = hpBarBg; hb_fill = hpBarFill
	hpBarGui = nil; hpBarBg = nil; hpBarFill = nil; hpBarTarget = nil
	if not hb_gui.Parent then
		pcall(function() hb_gui:Destroy() end)
		return
	end
	pcall(function()
		hb_t = TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		TweenService:Create(hb_bg, hb_t, {BackgroundTransparency = 1}):Play()
		TweenService:Create(hb_fill, hb_t, {BackgroundTransparency = 1}):Play()
	end)
	task.delay(0.25, function() pcall(function() hb_gui:Destroy() end) end)
end

function createHpBar(block)
	destroyHpBarNow()
	hb_gui = Instance.new("BillboardGui")
	hb_gui.Name = "NukerHPBar"
	hb_gui.Adornee = block
	hb_gui.Size = UDim2.new(0, 66, 0, 9)
	hb_gui.StudsOffset = Vector3.new(0, (block.Size.Y / 2) + 1.1, 0)
	hb_gui.AlwaysOnTop = true
	hb_gui.LightInfluence = 0
	hb_gui.MaxDistance = 45

	hb_bg = Instance.new("Frame")
	hb_bg.Size = UDim2.new(1, 0, 1, 0)
	hb_bg.BackgroundColor3 = Color3.fromRGB(15, 15, 18)
	hb_bg.BackgroundTransparency = 0.35
	hb_bg.BorderSizePixel = 0
	hb_bc = Instance.new("UICorner", hb_bg)
	hb_bc.CornerRadius = UDim.new(0, 4)

	hb_fill = Instance.new("Frame")
	hb_fill.Size = UDim2.new(1, -2, 1, -2)
	hb_fill.Position = UDim2.new(0, 1, 0, 1)
	hb_fill.BorderSizePixel = 0
	hb_fc = Instance.new("UICorner", hb_fill)
	hb_fc.CornerRadius = UDim.new(0, 3)
	hb_fill.Parent = hb_bg
	hb_bg.Parent = hb_gui
	hb_gui.Parent = block

	hpBarGui = hb_gui; hpBarBg = hb_bg; hpBarFill = hb_fill; hpBarTarget = block

	hb_max = block:GetAttribute("MaxHealth")
	hb_cur = block:GetAttribute("Health")
	if type(hb_max) == "number" and type(hb_cur) == "number" and hb_max > 0 then
		hb_pct = math.clamp(hb_cur / hb_max, 0, 1)
		hb_fill.Size = UDim2.new(hb_pct, -2, 1, -2)
		hb_fill.BackgroundColor3 = hpBarColor(hb_pct)
	end
end

function updateCustomHpBar(block)
	if not Nuker.Values["Custom HP Bar"] then
		hideHpBar()
		return
	end
	if hpBarTarget and not hpBarTarget.Parent then
		destroyHpBarNow()
	end
	if not block or not block.Parent then
		hideHpBar()
		return
	end
	if block ~= hpBarTarget then
		createHpBar(block)
	end
	if not hpBarFill then return end
	hb_max = block:GetAttribute("MaxHealth")
	hb_cur = block:GetAttribute("Health")
	if type(hb_max) ~= "number" or type(hb_cur) ~= "number" or hb_max <= 0 then
		hideHpBar()
		return
	end
	hb_pct = math.clamp(hb_cur / hb_max, 0, 1)
	pcall(function()
		TweenService:Create(hpBarFill, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = UDim2.new(hb_pct, -2, 1, -2),
			BackgroundColor3 = hpBarColor(hb_pct)
		}):Play()
	end)
end

