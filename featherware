function ShopTierBypassMechanic:Toggle(state)
    self.Revision+=1
    local revision=self.Revision
    self.Enabled = state
	if self.Enabled then
		-- Wait for shop items to load safely
		task.spawn(function()
            repeat
                if not self.Enabled or self.Revision~=revision then return end
                task.wait(.1)
            until bedwarsShop and bedwarsShop.ShopItems
            if not self.Enabled or self.Revision~=revision then return end

			-- Cache and strip tier data
			for _, v in pairs(bedwarsShop.ShopItems) do
				if type(v) == "table" then
					tieredCache[v] = v.tiered
					nextTierCache[v] = v.nextTier
					v.nextTier = nil
					v.tiered = nil
				end
			end

			-- Hook getShop safely
			if not originalGetShop and bedwarsShop.getShop then
				originalGetShop = bedwarsShop.getShop
				FWNoModules.RestoreMethod(bedwarsShop, "getShop")
				bedwarsShop.getShop = function(...)
					local result = originalGetShop(...)
					-- Ensure we return a table, not an Instance
					if type(result) ~= "table" then
						return {}
					end
					return result
				end
			end
		end)
	else
		-- Restore original data
		for v, tiered in pairs(tieredCache) do
			if type(v) == "table" then
				v.tiered = tiered
				v.nextTier = nextTierCache[v]
			end
		end

		-- Restore original function
		if originalGetShop and bedwarsShop then
			bedwarsShop.getShop = originalGetShop
			originalGetShop = nil
		end

		table.clear(tieredCache)
		table.clear(nextTierCache)
	end
end

