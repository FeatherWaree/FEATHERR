            local camera=world.CurrentCamera
            if not camera then return end
            local now=os.clock()
            if camera==cachedCamera and camera.CFrame==cachedCF and now-cachedAt<1/300 then return end
            cachedAt=now;cachedCamera=camera;cachedCF=camera.CFrame
