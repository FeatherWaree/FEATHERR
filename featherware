-- Method 1: __namecall Hook (Instant On Hit detection, zero loop lag)
emberSetupHook = function()
	if emberData.hookActive then return end
	if not hookmetamethod or not getnamecallmethod or not checkcaller then return end

	emberData.hookActive = true
	emberData.oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
		local args = {...}
		local result = emberData.oldNamecall(self, unpack(args))

		if not checkcaller() then
			pcall(function()
				local method = getnamecallmethod()
				if method == "FireServer" or method == "InvokeServer" then
					local remoteName = tostring(self)
					if remoteName == "SwordHit" or remoteName == "ProjectileHit" then
						if loops["auto ember"] and emberSettings.instakillEnabled and emberSettings.instakillMode == "On Hit" then
							if emberIsHoldingSaber() then
								local target = emberGetTarget()
								if target then
									emberFireRelease(target)
								end
							end
						end
					end
				end
			end)
		end
		return result
	end)
end

-- Method 2: EntityDamageEvent Fallback (For non-hook executors)
emberSetupFallback = function()
	if emberData.fallbackConn then return end
	pcall(function()
		local netManaged = ReplicatedStorage:WaitForChild("rbxts_include", 5):WaitForChild("node_modules", 5):WaitForChild("@rbxts", 5):WaitForChild("net", 5):WaitForChild("out", 5):WaitForChild("_NetManaged", 5)
		local entityDamaged = netManaged:WaitForChild("EntityDamageEvent", 5)

		emberData.fallbackConn = entityDamaged.OnClientEvent:Connect(function(data)
			if not loops["auto ember"] then return end
			if not emberSettings.instakillEnabled or emberSettings.instakillMode ~= "On Hit" then return end
			if not emberIsHoldingSaber() then return end

			local involvesMe = false
			if typeof(data) == "table" then
				if data.entityInstance == PlayersService.LocalPlayer.Character or data.fromEntity == PlayersService.LocalPlayer.Character then
					involvesMe = true
				end
			end

			if involvesMe then
				local target = emberGetTarget()
				if target then
					emberFireRelease(target)
				end
			end
		end)
	end)
end

-- LIGHTWEIGHT LOOP (Replaced Heartbeat with task.spawn to save FPS)
emberStartLoop = function()
	if emberData.loopThread then return end

	emberData.loopThread = task.spawn(function()
		while loops["auto ember"] do
			task.wait(0.25) -- 4 checks per second (perfect for melee, 0% lag)

			if not emberSettings.instakillEnabled and not emberSettings.autoReleaseEnabled then continue end

			localPlayer = PlayersService.LocalPlayer
			if localPlayer:GetAttribute("PlayingAsKits") ~= "ember" then
				if not emberData.notified then
					emberSendNotification("Auto Ember", "Ember kit is not equipped!", 5)
					emberData.notified = true
				end
				continue
			end
			emberData.notified = false

			if not emberIsHoldingSaber() then continue end

			now = os.clock()
			if now - emberData.lastRelease < emberSettings.delay then continue end

			target = emberGetTarget()
			if target then
				if emberSettings.instakillEnabled and emberSettings.instakillMode == "Spam" then
					emberFireRelease(target)
					emberData.lastRelease = now
				elseif emberSettings.autoReleaseEnabled then
					emberFireRelease(target)
					emberData.lastRelease = now
				end
			end
		end
	end)
end

emberStart = function()
	emberSetupHook()
	emberSetupFallback()
	emberStartLoop()
end

