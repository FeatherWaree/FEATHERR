function FWNoModules.BuildBindings()
    local api={down={},entries={},muted={},capture=nil}
    _G.IsBindingKey=false
    local service=FWNoModules.Mobile.GetService()
    local pending={}
    local dispatch
    local function enum(group,name)local ok,value=pcall(function()return group[name]end);return ok and value or nil end
    function api.Keys(binding)
        binding=FWNoModules.Profiles and FWNoModules.Profiles.Value(binding)or binding
        if binding==nil then return {}end
        if typeof(binding)=="EnumItem"then return {binding.Name}end
        local source=type(binding)=="table"and(binding.Keys or binding)or{binding}
        local keys,seen={},{}
        for _,key in ipairs(source)do
            local name=typeof(key)=="EnumItem"and key.Name or tostring(key)
            if name~=""and name~="Unknown"and not seen[name]and #keys<4 then
                keys[#keys+1]=name;seen[name]=true
            end
        end
        return keys
    end
    function api.Value(keys)
        keys=api.Keys(keys)
        if #keys==0 then return nil end
        if #keys==1 then return keys[1]end
        return {Version=1,Keys=keys}
    end
    function api.Format(binding)
        local keys=api.Keys(binding)
        if #keys==0 then return "None"end
        return table.concat(keys," + ")
    end
    function api.CallbackValue(binding)
        local keys=api.Keys(binding)
        if #keys==0 then return nil end
        if #keys==1 then local key=enum(Enum.KeyCode,keys[1]);if key then return key end end
        return {Keys=keys,Name=api.Format(keys)}
    end
    function api.Token(input)
        local kind=input.UserInputType.Name
        if input.KeyCode.Name=="MouseBackButton"then return "MouseButton4"end
        if kind=="Keyboard"then return input.KeyCode~=Enum.KeyCode.Unknown and input.KeyCode.Name or nil end
        if kind:match("^MouseButton[1-5]$")then return kind end
    end
    function api.Held(binding)
        local keys=api.Keys(binding);if #keys==0 then return false end
        for _,key in ipairs(keys)do if not api.down[key]then return false end end
        return true
    end
    function api.EventMatches(binding,input)
        local token=api.Token(input)
        for _,key in ipairs(api.Keys(binding))do if key==token then return true end end
        return false
    end
    local function focused()return service:GetFocusedTextBox()~=nil end
    function api.CancelCapture()
        local capture=api.capture;api.capture=nil;_G.IsBindingKey=false
        if FWNoModules.Mobile.CancelKeyPicker then FWNoModules.Mobile.CancelKeyPicker()end
        if capture and capture.cancel then capture.cancel()end
    end
    function api.Reset()
        api.CancelCapture();table.clear(api.down);table.clear(api.muted);table.clear(pending)
        if dispatch then task.cancel(dispatch);dispatch=nil end
        for _,entry in ipairs(api.entries)do entry.active=false end
    end
    function api.Register(get,callback)
        local entry={get=get,callback=callback,active=false}
        table.insert(api.entries,entry)
        return entry
    end
    local function finishCapture(keys)
        local capture=api.capture;if not capture then return end
        api.capture=nil;_G.IsBindingKey=false
        for key in pairs(api.down)do api.muted[key]=true end
        capture.done(api.Value(keys))
    end
    function api.Capture(title,input,done,preview,cancel)
        api.CancelCapture()
        if FWNoModules.Mobile.IsTouchInput(input)and FWNoModules.Mobile.PickKey then
            FWNoModules.Mobile.PickKey(title,function(binding)done(api.Value(binding))end,true)
            return
        end
        api.capture={done=done,preview=preview,cancel=cancel,keys={},held={},order={}}
        _G.IsBindingKey=true
        if preview then preview("Press up to 4 keys together...")end
    end
    local function evaluate()
        dispatch=nil
        local changed=pending;pending={}
        if api.capture or _G.IsBindingKey or focused()or(FWNoModules.Profiles and FWNoModules.Profiles.busy)then return end
        for key in pairs(api.muted)do if api.down[key]then return end end
        local candidates={}
        for _,entry in ipairs(api.entries)do
            local keys=api.Keys(entry.get())
            local touched=false
            for _,key in ipairs(keys)do if changed[key]then touched=true;break end end
            if touched and not entry.active and #keys>0 and api.Held(keys)then
                candidates[#candidates+1]={entry=entry,keys=keys}
            end
        end
        for _,candidate in ipairs(candidates)do
            local subset=false
            for _,other in ipairs(candidates)do
                if #other.keys>#candidate.keys then
                    local inside=true
                    for _,key in ipairs(candidate.keys)do if not table.find(other.keys,key)then inside=false;break end end
                    if inside then subset=true;break end
                end
            end
            if not subset then
                candidate.entry.active=true
                FWNoModules.WithSessionOwner(function()task.spawn(candidate.entry.callback)end)
            end
        end
    end
    FWNoModules.Connect(service.InputBegan,function(input,processed)
        local token=api.Token(input);if not token or api.down[token]then return end
        api.down[token]=true
        local capture=api.capture
        if capture then
            if token=="Escape"or token=="Backspace"then finishCapture({});return end
            if token=="MouseButton1"or token=="MouseButton2"then return end
            capture.held[token]=true
            if not table.find(capture.order,token)then capture.order[#capture.order+1]=token end
            local held={};for _,key in ipairs(capture.order)do if capture.held[key]then held[#held+1]=key end end
            if #held>#capture.keys and #held<=4 then
                capture.keys=held
                if capture.preview then capture.preview(api.Format(held))end
            end
            return
        end
        if processed or focused()or _G.IsBindingKey then return end
        pending[token]=true
        if not dispatch then dispatch=task.delay(.06,evaluate)end
    end)
    FWNoModules.Connect(service.InputEnded,function(input)
        local token=api.Token(input);if not token then return end
        local capture=api.capture
        if capture and capture.held[token]and #capture.keys>0 then finishCapture(capture.keys)end
        if not capture and pending[token]then
            if dispatch then task.cancel(dispatch);dispatch=nil end
            evaluate()
        end
        api.down[token]=nil;api.muted[token]=nil
        for _,entry in ipairs(api.entries)do if entry.active and not api.Held(entry.get())then entry.active=false end end
    end)
    FWNoModules.Connect(service.WindowFocusReleased,api.Reset)
    FWNoModules.OnCleanup(function()api.Reset();table.clear(api.entries)end)
    return api
end
