umaFireProjectile = function(target)
	localPlayer = PlayersService.LocalPlayer
	char = localPlayer.Character
	myRoot = char:FindFirstChild("HumanoidRootPart")
	if not myRoot then return end

	invFolder = ReplicatedStorage:FindFirstChild("Inventories") or ReplicatedStorage:FindFirstChild("inventories")
	playerInv = invFolder and invFolder:FindFirstChild(localPlayer.Name)
	staffInstance = playerInv and playerInv:FindFirstChild("spirit_staff")
	if not staffInstance then return end

	umaLoadMeta()

	itemPos = target:GetPivot().Position + Vector3.new(0, 2, 0)
	itemPos = itemPos + Vector3.new(math.random(-10, 10)/10, math.random(-5, 5)/10, math.random(-10, 10)/10)

	origin = myRoot.Position + Vector3.new(0, 2, 0)
	spawnOrigin = myRoot.Position

	vel, travelTime, reachable = umaSolveVelocity(origin, itemPos, umaData.launchSpeed, umaData.gravity)
	if not reachable or not vel then return end

	fireId = umaGenId()
	shotId = umaGenId()

	args = table.create(9)
	args[1] = staffInstance
	args[2] = nil
	args[3] = "attack_spirit"
	args[4] = origin
	args[5] = spawnOrigin
	args[6] = vel
	args[7] = fireId
	args[8] = {shotId = shotId, drawDurationSec = 0}
	args[9] = G.Services.Workspace:GetServerTimeNow()

	pcall(function()
		umaData.projectileFireRemote:InvokeServer(unpack(args, 1, 9))
	end)

	arrival = os.clock() + travelTime
	table.insert(umaData.activeProjectiles, {
		fireId = fireId,
		hits = {arrival - 0.05, arrival + 0.05, arrival + 0.15},
		nextHit = 1
	})

	umaPlayLegitEffects()
end

umaLoop = function()
	if not loops["auto uma"] then return end

	localPlayer = PlayersService.LocalPlayer
	if localPlayer:GetAttribute("PlayingAsKits") ~= "spirit_summoner" then
		if not umaData.notified then
			umaSendNotification("Auto Uma", "Spirit Summoner kit is not equipped!")
			umaData.notified = true
		end
		return
	end
	umaData.notified = false

	char = localPlayer.Character
	if not char then return end
	handInv = char:FindFirstChild("HandInvItem")
	if not handInv or not handInv.Value or handInv.Value.Name ~= "spirit_staff" then return end

	if not umaLoadRemotes() then return end

	now = os.clock()

	-- 1. Process active projectile hits (3 packets around arrival for reliable registration)
	for i = #umaData.activeProjectiles, 1, -1 do
		proj = umaData.activeProjectiles[i]
		while proj.nextHit <= 3 and now >= proj.hits[proj.nextHit] do
			pcall(function() umaData.projectileHitRemote:FireServer(proj.fireId) end)
			proj.nextHit = proj.nextHit + 1
		end
		if proj.nextHit > 3 then
			table.remove(umaData.activeProjectiles, i)
		end
	end

	myRoot = char:FindFirstChild("HumanoidRootPart")
	if not myRoot then return end

	-- 2. Find nearest target (full 70 stud range)
	nearestTarget = nil
	nearestDist = MAX_RANGE

	for _, item in ipairs(CollectionService:GetTagged("ItemDrop")) do
		if umaIsTargetResource(item) then
			pos = item:GetPivot().Position
			dist = (pos - myRoot.Position).Magnitude
			if dist <= nearestDist then
				nearestDist = dist
				nearestTarget = item
			end
		end
	end

	hasReadySpirits = (localPlayer:GetAttribute("ReadySummonedAttackSpirits") or 0) > 0

	-- 3. Decision Making
	if nearestTarget then
		if hasReadySpirits then
			if now - umaData.lastFire >= FIRE_DELAY then
				umaFireProjectile(nearestTarget)
				umaData.lastFire = now

				if umaData.store then
					pcall(function()
						umaData.store:dispatch({type = "CooldownStart", cooldownId = "attack_spirit", duration = FIRE_DELAY})
					end)
				end
			end
		else
			invFolder = ReplicatedStorage:FindFirstChild("Inventories") or ReplicatedStorage:FindFirstChild("inventories")
			playerInv = invFolder and invFolder:FindFirstChild(localPlayer.Name)
			hasStones = playerInv and playerInv:FindFirstChild("summon_stone") ~= nil

			if hasStones then
				if now - umaData.lastSummon >= SUMMON_DELAY then
					pcall(function() umaData.abilityRemote:FireServer("summon_attack_spirit") end)
					umaData.lastSummon = now

					if umaData.store then
						pcall(function()
							umaData.store:dispatch({type = "CooldownStart", cooldownId = "summon_attack_spirit", duration = SUMMON_DELAY})
						end)
					end
				end
			end
		end
	end
end

