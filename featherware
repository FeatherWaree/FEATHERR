elder_busy = false
function elderAutoLoop()
	if not loops["auto elder"] then return end
	if not AutoElder.Values["Auto Collect"] then return end
	if elder_busy then return end
	if os.clock() - elder_last_collect < 0.6 then return end

	elder_range = AutoElder.Values["Collect Range"] or 10
	elder_orb = elderFindNearestOrb(elder_range)
	if not elder_orb then return end

	elder_busy = true
	elder_mygen = elder_gen

	task.spawn(function()
		task.wait(AutoElder.Values["Collect Delay"] or 0.3)
		if elder_mygen ~= elder_gen or not loops["auto elder"] then elder_busy = false return end

		elder_hrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
		if not elder_hrp or not elder_orb.Parent then elder_busy = false return end
		elder_pos = elderGetPos(elder_orb)
		if not elder_pos or (elder_pos - elder_hrp.Position).Magnitude > (AutoElder.Values["Collect Range"] or 10) then elder_busy = false return end

		if elder_orb:GetAttribute("TreeOrbSecret") then
			if AutoElder.Values["Play Collect Animation"] then elderPlayCollectAnim(); task.wait(0.2) end
			if AutoElder.Values["Play Collect Sound"] then elderPlayCollectSound() end
			if elderFireConsume(elder_orb) then
				elderCleanupEntry(elder_orb)
				elder_esp_set[elder_orb] = nil
				pcall(function() elder_orb:Destroy() end)
			end
			elder_last_collect = os.clock()
		end

		elder_busy = false
	end)
end

