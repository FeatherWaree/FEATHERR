		-- NoSlowdown
		pcall(nsRestore)
		-- FreeCam
		if fc_conn then fc_conn:Disconnect() fc_conn = nil end
		-- XRay
		pcall(xrRestore)
		-- ESP modules (Metal, Star, Bee, Gompy, Sheep, Elder, Generator, Nametags, Item)
		pcall(function() if metal_distConn then metal_distConn:Disconnect() metal_distConn = nil end end)
