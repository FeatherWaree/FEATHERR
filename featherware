-- 1. DEFINE HELPER FUNCTIONS FIRST (Prevents nil reference errors)

local function getSetting(name, def)
	if not Chams or not Chams.Values then return def end
	local val = Chams.Values[name]
	if val == nil then return def end
	return val
end

local function updateAllHighlightProperties()
	if not loops["chams"] then return end

	local fc = getSetting("Cham Color", Color3.fromRGB(140, 120, 255))
	local oc = getSetting("Outline Color", Color3.fromRGB(255, 255, 255))
	local ft = getSetting("Cham Transparency", 0.5)
	local ot = getSetting("Outline Transparency", 0)

	for _, hl in pairs(chams_active) do
		if hl and hl.Parent then
			hl.FillColor = fc
			hl.OutlineColor = oc
			hl.FillTransparency = ft
			hl.OutlineTransparency = ot
		end
	end
end

local function isValidTarget(model)
	if not model or not model.Parent then return false end
	local hum = model:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return false end

	local plr = Players:GetPlayerFromCharacter(model)
	if plr then
		if not getSetting("Target Players", true) then return false end
		if plr == Player then return false end
		local sameTeam = (plr.Team ~= nil and Player.Team ~= nil and plr.Team == Player.Team)
		local isSpec = (plr.Team ~= nil and tostring(plr.Team.Name):lower():find("spectat") ~= nil)
		if sameTeam or isSpec then return false end
		return true
	else
		if not getSetting("Target NPCs/Dummies", false) then return false end
		return true
	end
end

local function chamsRemove(model)
	if chams_active[model] then
		pcall(function() chams_active[model]:Destroy() end)
		chams_active[model] = nil
	end
end

local function chamsMake(model)
	if not loops["chams"] then return end
	if chams_active[model] then return end
	if not isValidTarget(model) then return end

	local ok, hl = pcall(function()
		local h = FWNoModules.OwnInstance(Instance.new("Highlight"))
		h.Adornee = model
		h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		h.FillColor = getSetting("Cham Color", Color3.fromRGB(140, 120, 255))
		h.OutlineColor = getSetting("Outline Color", Color3.fromRGB(255, 255, 255))
		h.FillTransparency = getSetting("Cham Transparency", 0.5)
		h.OutlineTransparency = getSetting("Outline Transparency", 0)
		h.Parent = chamsFolder
		return h
	end)

	if ok and hl then
		chams_active[model] = hl

		FWNoModules.Connect(hl.AncestryChanged, function()
			if not hl.Parent and chams_active[model] == hl then
				chams_active[model] = nil
				if loops["chams"] and isValidTarget(model) then
					task.defer(function()
						chamsMake(model)
					end)
				end
			end
		end)
	end
end

local function chamsReconcileAll()
	if not loops["chams"] then return end

	for _, plr in ipairs(FWNoModules.PlayerSnapshot()) do
		if plr ~= Player then
			local char = plr.Character
			if char and isValidTarget(char) then
				chamsMake(char)
			else
				if char then chamsRemove(char) end
			end
		end
	end

	local npcList = (EntityCache and EntityCache.NPCs) or {}
	for _, npc in ipairs(npcList) do
		if isValidTarget(npc) then
			chamsMake(npc)
		else
			chamsRemove(npc)
		end
	end
end

