function updateCustomHpBar(block)
	if not Nuker.Values["Custom HP Bar"] then
		hideHpBar()
		return
	end
	if hpBarTarget and not hpBarTarget.Parent then destroyHpBarNow() end
	if not block or not block.Parent then
		hideHpBar()
		return
	end
	if block ~= hpBarTarget then createHpBar(block) end
	if not hpBarFill then return end

	gp = nkGridOf(block.Position)
	live, lmax = nkReadHealth(gp)
	if type(live) == "number" then
		hb_cur, hb_max = live, lmax or block:GetAttribute("MaxHealth")
	else
		p = nkPredicted[gp.X .. "_" .. gp.Y .. "_" .. gp.Z]
		if p then
			hb_cur, hb_max = p.h, p.m or block:GetAttribute("MaxHealth")
		else
			hb_cur = block:GetAttribute("Health")
			hb_max = block:GetAttribute("MaxHealth")
		end
	end
	if type(hb_max) ~= "number" or type(hb_cur) ~= "number" or hb_max <= 0 then return end
	hb_pct = math.clamp(hb_cur / hb_max, 0, 1)
	pcall(function()
		FWNoModules.OwnTween(TweenService:Create(hpBarFill, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = UDim2.new(hb_pct, -2, 1, -2),
			BackgroundColor3 = hpBarColor(hb_pct)
		})):Play()
	end)
end

