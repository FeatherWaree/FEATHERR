local function generateRandomString(length)
	local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
	local result = ""
	for i = 1, length do
		local rand = math.random(1, #chars)
		result = result .. string.sub(chars, rand, rand)
	end
	return result
end

local function checkVoidAhead(rootPart)
	local launchDirection = rootPart.CFrame.LookVector.Unit
	local rayOrigin = rootPart.Position + (launchDirection * 3.5)
	local rayDirection = Vector3.new(0, -15, 0)

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {rootPart.Parent}

	local result = G.Services.Workspace:Raycast(rayOrigin, rayDirection, params)
	return result == nil
end

autoFishThread = nil
local oldAutoFishToggle = AutoFish.Callbacks.OnToggle
AutoFish.Callbacks.OnToggle = function(state)
	if oldAutoFishToggle then oldAutoFishToggle(state) end
	loops["auto fish"] = state
	if autoFishThread then task.cancel(autoFishThread) autoFishThread = nil end
	if loops["auto fish"] then
		autoFishThread = task.spawn(function()
			local isFishing = false
			local idleLoopTrack = nil
			while loops["auto fish"] do
				Character = Player.Character
				if not Character then task.wait(0.1) continue end
				rootPart = Character:FindFirstChild("HumanoidRootPart")
				humanoid = Character:FindFirstChild("Humanoid")
				handInvItem = Character:FindFirstChild("HandInvItem")
				if not rootPart or not humanoid or humanoid.Health <= 0 or not handInvItem or not handInvItem.Value then
					isFishing = false
					if idleLoopTrack then idleLoopTrack:Stop() idleLoopTrack = nil end
					task.wait(0.1) continue
				end
				if handInvItem.Value.Name ~= "fishing_rod" then
					isFishing = false
					if idleLoopTrack then idleLoopTrack:Stop() idleLoopTrack = nil end
					task.wait(0.1) continue
				end
				if not isFishing then
					if not checkVoidAhead(rootPart) then task.wait(0.5) continue end
					isFishing = true
					launchDirection = rootPart.CFrame.LookVector.Unit
					inventoryFolder = FWNoModules.GetPrivateInventory(Player.Name)
					if not inventoryFolder then isFishing = false task.wait(0.1) continue end
					inventoryRod = inventoryFolder:WaitForChild("fishing_rod", 3)
					if not inventoryRod then isFishing = false task.wait(0.1) continue end
					playAnims = (AutoFish.Values and AutoFish.Values["Play Casting Anims"]) ~= false
					animator = humanoid:FindFirstChildOfClass("Animator") or humanoid
					if idleLoopTrack then idleLoopTrack:Stop() idleLoopTrack = nil end
					if playAnims then
						castAnim = FWNoModules.OwnInstance(Instance.new("Animation"))
						castAnim.AnimationId = "rbxassetid://7789127251"
						castTrack = FWNoModules.OwnInstance(animator:LoadAnimation(castAnim))
						castTrack.Looped = false
						castTrack:Play()
						task.delay(1.2, function() castAnim:Destroy() end)
					end
					randomShotId = generateRandomString(8)
					randomCode = generateRandomString(8)
					launchOrigin = rootPart.Position + (launchDirection * 3)
					originX, originY, originZ = launchOrigin.X, launchOrigin.Y + 0.5, launchOrigin.Z
					velocityX = launchDirection.X * 12
					velocityY = 4.45
					velocityZ = launchDirection.Z * 12
					fireArgs = { [1] = inventoryRod, [3] = "fisherman_bobber", [4] = vec(originX, originY, originZ), [5] = vec(originX, originY - 2, originZ), [6] = vec(velocityX, velocityY, velocityZ), [7] = randomCode, [8] = { shotId = randomShotId, drawDurationSec = 0 }, [9] = G.Services.Workspace:GetServerTimeNow() }
					pcall(function() if ProjectileRemote then ProjectileRemote:InvokeServer(unpack(fireArgs, 1, 9)) end end)
					task.wait(0.8)
					if playAnims and loops["auto fish"] then
						idleAnim = FWNoModules.OwnInstance(Instance.new("Animation"))
						idleAnim.AnimationId = "rbxassetid://7789132571"
						idleLoopTrack = FWNoModules.OwnInstance(animator:LoadAnimation(idleAnim))
						idleLoopTrack.Looped = true
						idleLoopTrack:Play()
					end
					initialPosition = rootPart.Position
					interrupted = false
					minigameApp = nil
					waitTimer = 0
					minigameWaitTime = (AutoFish.Values and AutoFish.Values["Minigame Wait Time"]) or 1.5
					while waitTimer < 10 and loops["auto fish"] do
						task.wait(0.05)
						waitTimer += 0.05
						hasMoved = (rootPart.Position - initialPosition).Magnitude > 0.5
						isJumping = humanoid.FloorMaterial == Enum.Material.Air
						stillHoldingRod = (handInvItem.Value and handInvItem.Value.Name == "fishing_rod")
						if hasMoved or isJumping or not stillHoldingRod then interrupted = true break end
						playerGui = Player:FindFirstChild("PlayerGui")
						if playerGui then
							actionBar = playerGui:FindFirstChild("ActionBarScreenGui")
							if actionBar and actionBar:FindFirstChild("ActionBar") then
								app = actionBar.ActionBar:FindFirstChild("FishingMinigameApp")
								if app then minigameApp = app break end
							end
						end
					end
					if minigameApp and not interrupted then
						if idleLoopTrack then idleLoopTrack:Stop() idleLoopTrack = nil end
						minigameContainer = minigameApp:FindFirstChild("3") and minigameApp["3"]:FindFirstChild("Minigame")
						elapsedMinigameTime = 0
						autoTrackVisual = (AutoFish.Values and AutoFish.Values["Visual UI Auto-Track"]) ~= false
						minigameInterrupted = false
						while elapsedMinigameTime < minigameWaitTime and minigameApp.Parent ~= nil and loops["auto fish"] do
							task.wait(0.1)
							elapsedMinigameTime += 0.1
							hasMoved = (rootPart.Position - initialPosition).Magnitude > 0.5
							isJumping = humanoid.FloorMaterial == Enum.Material.Air
							if hasMoved or isJumping then minigameInterrupted = true break end
							if autoTrackVisual and minigameContainer then
								marker = minigameContainer:FindFirstChild("Marker")
								fishZone = minigameContainer:FindFirstChild("FishZone")
								if marker and fishZone then fishZone.Position = fishZone.Position:Lerp(marker.Position, 0.35) end
							end
						end
						if minigameInterrupted then
							if playAnims then lostAnim = FWNoModules.OwnInstance(Instance.new("Animation")) lostAnim.AnimationId = "rbxassetid://7789136489" lostTrack = FWNoModules.OwnInstance(animator:LoadAnimation(lostAnim)) lostTrack:Play() task.delay(1.5, function() lostTrack:Stop() lostAnim:Destroy() end) end
							pcall(function() if PullRemote then PullRemote:FireServer({success = false}) end end)
						else
							if playAnims then successAnim = FWNoModules.OwnInstance(Instance.new("Animation")) successAnim.AnimationId = "rbxassetid://7789136489" successTrack = FWNoModules.OwnInstance(animator:LoadAnimation(successAnim)) successTrack:Play() task.delay(1.5, function() successTrack:Stop() successAnim:Destroy() end) end
							pcall(function() if PullRemote then PullRemote:FireServer({success = true}) end end)
						end
						if minigameApp then pcall(function() minigameApp:Destroy() end) end
						task.wait(1.2)
					else
						if idleLoopTrack then idleLoopTrack:Stop() idleLoopTrack = nil end
						pcall(function() if PullRemote then PullRemote:FireServer({success = false}) end end)
						if minigameApp then pcall(function() minigameApp:Destroy() end) end
						task.wait(0.5)
					end
					isFishing = false
				end
				task.wait(0.1)
			end
			if idleLoopTrack then idleLoopTrack:Stop() idleLoopTrack = nil end
			autoFishThread = nil
		end)
	end
end

