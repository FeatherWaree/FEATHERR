	if minerConnections.added then minerConnections.added:Disconnect() minerConnections.added = nil end
	if minerConnections.removed then minerConnections.removed:Disconnect() minerConnections.removed = nil end
	if minerConnections.heartbeat then minerConnections.heartbeat:Disconnect() minerConnections.heartbeat = nil end
	table.clear(minerKnownModels)
