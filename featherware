-- Using weak keys (__mode = "k") so we don't cause memory leaks when the game deletes parts
fpsCache = {
	PartsMat = setmetatable({}, {__mode = "k"}),
	PartsShad = setmetatable({}, {__mode = "k"}),
	Textures = setmetatable({}, {__mode = "k"}),
	Particles = setmetatable({}, {__mode = "k"}),
	GlobalShadows = nil,
	TerrainDeco = nil,
	WaterProps = {},
	StaticParts = {},
	CullingActive = false
}
fpsConnection = nil

function optimizeObj(v)
	if v:IsA("BasePart") then
		if FPSBooster.Values["Smooth Materials"] and v.Material ~= Enum.Material.SmoothPlastic then
			if fpsCache.PartsMat[v] == nil then fpsCache.PartsMat[v] = v.Material end
			v.Material = Enum.Material.SmoothPlastic
		end
		if FPSBooster.Values["Disable Part Shadows"] and v.CastShadow then
			if fpsCache.PartsShad[v] == nil then fpsCache.PartsShad[v] = true end
			v.CastShadow = false
		end
	elseif v:IsA("Texture") or v:IsA("Decal") then
		if FPSBooster.Values["Remove Textures & Decals"] and v.Transparency < 1 then
			if fpsCache.Textures[v] == nil then fpsCache.Textures[v] = v.Transparency end
			v.Transparency = 1
		end
	elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") then
		if FPSBooster.Values["Disable Particles & Beams"] and v.Enabled then
			if fpsCache.Particles[v] == nil then fpsCache.Particles[v] = v.Enabled end
			v.Enabled = false
		end
	end
end
