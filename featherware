function spinStep(dt)
	if not spin.on then return end
	dt = math.min(dt or 0.016, 0.05)       
	char = Player.Character
	hrp  = char and char:FindFirstChild("HumanoidRootPart")
	hum  = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum then return end
	if spin.origAuto == nil then spin.origAuto = hum.AutoRotate end
	hum.AutoRotate = false                

	sp = SpinBot.Values["Speed"] or 50
	ax = SpinBot.Values["Spin X"] and sp * dt or 0
	ay = SpinBot.Values["Spin Y"] and sp * dt or 0
	az = SpinBot.Values["Spin Z"] and sp * dt or 0
	if ax == 0 and ay == 0 and az == 0 then return end

	hrp.CFrame = CFrame.new(hrp.Position) * (CFrame.Angles(ax, ay, az) * hrp.CFrame.Rotation)
end

