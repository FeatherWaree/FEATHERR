            entry.previous=previous
            if not entry.removed then
                retained[#retained+1]=entry
                if entry.enabled then previous=entry.dispatch end
            else runtime.hookForwarders[entry.forwarder]=nil end
        end
        group.entries=retained
        group.head=previous
    end
    function runtime.UpdateFeatureHooks(owner,enabled)
        for _,group in ipairs(runtime.hookGroups)do
            for _,entry in ipairs(group.entries)do if entry.owner==owner then entry.enabled=enabled end end
            rebuildHooks(group)
        end
    end
    function FWNoModules.WrapHook(nativeHook)
        if not nativeHook then return nil end
        return function(object,key,replacement)
            local restoreEntry=runtime.hookForwarders[replacement]
            if restoreEntry and restoreEntry.group.object==object and restoreEntry.group.key==key then
                local previous=restoreEntry.group.head
                restoreEntry.removed=true
                rebuildHooks(restoreEntry.group)
                return previous
            end
            local group
            for _,item in ipairs(runtime.hookGroups)do if item.object==object and item.key==key then group=item;break end end
            if not group then
                if not runtime.active then return nativeHook(object,key,replacement)end
                group={object=object,key=key,entries={},restore=nativeHook}
                group.dispatch=function(...)return group.head(...)end
                group.base=nativeHook(object,key,group.dispatch)
                group.head=group.base
                runtime.hookGroups[#runtime.hookGroups+1]=group
                runtime.hooks[#runtime.hooks+1]=group
            end
