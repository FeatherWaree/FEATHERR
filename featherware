-- GHOST (default): movement untouched, box is just your screen
function stepGhost()
	hrp = getHRP(); if not hrp then return end
	delayE = Desync.Values["Delay"] or 0
	now = tick()
	table.insert(desync.queue, { t = now, cf = hrp.CFrame })
	while #desync.queue > 1 and (now - desync.queue[1].t) > (delayE + 1) do table.remove(desync.queue, 1) end
	show = Desync.Values["Show RootPart"] and delayE > 0 and #desync.queue > 1
	if show and not desync.marker then desync.marker = makeMarker(hrp.CFrame) end
	if (not show) and desync.marker then desync.marker:Destroy(); desync.marker = nil end
	if not show then return end
	targetT = now - delayE; lagCF = desync.queue[1].cf
	for i = 1, #desync.queue do if desync.queue[i].t >= targetT then lagCF = desync.queue[i].cf break end end
	desync.marker.CFrame = lagCF
end

