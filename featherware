local function playEmote(emoteName)
	if emoteName and emoteName ~= "" then

		local character = Player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")

		if not humanoid or humanoid.Health <= 0 then
			warn("Cannot play emote: Player is dead or character missing")
			return
		end

		local localAnimationId = EmoteAnimationData[emoteName]
		if localAnimationId and animator then
			pcall(function()
				local animInstance = FWNoModules.OwnInstance(Instance.new("Animation"))
				animInstance.AnimationId = localAnimationId

				local track = FWNoModules.OwnInstance(animator:LoadAnimation(animInstance))
				track.Priority = Enum.AnimationPriority.Action 
				track:Play()

				local moveConnection
				local jumpConnection

				local function cleanUp()
					if moveConnection then moveConnection:Disconnect(); moveConnection = nil end
					if jumpConnection then jumpConnection:Disconnect(); jumpConnection = nil end
				end

				moveConnection = FWNoModules.Connect(humanoid:GetPropertyChangedSignal("MoveDirection"), function()
					if humanoid.MoveDirection.Magnitude > 0 then
						track:Stop(0.01) -- Smooth fade out
						cleanUp()
					end
				end)

				jumpConnection = FWNoModules.Connect(humanoid:GetPropertyChangedSignal("Jump"), function()
					if humanoid.Jump == true then
						track:Stop(0.1)
						cleanUp()
					end
				end)

				FWNoModules.Connect(track.Stopped, function()
					cleanUp()
				end)

			end)
		else
		end


		Player:SetAttribute("EmoteTypeSlot1", emoteName)

		local args = {
			{
				emoteType = emoteName
			}
		}

		local remoteManaged = G.Services.RS
			:WaitForChild("rbxts_include")
			:WaitForChild("node_modules")
			:WaitForChild("@rbxts")
			:WaitForChild("net")
			:WaitForChild("out")
			:WaitForChild("_NetManaged")
			:WaitForChild("Emote")

		task.spawn(function()
			local success, result = pcall(function()
				return remoteManaged:InvokeServer(unpack(args))
			end)
			if not success then
				warn("Remote invocation failed:", result)
			else
				print("Server responded with:", result)
			end
		end)
	else
		warn("Failed to play emote: Emote.Values['Emote Type'] is empty or nil!")
	end
end

