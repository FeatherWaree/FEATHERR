adetundeApplyBypass = function()
	if adetundeSettings.bypassAnim then
		adetundeSetupAnimHook()

		-- Detect our own upgrade via the remote (works with or without canRequire)
		if not adetundeData.bypassConn then
			pcall(function()
				net = ReplicatedStorage:WaitForChild("rbxts_include", 5):WaitForChild("node_modules", 5):WaitForChild("@rbxts", 5):WaitForChild("net", 5):WaitForChild("out", 5):WaitForChild("_NetManaged", 5)
				rem = net:WaitForChild("FrostyHammerUpgrade", 5)
				adetundeData.bypassConn = rem.OnClientEvent:Connect(function(data)
					isMe = (type(data) == "table" and data.player == Players.LocalPlayer) or data == Players.LocalPlayer
					if isMe then
						adetundeData.upgradeWindowUntil = os.clock() + 2.3
					end
				end)
			end)
		end

		-- Counter the slowdown + remove the table hammer visual during the upgrade window
		if not adetundeData.bypassHb then
			adetundeData.bypassHb = G.Services.RunService.Heartbeat:Connect(function()
				char = Players.LocalPlayer.Character
				hum = char and char:FindFirstChildOfClass("Humanoid")
				if not hum or hum.Health <= 0 then return end
				now = os.clock()
				if now < adetundeData.upgradeWindowUntil then
					if hum.WalkSpeed < adetundeData.normalSpeed then
						hum.WalkSpeed = adetundeData.normalSpeed
					end
					tableHammer = char:FindFirstChild("RepairEnchantTableHammer")
					if tableHammer then tableHammer:Destroy() end
				else
					adetundeData.normalSpeed = hum.WalkSpeed
				end
			end)
		end
	else
		if adetundeData.bypassConn then adetundeData.bypassConn:Disconnect() adetundeData.bypassConn = nil end
		if adetundeData.bypassHb then adetundeData.bypassHb:Disconnect() adetundeData.bypassHb = nil end
	end
