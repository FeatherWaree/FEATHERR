function aadParseNet(...)
	aapn_args = {...}; aapn_tbl = nil
	for aapn_i = 1, #aapn_args do
		if type(aapn_args[aapn_i]) == "table" and typeof(aapn_args[aapn_i].initialVelocity) == "Vector3" then aapn_tbl = aapn_args[aapn_i]; break end
	end
	if aapn_tbl then
		aapn_verdict = aadOwnerVerdictFromShooterModel(aapn_tbl.shooter)
		aapn_ok = aadIngest(aapn_tbl.projectileType, aapn_tbl.initialVelocity, aapn_tbl.positionFrom, aapn_verdict, nil)
	else
		aapn_typ, aapn_vel, aapn_org, aapn_sh = aadScanTypes(aapn_args)
		aapn_verdict = aadOwnerVerdictFromShooterModel(aapn_sh)
		aapn_ok = aadIngest(aapn_typ, aapn_vel, aapn_org, aapn_verdict, nil)
	end
	if aapn_ok and not aad.dNet then aad.dNet = true; aad.srcNet = true end
end

