UserInputService.InputEnded:Connect(function(input)
	if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and adetundeData.dragInfo then
		mousePos = UserInputService:GetMouseLocation()
		inset = GuiService:GetGuiInset()
		screenPos = mousePos - inset

		targetSlot = nil
		for i = 1, 3 do
			f = adetundeData.slotFrames[i]
			if f then
				ap = f.AbsolutePosition
				as = f.AbsoluteSize
				if screenPos.X >= ap.X and screenPos.X <= ap.X + as.X and screenPos.Y >= ap.Y and screenPos.Y <= ap.Y + as.Y then
					targetSlot = i
					break
				end
			end
		end

		drag = adetundeData.dragInfo

		if targetSlot then
			existingInTarget = adetundeData.slotOrder[targetSlot]
			if drag.sourceType == "slot" then
				adetundeData.slotOrder[drag.sourceIndex] = existingInTarget
				adetundeData.slotOrder[targetSlot] = drag.upgradeType
			else
				for i = 1, 3 do
					if adetundeData.slotOrder[i] == drag.upgradeType then
						adetundeData.slotOrder[i] = nil
					end
				end
				adetundeData.slotOrder[targetSlot] = drag.upgradeType
			end
		else
			if drag.sourceType == "slot" then
				adetundeData.slotOrder[drag.sourceIndex] = nil
			end
		end

