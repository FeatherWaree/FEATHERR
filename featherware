function startFlying()
	-- Safety check to prevent duplicate loops making the timer drain double-speed
	if flyConnection then
		flyConnection:Disconnect()
		flyConnection = nil
	end

	char, hrp, hum = getCharacterData()
	if not hrp then return end

	hrp.CFrame = hrp.CFrame + Vector3.new(0, 0.1, 0)
	hum:ChangeState(Enum.HumanoidStateType.Freefall)

	if bodyVelocity then bodyVelocity:Destroy() end
	bodyVelocity = Instance.new("BodyVelocity")
	bodyVelocity.Name = "VerticalFlyForce"
	bodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9) 
	bodyVelocity.Velocity = Vector3.new(0, 0, 0)
	bodyVelocity.Parent = hrp

	isTeleportingDown = false
	currentFlyTime = maxFlyTime
	createFlyUI()

	rayParams = RaycastParams.new()
	rayParams.FilterDescendantsInstances = {char}
	rayParams.FilterType = Enum.RaycastFilterType.Exclude

	-- We use a custom real-time clock to avoid executor deltaTime glitches
	local lastFrameTime = os.clock()

	flyConnection = G.Services.RunService.Heartbeat:Connect(function()
		-- Calculate true real-world time passed since last frame
		local currentFrameTime = os.clock()
		local realDelta = currentFrameTime - lastFrameTime
		lastFrameTime = currentFrameTime

		currentChar, currentHrp, currentHum = getCharacterData()

		if not currentHrp or not currentHum then
			stopFlying()
			return
		end

		if bodyVelocity.Parent ~= currentHrp then
			bodyVelocity.Parent = currentHrp
		end

		rayResult = G.Services.Workspace:Raycast(currentHrp.Position, Vector3.new(0, -15, 0), rayParams)
		distToGround = rayResult and (currentHrp.Position.Y - rayResult.Position.Y) or 999

		-- === Fuel Drain Logic using strictly real time ===
		if not isTeleportingDown then
			if distToGround > 4 then
				currentFlyTime = math.max(0, currentFlyTime - realDelta)
			else
				currentFlyTime = maxFlyTime
			end
		end

		-- === UI Visual Updates ===
		if fuelBarFill and fuelTextLabel then
			-- Drops opacity slightly when empty so it doesn't vanish entirely, keeping the frame clean
			if currentFlyTime <= 0 then
				fuelBarFill.BackgroundTransparency = 1
			else
				fuelBarFill.BackgroundTransparency = 0.1
			end

			fuelBarFill.Size = UDim2.new(currentFlyTime / maxFlyTime, 0, 1, 0)
			fuelTextLabel.Text = string.format("%.1fs", currentFlyTime)
		end

		-- === Timer Depleted: Ground Reset Logic (0.45s) ===
		if currentFlyTime <= 0 and not isTeleportingDown then
			isTeleportingDown = true

			task.spawn(function()
				local originalPosition = currentHrp.CFrame
				local downRay = G.Services.Workspace:Raycast(currentHrp.Position, Vector3.new(0, -500, 0), rayParams)

				if downRay then
					-- Rapid touch-down on the surface
					currentHrp.CFrame = CFrame.new(downRay.Position + Vector3.new(0, 3, 0))
				end

				if bodyVelocity then
					bodyVelocity.Velocity = Vector3.new(0, 0, 0)
				end

				-- Hold on ground for exactly 0.45 seconds
				task.wait(0.45)

				if currentHrp and bodyVelocity then
					-- Teleport back to air position and refill timer
					currentHrp.CFrame = originalPosition
					currentFlyTime = maxFlyTime
					lastFrameTime = os.clock() -- Prevent massive delta drop upon returning
				end

				isTeleportingDown = false
			end)

			return
		end

		if isTeleportingDown then
			return
		end

		-- === Standard Movement Handling (Vertical + W/A/S/D) ===
		targetYVelocity = 0
		local moveDir = Vector3.new(0, 0, 0)

		isTyping = UserInputService:GetFocusedTextBox() ~= nil

		if not isTyping then
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
				targetYVelocity = Fly.Values["Fly Speed"]
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
				targetYVelocity = -Fly.Values["Fly Speed"]
			end

			if currentHum and currentHum.MoveDirection.Magnitude > 0 then
				moveDir = currentHum.MoveDirection * currentHum.WalkSpeed
			end
		end

		bodyVelocity.Velocity = Vector3.new(moveDir.X, targetYVelocity, moveDir.Z)
	end)
end

function stopFlying()
	if flyConnection then
		flyConnection:Disconnect()
		flyConnection = nil
	end
	if bodyVelocity then
		bodyVelocity:Destroy()
		bodyVelocity = nil
	end

	destroyFlyUI()
end

