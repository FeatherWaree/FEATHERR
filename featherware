        else nativeTask[method](thread, ...) end
        if coroutine.status(thread) == "dead" then completed(thread) end
        return thread
    end
    function scope.spawn(callback, ...) return schedule("spawn", nil, callback, ...) end
    function scope.defer(callback, ...) return schedule("defer", nil, callback, ...) end
    function scope.delay(duration, callback, ...) return schedule("delay", duration, callback, ...) end
    function scope.cancel(thread)
