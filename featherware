function FWNoModules.BuildMenuOptions(menu,main,settings,addons,save)
    local api=FWNoModules.MenuOptions or{}
    FWNoModules.MenuOptions=api
    local world=G.Services.Workspace
    local bindings=FWNoModules.Bindings
    local auto=true
    local manual=1
    local blurOn=true
    local intensity=12
    local tooltips=true
    local queued=false
    local manualSlider
    local blurTween,blurComplete
    local blur=FWNoModules.OwnInstance(Instance.new("BlurEffect"))
    blur.Name="Featherware_MenuBlur";blur.Size=0;blur.Enabled=false;blur.Parent=game:GetService("Lighting")
    local function size()local camera=world.CurrentCamera;return camera and camera.ViewportSize or Vector2.new(1920,1080)end
    function api.ScaleFor(available)
        if api.Overview then return api.OverviewScale or .5 end
        local value=manual
        if auto then
            value=FWNoModules.Mobile.TouchEnabled and 1.05 or math.clamp(math.min(available.X/1920,available.Y/1080),.7,1.6)
        end
        return math.min(value,(available.X-20)/320,(available.Y-24)/560)
    end
    local function windows()
        local out={{Frame=main}}
        for _,row in ipairs(addons.CategoryGroup.Rows)do
            local record=addons.Categories[row.ID]
            if record then out[#out+1]=record end
        end
        return out
    end
    local function applyVisibility(record,value)
        local binding=FWNoModules.Profiles.bindings[record.Name.."_CategoryVisibility"]
        if binding then binding.set(value)else record.Frame.Visible=value end
    end
    local function refresh()
        local available=main.Parent.AbsoluteSize
        if available.X<1 or available.Y<1 then available=size()end
        local records=windows()
        local columns,overviewScale=1,0
        if api.Overview then
            for c=1,#records do
                local rows=math.ceil(#records/c)
                local value=math.min((available.X-16-12*(c-1))/(320*c),(available.Y-16-12*(rows-1))/(560*rows))
                if value>overviewScale then columns=c;overviewScale=value end
            end
            api.OverviewScale=math.min(1.6,overviewScale)
        end
        local scale=api.ScaleFor(available)
        for i,record in ipairs(records)do
            local frame=record.Frame
            local uiScale=frame:FindFirstChildOfClass("UIScale")or FWNoModules.OwnInstance(Instance.new("UIScale",frame))
            frame.Size=UDim2.fromOffset(320,560);uiScale.Scale=scale
            if api.Overview then
                local rows=math.ceil(#records/columns)
                local totalW=columns*320*scale+(columns-1)*12
                local totalH=rows*560*scale+(rows-1)*12
                frame.Position=UDim2.fromOffset((available.X-totalW)/2+((i-1)%columns)*(320*scale+12),(available.Y-totalH)/2+math.floor((i-1)/columns)*(560*scale+12))
            end
        end
        if FWNoModules.Mobile.RefreshLayout then FWNoModules.Mobile.RefreshLayout()end
    end
    function api.Refresh()
        if queued then return end
        queued=true;FWNoModules.WithSessionOwner(function()task.defer(function()queued=false;if main.Parent then refresh()end end)end)
    end
    local function applyBlur()
        if blurComplete then FWNoModules.ReleaseConnection(blurComplete);blurComplete=nil end
        if blurTween then blurTween:Cancel()end
        local goal=blurOn and menu.Enabled and intensity or 0
        blur.Enabled=goal>0 or blur.Size>0
        blurTween=FWNoModules.OwnTween(TweenService:Create(blur,TweenInfo.new(.18,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Size=goal}))
        blurComplete=FWNoModules.Connect(blurTween.Completed,function()
            if blurComplete then FWNoModules.ReleaseConnection(blurComplete);blurComplete=nil end
            if goal==0 then blur.Enabled=false end
        end)
        blurTween:Play()
    end
    function api.ResetPositions()
        if addons.EndDrag then addons.EndDrag(false)end
        api.Overview=false
        for _,record in ipairs(windows())do if record.Name then applyVisibility(record,false)end end
        refresh()
        local available=main.Parent.AbsoluteSize
        local scale=api.ScaleFor(available)
        main.Position=UDim2.fromOffset((available.X-320*scale)/2,(available.Y-560*scale)/2)
        for _,record in ipairs(windows())do if record.Name then record.Frame.Position=main.Position end end
        menu.Enabled=true;save()
    end
    function api.SortWindows()
        if addons.EndDrag then addons.EndDrag(false)end
        api.Overview=true
        for _,record in ipairs(windows())do if record.Name then applyVisibility(record,true)end end
        refresh();menu.Enabled=true;save()
    end
    FWNoModules.Profiles.Register("FW_WindowOverview",function()return api.Overview==true end,function(value)api.Overview=value==true;api.Refresh()end,nil,"custom")
    settings:CreateKeybind("GUI Bind",Enum.KeyCode.RightShift,function(value)api.GuiBinding=value end)
    bindings.Register(function()return api.GuiBinding end,function()menu.Enabled=not menu.Enabled end)
    settings:CreateToggle("Blur Background",true,function(value)blurOn=value;applyBlur()end)
    settings:CreateSlider("Blur Intensity",0,56,12,function(value)intensity=value;applyBlur()end,1)
    settings:CreateToggle("Tooltips",true,function(value)tooltips=value;if not value and api.HideTooltip then api.HideTooltip()end end)
    settings:CreateToggle("Auto Rescale",true,function(value)auto=value;if FWNoModules.Profiles.ready and not FWNoModules.Profiles.busy then api.Overview=false end;if manualSlider then manualSlider:SetVisible(not auto)end;api.Refresh()end)
    manualSlider=settings:CreateSlider("GUI Scale",.5,1.75,1,function(value)manual=value;if not auto then if FWNoModules.Profiles.ready and not FWNoModules.Profiles.busy then api.Overview=false end;api.Refresh()end end,.05)
    manualSlider:SetVisible(not auto)
    settings:CreateButton("Reset GUI Positions",api.ResetPositions)
    settings:CreateButton("Sort GUI",api.SortWindows)
    settings:CreateLabel("Side mouse buttons: map to F8 / F9 in mouse software.")
    local tooltip=FWNoModules.OwnInstance(Instance.new("TextLabel",menu))
    tooltip.Name="FWTooltip";tooltip.Visible=false;tooltip.ZIndex=50000
    tooltip.Size=UDim2.fromOffset(240,66);tooltip.BackgroundColor3=Color3.fromRGB(25,25,29)
    tooltip.BorderSizePixel=0;tooltip.TextColor3=Color3.fromRGB(228,228,232)
    tooltip.TextSize=12;tooltip.Font=Enum.Font.Gotham;tooltip.TextWrapped=true
    tooltip.TextXAlignment=Enum.TextXAlignment.Left;tooltip.TextYAlignment=Enum.TextYAlignment.Center
    local pad=FWNoModules.OwnInstance(Instance.new("UIPadding",tooltip));pad.PaddingLeft=UDim.new(0,9);pad.PaddingRight=UDim.new(0,9)
    FWNoModules.OwnInstance(Instance.new("UICorner",tooltip)).CornerRadius=UDim.new(0,6)
    local hovered,hoverTask,moveConnection
    function api.HideTooltip()
        hovered=nil;tooltip.Visible=false
        if hoverTask then task.cancel(hoverTask);hoverTask=nil end
        if moveConnection then FWNoModules.ReleaseConnection(moveConnection);moveConnection=nil end
    end
    local function positionTooltip()
        local point=UserInputService:GetMouseLocation()
        local inset=game:GetService("GuiService"):GetGuiInset()
        local available=size()
        tooltip.Position=UDim2.fromOffset(math.clamp(point.X-inset.X+14,4,math.max(4,available.X-244)),math.clamp(point.Y-inset.Y+16,4,math.max(4,available.Y-100)))
    end
    function api.AttachTooltip(entry,button)
        if button:GetAttribute("FW_TooltipAttached")then return end
        button:SetAttribute("FW_TooltipAttached",true)
        FWNoModules.Connect(button.MouseEnter,function()
            api.HideTooltip()
            if not tooltips or not menu.Enabled or currentlyDragging then return end
            hovered=button
            hoverTask=task.delay(.32,function()
                hoverTask=nil
                if hovered~=button or not button.Parent or not tooltips or not menu.Enabled then return end
                tooltip.Text=entry.Name.."\n"..FWNoModules.DescribeFeature(entry)
                positionTooltip();tooltip.Visible=true
                moveConnection=FWNoModules.Connect(UserInputService.InputChanged,function(input)
                    if input.UserInputType==Enum.UserInputType.MouseMovement then positionTooltip()end
                end)
            end)
        end)
        FWNoModules.Connect(button.MouseLeave,function()if hovered==button then api.HideTooltip()end end)
        FWNoModules.Connect(button.Destroying,function()if hovered==button then api.HideTooltip()end end)
    end
    for button,entry in pairs(FWNoModules.TooltipRegistry)do api.AttachTooltip(entry,button)end
    FWNoModules.OnCleanup(api.HideTooltip)

    local viewportConnection
    local function bindCamera()
        if viewportConnection then FWNoModules.ReleaseConnection(viewportConnection)end
        local camera=world.CurrentCamera
        if camera then viewportConnection=FWNoModules.Connect(camera:GetPropertyChangedSignal("ViewportSize"),api.Refresh)end
        api.Refresh()
    end
    FWNoModules.Connect(world:GetPropertyChangedSignal("CurrentCamera"),bindCamera)
    FWNoModules.Connect(menu:GetPropertyChangedSignal("Enabled"),function()
        applyBlur()
        if not menu.Enabled then bindings.CancelCapture();if api.HideTooltip then api.HideTooltip()end end
    end)
    local before=FWNoModules.Profiles.BeforeSwitch
    FWNoModules.Profiles.BeforeSwitch=function()bindings.Reset();if api.HideTooltip then api.HideTooltip()end;if before then before()end end
    local after=FWNoModules.Profiles.AfterApply
    FWNoModules.Profiles.AfterApply=function()if after then after()end;api.Refresh();applyBlur()end
    FWNoModules.OnCleanup(function()
        if blurComplete then blurComplete:Disconnect()end
        if blurTween then blurTween:Cancel()end
        if viewportConnection then viewportConnection:Disconnect()end
        blur:Destroy()
    end)
    bindCamera();applyBlur()
    return api
end

