local function applyFontToObj(obj)
    pcall(function()
        if not(obj:IsA("TextLabel")or obj:IsA("TextButton")or obj:IsA("TextBox"))or obj:GetAttribute("FW_FontPinned")then return end
        if fontCache[obj]==nil then fontCache[obj]=obj.FontFace end
        obj.FontFace=currentFace
    end)
end
local function stopFontTracking(restore)
    for _,connection in ipairs(fontConnections)do FWNoModules.ReleaseConnection(connection)end
    table.clear(fontConnections)
    if restore then
        for obj,original in pairs(fontCache)do
            pcall(function()if obj.Parent then obj.FontFace=original end end)
        end
        table.clear(fontCache)
    end
end
local function applyFontsToHierarchy(parent)
    for _,object in ipairs(parent:GetDescendants())do applyFontToObj(object)end
    fontConnections[#fontConnections+1]=FWNoModules.Connect(parent.DescendantAdded,applyFontToObj)
end
