-- Full configuration snapshots, typed values, and live transactional profile changes.
FWNoModules.Profiles = {bindings = {}, order = {}, busy = false, ready = false}
do
    local api = FWNoModules.Profiles
    local indexPath = FILE_NAME .. ".profiles.json"
    local manifest = {version = 1, active = "1", nextId = 2, profiles = {{id = "1", name = "Default", path = FILE_NAME}}}
    local baseline = {}
    local cache = {}
    local listeners = {}
    local nilValue = {__fw_type = "Nil"}
    api.Nil = nilValue
    local function encode(value, seen)
        if value == nil or value == nilValue then return {__fw_type = "Nil"} end
        local kind = typeof(value)
        if kind == "Color3" then return {__fw_type = kind, R = value.R, G = value.G, B = value.B} end
        if kind == "Vector3" then return {__fw_type = kind, X = value.X, Y = value.Y, Z = value.Z} end
        if kind == "Vector2" then return {__fw_type = kind, X = value.X, Y = value.Y} end
        if kind == "UDim2" then return {__fw_type = kind, XS = value.X.Scale, XO = value.X.Offset, YS = value.Y.Scale, YO = value.Y.Offset} end
        if kind == "EnumItem" then return {__fw_type = kind, enum = tostring(value.EnumType):gsub("^Enum%.", ""), name = value.Name} end
        if type(value) ~= "table" then return value end
        seen = seen or {}
        if seen[value] then error("Circular configuration value") end
        seen[value] = true
        local result = {}
        for key, item in pairs(value) do result[key] = encode(item, seen) end
        seen[value] = nil
        return result
    end
    local function decode(value)
        if type(value) ~= "table" then return value end
        local kind = value.__fw_type
        if kind == "Nil" then return nilValue end
        if kind == "Color3" then return Color3.new(value.R, value.G, value.B) end
        if kind == "Vector3" then return Vector3.new(value.X, value.Y, value.Z) end
        if kind == "Vector2" then return Vector2.new(value.X, value.Y) end
        if kind == "UDim2" then return UDim2.new(value.XS, value.XO, value.YS, value.YO) end
        if kind == "EnumItem" then return Enum[value.enum][value.name] end
        local result = {}
        for key, item in pairs(value) do result[key] = decode(item) end
        return result
    end
    local function clone(value) return decode(encode(value)) end
    local function equal(a, b)
        if a == b then return true end
        if type(a) ~= "table" or type(b) ~= "table" then return false end
        for key, value in pairs(a) do if not equal(value, b[key]) then return false end end
        for key in pairs(b) do if a[key] == nil then return false end end
        return true
    end
    local function reconcile(destination, source)
        for key in pairs(destination) do if source[key] == nil then destination[key] = nil end end
        for key, value in pairs(source) do
            if type(value) == "table" and value ~= nilValue and type(destination[key]) == "table" and destination[key] ~= nilValue then
                reconcile(destination[key], value)
            else destination[key] = clone(value) end
        end
    end
    local function record(id)
        for _, profile in ipairs(manifest.profiles) do if profile.id == id then return profile end end
    end
    local function read(path)
        if not readfile then return nil end
        local ok, result = pcall(function() return decode(HttpService:JSONDecode(readfile(path))) end)
        if ok and type(result) == "table" then return result end
    end
    local lastWritten={}
    local function write(path, data)
        if not writefile then return false, "File saving is unavailable in this environment." end
        local ok, encoded = pcall(function() return HttpService:JSONEncode(encode(data)) end)
        if not ok then return false, tostring(encoded) end
        if lastWritten[path]==encoded then return true end
        local written, problem = pcall(writefile, path, encoded)
        if written then lastWritten[path]=encoded end
        return written, problem
    end
    local function changed()
        for callback in pairs(listeners) do callback() end
    end
    function api.Subscribe(callback) listeners[callback] = true; return function() listeners[callback] = nil end end
    function api.Value(value) if value ~= nilValue then return value end end
    api.Clone, api.Encode, api.Decode, api.Equal = clone, encode, decode, equal
    local function readBinding(binding)
        local ok,value=pcall(binding.get)
        if ok then binding.last=clone(value);return value end
        local saved=_G.SavedConfig[binding.key]
        if saved~=nil then return api.Value(clone(saved))end
        return api.Value(clone(binding.last))
    end
    function api.Register(key, get, set, owner, kind)
        if api.bindings[key] then return end
        local binding = {key = key, get = get, set = set, owner = owner, kind = kind}
        binding.default = clone(readBinding(binding))
        api.bindings[key] = binding
        api.order[#api.order + 1] = binding
        if _G.SavedConfig[key] ~= nil and kind == "custom" then set(api.Value(clone(_G.SavedConfig[key]))) end
    end
    function api.Snapshot()
        local result = clone(_G.SavedConfig)
        for _,binding in ipairs(api.order)do
            local pending=api.pending and api.pending[binding.key]
            if pending then
                local desired=_G.SavedConfig[binding.key]
                if desired==nil then desired=pending.value end
                result[binding.key]=clone(desired)
            else result[binding.key]=clone(readBinding(binding))end
        end
        return result
    end
    function api.GetProfiles() return manifest.profiles end
    function api.GetActive() return manifest.active end
    function api.PrepareUnload()
        if not api.unloadSnapshot then api.unloadSnapshot=api.busy and api.transitionSnapshot or api.Snapshot()end
    end
    function api.Flush()
        if api.busy and not api.unloadSnapshot then return true end
        local profile = record(manifest.active)
        local snapshot = api.unloadSnapshot or api.Snapshot()
        local ok, problem = write(profile.path, snapshot)
        if not ok then return false, problem end
        cache[profile.id] = snapshot
        return write(indexPath, manifest)
    end
    _G.SavedConfig = decode(_G.SavedConfig)
    local loadedIndex = read(indexPath)
    if loadedIndex and loadedIndex.version == 1 and type(loadedIndex.profiles) == "table" then
        local valid = {}
        for _, item in ipairs(loadedIndex.profiles) do
            if type(item.id) == "string" and item.id:match("^%d+$") and type(item.name) == "string" then
                item.path = item.id == "1" and FILE_NAME or (FILE_NAME .. ".profile_" .. item.id .. ".json")
                valid[#valid + 1] = item
            end
        end
        if #valid > 0 then
            manifest = loadedIndex
            manifest.profiles = valid
            local maxId = 1
            for _, item in ipairs(valid) do maxId = math.max(maxId, tonumber(item.id)) end
            manifest.nextId = math.max(tonumber(manifest.nextId) or 2, maxId + 1)
            local active = record(manifest.active) or valid[1]
            local saved = read(active.path)
            if saved then _G.SavedConfig = saved; manifest.active = active.id
            else
                -- Recover a readable profile without overwriting a corrupt/missing one.
                local recovered
                for _, item in ipairs(valid) do local data = read(item.path); if data then recovered = item; _G.SavedConfig = data; break end end
                if recovered then manifest.active = recovered.id else manifest = {version=1,active="1",nextId=2,profiles={{id="1",name="Default",path=FILE_NAME}}} end
            end
        end
    else
        -- Migrate legacy saves, including any typed values from a previous version.
        _G.SavedConfig = decode(_G.SavedConfig)
    end
    -- Profile selection commits settings even when a place lacks a feature's
    -- modules. Apply jobs have a bounded lifetime and belong to one selection.
    api.pending={}
    local applyGeneration=0
    local applyTask=task
    local function unavailable(problem)
        local message=tostring(problem):lower()
        for _,part in ipairs({"attempt to index nil","attempt to call a nil","not a valid member","not found","not available","unavailable","not ready","waitforchild","infinite yield","lacking capability","required module","to 'require'","cannot require"})do
            if message:find(part,1,true)then return true end
        end
        return false
    end
    local function cancelJob(job)
        if not applyTask then return end
        local current=coroutine.running()
        for _,thread in ipairs({job.thread,job.timeout})do
            if thread and thread~=current then pcall(applyTask.cancel,thread)end
        end
    end
    function api.CancelPending()
        applyGeneration+=1
        for _,job in pairs(api.pending)do cancelJob(job)end
        table.clear(api.pending)
    end
    function api.TouchBinding(key)
        if api.busy then return end
        local job=api.pending[key]
        if not job or job.thread==coroutine.running()then return end
        cancelJob(job);api.pending[key]=nil
    end
    local function suspend(job,problem)
        job.problem=tostring(problem)
        local owner=job.owner
        if owner then
            owner.ProfilePending=true
            if FWNoModules.CancelFeature then FWNoModules.CancelFeature(owner)end
            if FWNoModules.CleanupFeatureObjects then FWNoModules.CleanupFeatureObjects(owner)end
            if owner.ProfileLoopKey and FWNoModules.SetLoop then FWNoModules.SetLoop(owner.ProfileLoopKey,false)end
        end
    end
    local function resumeOwner(owner)
        if not owner or not owner.ProfilePending or not owner.Toggled or not owner.ProfileToggleKey then return end
        for _,job in pairs(api.pending)do if job.owner==owner then return end end
        api.TryApply(owner.ProfileToggleKey,function(value)owner:SetProfileState(value)end,true,owner)
    end
    function api.TryApply(key,callback,value,owner,stopping)
        local job={key=key,callback=callback,value=clone(value),owner=owner,generation=applyGeneration}
        local previous=api.pending[key];if previous then cancelJob(previous)end
        api.pending[key]=job
        local function run()
            job.thread=coroutine.running()
            local ok,problem=pcall(callback,api.Value(job.value))
            job.finished=true;job.ok=ok;job.problem=problem
            if job.generation~=applyGeneration or api.pending[key]~=job then return end
            if ok then
                api.pending[key]=nil
                if job.timeout and applyTask then pcall(applyTask.cancel,job.timeout)end
                resumeOwner(owner)
            elseif not stopping then suspend(job,problem)end
        end
        if applyTask then
            local function start()job.thread=applyTask.spawn(run)end
            if FWNoModules.WithSessionOwner then FWNoModules.WithSessionOwner(start)else start()end
        else run()end
        if stopping then
            -- Tracked feature work is already cancelled. Do not allow a yielding
            -- old-place cleanup to resume after the next profile has started.
            cancelJob(job);api.pending[key]=nil
            return true
        end
        if job.finished then
            if not job.ok and not unavailable(job.problem)and not(owner and key==owner.ProfileToggleKey)then error(job.problem,0)end
            return job.ok
        end
        local function timeout()
            if api.pending[key]~=job or job.generation~=applyGeneration or job.finished then return end
            cancelJob(job);job.finished=true;job.ok=false
            suspend(job,"Feature dependencies are not ready in this place.")
        end
        local function schedule()job.timeout=applyTask.delay(.75,timeout)end
        if FWNoModules.WithSessionOwner then FWNoModules.WithSessionOwner(schedule)else schedule()end
        return false
    end
    function api.RetryDeferred()
        if api.busy or not api.ready then return end
        local jobs={}
        for _,job in pairs(api.pending)do if job.finished then jobs[#jobs+1]=job end end
        for _,job in ipairs(jobs)do
            local desired=_G.SavedConfig[job.key]
            if desired==nil then desired=job.value end
            pcall(api.TryApply,job.key,job.callback,api.Value(clone(desired)),job.owner)
        end
        if _G.__FW_REFRESH_MODULE_LIST then _G.__FW_REFRESH_MODULE_LIST()end
    end
    function api.WatchAvailability()
        if api.availabilityConnected or not FWNoModules.Connect then return end
        api.availabilityConnected=true
        local queued=false
        local function changed()
            if not next(api.pending)or queued then return end
            queued=true
            applyTask.delay(.2,function()queued=false;api.RetryDeferred()end)
        end
        local players=game:GetService("Players")
        local player=players.LocalPlayer
        if player then
            local characterConnection
            local function watchCharacter(character)
                if characterConnection then FWNoModules.ReleaseConnection(characterConnection)end
                characterConnection=FWNoModules.Connect(character.ChildAdded,function(object)
                    if object.Name=="HumanoidRootPart"or object:IsA("Humanoid")then changed()end
                end)
                changed()
            end
            FWNoModules.Connect(player.CharacterAdded,watchCharacter)
            if player.Character then watchCharacter(player.Character)end
            local scripts=player:FindFirstChild("PlayerScripts")
            if scripts then FWNoModules.Connect(scripts.DescendantAdded,function(object)if object:IsA("ModuleScript")then changed()end end)end
        end
        FWNoModules.Connect(game:GetService("ReplicatedStorage").DescendantAdded,function(object)
            if object:IsA("ModuleScript")or object:IsA("RemoteFunction")or object:IsA("RemoteEvent")then changed()end
        end)
    end
    if FWNoModules.OnCleanup then FWNoModules.OnCleanup(api.CancelPending)end

    local function replay(data)
        local affected = {}
        local differences = {}
        for _, binding in ipairs(api.order) do
            local value = data[binding.key]
            if value == nil then value = baseline[binding.key];if value==nil then value=binding.default end end
            if api.pending[binding.key]or(binding.owner and binding.owner.ProfilePending)or not equal(encode(readBinding(binding)), encode(value)) then
                differences[#differences + 1] = {binding = binding, value = clone(value)}
                if binding.owner and binding.owner.Toggled ~= nil then affected[binding.owner] = true end
            end
        end
        api.CancelPending()
        for owner in pairs(affected)do
            if owner.Toggled then
                if FWNoModules.CancelFeature then FWNoModules.CancelFeature(owner)end
                api.TryApply("__stop_"..tostring(owner),function()owner:StopForUnload()end,nil,owner,true)
            end
        end
        reconcile(_G.SavedConfig, data)
        for _, change in ipairs(differences) do
            if change.binding.kind~="module"then
                api.TryApply(change.binding.key,change.binding.set,api.Value(change.value),change.binding.owner)
            end
        end
        if api.AfterApply then api.TryApply("__after_apply",api.AfterApply,nil)end
        for owner in pairs(affected) do
            local enabled = api.Value(data[owner.ProfileToggleKey]) == true
            api.TryApply(owner.ProfileToggleKey,function(value)owner:SetProfileState(value)end,enabled,owner)
        end
        if _G.__FW_REFRESH_MODULE_LIST then _G.__FW_REFRESH_MODULE_LIST()end
    end
    function api.Select(id, skipSave)
        if api.busy or not api.ready then return false, "A profile change is already in progress." end
        if id==manifest.active then return true end
        local target = record(id)
        if not target then return false, "Profile not found." end
        local incoming = cache[id] or read(target.path)
        if not incoming then return false, "This profile could not be read." end
        if api.BeforeSwitch then pcall(api.BeforeSwitch)end
        local previous = api.Snapshot()
        if not skipSave then local ok, problem = api.Flush(); if not ok then return false, problem end end
        api.transitionSnapshot=previous
        api.busy = true
        if api.OnBusy then api.OnBusy(true) end
        _G.IsBindingKey = false
        local ok, problem = pcall(replay, clone(incoming))
        if ok then
            local snapshot=api.Snapshot()
            local stored,reason=write(target.path,snapshot)
            if stored then cache[id]=snapshot else ok=false;problem=reason end
        end
        if ok then
            local oldId = manifest.active
            manifest.active = id
            local written, reason = write(indexPath, manifest)
            if not written then manifest.active = oldId; ok = false; problem = reason end
        end
        if not ok then pcall(replay, previous) end
        api.busy = false
        api.transitionSnapshot=nil
        if api.OnBusy then api.OnBusy(false) end
        changed()
        return ok, problem
    end
    function api.Add(name)
        if api.busy or not api.ready then return false, "Please wait for the current change." end
        local ok, problem = api.Flush(); if not ok then return false, problem end
        local id = tostring(manifest.nextId)
        local item = {id = id, name = name ~= "" and name or "Unnamed profile", path = FILE_NAME .. ".profile_" .. id .. ".json"}
        local snapshot = api.Snapshot()
        ok, problem = write(item.path, snapshot); if not ok then return false, problem end
        manifest.nextId += 1
        manifest.profiles[#manifest.profiles + 1] = item
        local oldId = manifest.active
        manifest.active = id
        ok, problem = write(indexPath, manifest)
        if not ok then manifest.active = oldId; table.remove(manifest.profiles); return false, problem end
        cache[id] = snapshot
        changed()
        return true, id
    end
    function api.Rename(id, name)
        local item = record(id)
        if api.busy or not item then return false, "Profile not found." end
        local previous = item.name
        item.name = name ~= "" and name or "Unnamed profile"
        local ok, problem = write(indexPath, manifest)
        if not ok then item.name = previous else changed() end
        return ok, problem
    end
    function api.Delete(id)
        if api.busy then return false, "Please wait for the current change." end
        local item = record(id)
        if not item then return false, "Profile not found." end
        if #manifest.profiles == 1 then
            local ok, problem = api.Add("Default"); if not ok then return false, problem end
        elseif manifest.active == id then
            for _, other in ipairs(manifest.profiles) do
                if other.id ~= id then local ok, problem = api.Select(other.id); if not ok then return false, problem end; break end
            end
        end
        local index = table.find(manifest.profiles, item)
        table.remove(manifest.profiles, index)
        local ok, problem = write(indexPath, manifest)
        if not ok then table.insert(manifest.profiles, index, item); return false, problem end
        cache[id] = nil
        if delfile then pcall(delfile, item.path) end
        changed()
        return true
    end
    function api.Finish()
        baseline = api.Snapshot()
        api.ready = true
        api.Flush()
    end
end

-- Update in-memory settings immediately. Coalesce disk writes during drags.
local saveConfigToPC
do
    local runtime = FWNoModules.Runtime
    local pending
    local function flush()
        if pending then task.cancel(pending); pending = nil end
        local ok, problem=FWNoModules.Profiles.Flush()
        if not ok then warn("[Featherware] Could not save profile: "..tostring(problem)) end
    end
    saveConfigToPC = function(force)
        if force then flush(); return end
        if not writefile or not runtime.active or pending or FWNoModules.Profiles.busy then return end
        pending = task.delay(0.25, function()
            pending = nil
            if runtime.active then flush() end
        end)
    end
    runtime.FlushConfig = flush
    local configPlayer = game:GetService("Players").LocalPlayer
    FWNoModules.Connect(configPlayer.OnTeleport, flush)
end


