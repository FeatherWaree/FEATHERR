evelynnTryCollect = function(orbModel)
	if not loops["auto evelynn"] then return end
	if not orbModel or not orbModel.Parent then return end
	if evelynnData.activeOrbs[orbModel] then return end

	-- Get the secret attribute
	secret = orbModel:GetAttribute("SpiritSecret")
	if not secret then return end

	if not evelynnLoadRemote() then return end

	-- Mark as active to prevent double-firing
	evelynnData.activeOrbs[orbModel] = true

	task.spawn(function()
		-- Apply user-configured delay
		delayTime = AutoEvelynn.Values["Delay"] or 0
		if delayTime > 0 then
			task.wait(delayTime)
		end

		-- Re-check validity after delay
		if not loops["auto evelynn"] or not orbModel.Parent then 
			evelynnData.activeOrbs[orbModel] = nil
			return 
		end

		-- Fire the remote
		pcall(function()
			evelynnData.remote:InvokeServer({secret = secret})
		end)

		-- Cleanup cache after a short delay
		task.wait(0.5)
		evelynnData.activeOrbs[orbModel] = nil
	end)
end

evelynnStart = function()
	-- Scan for existing orbs
	for _, obj in ipairs(CollectionService:GetTagged("EvelynnSoul")) do
		if obj:IsA("Model") and obj.Name == "SpiritOrb" then
			task.spawn(evelynnTryCollect, obj)
		end
	end

	-- Also scan G.Services.Workspace directly just in case the tag hasn't applied yet
	for _, obj in ipairs(G.Services.Workspace:GetDescendants()) do
		if obj:IsA("Model") and obj.Name == "SpiritOrb" then
			task.spawn(evelynnTryCollect, obj)
		end
	end

	-- Listen for new orbs spawning (Event-driven, zero lag)
	table.insert(evelynnData.connections, CollectionService:GetInstanceAddedSignal("EvelynnSoul"):Connect(function(obj)
		if loops["auto evelynn"] and obj:IsA("Model") and obj.Name == "SpiritOrb" then
			-- Tiny yield to ensure the SpiritSecret attribute has replicated from the server
			task.wait(0.05)
			task.spawn(evelynnTryCollect, obj)
		end
	end))

	-- Listen for G.Services.Workspace descendants as a fallback
	table.insert(evelynnData.connections, G.Services.Workspace.DescendantAdded:Connect(function(obj)
		if loops["auto evelynn"] and obj:IsA("Model") and obj.Name == "SpiritOrb" then
			task.wait(0.05)
			task.spawn(evelynnTryCollect, obj)
		end
	end))

	-- Cleanup removed orbs
	table.insert(evelynnData.connections, G.Services.Workspace.DescendantRemoving:Connect(function(obj)
		if evelynnData.activeOrbs[obj] then
			evelynnData.activeOrbs[obj] = nil
		end
	end))
end

evelynnStop = function()
	for _, conn in ipairs(evelynnData.connections) do
		pcall(function() conn:Disconnect() end)
	end
	evelynnData.connections = {}
	evelynnData.activeOrbs = {}
end

