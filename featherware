function vaCalcAngles(from, to)
	va_d = to - from
	va_mag = va_d.Magnitude
	if va_mag < 0.01 then return nil, nil end
	va_dx, va_dy, va_dz = va_d.X / va_mag, va_d.Y / va_mag, va_d.Z / va_mag
	va_yaw = math.atan2(-va_dx, -va_dz)
	va_pitch = math.asin(math.clamp(va_dy, -1, 1))
	va_pitch = math.clamp(va_pitch, -0.8, 0.8)
	return va_yaw, va_pitch
end

