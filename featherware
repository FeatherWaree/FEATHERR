-- One startup report. No relay, dashboard, user-list polling or ongoing telemetry.
function FWNoModules.CreateStartupWebhook(deps)
    local api={}
    local function validURL(value)
        if type(value)~="string"then return nil end
        local url=value:match("^%s*(.-)%s*$")
        local host,path=url:match("^https://([^/]+)(/[^?#]*)$")
        if host~="discord.com"and host~="discordapp.com"then return nil end
        if not path:match("^/api/webhooks/%d+/[%w%._%-]+$")and not path:match("^/api/v%d+/webhooks/%d+/[%w%._%-]+$")then return nil end
        return url
    end
    api.ValidateURL=validURL
    function api.Send(url)
        if url==""or url==nil then return false,"not configured"end
        url=validURL(url)
        if not url then deps.Notify("Startup webhook URL is invalid. Use the full Discord webhook URL.");return false,"invalid URL"end
        if type(deps.Request)~="function"then deps.Notify("This runtime has no HTTP request function. The startup report was not sent.");return false,"HTTP unavailable"end
        local key=deps.SessionKey().."|"..url
        local prior=deps.Sent[key]
        if prior and(prior.sent or(prior.runtime and prior.runtime.active))then return false,"already reported"end
        local record={runtime=deps.Runtime}
        deps.Sent[key]=record
        deps.OnCleanup(function()if deps.Sent[key]==record and not record.sent then deps.Sent[key]=nil end end)
        deps.Notify("This Featherware build sends one Discord startup report: your Roblox account, server and enabled feature names.")
        deps.Spawn(function()
            local encoded,body=pcall(function()return deps.Encode(deps.Payload())end)
            if not encoded then
                if deps.Sent[key]==record then deps.Sent[key]=nil end
                deps.Notify("The Discord startup report could not be encoded.")
                return
            end
            for attempt=1,2 do
                if not deps.Runtime.active or deps.Sent[key]~=record then return end
                local ok,response=pcall(deps.Request,{Url=url,Method="POST",Headers={["Content-Type"]="application/json"},Body=body,
                    Redirect=false,FollowRedirects=false})
                local status=ok and type(response)=="table"and tonumber(response.StatusCode or response.Status)or 0
                if status>=200 and status<300 then record.sent=true;record.runtime=nil;return end
                if status==429 and attempt==1 then
                    local delay=5
                    if type(response.Body)=="string"then
                        local parsed,data=pcall(deps.Decode,response.Body)
                        if parsed and type(data)=="table"then delay=math.clamp(tonumber(data.retry_after)or 5,1,30)end
                    end
                    deps.Wait(delay)
                else
                    if deps.Sent[key]==record then deps.Sent[key]=nil end
                    deps.Notify("Discord startup report failed (HTTP "..status.."). Check the webhook URL and permissions.")
                    return
                end
            end
        end)
        return true
    end
    return api
end

function FWNoModules.InstallStartupWebhook()
    local PlayersService=game:GetService("Players")
    local Http=game:GetService("HttpService")
    local localPlayer=PlayersService.LocalPlayer
    local requestFunction=request or http_request or(syn and syn.request)
    FWNoModules.Runtime.startupWebhookSent=FWNoModules.Runtime.startupWebhookSent or{}
    local sent=FWNoModules.Runtime.startupWebhookSent
    local function clean(value)return tostring(value):gsub("[`*_~|]","")end
    local reporter=FWNoModules.CreateStartupWebhook({
        Runtime=FWNoModules.Runtime,Sent=sent,Request=requestFunction,
        SessionKey=function()return localPlayer.UserId.."|"..game.PlaceId.."|"..(game.JobId~=""and game.JobId or"studio")end,
        Notify=function(message)pcall(NotificationSystem.Notify,"Discord startup report",message,8)end,
        OnCleanup=FWNoModules.OnCleanup,
        Spawn=function(fn)return FWNoModules.WithSessionOwner(function()return task.spawn(fn)end)end,
        Wait=task.wait,Encode=function(value)return Http:JSONEncode(value)end,Decode=function(value)return Http:JSONDecode(value)end,
        Payload=function()
            local features,seen={},{}
            for _,entry in ipairs(FW.MenuAddons.Modules)do
                if entry.Mod and entry.Mod.Toggled then
                    local name=clean(entry.CategoryName.."/"..entry.Name)
                    if not seen[name]then seen[name]=true;features[#features+1]=name end
                end
            end
            table.sort(features)
            local featureText=#features>0 and table.concat(features,"\n")or"None"
            if #featureText>980 then
                local boundary=utf8.offset(featureText,0,950)or 950
                featureText=featureText:sub(1,boundary-1).."\n… list truncated"
            end
            local fields={
                {name="Roblox account",value=clean(localPlayer.DisplayName).." (@"..clean(localPlayer.Name)..")\nUserId: "..localPlayer.UserId},
                {name="Server",value="PlaceId: "..game.PlaceId.."\nJobId: "..(game.JobId~=""and game.JobId or"Studio")},
                {name="Enabled features at startup ("..#features..")",value=featureText},
                {name="Report",value="One startup snapshot. Feature activity is self-reported, not verified detection."}
            }
            return {username="Featherware",allowed_mentions={parse={}},embeds={{
                title="Featherware started",color=5156169,fields=fields,timestamp=DateTime.now():ToIsoDate(),
                footer={text="No ongoing tracking or relay. Startup snapshot only."}
            }}}
        end
    })
    reporter.Send(FW_STARTUP_WEBHOOK.URL)
end


