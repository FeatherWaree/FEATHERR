laniDoTP = function(humanoid)
	if laniData.isConsuming then return end

	now = os.clock()
	if now - laniData.lastTP < LANI_INTERNAL_COOLDOWN then return end

	target = laniGetTarget()
	if not target then return end
	if not laniLoadRemotes() then return end

	holding = laniHoldingScepter()
	if not holding then
		if not laniSettings.autoSwap then return end
		if not laniGetScepterInstance() then return end
		holding = laniDoSwap()
		if not holding then return end
	end

	laniData.isConsuming = true
	laniData.lastTP = now

	pcall(function()
		laniPlayGameSound("LANI_SUMMON", 0.4)
		laniApplySlow(humanoid)

		animator = humanoid:FindFirstChildOfClass("Animator")
		if animator then
			laniData.consumeAnim = Instance.new("Animation")
			laniData.consumeAnim.AnimationId = LANI_CONSUME_ANIM
			laniData.consumeTrack = animator:LoadAnimation(laniData.consumeAnim)
			stopped = false
			laniData.consumeTrack.Stopped:Connect(function() stopped = true end)
			laniData.consumeTrack:Play(0)

			deadline = os.clock() + 3
			while not stopped and os.clock() < deadline and loops["auto lani"] and laniHoldingScepter() do
				task.wait()
			end
			pcall(function() laniData.consumeTrack:Stop() end)
		else
			task.wait(0.8)
		end

		laniRemoveSlow(humanoid)

		-- cancel if swapped away mid-charge or toggled off
		if not loops["auto lani"] or not laniHoldingScepter() then return end

		scepter = laniGetScepterInstance()
		if scepter then
			laniData.consumeRemote:InvokeServer({item = scepter})
		end

		task.wait(0.8)
		if not loops["auto lani"] then return end

		laniData.abilityRemote:FireServer("PALADIN_ABILITY")
		task.wait(0.1)
		laniData.paladinRemote:FireServer({target = target})

		task.wait(0.4)
		laniPlayGameSound("LANI_LANDING", 0.5)
	end)

	if laniData.consumeTrack then pcall(function() laniData.consumeTrack:Destroy() end) laniData.consumeTrack = nil end
	if laniData.consumeAnim then pcall(function() laniData.consumeAnim:Destroy() end) laniData.consumeAnim = nil end
	laniRemoveSlow(humanoid)
	laniData.isConsuming = false
end

