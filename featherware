local function IsOnVoidOrBridge(hrp)
	SharedRayParams.FilterDescendantsInstances = {hrp.Parent}
	pos = hrp.Position
	down = Vector3.new(0, -20, 0)
	if not G.Services.Workspace:Raycast(pos, down, SharedRayParams) then return true end
	right = hrp.CFrame.RightVector * 4
	forward = hrp.CFrame.LookVector * 4
	if not G.Services.Workspace:Raycast(pos + right, down, params) or not G.Services.Workspace:Raycast(pos - right, down, params) or
		not G.Services.Workspace:Raycast(pos + forward, down, params) or not G.Services.Workspace:Raycast(pos - forward, down, params) then
		return true 
	end
	return false
end

