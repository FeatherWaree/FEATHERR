function normalizeAssetId(id)
	id = tostring(id or "")
	if id == "" then return "" end
	if id:find("^rbxassetid://") then return id end
	if id:find("^%d+$") then return "rbxassetid://" .. id end

	-- Replaced 'local digits' with a unique global to prevent allocation limit leaks
	capeDigitsMatch = id:match("(%d+)")
	if capeDigitsMatch then return "rbxassetid://" .. capeDigitsMatch end
	return id
end

function removeCape()
	if capePart and capePart.Parent then
		capePart:Destroy()
	end
	capePart = nil
	capeDecal = nil
	capeWeld = nil

	if game:GetService("Players").LocalPlayer.Character then
		for _, desc in ipairs(game:GetService("Players").LocalPlayer.Character:GetDescendants()) do
			if desc:IsA("BasePart") and desc.Name ~= "HumanoidRootPart" then
				-- BUG FIX: Only reset transparency if the Transparency ability is turned OFF
				if not loops["transparency"] then
					desc.LocalTransparencyModifier = 0
				end
			end
		end
	end
end

function applyCapeSkin()
	if not capePart or not capePart.Parent then return end
	capeImageId = normalizeAssetId(Cape.Values["Image ID"])

	if capeDecal then
		capeDecal:Destroy()
		capeDecal = nil
	end

	if capeImageId ~= "" then
		capeDecal = Instance.new("Decal")
		capeDecal.Name = "CapeDecal"
		capeDecal.Texture = capeImageId
		capeDecal.Face = Enum.NormalId.Back
		capeDecal.Parent = capePart
		capePart.Color = Color3.fromRGB(255, 255, 255)
		capePart.Transparency = 0
		capePart.Material = Enum.Material.SmoothPlastic
	else
		capePart.Color = Color3.fromRGB(0, 0, 0)
		capePart.Transparency = 0
		capePart.Material = Enum.Material.Fabric
	end

	if loops and loops["transparency"] then
		capePart.LocalTransparencyModifier = Transparency.Values["Amount"] or 0.5
	end
end

function buildCape()
	removeCape()
	if not game:GetService("Players").LocalPlayer.Character then return end

	capeTorsoInst = game:GetService("Players").LocalPlayer.Character:FindFirstChild("UpperTorso") or game:GetService("Players").LocalPlayer.Character:FindFirstChild("Torso")
	if not capeTorsoInst then return end

	capePart = Instance.new("Part")
	capePart.Name = "FW_Cape"
	capePart.Size = Vector3.new(2, 3, 0.1)
	capePart.Anchored = false
	capePart.CanCollide = false
	capePart.CanQuery = false
	capePart.CanTouch = false
	capePart.Massless = true
	capePart.CastShadow = true
	capePart.TopSurface = Enum.SurfaceType.Smooth
	capePart.BottomSurface = Enum.SurfaceType.Smooth

	capePart.CFrame = capeTorsoInst.CFrame * CFrame.new(0, 1, 0.55) * CFrame.Angles(math.rad(-40), 0, 0) * CFrame.new(0, -1.75, 0)
	capePart.Parent = game:GetService("Players").LocalPlayer.Character

	capeWeld = Instance.new("WeldConstraint")
	capeWeld.Part0 = capeTorsoInst
	capeWeld.Part1 = capePart
	capeWeld.Parent = capePart

	applyCapeSkin()

	task.delay(0.05, function()
		if loops and loops["transparency"] and game:GetService("Players").LocalPlayer.Character then
			transpApplyAll(game:GetService("Players").LocalPlayer.Character)
		end
	end)
end

function capeOnCharacterAdded(newCapeChar)
	task.spawn(function()
		task.wait(0.5)
		if capeActive then
			buildCape()
		end
	end)
end

Cape.Callbacks.OnToggle = function(state)
	capeActive = state
	if state then
		buildCape()
		if not capeRespawnConn then
			capeRespawnConn = game:GetService("Players").LocalPlayer.CharacterAdded:Connect(capeOnCharacterAdded)
		end
	else
		removeCape()
		if capeRespawnConn then
			capeRespawnConn:Disconnect()
			capeRespawnConn = nil
		end
	end
end

