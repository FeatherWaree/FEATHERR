function elderFindNearestOrb(range)
	elder_char = Player.Character
	elder_hrp = elder_char and elder_char:FindFirstChild("HumanoidRootPart")
	if not elder_hrp then return nil end
	elder_best = nil
	elder_bestDist = range
	for elder_m in pairs(elder_esp_set) do
		if elder_m.Parent then
			elder_pos = elderGetPos(elder_m)
			if elder_pos then
				elder_d = (elder_pos - elder_hrp.Position).Magnitude
				if elder_d <= elder_bestDist then
					elder_bestDist = elder_d
					elder_best = elder_m
				end
			end
		else
			elder_esp_set[elder_m] = nil
		end
	end
	return elder_best
end

function elderStartTracking()
	if elder_tracking then return end
	elder_tracking = true
	for _, em in ipairs(elder_cs:GetTagged("treeOrb")) do
		if em:IsA("Model") or em:IsA("BasePart") then elder_esp_set[em] = true end
	end
	pcall(function()
		for _, ec in ipairs(G.Services.Workspace:GetChildren()) do
			if (ec:IsA("Model") or ec:IsA("BasePart")) and ec.Name:lower():find("treeorb") then elder_esp_set[ec] = true end
		end
	end)
	elder_conns = elder_conns or {}
	table.insert(elder_conns, FWNoModules.Connect(elder_cs:GetInstanceAddedSignal("treeOrb"), function(m)
		if m:IsA("Model") or m:IsA("BasePart") then elder_esp_set[m] = true end
	end))
	table.insert(elder_conns, FWNoModules.Connect(elder_cs:GetInstanceRemovedSignal("treeOrb"), function(m)
		elderCleanupEntry(m)
		elder_esp_set[m] = nil
	end))
	table.insert(elder_conns, FWNoModules.Connect(G.Services.Workspace.DescendantAdded, function(d)
		if (d:IsA("Model") or d:IsA("BasePart")) and d.Name:lower():find("treeorb") then elder_esp_set[d] = true end
	end))
end

function elderStopTracking()
	if loops["elder esp"] or loops["auto elder"] then return end
	if elder_conns then for _, ec in ipairs(elder_conns) do pcall(function() ec:Disconnect() end) end end
	elder_conns = {}
	for em in pairs(elder_esp_data) do elderCleanupEntry(em) end
	elder_esp_set = {}
	elder_esp_data = {}
	elder_tracking = false
end

elder_lastTick = 0
function elderEspLoop()
	if not loops["elder esp"] then return end
	elder_now = os.clock()
	if elder_now - elder_lastTick < 0.2 then return end
	elder_lastTick = elder_now
	pcall(function()
		elder_char = Player.Character
		elder_hrp = elder_char and elder_char:FindFirstChild("HumanoidRootPart")
		if not elder_hrp then return end

		elder_showHL = ElderESP.Values["Show Highlight"]
		elder_showDist = ElderESP.Values["Show Distance"]
		elder_showGlow = ElderESP.Values["Show Glow"]
		elder_col = ElderESP.Values["Orb Color"] or Color3.fromRGB(100, 255, 140)
		elder_partTransp = ElderESP.Values["Part Transparency"] or 0.3

		for elder_m in pairs(elder_esp_set) do
			if not elder_m.Parent then
				elderCleanupEntry(elder_m)
				elder_esp_set[elder_m] = nil
			else
				elder_pos = elderGetPos(elder_m)
				if elder_pos then
					elder_dist = (elder_pos - elder_hrp.Position).Magnitude

					if not elder_esp_data[elder_m] then
						elder_entry = {}
						if elder_showHL then
							elder_entry.origParts = elderColorParts(elder_m, elder_col, elder_partTransp)
						end
						if elder_showDist then
							elder_bb = FWNoModules.OwnInstance(Instance.new("BillboardGui"))
							elder_bb.Adornee = elder_m:IsA("BasePart") and elder_m or (elder_m.PrimaryPart or elder_m:FindFirstChildWhichIsA("BasePart"))
							elder_bb.Size = UDim2.fromOffset(120, 30)
							elder_bb.StudsOffset = Vector3.new(0, 2, 0)
							elder_bb.AlwaysOnTop = true
							elder_bb.Parent = G.Services.Workspace
							elder_dl = FWNoModules.OwnInstance(Instance.new("TextLabel"))
							elder_dl.Size = UDim2.fromScale(1, 1)
							elder_dl.BackgroundTransparency = 1
							elder_dl.Text = "Orb • " .. tostring(math.floor(elder_dist)) .. "m"
							elder_dl.TextColor3 = ElderESP.Values["Distance Text Color"] or Color3.fromRGB(255, 255, 255)
							elder_dl.TextSize = ElderESP.Values["Text Size"] or 12
							elder_dl.Font = Enum.Font.GothamBlack
							elder_dl.TextStrokeTransparency = 0
							elder_dl.TextStrokeColor3 = Color3.fromRGB(20, 20, 20)
							elder_dl.Parent = elder_bb
							elder_entry.bb = elder_bb
							elder_entry.dl = elder_dl
						end
						if elder_showGlow then
							elder_glowPart = elder_m:IsA("BasePart") and elder_m or (elder_m.PrimaryPart or elder_m:FindFirstChildWhichIsA("BasePart"))
							if elder_glowPart then
								elder_glow = FWNoModules.OwnInstance(Instance.new("PointLight"))
								elder_glow.Color = elder_col
								elder_glow.Range = ElderESP.Values["Glow Range"] or 10
								elder_glow.Brightness = ElderESP.Values["Glow Brightness"] or 2
								elder_glow.Parent = elder_glowPart
								elder_entry.glow = elder_glow
							end
						end
						elder_esp_data[elder_m] = elder_entry
					else
						elder_entry = elder_esp_data[elder_m]
						if elder_showHL and elder_entry.origParts then
							elderUpdatePartColors(elder_entry.origParts, elder_col, elder_partTransp)
						elseif not elder_showHL and elder_entry.origParts then
							elderRestoreParts(elder_entry.origParts)
							elder_entry.origParts = nil
						elseif elder_showHL and not elder_entry.origParts then
							elder_entry.origParts = elderColorParts(elder_m, elder_col, elder_partTransp)
						end
						if elder_entry.dl then
							elder_entry.dl.Text = "Orb • " .. tostring(math.floor(elder_dist)) .. "m"
							elder_entry.dl.TextColor3 = ElderESP.Values["Distance Text Color"] or Color3.fromRGB(255, 255, 255)
							elder_entry.dl.TextSize = ElderESP.Values["Text Size"] or 12
						end
						if elder_showGlow and not elder_entry.glow then
							elder_glowPart = elder_m:IsA("BasePart") and elder_m or (elder_m.PrimaryPart or elder_m:FindFirstChildWhichIsA("BasePart"))
							if elder_glowPart then
								elder_glow = FWNoModules.OwnInstance(Instance.new("PointLight"))
								elder_glow.Color = elder_col
								elder_glow.Range = ElderESP.Values["Glow Range"] or 10
								elder_glow.Brightness = ElderESP.Values["Glow Brightness"] or 2
								elder_glow.Parent = elder_glowPart
								elder_entry.glow = elder_glow
							end
						elseif not elder_showGlow and elder_entry.glow then
							pcall(function() elder_entry.glow:Destroy() end)
							elder_entry.glow = nil
						elseif elder_entry.glow then
							elder_entry.glow.Color = elder_col
							elder_entry.glow.Range = ElderESP.Values["Glow Range"] or 10
							elder_entry.glow.Brightness = ElderESP.Values["Glow Brightness"] or 2
						end
						if not elder_showDist and elder_entry.bb then
							pcall(function() elder_entry.bb:Destroy() end)
							elder_entry.bb = nil
							elder_entry.dl = nil
						end
					end
				end
			end
		end
	end)
end


