HitRegAdjuster.Callbacks.OnToggle = function(state)
	loops["hit reg adjuster"] = state
	if state and not hrAdjusterHookActive then
		hrAdjusterHookActive = true
		if hookmetamethod then
			local oldNamecall
			local hookRuntime = FWNoModules.Runtime
			oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
				if hookRuntime.active and loops["hit reg adjuster"] then
					local method = getnamecallmethod()
					if method == "FireServer" then
						local remoteName = tostring(self)
						if remoteName == "SwordHit" then
							local payload = ...
