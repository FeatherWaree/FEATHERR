cd_mainConn = FWNoModules.GatedFrame(G.Services.RunService.Heartbeat, {"cheater detector"}, function()
	if not loops["cheater detector"] then return end
	cd_now = os.clock()
	if cd_now - cd_owlScan > 1 then cd_owlScan = cd_now; cdOwlScanNow() end

	for _, p in ipairs(FWNoModules.PlayerSnapshot()) do
		if cdShouldCheck(p) then
			cd_char = p.Character
			if cd_char then
				cd_hr = cd_char:FindFirstChild("HumanoidRootPart")
				cd_hum = cd_char:FindFirstChildOfClass("Humanoid")
				if cd_hr and cd_hum and cd_hum.Health > 0 and cd_now >= cdState(p).nextSample then
					cd_st = cdState(p)
					cd_st.nextSample = cd_now + 0.1
					cd_dt = 0.1
					cd_vel = cd_hr.AssemblyLinearVelocity
					cd_hSpeed = Vector3.new(cd_vel.X, 0, cd_vel.Z).Magnitude
					cd_grounded = cd_hum.FloorMaterial ~= Enum.Material.Air

					-- VELOCITY
					if CheaterDetector.Values["Velocity"] and not cd_st.velChecked and cd_st.hurtTime > 0 then
						cd_dh = cd_now - cd_st.hurtTime
						if cd_dh >= 0.1 and cd_dh <= 0.3 then
							cd_st.velChecked = true
							if (cd_vel - cd_st.velBefore).Magnitude < 8 then
								cdNotify(p, "Velocity (no knockback)")
							end
						end
					end

					-- SPEED (fixed 21 threshold, potion/zephyr/adetunde/owl/knockback exempt)
					if CheaterDetector.Values["Speed"] then
						if cd_hSpeed > 21 and not cdSpeedExempt(p, cd_char, cd_st, cd_now) then
							cd_st.speedTime = cd_st.speedTime + cd_dt
							if cd_st.speedTime > 0.5 then
								cdNotify(p, "Speed (" .. math.floor(cd_hSpeed) .. ")")
								cd_st.speedTime = 0
							end
						else
							cd_st.speedTime = 0
						end
					end

					-- LONG JUMP (fireball/yuzi boosted beyond normal)
					if CheaterDetector.Values["Long Jump"] then
						if cd_hSpeed > 45 and now and not cdSpeedExempt(p, cd_char, cd_st, cd_now) then
							cd_st.ljTime = cd_st.ljTime + cd_dt
							if cd_st.ljTime > 0.25 then
								cdNotify(p, "Long Jump")
								cd_st.ljTime = 0
							end
						else
							cd_st.ljTime = 0
						end
					end

					-- FLY (hover, balloon/owl exempt)
					if CheaterDetector.Values["Fly"] then
						if not cd_grounded and not cdSpeedExempt(p, cd_char, cd_st, cd_now) then
							if math.abs(cd_vel.Y) < 3 or cd_vel.Y > 2 then
								cd_st.airTime = cd_st.airTime + cd_dt
								if cd_st.airTime > 0.8 then
									cdNotify(p, "Fly")
									cd_st.airTime = 0
								end
							else
								cd_st.airTime = 0
							end
						else
							cd_st.airTime = 0
						end
					end

					-- CLIMBER (faster response)
					if CheaterDetector.Values["Climber"] then
						if cd_vel.Y > 12 then
							cd_st.climbTime = cd_st.climbTime + cd_dt
							if cd_st.climbTime > 0.3 then
								cd_cp = RaycastParams.new()
								cd_cp.FilterType = Enum.RaycastFilterType.Exclude
								cd_cp.FilterDescendantsInstances = {cd_char}
								cd_w = G.Services.Workspace:Raycast(cd_hr.Position, cd_hr.CFrame.LookVector * 2.5, cd_cp)
								if cd_w then
									cdNotify(p, "Climber")
									cd_st.climbTime = 0
								end
							end
						else
							cd_st.climbTime = 0
						end
					end

					-- PHASE (only counts walls whose top is ABOVE your centre = truly inside)
					if CheaterDetector.Values["Phase"] and cd_now >= cd_st.phaseNext then
						cd_st.phaseNext = cd_now + 0.15
						cd_pp = OverlapParams.new()
						cd_pp.FilterType = Enum.RaycastFilterType.Exclude
						cd_pp.FilterDescendantsInstances = {cd_char}
						cd_in = G.Services.Workspace:GetPartBoundsInBox(cd_hr.CFrame, Vector3.new(1, 1, 1), cd_pp)
						cd_solid = false
						for _, b in ipairs(cd_in) do
							if b.CanCollide and (b.Position.Y + b.Size.Y / 2) > cd_hr.Position.Y + 0.5 then
								cd_solid = true
								break
							end
						end
						if cd_solid then
							cd_st.phaseTime = cd_st.phaseTime + 0.15
							if cd_st.phaseTime > 0.45 then
								cdNotify(p, "Phase")
								cd_st.phaseTime = 0
							end
						else
							cd_st.phaseTime = 0
						end
					end

					-- NO FALL
					if CheaterDetector.Values["No Fall"] then
						if cd_vel.Y < -12 then
							cd_st.falling = true
							if not cd_st.fallY or cd_hr.Position.Y < cd_st.fallY then cd_st.fallY = cd_hr.Position.Y end
						elseif cd_st.falling and cd_grounded then
							cd_st.falling = false
							if cd_st.fallY and (cd_st.fallY - cd_hr.Position.Y) > 12 and cd_now - cd_st.lastHurt > 0.3 then
								cdNotify(p, "No Fall")
							end
							cd_st.fallY = nil
						end
					end

					-- INF JUMP (needs 3 air jumps, balloon/wind_walker exempt)
					if CheaterDetector.Values["Inf Jump"] then
						if not cd_grounded and not cdHasBalloon(cd_char) and (cd_char:GetAttribute("PlayingAsKits") or "") ~= "wind_walker" then
							if cd_vel.Y > 40 and cd_now - cd_st.lastJumpSpike > 0.25 then
								cd_st.airJumps = cd_st.airJumps + 1
								cd_st.lastJumpSpike = cd_now
								if cd_st.airJumps >= 3 then
									cdNotify(p, "Inf Jump")
									cd_st.airJumps = 0
								end
							end
						else
							cd_st.airJumps = 0
						end
					end

					-- NOVOID (teleport up right after falling, pearl exempt)
					if CheaterDetector.Values["NoVoid"] then
						if cd_st.prevY then
							if (cd_hr.Position.Y - cd_st.prevY) > 15 and cd_st.wasFalling and cd_now - cd_st.pearlTime > 1 then
								cdNotify(p, "NoVoid")
							end
						end
						cd_st.wasFalling = cd_vel.Y < -10
						cd_st.prevY = cd_hr.Position.Y
					end

					-- GRAVITY (falling too slowly for too long)
					if CheaterDetector.Values["Gravity"] then
						if not cd_grounded and cd_vel.Y < 0 and cd_vel.Y > -12 and not cdHasBalloon(cd_char) then
							cd_st.fallTime = cd_st.fallTime + cd_dt
							if cd_st.fallTime > 0.3 then
								cdNotify(p, "Gravity")
								cd_st.fallTime = 0
							end
						else
							cd_st.fallTime = 0
						end
					end

					-- SPIN BOT (sustained insane rotation)
					if CheaterDetector.Values["Spin Bot"] then
						cd_look = cd_hr.CFrame.LookVector
						if cd_st.lastLook then
							cd_spin = math.deg(math.acos(math.clamp(cd_look:Dot(cd_st.lastLook), -1, 1)))
							if cd_spin > 50 then
								cd_st.spinTime = cd_st.spinTime + cd_dt
								if cd_st.spinTime > 0.5 then
									cdNotify(p, "Spin Bot")
									cd_st.spinTime = 0
								end
							else
								cd_st.spinTime = 0
							end
						end
						cd_st.lastLook = cd_look
					end

					-- TRAP DISABLER
					if CheaterDetector.Values["Trap/Gloop Disabler"] then
						if cd_now - cd_st.trapTime < 1 and cd_hSpeed > 10 then
							cdNotify(p, "Trap Disabler")
							cd_st.trapTime = -999
						end
						if cd_hSpeed > 13 then
							cd_gp = OverlapParams.new()
							cd_gp.FilterType = Enum.RaycastFilterType.Exclude
							cd_gp.FilterDescendantsInstances = {cd_char}
							cd_gin = G.Services.Workspace:GetPartBoundsInBox(cd_hr.CFrame, Vector3.new(3, 3, 3), cd_gp)
							for _, g in ipairs(cd_gin) do
								if g.Name:lower():find("gloop") then
									cdNotify(p, "Gloop Disabler")
									break
								end
							end
						end
					end

					-- NO ANIMATIONS
					if CheaterDetector.Values["No Animations"] then
						if cd_hSpeed > 8 then
							cd_st.moveTime = cd_st.moveTime + cd_dt
							if cd_st.moveTime > 2 then
								cd_st.moveTime = 0
								cd_anim = cd_hum:FindFirstChildOfClass("Animator")
								if cd_anim and #cd_anim:GetPlayingAnimationTracks() == 0 then
									cdNotify(p, "No Animations")
								end
							end
						else
							cd_st.moveTime = 0
						end
					end

					cd_st.lastVel = cd_vel
				end
			end
		end
	end
end)

