        if type(thread) ~= "thread" or coroutine.status(thread) ~= "dead" then nativeTask.cancel(thread) end
    end
    function runtime.CancelTasks()
        local current = coroutine.running()
        for thread in pairs(runtime.tasks) do
            if thread ~= current then pcall(nativeTask.cancel, thread); runtime.tasks[thread] = nil end
        end
    end
    function FWNoModules.OwnInstance(object)
        if object and runtime.active then
            runtime.objects[object] = true
            local thread=coroutine.running();markFeature(runtime.featureObjects,thread and runtime.owners[thread],object)
        end
        if object and FWNoModules.Mobile and FWNoModules.Mobile.OnInstance then FWNoModules.Mobile.OnInstance(object)end
        return object
    end
    function FWNoModules.ReleaseInstance(object)
        if not object then return end
        runtime.objects[object] = nil
        for _,items in pairs(runtime.featureObjects)do items[object]=nil end
        for _, child in ipairs(object:GetDescendants()) do
            runtime.objects[child] = nil
            for _,items in pairs(runtime.featureObjects)do items[child]=nil end
        end
    end
    function FWNoModules.OwnTween(object)
        if object and runtime.active then
            runtime.tweens[object] = true
            local thread=coroutine.running();markFeature(runtime.featureTweens,thread and runtime.owners[thread],object)
        end
        return object
    end
    function FWNoModules.Connect(signal, callback)
        local creator=coroutine.running()
        local owner=creator and runtime.owners[creator]
        local connection = signal:Connect(function(...)
            if not runtime.active then return end
            local thread = coroutine.running()
            local wasOwned = runtime.tasks[thread]
            local previousOwner=runtime.owners[thread]
            runtime.owners[thread]=owner
            markFeature(runtime.featureTasks,owner,thread)
            runtime.tasks[thread] = true
            local result = table.pack(pcall(callback, ...))
            if not wasOwned then runtime.tasks[thread] = nil end
            if owner and runtime.featureTasks[owner]then runtime.featureTasks[owner][thread]=nil end
            runtime.owners[thread]=previousOwner
            if not result[1] then error(result[2], 0) end
            return table.unpack(result, 2, result.n)
        end)
        markFeature(runtime.featureConnections,owner,connection)
        return FWNoModules.TrackFrameConnection(connection)
    end
    function FWNoModules.BindRenderStep(service, name, priority, callback)
        if not runtime.active then return end
        runtime.bindings[name] = service
        local thread=coroutine.running();runtime.bindingOwners[name]=thread and runtime.owners[thread]
        return service:BindToRenderStep(name, priority, callback)
    end
    function FWNoModules.RestoreMethod(object, key)
