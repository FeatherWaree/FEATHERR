				ka_skinTag = isc_selected[inventoryWeapon.Name]
				if ka_skinTag then
					ka_skinMeta = iscMeta[inventoryWeapon.Name .. "_" .. ka_skinTag]
					if not ka_skinMeta then
						for _, ka_m in pairs(iscMeta) do
							if type(ka_m) == "table" and ka_m.itemType == inventoryWeapon.Name and ka_m.skinTag == ka_skinTag then
								ka_skinMeta = ka_m
								break
							end
