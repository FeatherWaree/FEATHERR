xr_oreNames = { "iron_ore", "diamond_ore", "emerald_ore", "gold_ore", "crystal_ore" }
xr_bedNames = { "bed", "og_bed", "inflatable_bed" }
xr_chestNames = { "chest", "personal_chest", "og_personal_chest" }
xr_genNames = { "generator", "team_generator", "global_generator" }

function xrIsSpecial(name)
	xr_lower = name:lower()
	for _, xr_n in ipairs(xr_oreNames) do if xr_lower:find(xr_n) then return "ore" end end
	for _, xr_n in ipairs(xr_bedNames) do if xr_lower:find(xr_n) then return "bed" end end
	for _, xr_n in ipairs(xr_chestNames) do if xr_lower:find(xr_n) then return "chest" end end
	for _, xr_n in ipairs(xr_genNames) do if xr_lower:find(xr_n) then return "generator" end end
	return nil
end

function xrApply()
	xr_opacity = XRay.Values["Opacity"] or 0.7
	xr_count = 0
	for _, xr_obj in ipairs(G.Services.Workspace:GetDescendants()) do
		if xr_count > 3000 then break end
		if xr_obj:IsA("BasePart") and xr_obj.Transparency < 1 then
			xr_special = xr_obj.Parent and xrIsSpecial(xr_obj.Parent.Name) or nil
			if not xr_special then xr_special = xrIsSpecial(xr_obj.Name) end
			if xr_special then
				if (xr_special == "ore" and XRay.Values["Show Ores"]) or (xr_special == "bed" and XRay.Values["Show Beds"]) or (xr_special == "chest" and XRay.Values["Show Chests"]) or (xr_special == "generator" and XRay.Values["Show Generators"]) then
					if not xr_orig[xr_obj] then xr_orig[xr_obj] = { trans = xr_obj.Transparency, color = xr_obj.Color, mat = xr_obj.Material } end
					xr_obj.Transparency = 0
					xr_obj.Material = Enum.Material.Neon
					if xr_special == "ore" then xr_obj.Color = XRay.Values["Ore Color"] or Color3.fromRGB(100, 200, 255)
					elseif xr_special == "bed" then xr_obj.Color = XRay.Values["Bed Color"] or Color3.fromRGB(255, 100, 100)
					elseif xr_special == "chest" then xr_obj.Color = XRay.Values["Chest Color"] or Color3.fromRGB(200, 150, 50) end
				end
			else
				if not xr_orig[xr_obj] then xr_orig[xr_obj] = { trans = xr_obj.Transparency, color = xr_obj.Color, mat = xr_obj.Material } end
				xr_obj.Transparency = xr_opacity
			end
			xr_count = xr_count + 1
		end
	end
end

function xrRestore()
	for xr_obj, xr_data in pairs(xr_orig) do
		pcall(function()
			xr_obj.Transparency = xr_data.trans
			xr_obj.Color = xr_data.color
			xr_obj.Material = xr_data.mat
		end)
	end
	xr_orig = {}
end

XRay.Callbacks.OnToggle = function(state)
	loops["xray"] = state
	if state then
		xrApply()
	else
		xrRestore()
	end
end

