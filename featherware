-- Membership changes publish a new array. Loops already using an older
-- snapshot keep their original order and contents, even if they yield.
do
    local players = game:GetService("Players")
    local snapshot = players:GetPlayers()
    function FWNoModules.PlayerSnapshot() return snapshot end
    FWNoModules.Connect(players.PlayerAdded, function(player)
        if table.find(snapshot, player) then return end
        local nextSnapshot = table.clone(snapshot)
        nextSnapshot[#nextSnapshot + 1] = player
        snapshot = nextSnapshot
    end)
    FWNoModules.Connect(players.PlayerRemoving, function(player)
        local index = table.find(snapshot, player)
        if not index then return end
        local nextSnapshot = table.clone(snapshot)
        table.remove(nextSnapshot, index)
        snapshot = nextSnapshot
    end)
end


function FWNoModules.PinOverlay(gui, order)
    gui.DisplayOrder = order
