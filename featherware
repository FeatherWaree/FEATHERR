local function findNearbyContainers(radius, espOnly)
	if not loops["chest stealer"] and not espOnly then 
		return {}, {} 
	end

	local chests = {}
	local crates = {}

	local root = cachedHRP
	if not root then return chests, crates end

	-- FIX 1: MaxParts must be set as a property of OverlapParams!
	local overlapParams = OverlapParams.new()
	overlapParams.FilterDescendantsInstances = {Player.Character}
	overlapParams.FilterType = Enum.RaycastFilterType.Exclude
	overlapParams.MaxParts = 5000 

	-- Only 3 arguments are passed to GetPartBoundsInRadius
	local parts = G.Services.Workspace:GetPartBoundsInRadius(root.Position, radius, overlapParams)

	for _, part in ipairs(parts) do
		if part.Name == "chest" then
			chests[#chests + 1] = part
		elseif part.Name == "team_crate" then
			if ChestStealer.Values["Own Crate"] == false then
				if part:GetAttribute("Team") == Player:GetAttribute("Team") then
					continue
				end
			end
			crates[#crates + 1] = part
		end
	end

	return chests, crates
end


