	if not zenoLoadRemotes() then return false end

	playerInv = zenoGetInventoryFolder()
	if not playerInv then return false end

	staffInstance = playerInv:FindFirstChild("wizard_staff_3") or playerInv:FindFirstChild("wizard_staff_2") or playerInv:FindFirstChild("wizard_staff_1") or playerInv:FindFirstChild("wizard_staff")
