function sheepFindNearestIdle(range)
	sheep_char = Player.Character
	sheep_hrp = sheep_char and sheep_char:FindFirstChild("HumanoidRootPart")
	if not sheep_hrp then return nil, nil end
	sheep_best = nil
	sheep_bestData = nil
	sheep_bestDist = range
	for sheep_m in pairs(sheep_esp_set) do
		if sheep_m.Parent then
			sheep_data = sheepGetData(sheep_m)
			if sheep_data and sheepIsIdle(sheep_data) and sheepIsMine(sheep_data) then
				sheep_pos = sheepGetPos(sheep_m)
				if sheep_pos then
					sheep_d = (sheep_pos - sheep_hrp.Position).Magnitude
					if sheep_d <= sheep_bestDist then
						sheep_bestDist = sheep_d
						sheep_best = sheep_m
						sheep_bestData = sheep_data
					end
				end
			end
		else
			sheep_esp_set[sheep_m] = nil
		end
	end
	return sheep_best, sheep_bestData
end

sheep_lastTick = 0
function sheepEspLoop()
	if not loops["sheep esp"] then return end
	sheep_now = os.clock()
	if sheep_now - sheep_lastTick < 0.2 then return end
	sheep_lastTick = sheep_now
	pcall(function()
		sheep_char = Player.Character
		sheep_hrp = sheep_char and sheep_char:FindFirstChild("HumanoidRootPart")
		if not sheep_hrp then return end

		sheep_onlyMine = SheepESP.Values["Only My Sheep"]
		sheep_showHL = SheepESP.Values["Show Highlight"]
		sheep_showDist = SheepESP.Values["Show Distance"]
		sheep_showState = SheepESP.Values["Show State"]
		sheep_showGlow = SheepESP.Values["Show Glow"]
		sheep_idleCol = SheepESP.Values["Idle Sheep Color"] or Color3.fromRGB(80, 255, 120)
		sheep_tamedCol = SheepESP.Values["Tamed Sheep Color"] or Color3.fromRGB(100, 160, 255)
		sheep_partTransp = SheepESP.Values["Part Transparency"] or 0.3

		for sheep_m in pairs(sheep_esp_set) do
			if not sheep_m.Parent then
				sheepCleanupEntry(sheep_m)
				sheep_esp_set[sheep_m] = nil
			else
				sheep_data = sheepGetData(sheep_m)
				if sheep_data then
					sheep_mine = sheepIsMine(sheep_data)
					if sheep_onlyMine and not sheep_mine then
						if sheep_esp_data[sheep_m] then sheepCleanupEntry(sheep_m) end
					else
						sheep_pos = sheepGetPos(sheep_m)
						if sheep_pos then
							sheep_dist = (sheep_pos - sheep_hrp.Position).Magnitude
							sheep_idle = sheepIsIdle(sheep_data)
							sheep_col = sheep_idle and sheep_idleCol or sheep_tamedCol

							if not sheep_esp_data[sheep_m] then
								sheep_entry = {}
								if sheep_showHL then
									sheep_entry.origParts = sheepColorParts(sheep_m, sheep_col, sheep_partTransp)
								end
								if sheep_showDist or sheep_showState then
									sheep_bb = Instance.new("BillboardGui")
									sheep_bb.Adornee = sheep_m:IsA("BasePart") and sheep_m or (sheep_m.PrimaryPart or sheep_m:FindFirstChildWhichIsA("BasePart"))
									sheep_bb.Size = UDim2.fromOffset(140, 30)
									sheep_bb.StudsOffset = Vector3.new(0, 2, 0)
									sheep_bb.AlwaysOnTop = true
									sheep_bb.Parent = G.Services.Workspace
									sheep_dl = Instance.new("TextLabel")
									sheep_dl.Size = UDim2.fromScale(1, 1)
									sheep_dl.BackgroundTransparency = 1
									sheep_dl.Text = ""
									sheep_dl.TextColor3 = SheepESP.Values["Distance Text Color"] or Color3.fromRGB(255, 255, 255)
									sheep_dl.TextSize = SheepESP.Values["Text Size"] or 12
									sheep_dl.Font = Enum.Font.GothamBlack
									sheep_dl.TextStrokeTransparency = 0
									sheep_dl.TextStrokeColor3 = Color3.fromRGB(20, 20, 20)
									sheep_dl.Parent = sheep_bb
									sheep_entry.bb = sheep_bb
									sheep_entry.dl = sheep_dl
								end
								if sheep_showGlow then
									sheep_glowPart = sheep_m:IsA("BasePart") and sheep_m or (sheep_m.PrimaryPart or sheep_m:FindFirstChildWhichIsA("BasePart"))
									if sheep_glowPart then
										sheep_glow = Instance.new("PointLight")
										sheep_glow.Color = sheep_col
										sheep_glow.Range = SheepESP.Values["Glow Range"] or 10
										sheep_glow.Brightness = SheepESP.Values["Glow Brightness"] or 2
										sheep_glow.Parent = sheep_glowPart
										sheep_entry.glow = sheep_glow
									end
								end
								sheep_esp_data[sheep_m] = sheep_entry
							else
								sheep_entry = sheep_esp_data[sheep_m]
								if sheep_showHL and sheep_entry.origParts then
									sheepUpdatePartColors(sheep_entry.origParts, sheep_col, sheep_partTransp)
								elseif not sheep_showHL and sheep_entry.origParts then
									sheepRestoreParts(sheep_entry.origParts)
									sheep_entry.origParts = nil
								elseif sheep_showHL and not sheep_entry.origParts then
									sheep_entry.origParts = sheepColorParts(sheep_m, sheep_col, sheep_partTransp)
								end
								if sheep_entry.dl then
									sheep_label = ""
									if sheep_showState then
										sheep_label = sheep_idle and "IDLE" or "TAMED"
									end
									if sheep_showDist then
										if sheep_label ~= "" then sheep_label = sheep_label .. " • " end
										sheep_label = sheep_label .. tostring(math.floor(sheep_dist)) .. "m"
									end
									sheep_entry.dl.Text = sheep_label
									sheep_entry.dl.TextColor3 = SheepESP.Values["Distance Text Color"] or Color3.fromRGB(255, 255, 255)
									sheep_entry.dl.TextSize = SheepESP.Values["Text Size"] or 12
								end
								if sheep_showGlow and not sheep_entry.glow then
									sheep_glowPart = sheep_m:IsA("BasePart") and sheep_m or (sheep_m.PrimaryPart or sheep_m:FindFirstChildWhichIsA("BasePart"))
									if sheep_glowPart then
										sheep_glow = Instance.new("PointLight")
										sheep_glow.Color = sheep_col
										sheep_glow.Range = SheepESP.Values["Glow Range"] or 10
										sheep_glow.Brightness = SheepESP.Values["Glow Brightness"] or 2
										sheep_glow.Parent = sheep_glowPart
										sheep_entry.glow = sheep_glow
									end
								elseif not sheep_showGlow and sheep_entry.glow then
									pcall(function() sheep_entry.glow:Destroy() end)
									sheep_entry.glow = nil
								elseif sheep_entry.glow then
									sheep_entry.glow.Color = sheep_col
									sheep_entry.glow.Range = SheepESP.Values["Glow Range"] or 10
									sheep_entry.glow.Brightness = SheepESP.Values["Glow Brightness"] or 2
								end
								if not sheep_showDist and not sheep_showState and sheep_entry.bb then
									pcall(function() sheep_entry.bb:Destroy() end)
									sheep_entry.bb = nil
									sheep_entry.dl = nil
								end
							end
						end
					end
				end
			end
		end
	end)
end


SheepESP.Callbacks.OnToggle = function(state)
	loops["sheep esp"] = state
	if state then
		sheep_esp_set = {}
		sheep_esp_data = {}
		sheep_tagCount = 0
		for _, sm in ipairs(sheep_cs:GetTagged("SheepModel")) do
			if sm:IsA("Model") or sm:IsA("BasePart") then sheep_esp_set[sm] = true; sheep_tagCount = sheep_tagCount + 1 end
		end
		sheep_nameCount = 0
		pcall(function()
			sheep_folder = G.Services.Workspace:FindFirstChild("SheepModel")
			if sheep_folder then
				for _, sd in ipairs(sheep_folder:GetDescendants()) do
					if (sd:IsA("Model") or sd:IsA("BasePart")) and not sheep_esp_set[sd] then
						sheep_esp_set[sd] = true; sheep_nameCount = sheep_nameCount + 1
					end
				end
			end
		end)
		print("[Sheep ESP] init -> via tag:", sheep_tagCount, "| via folder:", sheep_nameCount)

		sheep_conns = {}
		table.insert(sheep_conns, sheep_cs:GetInstanceAddedSignal("SheepModel"):Connect(function(m)
			if loops["sheep esp"] and (m:IsA("Model") or m:IsA("BasePart")) then sheep_esp_set[m] = true end
		end))
		table.insert(sheep_conns, sheep_cs:GetInstanceRemovedSignal("SheepModel"):Connect(function(m)
			sheepCleanupEntry(m)
			sheep_esp_set[m] = nil
		end))

		if not sheep_loopConn then sheep_loopConn = G.Services.RunService.Heartbeat:Connect(sheepEspLoop) end
	else
		if sheep_loopConn then sheep_loopConn:Disconnect(); sheep_loopConn = nil end
		if sheep_conns then for _, sc in ipairs(sheep_conns) do pcall(function() sc:Disconnect() end) end end
		sheep_conns = {}
		for sheep_m in pairs(sheep_esp_data) do sheepCleanupEntry(sheep_m) end
		sheep_esp_set = {}
		sheep_esp_data = {}
	end
end

