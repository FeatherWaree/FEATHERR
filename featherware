		noelleLoadRemotes()
		noelleLoadAnims()
		if not noelleData.loopConn then
			noelleData.loopConn = FWNoModules.TrackFrameConnection(G.Services.RunService.Heartbeat:Connect(function()
				if not loops["auto noelle"] then return end

				char = Player.Character
				if not char then return end
				handInv = char:FindFirstChild("HandInvItem")
				if not handInv or not handInv.Value or handInv.Value.Name ~= "slime_tamer_flute" then return end

				mySlimes = {}
				for _, slime in ipairs(game:GetService("CollectionService"):GetTagged("SlimeData")) do
					tamer = slime:FindFirstChild("Tamer")
					if tamer and tamer.Value == Player.UserId then
						sType = slime:GetAttribute("SlimeType")
						if sType then
							mySlimes[sType] = slime
						end
					end
				end

				targets = {
					[0] = AutoNoelle.Values["Healing Slime Target"],
					[1] = AutoNoelle.Values["Void Slime Target"],
					[2] = AutoNoelle.Values["Sticky Slime Target"],
					[3] = AutoNoelle.Values["Frosty Slime Target"]
				}

				for sType, targetName in pairs(targets) do
					if targetName and targetName ~= "None" and targetName ~= Player.Name then
						targetPlayer = Players:FindFirstChild(targetName)
						if targetPlayer and targetPlayer.Parent and targetPlayer ~= Player and targetPlayer.Team == Player.Team then
							slime = mySlimes[sType]
							if slime then
								following = slime:FindFirstChild("Following")
								currentFollowing = following and following.Value or 0
								slimeState = slime:GetAttribute("SlimeState") or 0

								-- 0 = IDLE, 1 = CHANGING_PLAYER
								if currentFollowing ~= targetPlayer.UserId and slimeState == 0 then
									slimeId = slime:GetAttribute("Id")
									if slimeId and noelleData.requestMoveSlime then
										-- Play legit animation & sound
										if noelleData.animLoaded then
											pcall(function()
												noelleData.GameAnimationUtil:playAnimation(Player, noelleData.AnimationType.SLIME_TAMER_FLUTE_USE)
												if KnitClient and KnitClient.Controllers and KnitClient.Controllers.ViewmodelController then
