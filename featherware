HBE_isProjectileWeapon = function(name)
	if not name then return false end
	local n = string.lower(name)
	for _, w in ipairs(HBE_projectileWeapons) do
		if string.find(n, string.lower(w)) then return true end
	end
	return false
end

HBE_isHoldingProjectile = function()
	local char = Player.Character
	if not char then return false end
	local hi = char:FindFirstChild("HandInvItem")
	if not hi or not hi.Value then return false end
	local name = typeof(hi.Value) == "Instance" and hi.Value.Name or tostring(hi.Value)
	return HBE_isProjectileWeapon(name)
end

HBE_getTargets = function()
	local targets = {}
	if HitboxExpander.Values["Expand Players"] then
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= Player and plr.Character and plr.Team ~= Player.Team then
				local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
				local hum = plr.Character:FindFirstChild("Humanoid")
				if hrp and hum and hum.Health > 0 then
					table.insert(targets, {model = plr.Character, hrp = hrp})
				end
			end
		end
	end
	if HitboxExpander.Values["Expand NPCs"] then
		for _, npc in ipairs(G.Services.Workspace:GetChildren()) do
			if npc:IsA("Model") and npc:FindFirstChild("Humanoid") and not Players:GetPlayerFromCharacter(npc) then
				local hrp = npc:FindFirstChild("HumanoidRootPart") or npc.PrimaryPart
				local hum = npc:FindFirstChild("Humanoid")
				if hrp and hum and hum.Health > 0 then
					table.insert(targets, {model = npc, hrp = hrp})
				end
			end
		end
	end
	return targets
end

HBE_createPart = function(model, hrp, expand)
	local part = Instance.new("Part")
	part.Name = "HBE_Hitbox"
	part.Shape = Enum.PartType.Ball
	part.Size = Vector3.new(expand, expand, expand)
	part.CFrame = hrp.CFrame
	part.Transparency = 1
	part.CanCollide = false
	part.CanQuery = true
	part.CanTouch = false
	part.Anchored = true
	part.Massless = true
	part.CastShadow = false
	part.Parent = model
	HBE_parts[model] = part
	return part
end

HBE_update = function()
	local holdingProj = HitboxExpander.Values["Projectile Hitbox Only"] and HBE_isHoldingProjectile()
	local targets = HBE_getTargets()
	local expand = tonumber(HitboxExpander.Values["Expand Size"]) or 12

	-- Remove hitboxes for models no longer in targets
	for model, part in pairs(HBE_parts) do
		if not model.Parent then
			if part and part.Parent then part:Destroy() end
			HBE_parts[model] = nil
		end
	end

	-- Remove hitboxes when not holding projectile weapon
	if HitboxExpander.Values["Projectile Hitbox Only"] and not holdingProj then
		for model, part in pairs(HBE_parts) do
			if part and part.Parent then part:Destroy() end
			HBE_parts[model] = nil
		end
		return
	end

	for _, t in ipairs(targets) do
		local part = HBE_parts[t.model]
		if not part or not part.Parent then
			part = HBE_createPart(t.model, t.hrp, expand)
			HBE_parts[t.model] = part
		end
		part.CFrame = t.hrp.CFrame
		part.Size = Vector3.new(expand, expand, expand)
	end
end

HBE_loop = function()
	while loops["hitbox expander"] do
		HBE_update()
		task.wait(0.1)
	end
end

HitboxExpander.Callbacks.OnToggle = function(state)
	loops["hitbox expander"] = state
	if state then
		task.spawn(HBE_loop)
	else
		for model, part in pairs(HBE_parts) do
			if part and part.Parent then part:Destroy() end
			HBE_parts[model] = nil
		end
	end
end

