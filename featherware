local function playNightmareEmote()
	local character = Player.Character
	if not character then return end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then return end

	local lowerTorso = character:FindFirstChild("LowerTorso") or character:FindFirstChild("Torso")
	if not lowerTorso then return end

	animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		NotificationSystem.Notify("Nightmare Emote", "No animator found", 1)
		return
	end

	local anim = Instance.new("Animation")
	anim.AnimationId = "rbxassetid://9191822700"
	local track = animator:LoadAnimation(anim)
	track.Priority = Enum.AnimationPriority.Action
	track:Play()

	-- 2. Spawn & Setup VFX
	local vfxClone = nil
	local success, nightmareVfxTemplate = pcall(function()
		return G.Services.RS:WaitForChild("Assets", 2):WaitForChild("Effects", 2):WaitForChild("NightmareEmote", 2)
	end)

	if success and nightmareVfxTemplate then
		vfxClone = nightmareVfxTemplate:Clone()
		vfxClone.Parent = G.Services.Workspace

		-- Position it exactly like the decompiled controller
		vfxClone:PivotTo(lowerTorso.CFrame + Vector3.new(0, -2, 0))

		-- Anchor and disable collisions/raycasting
		for _, descendant in ipairs(vfxClone:GetDescendants()) do
			if descendant:IsA("BasePart") then
				descendant.CanCollide = false
				descendant.Anchored = true
				descendant.CanQuery = false
				descendant.CanTouch = false
			end
		end

		-- Rotate Outer and Middle parts infinitely
		local outer = vfxClone:FindFirstChild("Outer")
		if outer then
			TweenService:Create(outer, TweenInfo.new(1.5, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, -1), {Orientation = outer.Orientation + Vector3.new(0, 360, 0)}):Play()
		end

		local middle = vfxClone:FindFirstChild("Middle")
		if middle then
			TweenService:Create(middle, TweenInfo.new(12.5, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, -1), {Orientation = middle.Orientation + Vector3.new(0, -360, 0)}):Play()
		end
	end

	-- 3. Cleanup on Movement / Jumping / Dying
	local moveConnection, jumpConnection, deadConnection

	local function cleanup()
		if track and track.IsPlaying then track:Stop(0.1) end
		if vfxClone and vfxClone.Parent then vfxClone:Destroy() end
		if moveConnection then moveConnection:Disconnect() end
		if jumpConnection then jumpConnection:Disconnect() end
		if deadConnection then deadConnection:Disconnect() end
	end

	moveConnection = humanoid:GetPropertyChangedSignal("MoveDirection"):Connect(function()
		if humanoid.MoveDirection.Magnitude > 0 then
			cleanup()
		end
	end)

	jumpConnection = humanoid:GetPropertyChangedSignal("Jump"):Connect(function()
		if humanoid.Jump then
			cleanup()
		end
	end)

	deadConnection = humanoid.Died:Connect(function()
		cleanup()
	end)
end

