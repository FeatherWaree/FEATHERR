wardenTryCollect = function(soulModel)
	if not loops["auto warden"] then return end
	if wardenData.trackedSouls[soulModel] then return end -- Already processing

	local character = Player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not rootPart then return end

	-- Find the part to measure distance from (Spirit or PrimaryPart)
	local spiritPart = soulModel:FindFirstChild("Spirit") or soulModel.PrimaryPart or soulModel:FindFirstChildWhichIsA("BasePart")
	if not spiritPart then 
		print("[Auto Warden] Soul model has no Spirit/PrimaryPart.")
		return 
	end

	local maxRange = AutoWarden.Values["Range"] or 20
	local distance = (rootPart.Position - spiritPart.Position).Magnitude

	if distance <= maxRange then
		-- Check for Id or id attribute
		local soulId = soulModel:GetAttribute("Id") or soulModel:GetAttribute("id")

		if soulId then
			print("[Auto Warden] Soul in range! ID: " .. tostring(soulId) .. " | Distance: " .. math.floor(distance))
			wardenData.trackedSouls[soulModel] = true -- Mark as processing

			task.spawn(function()
				if wardenData.remote then
					local success, err = pcall(function()
						wardenData.remote:FireServer({
							id = soulId,
							collectableName = "JailorSoul"
						})
					end)

					if success then
						print("[Auto Warden] Successfully collected soul!")
					else
						print("[Auto Warden] Failed to collect soul: " .. tostring(err))
						wardenData.trackedSouls[soulModel] = nil -- Allow retry
					end
				else
					print("[Auto Warden] Remote is nil! Cannot collect.")
				end
			end)
		else
			print("[Auto Warden] Soul found but has no Id attribute.")
		end
	end
end

wardenStart = function()
	if wardenData.connections.active then return end
	wardenData.connections.active = true
	wardenData.trackedSouls = {}

	print("[Auto Warden] Started! Listening for JailorSoul tags...")

	-- 1. Scan for existing souls
	local existingSouls = wardenData.cs:GetTagged("JailorSoul")
	print("[Auto Warden] Found " .. #existingSouls .. " existing souls.")
	for _, soul in ipairs(existingSouls) do
		if soul:IsA("Model") then
			task.spawn(wardenTryCollect, soul)
		end
	end

	-- Also scan by name just in case tags aren't applied instantly
	pcall(function()
		for _, obj in ipairs(G.Services.Workspace:GetDescendants()) do
			if obj:IsA("Model") and obj.Name == "JailorSoul" then
				task.spawn(wardenTryCollect, obj)
			end
		end
	end)

	wardenData.descendantConn = G.Services.Workspace.DescendantAdded:Connect(function(obj)
		if not loops["auto warden"] then return end
		if obj:IsA("Model") and obj.Name == "JailorSoul" then
			task.wait(0.1)
			task.spawn(wardenTryCollect, obj)
		end
	end)
	table.insert(wardenData.connections, wardenData.descendantConn)

	-- 3. Listen for removed souls to clean up cache
	table.insert(wardenData.connections, wardenData.cs:GetInstanceRemovedSignal("JailorSoul"):Connect(function(soul)
		wardenData.trackedSouls[soul] = nil
	end))

	-- 4. Fallback: Listen for G.Services.Workspace descendants named JailorSoul
	table.insert(wardenData.connections, G.Services.Workspace.DescendantAdded:Connect(function(obj)
		if loops["auto warden"] and obj:IsA("Model") and obj.Name == "JailorSoul" then
			task.wait(0.1)
			task.spawn(wardenTryCollect, obj)
		end
	end))
end

wardenStop = function()
	wardenData.connections.active = false
	if wardenData.connections then
		for _, conn in ipairs(wardenData.connections) do
			if typeof(conn) == "RBXScriptConnection" then
				pcall(function() conn:Disconnect() end)
			end
		end
	end
	wardenData.connections = {}
	wardenData.trackedSouls = {}
	print("[Auto Warden] Stopped.")
end


