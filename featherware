				end
			else
				-- If Killaura is turned off OR Sync is turned off, fall back to normal Aim Assist
				if bestTarget and bestTarget:FindFirstChild("Humanoid") and bestTarget.Humanoid.Health > 0 then
					currentTarget = bestTarget
				else
					currentTarget = nil
				end
			end

		end
	end)
end

