function sscIsFirstPerson()
	ssc_head = Player.Character and Player.Character:FindFirstChild("Head")
	if not ssc_head then return false end
	return (camera.CFrame.Position - ssc_head.Position).Magnitude < 1.5
end

function sscRemoveSkin(item)
	if not item or typeof(item) ~= "Instance" then return end
	ssc_old = item:FindFirstChild(item.Name .. "_Skin")
	if ssc_old then ssc_old:Destroy() end
	for _, ssc_v in ipairs(item:GetDescendants()) do
		if ssc_v:IsA("BasePart") then
			ssc_ot = ssc_v:GetAttribute("_sscOrigTransp")
			if ssc_ot ~= nil then ssc_v.Transparency = ssc_ot; ssc_v:SetAttribute("_sscOrigTransp", nil) end
			ssc_olm = ssc_v:GetAttribute("_sscOrigLTM")
			if ssc_olm ~= nil then ssc_v.LocalTransparencyModifier = ssc_olm; ssc_v:SetAttribute("_sscOrigLTM", nil) end
		elseif ssc_v:IsA("ParticleEmitter") or ssc_v:IsA("Trail") or ssc_v:IsA("Beam") then
			ssc_oe = ssc_v:GetAttribute("_sscOrigEnabled")
			if ssc_oe ~= nil then ssc_v.Enabled = ssc_oe; ssc_v:SetAttribute("_sscOrigEnabled", nil) end
		end
	end
	ssc_tracked[item] = nil
end

function sscApplySkin(item)
	if not item or typeof(item) ~= "Instance" then return end
	sscRemoveSkin(item)
	if not loops["sword skin changer"] then return end
	if not currentSelectedSkin or not itemsFolder then return end

	ssc_target = string.lower(item.Name .. "_" .. currentSelectedSkin)
	ssc_alt = string.lower(currentSelectedSkin .. "_" .. item.Name)
	ssc_replacement = itemsFolder:FindFirstChild(ssc_target) or itemsFolder:FindFirstChild(ssc_alt)
	if not ssc_replacement then return end
	ssc_handle = item:FindFirstChild("Handle")
	if not ssc_handle then return end
	ssc_skinHandle = ssc_replacement:FindFirstChild("Handle")
	if not ssc_skinHandle then return end

	ssc_hide = {}; ssc_fx = {}
	for _, ssc_v in ipairs(item:GetDescendants()) do
		if ssc_v:IsA("BasePart") then
			ssc_v:SetAttribute("_sscOrigTransp", ssc_v.Transparency)
			ssc_v:SetAttribute("_sscOrigLTM", ssc_v.LocalTransparencyModifier)
			ssc_v.Transparency = 1
			ssc_v.LocalTransparencyModifier = 1
			table.insert(ssc_hide, ssc_v)
		elseif ssc_v:IsA("ParticleEmitter") or ssc_v:IsA("Trail") or ssc_v:IsA("Beam") then
			ssc_v:SetAttribute("_sscOrigEnabled", ssc_v.Enabled)
			ssc_v.Enabled = false
			table.insert(ssc_fx, ssc_v)
		end
	end

	ssc_model = Instance.new("Model")
	ssc_model.Name = item.Name .. "_Skin"
	ssc_model.Parent = item

	ssc_skin = ssc_skinHandle:Clone()
	ssc_skin.Parent = ssc_model
	ssc_skin.Anchored = false
	ssc_skin.CanCollide = false
	ssc_skin.CanQuery = false
	ssc_skin.CanTouch = false
	ssc_skin.CastShadow = false
	ssc_skin.Massless = true

	if string.find(string.lower(item.Name), "axe") then
		ssc_skin.CFrame = ssc_handle.CFrame * CFrame.Angles(0, math.rad(90), 0)
	else
		ssc_skin.CFrame = ssc_handle.CFrame
	end

	ssc_weld = Instance.new("WeldConstraint")
	ssc_weld.Part0 = ssc_handle
	ssc_weld.Part1 = ssc_skin
	ssc_weld.Parent = ssc_skin
	ssc_model.PrimaryPart = ssc_skin

	ssc_info = { hide = ssc_hide, fx = ssc_fx, skin = {}, skinfx = {} }
	for _, ssc_d in ipairs(ssc_model:GetDescendants()) do
		if ssc_d:IsA("BasePart") then table.insert(ssc_info.skin, ssc_d)
		elseif ssc_d:IsA("ParticleEmitter") or ssc_d:IsA("Trail") or ssc_d:IsA("Beam") then table.insert(ssc_info.skinfx, ssc_d) end
	end
	ssc_vmnow = camera:FindFirstChild("Viewmodel") or camera:FindFirstChild("ViewModel")
	ssc_info.isViewmodel = (ssc_vmnow and item:IsDescendantOf(ssc_vmnow)) and true or false
	ssc_tracked[item] = ssc_info

	ssc_fp0 = sscIsFirstPerson()
	ssc_show0 = (ssc_info.isViewmodel and ssc_fp0) or (not ssc_info.isViewmodel and not ssc_fp0)
	ssc_opaq0 = ssc_show0 and 0 or 1
	for _, ssc_p in ipairs(ssc_info.skin) do ssc_p.Transparency = ssc_opaq0; ssc_p.LocalTransparencyModifier = ssc_opaq0 end
	for _, ssc_e in ipairs(ssc_info.skinfx) do ssc_e.Enabled = ssc_show0 end
end

function sscMaintain()
	ssc_fp = sscIsFirstPerson()
	for ssc_item, ssc_info in pairs(ssc_tracked) do
		if not ssc_item or not ssc_item.Parent or not ssc_item:FindFirstChild("Handle") or not ssc_item:FindFirstChild(ssc_item.Name .. "_Skin") then
			sscRemoveSkin(ssc_item)
		else
			ssc_show = (ssc_info.isViewmodel and ssc_fp) or (not ssc_info.isViewmodel and not ssc_fp)
			ssc_opaq = ssc_show and 0 or 1
			for _, ssc_p in ipairs(ssc_info.hide) do if ssc_p.Parent then ssc_p.Transparency = 1; ssc_p.LocalTransparencyModifier = 1 end end
			for _, ssc_e in ipairs(ssc_info.fx) do if ssc_e.Parent then ssc_e.Enabled = false end end
			for _, ssc_p in ipairs(ssc_info.skin) do if ssc_p.Parent then ssc_p.Transparency = ssc_opaq; ssc_p.LocalTransparencyModifier = ssc_opaq end end
			for _, ssc_e in ipairs(ssc_info.skinfx) do if ssc_e.Parent then ssc_e.Enabled = ssc_show end end
		end
	end
end

function sscScanParent(ssc_par)
	if not ssc_par then return end
	for _, ssc_ch in ipairs(ssc_par:GetChildren()) do
		if not ssc_tracked[ssc_ch] and ssc_ch:FindFirstChild("Handle") then sscApplySkin(ssc_ch) end
	end
end

function sscReconcile()
	sscScanParent(Player.Character)
	ssc_vm2 = camera:FindFirstChild("Viewmodel") or camera:FindFirstChild("ViewModel")
	sscScanParent(ssc_vm2)
end

function sscApplyAll()
	if Player.Character then
		for _, ssc_item in ipairs(Player.Character:GetChildren()) do sscApplySkin(ssc_item) end
	end
	ssc_vm = camera:FindFirstChild("Viewmodel") or camera:FindFirstChild("ViewModel")
	if ssc_vm then
		for _, ssc_item in ipairs(ssc_vm:GetChildren()) do sscApplySkin(ssc_item) end
	end
end

function sscClearAll()
	if Player.Character then
		for _, ssc_item in ipairs(Player.Character:GetChildren()) do sscRemoveSkin(ssc_item) end
	end
	ssc_vm = camera:FindFirstChild("Viewmodel") or camera:FindFirstChild("ViewModel")
	if ssc_vm then
		for _, ssc_item in ipairs(ssc_vm:GetChildren()) do sscRemoveSkin(ssc_item) end
	end
end

