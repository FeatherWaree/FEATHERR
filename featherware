function ieUpdateLabels()
	ie_char = Player.Character
	ie_hrp = ie_char and ie_char:FindFirstChild("HumanoidRootPart")
	if not ie_hrp then return end
	ie_maxDist = ItemESP.Values["Max Distance"] or 200
	for ie_inst, ie_data in pairs(ie_objects) do
		if not ie_inst.Parent then ieRemoveESP(ie_inst) continue end
		ie_pos = ie_inst.Position
		ie_dist = (ie_pos - ie_hrp.Position).Magnitude
		if ie_dist > ie_maxDist then ie_data.bb.Enabled = false continue end
		ie_data.bb.Enabled = true
		ie_lines = {}
		ie_name = ie_inst.Name:gsub("_", " ")
		ie_amt = ie_inst:GetAttribute("Amount") or 1
		if ItemESP.Values["Show Amount"] and ie_amt > 1 then
			table.insert(ie_lines, ie_name .. " x" .. tostring(ie_amt))
		else
			table.insert(ie_lines, ie_name)
		end
		if ItemESP.Values["Show Distance"] then
			table.insert(ie_lines, string.format("%d studs", math.round(ie_dist)))
		end
		ie_data.lbl.Text = table.concat(ie_lines, "\n")
		ie_data.lbl.TextColor3 = ItemESP.Values["Item Color"] or Color3.fromRGB(255, 255, 100)
		ie_data.lbl.TextSize = ItemESP.Values["Text Size"] or 12
	end
