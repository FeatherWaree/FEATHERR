			if type(p_hand) == "table" then
				if type(p_hand.item) == "table" and p_hand.item.itemType then return p_hand.item.itemType end
				if type(p_hand.item) == "string" then return p_hand.item end
				if p_hand.itemType then return p_hand.itemType end
			elseif type(p_hand) == "string" then
				return p_hand
			end
		end
	end
	p_char = Players.LocalPlayer.Character
	if p_char then
		p_hi = p_char:FindFirstChild("HandInvItem")
		if p_hi then
			if typeof(p_hi.Value) == "Instance" then return p_hi.Value.Name end
			if typeof(p_hi.Value) == "string" then return p_hi.Value end
		end
		p_tool = p_char:FindFirstChildWhichIsA("Tool")
		if p_tool then return p_tool.Name end
		for _, L in ipairs(PA_LOADOUTS) do
			if p_char:FindFirstChild(L.weapon.Name) then return L.weapon.Name end
		end
	end
	return nil
end

