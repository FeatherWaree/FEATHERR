				if loops["nofall"] then
					nfEnableStateConnections(newHum)
				end
			end
		end)
	else
		-- Disconnect the loop
		if nofall.conn then 
			nofall.conn:Disconnect()
			nofall.conn = nil 
		end

		-- Re-enable StateChanged connections
		nfDisableStateConnections()

		if nfCharAddedConn then 
			nfCharAddedConn:Disconnect()
			nfCharAddedConn = nil
		end
	end
end

