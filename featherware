laniGetTarget = function()
	if laniSettings.targetMode == "Manual" then
		if laniSettings.targetPlayer == "" then return nil end
		return Players:FindFirstChild(laniSettings.targetPlayer)
	end

	myChar = Players.LocalPlayer.Character
	if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end
	myPos = myChar.HumanoidRootPart.Position

	validTargets = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if player == Players.LocalPlayer then continue end
		if player.Team ~= Players.LocalPlayer.Team then continue end

		char = player.Character
		if char and char:FindFirstChild("HumanoidRootPart") then
			hum = char:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 then
				table.insert(validTargets, {player = player, char = char, hum = hum})
			end
		end
	end

	if #validTargets == 0 then return nil end

	if laniSettings.targetMode == "Random" then
		return validTargets[math.random(1, #validTargets)].player
	elseif laniSettings.targetMode == "Closest" then
		best = nil
		bestDist = math.huge
		for _, t in ipairs(validTargets) do
			dist = (t.char.HumanoidRootPart.Position - myPos).Magnitude
			if dist < bestDist then
				bestDist = dist
				best = t.player
			end
		end
		return best
	elseif laniSettings.targetMode == "Lowest Health" then
		best = nil
		bestPercent = math.huge
		for _, t in ipairs(validTargets) do
			percent = t.hum.Health / t.hum.MaxHealth
			if percent < bestPercent then
				bestPercent = percent
				best = t.player
			end
		end
		return best
	end

	return nil
end

