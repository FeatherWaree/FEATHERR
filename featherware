					end
					if ka_skinMeta and type(ka_skinMeta.sword) == "table" and type(ka_skinMeta.sword.hitSounds) == "table" and #ka_skinMeta.sword.hitSounds > 0 then
						ka_sndId = ka_skinMeta.sword.hitSounds[math.random(1, #ka_skinMeta.sword.hitSounds)]
						if type(ka_sndId) == "string" then
							if not string.find(ka_sndId, "rbxassetid") then ka_sndId = "rbxassetid://" .. ka_sndId end
							ka_snd = FWNoModules.OwnInstance(Instance.new("Sound"))
							ka_snd.SoundId = ka_sndId
							ka_snd.Volume = 1
							ka_snd.Parent = G.Services.Workspace.CurrentCamera or G.Services.Workspace
							ka_snd.PlayOnRemove = true
							ka_snd:Destroy()
						end
					end
				end
			end

            local sentAt=os.clock()
            local sentServer=G.Services.Workspace:GetServerTimeNow()
			SwordHitRemote:FireServer(unpack(kaArgs))
            kaSync:Sent(sentAt,sentServer,besttarget,kaSync.locked)
            if Killaura.Values["Adaptive Hit Timing"]and kaSwordController then kaSwordController.lastAttack=sentServer end
			kaPacer:Commit(sentAt, attackDelay)
		end
	end))
end

