function vaIsTeamSafe(plr)
	if not VulcanAimbot.Values["Ignore Team/Spectators"] then return true end
	if not plr.Team then return true end
	if Player.Team and plr.Team == Player.Team then return false end
	va_tn = plr.Team.Name:lower()
	if va_tn:find("spectator") or va_tn:find("spectate") then return false end
	return true
end

function vaWallClear(from, to, turret, targetModel)
	if not VulcanAimbot.Values["Ignore Behind Walls"] then return true end
	va_d = to - from
	va_dist = va_d.Magnitude
	if va_dist < 0.1 then return true end
	va_wallParams.FilterDescendantsInstances = { turret, targetModel }
	va_hit = G.Services.Workspace:Raycast(from, va_d.Unit * (va_dist + 0.5), va_wallParams)
	if not va_hit then return true end
	if va_hit.Instance:IsDescendantOf(targetModel) then return true end
	return false
end

function vaCalcAngles(from, to)
	va_d = to - from
	va_mag = va_d.Magnitude
	if va_mag < 0.01 then return nil, nil end
	va_dx, va_dy, va_dz = va_d.X / va_mag, va_d.Y / va_mag, va_d.Z / va_mag
	va_yaw = math.atan2(-va_dx, -va_dz)
	va_pitch = math.asin(math.clamp(va_dy, -1, 1))
	va_pitch = math.clamp(va_pitch, -0.8, 0.8)
	return va_yaw, va_pitch
end

