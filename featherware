		-- Define these locally for the drag logic just in case they aren't at the top of your script
		local RunService = G.Services.RunService
		local UserInputService = G.Services.UIS

        local stopSliderDrag
        FWNoModules.Connect(bg.InputBegan,function(input)
            if input.UserInputType~=Enum.UserInputType.MouseButton1 and input.UserInputType~=Enum.UserInputType.Touch then return end
            if stopSliderDrag then stopSliderDrag()end
            local unlock=FWNoModules.Mobile.LockScroll(sFrame)
