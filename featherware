function nfDisableStateConnections()
	for _, conn in ipairs(nfStateChangedConns) do
		pcall(function() conn:Disable() end)
	end
	nfStateChangedConns = {}
end

function nfEnableStateConnections(hum)
	nfDisableStateConnections()
	if getconnections then
