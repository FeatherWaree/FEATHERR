function velocityHeartbeat()
	if not cachedVelocityHRP or not cachedVelocityHum then return end
	if cachedVelocityHum.Health <= 0 then return end

	currentVel = cachedVelocityHRP.AssemblyLinearVelocity
	deltaVel = currentVel - lastVelocity

	-- FIX: Ignore vertical velocity changes if jumping to prevent false positives
	if UserInputService:IsKeyDown(Enum.KeyCode.Space) or (currentVel.Y > 15 and lastVelocity.Y >= 0) then
		deltaVel = Vector3.new(deltaVel.X, 0, deltaVel.Z)
	end

	forceMagnitude = deltaVel.Magnitude
	isKnockbackHit = forceMagnitude > 18 -- Slightly lowered threshold to catch weaker hits

	if isKnockbackHit then
		lookVector = cachedVelocityHRP.CFrame.LookVector
		forceDirection = deltaVel.Magnitude > 0.01 and deltaVel.Unit or Vector3.zero
		alignment = lookVector:Dot(forceDirection)

		-- If the knockback is mostly forward (e.g. from sprinting), ignore it
		if alignment > 0.7 then 
			isKnockbackHit = false 
		end
	end

	chance = Velocity.Values["Chance"] or 100
	chancePass = math.random() * 100 < chance

	if isKnockbackHit and chancePass then
		isOnBridge = IsOnVoidOrBridge(cachedVelocityHRP)

		if isOnBridge and Velocity.Values["Take Knockback On Bridges"] == false then
			cachedVelocityHRP.AssemblyLinearVelocity = Vector3.new(0, currentVel.Y, 0)
			lastVelocity = cachedVelocityHRP.AssemblyLinearVelocity
			return
		end

		hMaster = (isOnBridge and (Velocity.Values["Bridge Horizontal Knockback"] or 100) or (Velocity.Values["Horizontal"] or 100)) / 100
		vMaster = (isOnBridge and (Velocity.Values["Bridge Vertical Knockback"] or 100) or (Velocity.Values["Velocity"] or 100)) / 100

		localHit = cachedVelocityHRP.CFrame:VectorToObjectSpace(deltaVel)

		modX = (localHit.X * ((localHit.X > 0 and Velocity.Values["Right Knockback"] or Velocity.Values["Left Knockback"]) / 100)) * hMaster
		modZ = (localHit.Z * ((localHit.Z > 0 and Velocity.Values["Back Knockback"] or Velocity.Values["Front Knockback"]) / 100)) * hMaster
		modY = (localHit.Y * ((localHit.Y > 0 and Velocity.Values["Up Knockback"] or Velocity.Values["Down Knockback"]) / 100)) * vMaster

		kbDir = Velocity.Values["Knockback Direction"] or "Normal"
		if kbDir == "Backwards" then modZ = math.abs(modZ); modX = 0
		elseif kbDir == "Reversed" then modX = -modX; modZ = -modZ; modY = -modY
		elseif kbDir == "Up" then modX = 0; modZ = 0; modY = math.max(50, math.abs(modY)) end

		if hMaster == 0 and vMaster == 0 then
			cachedVelocityHRP.AssemblyLinearVelocity = Vector3.new(0, currentVel.Y, 0)
			lastVelocity = cachedVelocityHRP.AssemblyLinearVelocity
			return 
		end

		newWorld = cachedVelocityHRP.CFrame:VectorToWorldSpace(Vector3.new(modX, (vMaster > 0 and modY or 0), modZ))

		cachedVelocityHRP.AssemblyLinearVelocity = Vector3.new(
			(hMaster == 0 and 0 or (currentVel.X - deltaVel.X + newWorld.X)),
			(vMaster == 0 and currentVel.Y or (currentVel.Y - deltaVel.Y + newWorld.Y)),
			(hMaster == 0 and 0 or (currentVel.Z - deltaVel.Z + newWorld.Z))
		)

		lastVelocity = cachedVelocityHRP.AssemblyLinearVelocity
		return
	end

	lastVelocity = currentVel
end

