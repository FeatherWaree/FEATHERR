function createESPContainer(model)
	if activeESPCache[model] then return end

	hrp = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
	head = model:FindFirstChild("Head")
	hum = model:FindFirstChildOfClass("Humanoid")

	if not hrp or not head then return end

	container = {
		Model = model,
		HRP = hrp,
		Head = head,
		Frame2D = nil,
		Stroke2D = nil,
		Box3D = nil,
		Selection3D = nil,
		Weld3D = nil,
		SkeletonLines = {},
		CachedJoints = {}
	}

	-- Parent 2D elements to mainScreenUI so they hide with the menu
	frame2D = Instance.new("Frame")
	frame2D.Name = "2D_ESP_Frame"
	frame2D.BackgroundTransparency = 1
	frame2D.BorderSizePixel = 0
	frame2D.Size = UDim2.fromOffset(0, 0)
	frame2D.Visible = false
	frame2D.Parent = espScreenGui

	stroke2D = Instance.new("UIStroke")
	stroke2D.Thickness = 1.5
	stroke2D.Parent = frame2D

	container.Frame2D = frame2D
	container.Stroke2D = stroke2D

	cf, sz = model:GetBoundingBox()

	box3D = Instance.new("Part")
	box3D.Name = "3D_ESP_BOX"
	box3D.Anchored = false
	box3D.CanCollide = false
	box3D.Massless = true 
	box3D.CanTouch = false
	box3D.CanQuery = false 
	box3D.Material = Enum.Material.SmoothPlastic
	box3D.Size = sz
	box3D.CFrame = cf
	box3D.Transparency = 1
	box3D.Parent = model

	weld3D = Instance.new("WeldConstraint")
	weld3D.Part0 = box3D
	weld3D.Part1 = hrp
	weld3D.Parent = box3D

	sel3D = Instance.new("SelectionBox")
	sel3D.Adornee = box3D
	sel3D.LineThickness = 0.05
	sel3D.Visible = false
	sel3D.Parent = box3D

	container.Box3D = box3D
	container.Selection3D = sel3D
	container.Weld3D = weld3D

	jointList = (hum and hum.RigType == Enum.HumanoidRigType.R15) and R15_JOINTS or R6_JOINTS
	for _, pair in pairs(jointList) do
		p1 = model:FindFirstChild(pair[1])
		p2 = model:FindFirstChild(pair[2])
		if p1 and p2 then
			table.insert(container.CachedJoints, {p1, p2})

			line = Instance.new("Frame")
			line.Name = "SkeletonLine"
			line.AnchorPoint = Vector2.new(0.5, 0.5)
			line.BorderSizePixel = 0
			line.BackgroundTransparency = 0
			line.Visible = false
			line.Parent = espScreenGui

			stroke = Instance.new("UIStroke")
			stroke.Thickness = 1
			stroke.Color = Color3.new(0, 0, 0)
			stroke.Parent = line

			table.insert(container.SkeletonLines, line)
		end
	end

	activeESPCache[model] = container
end

function removeESPContainer(model)
	data = activeESPCache[model]
	if not data then return end

	if data.Frame2D then data.Frame2D:Destroy() end
	if data.Box3D then data.Box3D:Destroy() end
	for _, line in pairs(data.SkeletonLines) do
		if line then line:Destroy() end
	end

	activeESPCache[model] = nil
end

function updateESP()
	cam = G.Services.Workspace.CurrentCamera
	if not cam then return end

	mode = getSetting("ESP Mode", "2D")
	color2D = getSetting("2D Box Color", Color3.fromRGB(255, 0, 0))
	fill2D = getSetting("Fill 2D Box", false)
	color3D = getSetting("3D Box Color", Color3.fromRGB(85, 0, 127))
	fill3D = getSetting("Fill 3D Box", true)
	colorSkel = getSetting("Skeleton Color", Color3.fromRGB(255, 0, 0))

	camPos = cam.CFrame.Position

	-- SYNC: Check EntityCache for any new models that need ESP containers created
	local function syncWithCache(cacheTable)
		for _, model in ipairs(cacheTable) do
			if model and model.Parent and not activeESPCache[model] then
				createESPContainer(model)
			end
		end
	end

	syncWithCache(EntityCache.Players)
	syncWithCache(EntityCache.NPCs)

	-- Render Loop
	for model, data in pairs(activeESPCache) do
		-- CLEANUP: If the model is no longer in the EntityCache, remove its ESP
		if not table.find(EntityCache.Players, model) and not table.find(EntityCache.NPCs, model) then
			removeESPContainer(model)
			continue
		end

		if not isValidTarget(model) then
			if data.Frame2D then data.Frame2D.Visible = false end
			if data.Box3D then data.Box3D.Transparency = 1 end
			if data.Selection3D then data.Selection3D.Visible = false end
			for _, line in pairs(data.SkeletonLines) do line.Visible = false end
			continue
		end

		hrpPos = data.HRP.Position
		if (hrpPos - camPos).Magnitude > 500 then
			if data.Frame2D then data.Frame2D.Visible = false end
			if data.Box3D then data.Box3D.Transparency = 1 end
			continue
		end

		if mode == "2D" then
			if data.Box3D then data.Box3D.Transparency = 1 end
			if data.Selection3D then data.Selection3D.Visible = false end
			for _, line in pairs(data.SkeletonLines) do line.Visible = false end

			topPos = data.Head.Position + Vector3.new(0, data.Head.Size.Y * 0.5 + 0.2, 0)
			botPos = data.HRP.Position - Vector3.new(0, data.HRP.Size.Y * 1.5, 0)

			topScreen, topVis = cam:WorldToViewportPoint(topPos)
			botScreen, botVis = cam:WorldToViewportPoint(botPos)

			if topVis or botVis then
				height = math.abs(topScreen.Y - botScreen.Y)
				width = height * 0.55
				data.Frame2D.Position = UDim2.fromOffset(topScreen.X - (width / 2), topScreen.Y)
				data.Frame2D.Size = UDim2.fromOffset(width, height)
				data.Stroke2D.Color = color2D
				data.Frame2D.BackgroundColor3 = color2D
				data.Frame2D.BackgroundTransparency = fill2D and 0.65 or 1
				data.Frame2D.Visible = true
			else
				data.Frame2D.Visible = false
			end
		elseif mode == "3D" then
			if data.Frame2D then data.Frame2D.Visible = false end
			for _, line in pairs(data.SkeletonLines) do line.Visible = false end
			if data.Box3D and data.Selection3D then
				data.Box3D.Color = color3D
				data.Box3D.Transparency = fill3D and 0.65 or 1
				data.Selection3D.Color3 = color3D
				data.Selection3D.Visible = true
			end
		elseif mode == "Skeleton" then
			if data.Frame2D then data.Frame2D.Visible = false end
			if data.Box3D then data.Box3D.Transparency = 1 end
			if data.Selection3D then data.Selection3D.Visible = false end
			for idx, pair in pairs(data.CachedJoints) do
				v1, vis1 = cam:WorldToViewportPoint(pair[1].Position)
				v2, vis2 = cam:WorldToViewportPoint(pair[2].Position)
				lineFrame = data.SkeletonLines[idx]
				if vis1 and vis2 and lineFrame then
					ptA = Vector2.new(v1.X, v1.Y)
					ptB = Vector2.new(v2.X, v2.Y)
					dist = (ptB - ptA).Magnitude
					center = (ptA + ptB) * 0.5
					ang = math.deg(math.atan2(ptB.Y - ptA.Y, ptB.X - ptA.X))
					lineFrame.Position = UDim2.fromOffset(center.X, center.Y)
					lineFrame.Size = UDim2.fromOffset(dist, 3)
					lineFrame.Rotation = ang
					lineFrame.BackgroundColor3 = colorSkel
					lineFrame.Visible = true
				elseif lineFrame then
					lineFrame.Visible = false
				end
			end
		end
	end
end

function cleanAllESP()
	for name, conn in pairs(espConnections) do
		if conn then pcall(function() conn:Disconnect() end) end
	end
	espConnections = {}
	for model, _ in pairs(activeESPCache) do
		removeESPContainer(model)
	end
	activeESPCache = setmetatable({}, {__mode = "k"})
end

