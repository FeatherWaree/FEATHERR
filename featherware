					return 
				end
			end

			hrp = cachedChar:FindFirstChild("HumanoidRootPart")
			if not hrp then return end

			-- ===== BULLETPROOF CONFIG & SLIDER PARSER =====
			rawVal = Speed.Values["Speed"]

			-- Unpack if the UI stored the value in a table object
			if typeof(rawVal) == "table" then
				rawVal = rawVal.Value or rawVal.Val or rawVal[1]
			end

			parsedVal = tonumber(rawVal)

			if parsedVal then
				-- Fix 1: If saved as a normalized float (e.g. 0.64 ratio of 75 max speed)
				if parsedVal > 0 and parsedVal < 1 then
					targetSpeed = math.round(parsedVal)
					-- Fix 2: If config load yields 1 on initial frame, use last known valid speed or default 20
				elseif parsedVal == 1 then
					if lastValidSpeed and lastValidSpeed > 1 then
						targetSpeed = lastValidSpeed
					else
						targetSpeed = 20
					end
				else
					targetSpeed = parsedVal
				end
			else
				targetSpeed = 20
			end

			-- Save valid target speed so initial rejoin glitches won't reset your config
			if targetSpeed > 1 then
				lastValidSpeed = targetSpeed
			end

			hasLegitBoost = false 

			if zephyrStacks and zephyrStacks >= 1 then
				targetSpeed = 34
				hasLegitBoost = true
			elseif cachedChar:GetAttribute("SpeedBoost") == 1.5 then
				targetSpeed = 33
				hasLegitBoost = true
			elseif FWNoModules.GetPrivateInventory(Player) and FWNoModules.GetPrivateInventory(Player):FindFirstChild("speed_potion") then
				targetSpeed = 33
				hasLegitBoost = true

				if not consumingPotion then
					consumingPotion = true
					NotificationSystem.Notify("Speed Potion", "Consuming speed potion...", 2)

					task.spawn(function()
						local currentInventory = FWNoModules.GetPrivateInventory(Player)
                        local potion = currentInventory and currentInventory:FindFirstChild("speed_potion")
                        if potion then
                            G.Services.RS.rbxts_include.node_modules["@rbxts"].net.out._NetManaged.ConsumeItem:InvokeServer({item = potion})
                        end
						task.wait(1) 
						consumingPotion = false
					end)
				end
			end

			if Speed.Values["Speed Booster"] then
				timeInCycle = os.clock() % 1.5 
				if timeInCycle < 1.25 then
					targetSpeed = targetSpeed + 1
				end
			end

			if hasLegitBoost then
				cachedHumanoid.WalkSpeed = targetSpeed
			elseif targetSpeed <= 20 then
				cachedHumanoid.WalkSpeed = targetSpeed
			else
				cachedHumanoid.WalkSpeed = 20 

				if cachedHumanoid.MoveDirection.Magnitude > 0 then
					extraSpeed = targetSpeed - 20 
					displacement = cachedHumanoid.MoveDirection * (extraSpeed * deltaTime)
					hrp.CFrame = hrp.CFrame + displacement
				end
			end
		end))
	else
		liveChar = Player.Character
		liveHum = liveChar and liveChar:FindFirstChildOfClass("Humanoid")
		if liveHum then
			liveHum.WalkSpeed = 20
		elseif cachedHumanoid then
			cachedHumanoid.WalkSpeed = 20
		end
		NotificationSystem.Notify("Speed", "Speed disabled.", 2)
	end
