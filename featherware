warriorCheckAndFire = function()
	if not loops["auto warrior"] then return end

	-- 1. Check if Warrior Kit is equipped
	kitAttr = PlayersService.LocalPlayer:GetAttribute("PlayingAsKits")
	if kitAttr ~= "warrior" then
		if not warriorData.notified then
			warriorSendNotification("Auto Warrior", "Warrior kit is not equipped! Module disabled.")
			warriorData.notified = true
		end
		return
	end

	-- Reset notification flag if kit is equipped
	warriorData.notified = false

	now = os.clock()
	if now - warriorData.lastFire < WARRIOR_COOLDOWN then return end

	char = PlayersService.LocalPlayer.Character
	if not char then return end

	hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return end

	-- 2. Check HP Percentage
	hpPercent = (hum.Health / hum.MaxHealth) * 100
	hpLimit = AutoWarrior.Values["HP Threshold"] or 80

	if hpPercent >= hpLimit then return end -- HP is too high, don't use

	-- 3. Check Grit Attribute
	grit = PlayersService.LocalPlayer:GetAttribute("Grit") or 0
	gritLimit = AutoWarrior.Values["Grit Threshold"] or 60

	if grit < gritLimit then return end -- Grit is too low, don't use

	-- 4. Fire Ability
	if not warriorLoadRemote() then return end

	warriorData.lastFire = now
	print("[Auto Warrior] HP: " .. math.floor(hpPercent) .. "% (<" .. hpLimit .. "%) | Grit: " .. grit .. " (>=" .. gritLimit .. "). Firing warrior_strike!")

	pcall(function()
		warriorData.abilityRemote:FireServer("warrior_strike")
	end)
end

warriorHookSignals = function()
	-- Disconnect old connections
	if warriorData.hpConn then pcall(function() warriorData.hpConn:Disconnect() end) warriorData.hpConn = nil end
	if warriorData.gritConn then pcall(function() warriorData.gritConn:Disconnect() end) warriorData.gritConn = nil end

	-- Hook Grit changes on LocalPlayer
	warriorData.gritConn = PlayersService.LocalPlayer:GetAttributeChangedSignal("Grit"):Connect(function()
		warriorCheckAndFire()
	end)

	-- Hook Health changes on Character
	char = PlayersService.LocalPlayer.Character
	if char then
		hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			warriorData.hpConn = hum.HealthChanged:Connect(function()
				warriorCheckAndFire()
			end)
		end
	end

	-- Initial check
	task.wait(0.1)
	warriorCheckAndFire()
end

warriorStart = function()
	warriorHookSignals()

	-- Re-hook health signal on respawn
	if not warriorData.charConn then
		warriorData.charConn = PlayersService.LocalPlayer.CharacterAdded:Connect(function(char)
			if loops["auto warrior"] then
				task.wait(0.5) -- Wait for humanoid to load
