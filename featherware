eldricIsEnemy = function(entity)
	if not entity then return false end
	plr = PlayersService:GetPlayerFromCharacter(entity)
	if plr then
		if plr == PlayersService.LocalPlayer then return false end
		if plr.Team and PlayersService.LocalPlayer.Team and plr.Team == PlayersService.LocalPlayer.Team then return false end
		if plr:GetAttribute("Spectating") or plr:GetAttribute("IsSpectator") then return false end
		return true
	end
	hum = entity:FindFirstChildOfClass("Humanoid")
	if hum and hum.Health > 0 then return true end
	return false
end

