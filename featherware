    end
end

-- Update in-memory settings immediately. Coalesce disk writes during drags.
local saveConfigToPC
do
    local runtime = FWNoModules.Runtime
    local pending
    local function flush()
        if pending then task.cancel(pending); pending = nil end
        local ok, problem=FWNoModules.Profiles.Flush()
        if not ok then warn("[Featherware] Could not save profile: "..tostring(problem)) end
    end
    saveConfigToPC = function(force)
        if force then flush(); return end
        if not writefile or not runtime.active or pending or FWNoModules.Profiles.busy then return end
        pending = task.delay(0.25, function()
            pending = nil
            if runtime.active then flush() end
        end)
    end
    runtime.FlushConfig = flush
    local configPlayer = game:GetService("Players").LocalPlayer
    FWNoModules.Connect(configPlayer.OnTeleport, flush)
end


