-- 5. PLAYER TRACKING (No CollectionService, tracks characters directly via Player events)
EC_AddPlayerChar = function(char)
	if char and char:IsA("Model") then
		if not table.find(EntityCache.Players, char) then
			table.insert(EntityCache.Players, char)
		end
	end
end

EC_RemovePlayerChar = function(char)
	local pIdx = table.find(EntityCache.Players, char)
	if pIdx then
		table.remove(EntityCache.Players, pIdx)
	end
end

FWNoModules.PlayerCacheRecords = {}
EC_RemovePlayer = function(plr)
    local record = FWNoModules.PlayerCacheRecords[plr]
    if not record then return end
    FWNoModules.PlayerCacheRecords[plr] = nil
    if record.Character then EC_RemovePlayerChar(record.Character) end
    FWNoModules.ReleaseConnection(record.Added)
    FWNoModules.ReleaseConnection(record.Removing)
end
EC_SetupPlayer = function(plr)
    if FWNoModules.PlayerCacheRecords[plr] then return end
    local record = {Character = plr.Character}
    FWNoModules.PlayerCacheRecords[plr] = record
    if record.Character then EC_AddPlayerChar(record.Character) end
    record.Added = FWNoModules.Connect(plr.CharacterAdded, function(newChar)
        if record.Character and record.Character ~= newChar then EC_RemovePlayerChar(record.Character) end
        record.Character = newChar
        EC_AddPlayerChar(newChar)
    end)
    record.Removing = FWNoModules.Connect(plr.CharacterRemoving, function(oldChar)
        EC_RemovePlayerChar(oldChar)
        if record.Character == oldChar then record.Character = nil end
    end)
end
FWNoModules.Connect(EC_PlayersService.PlayerRemoving, EC_RemovePlayer)
FWNoModules.OnCleanup(function()
    for _, record in pairs(FWNoModules.PlayerCacheRecords) do
        FWNoModules.ReleaseConnection(record.Added)
        FWNoModules.ReleaseConnection(record.Removing)
    end
    table.clear(FWNoModules.PlayerCacheRecords)
    table.clear(EntityCache.Players)
    table.clear(EntityCache.NPCs)
end)

-- Scan players already in the server
for _, plr in ipairs(FWNoModules.PlayerSnapshot()) do
