eldricLoop = function()
	if not loops["auto eldric"] then return end

	localPlayer = PlayersService.LocalPlayer
	now = os.clock()

	if now - eldricData.lastFire < ELDRIC_COOLDOWN then return end

	if eldricHasActiveTarget() then return end

	invFolder = FWNoModules.GetPrivateInventoryContainer()
	if not invFolder then return end
	myInv = FWNoModules.GetPrivateInventory(localPlayer.Name)
	if not myInv then return end

	warlockStaff = myInv:FindFirstChild("warlock_staff")
	if not warlockStaff then
		if not eldricData.notified then
			eldricSendNotification("Auto Eldric", "Warlock Staff not found in inventory! Module paused.")
			eldricData.notified = true
		end
		return
	end
	eldricData.notified = false

	target = eldricGetValidTarget(eldricSettings.range, eldricSettings.healthPercent)
	if target then
		if not eldricLoadRemotes() then return end

		eldricData.lastFire = now

		pcall(function()
			if not eldricIsStaffEquipped() then
				args = {
					{
						hand = warlockStaff
					}
				}
				eldricData.setInvItemRemote:InvokeServer(unpack(args))
			end

			abilityArgs = {
				"WARLOCK_LINK"
			}
			eldricData.useAbilityRemote:FireServer(unpack(abilityArgs))

			targetArgs = {
				{
					target = target
				}
			}
			eldricData.linkTargetRemote:InvokeServer(unpack(targetArgs))
		end)

		eldricPlayEffects()
	end
end

