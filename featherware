    local function matches(value, query)
        value = string.lower(tostring(value or ""))
        for word in string.gmatch(string.lower(query), "%S+") do
            if not string.find(value, word, 1, true) then return false end
        end
        return true
    end

    local function button(parent, text, width, right)
        local control = FWNoModules.OwnInstance(Instance.new("TextButton"))
        control.BackgroundTransparency = 1
