Sprint.Callbacks.OnToggle = function(state)
	loops["sprint"] = state

	if state and canRequire then
		SprintConstants.RUN_FOV_MULT = Sprint.Values["FOV Multipler"]

		SprintController.attemptingSprint = true
		SprintController:startSprinting()

		-- Hook the stop function directly (No Loops)
		FWNoModules.RestoreMethod(SprintController, "stopSprinting")
		SprintController.stopSprinting = function(self, ...)
			local result = origStopSprinting(self, ...)

			if loops["sprint"] and not sprintDebounce then
				sprintDebounce = true

				self.attemptingSprint = true

				task.spawn(function()
					if self.attemptingSprint then
						self:startSprinting()
					end
					sprintDebounce = false
				end)
			end

			return result
		end

	elseif not state and canRequire then
		SprintConstants.RUN_FOV_MULT = 1.1

		if origStopSprinting then
			SprintController.stopSprinting = origStopSprinting
		end

		SprintController:stopSprinting(true)
	end
end
-- Trigger target eligibility. Detection keeps its original mouse/raycast behaviour.
FWNoModules.TriggerChecks = {}
do
    local checks = FWNoModules.TriggerChecks
    local function spectatorFlag(entity)
        return entity and (entity:GetAttribute("Spectating") == true or entity:GetAttribute("Spectating") == 1
            or entity:GetAttribute("IsSpectator") == true or entity:GetAttribute("IsSpectator") == 1)
    end
    local function spectatorName(name)
        return type(name) == "string" and string.find(string.lower(name), "spectat", 1, true) ~= nil
    end
    function checks.IsSpectator(player, character)
        return spectatorFlag(player) or spectatorFlag(character)
            or (player and player.Team and spectatorName(player.Team.Name))
            or (player and spectatorName(player:GetAttribute("Team")))
            or (character and spectatorName(character:GetAttribute("Team")))
    end
    function checks.SameTeam(localPlayer, targetPlayer, character)
        if targetPlayer and localPlayer.Team ~= nil and targetPlayer.Team == localPlayer.Team then return true end
        for _, attribute in ipairs({"Team", "TeamId"}) do
            local own = localPlayer:GetAttribute(attribute)
            local other = targetPlayer and targetPlayer:GetAttribute(attribute)
            if other == nil and character then other = character:GetAttribute(attribute) end
            if own ~= nil and other ~= nil and own == other then return true end
        end
        return false
    end
    function checks.Allowed(localPlayer, targetPlayer, character)
        local localCharacter = localPlayer.Character
        if not character or character == localCharacter or targetPlayer == localPlayer then return false end
        if checks.IsSpectator(localPlayer, localCharacter) or checks.IsSpectator(targetPlayer, character) then return false end
        if checks.SameTeam(localPlayer, targetPlayer, character) then return false end
        return true
    end
end

TRIGGER_RADIUS = 3.5
TRIGGER_MAXDIST = 22
WS = G.Services.Workspace
TRIGGER_FAN_DEG = 3
triggerThread = nil

do
    local query = RaycastParams.new()
    query.FilterType = Enum.RaycastFilterType.Exclude
    local queryCharacter
    local function queryParams()
        local character = Player.Character
        if queryCharacter ~= character then
            queryCharacter = character
            query.FilterDescendantsInstances = character and {character} or {}
        end
        return query
    end

    function fanRay(ray)
        local camera = G.Services.Workspace.CurrentCamera
        if not camera then return nil end
        local right, up, direction = camera.CFrame.RightVector, camera.CFrame.UpVector, ray.Direction
        local spread = math.rad(TRIGGER_FAN_DEG)
        local offsets = {(direction + right * spread).Unit, (direction - right * spread).Unit,
            (direction + up * spread).Unit, (direction - up * spread).Unit}
        local params = queryParams()
        for index = 1, 4 do
            local hit = WS:Raycast(ray.Origin, offsets[index] * TRIGGER_MAXDIST, params)
            if hit then
                local model = trigModelOf(hit.Instance)
                if model then return model end
            end
        end
        return nil
    end

    function trigModelOf(instance)
        local model = instance
        while model and model ~= G.Services.Workspace and model ~= game do
            if model:IsA("Model") and model ~= Player.Character then
                local humanoid = model:FindFirstChildOfClass("Humanoid")
                if humanoid and humanoid.Health > 0 then
                    local targetPlayer = Players:GetPlayerFromCharacter(model)
                    local selected = targetPlayer and TriggerBot.Values["Target Players"]
                        or (not targetPlayer and TriggerBot.Values["Target NPCs/Dummies"])
                    if selected and FWNoModules.TriggerChecks.Allowed(Player, targetPlayer, model) then return model end
                    return nil
                end
            end
            model = model.Parent
        end
        return nil
    end

    function getTriggerTarget()
        if not (TriggerBot.Values["Target Players"] or TriggerBot.Values["Target NPCs/Dummies"]) then return nil end
        local mouse = FWNoModules.Mobile.GetMouse(Player)
        local ray = mouse.UnitRay
        local model = trigModelOf(mouse.Target)
        if not model and Player.Character then
            if type(WS.Spherecast) == "function" then
                local ok, result = pcall(WS.Spherecast, WS, ray.Origin, TRIGGER_RADIUS, ray.Direction * TRIGGER_MAXDIST, queryParams())
                if ok and result then model = trigModelOf(result.Instance) end
            end
            if not model then model = fanRay(ray) end
        end
        return model
    end
end

