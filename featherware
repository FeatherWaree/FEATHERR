	return math.deg(math.acos(math.clamp(look:Dot(toB), -1, 1))) <= allowed
end

-- ===== BEST PATH EVAL =====
nkDirs = {
	Vector3.new(1,0,0), Vector3.new(-1,0,0),
	Vector3.new(0,1,0), Vector3.new(0,-1,0),
	Vector3.new(0,0,1), Vector3.new(0,0,-1)
}

function nkPerpOffsets(dir)
	if dir.Y ~= 0 then
		return {Vector3.new(0,0,0), Vector3.new(1.2,0,0), Vector3.new(-1.2,0,0), Vector3.new(0,0,1.2), Vector3.new(0,0,-1.2)}
	elseif dir.X ~= 0 then
		return {Vector3.new(0,0,0), Vector3.new(0,1.2,0), Vector3.new(0,-1.2,0), Vector3.new(0,0,1.2), Vector3.new(0,0,-1.2)}
	else
		return {Vector3.new(0,0,0), Vector3.new(1.2,0,0), Vector3.new(-1.2,0,0), Vector3.new(0,1.2,0), Vector3.new(0,-1.2,0)}
	end
end

function nkEvalTarget(target, char, range, isBed)
	myPos = char.HumanoidRootPart.Position
	best = nil
	if isBed then
		for _, dir in ipairs(nkDirs) do
			half = (target.Size.X*math.abs(dir.X) + target.Size.Y*math.abs(dir.Y) + target.Size.Z*math.abs(dir.Z)) / 2
			bedPoint = target.Position + dir * (half - 0.5)
			for _, off in ipairs(nkPerpOffsets(dir)) do
				cells = {}
				hpSum = 0
				for i = 0, 5 do
					pt = target.Position + dir * (half + 1.5 + i*3) + off
					if cellSolid(pt, char) then
						gp = nkGridOf(pt)
						inst = blockAtPoint(pt, char)
						hpSum = hpSum + nkCellHealth(gp, inst)
						table.insert(cells, gp)
					else
						break
					end
				end
				if #cells == 0 then
					dist = (bedPoint - myPos).Magnitude
					if dist <= range then
						cost = dist
						if not best or cost < best.cost then
							best = {open = true, cost = cost, bedPoint = bedPoint, dir = dir, cells = {nkGridOf(bedPoint)}, outer = nil, target = target}
						end
					end
				else
					outerPt = target.Position + dir * (half + 1.5 + (#cells - 1)*3) + off
					dist = (outerPt - myPos).Magnitude
					if dist <= range then
						cost = dist + hpSum * 0.15 + #cells * 2
						if not best or cost < best.cost then
							best = {open = false, cost = cost, bedPoint = bedPoint, dir = dir, cells = cells, outer = outerPt, target = target}
						end
					end
				end
			end
		end
	else
		dirV = myPos - target.Position
		dirV = Vector3.new(dirV.X, 0, dirV.Z)
		if dirV.Magnitude > 0.1 then
			dirV = dirV.Unit
			half = (target.Size.X*math.abs(dirV.X) + target.Size.Z*math.abs(dirV.Z)) / 2
			cells = {}
			hpSum = 0
			for i = 0, 5 do
				pt = target.Position + dirV * (half + 1.5 + i*3)
				if cellSolid(pt, char) then
					gp = nkGridOf(pt)
					inst = blockAtPoint(pt, char)
					hpSum = hpSum + nkCellHealth(gp, inst)
					table.insert(cells, gp)
				else
					break
				end
			end
			if #cells == 0 then
				dist = (target.Position - myPos).Magnitude
				if dist <= range then
					best = {open = true, cost = dist, bedPoint = target.Position, dir = dirV, cells = {nkGridOf(target.Position)}, outer = nil, target = target}
				end
			else
				outerPt = target.Position + dirV * (half + 1.5 + (#cells - 1)*3)
				dist = (outerPt - myPos).Magnitude
				if dist <= range then
					best = {open = false, cost = dist + hpSum*0.15 + #cells*2, bedPoint = target.Position, dir = dirV, cells = cells, outer = outerPt, target = target}
				end
			end
		end
	end
	return best
end

-- ===== PRIORITY TARGET PICKER =====
function nkPickTarget(char, range)
	myPos = char.HumanoidRootPart.Position
	for _, g in ipairs(nkGroupPriority) do
		if isGroupEnabled(g) then
			best, bd = nil, range
			for _, blk in ipairs(targetMap[g]) do
				if blk and blk.Parent and (g ~= "bed" or not isOwnTeam(blk)) then
					d = (myPos - blk.Position).Magnitude
					if d < bd then bd = d; best = blk end
				end
			end
			if best then return best, g end
		end
	end
	return nil, nil
end

