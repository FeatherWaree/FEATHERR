end

-- CRITICAL FIX: Use Killaura's Wall Check logic
function asCanSee(targetModel)
	if canRequire and kaSwordController and kaEntityUtil and targetModel then
		local kaPart = targetModel:FindFirstChild("HumanoidRootPart") or targetModel.PrimaryPart
		if kaPart then
			local kaEntity = kaEntityUtil:getEntity(kaPart)
			if kaEntity then
				local kaVisible = kaSwordController:canSee(kaEntity)
				if kaVisible then return true end
			end
		end
	end

	local kaChar = Player.Character
	local kaHrp = kaChar and kaChar:FindFirstChild("HumanoidRootPart")
	if not kaHrp or not targetModel then return false end

	local tPart = targetModel:FindFirstChild("HumanoidRootPart") or targetModel.PrimaryPart
	if not tPart then return false end

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = {kaChar, targetModel}
	rayParams.IgnoreWater = true

	local hit = G.Services.Workspace:Raycast(kaHrp.Position, tPart.Position - kaHrp.Position, rayParams)
	return hit == nil
end

-- CRITICAL FIX: First Person Check
function asIsFirstPerson()
	char = Player.Character
	if not char then return false end
	head = char:FindFirstChild("Head")
	if not head then return false end
	cam = G.Services.Workspace.CurrentCamera
	if not cam then return false end
	return (cam.CFrame.Position - head.Position).Magnitude < 1.5
end

function asDoShoot(target, swordInst)
	-- SAFETY: If busy flag is stuck for more than 2 seconds, force reset it
	if asBusy and (tick() - asBusyTimestamp > 2) then
		asBusy = false
	end

	if asBusy then return end

	-- 1. PRE-CHECKS (Before swapping inventory)
	if not asIsFirstPerson() then return end -- First Person Only

	tHum = target:FindFirstChildOfClass("Humanoid")
	if not tHum or tHum.Health <= 0 then return end -- Dead check

	myHRP = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
	tHRP = target:FindFirstChild("HumanoidRootPart") or target.PrimaryPart
	if not myHRP or not tHRP then return end

	-- Teammate check
	targetPlayer = Players:GetPlayerFromCharacter(target)
	if targetPlayer and Player.Team and targetPlayer.Team == Player.Team then return end

	-- Wall check (Using KA logic)
	if not asCanSee(target) then return end

	-- Angle check (180° forward cone using Camera)
	cam = G.Services.Workspace.CurrentCamera
	camDir = cam and cam.CFrame.LookVector or myHRP.CFrame.LookVector
	toTarget = (tHRP.Position - myHRP.Position).Unit
	angle = math.acos(math.clamp(camDir:Dot(toTarget), -1, 1))

	if angle > math.rad(90) then return end -- Looking away

	-- 2. ALL CHECKS PASSED - Proceed with swap and shoot
	asBusy = true
	asBusyTimestamp = tick() -- Record start time

	-- Safety wrapper to ensure asBusy is always reset
	pcall(function()
		loadout = asGetProjectileLoadout()
		if not loadout then 
			asBusy = false 
			return 
		end

		asCurrentLoadout = loadout
		asSavedSword = swordInst

		-- Swap to projectile
		if paSetInv then
			pcall(function() paSetInv:InvokeServer({ hand = loadout.weapon }) end)
		end

		task.wait(0.05)

		-- Re-verify target is still valid after the small wait
		if not target.Parent or not tHum or tHum.Health <= 0 then
			if asSavedSword and paSetInv then pcall(function() paSetInv:InvokeServer({ hand = asSavedSword }) end) end
			asBusy = false
			return
		end

		tHead = target:FindFirstChild("Head")

		-- Headshot Logic
		targetPos = tHRP.Position
		if loadout.weapon.Name == "headhunter" and tHead then
			chance = tonumber(AutoShoot.Values["Headshot Chance %"]) or 50
			if math.random(1, 100) <= chance then
				targetPos = tHead.Position + Vector3.new(0, 0.5, 0)
			end
		end

		origin = asGetLaunchPosition() or (myHRP.Position - Vector3.new(0, 2, 0))

		pm = PA_PROJ_META[loadout.projectile] or PA_PROJ_META[loadout.weapon.Name] or {}
		launchVel = pm.launchVelocity or 100
		grav = pm.gravitationalAcceleration or 196.2
		life = pm.lifetimeSec or 3

		vt, t = paAim(origin, targetPos, Vector3.zero, launchVel, grav, life, 0)
		if not vt then
			dir = (targetPos - origin).Unit
			vt = dir * launchVel
			t = (targetPos - origin).Magnitude / launchVel
		end

		asShowAimBeam(origin, vt, grav, math.min(t, life))

		fireId = paGenId and paGenId() or tostring(math.random(100000, 999999))
		shotId = paGenId and paGenId() or tostring(math.random(100000, 999999))

		if paFire then
			pcall(function()
				paFire:InvokeServer(
					loadout.weapon, 
					loadout.ammo, 
					loadout.projectile, 
					vec3(origin.X, origin.Y, origin.Z),
					vec3(origin.X, origin.Y, origin.Z),
					vec3(vt.X, vt.Y, vt.Z),
					fireId, 
					{ shotId = shotId, drawDurationSec = 0 },
					G.Services.Workspace:GetServerTimeNow()
				)
			end)
		end

		if paPlayAnim and loadout.fireAnim then
			paPlayAnim(loadout.fireAnim, false)
		end

		if paPlaySound and loadout.launchSnd then
			paPlaySound(loadout.launchSnd)
		end

		asHideAimBeam()

		-- Swap back to sword
		if asSavedSword and paSetInv then
			pcall(function() paSetInv:InvokeServer({ hand = asSavedSword }) end)
		end

		baseDelay = loadout.fireDelay or 0.3
		randomExtra = math.random(5, 10) / 100
		asNextCooldown = baseDelay + randomExtra
	end)

	asBusy = false
end

AutoShoot.Callbacks.OnToggle = function(state)
	loops["auto shoot"] = state
	if state then
		asSetupAimBeam()
		if not asConn then
			asConn = FWNoModules.TrackFrameConnection(G.Services.RunService.Heartbeat:Connect(function()
				if not loops["auto shoot"] or not AutoShoot.Values["Enabled"] then return end

				-- SAFETY: If busy flag is stuck for more than 2 seconds, force reset it
				if asBusy and (tick() - asBusyTimestamp > 2) then
					asBusy = false
				end

				if asBusy then return end

				now = tick()
				if now - asLastShot < asNextCooldown then return end

				if loops["killaura"] and currentKaTarget and currentKaTarget.Parent then
					char = Player.Character
					if not char then return end

					myHRP = char:FindFirstChild("HumanoidRootPart")
					tHRP = currentKaTarget:FindFirstChild("HumanoidRootPart") or currentKaTarget.PrimaryPart
					tHum = currentKaTarget:FindFirstChildOfClass("Humanoid")

					if myHRP and tHRP and tHum and tHum.Health > 0 then
						dist = (myHRP.Position - tHRP.Position).Magnitude
						reach = tonumber(Killaura.Values["Reach"]) or 12.4

						if dist <= reach + 2 then
							handItem = char:FindFirstChild("HandInvItem")
							if not handItem or not handItem.Value then return end

							heldName = typeof(handItem.Value) == "Instance" and handItem.Value.Name or tostring(handItem.Value)
							isSword = swords and table.find(swords, heldName)

							if isSword then
								asLastShot = now
								task.spawn(asDoShoot, currentKaTarget, handItem.Value)
							end
						end
					end
				end
			end))
		end
	else
		if asConn then asConn:Disconnect(); asConn = nil end
		asHideAimBeam()
		asBusy = false
	end
end

