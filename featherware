cryptGetDistance = function(gravestone)
	myChar = PlayersService.LocalPlayer.Character
	if not myChar then return math.huge end
	myRoot = myChar:FindFirstChild("HumanoidRootPart")
	if not myRoot then return math.huge end

	pos = gravestone:GetPivot().Position
	return (pos - myRoot.Position).Magnitude
end

cryptCollect = function(gravestone)
	if cryptData.processed[gravestone] then return end
	cryptData.processed[gravestone] = true

	task.spawn(function()
		-- Apply user-configured delay
		delayTime = AutoCrypt.Values["Delay"] or 0
		if delayTime > 0 then
			task.wait(delayTime)
		end

		-- Re-check validity after delay
		if not loops["auto crypt"] or not gravestone or not gravestone.Parent then 
			cryptData.processed[gravestone] = nil
			return 
		end

		-- Ensure we are still within interaction range (12 studs max + 2 stud buffer)
		if cryptGetDistance(gravestone) > 14 then
			cryptData.processed[gravestone] = nil
			return
		end

		if not cryptLoadRemote() then
			cryptData.processed[gravestone] = nil
			return
		end

		-- PLAY CORRECT CLAIM ANIMATIONS
		if cryptLoadAnims() then
			pcall(function()
				-- 1. The initial proximity prompt tap
				cryptData.GameAnimationUtil:playAnimation(PlayersService.LocalPlayer, cryptData.AnimationType.PUNCH)
				if cryptData.KnitClient and cryptData.KnitClient.Controllers and cryptData.KnitClient.Controllers.ViewmodelController then
					cryptData.KnitClient.Controllers.ViewmodelController:playAnimation(cryptData.AnimationType.FP_USE_ITEM)
				end

				task.wait(0.1) 

				-- 2. The ACTUAL claiming channel animation (USE_GRAVESTONE)
				-- This is exactly what the game plays in useGravestone() after the server accepts
				if cryptData.AnimationUtil then
					local assetId = cryptData.GameAnimationUtil:getAssetId(cryptData.AnimationType.USE_GRAVESTONE)
					cryptData.AnimationUtil:playAnimation(PlayersService.LocalPlayer, assetId, {looped = false})
				end
			end)
		end

		-- Extract attributes required by the server
		secret = gravestone:GetAttribute("GravestoneSecret")
		position = gravestone:GetAttribute("GravestonePosition") or gravestone:GetPivot().Position
		userId = gravestone:GetAttribute("GravestonePlayerUserId")
		armor = gravestone:GetAttribute("ArmorType")
		sword = gravestone:GetAttribute("SwordType")
		bow = gravestone:GetAttribute("BowType")

		if secret then
			args = {
				secret = secret,
				position = position,
				skeletonData = {
					associatedPlayerUserId = userId,
					armorType = armor,
					weaponType = sword,
					bowType = bow
				}
			}

			pcall(function()
				if cryptData.activateRemote:IsA("RemoteFunction") then
					cryptData.activateRemote:InvokeServer(args)
				else
					cryptData.activateRemote:FireServer(args)
				end
			end)
		end

		-- Cleanup cache after a short delay
		task.wait(1)
		cryptData.processed[gravestone] = nil
	end)
end

cryptScan = function()
	for _, obj in ipairs(CollectionService:GetTagged("Gravestone")) do
		if not cryptData.processed[obj] then
