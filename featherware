	if includeTeam == nil then includeTeam = true end

	if includeTeam then
		beehiveData.Gui.Enabled = true
	else
		placedBy = instance:GetAttribute("PlacedByUserId")
		isTeamHive = false

		if placedBy and placedBy == game:GetService("Players").LocalPlayer.UserId then
			isTeamHive = true
		elseif placedBy then
			targetPlr = game:GetService("Players"):GetPlayerByUserId(placedBy)
			if targetPlr and targetPlr.Team and game:GetService("Players").LocalPlayer.Team and targetPlr.Team == game:GetService("Players").LocalPlayer.Team then
				isTeamHive = true
			end
		end

		if isTeamHive then
			beehiveData.Gui.Enabled = false
		else
			beehiveData.Gui.Enabled = true
		end
	end
end

updateAllBeehiveVisibility = function()
	for inst, _ in pairs(beehiveEspCache) do
		checkBeehiveVisibility(inst)
	end
end

createBeehiveESP = function(instance)
	if beehiveEspCache[instance] then return end
	if not instance:IsA("Instance") then return end

	beehiveTargetPart = instance:IsA("Model") and (instance.PrimaryPart or instance:FindFirstChildWhichIsA("BasePart")) or instance
	if not beehiveTargetPart or not beehiveTargetPart:IsA("BasePart") then return end

	beehiveEspCache[instance] = {
		Gui = nil,
		Label = nil,
		Conns = {}
	}

	beehiveAttachment = Instance.new("Attachment")
	beehiveAttachment.Name = "BeehiveESP_Attachment"
	beehiveAttachment.Position = Vector3.new(0, 3.5, 0)
	beehiveAttachment.Parent = beehiveTargetPart

	beehiveGui = Instance.new("BillboardGui")
	beehiveGui.Name = "BeehiveESP_Gui"
	beehiveGui.Size = UDim2.fromOffset(130, 45)
	beehiveGui.AlwaysOnTop = true
	beehiveGui.Adornee = beehiveAttachment
	beehiveGui.Parent = mainScreenUI

	beehiveLabel = Instance.new("TextLabel")
	beehiveLabel.Size = UDim2.new(1, 0, 1, 0)
	beehiveLabel.BackgroundTransparency = 0.35
	beehiveLabel.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
	beehiveLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
	beehiveLabel.TextStrokeTransparency = 0.4
	beehiveLabel.TextSize = 13
	beehiveLabel.Font = Enum.Font.SourceSansBold
	beehiveLabel.Parent = beehiveGui

	beehiveCorner = Instance.new("UICorner")
	beehiveCorner.CornerRadius = UDim.new(0, 6)
	beehiveCorner.Parent = beehiveLabel

	beehiveEspCache[instance].Gui = beehiveGui
	beehiveEspCache[instance].Label = beehiveLabel

	beehiveAttrConn = instance:GetAttributeChangedSignal("Level"):Connect(function()
		beehiveData = beehiveEspCache[instance]
		if beehiveData and beehiveData.Label then
			beehiveLevel = instance:GetAttribute("Level") or 0
			beehiveData.Label.Text = string.format("Beehive\nBees: %d", beehiveLevel)
		end
	end)

	beehiveOwnerConn = instance:GetAttributeChangedSignal("PlacedByUserId"):Connect(function()
		checkBeehiveVisibility(instance)
	end)

	beehiveLevel = instance:GetAttribute("Level") or 0
	beehiveLabel.Text = string.format("Beehive\nBees: %d", beehiveLevel)

	checkBeehiveVisibility(instance)

	beehiveEspCache[instance].Conns = {beehiveAttrConn, beehiveOwnerConn}
end

BeehiveESP.Callbacks.OnToggle = function(state)
	loops["beehive esp"] = state

	for _, conn in pairs(beehiveConnections) do
		if conn then conn:Disconnect() end
	end
	beehiveConnections = {}

	for _, conn in pairs(beehiveTrackedConns) do
		if conn then conn:Disconnect() end
	end
	beehiveTrackedConns = {}

	if state then
		for _, inst in ipairs(game:GetService("CollectionService"):GetTagged("beehive")) do
			createBeehiveESP(inst)
		end

		beehiveConnections["Added"] = game:GetService("CollectionService"):GetInstanceAddedSignal("beehive"):Connect(createBeehiveESP)
		beehiveConnections["Removed"] = game:GetService("CollectionService"):GetInstanceRemovedSignal("beehive"):Connect(removeBeehiveESP)

		table.insert(beehiveTrackedConns, game:GetService("Players").LocalPlayer:GetPropertyChangedSignal("Team"):Connect(updateAllBeehiveVisibility))
		for _, plr in ipairs(game:GetService("Players"):GetPlayers()) do
			table.insert(beehiveTrackedConns, plr:GetPropertyChangedSignal("Team"):Connect(updateAllBeehiveVisibility))
		end
		table.insert(beehiveTrackedConns, game:GetService("Players").PlayerAdded:Connect(function(plr)
			table.insert(beehiveTrackedConns, plr:GetPropertyChangedSignal("Team"):Connect(updateAllBeehiveVisibility))
		end))
	else
		for inst, _ in pairs(beehiveEspCache) do
			removeBeehiveESP(inst)
		end
		table.clear(beehiveEspCache)
	end
end
