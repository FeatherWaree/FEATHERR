	va_lookDir = va_cam.CFrame.LookVector
	va_bestModel = nil
	va_bestRoot = nil
	va_bestAngle = math.huge

	if VulcanAimbot.Values["Target Players"] then
		for _, va_plr in ipairs(Players:GetPlayers()) do
			if va_plr ~= Player and va_plr.Character then
				va_hum = va_plr.Character:FindFirstChildOfClass("Humanoid")
				va_root = va_plr.Character:FindFirstChild("HumanoidRootPart")
				if va_hum and va_root and va_hum.Health > 0 then
					if not vaIsTeamSafe(va_plr) then continue end
					va_dist = (va_root.Position - origin).Magnitude
					if va_dist <= range then
						if not vaWallClear(origin, va_root.Position, turret, va_plr.Character) then continue end
						va_toT = (va_root.Position - origin).Unit
						va_ang = math.acos(math.clamp(va_lookDir:Dot(va_toT), -1, 1))
						if va_ang < va_bestAngle then
							va_bestAngle = va_ang
							va_bestModel = va_plr.Character
							va_bestRoot = va_root
						end
					end
				end
			end
		end
	end

	if VulcanAimbot.Values["Target NPCs/Dummies"] then
		va_now2 = os.clock()
		if va_now2 - va_lastNpcScan >= 2 then
			va_lastNpcScan = va_now2
			pcall(vaScanNpcs)
		end
		for _, va_npc in ipairs(va_npcCache) do
			if va_npc.Parent then
				va_hum = va_npc:FindFirstChildOfClass("Humanoid")
				va_root = va_npc:FindFirstChild("HumanoidRootPart")
				if va_hum and va_root and va_hum.Health > 0 then
					va_dist = (va_root.Position - origin).Magnitude
					if va_dist <= range then
						if not vaWallClear(origin, va_root.Position, turret, va_npc) then continue end
						va_toT = (va_root.Position - origin).Unit
						va_ang = math.acos(math.clamp(va_lookDir:Dot(va_toT), -1, 1))
						if va_ang < va_bestAngle then
							va_bestAngle = va_ang
							va_bestModel = va_npc
							va_bestRoot = va_root
						end
					end
				end
			end
		end
	end

	return va_bestModel, va_bestRoot, va_bestAngle
end

function vaResolveTarget(turret, origin, range)
	va_bestModel, va_bestRoot, va_bestAngle = vaFindBestTarget(turret, origin, range)

	if VulcanAimbot.Values["Sticky Target"] and va_currentTargetModel and va_currentTargetModel.Parent then
		va_curRoot = va_currentTargetModel:FindFirstChild("HumanoidRootPart")
		va_curHum = va_currentTargetModel:FindFirstChildOfClass("Humanoid")
		if va_curRoot and va_curHum and va_curHum.Health > 0 then
			va_curDist = (va_curRoot.Position - origin).Magnitude
			va_curValid = va_curDist <= range
			if va_curValid and VulcanAimbot.Values["Ignore Behind Walls"] then
				va_curValid = vaWallClear(origin, va_curRoot.Position, turret, va_currentTargetModel)
			end
			if va_curValid then
				va_cam2 = G.Services.Workspace.CurrentCamera
				if va_cam2 then
					va_lookDir2 = va_cam2.CFrame.LookVector
					va_curAngle = math.acos(math.clamp(va_lookDir2:Dot((va_curRoot.Position - origin).Unit), -1, 1))
					va_threshold = math.rad(VulcanAimbot.Values["Switch Threshold"] or 5)
					if va_bestModel and va_bestModel ~= va_currentTargetModel and va_bestAngle < va_curAngle - va_threshold then
						va_currentTargetModel = va_bestModel
						vaResetTracking()
					end
				end
				return va_currentTargetModel
			end
		end
		va_currentTargetModel = va_bestModel
		vaResetTracking()
		return va_bestModel
	end

	if va_currentTargetModel ~= va_bestModel then vaResetTracking() end
	va_currentTargetModel = va_bestModel
	return va_bestModel
end

