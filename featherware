function updateFakeRank(rankName)
	fs_char2 = Player.Character
	if not fs_char2 or not fs_char2:FindFirstChild("Head") then return end

	fs_nametag = fs_char2.Head:FindFirstChild("Nametag", true)
	if not fs_nametag then return end

	fs_container = fs_nametag:FindFirstChild("DisplayNameContainer", true) or fs_nametag

	if not fw_RankImageLabel or fw_RankImageLabel.Parent ~= fs_container then
		if fw_RankImageLabel then fw_RankImageLabel:Destroy() end
		fw_RankImageLabel = FWNoModules.OwnInstance(Instance.new("ImageLabel"))
		fw_RankImageLabel.Name = "FakeRankDisplay"
		fw_RankImageLabel.BackgroundTransparency = 1
		fw_RankImageLabel.LayoutOrder = 0
		fw_RankImageLabel.Size = UDim2.fromScale(1, 1)
		fw_RankImageLabel.SizeConstraint = Enum.SizeConstraint.RelativeYY
		fw_RankImageLabel.ScaleType = Enum.ScaleType.Fit
		fw_RankImageLabel.Parent = fs_nametag
		fw_RankImageLabel.Position = UDim2.new(1, 0, 0.3, 0)
		fw_RankImageLabel.LayoutOrder = 5
		fw_RankImageLabel.AnchorPoint = Vector2.new(1, 0.5)
	end

	if rankName == "None" or not fw_RankMeta then
		fw_RankImageLabel.Visible = false
		return
	end

	fs_divId = nil
	if rankName == "Bronze" then fs_divId = 0
	elseif rankName == "Silver" then fs_divId = 4
	elseif rankName == "Gold" then fs_divId = 8
	elseif rankName == "Platinum" then fs_divId = 12
	elseif rankName == "Diamond" then fs_divId = 16
	elseif rankName == "Emerald" then fs_divId = 20
	elseif rankName == "Nightmare" then fs_divId = 24 end

	if fs_divId and fw_RankMeta[fs_divId] and fw_RankMeta[fs_divId].image then
		fw_RankImageLabel.Image = fw_RankMeta[fs_divId].image
		fw_RankImageLabel.Visible = true
	else
		fw_RankImageLabel.Visible = false
	end
end


