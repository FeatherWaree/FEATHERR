startAntiLasso = function()
	if antiLassoConnections["tag"] then return end 

	AntiLassoHandler = function(char)
		if not char then return end

		HRP = char:WaitForChild("HumanoidRootPart", 5)

		if HRP then
			antiLassoConnections["physics"] = HRP.ChildAdded:Connect(function(child)
				if loops["anti lasso"] == true then
					if child:IsA("BodyMover") or child:IsA("LinearVelocity") or child:IsA("AlignPosition") or child:IsA("VectorForce") or child:IsA("BodyVelocity") then
						-- Only destroy the physics if our chance roll succeeded and we are actively defending
						if isBeingLassoed then
							print("[Anti-Lassy] Detected pull physics added to character, destroying it!")
							child:Destroy()
						end
					end
				end
			end)
		end
	end

	if Me.Character then
		AntiLassoHandler(Me.Character)
	end

	antiLassoConnections["char"] = Me.CharacterAdded:Connect(AntiLassoHandler)

	antiLassoConnections["tag"] = CollectionService:GetInstanceAddedSignal("LassoHooked"):Connect(function(hitEntity)
		if loops["anti lasso"] == true and hitEntity == Me.Character then

			-- CHANCE CALCULATION
			chance = loops["anti lasso chance"]
			roll = math.random(1, 100)

			if roll <= chance then
				print("[Anti-Lassy] Lasso hooked! Roll: " .. roll .. "/" .. chance .. ". Activating defense...")

				CollectionService:RemoveTag(hitEntity, "LassoHooked")

				torso = hitEntity:FindFirstChild("UpperTorso")
				if torso then
					for _, item in pairs(torso:GetChildren()) do
						itemName = string.lower(item.Name)
						if item:IsA("Weld") or string.find(itemName, "lasso") or string.find(itemName, "rope") then
							item:Destroy()
						end
					end
				end

				hrp = hitEntity:FindFirstChild("HumanoidRootPart")
				if hrp and not isBeingLassoed then
					isBeingLassoed = true
					safeCFrame = hrp.CFrame
					print("[Anti-Lassy] Locking CFrame for 1.5s to block the server pull...")

					connectionName = "AntiLassoLock"
					startTime = os.clock()

					G.Services.RunService:BindToRenderStep(connectionName, 2000, function()
						-- INCREASED DURATION: Now holds you for 1.5 seconds instead of 0.5
						if hrp and os.clock() - startTime < 2.05 then
							hrp.CFrame = safeCFrame
							hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
						else
							G.Services.RunService:UnbindFromRenderStep(connectionName)
							isBeingLassoed = false
							print("[Anti-Lassy] Defense sequence complete. You are free to move.")
						end
					end)
				end
			else
				print("[Anti-Lassy] Lasso hooked you, but chance roll failed (" .. roll .. " > " .. chance .. "). Letting it pull.")
			end
		end
	end)
end

stopAntiLasso = function()
	for key, connection in pairs(antiLassoConnections) do
		if connection then
			connection:Disconnect()
		end
	end
	antiLassoConnections = {}

	pcall(function() RunService:UnbindFromRenderStep("AntiLassoLock") end)
	isBeingLassoed = false
end

