-- One incremental discovery pass, reversible changes, and live culling membership.
function FWNoModules.CreateFPSOptimizer(deps)
    local api={Enabled=false}
    local options={}
    local records=setmetatable({},{__mode="k"})
    local culling=setmetatable({},{__mode="k"})
    local added,removed,scanThread,cullThread
    local revision=0
    local function disconnect(connection)
        if connection then deps.Disconnect(connection)end
    end
    local function cancel(thread)
        if thread and thread~=coroutine.running()then pcall(deps.Cancel,thread)end
    end
    local function write(object,property,value)
        return pcall(function()if object[property]~=value then object[property]=value end end)
    end
    local function restore(object)
        local saved=records[object]
        if saved then
            for property,value in pairs(saved)do write(object,property,value)end
            records[object]=nil
        end
        local original=culling[object]
        if original~=nil then write(object,"LocalTransparencyModifier",original);culling[object]=nil end
    end
    local function applyProperties(object,desired)
        local saved=records[object]
        if saved then
            for property,value in pairs(saved)do
                if desired[property]==nil then write(object,property,value);saved[property]=nil end
            end
        end
        for property,value in pairs(desired)do
            local ok,original=pcall(function()return object[property]end)
            if ok and original~=value then
                if not saved then saved={};records[object]=saved end
                if saved[property]==nil then saved[property]=original end
                write(object,property,value)
            end
        end
        if saved and next(saved)==nil then records[object]=nil end
    end
    local function observe(object)
        if not api.Enabled then return end
        if object:IsA("BasePart")then
            local desired={}
            if options["Smooth Materials"]then desired.Material=deps.SmoothMaterial end
            if options["Disable Part Shadows"]then desired.CastShadow=false end
            applyProperties(object,desired)
            if options["Render Culling"]and object.Transparency<1 and culling[object]==nil then
                culling[object]=object.LocalTransparencyModifier
            end
        elseif object:IsA("Texture")or object:IsA("Decal")then
            applyProperties(object,options["Remove Textures & Decals"]and{Transparency=1}or{})
        elseif object:IsA("ParticleEmitter")or object:IsA("Trail")or object:IsA("Beam")then
            applyProperties(object,options["Disable Particles & Beams"]and{Enabled=false}or{})
        end
    end
    local function globals()
        applyProperties(deps.Lighting,options["Disable Global Shadows"]and{GlobalShadows=false}or{})
        local desired={}
        if options["Disable Terrain Grass"]then desired.Decoration=false end
        if options["Simplify Water"]then desired.WaterWaveSize=0;desired.WaterWaveSpeed=0;desired.WaterTransparency=1 end
        applyProperties(deps.Terrain,desired)
    end
    local function scan()
        revision+=1
        local token=revision
        cancel(scanThread);scanThread=nil
        scanThread=deps.Spawn(function()
            local stack={deps.World}
            local processed=0
            local deadline=deps.Clock()+.002
            while #stack>0 and api.Enabled and revision==token do
                local object=table.remove(stack)
                if object==deps.World or object:IsDescendantOf(deps.World)then
                    observe(object)
                    local ok,children=pcall(function()return object:GetChildren()end)
                    if ok then for _,child in ipairs(children)do stack[#stack+1]=child end end
                end
                processed+=1
                if processed%150==0 or deps.Clock()>=deadline then deps.Wait();deadline=deps.Clock()+.002 end
            end
            if revision==token then scanThread=nil end
        end)
    end
    local function synchronizeCulling()
        if not options["Render Culling"]then
            cancel(cullThread);cullThread=nil
            for part,original in pairs(culling)do write(part,"LocalTransparencyModifier",original)end
            table.clear(culling)
        elseif not cullThread then
            cullThread=deps.Spawn(function()
                while api.Enabled and options["Render Culling"]do
                    local position=deps.Position()
                    if position then
                        local distance=tonumber(options["Cull Distance Slider"])or 150
                        local squared=distance*distance
                        local processed=0
                        local deadline=deps.Clock()+.002
                        for part,original in pairs(culling)do
                            if not part:IsDescendantOf(deps.World)then
                                write(part,"LocalTransparencyModifier",original);culling[part]=nil
                            else
                                local delta=part.Position-position
                                local hidden=part.Anchored and delta:Dot(delta)>squared
                                write(part,"LocalTransparencyModifier",hidden and 1 or original)
                            end
                            processed+=1
                            if processed%200==0 or deps.Clock()>=deadline then
                                deps.Wait();deadline=deps.Clock()+.002
                                if not api.Enabled or not options["Render Culling"]then break end
                            end
                        end
                    end
                    deps.Wait(.5)
                end
                cullThread=nil
            end)
        end
    end
    function api.Update(values)
        options=table.clone(values)
        if not api.Enabled then return end
        globals();synchronizeCulling();scan()
    end
    function api.Stop()
        api.Enabled=false;revision+=1
        cancel(scanThread);scanThread=nil;cancel(cullThread);cullThread=nil
        disconnect(added);added=nil;disconnect(removed);removed=nil
        for object in pairs(records)do restore(object)end
        for part in pairs(culling)do restore(part)end
    end
    function api.Start(values)
        if api.Enabled then api.Update(values);return end
        options=table.clone(values);api.Enabled=true
        added=deps.Connect(deps.World.DescendantAdded,observe)
        removed=deps.Connect(deps.World.DescendantRemoving,restore)
        globals();scan();synchronizeCulling()
    end
    return api
end

