	if now - nazarData.lastFire < 3 then return end

	nazarData.lastFire = now
	pcall(function()
		if useAbility then
			useAbility:FireServer("consume_life_foce")
		else
			args = {
				"consume_life_foce"
			}
			G.Services.RS:WaitForChild("events-@easy-games/game-core:shared/game-core-networking@getEvents.Events"):WaitForChild("useAbility"):FireServer(unpack(args))
		end
	end)
end

nazarSetupHook = function()
	if nazarData.hookActive then return end
	if not canRequire then return end
	if not hookmetamethod or not getnamecallmethod or not checkcaller then return end

	nazarData.hookActive = true
	pcall(function()
		nazarData.oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
			args = {...}
			result = nazarData.oldNamecall(self, unpack(args))

			if not checkcaller() then
				pcall(function()
					method = getnamecallmethod()
					if method == "FireServer" or method == "InvokeServer" then
						remoteName = tostring(self)
						if remoteName == "SwordHit" or remoteName == "ProjectileHit" then
							if loops["auto nazar"] and (AutoNazar.Values["Mode"] == "On Hit") then
								char = Players.LocalPlayer.Character
								hum = char and char:FindFirstChildOfClass("Humanoid")
								if hum then
									hpPct = (hum.Health / hum.MaxHealth) * 100
									targetPct = AutoNazar.Values["Health Percent"] or 50
									if hpPct <= targetPct then
										nazarFireAbility()
									end
								end
							end
						end
					end
				end)
			end
			return result
		end)
	end)
end

