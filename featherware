infernalCheckTrajectory = function(proj)
	myChar = PlayersService.LocalPlayer.Character
	myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	if not myRoot then return false end

	pos1 = proj:GetPivot().Position
	task.wait(0.05)
	if not proj or not proj.Parent then return false end
	pos2 = proj:GetPivot().Position

	delta = pos2 - pos1
	if delta.Magnitude < 0.2 then return false end

	dir = delta.Unit
	speed = delta.Magnitude / 0.05 -- actual current speed

	toPlayer = myRoot.Position - pos2

	-- Must be heading generally toward us
	if toPlayer:Dot(dir) <= 0 then return false end

	-- Proximity fallback: very close and heading at us = threat
	if toPlayer.Magnitude <= 12 then return true end

	-- Simulate the arc with real speed + meta gravity
	dt = 0.05
	pos = pos2
	vel = dir * speed
	time = 0

	while time < 2.5 do
		vel = vel + Vector3.new(0, -GRAVITY, 0) * dt
		pos = pos + vel * dt
		time = time + dt

		if (pos - myRoot.Position).Magnitude <= HIT_RADIUS then
			return true
		end
		if (pos - pos2).Magnitude > 300 then break end
	end
	return false
end

infernalBlockProjectile = function(proj)
	now = os.clock()

	-- If already blocking, just extend the duration
	if now < infernalData.blockUntil then
		infernalData.blockUntil = math.max(infernalData.blockUntil, now + 1.0)
		return
	end

	if not infernalLoadRemotes() then return end

	shieldInst = infernalGetShieldInstance()
	if not shieldInst then return end

	currentItem = infernalGetCurrentItem()
	holdingShield = currentItem and currentItem.Name == "infernal_shield"

	-- Equip the shield if we aren't already holding it (even if hand is empty)
	if not holdingShield then
		infernalData.originalItem = currentItem
		infernalEquipShield(shieldInst)
	end

	infernalData.blockUntil = now + 1.5

	if not infernalData.blockingActive then
		infernalData.blockingActive = true

		task.spawn(function()
			while os.clock() < infernalData.blockUntil do
				pcall(function()
					infernalData.shieldRemote:FireServer({raised = true})
				end)
				task.wait(0.1)
			end

			pcall(function()
				infernalData.shieldRemote:FireServer({raised = false})
			end)

			-- Swap back to the item we were holding (if we swapped and it still exists)
			if infernalData.originalItem and infernalData.originalItem.Parent then
				task.wait(0.05)
				pcall(function()
					infernalData.setInvRemote:InvokeServer({hand = infernalData.originalItem})
				end)
			end

			infernalData.originalItem = nil
			infernalData.blockingActive = false
		end)
	end
end

