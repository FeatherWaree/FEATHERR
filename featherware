function scaffoldRoundPos(pos)
	return Vector3.new(math.round(pos.X / 3) * 3, math.round(pos.Y / 3) * 3, math.round(pos.Z / 3) * 3)
end

function scaffoldGetPlacedBlock(pos)
	gridPos = Vector3.new(math.round(pos.X / 3), math.round(pos.Y / 3), math.round(pos.Z / 3))
	worldPos = gridPos * 3
	params = OverlapParams.new()
	params.FilterDescendantsInstances = {Player.Character}
	params.FilterType = Enum.RaycastFilterType.Exclude
	parts = G.Services.Workspace:GetPartBoundsInBox(CFrame.new(worldPos), Vector3.new(2.8, 2.8, 2.8), params)
	for _, p in ipairs(parts) do
		if p.CanCollide and not p:IsDescendantOf(Player.Character) then
			return p, gridPos
		end
	end
	return nil, gridPos
end

-- CRITICAL FIX #1: FAST RAYCAST PROXIMITY (Fixes 5 FPS near void)
function scaffoldBlockProximity(pos)
	-- Raycast straight down to find the nearest block surface below the player
	rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances = {Player.Character}

	-- Cast down 50 studs from the player's feet
	hit = G.Services.Workspace:Raycast(Vector3.new(pos.X, pos.Y + 5, pos.Z), Vector3.new(0, -50, 0), rp)

	if hit then
		-- Snap the hit position to the nearest grid block above the surface
		blockPos = Vector3.new(math.round(hit.Position.X / 3) * 3, math.round((hit.Position.Y + 1.5) / 3) * 3, math.round(hit.Position.Z / 3) * 3)
		return blockPos
	end

	return nil -- Over the void, return nil instantly (0 FPS cost)
end

function scaffoldCheckAdjacent(pos)
	for _, v in ipairs(scaffoldAdjacent) do
		block, _ = scaffoldGetPlacedBlock(pos + v)
		if block then return true end
	end
	return false
end

