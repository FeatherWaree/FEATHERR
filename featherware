-- Ballistic solver: curved launch velocity that lands on target + flight time + reachable flag
umaSolveVelocity = function(origin, targetPos, speed, g)
	delta = targetPos - origin
	horiz = Vector3.new(delta.X, 0, delta.Z)
	dist = horiz.Magnitude
	dy = delta.Y

	if dist < 0.5 then
		return delta.Unit * speed, (delta.Magnitude / speed), true
	end

	v2 = speed * speed
	v4 = v2 * v2
	disc = v4 - g * (g * dist * dist + 2 * dy * v2)

	if disc < 0 then
		return nil, 0, false -- physically unreachable, don't waste the spirit
	end

	tanTheta = (v2 - math.sqrt(disc)) / (g * dist)
	cosTheta = 1 / math.sqrt(1 + tanTheta * tanTheta)
	vH = speed * cosTheta
	vY = vH * tanTheta

	return horiz.Unit * vH + Vector3.new(0, vY, 0), (dist / vH), true
end

