-- This emote stays enabled until stopped, moved, jumped, or the character dies.
do
    local button
    local active
    local function stop()
        local state=active
        if not state then return end
        active=nil
        for _,connection in ipairs(state.connections)do FWNoModules.ReleaseConnection(connection)end
        for _,animation in ipairs(state.tweens)do pcall(function()animation:Cancel()end)end
        if state.track then
            pcall(function()state.track:Stop(.1);state.track:Destroy()end)
            FWNoModules.ReleaseInstance(state.track)
        end
        if state.vfx then state.vfx:Destroy();FWNoModules.ReleaseInstance(state.vfx)end
        if state.animation then state.animation:Destroy();FWNoModules.ReleaseInstance(state.animation)end
    end
    local function disable(state)
        if active~=state then return end
        stop()
        if button and button.Toggled then button:SetState(false)end
    end
    local function play()
        stop()
        local character=Player.Character
        local humanoid=character and character:FindFirstChildOfClass("Humanoid")
        local torso=character and(character:FindFirstChild("LowerTorso")or character:FindFirstChild("Torso"))
        local animator=humanoid and humanoid:FindFirstChildOfClass("Animator")
        if not humanoid or humanoid.Health<=0 or not torso or not animator then
            NotificationSystem.Notify("Nightmare Emote","A living character with an animator is required.",2)
            if button and button.Toggled then button:SetState(false)end
            return
        end
        local state={connections={},tweens={}}
        active=state
        local function connect(signal,callback)
            state.connections[#state.connections+1]=FWNoModules.Connect(signal,callback)
        end
        connect(humanoid:GetPropertyChangedSignal("MoveDirection"),function()
            if humanoid.MoveDirection.Magnitude>.05 then disable(state)end
        end)
        connect(humanoid:GetPropertyChangedSignal("Jump"),function()if humanoid.Jump then disable(state)end end)
        connect(humanoid.Died,function()disable(state)end)
        connect(Player.CharacterRemoving,function(removed)if removed==character then disable(state)end end)
        state.animation=FWNoModules.OwnInstance(Instance.new("Animation"))
        state.animation.AnimationId="rbxassetid://9191822700"
        local ok,track=pcall(animator.LoadAnimation,animator,state.animation)
        if not ok then
            disable(state);NotificationSystem.Notify("Nightmare Emote","Animation could not be loaded.",2)
            return
        end
        state.track=FWNoModules.OwnInstance(track)
        connect(track.Stopped,function()disable(state)end)
        track.Priority=Enum.AnimationPriority.Action
        track.Looped=true
        track:Play()
        local found,template=pcall(function()
            local assets=G.Services.RS:FindFirstChild("Assets")or G.Services.RS:WaitForChild("Assets",2)
            local effects=assets and(assets:FindFirstChild("Effects")or assets:WaitForChild("Effects",2))
            return effects and(effects:FindFirstChild("NightmareEmote")or effects:WaitForChild("NightmareEmote",2))
        end)
        if active~=state or Player.Character~=character then return end
        if found and template then
            state.vfx=FWNoModules.OwnInstance(template:Clone())
            connect(state.vfx.Destroying,function()
                if active==state then state.vfx=nil;disable(state)end
            end)
            state.vfx:PivotTo(torso.CFrame+Vector3.new(0,-2,0))
            for _,part in ipairs(state.vfx:GetDescendants())do
                if part:IsA("BasePart")then
                    part.CanCollide=false;part.Anchored=true;part.CanQuery=false;part.CanTouch=false
                end
            end
            state.vfx.Parent=G.Services.Workspace
            for _,spec in ipairs({{"Outer",1.5,360},{"Middle",12.5,-360}})do
                local part=state.vfx:FindFirstChild(spec[1])
                if part and part:IsA("BasePart")then
                    local animation=FWNoModules.OwnTween(TweenService:Create(part,TweenInfo.new(spec[2],Enum.EasingStyle.Linear,Enum.EasingDirection.Out,-1),{Orientation=part.Orientation+Vector3.new(0,spec[3],0)}))
                    state.tweens[#state.tweens+1]=animation;animation:Play()
                end
            end
        end
    end
    button=GameTab:CreateButton("Nightmare Emote",function(enabled)
        if enabled then play()else stop()end
    end,false)
    FWNoModules.OnCleanup(stop)
end


