	if not marinaData.loopConn then
		marinaData.loopConn =FWNoModules.TrackFrameConnection(G.Services.RunService.Heartbeat:Connect(function()
			now = os.clock()
			if now - (marinaData.lastLoop or 0) < 0.2 then return end -- 5 checks per sec
			marinaData.lastLoop = now
			marinaCheckAndFire()
		end))
	end
end

