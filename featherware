            local entry={group=group,callback=replacement,owner=thread and runtime.owners[thread],enabled=true,previous=group.head}
            entry.forwarder=function(...)return entry.previous(...)end
            entry.dispatch=function(...)return entry.callback(...)end
            runtime.hookForwarders[entry.forwarder]=entry
            group.entries[#group.entries+1]=entry
            rebuildHooks(group)
            return entry.forwarder
        end
    end
    function runtime.RestoreSession()
        for name, service in pairs(runtime.bindings) do pcall(function() service:UnbindFromRenderStep(name) end) end
        table.clear(runtime.bindings)
        for i = #runtime.hooks, 1, -1 do
            local entry = runtime.hooks[i]
            pcall(entry.restore, entry.object, entry.key, entry.base)
        end
        table.clear(runtime.hooks)
        table.clear(runtime.hookGroups);table.clear(runtime.hookForwarders)
