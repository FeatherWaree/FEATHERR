		d = Instance.new("Part"); d.Name = "DesyncAnchor"; d.Size = Vector3.new(2,2,1)
		d.Transparency = 1; d.Anchored = true; d.CanCollide = false
		d.CanQuery = false; d.CanTouch = false; d.Massless = true; d.Parent = char
		desync.dummy = d
	end
	d.CFrame = cf; return d
end
function clearDummy(char)
	if desync.dummy then desync.dummy:Destroy() desync.dummy = nil end
	hrp = desync.hrp
	if char and hrp and hrp.Parent == char then char.PrimaryPart = hrp end
end
function mover(prevCF, dt, hum)
	cam = G.Services.Workspace.CurrentCamera
	lookH  = Vector3.new(cam.CFrame.LookVector.X,0,cam.CFrame.LookVector.Z)
	rightH = Vector3.new(cam.CFrame.RightVector.X,0,cam.CFrame.RightVector.Z)
	gOff = (hum and hum.HipHeight and hum.HipHeight > 0) and hum.HipHeight or 2
	dir = Vector3.zero
	if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + lookH  end
	if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - lookH  end
	if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - rightH end
	if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + rightH end
	speed = (hum and hum.WalkSpeed and hum.WalkSpeed > 0) and hum.WalkSpeed or 16
	hMove = (dir.Magnitude > 0) and (dir.Unit * speed * dt) or Vector3.zero
	if hMove.Magnitude > 0 then
		rp = RaycastParams.new(); rp.FilterType = Enum.RaycastFilterType.Exclude; rp.FilterDescendantsInstances = charFilter()
		hit = G.Services.Workspace:Raycast(prevCF.Position, hMove.Unit * (hMove.Magnitude + 0.25), rp)
		if hit and hit.Distance <= hMove.Magnitude + 0.05 then hMove = Vector3.zero end
	end
	vy = desync.vy
	if UserInputService:IsKeyDown(Enum.KeyCode.Space) and desync.grounded then vy = 50 end
	vy = vy - G.Services.Workspace.Gravity * dt
	base = prevCF.Position + hMove
	rp2 = RaycastParams.new(); rp2.FilterType = Enum.RaycastFilterType.Exclude; rp2.FilterDescendantsInstances = charFilter()
	g = G.Services.Workspace:Raycast(base + Vector3.new(0,12,0), Vector3.new(0,-30,0), rp2)
	if g then
		groundY = g.Position.Y + gOff; gravY = base.Y + vy*dt
		if gravY <= groundY + 0.15 then newPos = Vector3.new(base.X,groundY,base.Z); vy = 0; grounded = true
		else newPos = Vector3.new(base.X,gravY,base.Z); grounded = false end
	else newPos = Vector3.new(base.X, base.Y + vy*dt, base.Z); grounded = false end
	desync.vy = vy; desync.grounded = grounded
	lh = lookH.Magnitude > 0.001 and lookH.Unit or Vector3.new(0,0,-1)
	return CFrame.lookAt(newPos, newPos + lh)
end
function stepReal(dt)
	hrp = desync.hrp; if not hrp then return end
	char = Player.Character; hum = char and char:FindFirstChildOfClass("Humanoid")
	delayE = Desync.Values["Delay"] or 0
	instant = mover(desync.instant or hrp.CFrame, dt, hum); desync.instant = instant
	want = Desync.Values["Show RootPart"] and delayE > 0
	if want and not desync.marker then desync.marker = makeMarker(desync.frozen or instant) end
	if (not want) and desync.marker then desync.marker:Destroy(); desync.marker = nil end
	if delayE <= 0 then
		if desync.phase ~= "off" and char then
			hrp.Anchored = false; hrp.CanCollide = true
			if hrp.Parent ~= char then hrp.Parent = char end
			clearDummy(char)
			if CAMERA_FOLLOW and hum then G.Services.Workspace.CurrentCamera.CameraSubject = hum end
			desync.phase = "off"; desync.accum = 0; desync.vy = 0; desync.grounded = true
		end
		desync.instant = hrp.CFrame
		if desync.marker then desync.marker.CFrame = hrp.CFrame end
		return
	end
	if desync.phase == "off" then
		desync.frozen = hrp.CFrame; hrp.CanCollide = false; hrp.Anchored = true
		hrp.Parent = G.Services.Workspace.CurrentCamera
		if char then d = ensureDummy(char, desync.frozen); if d then char.PrimaryPart = d end end
		if CAMERA_FOLLOW then G.Services.Workspace.CurrentCamera.CameraSubject = hrp end
		desync.phase = "frozen"; desync.accum = 0; desync.vy = 0; desync.grounded = true
	end
	if desync.phase == "resyncing" then
		if desync.dummy then desync.dummy:Destroy() desync.dummy = nil end
		if char and hrp.Parent ~= char then hrp.Anchored = false; hrp.Parent = char; char.PrimaryPart = hrp end
		hrp.CFrame = instant; pcall(function() hrp.AssemblyLinearVelocity = Vector3.zero end)
		desync.frames = desync.frames - 1
		if desync.frames <= 0 then
			hrp.Anchored = true; hrp.CanCollide = false; hrp.Parent = G.Services.Workspace.CurrentCamera
			if char then d = ensureDummy(char, desync.frozen); if d then char.PrimaryPart = d end end
			if CAMERA_FOLLOW then G.Services.Workspace.CurrentCamera.CameraSubject = hrp end
			desync.phase = "frozen"; desync.accum = 0
		end
	else
		hrp.CFrame = instant; desync.accum = desync.accum + dt
		if desync.accum >= delayE and char then
			desync.frozen = instant; hrp.Anchored = false; hrp.Parent = char; char.PrimaryPart = hrp
			hrp.CFrame = instant; desync.phase = "resyncing"; desync.frames = 3
		end
	end
	if desync.marker then desync.marker.CFrame = desync.frozen end
end

function enterReal()
	hrp = getHRP(); if not hrp then return end
	desync.hrp = hrp; desync.instant = hrp.CFrame; desync.frozen = hrp.CFrame
	desync.phase = "off"; desync.accum = 0; desync.vy = 0; desync.grounded = true
	desync.queue = {}
end
function exitReal()
	hrp = desync.hrp; char = Player.Character
	hum = char and char:FindFirstChildOfClass("Humanoid")
	if hrp and hrp.Parent == G.Services.Workspace.CurrentCamera and char then
		hrp.Anchored = false; hrp.CanCollide = true; hrp.Parent = char
	end
	clearDummy(char)
	if hum then G.Services.Workspace.CurrentCamera.CameraSubject = hum end
	if desync.marker then desync.marker:Destroy(); desync.marker = nil end
	desync.hrp, desync.instant, desync.frozen = nil, nil, nil; desync.phase = "off"; desync.queue = {}
end
function desyncFrame(dt)
	if not desync.on then return end
	realNow = Desync.Values["Real Desync"] == true
	if realNow ~= desync.lastReal then
		if realNow then enterReal() else exitReal() end
		desync.lastReal = realNow
	end
	if realNow then stepReal(dt) else stepGhost() end
end
function startDesync()
	if desync.on then return end
	desync.on = true; desync.queue = {}; desync.lastReal = false
	desync.conn = G.Services.RunService.RenderStepped:Connect(desyncFrame)
end
function stopDesync()
	if not desync.on then return end
	desync.on = false
	if desync.conn then desync.conn:Disconnect(); desync.conn = nil end
	exitReal()
	if desync.marker then desync.marker:Destroy(); desync.marker = nil end
	desync.queue = {}
end

