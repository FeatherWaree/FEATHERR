whisperLogic = function()
	if not loops["auto whisper"] then return end

	local myChar = Player.Character
	if not myChar or not myChar:FindFirstChild("Humanoid") then return end
	local myHum = myChar:FindFirstChildOfClass("Humanoid")
	if myHum.Health <= 0 then return end

	local owl = whisperGetOwl()

	-- 1. Auto Summon
	if AutoWhisper.Values["Auto Whisper Player"] and not owl then
		local handItem = myChar:FindFirstChild("HandInvItem")
		if handItem and handItem.Value and handItem.Value.Name == "owl_orb" then
			local whisperTarget = AutoWhisper.Values["Player"]
			if whisperTarget and whisperTarget ~= "" and whisperTarget ~= "None" then
				local targetPlayer = Players:FindFirstChild(whisperTarget)
				if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChildOfClass("Humanoid") and targetPlayer.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
					pcall(function()
						useAbility:FireServer("SUMMON_OWL")
						summonOwl:InvokeServer(targetPlayer)
					end)
				end
			end
		end
	end

	if not owl then return end

	local targetPlayerId = owl:GetAttribute("Target")
	local targetPlayer = targetPlayerId and Players:GetPlayerByUserId(targetPlayerId)
	local targetChar = targetPlayer and targetPlayer.Character

	-- 2. Auto Heal & Auto Fly (Target must be the summoned player)
	if targetChar and targetChar:FindFirstChildOfClass("Humanoid") and targetChar:FindFirstChildOfClass("Humanoid").Health > 0 then
		local tHum = targetChar:FindFirstChildOfClass("Humanoid")

		if AutoWhisper.Values["Auto Heal"] then
			local now = os.clock()
			if now - (whisperData.lastHeal or 0) >= 1.5 then 
				local hpPercent = AutoWhisper.Values["Heal when below %"] or 80
				local hpThreshold = tHum.MaxHealth * (hpPercent / 100)
				if tHum.Health <= hpThreshold then
					pcall(function()
						whisperEvents:FireServer({target = targetPlayer, ability = "OWL_HEAL"})
					end)
					whisperData.lastHeal = now
				end
			end
		end

		if AutoWhisper.Values["Auto Fly"] then
			local now = os.clock()
			if now - (whisperData.lastFly or 0) >= 1.0 then 
				local tHRP = targetChar:FindFirstChild("HumanoidRootPart")
				if tHRP then
					local belowStuds = AutoWhisper.Values["Fly when below"] or -50
					if tHRP.Position.Y <= belowStuds then
						pcall(function()
							whisperEvents:FireServer({target = targetPlayer, ability = "OWL_LIFT"})
						end)
						whisperData.lastFly = now
					end
				end
			end
		end
	end

	-- 3. Auto Shoot (Aura)
	if AutoWhisper.Values["Auto Shoot"] then
		now = os.clock()
		shootDelay = AutoWhisper.Values["Shoot Delay"] or 0.5
		if now - (whisperData.lastShot or 0) >= shootDelay then
			owlPart = owl and (owl.PrimaryPart or owl:FindFirstChildWhichIsA("BasePart"))
			shootTarget = owlPart and whisperGetTarget(owlPart.Position, owl, targetChar) or nil
			if shootTarget and whisperShoot(owl, shootTarget) then
				whisperData.lastShot = now
			end
		end
	end
end

