function healthVal(name, def)
	hlth_v = Health.Values[name]
	if hlth_v == nil then return def end
	return hlth_v
end

function healthUpdateText()
	if not hlth_num then return end

	local hlth_frac = 1 -- Default fraction just in case

	-- [FIX] Rewrote this so it doesn't "return" early. Color settings now apply even if Humanoid is dead/nil.
	if not hlth_hum or not hlth_hum.Parent then
		hlth_num.Text = "?"
	else
		hlth_hp = math.floor(hlth_hum.Health)
		hlth_mx = math.max(1, math.floor(hlth_hum.MaxHealth))
		hlth_frac = math.clamp(hlth_hum.Health / hlth_hum.MaxHealth, 0, 1)

		if healthVal("Show Max Health", false) then
			hlth_numText = hlth_hp .. " / " .. hlth_mx
		else
			hlth_numText = tostring(hlth_hp)
		end

		if healthVal("Show Percent", false) then
			hlth_numText = hlth_numText .. "  " .. math.floor(hlth_frac * 100) .. "%"
		end

		hlth_num.Text = hlth_numText
	end

	-- Color logic moved outside the humanoid check so it always updates
	if healthVal("Color By Health", false) then
		hlth_hc = Color3.fromRGB(255 * (1 - hlth_frac), 255 * hlth_frac, 40)
		hlth_num.TextColor3 = hlth_hc
		hlth_heart.TextColor3 = hlth_hc
	else
		hlth_num.TextColor3 = healthVal("Text Color", Color3.fromRGB(255, 255, 255))
		hlth_heart.TextColor3 = healthVal("Heart Color", Color3.fromRGB(255, 70, 90))
	end
end

