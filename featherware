TRIGGER_RADIUS   = 3.5
TRIGGER_MAXDIST  = 22  
WS = G.Services.Workspace 
TRIGGER_FAN_DEG = 3 
triggerThread = nil


function fanRay(ray)
	cam = G.Services.Workspace.CurrentCamera
	if not cam then return nil end
	r = cam.CFrame.RightVector
	u = cam.CFrame.UpVector
	d = ray.Direction
	s = math.rad(TRIGGER_FAN_DEG)
	offs = { (d + r*s).Unit, (d - r*s).Unit, (d + u*s).Unit, (d - u*s).Unit }
	params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	if Player.Character then params.FilterDescendantsInstances = {Player.Character} end
	for i = 1, 4 do
		hit = WS:Raycast(ray.Origin, offs[i] * TRIGGER_MAXDIST, params)
		if hit then
			mm = trigModelOf(hit.Instance)
			if mm then return mm end
		end
	end
	return nil
end


function trigModelOf(inst)
	m = inst
	while m and m ~= G.Services.Workspace and m ~= game do
		if m:IsA("Model") and m ~= Player.Character then
			h = m:FindFirstChildOfClass("Humanoid")
			if h and h.Health > 0 then
				tp = Players:GetPlayerFromCharacter(m)
				if tp then
					if TriggerBot.Values["Target Players"] and tp ~= Player and tp.Team ~= Player.Team then return m end
				else    
					if TriggerBot.Values["Target NPCs/Dummies"] then return m end
				end
				return nil
			end
		end
		m = m.Parent
	end
	return nil
end

function getTriggerTarget()
	if not (TriggerBot.Values["Target Players"] or TriggerBot.Values["Target NPCs/Dummies"]) then return nil end
	mouse = Player:GetMouse()
	ray   = mouse.UnitRay
	model = trigModelOf(mouse.Target)  
	if not model and Player.Character then
		if type(WS.Spherecast) == "function" then   
			params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			if Player.Character then params.FilterDescendantsInstances = {Player.Character} end
			ok, res = pcall(WS.Spherecast, WS, ray.Origin, TRIGGER_RADIUS, ray.Direction * TRIGGER_MAXDIST, params)
			if ok and res then model = trigModelOf(res.Instance) end
		end
		if not model then model = fanRay(ray) end
	end
	return model
end

function triggerLoop()
	while loops["trigger bot"] do
		if not (TriggerBot.Values["Target Players"] or TriggerBot.Values["Target NPCs/Dummies"]) then
			task.wait(0.25)
		else
			char = Player.Character
			hum  = char and char:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 then
				hi   = char:FindFirstChild("HandInvItem")
				held = hi and hi.Value
				heldName = (typeof(held) == "Instance" and held.Name) or (held and tostring(held)) or nil
				if heldName and table.find(swords, heldName) then
					if getTriggerTarget() then
						pcall(function() sword_controller.lastSwing = 0 end)       
						pcall(function() sword_controller:swingSwordAtMouse(0.39) end)  
					end
				end
			end
			task.wait(1 / math.max(TriggerBot.Values["CPS"] or 9, 0.1))
		end
	end
end

