function iscRemoveSkin(item)
	if not item or typeof(item) ~= "Instance" then return end
	local old = item:FindFirstChild(item.Name .. "_Skin")
	if old then old:Destroy() end
	for _, v in ipairs(item:GetDescendants()) do
		if v:IsA("BasePart") then
			local ot = v:GetAttribute("_iscOrigTransp")
			if ot ~= nil then v.Transparency = ot; v:SetAttribute("_iscOrigTransp", nil) end
			local olm = v:GetAttribute("_iscOrigLTM")
			if olm ~= nil then v.LocalTransparencyModifier = olm; v:SetAttribute("_iscOrigLTM", nil) end
		elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") then
			local oe = v:GetAttribute("_iscOrigEnabled")
			if oe ~= nil then v.Enabled = oe; v:SetAttribute("_iscOrigEnabled", nil) end
		end
	end
	isc_tracked[item] = nil
end

iscFindSkinModel = function(itemName, tag)
	if not itemsFolder then return nil end
	local flat = string.gsub(tag, "_", "")
	return itemsFolder:FindFirstChild(string.lower(itemName .. "_" .. tag))
		or itemsFolder:FindFirstChild(string.lower(tag .. "_" .. itemName))
		or itemsFolder:FindFirstChild(itemName .. "_" .. tag)
		or itemsFolder:FindFirstChild(tag .. "_" .. itemName)
		or itemsFolder:FindFirstChild(itemName .. "_" .. flat)
		or itemsFolder:FindFirstChild(flat .. "_" .. itemName)
end

function iscApplySkin(item)
	if not item or typeof(item) ~= "Instance" then return end
    local existing = isc_tracked[item]
    local selected = isc_selected[item.Name]
    if existing and selected == existing.tag and existing.model and existing.model.Parent == item
        and existing.handle == item:FindFirstChild("Handle")
        and existing.source == iscFindSkinModel(item.Name, selected) then return end
	iscRemoveSkin(item)
	if not loops["item skin changer"] then return end
	local tag = isc_selected[item.Name]
	if not tag then return end

	replacement = iscFindSkinModel(item.Name, tag)
	if not replacement then return end

	local handle = item:FindFirstChild("Handle")
	if not handle then return end
	local skinHandle = replacement:FindFirstChild("Handle")
	if not skinHandle then return end

	local hide = {}; local fx = {}
	for _, v in ipairs(item:GetDescendants()) do
		if v:IsA("BasePart") then
			v:SetAttribute("_iscOrigTransp", v.Transparency)
			v:SetAttribute("_iscOrigLTM", v.LocalTransparencyModifier)
			v.Transparency = 1
			v.LocalTransparencyModifier = 1
			table.insert(hide, v)
		elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") then
			v:SetAttribute("_iscOrigEnabled", v.Enabled)
			v.Enabled = false
			table.insert(fx, v)
		end
	end

	local model = FWNoModules.OwnInstance(Instance.new("Model"))
	model.Name = item.Name .. "_Skin"
	model.Parent = item

	local skin = FWNoModules.OwnInstance(skinHandle:Clone())
	skin.Parent = model

	-- Physics fix
	if skin:IsA("BasePart") then
		skin.Anchored = false; skin.CanCollide = false; skin.CanQuery = false; skin.CanTouch = false; skin.CastShadow = false; skin.Massless = true
	end
	for _, d in ipairs(skin:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = false; d.CanCollide = false; d.CanQuery = false; d.CanTouch = false; d.CastShadow = false; d.Massless = true
		end
	end

	-- Rotation fix
	local nameLower = string.lower(item.Name)
	if string.find(nameLower, "bow") or string.find(nameLower, "crossbow") or string.find(nameLower, "headhunter") then
		skin.CFrame = handle.CFrame * CFrame.Angles(0, math.rad(-90), 0)
	elseif string.find(nameLower, "axe") then
		skin.CFrame = handle.CFrame * CFrame.Angles(0, math.rad(90), 0)
	else
		skin.CFrame = handle.CFrame
	end

	-- Lasso fix
	if string.find(nameLower, "lasso") then
		skin:SetAttribute("_iscForceTransp", 1)
		local lassoInner = skin:FindFirstChild("lasso")
		if lassoInner and lassoInner:IsA("BasePart") then
			lassoInner:SetAttribute("_iscForceTransp", 0)
		end
	end

	local weld = FWNoModules.OwnInstance(Instance.new("WeldConstraint"))
	weld.Part0 = handle; weld.Part1 = skin; weld.Parent = skin
	model.PrimaryPart = skin

	local info = { hide = hide, fx = fx, skin = {}, skinfx = {}, tag = tag, model = model, handle = handle, source = replacement }
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then table.insert(info.skin, d)
		elseif d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam") then table.insert(info.skinfx, d) end
	end

	local vmnow = camera:FindFirstChild("Viewmodel") or camera:FindFirstChild("ViewModel")
	info.isViewmodel = (vmnow and item:IsDescendantOf(vmnow)) and true or false
	isc_tracked[item] = info

	local fp = iscIsFirstPerson()
	local show = (info.isViewmodel and fp) or (not info.isViewmodel and not fp)
	local opaq = show and 0 or 1

	for _, p in ipairs(info.skin) do
		local ft = p:GetAttribute("_iscForceTransp")
		local val = (show and ft ~= nil) and ft or opaq
		p.Transparency = val
		p.LocalTransparencyModifier = val
	end
	for _, e in ipairs(info.skinfx) do e.Enabled = show end
end

function iscMaintain()
    local firstPerson = iscIsFirstPerson()
    for item, info in pairs(isc_tracked) do
        if not item or not item.Parent or not item:FindFirstChild("Handle") or not item:FindFirstChild(item.Name .. "_Skin") then
            iscRemoveSkin(item)
        else
            local show = (info.isViewmodel and firstPerson) or (not info.isViewmodel and not firstPerson)
            local opacity = show and 0 or 1
            for _, part in ipairs(info.hide) do
                if part.Parent then
                    if part.Transparency ~= 1 then part.Transparency = 1 end
                    if part.LocalTransparencyModifier ~= 1 then part.LocalTransparencyModifier = 1 end
                end
            end
            for _, effect in ipairs(info.fx) do
                if effect.Parent and effect.Enabled ~= false then effect.Enabled = false end
            end
            for _, part in ipairs(info.skin) do
                if part.Parent then
                    local forced = part:GetAttribute("_iscForceTransp")
                    local value = (show and forced ~= nil) and forced or opacity
                    if part.Transparency ~= value then part.Transparency = value end
                    if part.LocalTransparencyModifier ~= value then part.LocalTransparencyModifier = value end
                end
            end
            for _, effect in ipairs(info.skinfx) do
                if effect.Parent and effect.Enabled ~= show then effect.Enabled = show end
            end
        end
    end
end

function iscScanParent(parent)
    if not parent then return end
    for _, item in ipairs(parent:GetChildren()) do
        if not isc_tracked[item] and item:FindFirstChild("Handle") then
            -- Unselected items have no skin to build. Reconcile selected items
            -- at the same interval, including late handles/assets as before.
            if isc_selected[item.Name] then
                iscApplySkin(item)
            elseif item:FindFirstChild(item.Name .. "_Skin") then
                iscRemoveSkin(item)
            end
        end
    end
end


function iscReconcile()
	iscScanParent(Player.Character)
	local vm = camera:FindFirstChild("Viewmodel") or camera:FindFirstChild("ViewModel")
	iscScanParent(vm)
end

function iscApplyAll()
	if Player.Character then
		for _, item in ipairs(Player.Character:GetChildren()) do iscApplySkin(item) end
	end
	local vm = camera:FindFirstChild("Viewmodel") or camera:FindFirstChild("ViewModel")
	if vm then
		for _, item in ipairs(vm:GetChildren()) do iscApplySkin(item) end
	end
end

function iscClearAll()
	if Player.Character then
		for _, item in ipairs(Player.Character:GetChildren()) do iscRemoveSkin(item) end
	end
	local vm = camera:FindFirstChild("Viewmodel") or camera:FindFirstChild("ViewModel")
	if vm then
		for _, item in ipairs(vm:GetChildren()) do iscRemoveSkin(item) end
	end
end

