-- BULLETPROOF ANIMATION LOADER (Loads the correct AnimationUtil from game-core)
cryptLoadAnims = function()
	if cryptData.animsLoaded then return true end
	if not canRequire then return false end

	local success = pcall(function()
		-- Load AnimationUtil from game-core (used for USE_GRAVESTONE)
		local gameCore = require(ReplicatedStorage:WaitForChild("rbxts_include", 5):WaitForChild("node_modules", 5):WaitForChild("@easy-games", 5):WaitForChild("game-core", 5):WaitForChild("out", 5))
		cryptData.AnimationUtil = gameCore.AnimationUtil

