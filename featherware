				if data.fromEntity == PlayersService.LocalPlayer.Character then
					targetEntity = data.entityInstance
					if targetEntity then
						task.wait(0.1)
						lumenFireWavesAtTarget(targetEntity)
					end
				end
			end
		end)
	end)
end

