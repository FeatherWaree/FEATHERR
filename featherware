	    local Drills, Added = {}, {}
	    for _, v: Model in Tagged do
	        AddDrill(Drills, Added, v)
	    end
	
	    for _, v: Model in (bedwars.DrillTabletController and bedwars.DrillTabletController.drillList or {}) do
