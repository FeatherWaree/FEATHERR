function trIncludePlayer(trip_pl)
	if trip_pl == Player then return false end
	trip_c = trip_pl.Character
	if not trip_c then return false end
	trip_hum = trip_c:FindFirstChildOfClass("Humanoid")
	if not trip_hum or trip_hum.Health <= 0 then return false end
	trip_pt = trip_pl.Team; trip_mt = Player.Team
	if trip_pt and trip_mt and trip_pt == trip_mt then return false end
	if trip_pt and tostring(trip_pt.Name):lower():find("spectat") then return false end
	return true
end

function trProcessTarget(trpt_model)
	if not trpt_model then return end
	trpt_part = nil
	if trr_endMode == "Head" then trpt_part = trpt_model:FindFirstChild("Head") end
	if not trpt_part then trpt_part = trpt_model:FindFirstChild("HumanoidRootPart") or trpt_model.PrimaryPart end
	if not trpt_part then return end
	trpt_hum = trpt_model:FindFirstChildOfClass("Humanoid")
	if not trpt_hum or trpt_hum.Health <= 0 then return end
	trpt_sp = trr_cam:WorldToViewportPoint(trpt_part.Position)
	if trpt_sp.Z < 0 then return end
	trpt_dx = trpt_sp.X - trr_start.X
	trpt_dy = trpt_sp.Y - trr_start.Y
	trpt_len = math.sqrt(trpt_dx * trpt_dx + trpt_dy * trpt_dy)
	if trpt_len < 1 then return end
	trr_used = trr_used + 1
	trpt_line = trGetLine(trr_used)
	trpt_line.Visible = true
	trpt_line.BackgroundColor3 = trr_color
	trpt_line.BackgroundTransparency = trr_transp
	trpt_line.Position = UDim2.fromOffset((trr_start.X + trpt_sp.X) * 0.5, (trr_start.Y + trpt_sp.Y) * 0.5)
	trpt_line.Size = UDim2.fromOffset(trpt_len, trr_thick)
	trpt_line.Rotation = math.deg(math.atan2(trpt_dy, trpt_dx))
end

function trRender()
	if not loops["tracers"] then return end
	trr_cam = G.Services.Workspace.CurrentCamera
	if not trr_cam then return end

	trr_endMode = Tracers.Values["End Position"] or "Torso"
	trr_color = Tracers.Values["Tracer Color"] or Color3.fromRGB(255, 255, 255)
	trr_transp = Tracers.Values["Tracer Transparency"] or 0
	trr_thick = Tracers.Values["Tracer Thickness"] or 2
	trr_startMode = Tracers.Values["Start Position"] or "Bottom"
	trr_vs = trr_cam.ViewportSize

	if trr_startMode == "Mouse" then
		trr_m = UserInputService:GetMouseLocation()
		trr_start = Vector2.new(trr_m.X, trr_m.Y)
	elseif trr_startMode == "Middle" then
		trr_start = Vector2.new(trr_vs.X * 0.5, trr_vs.Y * 0.5)
	else
		trr_start = Vector2.new(trr_vs.X * 0.5, trr_vs.Y)
	end

	trr_used = 0

	if Tracers.Values["Target Players"] then
		for _, trr_pl in pairs(Players:GetPlayers()) do
			if trIncludePlayer(trr_pl) then trProcessTarget(trr_pl.Character) end
		end
	end

	if Tracers.Values["Target NPCs/Dummies"] then
		for _, trr_npc in ipairs(EntityCache.npcs) do
			if trr_npc and trr_npc.Parent then trProcessTarget(trr_npc) end
		end
	end

	for trr_j = trr_used + 1, #tr_pool do
		tr_pool[trr_j].Visible = false
	end
end

