end

cyberFindResourceTarget = function(basePos)
	bestTarget = nil
	bestDist = math.huge

	for _, item in ipairs(CollectionService:GetTagged("ItemDrop")) do
		name = item.Name:lower()
		if name:find("diamond") or name:find("emerald") then
			pos = item:GetPivot().Position

			-- Ignore items at our base
			if basePos and (pos - basePos).Magnitude < 25 then continue end

			myChar = PlayersService.LocalPlayer.Character
			myPos = myChar and myChar.PrimaryPart and myChar.PrimaryPart.Position
			if myPos then
				dist = (pos - myPos).Magnitude
				if dist < bestDist then
					bestDist = dist
					bestTarget = pos
				end
			end
		end
	end
	return bestTarget
end

cyberFlyDrone = function(drone, targetPos, swoopDown)
	if not drone or not drone.PrimaryPart then return false end
	pos = drone.PrimaryPart.Position
	dir = targetPos - pos
	dist = dir.Magnitude

	if dist < 4 then return true end -- Arrived

	-- Arc flight to fly over walls, but swoop down when close to target
	heightOffset = 0
	if dist > 15 and not swoopDown then
		heightOffset = math.min(dist * 0.4, 25)
	end

	arcTarget = targetPos + Vector3.new(0, heightOffset, 0)
	flyDir = (arcTarget - pos).Unit

	speed = 45
	if drone:GetAttribute("SpeedBoost") then speed = 75 end

	drone.PrimaryPart.AssemblyLinearVelocity = flyDir * speed
	drone.PrimaryPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
	return false
end

cyberLoop = function()
	if not loops["auto cyber"] then return end

	drone = cyberGetActiveDrone()

	-- 1. Drone Broken / Not Deployed Check
	if not drone then
		if not cyberData.notifiedBroken then
			NotificationSystem.Notify("Drone Status", "Your drone was destroyed or not deployed! Please deploy a new one.", 6)
			cyberData.notifiedBroken = true
		end
		cyberData.state = "IDLE"
		return
	else
		cyberData.notifiedBroken = false
	end

	heldItem = drone:GetAttribute("HeldItem")
	heldAmount = drone:GetAttribute("HeldItemAmount") or 0
	maxLoot = AutoCyber.Values["Max Loot"] or 5

	-- Find base
	if not cyberData.basePos then
		cyberData.basePos = cyberFindBase()
	end

	-- 2. Check if Drone is Full
	if heldAmount >= maxLoot and cyberData.state ~= "RETURNING" and cyberData.state ~= "DROPPING" then
		cyberData.state = "RETURNING"
		if not cyberData.notifiedFull then
			NotificationSystem.Notify("Drone Full", "Collected " .. heldAmount .. " " .. (heldItem or "items") .. ". Returning to base.", 5)
			cyberData.notifiedFull = true
		end
	end

	-- If Auto Farm is toggled off, it just holds position and waits for you
	if not cyberSettings.autoFarm then return end

	-- 3. State Machine AI
	if cyberData.state == "IDLE" or cyberData.state == "SEARCHING" then
		target = cyberFindResourceTarget(cyberData.basePos)
		if target then
			cyberData.target = target
			cyberData.state = "FLYING_TO_TARGET"
			cyberData.waitingAtGenerator = false
		elseif cyberData.basePos then
			-- No items found, return to base to wait safely
			cyberData.target = cyberData.basePos
			cyberData.state = "RETURNING"
		end

	elseif cyberData.state == "FLYING_TO_TARGET" then
		arrived = cyberFlyDrone(drone, cyberData.target, false)
		if arrived then
			cyberData.state = "COLLECTING"
			cyberData.waitingAtGenerator = false
			cyberData.generatorPos = cyberData.target
			cyberData.lastHeldAmount = heldAmount
		end

	elseif cyberData.state == "COLLECTING" then
		heldNow = drone:GetAttribute("HeldItemAmount") or 0
		if heldNow > cyberData.lastHeldAmount then
			cyberData.lastHeldAmount = heldNow
			if heldNow >= maxLoot then
				cyberData.state = "RETURNING"
				if not cyberData.notifiedFull then
					NotificationSystem.Notify("Drone Full", "Collected " .. heldNow .. " " .. (heldItem or "items") .. ". Returning to base.", 5)
					cyberData.notifiedFull = true
				end
			else
				cyberData.state = "SEARCHING"
			end
		else
			-- Item not picked up yet (waiting for respawn), hover safely above generator
			if not cyberData.waitingAtGenerator then
				cyberData.waitingAtGenerator = true
				cyberData.generatorPos = cyberData.target + Vector3.new(0, 20, 0)
				cyberData.lastSwoop = os.clock()
			end

			now = os.clock()
			if now - cyberData.lastSwoop > 3 then
				cyberData.lastSwoop = now
				cyberData.target = cyberData.generatorPos - Vector3.new(0, 20, 0) -- Swoop down to check
			else
				cyberData.target = cyberData.generatorPos -- Hover up safely
			end
			cyberFlyDrone(drone, cyberData.target, true) -- swoopDown = true so it doesn't arc while hovering
		end

	elseif cyberData.state == "RETURNING" then
		if cyberData.basePos then
			arrived = cyberFlyDrone(drone, cyberData.basePos, false)
			if arrived then
				cyberData.state = "DROPPING"
				if not cyberData.notifiedReturned then
					NotificationSystem.Notify("Drone Returned", "Drone is at your base. Please collect the loot!", 6)
					cyberData.notifiedReturned = true
				end
			end
		end

	elseif cyberData.state == "DROPPING" then
		if not heldItem or heldAmount == 0 then
			cyberData.state = "SEARCHING"
			cyberData.notifiedFull = false
			cyberData.notifiedReturned = false
			cyberData.lastHeldAmount = 0
		end
	end
end

