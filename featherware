scaffoldSetInvRemote = nil
pcall(function()
	scaffoldSetInvRemote = G.Services.RS:WaitForChild("rbxts_include"):WaitForChild("node_modules"):WaitForChild("@rbxts"):WaitForChild("net"):WaitForChild("out"):WaitForChild("_NetManaged"):WaitForChild("SetInvItem")
