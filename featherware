function nofallLoop()
	if not nofall.on then return end
	if loops["fly"] or loops["swim"] then return end

	char = Player.Character
	hrp = char and char:FindFirstChild("HumanoidRootPart")
	hum = char and char:FindFirstChildOfClass("Humanoid")

	if not hrp or not hum or hum.Health <= 0 then 
		nfTrackedVel = 0
		return 
	end

	-- Get the Damage Percentage from the slider (0 to 100)
	damagePct = tonumber(NoFall.Values["Damage Percent"]) or 0

	-- CatVape Logic: threshold = -(45 + (Damage.Value * 0.75))
	-- If Damage is 0%, threshold is -45 (save from all falls).
	-- If Damage is 100%, threshold is -120 (only save from extreme falls).
	threshold = -(45 + (damagePct * 0.75))

	velo = hrp.AssemblyLinearVelocity

	-- Check if we are falling faster than the threshold
	if nfTrackedVel < threshold then
		-- 1. Force the Humanoid state to Landed so the client doesn't apply damage
		pcall(function() hum:ChangeState(Enum.HumanoidStateType.Landed) end)

		-- 2. Briefly set velocity to a safe landing speed (2.5), then restore it
		-- This tricks the client physics into thinking we landed softly without changing gravity
		originalVelo = velo
		pcall(function() hrp.AssemblyLinearVelocity = Vector3.new(velo.X, 2.5, velo.Z) end)

		-- Wait a tiny bit for the state change to register (CatVape uses PreRender:Wait())
		G.Services.RunService.PreRender:Wait()

		-- Restore original velocity so we don't float or lose momentum
		pcall(function() hrp.AssemblyLinearVelocity = originalVelo end)

		-- 3. Fire the GroundHit remote to tell the server we landed safely
		if nfGroundHitRemote then
			pcall(function()
				-- The remote expects: (nil, velocityVector, serverTime)
				nfGroundHitRemote:FireServer(nil, Vector3.new(0, nfTrackedVel, 0), G.Services.Workspace:GetServerTimeNow())
			end)
		end
	end

	-- Track the Y velocity for the next frame
	nfTrackedVel = velo.Y
end

