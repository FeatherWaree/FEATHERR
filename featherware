function ntKitImage(plr)
	if not ntCanReq or not BedwarsKitMetaModule then return nil end
	nt_kitRaw = plr:GetAttribute("PlayingAsKits") or plr:GetAttribute("PlayingAsKit")
	if not nt_kitRaw then return nil end
	nt_ok, nt_meta = pcall(BedwarsKitMetaModule.getBedwarsKitMeta, nt_kitRaw)
	if nt_ok and type(nt_meta) == "table" and nt_meta.renderImage then
		return nt_meta.renderImage
	end
	return nil
end

function ntGetRankImage(plr)
	if not ntCanReq or not ntRankMeta then return nil end
	ntDiv = ntRankCache[plr.UserId]
	if not ntDiv then
		ntDiv = plr:GetAttribute("RankDivision") or plr:GetAttribute("rankDivision") or plr:GetAttribute("Rank") or plr:GetAttribute("rank")
	end
	if not ntDiv then return nil end

	ntMeta = ntRankMeta[ntDiv]
	if ntMeta and ntMeta.image then
		return ntMeta.image
	end

	ntDivStr = string.lower(tostring(ntDiv))
	ntTiers = {"bronze", "silver", "gold", "platinum", "diamond", "emerald", "nightmare"}
	for _, t in ipairs(ntTiers) do
		if string.find(ntDivStr, t) then
			for _, m in pairs(ntRankMeta) do
				if m.tier == t and m.image then
					return m.image
				end
			end
		end
	end
	return nil
end

