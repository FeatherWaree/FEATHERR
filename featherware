if hookmetamethod and newcclosure then
	reachOldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
		method = getnamecallmethod and getnamecallmethod() or getnamecheckmethod()

		-- === SWORD REACH ===
		if self.Name == "SwordHit" and method == "FireServer" then
			if loops["reach"] and Reach.Values["Sword"] then
				args = {...}
				data = args[1]
				if type(data) == "table" and data.validate and data.validate.targetPosition and data.validate.selfPosition then
					selfPos = data.validate.selfPosition.value
					targetPos = data.validate.targetPosition.value
					dist = (targetPos - selfPos).Magnitude
					swordReach = Reach.Values["Sword Reach"] or 14.8
					if swordReach > 14.4 and dist > 14.4 then
						dir = (targetPos - selfPos).Unit
						data.validate.targetPosition.value = selfPos + dir * 14.0
					end
				end
				return reachOldNamecall(self, (unpack or table.unpack)(args))
			end

			-- === KAIDA REACH ===
		elseif self.Name == "SummonerClawAttackRequest" and method == "FireServer" then
			if loops["kaida reach"] then
				args = {...}
				data = args[1]
				if type(data) == "table" and data.position and data.direction then
					targetReach = tonumber(KaidaReach.Values["Claw Reach"]) or 21
					if targetReach > 21 then
						extraDist = targetReach - 21
						dir = data.direction
						pos = data.position

						newX = pos.X + (dir.X * extraDist)
						newY = pos.Y + (dir.Y * extraDist)
						newZ = pos.Z + (dir.Z * extraDist)

						if vector and vector.create then
							data.position = vector.create(newX, newY, newZ)
						else
							data.position = Vector3.new(newX, newY, newZ)
						end
					end
				end
				return reachOldNamecall(self, (unpack or table.unpack)(args))
			end
		end

		return reachOldNamecall(self, ...)
	end))
end



