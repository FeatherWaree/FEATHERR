									bl_life = pa_pm.lifetimeSec or 3

									pa_vt, pa_t = paAim(pa_spawnO, pa_hrp.Position, pa_lead, bl_launchVel, bl_grav, bl_life, pa_tgtG,pa_motion)

									if pa_vt and paHasLOS(pa_myPos, pa_target, pa_hrp) then
										heldNameB = paGetHeldName()
