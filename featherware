local function playLocalAnimation(emoteName)
	local character = game.Players.LocalPlayer.Character
	if not character then return end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	if not animator then return end

	local animationObject = Instance.new("Animation")

	if emoteName == "NIGHTMARE_1" then
		animationObject.AnimationId = "rbxassetid://152" 
	else
		animationObject.AnimationId = "rbxassetid://5077119569" 
	end

	if animationObject.AnimationId ~= "" then
		local success, track = pcall(function()
			return animator:LoadAnimation(animationObject)
		end)

		if success and track then
			track.Priority = Enum.AnimationPriority.Action
			track:Play()

			return track, animationObject
		end
	end
	animationObject:Destroy()
	return nil
end

