function paSolve(O, T, v, g)
	pasol_d = T - O
	pasol_R = math.sqrt(pasol_d.X*pasol_d.X + pasol_d.Z*pasol_d.Z)
	if v <= 0 then return nil end
	if g < 0.001 then
		pasol_dist = pasol_d.Magnitude
		if pasol_dist < 0.01 then return Vector3.new(0, v, 0), 0 end
		return pasol_d.Unit * v, pasol_dist / v
	end
	if pasol_R < 0.5 then return Vector3.new(0, pasol_d.Y >= 0 and v or -v, 0), math.abs(pasol_d.Y)/v end
	pasol_v2 = v*v
	pasol_disc = pasol_v2*pasol_v2 - g*(g*pasol_R*pasol_R + 2*pasol_d.Y*pasol_v2)
	if pasol_disc < 0 then return nil end
	pasol_tanT = (pasol_v2 - math.sqrt(pasol_disc)) / (g*pasol_R)
	pasol_cosT = 1 / math.sqrt(1 + pasol_tanT*pasol_tanT)
	pasol_hDir = Vector3.new(pasol_d.X, 0, pasol_d.Z) * (1/pasol_R)
	return pasol_hDir*(v*pasol_cosT) + Vector3.new(0, v*pasol_tanT*pasol_cosT, 0), pasol_R/(v*pasol_cosT)
end

function paAim(O, hrp, vel, v, g, life, pTgtG)
	paa_T = hrp
	paa_g = pTgtG or 0
	paa_vt, paa_t = nil, 0
	for paa_i = 1, 4 do
		paa_vt, paa_t = paSolve(O, paa_T, v, g)
		if not paa_vt or paa_t > (life or 3) then return nil end
		paa_T = Vector3.new(
			hrp.X + vel.X * paa_t,
			hrp.Y + vel.Y * paa_t - 0.5 * paa_g * paa_t * paa_t,
			hrp.Z + vel.Z * paa_t)
	end
	return paa_vt, paa_t
end

function paHasLOS(origin, model, rootPart)
