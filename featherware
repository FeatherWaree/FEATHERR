function geUpdateLabels()
	ge_char = Player.Character
	ge_hrp = ge_char and ge_char:FindFirstChild("HumanoidRootPart")
	if not ge_hrp then return end
	ge_maxDist = GeneratorESP.Values["Max Distance"] or 300
	for ge_inst, ge_data in pairs(ge_objects) do
		if not ge_inst.Parent then geRemoveESP(ge_inst) continue end
		if string.find(string.lower(ge_inst.Name), "cframe") then return end
		ge_pos = ge_inst.Position or (ge_inst:GetAttribute("position"))
		if not ge_pos then continue end
		ge_dist = (ge_pos - ge_hrp.Position).Magnitude
		if ge_dist > ge_maxDist then ge_data.bb.Enabled = false continue end
		ge_data.bb.Enabled = true
		ge_lines = {}
		ge_name = ge_inst.Name or "Generator"
		if ge_inst:GetAttribute("teamId") then ge_name = "Team Generator" end
		table.insert(ge_lines, ge_name)
		if GeneratorESP.Values["Show Level"] then
			ge_lvl = ge_inst:GetAttribute("GeneratorLevel") or 0
			table.insert(ge_lines, "Level: " .. tostring(ge_lvl))
		end
		if GeneratorESP.Values["Show Cooldown"] then
			ge_cd = ge_inst:GetAttribute("Cooldown") or 0
			ge_lastDrop = ge_dropTimes[ge_inst] or 0
			ge_elapsed = os.clock() - ge_lastDrop
			ge_remaining = math.max(0, ge_cd - ge_elapsed)
			table.insert(ge_lines, "Next: " .. string.format("%.1fs", ge_remaining))
		end
		if GeneratorESP.Values["Show Distance"] then
			table.insert(ge_lines, string.format("%d studs", math.round(ge_dist)))
		end
		ge_data.lbl.Text = table.concat(ge_lines, "\n")
		ge_data.lbl.TextColor3 = ge_data.isTeam and (GeneratorESP.Values["Team Gen Color"] or Color3.fromRGB(50, 200, 255)) or (GeneratorESP.Values["Generator Color"] or Color3.fromRGB(255, 200, 50))
