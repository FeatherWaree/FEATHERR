-- Action name for sinking character movement inputs
SINK_ACTION = "FreecamSinkMovement"

function sinkInput()
	return Enum.ContextActionResult.Sink
end

-- Helper function to manage character state (freeze, hide, block character inputs)
function setCharacterState(character, isFreecam)
	if isFreecam then
		-- Priority 3000 blocks Roblox from passing movement keys to your character
		ContextActionService:BindActionAtPriority(
			SINK_ACTION,
			sinkInput,
			false,
			3000,
			Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D,
			Enum.KeyCode.Space, Enum.KeyCode.LeftShift
		)
	else
		-- Restore normal character controls
		ContextActionService:UnbindAction(SINK_ACTION)
	end

	if not character then return end

	-- Anchor HumanoidRootPart to prevent physics movement
	hrp = character:FindFirstChild("HumanoidRootPart")
	if hrp then
		hrp.Anchored = isFreecam
	end

	-- Handle character visibility
	hidePlayer = isFreecam and not FreeCam.Values["Show Player"]
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
			part.LocalTransparencyModifier = hidePlayer and 1 or 0
		end
	end
end

FreeCam.Callbacks.OnToggle = function(state)
	loops["freecam"] = state
	fc_cam = G.Services.Workspace.CurrentCamera

	if state then
		fc_origSubject = fc_cam.CameraSubject
		fc_cam.CameraType = Enum.CameraType.Scriptable

		-- Store current camera position and orientation angles
		fc_camPos = fc_cam.CFrame.Position
		local rx, ry, _ = fc_cam.CFrame:ToEulerAnglesYXZ()
		pitch = rx
		yaw = ry

		-- Apply character freeze and block movement inputs
		setCharacterState(Player.Character, true)

		-- Lock mouse in place ONLY when holding Right Click
		fc_inputBeganConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
			if input.UserInputType == Enum.UserInputType.MouseButton2 then
				UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
			end
		end)

		-- Release mouse lock when Right Click is released
		fc_inputEndedConn = UserInputService.InputEnded:Connect(function(input, gameProcessed)
			if input.UserInputType == Enum.UserInputType.MouseButton2 then
				UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			end
		end)

		-- Mouse Movement Listener (Rotates the Camera only if RMB is down)
		fc_inputConn = UserInputService.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseMovement then
				if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
					local delta = input.Delta

					-- INCREASE THIS NUMBER TO TURN FASTER (Was 0.003)
					local sensitivity = 0.008 

					yaw = yaw - (delta.X * sensitivity)
					pitch = math.clamp(pitch - (delta.Y * sensitivity), math.rad(-89), math.rad(89))
				end
			end
		end)

		-- Respawn Handler (Resets FreeCam to character position upon death)
		fc_charAddedConn = Player.CharacterAdded:Connect(function(newChar)
			local hrp = newChar:WaitForChild("HumanoidRootPart", 5)
			if hrp then
				-- Reposition FreeCam near new spawn point
				fc_camPos = hrp.Position + Vector3.new(0, 5, 10)

				local newCFrame = CFrame.lookAt(fc_camPos, hrp.Position)
				local rx, ry, _ = newCFrame:ToEulerAnglesYXZ()
				pitch = rx
				yaw = ry

				setCharacterState(newChar, true)
			end
		end)

		-- Main Movement Loop
		fc_conn = G.Services.RunService.RenderStepped:Connect(function(deltaTime)
			if not loops["freecam"] then return end

			-- Keep camera scriptable so engine doesn't override it
			fc_cam.CameraType = Enum.CameraType.Scriptable

			-- Calculate rotation CFrame from pitch and yaw
			rotCFrame = CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)

			fc_speed = FreeCam.Values["Speed"] or 50
			fc_move = Vector3.zero

			-- Calculate movement relative to where the camera is looking
			if UserInputService:IsKeyDown(Enum.KeyCode.W) then fc_move = fc_move + rotCFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then fc_move = fc_move - rotCFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then fc_move = fc_move - rotCFrame.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then fc_move = fc_move + rotCFrame.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then fc_move = fc_move + Vector3.new(0, 1, 0) end
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then fc_move = fc_move - Vector3.new(0, 1, 0) end

			if fc_move.Magnitude > 0 then
				fc_camPos = fc_camPos + (fc_move.Unit * fc_speed * deltaTime)
			end

			-- Update final camera CFrame
			fc_cam.CFrame = CFrame.new(fc_camPos) * rotCFrame
		end)

	else
		-- Disconnect event connections
		if fc_conn then fc_conn:Disconnect(); fc_conn = nil end
		if fc_inputConn then fc_inputConn:Disconnect(); fc_inputConn = nil end
		if fc_inputBeganConn then fc_inputBeganConn:Disconnect(); fc_inputBeganConn = nil end
		if fc_inputEndedConn then fc_inputEndedConn:Disconnect(); fc_inputEndedConn = nil end
		if fc_charAddedConn then fc_charAddedConn:Disconnect(); fc_charAddedConn = nil end

		-- Restore original camera and mouse settings
		fc_cam.CameraType = Enum.CameraType.Custom
		fc_cam.CameraSubject = fc_origSubject or (Player.Character and Player.Character:FindFirstChild("Humanoid"))
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default

		-- Unfreeze character and restore key inputs
		setCharacterState(Player.Character, false)
	end
end

