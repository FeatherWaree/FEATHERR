function elderGetPos(m)
	if m:IsA("BasePart") then return m.Position end
	if m:IsA("Model") then
		elder_pp = m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart")
		if elder_pp then return elder_pp.Position end
		pcall(function() return m:GetPivot().Position end)
	end
	return nil
end

function elderColorParts(m, col, transp)
	elder_orig = {}
	for _, ep in ipairs(m:GetDescendants()) do
		if ep:IsA("BasePart") then
			table.insert(elder_orig, {part = ep, color = ep.Color, transp = ep.Transparency, mat = ep.Material})
			ep.Color = col
			ep.Transparency = transp
			ep.Material = Enum.Material.Neon
		end
	end
	return elder_orig
end

function elderRestoreParts(orig)
	if not orig then return end
	for _, op in ipairs(orig) do
		pcall(function()
			op.part.Color = op.color
			op.part.Transparency = op.transp
			op.part.Material = op.mat
		end)
	end
end

function elderUpdatePartColors(orig, col, transp)
	if not orig then return end
	for _, op in ipairs(orig) do
		pcall(function()
			op.part.Color = col
			op.part.Transparency = transp
			op.part.Material = Enum.Material.Neon
		end)
	end
end

function elderCleanupEntry(m)
	elder_d = elder_esp_data[m]
	if not elder_d then return end
	if elder_d.origParts then elderRestoreParts(elder_d.origParts) end
	if elder_d.bb then pcall(function() elder_d.bb:Destroy() end) end
	if elder_d.glow then pcall(function() elder_d.glow:Destroy() end) end
	elder_esp_data[m] = nil
end

function elderFireConsume(orb)
	if not orb or not elder_remotes then return false end
	elder_secret = orb:GetAttribute("TreeOrbSecret")
	if not elder_secret then return false end
	elder_ok, elder_ret = pcall(function()
		return elder_remotes.Client:Get("ConsumeTreeOrb"):CallServer({treeOrbSecret = elder_secret})
	end)
	if not elder_ok then return false end
	return elder_ret ~= nil and elder_ret ~= false
end

