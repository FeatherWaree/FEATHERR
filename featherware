	end
	if not ntDiv then return nil end

	ntMeta = ntRankMeta[ntDiv]
	if ntMeta and ntMeta.image then
		return ntMeta.image
	end

	ntDivStr = string.lower(tostring(ntDiv))
	ntTiers = {"bronze", "silver", "gold", "platinum", "diamond", "emerald", "nightmare"}
	for _, t in ipairs(ntTiers) do
