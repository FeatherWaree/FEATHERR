            if entry.object == object and entry.key == key then return end
        end
        runtime.restorations[#runtime.restorations + 1] = {object = object, key = key, value = object[key]}
    end
    runtime.hookGroups = {}
    runtime.hookForwarders = setmetatable({}, {__mode="k"})
    local function rebuildHooks(group)
