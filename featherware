		metal_dl.Size = UDim2.fromScale(1, 1)
		metal_dl.BackgroundTransparency = 1
		metal_dl.Text = ""
		metal_dl.TextColor3 = MetalESP.Values["Distance Text Color"] or Color3.fromRGB(255, 255, 255)
