function asIsItemSelected(itemName)
	asSel = ChestESP.Values["Items"]
	if asSel == nil then return true end
	if type(asSel) == "table" then
		for asK, asV in pairs(asSel) do
			if asK == itemName or asV == itemName then return true end
		end
		return false
	elseif type(asSel) == "string" then
		return asSel == itemName
	end
	return true
end

local function getItemImage(itemName)
	if not ItemMetaModule or not ItemMetaModule.getItemMeta then return "" end
	itemData = ItemMetaModule.getItemMeta(itemName)
	if itemData and (itemData.image or itemData.icon) then
		imgVal = itemData.image or itemData.icon
		if type(imgVal) == "number" then
			return "rbxassetid://" .. tostring(imgVal)
		elseif type(imgVal) == "string" then
			if string.match(imgVal, "^%d+$") then return "rbxassetid://" .. imgVal end
			return imgVal
		end
	end
	return ""
end

local activeESPs = {}

local function applyScale(billboard)
	sc = ChestESP.Values["ESP Scale"] or 1
	billboard.Size = UDim2.new(CHEST_BASE_W * sc, 0, CHEST_BASE_H * sc, 0)
	billboard.StudsOffset = Vector3.new(0, 2.5 + 2.5 * sc, 0)
