-- Helper to check if an instance is a valid NPC based on your updated rules
local function isValidNPC(instance)
	if not instance:IsA("Model") then return false end
	if not instance:FindFirstChildOfClass("Humanoid") then return false end

	-- If it has the "entity" tag, validate names/custom names
	if EC_CS:HasTag(instance, "entity") then
		local hasDummyInName = instance.Name:lower():find("dummy") ~= nil

		-- Check for CustomEntityName (as a child Value/Attribute)
		local customNameVal = instance:FindFirstChild("CustomEntityName")
		local customNameStr = nil

		if customNameVal then
			if customNameVal:IsA("StringValue") or customNameVal:IsA("ValueBase") then
				customNameStr = tostring(customNameVal.Value):lower()
			end
		end

		-- Also check attributes just in case it's stored as an attribute
		if not customNameStr and instance:GetAttribute("CustomEntityName") then
			customNameStr = tostring(instance:GetAttribute("CustomEntityName")):lower()
		end

		local hasDummyInCustomName = customNameStr and customNameStr:find("dummy") ~= nil

		-- Must have "dummy" in either the model name or the CustomEntityName
		if not hasDummyInName and not hasDummyInCustomName then
			return false
		end
	end

	return true
end

FWNoModules.PendingNPCs = setmetatable({}, {__mode = "k"})
EC_AddNPC = function(instance)
	local discoveryRuntime = FWNoModules.Runtime
	local pending = FWNoModules.PendingNPCs
	local cache = EntityCache.NPCs
	if not discoveryRuntime.active then return end
	if not instance:IsA("Model") or pending[instance] then return end
	pending[instance] = true
	task.spawn(function()
		local timeout = 3
		local elapsed = 0

		while elapsed < timeout and discoveryRuntime.active do
			if instance:FindFirstChildOfClass("Humanoid") then break end
			elapsed = elapsed + task.wait(0.1)
		end

		task.wait(0.1)

		pending[instance] = nil
		if discoveryRuntime.active and instance and instance.Parent and isValidNPC(instance) then
			if not table.find(cache, instance) then
				table.insert(cache, instance)
			end
		end
	end)
end

-- 2. Helper to remove from NPCs
EC_RemoveNPC = function(instance)
	local nIdx = table.find(EntityCache.NPCs, instance)
	if nIdx then
		table.remove(EntityCache.NPCs, nIdx)
	end
end

