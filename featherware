	loops["auto nazar"] = state
	if state then
		nazarSetupHook()
		nazarData.lastFire = 0
		char = Players.LocalPlayer.Character
		hum = char and char:FindFirstChildOfClass("Humanoid")
		nazarData.lastHealth = hum and hum.Health or 100

		if not nazarConn then
			nazarConn =G.Services.RunService.Heartbeat:Connect(function()
				if not loops["auto nazar"] then return end

				char = Players.LocalPlayer.Character
				hum = char and char:FindFirstChildOfClass("Humanoid")

